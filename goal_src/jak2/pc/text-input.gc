(in-package goal)

(define-extern get-aspect-ratio (function symbol))

(defenum pc-text-edit-state
  :type uint8
  (inactive 0)
  (editing 1)
  (submitted 2)
  (cancelled 3))

(deftype pc-text-input-session (structure)
  ((token uint32)
   (revision uint32)
   (cursor uint16)
   (anchor uint16)
   (composition-cursor uint16)
   (composition-anchor uint16)
   (status pc-text-edit-state)
   (text string)
   (composition string)
   (hints-overlay (pointer mp-overlay-layout-process))))

(defun pc-text-input-hints-owner ()
  (if (nonnull? *progress-process* (-> *progress-process* 0))
      (the-as process (-> *progress-process* 0))
      (the-as process #f)))

(defun pc-text-input-hints-sync! ((session pc-text-input-session))
  (when (nonnull? session (-> session hints-overlay))
    (let ((owner (pc-text-input-hints-owner)))
      (when (nonnull? owner)
        (mp-overlay-layout-set-conditions!
          (-> session hints-overlay) owner
          (the uint
               (if (and (nonzero? (-> session token))
                        (= (-> session status) (pc-text-edit-state editing)))
                   1
                   0))))))
  (none))

(defun pc-text-input-hint-widget! ((widget mp-overlay-widget)
                                    (id text-id) (offset-y int))
  (when (nonnull? widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) id)
    (set! (-> widget required-conditions) (the uint32 1))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget offset-y) offset-y)
    (set! (-> widget width) 375.0)
    (set! (-> widget height) 16.0)
    (set! (-> widget scale) 0.35)
    (set! (-> widget color) (the-as uint32 (font-color progress)))
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (set! (-> widget bucket) (the-as uint32 (bucket-id progress))))
  widget)

(defun pc-text-input-show-hints! ((session pc-text-input-session))
  (when (and (nonnull? session)
             (nonzero? (-> session token))
             (not (nonnull? (-> session hints-overlay))))
    (let ((owner (pc-text-input-hints-owner))
          (layout (new 'stack 'mp-overlay-layout))
          (widget (new 'stack 'mp-overlay-widget)))
      (when (nonnull? owner layout widget)
        (mp-overlay-layout-clear! layout)
        (set! (-> layout bounds-x) (if (= (get-aspect-ratio) 'aspect16x9) 10 10))
        (set! (-> layout bounds-y) (if (= (get-aspect-ratio) 'aspect16x9) 380 350))
        (set! (-> layout bounds-width) 475.0)
        (set! (-> layout bounds-height) 33.0)
        (pc-text-input-hint-widget! widget (text-id progress-text-input-confirm) 0)
        (mp-overlay-layout-add-widget! layout widget)
        (pc-text-input-hint-widget! widget (text-id progress-text-input-cancel) 20)
        (mp-overlay-layout-add-widget! layout widget)
        (set! (-> session hints-overlay) (mp-overlay-layout-start! owner layout empty-string-resolver))
        (pc-text-input-hints-sync! session))))
  (none))

(defun pc-text-input-close! ((session pc-text-input-session))
  (when (nonnull? session)
    (when (nonnull? (-> session hints-overlay))
      (let ((owner (pc-text-input-hints-owner)))
        (when (nonnull? owner)
          (mp-overlay-layout-stop! (-> session hints-overlay) owner)))
      (set! (-> session hints-overlay)
            (the-as (pointer mp-overlay-layout-process) #f)))
    (when (nonzero? (-> session token))
      (pc-text-input-close (-> session token)))
    (set! (-> session token) 0)
    (set! (-> session revision) 0)
    (set! (-> session status) (pc-text-edit-state inactive)))
  (none))

(defun pc-text-input-open! ((session pc-text-input-session) (initial string)
                            (max-bytes uint) (allowed string) (uppercase? symbol))
  (when (nonnull? session initial allowed)
    (pc-text-input-close! session)
    (let ((token (pc-text-input-begin initial max-bytes allowed uppercase?)))
      (when (nonzero? token)
        (set! (-> session token) token)
        (set! (-> session revision) 0)
        (set! (-> session status) (pc-text-edit-state editing))
        (set! (-> session text) initial)
        (set! (-> session composition) "")
        (set! (-> session cursor) (the uint16 (length initial)))
        (set! (-> session anchor) (the uint16 (length initial)))
        (pc-text-input-show-hints! session)
        (return #t))))
  #f)

(defun pc-text-input-refresh! ((session pc-text-input-session))
  (when (nonnull? session)
    (let ((token (-> session token)))
      (when (nonzero? token)
        (let ((revision (pc-text-input-revision token)))
          (when (and (nonzero? revision) (!= revision (-> session revision)))
            (let ((text (pc-text-input-text token))
                  (composition (pc-text-input-composition token)))
              (when (nonnull? text composition)
                (set! (-> session text) text)
                (set! (-> session composition) composition)
                (set! (-> session cursor) (the uint16 (pc-text-input-cursor token)))
                (set! (-> session anchor) (the uint16 (pc-text-input-anchor token)))
                (set! (-> session composition-cursor)
                      (the uint16 (pc-text-input-composition-cursor token)))
                (set! (-> session composition-anchor)
                      (the uint16 (pc-text-input-composition-anchor token)))
                (set! (-> session status)
                      (the pc-text-edit-state (pc-text-input-status token)))
                (when (= revision (pc-text-input-revision token))
                  (set! (-> session revision) revision))))))))
    (pc-text-input-hints-sync! session))
  (none))

(defun pc-text-input-append-byte! ((destination string) (value uint))
  (when (nonnull? destination)
    (let ((index (length destination)))
      (set! (-> destination data index) value)
      (set! (-> destination data (+ index 1)) 0)))
  (none))

(defun pc-text-input-append-composition! ((session pc-text-input-session)
                                           (destination string) (caret? symbol))
  (when (nonnull? session destination (-> session composition))
    (let ((composition (-> session composition))
          (selection-start (min (-> session composition-cursor)
                                (-> session composition-anchor)))
          (selection-end (max (-> session composition-cursor)
                              (-> session composition-anchor))))
      (format destination "~35L")
      (dotimes (index (+ (length composition) 1))
        (when (and (< selection-start selection-end) (= index selection-start))
          (format destination "~33L"))
        (when (and (< selection-start selection-end) (= index selection-end))
          (format destination "~35L"))
        (when (and caret? (= index (-> session composition-cursor)))
          ;; the caret is the pipe | char
          (format destination "~Y~-4H~35L\c84~Z~35L"))
        (when (< index (length composition))
          (pc-text-input-append-byte! destination (-> composition data index))))
      (format destination "~33L")))
  (none))

(defun pc-text-input-format! ((session pc-text-input-session)
                               (destination string) (caret? symbol))
  (when (nonnull? session destination (-> session text))
    (clear destination)
    (let ((value (-> session text))
          (selection-start (min (-> session cursor) (-> session anchor)))
          (selection-end (max (-> session cursor) (-> session anchor))))
      (format destination "~33L")
      (dotimes (index (+ (length value) 1))
        (when (and (< selection-start selection-end) (= index selection-start))
          (format destination "~35L"))
        (when (and (< selection-start selection-end) (= index selection-end))
          (format destination "~33L"))
        (when (= index (-> session cursor))
          (if (and (nonnull? (-> session composition))
                   (> (length (-> session composition)) 0))
              (pc-text-input-append-composition! session destination caret?)
              (when caret?
                ;; the caret is the pipe | char
                (format destination "~Y~-4H~35L\c84~Z"))))
        (when (< index (length value))
          (pc-text-input-append-byte! destination (-> value data index))))
      (format destination "~1L")))
  destination)
