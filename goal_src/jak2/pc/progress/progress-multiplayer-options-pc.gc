;;-*-Lisp-*-
(in-package goal)

(defun-extern draw-generic-highlight int int float pointer)
(define-extern mp-player-color-progress-enter! (function progress none))
(define-extern refresh-generic-text-fields! (function menu-option-list none))

(deftype menu-multiplayer-large-link-option (menu-generic-link-option) ())

(define-extern *multiplayer-options-pc* menu-option-list)

(defun mp-reset-scrolling-page-selection! ((menu-list menu-option-list))
  (when (nonnull? menu-list (-> menu-list options))
    (let ((options-array (-> menu-list options)))
      (when (> (-> options-array length) 0)
        (let ((page (-> options-array 0)))
          (when (and (nonnull? page) (type? page menu-generic-scrolling-page))
            (set! (-> (the-as menu-generic-scrolling-page page) selected-option-index) -1))))))
  (none))

(defun mp-reset-multiplayer-options-selection! ()
  (mp-reset-scrolling-page-selection! *multiplayer-options-pc*)
  (none))

(defun mp-load-multiplayer-options! ()
  (mp-sync-preferences-to-session-host-config!)
  (refresh-generic-text-fields! *multiplayer-options-pc*)
  (mp-reset-multiplayer-options-selection!)
  (when (nonnull? *progress-process* (-> *progress-process* 0))
    (set! (-> (-> *progress-process* 0) selected-option) #f))
  (none))

(defmethod draw-option ((obj menu-multiplayer-large-link-option)
                        (p progress)
                        (font-ctx font-context)
                        (option-index int)
                        (selected? symbol))
  (when (and obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (when (not (-> obj mounted?))
      (on-mount! obj))
    (let ((alpha (fmax (* 2.0 (- 0.5 (-> p menu-transition))) 0.0)))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.75)
      (+! (-> font-ctx origin y) (if (= (get-aspect-ratio) 'aspect4x3) 14.0 11.0))
      (cond
        ((and (nonzero? (-> obj should-disable?))
              (!= (-> obj should-disable?) #f)
              ((-> obj should-disable?)))
         (set-color! font-ctx (font-color progress-option-off))
         (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
           (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 26 (* 0.5 alpha))))
        ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
         (set-color! font-ctx (progress-selected 0))
         (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 26 alpha))
        (else
         (set-color! font-ctx (font-color progress))))
      (print-game-text (lookup-text! *common-text* (-> obj name) #f) font-ctx #f 44 (bucket-id progress))))
  (none))

(defmacro progress-new-generic-large-link-to-scrolling-page (title &key (should-disable? #f) &rest options)
  `(new 'static 'menu-multiplayer-large-link-option
    :name ,title
    :should-disable? ,should-disable?
    :target (new 'static 'menu-option-list
      :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-generic-scrolling-page
       :name ,title
       :menu-options (new 'static 'boxed-array :type menu-option
       ,@options))))))

(define *multiplayer-options-pc*
  (progress-new-generic-scrolling-page (text-id progress-multiplayer-options)
    (new 'static 'menu-generic-text-field-option
      :name (text-id progress-username)
      :field 2
      :get-value-fn (lambda ((field int)) (pc-multi-get-preference-field field))
      :set-value-fn (lambda ((field int) (value string)) (pc-multi-set-preference-field field value))
      :max-bytes 15
      :allowed-characters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
      :uppercase? #f
      :session (new 'static 'pc-text-input-session))
    (new 'static 'menu-generic-boolean-option
      :name (text-id progress-multiplayer-preferred-character)
      :truthy-text (text-id progress-multiplayer-char-jak)
      :falsey-text (text-id progress-multiplayer-char-daxter)
      :get-value-fn (lambda ()
        (= (pc-multi-get-preference-player-character) (mp-player-character jak)))
      :on-confirm (lambda ((value symbol))
        (pc-multi-set-preference-player-character
          (the uint (if value (mp-player-character jak) (mp-player-character daxter))))))
    (new 'static 'menu-generic-button-option
      :name (text-id progress-lobby-color-title)
      :on-confirm (lambda ((the-progress progress))
        (mp-player-color-progress-enter! the-progress)))
    (progress-new-generic-large-link-to-scrolling-page (text-id progress-multiplayer-host-options)
      (new 'static 'menu-generic-carousel-option
        :name (text-id progress-multiplayer-max-players)
        :get-max-size-fn (lambda () (+ (the int MP_MAX_PLAYERS) -1))
        :get-item-label-fn (lambda ((index int))
          (format (clear *temp-string*)
                  (lookup-text! *common-text* (text-id progress-multiplayer-players-count-fmt) #f)
                  (+ index 2))
          *temp-string*)
        :get-item-index-fn (lambda ()
          (+ (the int *mp-session-player-limit*) -2))
        :on-confirm (lambda ((index int) (the-progress progress))
          (let ((limit (+ index 2)))
            (mp-set-session-player-limit! (the uint limit))
            (pc-multi-set-preference-player-limit (the uint limit)))))
      (new 'static 'menu-generic-text-field-option
        :name (text-id progress-port)
        :field 0
        :get-value-fn (lambda ((field int)) (pc-multi-get-preference-field field))
        :set-value-fn (lambda ((field int) (value string)) (pc-multi-set-preference-field field value))
        :max-bytes 5
        :allowed-characters "0123456789"
        :session (new 'static 'pc-text-input-session))
      (new 'static 'menu-generic-text-field-option
        :name (text-id progress-multiplayer-room-code)
        :field 1
        :get-value-fn (lambda ((field int)) (pc-multi-get-preference-field field))
        :set-value-fn (lambda ((field int) (value string)) (pc-multi-set-preference-field field value))
        :max-bytes 6
        :allowed-characters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
        :uppercase? #t
        :session (new 'static 'pc-text-input-session))
      (new 'static 'menu-generic-boolean-option
        :name (text-id progress-multiplayer-auto-port-mapping)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda () (= (pc-multi-get-automatic-port-mapping) 1))
        :on-confirm (lambda ((value symbol))
          (pc-multi-set-automatic-port-mapping (if value 1 0))))
      (new 'static 'menu-generic-button-option
        :name (text-id progress-multiplayer-reset-defaults)
        :on-confirm (lambda ((the-progress progress))
          (pc-multi-reset-preferences)
          (mp-sync-preferences-to-session-host-config!)
          (refresh-generic-text-fields! *multiplayer-options-pc*)
          (none))))))
