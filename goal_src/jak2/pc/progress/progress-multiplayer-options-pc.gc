;;-*-Lisp-*-
(in-package goal)

(define-extern mp-player-color-progress-enter! (function progress none))
(define-extern refresh-generic-text-fields! (function menu-option-list none))
(define-extern get-host-rule-value (function int int))

(defun get-multiplayer-preference-text ((field int))
  (when (nonnull? *multiplayer-preferences*)
    (case field
      ((0) (return (format #f "~D" (-> *multiplayer-preferences* network-port))))
      ((1) (return (-> *multiplayer-preferences* room-code)))
      ((2) (return (-> *multiplayer-preferences* player-name)))
      ((3) (return (format #f "~D" (get-host-rule-value 2))))))
  "")

(defun parse-multiplayer-preference-number ((value string))
  (when (nonnull? value)
    (let ((digits (-> value data))
          (size (length value)))
      (when (and (nonnull? digits) (> size 0) (<= size 5))
        (dotimes (index size)
          (when (or (< (-> digits index) 48) (> (-> digits index) 57))
            (return -1)))
        (let ((number (string->int value)))
          (when (<= number 65535)
            (return number))))))
  -1)

(defun set-multiplayer-preference-text! ((field int) (value string))
  (when (nonnull? *multiplayer-preferences* value)
    (case field
      ((0 3)
       (let ((number (parse-multiplayer-preference-number value)))
         (when (< number 0)
           (return 0))
         (if (= field 0)
           (set! (-> *multiplayer-preferences* network-port) (the-as uint16 number))
           (set! (-> *multiplayer-preferences* respawn-delay-seconds) (the-as uint16 number)))))
      ((1)
       (when (or (> (length value) 6) (not (nonnull? (-> *multiplayer-preferences* room-code))))
         (return 0))
       (copy-string<-string (-> *multiplayer-preferences* room-code) value))
      ((2)
       (when (or (> (length value) 15) (not (nonnull? (-> *multiplayer-preferences* player-name))))
         (return 0))
       (copy-string<-string (-> *multiplayer-preferences* player-name) value))
      (else (return 0)))
    (return (save-multiplayer-preferences!)))
  0)

(define-extern *multiplayer-options-pc* menu-option-list)

(define-extern can-change-player-character? (function symbol))
(define-extern draw-generic-stacked-option-label (function menu-generic-option progress font-context int symbol none))

(defun can-edit-host-options? ()
  (or (not (mp-session-active?)) (= (pc-multi-is-lobby-host) 1)))

(defun get-host-rule-value ((field int))
  (when (and (mp-session-active?) (not (mp-session-host?)) (nonnull? *mp-world-state*))
    (case field
      ((0) (return (the int (-> *mp-world-state* friendly-fire))))
      ((1) (return (the int (-> *mp-world-state* player-collision))))
      ((2) (return (the int (-> *mp-world-state* respawn-delay-seconds))))))
  (when (nonnull? *multiplayer-preferences*)
    (case field
      ((0) (return (the int (-> *multiplayer-preferences* friendly-fire))))
      ((1) (return (the int (-> *multiplayer-preferences* player-collision))))
      ((2) (return (the int (-> *multiplayer-preferences* respawn-delay-seconds))))))
  0)

(defun reset-multiplayer-option-defaults! ((scope int))
  (when (nonnull? *multiplayer-preferences*)
    (case scope
      ((1)
       (set! (-> *multiplayer-preferences* nametag-visibility) (the-as uint8 (player-nametag-visibility hold)))
       (set! (-> *multiplayer-preferences* player-map-marker) 1))
      ((2)
       (unless (can-edit-host-options?) (return (the-as none 0)))
       (set! (-> *multiplayer-preferences* friendly-fire) 0)
       (set! (-> *multiplayer-preferences* player-collision) 0)
       (set! (-> *multiplayer-preferences* respawn-delay-seconds) 20))
      ((3)
       (when (mp-session-active?) (return (the-as none 0)))
       (set! (-> *multiplayer-preferences* network-port) 26210)
       (set! (-> *multiplayer-preferences* automatic-port-mapping) 1)
       (set! (-> *multiplayer-preferences* session-player-limit) 2)
       (when (nonnull? (-> *multiplayer-preferences* room-code))
         (clear (-> *multiplayer-preferences* room-code)))))
    (save-multiplayer-preferences!)
    (mp-sync-preferences-to-session-host-config!)
    (refresh-generic-text-fields! *multiplayer-options-pc*))
  (none))

(deftype menu-player-character-option (menu-generic-boolean-option) ())

(defmethod draw-option ((option menu-player-character-option)
                        (progress progress) (context font-context) (index int) (selected? symbol))
  (when (nonnull? option progress context)
    (if (not (can-change-player-character?))
        (begin
          (draw-generic-stacked-option-label option progress context index #f)
          (set! (-> context scale) 0.30)
          (print-game-text (lookup-text! *common-text* (text-id progress-multiplayer-character-unavailable) #f)
                           context #f 44 (bucket-id progress)))
        ((method-of-type menu-generic-boolean-option draw-option)
          option progress context index selected?)))
  (none))

(defun get-options-scrolling-page ((menu-list menu-option-list))
  (when (and (nonnull? menu-list (-> menu-list options)) (> (-> menu-list options length) 0))
    (let ((page (-> menu-list options 0)))
      (when (and (nonnull? page) (type? page menu-generic-scrolling-page))
        (return (the-as menu-generic-scrolling-page page)))))
  (the-as menu-generic-scrolling-page #f))

(defun mp-reset-multiplayer-options-selection! ()
  (let ((page (get-options-scrolling-page *multiplayer-options-pc*)))
    (when (nonnull? page)
      (set! (-> page selected-option-index) -1)))
  (none))

(define-extern mp-load-multiplayer-options! (function none))

(defun load-host-options-page! ()
  (let ((root (get-options-scrolling-page *multiplayer-options-pc*)))
    (when (and (nonnull? root (-> root menu-options)) (> (-> root menu-options length) 0))
      (let* ((link (the-as menu-generic-link-option (-> root menu-options (- (-> root menu-options length) 1))))
             (page (get-options-scrolling-page (if (nonnull? link) (-> link target) (the-as menu-option-list #f)))))
        (when (nonnull? page (-> page menu-options))
          (set! (-> page menu-options length) (if (mp-session-active?) 4 5))))))
  (mp-load-multiplayer-options!)
  (none))

(defun mp-load-multiplayer-options! ()
  (mp-sync-preferences-to-session-host-config!)
  (refresh-generic-text-fields! *multiplayer-options-pc*)
  (mp-reset-multiplayer-options-selection!)
  (when (nonnull? *progress-process* (-> *progress-process* 0))
    (set! (-> (-> *progress-process* 0) selected-option) #f))
  (none))

(define *multiplayer-options-pc*
  (progress-new-generic-scrolling-page (text-id progress-multiplayer-options)
    (new 'static 'menu-generic-text-field-option
      :name (text-id progress-player-name)
      :field 2
      :get-value-fn (lambda ((field int)) (get-multiplayer-preference-text field))
      :set-value-fn (lambda ((field int) (value string)) (set-multiplayer-preference-text! field value))
      :max-bytes 15
      :allowed-characters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
      :uppercase? #f
      :session (new 'static 'pc-text-input-session))
    (new 'static 'menu-generic-button-option
      :name (text-id progress-lobby-color-title)
      :on-confirm (lambda ((the-progress progress))
        (mp-player-color-progress-enter! the-progress)))
    (new 'static 'menu-player-character-option
      :name (text-id progress-multiplayer-preferred-character)
      :should-disable? (lambda () (not (can-change-player-character?)))
      :truthy-text (text-id progress-multiplayer-char-jak)
      :falsey-text (text-id progress-multiplayer-char-daxter)
      :get-value-fn (lambda ()
        (and (nonnull? *multiplayer-preferences*)
             (= (-> *multiplayer-preferences* preferred-character) (mp-player-character jak))))
      :on-confirm (lambda ((value symbol))
        (when (and (nonnull? *multiplayer-preferences*) (can-change-player-character?))
          (set! (-> *multiplayer-preferences* preferred-character)
                (the-as uint8 (if value (mp-player-character jak) (mp-player-character daxter))))
          (save-multiplayer-preferences!))
        (none)))
    (new 'static 'menu-generic-choice-option
      :name (text-id progress-multiplayer-nametag-visibility)
      :items (new 'static 'boxed-array :type text-id
        (text-id progress-multiplayer-nametag-always)
        (text-id progress-multiplayer-nametag-hold)
        (text-id progress-off))
      :get-item-index-fn (lambda ()
        (if (nonnull? *multiplayer-preferences*)
            (the int (-> *multiplayer-preferences* nametag-visibility))
            (the int (player-nametag-visibility hold))))
      :on-confirm (lambda ((index int) (the-progress progress))
        (when (nonnull? *multiplayer-preferences*)
          (set! (-> *multiplayer-preferences* nametag-visibility) (the-as uint8 index))
          (save-multiplayer-preferences!))
        (none)))
    (new 'static 'menu-generic-boolean-option
      :name (text-id progress-multiplayer-player-map-marker)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda ()
        (and (nonnull? *multiplayer-preferences*)
             (= (-> *multiplayer-preferences* player-map-marker) 1)))
      :on-confirm (lambda ((value symbol))
        (when (nonnull? *multiplayer-preferences*)
          (set! (-> *multiplayer-preferences* player-map-marker) (the-as uint8 (if value 1 0)))
          (save-multiplayer-preferences!))
        (none)))
    (progress-new-generic-link-to-scrolling-page (text-id progress-multiplayer-host-options)
      :on-load (lambda () (load-host-options-page!))
      (new 'static 'menu-generic-boolean-option
        :should-disable? (lambda () (not (can-edit-host-options?)))
        :name (text-id progress-multiplayer-friendly-fire)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda ()
          (= (get-host-rule-value 0) 1))
        :on-confirm (lambda ((value symbol))
          (when (nonnull? *multiplayer-preferences*)
            (set! (-> *multiplayer-preferences* friendly-fire) (the-as uint8 (if value 1 0)))
            (save-multiplayer-preferences!))
          (none)))
      (new 'static 'menu-generic-boolean-option
        :should-disable? (lambda () (not (can-edit-host-options?)))
        :name (text-id progress-multiplayer-player-collision)
        :truthy-text (text-id progress-on)
        :falsey-text (text-id progress-off)
        :get-value-fn (lambda ()
          (= (get-host-rule-value 1) 1))
        :on-confirm (lambda ((value symbol))
          (when (nonnull? *multiplayer-preferences*)
            (set! (-> *multiplayer-preferences* player-collision) (the-as uint8 (if value 1 0)))
            (save-multiplayer-preferences!))
          (none)))
      (new 'static 'menu-generic-text-field-option
        :should-disable? (lambda () (not (can-edit-host-options?)))
        :name (text-id progress-multiplayer-respawn-delay)
        :zero-value-label (text-id progress-field-disabled-label)
        :field 3
        :get-value-fn (lambda ((field int)) (get-multiplayer-preference-text field))
        :set-value-fn (lambda ((field int) (value string)) (set-multiplayer-preference-text! field value))
        :max-bytes 5
        :allowed-characters "0123456789"
        :session (new 'static 'pc-text-input-session))
      (new 'static 'menu-generic-button-option
        :name (text-id progress-multiplayer-reset-defaults)
        :should-disable? (lambda () (not (can-edit-host-options?)))
        :on-confirm (lambda ((the-progress progress)) (reset-multiplayer-option-defaults! 2)))
      (progress-new-generic-link-to-scrolling-page (text-id progress-multiplayer-connection-options)
        :on-load (lambda () (mp-load-multiplayer-options!))
        (new 'static 'menu-generic-carousel-option
          :name (text-id progress-multiplayer-max-players)
          :get-max-size-fn (lambda () (+ (the int MP_MAX_PLAYERS) -1))
          :get-item-label-fn (lambda ((index int))
            (format (clear *temp-string*)
                    (lookup-text! *common-text* (text-id progress-multiplayer-players-count-fmt) #f)
                    (+ index 2))
            *temp-string*)
          :get-item-index-fn (lambda ()
            (+ (the int *mp-session-player-limit*) -2))
          :on-confirm (lambda ((index int) (the-progress progress))
            (let ((limit (+ index 2)))
              (mp-set-session-player-limit! (the uint limit))
              (when (nonnull? *multiplayer-preferences*)
                (set! (-> *multiplayer-preferences* session-player-limit) (the-as uint8 limit))
                (save-multiplayer-preferences!)))
            (none)))
        (new 'static 'menu-generic-text-field-option
          :name (text-id progress-port)
          :field 0
          :get-value-fn (lambda ((field int)) (get-multiplayer-preference-text field))
          :set-value-fn (lambda ((field int) (value string)) (set-multiplayer-preference-text! field value))
          :max-bytes 5
          :allowed-characters "0123456789"
          :session (new 'static 'pc-text-input-session))
        (new 'static 'menu-generic-text-field-option
          :name (text-id progress-multiplayer-room-code)
          :field 1
          :get-value-fn (lambda ((field int)) (get-multiplayer-preference-text field))
          :set-value-fn (lambda ((field int) (value string)) (set-multiplayer-preference-text! field value))
          :max-bytes 6
          :allowed-characters "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
          :uppercase? #t
          :session (new 'static 'pc-text-input-session))
        (new 'static 'menu-generic-boolean-option
          :name (text-id progress-multiplayer-auto-port-mapping)
          :truthy-text (text-id progress-on)
          :falsey-text (text-id progress-off)
          :get-value-fn (lambda ()
            (and (nonnull? *multiplayer-preferences*) (= (-> *multiplayer-preferences* automatic-port-mapping) 1)))
          :on-confirm (lambda ((value symbol))
            (when (nonnull? *multiplayer-preferences*)
              (set! (-> *multiplayer-preferences* automatic-port-mapping) (the-as uint8 (if value 1 0)))
              (save-multiplayer-preferences!))
            (none)))
        (new 'static 'menu-generic-button-option
          :name (text-id progress-multiplayer-reset-defaults)
          :on-confirm (lambda ((the-progress progress)) (reset-multiplayer-option-defaults! 3)))))))
