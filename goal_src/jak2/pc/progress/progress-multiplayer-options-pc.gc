;;-*-Lisp-*-
(in-package goal)

#|@file
Dedicated Multiplayer Options page. Persistent values live in the C++
multiplayer-settings.json store and are committed when editing finishes.
|#

(defun-extern pc-get-last-key uint)
(defun-extern draw-generic-highlight int int float pointer)
(defun-extern draw-generic-simple-string-option menu-generic-option progress font-context int string none)
(define-extern mp-player-color-progress-enter! (function progress none))

(deftype menu-multiplayer-player-name-option (menu-generic-option) ())
(deftype menu-multiplayer-setting-field-option (menu-generic-option)
  ((field int32)))
(deftype menu-multiplayer-player-character-boolean-option (menu-generic-boolean-option)
  ((player-id int32)))

(define *mp-preference-port-display* (the-as string #f))
(define *mp-preference-room-code-display* (the-as string #f))
(define *mp-preference-player-name-display* (the-as string #f))

(defun mp-refresh-preference-field! ((field int))
  (let ((display (pc-multi-get-preference-field field)))
    (when (and display (nonzero? (the-as uint display)))
      (if (= field 0)
          (set! *mp-preference-port-display* display)
          (if (= field 1)
              (set! *mp-preference-room-code-display* display)
              (set! *mp-preference-player-name-display* display)))
      )
    )
  (none))

(defun mp-refresh-preference-fields! ()
  (mp-refresh-preference-field! 0)
  (mp-refresh-preference-field! 1)
  (mp-refresh-preference-field! 2)
  (none))

(defun mp-load-multiplayer-options! ()
  (pc-multi-discard-preference-edits)
  (mp-sync-preferences-to-session-host-config!)
  (mp-refresh-preference-fields!)
  (none))

(defun mp-player-name-finish-edit! ((p progress))
  (when (and p (nonzero? (the-as uint p)))
    (if (= (pc-multi-commit-preference-field 2) 1)
        (begin
          (mp-refresh-preference-field! 2)
          (set! (-> p selected-option) #f)
          (sound-play "generic-beep"))
        (sound-play "menu-error"))
    )
  (none))

(defun mp-player-name-edit! ((p progress) (key uint))
  (when (and p
             (nonzero? (the-as uint p))
             (= (pc-multi-edit-preference-field 2 key) 1))
    (mp-refresh-preference-field! 2)
    )
  (none))

(defmethod respond-progress ((obj menu-multiplayer-player-name-option)
                             (p progress) (selected? symbol))
  (when (and selected?
             obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p)))
    (let ((key (pc-get-last-key)))
      (cond
        ((cpad-pressed? 0 confirm)
         (mp-player-name-finish-edit! p))
        ((or (= key #x0d) (= key #x0a))
         (mp-player-name-finish-edit! p))
        ((nonzero? key)
         (mp-player-name-edit! p key)))
      )
    )
  0)

(defmethod draw-option ((obj menu-multiplayer-player-name-option)
                        (p progress) (font-ctx font-context)
                        (option-index int) (selected? symbol))
  (when (and obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx))
             *mp-preference-player-name-display*
             (nonzero? (the-as uint *mp-preference-player-name-display*)))
    (format (clear *temp-string*) "~S: ~S"
            (lookup-text! *common-text* (text-id progress-username) #f)
            *mp-preference-player-name-display*)
    (draw-generic-simple-string-option obj p font-ctx option-index *temp-string*)
      )
  (none))

(defun mp-preference-field-display ((field int))
  (if (= field 0)
      *mp-preference-port-display*
      *mp-preference-room-code-display*))

(defun mp-preference-field-label ((field int))
  (if (= field 0)
      (text-id progress-multiplayer-network-port)
      (text-id progress-multiplayer-room-code)))

(defun mp-commit-preference-field! ((field int) (p progress))
  (when (and p (nonzero? (the-as uint p)))
    (if (= (pc-multi-commit-preference-field field) 1)
        (begin
          (mp-refresh-preference-field! field)
          (set! (-> p selected-option) #f)
          (sound-play "generic-beep"))
        (sound-play "menu-error"))
    )
  (none))

(defmethod respond-progress ((obj menu-multiplayer-setting-field-option)
                             (p progress) (selected? symbol))
  (when (and selected?
             obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p)))
    (let ((field (-> obj field))
          (key (pc-get-last-key)))
      (cond
        ((cpad-pressed? 0 confirm)
         (mp-commit-preference-field! field p))
        ((or (= key #x0d) (= key #x0a))
         (mp-commit-preference-field! field p))
        ((nonzero? key)
         (when (= (pc-multi-edit-preference-field field key) 1)
           (mp-refresh-preference-field! field)))
        )
      )
    )
  0)

(defmethod draw-option ((obj menu-multiplayer-setting-field-option)
                        (p progress) (font-ctx font-context)
                        (option-index int) (selected? symbol))
  (when (and obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (let ((display (mp-preference-field-display (-> obj field)))
          (label (mp-preference-field-label (-> obj field))))
      (when (and display (nonzero? (the-as uint display)))
        (format (clear *temp-string*) "~S: ~S"
                (lookup-text! *common-text* label #f)
                display)
        (draw-generic-simple-string-option obj p font-ctx option-index *temp-string*)
        )
      )
    )
  (none))

(defmethod draw-option ((obj menu-multiplayer-player-character-boolean-option)
                        (arg0 progress)
                        (font-ctx font-context)
                        (option-index int)
                        (selected? symbol))
  (when (and obj (nonzero? (the-as uint obj))
             arg0 (nonzero? (the-as uint arg0))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (when (not (-> obj mounted?))
      (on-mount! obj))
    (let ((alpha (fmax (* 2.0 (- 0.5 (-> arg0 menu-transition))) 0.0))
          (line-height 18.0))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.45)
      (+! (-> font-ctx origin y) (if (= (get-aspect-ratio) 'aspect4x3) 7.0 5.0))
      (format (clear *temp-string*)
              (lookup-text! *common-text* (text-id progress-multiplayer-player-char-fmt) #f)
              (+ (-> obj player-id) 1))
      (cond
        (selected?
          (set-color! font-ctx (font-color progress-force-selected))
          (draw-generic-highlight (the int (- (-> font-ctx origin y) 2.0)) 33 alpha)
          (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
          (+! (-> font-ctx origin y) line-height)
          (set! *progress-generic-temp-string* (clear *progress-generic-temp-string*))
          (if (-> obj value)
              (format *progress-generic-temp-string* "~33L~S~35L ~S" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
              (format *progress-generic-temp-string* "~35L~S ~33L~S~1L" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))))
        (else
          (cond
            ((and (nonzero? (-> obj should-disable?))
                  (!= (-> obj should-disable?) #f)
                  ((-> obj should-disable?)))
             (set-color! font-ctx (font-color progress-option-off))
             (when (= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
               (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 18 (* 0.5 alpha))))
            ((= option-index (-> *progress-pc-generic-store* current-menu-hover-index))
             (set-color! font-ctx (progress-selected 0))
             (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 18 alpha))
            (else
             (set-color! font-ctx (font-color progress))))
          (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
          (+! (-> font-ctx origin y) line-height)
          (set! *progress-generic-temp-string* (clear *progress-generic-temp-string*))
          (let ((actual-value (call-get-value-fn obj)))
            (if actual-value
                (format *progress-generic-temp-string* "~1L~S~35L ~S" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))
                (format *progress-generic-temp-string* "~35L~S ~1L~S~1L" (lookup-text! *common-text* (-> obj truthy-text) #f) (lookup-text! *common-text* (-> obj falsey-text) #f))))))
      (set-scale! font-ctx 0.35)
      (print-game-text *progress-generic-temp-string* font-ctx #f 44 (bucket-id progress))
      )
    )
  (none))

(define *multiplayer-options-pc*
  (progress-new-generic-scrolling-page (text-id progress-multiplayer-options)
    (new 'static 'menu-multiplayer-player-name-option
      :name (text-id progress-username))
    (new 'static 'menu-generic-button-option
      :name (text-id progress-lobby-color-title)
      :on-confirm (lambda ((the-progress progress))
        (mp-player-color-progress-enter! the-progress)))
    (new 'static 'menu-generic-carousel-option
      :name (text-id progress-multiplayer-max-players)
      :get-max-size-fn (lambda () (+ (the int MP_MAX_PLAYERS) -1))
      :get-item-label-fn (lambda ((index int))
        (format (clear *temp-string*)
                (lookup-text! *common-text* (text-id progress-multiplayer-players-count-fmt) #f)
                (+ index 2))
        *temp-string*)
      :get-item-index-fn (lambda ()
        (+ (the int *mp-session-player-limit*) -2))
      :on-confirm (lambda ((index int) (the-progress progress))
        (let ((limit (+ index 2)))
          (mp-set-session-player-limit! (the uint limit))
          (pc-multi-set-preference-player-limit (the uint limit)))))
    (progress-new-generic-link-to-scrolling-page (text-id progress-multiplayer-player-chars)
      (new 'static 'menu-multiplayer-player-character-boolean-option
        :player-id 0
        :truthy-text (text-id progress-multiplayer-char-jak)
        :falsey-text (text-id progress-multiplayer-char-daxter)
        :get-value-fn (lambda () (= (mp-session-player-character (the uint 0)) (mp-player-character jak)))
        :on-confirm (lambda ((val symbol))
          (let ((chosen (if val (mp-player-character jak) (mp-player-character daxter))))
            (mp-set-session-player-character! (the uint 0) chosen)
            (pc-multi-set-preference-player-character (the uint 0) (the uint chosen)))))
      (new 'static 'menu-multiplayer-player-character-boolean-option
        :player-id 1
        :truthy-text (text-id progress-multiplayer-char-jak)
        :falsey-text (text-id progress-multiplayer-char-daxter)
        :get-value-fn (lambda () (= (mp-session-player-character (the uint 1)) (mp-player-character jak)))
        :on-confirm (lambda ((val symbol))
          (let ((chosen (if val (mp-player-character jak) (mp-player-character daxter))))
            (mp-set-session-player-character! (the uint 1) chosen)
            (pc-multi-set-preference-player-character (the uint 1) (the uint chosen)))))
      (new 'static 'menu-multiplayer-player-character-boolean-option
        :player-id 2
        :truthy-text (text-id progress-multiplayer-char-jak)
        :falsey-text (text-id progress-multiplayer-char-daxter)
        :should-disable? (lambda () (< *mp-session-player-limit* (the uint 3)))
        :get-value-fn (lambda () (= (mp-session-player-character (the uint 2)) (mp-player-character jak)))
        :on-confirm (lambda ((val symbol))
          (let ((chosen (if val (mp-player-character jak) (mp-player-character daxter))))
            (mp-set-session-player-character! (the uint 2) chosen)
            (pc-multi-set-preference-player-character (the uint 2) (the uint chosen)))))
      (new 'static 'menu-multiplayer-player-character-boolean-option
        :player-id 3
        :truthy-text (text-id progress-multiplayer-char-jak)
        :falsey-text (text-id progress-multiplayer-char-daxter)
        :should-disable? (lambda () (< *mp-session-player-limit* (the uint 4)))
        :get-value-fn (lambda () (= (mp-session-player-character (the uint 3)) (mp-player-character jak)))
        :on-confirm (lambda ((val symbol))
          (let ((chosen (if val (mp-player-character jak) (mp-player-character daxter))))
            (mp-set-session-player-character! (the uint 3) chosen)
            (pc-multi-set-preference-player-character (the uint 3) (the uint chosen))))))
    (new 'static 'menu-multiplayer-setting-field-option
      :name (text-id progress-multiplayer-network-port)
      :field 0)
    (new 'static 'menu-multiplayer-setting-field-option
      :name (text-id progress-multiplayer-room-code)
      :field 1)
    (new 'static 'menu-generic-boolean-option
      :name (text-id progress-multiplayer-auto-port-mapping)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (= (pc-multi-get-automatic-port-mapping) 1))
      :on-confirm (lambda ((value symbol))
        (pc-multi-set-automatic-port-mapping (if value 1 0))))
    (new 'static 'menu-generic-button-option
      :name (text-id progress-multiplayer-reset-defaults)
      :on-confirm (lambda ((the-progress progress))
        (pc-multi-reset-preferences)
        (mp-sync-preferences-to-session-host-config!)
        (mp-refresh-preference-fields!)
        (none)))))
