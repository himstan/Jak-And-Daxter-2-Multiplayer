(deftype menu-waiting-for-daxter-option (menu-option)
  ()
  )

(defun mp-progress-host-peer-ready? ()
  (= (pc-multi-get-status) (mp-connection-status connected-lobby))
  )

(defun mp-progress-advance-host-if-ready! ((p progress))
  (if (and p
           (nonzero? (the-as uint p))
           (mp-progress-host-peer-ready?)
           (not *multi-sync-enabled?*))
      (begin
        (sound-play "generic-beep")
        (pc-multi-set-status (mp-connection-status game-starting))
        (when (and *local-info* (nonzero? (the-as uint *local-info*)))
          (set! (-> *local-info* sync-flag) (the-as uint 0)))

        (debug-log *mp-debug-log?* "[MP-Host] Remote joined. Transitioning to engine loading flow...~%")
        (when (and *bigmap* (nonzero? *bigmap*))
          (set! (-> *bigmap* drawing-flag) #t)
          )
        (cond
          ((and *pc-settings*
                (nonzero? (the-as uint *pc-settings*))
                (-> *pc-settings* mp-is-new-game?)
                (< (-> *pc-settings* mp-selected-save-slot) 4))
           (set-next-state p 'saving 0)
           )
          ((and *pc-settings*
                (nonzero? (the-as uint *pc-settings*))
                (-> *pc-settings* mp-is-new-game?))
           (if (and *game-info* (nonzero? (the-as uint *game-info*)))
               (mp-progress-intro-start!
                 (logtest? (-> *game-info* purchase-secrets) (game-secrets hero-mode)))
               (mp-progress-intro-start! #f))
           )
          (else
            (set-next-state p 'loading 0)
            )
          )
        #t
        )
      #f
      )
    )

(defmethod respond-progress ((obj menu-waiting-for-daxter-option) (p progress) (selected? symbol))
  (mp-progress-advance-host-if-ready! p)
  0)

(defmethod draw-option ((obj menu-waiting-for-daxter-option) (p progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (when (and p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition)))))
          (setup-status (pc-multi-get-host-setup-status)))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.5)
      (+! (-> font-ctx origin y) 11.0)
      (if (< setup-status 0)
          (set-color! font-ctx (font-color red))
          (set-color! font-ctx (font-color progress)))
      (cond
        ((= setup-status 1)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-starting) #f)))
        ((= setup-status 2)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-configuring-router) #f)))
        ((= setup-status 3)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-waiting-for-daxter) #f)))
        ((= setup-status 4)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-unverified) #f)))
        ((= setup-status -1)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-automatic-failed) #f)))
        ((= setup-status -2)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-bind-failed) #f)))
        ((= setup-status -3)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-host-start-failed) #f)))
        (else
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-waiting-for-daxter) #f))))
      (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))))
  (none))

