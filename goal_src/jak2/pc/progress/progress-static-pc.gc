  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 25
    :scale 0.74
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-waiting-for-daxter-option)
      (new 'static 'menu-copy-host-access-option :name (text-id progress-copy-invite))
      )
    )
  )

(deftype menu-join-search-option (menu-option)
  ((last-status mp-connection-status)
   )
  )

(defun mp-connection-failure-text-id ((failure int))
  (cond
    ((= failure 1) (text-id progress-invalid-invite))
    ((= failure 2) (text-id progress-host-unreachable))
    ((= failure 3) (text-id progress-room-code-rejected))
    ((= failure 4) (text-id progress-host-full))
    ((= failure 5) (text-id progress-version-mismatch))
    ((= failure 6) (text-id progress-lan-search-timeout))
    ((= failure 7) (text-id progress-credential-discovery-failed))
    (else (text-id no-menu-data))))

(defun mp-connection-phase-text-id ((phase int))
  (cond
    ((= phase 1) (text-id progress-validating-invite))
    ((= phase 2) (text-id progress-contacting-host))
    ((= phase 3) (text-id progress-authenticating))
    ((= phase 4) (text-id progress-connected))
    (else (text-id progress-searching))))

(defmethod respond-progress ((obj menu-join-search-option) (p progress) (selected? symbol))
  (let ((status (pc-multi-get-status)))
    (when (!= status (-> obj last-status))
      (set! (-> obj last-status) status)
      (cond
        ((= status (mp-connection-status connected-lobby)) ;; Connected
         (sound-play "generic-beep")
         (set! *multi-sync-enabled?* #t)
         )
        )
      )
    )
  0)

(defmethod draw-option ((obj menu-join-search-option) (p progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition)))))
        (status (pc-multi-get-status)))
    (set! (-> font-ctx alpha) alpha)
    (set-flags! font-ctx (font-flags kerning middle large))
    (set-scale! font-ctx 0.6)
    (+! (-> font-ctx origin y) 11.0)
    (set-color! font-ctx (font-color progress))
    
    (if (or (= status (mp-connection-status version-mismatch)) *mp-version-mismatch-menu-active?*)
        (format (clear *temp-string*)
                (lookup-text! *common-text* (text-id progress-version-mismatch) #f)
                (mp-required-version-for-display))
        (let ((failure (pc-multi-get-connection-failure)))
          (let ((msg (if (!= failure 0)
                       (mp-connection-failure-text-id failure)
                       (mp-connection-phase-text-id (pc-multi-get-connection-phase)))))
            (format (clear *temp-string*) "~S" (lookup-text! *common-text* msg #f)))))
    (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
    )
  (none))

(defmethod respond-progress ((obj menu-version-mismatch-option) (p progress) (selected? symbol))
  0)

(defmethod draw-option ((obj menu-version-mismatch-option) (p progress)
                        (font-ctx font-context) (option-index int) (selected? symbol))
  (when (and p
             (nonzero? (the-as uint p))
             font-ctx
             (nonzero? (the-as uint font-ctx)))
    (let ((required-version (mp-required-version-for-display))
          (alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition))))))
      (when (and required-version
                 (nonzero? (the-as uint required-version)))
        (set! (-> font-ctx alpha) alpha)
        (set-flags! font-ctx (font-flags kerning middle large))
        (set-scale! font-ctx 0.52)
        (+! (-> font-ctx origin y) 11.0)
        (set-color! font-ctx (font-color progress))
        (format (clear *temp-string*)
                (lookup-text! *common-text* (text-id progress-version-mismatch) #f)
                required-version)
        (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
        )
      )
    )
  (none))

(defmethod respond-progress ((obj menu-version-mismatch-back-option) (p progress)
                             (selected? symbol))
  (when (and selected?
             p
             (nonzero? (the-as uint p)))
    (set! (-> p selected-option) #f)
    (sound-play "generic-beep")
    (set-next-state p 'join-game 0)
    )
  0)

