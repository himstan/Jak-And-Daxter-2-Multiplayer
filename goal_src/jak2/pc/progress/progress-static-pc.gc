      :name (text-id progress-hint-subtitles)
      :truthy-text (text-id progress-on)
      :falsey-text (text-id progress-off)
      :get-value-fn (lambda () (-> *pc-settings* hinttitles?))
      :on-confirm (lambda ((val symbol))
        (set! (-> *pc-settings* hinttitles?) val)
