;;-*-Lisp-*-
(in-package goal)

#|@file
Additional PC port specific file for overriding/expanding the progress menu
This gives us more freedom to write code how we want.
|#

(defun-extern mp-update-version-mismatch-ui! mp-connection-status none)

(defun mp-progress-intro-start! ((hero-mode? symbol))
  (set! (-> *game-info* mode) 'play)
  (if hero-mode?
      (initialize! *game-info* 'game (the-as game-save #f) "intro-start-hero")
      (initialize! *game-info* 'game (the-as game-save #f) "intro-start")
      )
  (set-master-mode 'game)
  0
  )

(deftype menu-username-option (menu-option)
  ()
  )

(defmethod respond-progress ((obj menu-username-option) (p progress) (selected? symbol))
  (if selected?
    (let ((key (pc-get-last-key)))
      (when (nonzero? key)
        (let ((s (-> *pc-settings* username)))
          (cond
            ;; Backspace
            ((= key #x08)
             (when (> (length s) 0)
               (set! (-> s data (dec (length s))) 0)
               ))
            ;; Enter/Return - finish editing
            ((or (= key #x0D) (= key #x0A))
             (set! (-> p selected-option) #f)
             )
            ;; Printable ASCII - Only allow letters and numbers for username
            ((and (or (and (>= key #x30) (<= key #x39))
                      (and (>= key #x41) (<= key #x5a))
                      (and (>= key #x61) (<= key #x7a)))
                  (< (length s) 16))
             (let ((len (length s)))
               (set! (-> s data len) key)
               (set! (-> s data (inc len)) 0)
               )
             )
            )
          )
        (pc-settings-save)
        )
      )
    )
  0)

(defmethod draw-option ((obj menu-username-option) (p progress) (font-ctx font-context) (option-index int) (selected? symbol))
  (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition)))))
        (username (-> *pc-settings* username)))
    (set! (-> font-ctx alpha) alpha)
    (set-flags! font-ctx (font-flags kerning middle large))
    (set-scale! font-ctx 0.5)
    (+! (-> font-ctx origin y) 11.0)
    (when (= option-index (-> p option-index))
       (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 18 alpha)
       )

    (set-color! font-ctx (font-color progress))
    (format (clear *temp-string*) "~S: ~S" (lookup-text! *common-text* (text-id progress-username) #f) username)
    (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
    )
  (none))

(deftype menu-paste-invite-option (menu-option) ())
(deftype menu-connect-invite-option (menu-option) ())
(deftype menu-copy-host-access-option (menu-option) ())
(deftype menu-invite-validation-option (menu-option) ())
(deftype menu-direct-field-option (menu-option)
  ((field int32))
  )
(deftype menu-direct-connect-option (menu-option) ())
(deftype menu-version-mismatch-option (menu-option) ())
(deftype menu-version-mismatch-back-option (menu-option) ())

(define *mp-version-resolution-attempted?* #f)
(define *mp-local-version-text* (the-as string #f))
(define *mp-direct-address-display* (the-as string #f))
(define *mp-direct-port-display* (the-as string #f))
(define *mp-direct-room-code-display* (the-as string #f))

(defun mp-refresh-direct-field! ((field int))
  (let ((display (pc-multi-get-direct-field field)))
    (when (and display (nonzero? (the-as uint display)))
      (cond
        ((= field 0) (set! *mp-direct-address-display* display))
        ((= field 1) (set! *mp-direct-port-display* display))
        ((= field 2) (set! *mp-direct-room-code-display* display))
        )
      )
    )
  (none)
  )

(defun mp-refresh-direct-fields! ()
  (mp-refresh-direct-field! 0)
  (mp-refresh-direct-field! 1)
  (mp-refresh-direct-field! 2)
  (none)
  )

(defun mp-clear-direct-connect-ui! ()
  (pc-multi-clear-direct-connect)
  (mp-refresh-direct-fields!)
  (none)
  )

(defun mp-reset-direct-connect-ui! ()
  (pc-multi-reset-direct-connect)
  (mp-refresh-direct-fields!)
  (none)
  )

(defun mp-direct-field-display ((field int))
  (cond
    ((= field 0) *mp-direct-address-display*)
    ((= field 1) *mp-direct-port-display*)
    ((= field 2) *mp-direct-room-code-display*)
    (else (the-as string #f))
    )
  )

(defun mp-direct-field-label ((field int))
  (cond
    ((= field 0) (text-id progress-ip-address))
    ((= field 1) (text-id progress-port))
    (else (text-id progress-multiplayer-room-code))
    )
  )

(defun mp-configure-bridge-version! ()
  (when (not *mp-version-resolution-attempted?*)
    (set! *mp-version-resolution-attempted?* #t)
    (if (and *mod-version-text*
             (nonzero? (the-as uint *mod-version-text*))
             (= (pc-multi-set-local-version *mod-version-text*) 1))
        (let ((resolved-version (pc-multi-get-local-version)))
          (when (and resolved-version
                     (nonzero? (the-as uint resolved-version))
                     (nonzero? (length resolved-version)))
            (set! *mp-local-version-text* resolved-version)
            )
          )
        (none)
        )
    (when (not (and *mp-local-version-text*
                    (nonzero? (the-as uint *mp-local-version-text*))
                    (nonzero? (length *mp-local-version-text*))))
      (format #t "[Multiplayer] Local mod version is unavailable.~%")
      )
    )
  (and *mp-local-version-text*
       (nonzero? (the-as uint *mp-local-version-text*))
       (nonzero? (length *mp-local-version-text*)))
  )

(defun mp-progress-local-version ()
  (if (mp-configure-bridge-version!)
      *mp-local-version-text*
      (the-as string #f))
  )

(defun mp-clear-version-mismatch-ui! ()
  (set! *mp-version-mismatch-menu-active?* #f)
  (set! *mp-required-version-text* (the-as string #f))
  (none)
  )

(defun mp-cache-required-version! ()
  (if (and *mp-required-version-text*
           (nonzero? (the-as uint *mp-required-version-text*))
           (nonzero? (length *mp-required-version-text*)))
      #t
      (let ((required-version (pc-multi-get-required-version)))
        (if (and required-version
                 (nonzero? (the-as uint required-version))
                 (nonzero? (length required-version)))
            (begin
              (set! *mp-required-version-text* required-version)
              #t
              )
            #f
            )
        ))
  )

(defun mp-required-version-for-display ()
  (if (mp-cache-required-version!)
      *mp-required-version-text*
      (the-as string #f))
  )

(defun mp-draw-invite-action ((label text-id) (status int) (show-status? symbol)
                              (p progress) (font-ctx font-context) (option-index int))
  (when (and p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (let ((alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition))))))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.5)
      (+! (-> font-ctx origin y) 11.0)
      (when (= option-index (-> p option-index))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 18 alpha))
      (if (< status 0)
          (set-color! font-ctx (font-color red))
          (set-color! font-ctx (font-color progress)))
      (cond
        ((and show-status? (= status 1))
         (format (clear *temp-string*) "~S: ~S"
                 (lookup-text! *common-text* label #f)
                 (lookup-text! *common-text* (text-id progress-invite-ready) #f)))
        ((and show-status? (= status -1))
         (format (clear *temp-string*) "~S: ~S"
                 (lookup-text! *common-text* label #f)
                 (lookup-text! *common-text* (text-id progress-invalid-invite) #f)))
        (else
         (format (clear *temp-string*) "~S" (lookup-text! *common-text* label #f))))
      (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))))
  (none))

(defmethod respond-progress ((obj menu-paste-invite-option) (p progress) (selected? symbol))
  (when (and selected? p (nonzero? (the-as uint p)))
    (set! (-> p selected-option) #f)
    (if (= (pc-multi-stage-clipboard-invite) 1)
        (sound-play "generic-beep")
        (sound-play "menu-error")))
  0)

(defmethod draw-option ((obj menu-paste-invite-option) (p progress) (font-ctx font-context)
                        (option-index int) (selected? symbol))
  (mp-draw-invite-action (text-id progress-paste-invite)
                         (pc-multi-get-staged-invite-status) #t p font-ctx option-index))

(defmethod respond-progress ((obj menu-invite-validation-option)
                             (p progress) (selected? symbol))
  0)

(defmethod draw-option ((obj menu-invite-validation-option) (p progress)
                        (font-ctx font-context) (option-index int) (selected? symbol))
  (when (and p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (let ((status (pc-multi-get-staged-invite-status))
          (alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition))))))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.46)
      (+! (-> font-ctx origin y) 11.0)
      (if (= status -1)
          (set-color! font-ctx (font-color red))
          (set-color! font-ctx (font-color progress)))
      (cond
        ((= status 1)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-invite-ready) #f)))
        ((= status -1)
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-invalid-invite) #f)))
        (else
         (format (clear *temp-string*) "~S"
                 (lookup-text! *common-text* (text-id progress-invite-not-pasted) #f))))
      (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
      )
    )
  (none))

(defmethod respond-progress ((obj menu-connect-invite-option) (p progress) (selected? symbol))
  (when (and selected? p (nonzero? (the-as uint p)))
    (set! (-> p selected-option) #f)
    (if (= (pc-multi-get-staged-invite-status) 1)
        (begin
          (sound-play "generic-beep")
          (set-next-state p 'connecting-invite 0))
        (sound-play "menu-error")))
  0)

(defmethod draw-option ((obj menu-connect-invite-option) (p progress) (font-ctx font-context)
                        (option-index int) (selected? symbol))
  (mp-draw-invite-action (text-id progress-connect)
                         (if (= (pc-multi-get-staged-invite-status) 1) 0 -1)
                         #f p font-ctx option-index))

(defmethod respond-progress ((obj menu-direct-field-option) (p progress) (selected? symbol))
  (when (and selected?
             obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p)))
    (let ((key (pc-get-last-key)))
      (when (nonzero? key)
        (if (or (= key #x0d) (= key #x0a))
            (set! (-> p selected-option) #f)
            (let ((edit-result (pc-multi-edit-direct-field (-> obj field) key)))
              (cond
                ((= edit-result 1) (mp-refresh-direct-field! (-> obj field)))
                ((= edit-result -1) (sound-play "menu-error"))
                )
              )
            )
        )
      )
    )
  0
  )

(defmethod draw-option ((obj menu-direct-field-option) (p progress)
                        (font-ctx font-context) (option-index int) (selected? symbol))
  (when (and obj (nonzero? (the-as uint obj))
             p (nonzero? (the-as uint p))
             font-ctx (nonzero? (the-as uint font-ctx)))
    (let ((display (mp-direct-field-display (-> obj field)))
          (alpha (max 0.0 (* 2.0 (- 0.5 (-> p menu-transition))))))
      (set! (-> font-ctx alpha) alpha)
      (set-flags! font-ctx (font-flags kerning middle large))
      (set-scale! font-ctx 0.48)
      (+! (-> font-ctx origin y) 11.0)
      (when (= option-index (-> p option-index))
        (draw-generic-highlight (the int (+ -2.0 (-> font-ctx origin y))) 18 alpha)
        )
      (set-color! font-ctx (font-color progress))
      (format (clear *temp-string*) "~S: ~S"
              (lookup-text! *common-text* (mp-direct-field-label (-> obj field)) #f)
              display)
      (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))
      )
    )
  (none)
  )

(defmethod respond-progress ((obj menu-direct-connect-option) (p progress) (selected? symbol))
  (when (and selected? p (nonzero? (the-as uint p)))
    (set! (-> p selected-option) #f)
    (if (= (pc-multi-direct-connect-ready) 1)
        (begin
          (sound-play "generic-beep")
          (set-next-state p 'direct-searching 0)
          )
        (sound-play "menu-error")
        )
    )
  0
  )

(defmethod draw-option ((obj menu-direct-connect-option) (p progress)
                        (font-ctx font-context) (option-index int) (selected? symbol))
  (mp-draw-invite-action (text-id progress-connect)
                         (if (= (pc-multi-direct-connect-ready) 1) 0 -1)
                         #f p font-ctx option-index)
  )

(defmethod respond-progress ((obj menu-copy-host-access-option) (p progress) (selected? symbol))
  (when (and selected? p (nonzero? (the-as uint p)))
    (set! (-> p selected-option) #f)
    (if (= (pc-multi-copy-host-access) 1)
        (sound-play "generic-beep")
        (sound-play "menu-error")
        )
    )
  0
  )

(defmethod draw-option ((obj menu-copy-host-access-option) (p progress) (font-ctx font-context)
                        (option-index int) (selected? symbol))
  (let ((copy-mode (pc-multi-get-host-copy-mode)))
    (when (!= copy-mode 0)
      (mp-draw-invite-action (if (= copy-mode 1)
                                 (text-id progress-copy-invite)
                                 (text-id progress-copy-room-code))
                             0 #f p font-ctx option-index)))
  (none))

(define *title-pc*
  (new 'static 'menu-option-list
    :y-center #xc6
    :y-space 30
    :scale 0.82
    :options (new 'static 'boxed-array :type menu-option
      (new 'static 'menu-sub-menu-option
        :name (text-id progress-host-game)
        :scale #t
        :next-state 'host-mode
        )
      (new 'static 'menu-sub-menu-option
        :name (text-id progress-join-game)
        :scale #t
        :next-state 'join-game
        )
      (new 'static 'menu-sub-menu-option
        :name (text-id progress-title-options)
        :scale #t
        :next-state 'title-options
        )
      (new 'static 'menu-sub-menu-option
        :name (text-id progress-root-secrets)
        :scale #t
        :next-state 'unlocked-secrets
        )
      (new 'static 'menu-exit-game-option
        :name (text-id progress-quit)
        :scale #f
        )
      )
    )
  )

(define *sound-options-pc*
  (progress-new-generic-scrolling-page (text-id progress-root-sound-options)
    (new 'static 'menu-generic-slider-option
        :name (text-id progress-sound-sfx-volume)
        :min-value 0.0
        :max-value 1.0
        :step 0.01
        :show-decimal? #t
        :get-value-fn (lambda () (-> *pc-settings* memcard-volume-sfx))
        :on-confirm (lambda ((val float))
          (set! (-> *pc-settings* memcard-volume-sfx) val)
          (pc-settings-save)
          (set! (-> *setting-control* user-default sfx-volume) val)))
    (new 'static 'menu-generic-slider-option
        :name (text-id progress-sound-music-volume)
        :min-value 0.0
        :max-value 1.0
        :step 0.01
        :show-decimal? #t
        :get-value-fn (lambda () (-> *pc-settings* memcard-volume-music))
        :on-confirm (lambda ((val float))
          (set! (-> *pc-settings* memcard-volume-music) val)
          (pc-settings-save)
          (set! (-> *setting-control* user-default music-volume) val)))
    (new 'static 'menu-generic-slider-option
        :name (text-id progress-sound-speech-volume)
        :min-value 0.0
        :max-value 1.0
        :step 0.01
        :show-decimal? #t
        :get-value-fn (lambda () (-> *pc-settings* memcard-volume-dialog))
        :on-confirm (lambda ((val float))
          (set! (-> *pc-settings* memcard-volume-dialog) val)
          (pc-settings-save)
          (set! (-> *setting-control* user-default dialog-volume) val)))
    (new 'static 'menu-generic-carousel-option
        :name (text-id progress-sound-format)
        :get-max-size-fn (lambda () 3)
        :get-item-label-fn (lambda ((index int))
          (case index
            ((0) (lookup-text! *common-text* (text-id progress-sound-mono) #f))
            ((1) (lookup-text! *common-text* (text-id progress-sound-stereo) #f))
            ((2) (lookup-text! *common-text* (text-id progress-sound-surround) #f))))
        :get-item-index-fn (lambda () (-> *setting-control* user-default stereo-mode))
        :on-confirm (lambda ((index int) (the-progress progress)) (set! (-> *setting-control* user-default stereo-mode) index)))))

