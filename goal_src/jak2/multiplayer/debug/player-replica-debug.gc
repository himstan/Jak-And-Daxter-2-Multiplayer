;;-*-Lisp-*-
(in-package goal)

(defun draw-player-replica-debug ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((proc (mp-player-record-target record))
          (target-record (get-player-target-record record))
          (draw-pos (new 'stack-no-clear 'vector)))
      (when (and target-record (nonzero? target-record) (-> target-record active?))
        (add-debug-sphere #t (bucket-id debug-no-zbuf1) (-> target-record trans) (meters 0.5) (static-rgba 255 255 0 128))
        (vector-copy! draw-pos (-> target-record trans))
        (+! (-> draw-pos y) (meters 2.0))
        (let ((state-sym (mp-target-get-state-from-id (-> target-record state-id))))
          (add-debug-text-3d #t
                             (bucket-id debug-no-zbuf1)
                             (if state-sym (symbol->string state-sym) "none")
                             draw-pos
                             (font-color yellow)
                             (the-as vector2h #f)))
        (add-debug-text-3d #t
                           (bucket-id debug-no-zbuf1)
                           "RECORD"
                           (-> target-record trans)
                           (font-color yellow)
                           (the-as vector2h #f)))
      (when (and proc (nonzero? proc) (-> proc control) (nonzero? (-> proc control)))
        (let ((replica-pos (-> proc control trans)))
          (vector-copy! draw-pos replica-pos)
          (+! (-> draw-pos y) (meters 2.5))
          (let ((curr-state (-> proc state)))
            (add-debug-text-3d #t
                               (bucket-id debug-no-zbuf1)
                               (if (and curr-state (nonzero? curr-state)) (symbol->string (-> curr-state name)) "unknown")
                               draw-pos
                               (font-color green)
                               (the-as vector2h #f)))
          (add-debug-text-3d #t (bucket-id debug-no-zbuf1) "REPLICA" replica-pos (font-color green) (the-as vector2h #f))
          (let ((pad (-> proc control cpad))
                (debug-str *temp-string*))
            (when (and pad (nonzero? pad))
              (format debug-str "PAD: BTNS #x~X LX ~D LY ~D" (-> pad button0) (-> pad leftx) (-> pad lefty))
              (vector-copy! draw-pos replica-pos)
              (+! (-> draw-pos y) (meters 1.5))
              (add-debug-text-3d #t
                                 (bucket-id debug-no-zbuf1)
                                 debug-str
                                 draw-pos
                                 (font-color cyan)
                                 (the-as vector2h #f))
              (format debug-str "STK: SPD ~f DIR ~f" (-> pad stick0-speed) (-> pad stick0-dir))
              (+! (-> draw-pos y) (meters -0.3))
              (add-debug-text-3d #t
                                 (bucket-id debug-no-zbuf1)
                                 debug-str
                                 draw-pos
                                 (font-color cyan)
                                 (the-as vector2h #f))))
          (when (and target-record (nonzero? target-record) (-> target-record active?))
            (add-debug-line #t
                            (bucket-id debug-no-zbuf1)
                            replica-pos
                            (-> target-record trans)
                            (static-rgba 255 255 255 128)
                            #f
                            (the-as rgba 0)))))))
  (none))

(defun draw-replica-debug ()
  (when *player-replica-debug?*
    (mp-player-controller-for-each-remote! *mp-player-controller* draw-player-replica-debug))
  (none))
