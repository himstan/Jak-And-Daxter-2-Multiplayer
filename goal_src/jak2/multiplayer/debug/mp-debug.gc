;;-*-Lisp-*-
(in-package goal)

(defun debug-state-name ((proc process))
  (if (and proc (nonzero? proc) (-> proc state) (nonzero? (-> proc state))) (-> proc state name) 'none))

(defun debug-next-state-name ((proc process))
  (if (and proc (nonzero? proc) (-> proc next-state) (nonzero? (-> proc next-state))) (-> proc next-state name) 'none))

(defun mp-debug-session-role-name ()
  (cond
    ((mp-session-host?) "HOST")
    ((mp-session-client?) "CLIENT")
    (else "OFFLINE")))

(defun mp-debug-player-character-name ((record mp-player-record))
  (cond
    ((mp-player-jak? record) "JAK")
    ((mp-player-daxter? record) "DAXTER")
    (else "UNKNOWN")))

(defun draw-boss-state-debug ((label string) (slot mp-replication-boss-state))
  (format *stdcon*
          "~S: kind:~D state:~S stage:~D~%"
          label
          (-> slot kind)
          (boss-state-name (boss-kind-states (-> slot kind)) (-> slot state-id))
          (-> slot stage))
  (format *stdcon*
          "  health:~,,2f shield:~,,2f target:~D entry:~D~%"
          (-> slot health)
          (-> slot shield)
          (-> slot target-player-slot)
          (-> slot state-entry))
  (none))

(defun mp-draw-boss-debug ()
  (when *mp-debug-boss*
    (format *stdcon* "~0k--- MP BOSS DEBUG (~S) ---~%" (mp-debug-session-role-name))
    (draw-boss-state-debug "LOCAL" (local-boss-state))
    (draw-boss-state-debug "REMOTE" (-> *mp-replication-state* remote boss)))
  (none))

(defun mp-draw-boss-debug-overlay ()
  (when *mp-debug-boss*
    (let ((slot (if (mp-session-host?) (local-boss-state) (-> *mp-replication-state* remote boss))))
      (when (!= (-> slot kind) (boss-kind none))
        (add-debug-sphere #t
                          (bucket-id debug-no-zbuf1)
                          (boss-state-trans! (-> slot position) (new 'stack-no-clear 'vector))
                          (meters 1.0)
                          (static-rgba 0 255 255 180)))))
  (none))

(defun mp-debug-append-draw-flag ((flags-text string) (flag-name string) (enabled? symbol))
  (if enabled? (if (string= flags-text "") flag-name (the-as string (format #f "~A, ~A" flags-text flag-name))) flags-text))

(defun mp-debug-get-draw-status-flags ((draw draw-control))
  (let ((status (if (and draw (nonzero? draw)) (the-as uint32 (-> draw status)) (the-as uint32 0)))
        (flags-text ""))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text
                                     "close-to-screen"
                                     (logtest? status (draw-control-status close-to-screen))))
    (set! flags-text (mp-debug-append-draw-flag flags-text "no-draw" (logtest? status (draw-control-status no-draw))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "no-draw-temp" (logtest? status (draw-control-status no-draw-temp))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "on-screen" (logtest? status (draw-control-status on-screen))))
    (set! flags-text (mp-debug-append-draw-flag flags-text "uninited" (logtest? status (draw-control-status uninited))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "no-draw-bounds" (logtest? status (draw-control-status no-draw-bounds))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text
                                     "no-closest-distance"
                                     (logtest? status (draw-control-status no-closest-distance))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "math-skel" (logtest? status (draw-control-status math-skel))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "force-vu1" (logtest? status (draw-control-status force-vu1))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text
                                     "no-draw-bounds2"
                                     (logtest? status (draw-control-status no-draw-bounds2))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "force-fade" (logtest? status (draw-control-status force-fade))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text
                                     "warp-cross-fade"
                                     (logtest? status (draw-control-status warp-cross-fade))))
    (set! flags-text (mp-debug-append-draw-flag flags-text "lod-set" (logtest? status (draw-control-status lod-set))))
    (set! flags-text
          (mp-debug-append-draw-flag flags-text "disable-fog" (logtest? status (draw-control-status disable-fog))))
    (set! flags-text (mp-debug-append-draw-flag flags-text "hud" (logtest? status (draw-control-status hud))))
    (if (string= flags-text "") "none" (the-as string flags-text))))

(defun mp-draw-level-debug ()
  (when *mp-level-debug?*
    (format *stdcon* "~0k--- LEVEL LOAD DEBUG ---~%")
    (when (and *load-state* (nonzero? *load-state*))
      (format *stdcon* "VIS-NICK target: ~A~%" (-> *load-state* vis-nick)))
    (when (and *level* (nonzero? *level*))
      (format *stdcon* "PLAY?: ~A  BORDER?: ~A  VIS?: ~A~%" (-> *level* play?) (-> *level* border?) (-> *level* vis?))
      (format *stdcon* "LOAD-LEVEL: ~A~%" (-> *level* load-level)))
    (when (and *level* (nonzero? *level*))
      (let ((loading-lev (-> *level* loading-level)))
        (if (and loading-lev (nonzero? loading-lev) (!= loading-lev (-> *level* default-level)))
          (format *stdcon* "LOADING LEVEL: ~A (status: ~A)~%" (-> loading-lev name) (-> loading-lev status))
          (format *stdcon* "LOADING LEVEL: none~%"))))
    (when (and *load-state* (nonzero? *load-state*))
      (format *stdcon* "WANTED LEVELS (WANT):~%")
      (dotimes (i 6)
        (let ((want-state (-> *load-state* want i)))
          (when (and want-state (nonzero? want-state) (-> want-state name))
            (format *stdcon*
                    "  ~D: ~A [~A] (force-vis? ~A, force-inside? ~A)~%"
                    i
                    (-> want-state name)
                    (-> want-state display?)
                    (-> want-state force-vis?)
                    (-> want-state force-inside?))))))
    (when (and *level* (nonzero? *level*))
      (format *stdcon* "ACTIVE HEAPS (draw-level-count: ~D):~%" (-> *level* draw-level-count))
      (dotimes (i (-> *level* length))
        (let ((lev (-> *level* level i)))
          (when (and lev (nonzero? lev) (!= (-> lev status) 'inactive))
            (let* ((heap (-> lev heap))
                   (size (- (the int (-> heap top-base)) (the int (-> heap base))))
                   (used (+ (- (the int (-> heap current)) (the int (-> heap base)))
                            (- (the int (-> heap top-base)) (the int (-> heap top)))))
                   (free (- (the int (-> heap top)) (the int (-> heap current)))))
              (format *stdcon*
                      "  ~D: ~A (status: ~A, nick: ~A, display: ~A, render: ~A)~%"
                      i
                      (-> lev name)
                      (-> lev status)
                      (-> lev nickname)
                      (-> lev display?)
                      (-> lev render?))
              (format *stdcon*
                      "     Heap: size ~D, used ~D (~D%), free ~D~%"
                      size
                      used
                      (if (> size 0) (/ (* 100 used) size) 0)
                      free))))))
    (format *stdcon* "-------------------------~%~%"))
  (none))

(defun mp-debug-print-target-finish-sphere ()
  (if (and *target* (nonzero? *target*))
    (let ((target-control (-> *target* control)))
      (cond
        ((not (and target-control (nonzero? target-control)))
         (format 0 "[MP Debug] Target sphere unavailable: target control is null.~%"))
        ((focus-test? *target* teleporting) (format 0 "[MP Debug] Target sphere unavailable: target is teleporting.~%"))
        ((and *level*
              (nonzero? *level*)
              (-> *level* loading-level)
              (nonzero? (-> *level* loading-level))
              (-> *level* default-level)
              (!= (-> *level* loading-level) (-> *level* default-level)))
         (format 0 "[MP Debug] Target sphere unavailable: a level is loading.~%"))
        (else
         (let ((target-position (target-pos 0)))
           (if (and target-position (nonzero? target-position))
             (format 0
                     "(new 'static 'sphere~%                       :x ~,,1f~%                       :y ~,,1f~%                       :z ~,,1f~%                       :r 0.0)~%"
                     (-> target-position x)
                     (-> target-position y)
                     (-> target-position z))
             (format 0 "[MP Debug] Target sphere unavailable: target position is null.~%"))))))
    (format 0 "[MP Debug] Target sphere unavailable: *target* is null.~%"))
  (none))
