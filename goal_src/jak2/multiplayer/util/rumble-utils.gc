;;-*-Lisp-*-
(in-package goal)

(defun rumble-local-controller ((owner target) (motor int) (amount int) (duration time-frame))
  (when (not-player-replica? owner)
    (cpad-set-buzz! (-> *cpad-list* cpads 0) motor amount duration))
  (none))

(defun stop-rumble-local-controller ((owner target))
  (when (not-player-replica? owner)
    (buzz-stop! 0))
  (none))

(defun mp-projectile-owner ((projectile process-drawable))
  (let ((owner (the-as target #f)))
    (when (and projectile (nonzero? projectile) (-> projectile parent) (nonzero? (-> projectile parent)))
      (let ((gun-proc (ppointer->process (-> projectile parent))))
        (when (and gun-proc (nonzero? gun-proc) (-> gun-proc parent) (nonzero? (-> gun-proc parent)))
          (set! owner (the-as target (-> gun-proc parent 0))))))
    owner))

(defun mp-local-projectile-owner? ((projectile process-drawable))
  (not-player-replica? (mp-projectile-owner projectile)))

(defun mp-local-projectile-rumble! ((projectile process-drawable) (motor int) (amount int) (duration time-frame))
  (rumble-local-controller (mp-projectile-owner projectile) motor amount duration)
  (none))
