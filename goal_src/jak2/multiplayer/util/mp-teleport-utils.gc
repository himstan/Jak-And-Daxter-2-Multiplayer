;;-*-Lisp-*-
(in-package goal)

(define-extern mp-vehicle-find-by-net-id (function uint vehicle))

(defun mp-teleport-destination-record ()
  (let ((spectated (mp-spectated-player-record)))
    (if (and spectated (nonzero? spectated)) spectated (mp-nearest-remote-player-record *target* #f))))

(defun mp-player-teleport-ready-or-request! ((record mp-player-record))
  (if (or (mp-respawn-policy-blocks-remote-placement?) (not record) (zero? record))
    #f
    (begin
      (mp-ensure-player-level-wanted! record)
      (mp-player-level-ready? record))))

(defun mp-remote-teleport-ready-or-request! ()
  (mp-player-teleport-ready-or-request! (mp-teleport-destination-record)))

(defun mp-teleport-target-ready-for-record? ((player target) (record mp-player-record))
  (nonnull? player record (-> player control) (-> player control root-prim)))

(defun mp-teleport-target-ready? ((player target))
  (mp-teleport-target-ready-for-record? player (mp-teleport-destination-record)))

(defun mp-local-scene-teleport-ready-for-record? ((record mp-player-record))
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       record
       (nonzero? record)
       (not (focus-test? *target* teleporting))
       (not (and (-> *target* state) (= (-> *target* state name) 'target-load-wait)))
       (not (and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait)))))

(defun mp-teleport-send-camera-event! ()
  (when (and *camera* (nonzero? *camera*))
    (send-event *camera* 'teleport))
  (none))

(defun mp-teleport-player-to-record-coords! ((player target) (record mp-player-record) (extra-y float))
  (when (and (nonnull? player record (-> player control)) (mp-teleport-target-ready-for-record? player record))
    (let ((control (-> player control))
          (position (new 'stack 'vector)))
      (set-vector! position
                   (-> record transform position x)
                   (+ (-> record transform position y) extra-y)
                   (-> record transform position z)
                   1.0)
      (move-to-point! control position)
      (set! (-> control transv quad) (the-as uint128 0))
      (vector-copy! (-> control camera-pos) (-> control trans))
      (mp-teleport-send-camera-event!)))
  (none))

(defun mp-teleport-player-to-vehicle! ((player target) (veh vehicle) (extra-x float) (extra-z float))
  (when (and (nonnull? player (-> player control) veh (-> veh root)) (mp-teleport-target-ready? player))
    (let ((control (-> player control))
          (position (new 'stack 'vector)))
      (vector-copy! position (-> veh root trans))
      (+! (-> position x) extra-x)
      (+! (-> position y) 4096.0)
      (+! (-> position z) extra-z)
      (move-to-point! control position)
      (set! (-> control transv quad) (the-as uint128 0))
      (vector-copy! (-> control camera-pos) (-> control trans))
      (mp-teleport-send-camera-event!)))
  (none))

(defun mp-teleport-find-last-empty-seat ((veh vehicle) (passenger-only? symbol))
  (let ((best-seat -1))
    (when (and veh (nonzero? veh) (-> veh info) (nonzero? (-> veh info)))
      (countdown (seat-idx (the int (-> veh info seat-count)))
        (when (and (or (not passenger-only?) (> seat-idx 0))
                   (nonzero? (-> veh info seat-array seat-idx flags))
                   (not (get-rider-in-seat veh seat-idx)))
          (set! best-seat seat-idx)
          (return best-seat))))
    best-seat))

(defun mp-teleport-board-vehicle-seat! ((player target) (veh vehicle) (seat-idx int))
  (when (and (mp-teleport-target-ready? player) veh (nonzero? veh) (!= seat-idx -1))
    (set! *mp-shuttle-override-seat-index* seat-idx)
    (if (focus-test? player indax)
      (go-process player target-indax-pilot-start (process->handle veh) #t #t)
      (go-process player target-pilot-start (process->handle veh) #t #f)))
  (none))

(defun mp-teleport-reset-local-base-state! ((player target))
  (when (and player (nonzero? player))
    (if (focus-test? player indax) (go-process player target-indax-start (the handle #f)) (go-process player target-stance)))
  (none))

(defun mp-teleport-local-target-to-player! ((record mp-player-record) (ride-along? symbol))
  (when (mp-teleport-target-ready-for-record? *target* record)
    (when (focus-test? *target* pilot)
      (mp-clear-local-vehicle-occupancy! *target*))
    (cond
      ((and ride-along? (focus-test? *target* indax))
       (log 'debug "[MP-Teleport] Daxter player hopping onto Jak (ride-along)~%")
       (mp-teleport-player-to-record-coords! *target* record 4096.0)
       (go-process *target* target-indax-jump-on (-> record identity player-id)))
      ((nonzero? (-> record vehicle vehicle-id))
       (let ((riding-veh-id (-> record vehicle vehicle-id)))
         (let ((veh (mp-vehicle-find-by-net-id riding-veh-id)))
           (cond
             ((and veh (nonzero? veh) (-> veh root) (nonzero? (-> veh root)))
              (mp-teleport-player-to-vehicle! *target* veh 0.0 0.0)
              (let ((best-seat (mp-teleport-find-last-empty-seat veh #f)))
                (cond
                  ((!= best-seat -1)
                   (log 'debug "[MP-Teleport] Teleporting player into vehicle seat ~D~%" best-seat)
                   (mp-teleport-board-vehicle-seat! *target* veh best-seat))
                  (else
                   (log 'debug "[MP-Teleport] Vehicle full. Teleporting next to vehicle.~%")
                   (mp-teleport-reset-local-base-state! *target*)))))
             (else
              (log 'debug "[MP-Teleport] Vehicle ~D not found. Teleporting to remote player coords.~%" riding-veh-id)
              (mp-teleport-player-to-record-coords! *target* record 4096.0)
              (mp-teleport-reset-local-base-state! *target*))))))
      (else
       (log 'debug "[MP-Teleport] Remote player on foot. Teleporting to remote player coords.~%")
       (mp-teleport-player-to-record-coords! *target* record 4096.0)
       (mp-teleport-reset-local-base-state! *target*))))
  (none))

(defun place-respawn-target-at-player! ((player target) (record mp-player-record))
  (when (and (nonnull? player record) (mp-teleport-target-ready-for-record? player record))
    (mp-clear-local-vehicle-occupancy! player)
    (when (nonzero? (-> record vehicle vehicle-id))
      (let ((veh (mp-vehicle-find-by-net-id (-> record vehicle vehicle-id))))
        (when (nonnull? veh (-> veh root))
          (mp-teleport-player-to-vehicle! player veh (meters 8.0) (meters 8.0))
          (return veh))))
    (mp-teleport-player-to-record-coords! player record 4096.0))
  (the-as vehicle #f))

(defun mp-scene-sync-teleport-to-player! ((record mp-player-record))
  (when (mp-local-scene-teleport-ready-for-record? record)
    (log 'debug "[MP-SceneTeleport] Snapping to scene initiator player ~D.~%" (-> record identity player-id))
    (mp-teleport-player-to-record-coords! *target* record 4096.0))
  (none))

(defun mp-teleport-bootstrap-clearance? ((player target) (position vector))
  (when (nonnull? player position *collide-cache*)
    (let ((query (new 'stack-no-clear 'collide-query)))
      (vector-copy! (-> query start-pos) position)
      (set-vector! (-> query move-dist) 0.0 (meters 1) 0.0 0.0)
      (set! (-> query radius) (meters 0.35))
      (set! (-> query collide-with) (collide-spec backgnd))
      (set! (-> query ignore-process0) player)
      (set! (-> query ignore-process1) #f)
      (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (set! (-> query action-mask) (collide-action solid))
      (let ((fraction (fill-and-probe-using-line-sphere *collide-cache* query)))
        (return (or (< fraction 0.0) (>= fraction 1.0))))))
  #f)

(defun mp-teleport-bootstrap-ground-position! ((player target) (record mp-player-record) (position vector))
  (when (nonnull? player record position (-> player control) *collide-cache*)
    (let ((query (new 'stack-no-clear 'collide-query))
          (control (-> player control)))
      (dotimes (candidate 5)
        (vector-copy! position (-> record transform position))
        (case candidate
          ((1) (+! (-> position x) (meters 2)))
          ((2) (-! (-> position x) (meters 2)))
          ((3) (+! (-> position z) (meters 2)))
          ((4) (-! (-> position z) (meters 2))))
        (when (above-ground? control query position (collide-spec backgnd) (meters 2) (meters 12) (meters 0.5))
          (set! (-> position y) (+ (-> query best-other-tri intersect y) (meters 1)))
          (when (and (mp-teleport-bootstrap-clearance? player position) (player-position-clear? player position))
            (return #t))))))
  #f)

(defun reset-teleport-history! ((player target))
  (when (nonnull? player (-> player control))
    (let ((control (-> player control)))
      (vector-copy! (-> control trans-old) (-> control trans))
      (vector-copy! (-> control trans-old-old) (-> control trans))
      (vector-copy! (-> control trans-old-old-old) (-> control trans))
      (vector-copy! (-> control last-trans-any-surf) (-> control trans))
      (vector-copy! (-> control camera-pos) (-> control trans))
      (vector-copy! (-> player alt-cam-pos) (-> control camera-pos))
      (vector-reset! (-> control transv))
      (set-time! (-> player teleport-time))
      (when (nonnull? *level*)
        (dotimes (index 2)
          (vector-copy! (-> *level* target-pos index) (-> control trans))
          (vector-copy! (-> *level* camera-pos index) (-> control camera-pos))))))
  (none))

(defun mp-teleport-bootstrap-to-record! ((player target) (record mp-player-record))
  (when (not (and (mp-teleport-target-ready-for-record? player record) (nonnull? player record)))
    (return #f))
  (let ((veh (mp-vehicle-find-by-net-id (the uint (-> record vehicle vehicle-id))))
        (position (new 'stack 'vector)))
    (when (nonnull? veh (-> veh root))
      (dotimes (seat-index 3)
        (when (= (get-rider-in-seat veh (+ seat-index 1)) player)
          (reset-teleport-history! player)
          (return #t)))
      (when (or (and (nonnull? (-> player state))
                     (or (= (-> player state name) 'target-pilot-start)
                         (= (-> player state name) 'target-indax-pilot-start)))
                (and (nonnull? (-> player next-state))
                     (or (= (-> player next-state name) 'target-pilot-start)
                         (= (-> player next-state name) 'target-indax-pilot-start))))
        (return #f))
      (let ((seat (mp-teleport-find-last-empty-seat veh #t)))
        (when (!= seat -1)
          (mp-clear-local-vehicle-occupancy! player)
          (mp-teleport-player-to-vehicle! player veh 0.0 0.0)
          (mp-teleport-board-vehicle-seat! player veh seat)
          (reset-teleport-history! player)
          (return #f))))
    (when (mp-teleport-bootstrap-ground-position! player record position)
      (mp-clear-local-vehicle-occupancy! player)
      (vector-copy! (-> player control trans) position)
      (quaternion-axis-angle! (-> player control quat) 0.0 1.0 0.0 (-> record transform angle))
      (quaternion-copy! (-> player control quat-for-control) (-> player control quat))
      (quaternion-copy! (-> player control dir-targ) (-> player control quat))
      (mp-teleport-reset-local-base-state! player)
      (reset-teleport-history! player)
      (return #t)))
  #f)
