;;-*-Lisp-*-
(in-package goal)

(deftype mp-player-list-manager (structure)
  ((layout             mp-overlay-layout :inline)
   (overlay            (pointer mp-overlay-layout-process))
   (initialized?       symbol)
   (visible?           symbol)
   )
  )

(define-perm *mp-player-list* mp-player-list-manager
  (new 'static 'mp-player-list-manager))

(defconstant MP_PLAYER_NAMETAG_MAX_DIST (meters 100.0))
(defconstant MP_PLAYER_NAMETAG_SCALE_MIN_DIST (meters 3.0))
(defconstant MP_PLAYER_NAMETAG_MAX_SCALE 1.15)
(defconstant MP_PLAYER_NAMETAG_MIN_SCALE 0.35)
(defconstant MP_PLAYER_NAMETAG_Y_OFFSET_JAK (meters 2.3))
(defconstant MP_PLAYER_NAMETAG_Y_OFFSET_DAXTER (meters 1.15))

(define-extern mp-player-list-update! (function symbol))
(define-extern mp-player-list-show! (function symbol))
(define-extern mp-player-list-hide! (function symbol))
(define-extern mp-player-list-visible? (function symbol))
