;;-*-Lisp-*-
(in-package goal)

(define *nametag-string* (new 'global 'string 128 (the-as string #f)))

(deftype mp-player-list-manager (structure)
  ((layout       mp-overlay-layout :inline)
   (overlay      (pointer mp-overlay-layout-process))
   (initialized? symbol)
   (visible?     symbol)))

(define-perm *mp-player-list* mp-player-list-manager (new 'static 'mp-player-list-manager))

(defconstant PLAYER_NAMETAG_MAX_DISTANCE (meters 100.0))
(defconstant PLAYER_NAMETAG_GLYPH_HEIGHT (meters 0.3))
(defconstant PLAYER_NAMETAG_JAK_CLEARANCE (meters 0.4))
(defconstant PLAYER_NAMETAG_DAXTER_CLEARANCE (meters 0.3))

(define-extern draw-player-nametags! (function none))
(define-extern mp-player-list-update! (function symbol))
(define-extern mp-player-list-show! (function symbol))
(define-extern mp-player-list-hide! (function symbol))
(define-extern mp-player-list-visible? (function symbol))
