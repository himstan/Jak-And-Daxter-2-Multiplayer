(in-package goal)

(define *nametag-string* (new 'global 'string 128 (the-as string #f)))

(deftype menu-player-list-option (menu-option)
  ((selected-player int8)
   (open?           symbol)))

(defconstant PLAYER_LIST_PANEL_TOP 66.0)
(defconstant PLAYER_LIST_PANEL_BOTTOM 330.0)
(defconstant PLAYER_NAMETAG_MAX_DISTANCE (meters 100.0))
(defconstant PLAYER_NAMETAG_GLYPH_HEIGHT (meters 0.3))
(defconstant PLAYER_NAMETAG_JAK_CLEARANCE (meters 0.4))
(defconstant PLAYER_NAMETAG_DAXTER_CLEARANCE (meters 1.2))
(defconstant PLAYER_NAMETAG_DAXTER_RIDING_CLEARANCE (meters 0.2))

(define-extern draw-player-nametags! (function none))
(define-extern update-player-list-input! (function none))
(define-extern draw-player-list! (function none))
(define-extern player-list-open? (function symbol))
