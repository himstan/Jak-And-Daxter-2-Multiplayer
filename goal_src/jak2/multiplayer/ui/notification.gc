;;-*-Lisp-*-
(in-package goal)

(defun notification-entry-at ((manager notification-manager) (row int))
  (when (and (nonnull? manager) (>= row 0) (< row (-> manager count)))
    (return (-> manager entries (mod (+ (the int (-> manager head)) row) NOTIFICATION_VISIBLE_COUNT))))
  (the-as notification-entry #f))

(defun notification-visible? ()
  (let ((status (pc-multi-get-session-status)))
    (if (or (and (or (= status (mp-connection-status lobby)) (= status (mp-connection-status game-starting)))
                 (nonnull? *progress-process* (-> *progress-process* 0))
                 (= (-> *progress-process* 0 current) 'mp-lobby))
            (= status (mp-connection-status in-game)))
      #t
      #f)))

(defun chat-input-allowed? ()
  (and (notification-visible?)
       (or (!= (pc-multi-get-session-status) (mp-connection-status in-game))
           (and (= *master-mode* 'game) (not *progress-process*)))))

(defun notification-make-room! ((manager notification-manager))
  (when (nonnull? manager)
    (dotimes (row (-> manager count))
      (let ((entry (notification-entry-at manager row)))
        (when (nonnull? entry)
          (set! (-> entry row-y)
                (min (-> entry row-y)
                     (* (the float (+ (- NOTIFICATION_VISIBLE_COUNT (-> manager count)) row)) NOTIFICATION_ROW_HEIGHT)))))))
  (none))

(defun notification-enqueue! ((manager notification-manager) (player-slot uint) (notification text-id))
  (when (nonnull? manager)
    (when (= (-> manager count) NOTIFICATION_VISIBLE_COUNT)
      (set! (-> manager head) (the uint8 (mod (+ (-> manager head) 1) NOTIFICATION_VISIBLE_COUNT)))
      (-! (-> manager count) 1))
    (notification-make-room! manager)
    (+! (-> manager count) 1)
    (let ((entry (notification-entry-at manager (- (the int (-> manager count)) 1)))
          (previous (notification-entry-at manager (- (the int (-> manager count)) 2))))
      (when (nonnull? entry (-> entry name) (-> entry text) (-> manager name-buffer) (-> manager text-buffer))
        (format (clear (-> entry name)) (if (= notification (text-id null)) "~S:" "~S") (-> manager name-buffer))
        (copy-string<-string (-> entry text) (-> manager text-buffer))
        (set! (-> entry system?) (the uint8 (if (= notification (text-id null)) 0 1)))
        (set! (-> entry color) (mp-player-font-color-by-slot (the int player-slot)))
        (set! (-> entry started) (current-time))
        (set! (-> entry row-y)
              (if (= (pc-multi-get-session-status) (mp-connection-status in-game))
                (if (nonnull? previous) (+ (-> previous row-y) NOTIFICATION_ROW_HEIGHT) 0.0)
                (if (nonnull? previous)
                  (max (* (the float NOTIFICATION_VISIBLE_COUNT) NOTIFICATION_ROW_HEIGHT)
                       (+ (-> previous row-y) NOTIFICATION_ROW_HEIGHT))
                  (* (the float (- NOTIFICATION_VISIBLE_COUNT 1)) NOTIFICATION_ROW_HEIGHT)))))))
  (none))

(defbehavior notification-event-handler notification-manager ((sender process)
                                                              (num-params int)
                                                              (message symbol)
                                                              (event
                                                                event-message-block))
  (when (and (= message 'notify-player) (nonnull? self event *common-text* (-> self name-buffer) (-> self text-buffer)))
    (let ((player-slot (the uint (-> event param 0)))
          (notification (the-as text-id (-> event param 1))))
      (when (mp-player-slot-valid? player-slot)
        (mp-player-copy-name! (-> self name-buffer) player-slot)
        (format (clear (-> self text-buffer)) (lookup-text! *common-text* notification #f) "")
        (notification-enqueue! self player-slot notification))))
  (none))

(defun notify-player! ((player-slot uint) (notification text-id))
  (when (nonnull? *active-pool*)
    (let ((manager (process-by-type-exact 'notification-manager *active-pool*)))
      (when (nonnull? manager)
        (send-event manager 'notify-player player-slot (the-as uint notification)))))
  (none))

(defun chat-receive! ((manager notification-manager))
  (when (nonnull? manager)
    (let ((message (pc-multi-copy-chat (-> manager last-serial) (-> manager name-buffer) (-> manager text-buffer))))
      (while (nonzero? message)
        (notification-enqueue! manager (logand message #xff) (text-id null))
        (set! (-> manager last-serial) (the uint32 (ash message -8)))
        (set! message (pc-multi-copy-chat (-> manager last-serial) (-> manager name-buffer) (-> manager text-buffer))))))
  (none))

(defun notification-expire! ((manager notification-manager))
  (when (nonnull? manager)
    (let ((entry (notification-entry-at manager 0)))
      (while (and (nonnull? entry)
                  (>= (- (current-time) (-> entry started)) (+ NOTIFICATION_HOLD_TIME (* 2 NOTIFICATION_SLIDE_TIME))))
        (set! (-> manager head) (the uint8 (mod (+ (-> manager head) 1) NOTIFICATION_VISIBLE_COUNT)))
        (-! (-> manager count) 1)
        (set! entry (notification-entry-at manager 0)))))
  (none))

(defun chat-update-editor! ((manager notification-manager) (visible? symbol))
  (when (nonnull? manager)
    (let ((editor (-> manager editor)))
      (when (nonnull? editor)
        (when (pc-text-input-shortcut (and visible? (zero? (-> editor token)) (not (player-list-open?))))
          (set! (-> editor token) (pc-text-input-begin "" (the uint 192) "" #f))
          (set! (-> editor revision) 0))
        (pc-text-input-refresh! editor)
        (cond
          ((or (not visible?) (= (-> editor status) (pc-text-edit-state cancelled))) (pc-text-input-close! editor))
          ((= (-> editor status) (pc-text-edit-state submitted))
           (when (and (nonnull? (-> editor text)) (> (length (-> editor text)) 0))
             (pc-multi-send-chat (-> editor text)))
           (pc-text-input-close! editor))))))
  (none))

(defun notification-draw-line! ((context font-context) (text string) (width float) (literal? symbol))
  (when (nonnull? context text *display* (-> *display* frames (-> *display* on-screen) global-buf))
    (let ((fitted (if literal? (fit-overlay-text text context width) text)))
      (when (nonnull? fitted)
        (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id progress))
          (draw-string fitted buffer context)))))
  (none))

(defun notification-draw-entry! ((entry notification-entry) (context font-context) (base-y float))
  (when (nonnull? entry context (-> entry name) (-> entry text) *pc-encoded-temp-string*)
    (let ((left (+ 20.0
                   (the float
                        (overlay-slide-offset (- (current-time) (-> entry started))
                                              NOTIFICATION_SLIDE_TIME
                                              NOTIFICATION_HOLD_TIME
                                              (+ NOTIFICATION_WIDTH 20.0))))))
      (set! (-> context origin x) left)
      (set! (-> context origin y) (+ base-y (-> entry row-y)))
      (set-color! context (-> entry color))
      (notification-draw-line! context (-> entry name) 110.0 #t)
      (let ((name-width (min 110.0 (-> (get-string-length *pc-encoded-temp-string* context) length)))
            (gap (if (zero? (-> entry system?)) 5.0 0.0)))
        (set! (-> context origin x) (+ left name-width gap))
        (set-color! context (font-color default))
        (notification-draw-line! context
                                 (-> entry text)
                                 (- NOTIFICATION_WIDTH name-width gap)
                                 (if (zero? (-> entry system?)) #t #f)))))
  (none))

(defun chat-draw-input! ((manager notification-manager) (context font-context) (input-y float))
  (when (nonnull? manager context (-> manager editor) (-> manager input-display) *pc-encoded-temp-string*)
    (when (= (-> manager editor status) (pc-text-edit-state editing))
      (set! (-> context origin x) 20.0)
      (set! (-> context origin y) input-y)
      (set-color! context (font-color white))
      (notification-draw-line! context "Say: " NOTIFICATION_WIDTH #t)
      (let ((prompt-width (-> (get-string-length *pc-encoded-temp-string* context) length)))
        (set! (-> context origin x) (+ 20.0 prompt-width))
        (pc-text-input-display (-> manager editor token) (-> manager input-display))
        (let ((width (-> (get-string-length (-> manager input-display) context) length))
              (available-width (- NOTIFICATION_WIDTH prompt-width)))
          (when (> width available-width)
            (set-scale! context (* NOTIFICATION_TEXT_SCALE (/ available-width width)))))
        (when (nonnull? *display* (-> *display* frames (-> *display* on-screen) global-buf))
          (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                       (bucket-id progress))
            (draw-string (-> manager input-display) buffer context))))))
  (none))

(defun notification-draw-messages! ((manager notification-manager) (context font-context) (base-y float))
  (when (nonnull? manager context)
    (dotimes (row (-> manager count))
      (let ((entry (notification-entry-at manager row)))
        (when (nonnull? entry)
          (set! (-> entry row-y)
                (max (* (the float
                             (if (= (pc-multi-get-session-status) (mp-connection-status in-game))
                               row
                               (+ (- NOTIFICATION_VISIBLE_COUNT (-> manager count)) row)))
                        NOTIFICATION_ROW_HEIGHT)
                     (- (-> entry row-y) (* 180.0 (seconds-per-frame)))))
          (when (<= (-> entry row-y) (* (the float (- NOTIFICATION_VISIBLE_COUNT 1)) NOTIFICATION_ROW_HEIGHT))
            (notification-draw-entry! entry context base-y))))))
  (none))

(defun notification-sprite-clearance ((sprite hud-sprite) (top float))
  (let ((tex (-> sprite tex)))
    (when (or (not (nonnull? sprite tex)) (= (-> sprite scale-x) 0.0))
      (return top))
    (let* ((width (* (the float (-> tex w)) (-> sprite scale-x) (-> *video-params* relative-x-scale)))
           (height (* (the float (-> tex h)) (-> sprite scale-y)))
           (centered? (logtest? (-> sprite flags) 8))
           (left (- (the float (-> sprite pos x))
                    (cond
                      ((logtest? (-> sprite flags) 4) width)
                      (centered? (* 0.5 width))
                      (else 0.0))))
           (sprite-top (- (the float (-> sprite pos y)) (if centered? (* 0.5 height) 0.0)))
           (sprite-bottom (+ sprite-top height)))
      (if (and (< left (+ 20.0 NOTIFICATION_WIDTH))
               (> (+ left width) 20.0)
               (< sprite-top (+ top NOTIFICATION_AREA_HEIGHT))
               (> sprite-bottom top))
        (+ sprite-bottom 4.0)
        top))))

(defun notification-top-below-hud ()
  (let ((top 16.0))
    (when (nonnull? *hud-engine*)
      (let ((node (-> *hud-engine* alive-list next0)))
        (while (and (nonnull? node) (!= node (-> *hud-engine* alive-list-end)))
          (let ((hud (the-as hud (-> (the-as connection node) param1))))
            (when (and (nonnull? hud) (not (hidden? hud)))
              (dotimes (index 30)
                (set! top (notification-sprite-clearance (-> hud sprites index) top)))))
          (set! node (-> node next0)))))
    top))

(defun notification-draw! ((manager notification-manager))
  (when (nonnull? manager)
    (let* ((base-y (if (= (pc-multi-get-session-status) (mp-connection-status in-game))
                     (notification-top-below-hud)
                     (- 374.0 (* (the float (- NOTIFICATION_VISIBLE_COUNT 1)) NOTIFICATION_ROW_HEIGHT))))
           (newest (notification-entry-at manager (- (the int (-> manager count)) 1)))
           (input-y (if (= (pc-multi-get-session-status) (mp-connection-status in-game))
                      (+ base-y
                         (if (nonnull? newest)
                           (+ 18.0
                              (min (-> newest row-y)
                                   (* (the float (- NOTIFICATION_VISIBLE_COUNT 1)) NOTIFICATION_ROW_HEIGHT)))
                           0.0))
                      392.0))
           (context (new 'stack
                         'font-context
                         *font-default-matrix*
                         20
                         (the int base-y)
                         0.0
                         (font-color white)
                         (font-flags shadow kerning large))))
      (when (nonnull? context *display* (-> *display* frames (-> *display* on-screen) global-buf))
        (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                     (bucket-id progress))
          (dma-buffer-add-gs-set-flusha buffer
                                        (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))
                                        (tex1-1 (new 'static 'gs-tex1 :mmag #x1 :mmin #x1))))
        (set-scale! context NOTIFICATION_TEXT_SCALE)
        (notification-draw-messages! manager context base-y)
        (chat-draw-input! manager context input-y))))
  (none))

(defun notification-update! ((manager notification-manager))
  (when (nonnull? manager)
    (let ((visible? (notification-visible?)))
      (chat-update-editor! manager (chat-input-allowed?))
      (if (or (< (pc-multi-get-session-status) (mp-connection-status lobby))
              (> (pc-multi-get-session-status) (mp-connection-status in-game)))
        (set! (-> manager count) (the uint8 0))
        (chat-receive! manager))
      (notification-expire! manager)
      (when visible?
        (notification-draw! manager))))
  (none))

(defstate notification-active (notification-manager)
  :virtual #t
  :event notification-event-handler
  :exit
    (behavior ()
      (when (nonnull? self (-> self editor))
        (pc-text-input-close! (-> self editor)))
      (pc-text-input-shortcut #f))
  :code
    (behavior ()
      (until #f
        (notification-update! self)
        (suspend))
      #f))

(defbehavior notification-init notification-manager ()
  (when (nonnull? self *display* (-> *display* real-clock))
    (set! (-> self clock) (-> *display* real-clock))
    (set! (-> self head) (the uint8 0))
    (set! (-> self count) (the uint8 0))
    (set! (-> self last-serial) (the uint32 0))
    (set! (-> self input-display) (new 'process 'string 4096 (the-as string #f)))
    (set! (-> self name-buffer) (new 'process 'string 64 (the-as string #f)))
    (set! (-> self text-buffer) (new 'process 'string 256 (the-as string #f)))
    (dotimes (index NOTIFICATION_VISIBLE_COUNT)
      (set! (-> self entries index name) (new 'process 'string 64 (the-as string #f)))
      (set! (-> self entries index text) (new 'process 'string 256 (the-as string #f))))
    (change-to-last-brother self)
    (go-virtual notification-active))
  (none))

(defun ensure-player-notifications! ((owner process))
  (when (and (nonnull? owner *active-pool*) (not (nonnull? (process-by-type-exact 'notification-manager *active-pool*))))
    (process-spawn notification-manager :init notification-init :to owner))
  (none))
