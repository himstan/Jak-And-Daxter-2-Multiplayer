;;-*-Lisp-*-
(in-package goal)

(defun notification-entry-at ((manager notification-manager) (row uint))
  (when (and (nonnull? manager) (< row (-> manager count)))
    (return (-> manager entries (mod (+ (the uint (-> manager head)) row) (the uint NOTIFICATION_QUEUE_CAPACITY)))))
  (the-as notification-entry #f))

(defun notification-string-resolver! ((owner process) (row uint) (destination string))
  (when (nonnull? destination *active-pool*)
    (let* ((manager (the-as notification-manager (process-by-type-exact 'notification-manager *active-pool*)))
           (entry (notification-entry-at manager row)))
      (when (nonnull? entry (-> entry name))
        (copy-string<-string destination (-> entry name))
        (return #t))))
  #f)

(defun notification-enqueue! ((manager notification-manager) (player-id uint) (text text-id))
  (when (and (nonnull? manager) (mp-player-id-valid? player-id) (< (-> manager count) NOTIFICATION_QUEUE_CAPACITY))
    (let ((entry (-> manager entries (mod (+ (-> manager head) (-> manager count)) NOTIFICATION_QUEUE_CAPACITY))))
      (when (nonnull? entry (-> entry name))
        (mp-player-copy-name! (-> entry name) player-id)
        (set! (-> entry text) text)
        (set! (-> entry started) (the-as time-frame -1))
        (set! (-> entry row-y) -1.0)
        (+! (-> manager count) 1))))
  (none))

(defbehavior notification-event-handler notification-manager ((sender process)
                                                              (num-params int)
                                                              (message symbol)
                                                              (event
                                                                event-message-block))
  (when (and (= message 'notify-player) (nonnull? self event))
    (notification-enqueue! self (the uint (-> event param 0)) (the-as text-id (-> event param 1))))
  (none))

(defun notify-player! ((player-id uint) (text text-id))
  (when (nonnull? *active-pool*)
    (let ((manager (process-by-type-exact 'notification-manager *active-pool*)))
      (when (nonnull? manager)
        (send-event manager 'notify-player player-id (the-as uint text)))))
  (none))

(defun notification-configure-widget! ((widget mp-overlay-widget) (row int))
  (when (nonnull? widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) (text-id notification-player-joined))
    (set! (-> widget parameter-kind) (mp-overlay-parameter-kind string))
    (set! (-> widget parameter-index) (the uint32 row))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget width) 320.0)
    (set! (-> widget height) 36.0)
    (set! (-> widget scale) 0.5)
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (set! (-> widget bucket) (the-as uint32 (bucket-id progress)))
    (set! (-> widget enabled?) #f))
  (none))

(defbehavior notification-init notification-manager ()
  (when (nonnull? self *display* (-> *display* real-clock))
    (set! (-> self clock) (-> *display* real-clock)))
  (when (nonnull? self)
    (set! (-> self head) (the uint8 0))
    (set! (-> self count) (the uint8 0))
    (set! (-> self string-resolver) notification-string-resolver!)
    (mp-overlay-layout-clear! (-> self layout))
    (set! (-> self layout bounds-width) 320.0)
    (let ((widget (new 'stack 'mp-overlay-widget)))
      (dotimes (row NOTIFICATION_VISIBLE_COUNT)
        (notification-configure-widget! widget row)
        (mp-overlay-layout-add-widget! (-> self layout) widget)))
    (dotimes (index NOTIFICATION_QUEUE_CAPACITY)
      (set! (-> self entries index name) (new 'process 'string 64 (the-as string #f))))
    (change-to-last-brother self)
    (go-virtual notification-active))
  (none))

(defun ensure-player-notifications! ((owner process))
  (when (and (nonnull? owner *active-pool*) (not (nonnull? (process-by-type-exact 'notification-manager *active-pool*))))
    (process-spawn notification-manager :init notification-init :to owner))
  (none))

(defun notification-expire! ((manager notification-manager) (now time-frame))
  (when (nonnull? manager)
    (let ((entry (notification-entry-at manager (the uint 0))))
      (while (and (nonnull? entry)
                  (>= (-> entry started) 0)
                  (>= (- now (-> entry started)) (+ (* 2 NOTIFICATION_SLIDE_TIME) NOTIFICATION_HOLD_TIME)))
        (set! (-> manager head) (the uint8 (mod (+ (-> manager head) 1) NOTIFICATION_QUEUE_CAPACITY)))
        (-! (-> manager count) 1)
        (set! entry (notification-entry-at manager (the uint 0))))))
  (none))

(defun notification-slide-offset ((age time-frame))
  (let* ((enter-progress (min 1.0 (/ (the float age) NOTIFICATION_SLIDE_TIME)))
         (exit-progress (max 0.0
                             (/ (- (the float age) (+ NOTIFICATION_SLIDE_TIME NOTIFICATION_HOLD_TIME))
                                NOTIFICATION_SLIDE_TIME)))
         (remaining (- 1.0 enter-progress)))
    (the int (* -340.0 (max (* remaining remaining remaining) (min 1.0 exit-progress))))))

(defun notification-row-floor ((manager notification-manager) (row int))
  (let ((floor (the float (* row NOTIFICATION_ROW_HEIGHT))))
    (when (> row 0)
      (let ((previous (notification-entry-at manager (the uint (- row 1)))))
        (when (nonnull? previous)
          (set! floor (max floor (+ (-> previous row-y) (the float NOTIFICATION_ROW_HEIGHT)))))))
    floor))

(defun notification-update-entry! ((entry notification-entry) (floor float) (now time-frame))
  (when (nonnull? entry)
    (when (< (-> entry started) 0)
      (set! (-> entry started) now)
      (set! (-> entry row-y) floor))
    (set! (-> entry row-y) (max floor (- (-> entry row-y) (* 180.0 (seconds-per-frame))))))
  (none))

(defun notification-update-row! ((manager notification-manager) (row int) (now time-frame))
  (when (nonnull? manager)
    (let ((widget (-> manager layout widgets row))
          (entry (notification-entry-at manager (the uint row))))
      (when (nonnull? widget)
        (set! (-> widget enabled?) (if (nonnull? entry) #t #f))
        (when (nonnull? entry)
          (notification-update-entry! entry (notification-row-floor manager row) now)
          (set! (-> widget text) (-> entry text))
          (set! (-> widget offset-x) (notification-slide-offset (- now (-> entry started))))
          (set! (-> widget offset-y) (the int (-> entry row-y)))))))
  (none))

(defun notification-update! ((manager notification-manager))
  (when (nonnull? manager)
    (let ((status (pc-multi-get-session-status)))
      (when (or (= status (mp-connection-status lobby))
                (< status (mp-connection-status connecting))
                (> status (mp-connection-status in-game)))
        (set! (-> manager count) (the uint8 0))
        (set! (-> manager head) (the uint8 0))
        (return (the-as none 0)))
      (let ((now (current-time)))
        (notification-expire! manager now)
        (dotimes (row NOTIFICATION_VISIBLE_COUNT)
          (notification-update-row! manager row now)))
      (mp-overlay-layout-draw! manager)))
  (none))

(defstate notification-active (notification-manager)
  :virtual #t
  :event notification-event-handler
  :code
    (behavior ()
      (until #f
        (notification-update! self)
        (suspend))
      #f))
