;;-*-Lisp-*-
(in-package goal)

(define-extern pc-multi-get-tutorials-seen (function uint))
(define-extern pc-multi-mark-tutorial-seen (function uint int))

(define *tutorial-ride-along-message*
  (new 'static
       'talker-speech-class
       :name "tutorial-ride-along"
       :channel (gui-channel message)
       :text-message (text-id tutorial-ride-along)
       :text-duration (seconds 5)))
(define *tutorial-player-list-message*
  (new 'static
       'talker-speech-class
       :name "tutorial-player-list"
       :channel (gui-channel message)
       :text-message (text-id tutorial-player-list)
       :text-duration (seconds 5)))

(defun multiplayer-tutorial-ready? ()
  (the symbol
       (and (player-list-allowed?)
            (nonnull? *target* (-> *target* control) (-> *target* fact) *gui-control* *entity-pool*)
            (player-target-alive? *target*)
            (> (-> *target* fact health) 0.0)
            (not (focus-test? *target* grabbed teleporting pilot board))
            (not (player-changing-character? *target*))
            (not (or (movie?) (real-movie?) (paused?) (player-list-open?))))))

(defun tutorial-daxter-nearby? ()
  (when (and (nonnull? *target* (-> *target* control))
             (mp-target-jak? *target*)
             (not (nonnull? (get-jak-rider *target*))))
    (mp-for-each-player-target (player-id record player)
      (when (and (nonnull? record player (-> player control))
                 (mp-remote-gameplay-player-connected? record)
                 (mp-target-daxter? player)
                 (player-target-alive? player)
                 (not (focus-test? player grabbed teleporting pilot board))
                 (zero? (-> record action scene-state))
                 (< (vector-vector-distance (-> player control trans) (-> *target* control trans))
                    RIDE_ALONG_MOUNT_DISTANCE))
        (return #t))))
  #f)

(defun start-multiplayer-tutorial! ((manager tutorial-manager) (tutorial multiplayer-tutorial))
  (when (nonnull? manager *target* (-> *target* control) *entity-pool*)
    (let* ((message (if (= tutorial (multiplayer-tutorial ride-along)) *tutorial-ride-along-message* *tutorial-player-list-message*))
           (spawned (process-spawn talker
                                   :init talker-init
                                   message
                                   (-> *target* control trans)
                                   (the-as region #f)
                                   :to *entity-pool*)))
      (when (nonnull? spawned)
        (let ((talker (ppointer->process spawned)))
          (when (nonnull? talker)
            (set! (-> manager current) tutorial)
            (set! (-> manager talker) (process->handle talker)))))))
  (none))

(defun multiplayer-tutorial-action-complete? ((tutorial multiplayer-tutorial))
  (case tutorial
    (((multiplayer-tutorial player-list)) (player-list-open?))
    (((multiplayer-tutorial ride-along))
     (and (nonnull? *target*) (mp-target-jak? *target*) (nonnull? (get-jak-rider *target*))))
    (else #f)))

(defbehavior tutorial-manager-post tutorial-manager ()
  (unless (nonnull? self)
    (return (the-as none 0)))
  (let ((talker (the-as talker (handle->process-safe (-> self talker)))))
    (cond
      ((and (nonnull? talker) (multiplayer-tutorial-action-complete? (-> self current)))
       (pc-multi-mark-tutorial-seen (the uint (-> self current)))
       (send-event talker 'die))
      ((not (multiplayer-tutorial-ready?))
       (set! (-> self player) (the-as handle #f))
       (when (nonnull? talker)
         (send-event talker 'die)))
      ((nonnull? talker (-> talker state) *gui-control*)
       (when (and (= (-> talker state name) 'active)
                  (= (get-status *gui-control* (-> talker message-id)) (gui-status active))
                  (not (logtest? (pc-multi-get-tutorials-seen) (-> self current))))
         (pc-multi-mark-tutorial-seen (the uint (-> self current)))))
      ((nonnull? *target* *gui-control*)
       (when (!= (-> self player) (process->handle *target*))
         (set! (-> self player) (process->handle *target*))
         (set-time! (-> self spawn-time)))
       (when (and (time-elapsed? (-> self spawn-time) (seconds 5))
                  (not (nonnull? (lookup-gui-connection *gui-control*
                                                        (the-as process #f)
                                                        (gui-channel message)
                                                        (the-as string #f)
                                                        (the-as sound-id 0)))))
         (let ((seen (pc-multi-get-tutorials-seen)))
           (cond
             ((and (not (logtest? seen (multiplayer-tutorial ride-along))) (tutorial-daxter-nearby?))
              (start-multiplayer-tutorial! self (multiplayer-tutorial ride-along)))
             ((not (logtest? seen (multiplayer-tutorial player-list)))
              (start-multiplayer-tutorial! self (multiplayer-tutorial player-list)))))))))
  (none))

(defun multiplayer-tutorials-complete? ()
  (= (pc-multi-get-tutorials-seen) (the uint (multiplayer-tutorial ride-along player-list))))

(defstate active (tutorial-manager)
  :virtual #t
  :code sleep-code
  :trans
    (behavior ()
      (when (and (nonnull? self)
                 (multiplayer-tutorials-complete?)
                 (not (nonnull? (handle->process-safe (-> self talker)))))
        (deactivate self)))
  :post tutorial-manager-post)

(defbehavior tutorial-manager-init tutorial-manager ()
  (when (nonnull? self *display* (-> *display* real-clock))
    (set! (-> self clock) (-> *display* real-clock))
    (set! (-> self player) (the-as handle #f))
    (set! (-> self talker) (the-as handle #f))
    (set! (-> self spawn-time) (the-as time-frame 0))
    (set! (-> self current) (the-as multiplayer-tutorial 0))
    (go-virtual active))
  (none))

(defun start-tutorial-manager! ()
  (when (and (nonnull? *target* *active-pool* *mid-pool* *display* (-> *display* real-clock))
             (not (multiplayer-tutorials-complete?))
             (not (nonnull? (process-by-type-exact 'tutorial-manager *active-pool*))))
    (process-spawn tutorial-manager :init tutorial-manager-init :to *mid-pool*))
  (none))
