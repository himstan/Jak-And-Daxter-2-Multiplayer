;;-*-Lisp-*-
(in-package goal)

(defconstant NOTIFICATION_VISIBLE_COUNT 5)
(defconstant NOTIFICATION_ROW_HEIGHT 14.0)
(defconstant NOTIFICATION_TEXT_SCALE 0.27)
(defconstant NOTIFICATION_SLIDE_TIME (seconds 0.35))
(defconstant NOTIFICATION_HOLD_TIME (seconds 12))
(defconstant NOTIFICATION_WIDTH 400.0)
(defconstant NOTIFICATION_AREA_HEIGHT 84.0)

(deftype notification-entry (structure)
  ((started time-frame)
   (row-y   float)
   (color   font-color)
   (name    string)
   (text    string)
   (system? uint8)))

(deftype notification-manager (process)
  ((entries       notification-entry NOTIFICATION_VISIBLE_COUNT :inline)
   (editor        pc-text-input-session :inline)
   (input-display string)
   (name-buffer   string)
   (text-buffer   string)
   (last-serial   uint32)
   (head          uint8)
   (count         uint8))
  (:state-methods
   notification-active))

(define-extern pc-multi-send-chat (function string int))
(define-extern pc-multi-copy-chat (function uint string string uint))
(define-extern ensure-player-notifications! (function process none))
(define-extern notify-player! (function uint text-id none))
