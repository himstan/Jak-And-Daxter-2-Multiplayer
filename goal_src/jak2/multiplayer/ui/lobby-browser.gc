;;-*-Lisp-*-
(in-package goal)

(define *lobby-browser-text* (new 'global 'string 64 (the-as string #f)))
(define *overlay-fit-text* (new 'global 'string 512 (the-as string #f)))
(define *lobby-browser-column-starts* (new 'static 'boxed-array :type float 0.09 0.82 0.35))
(define *lobby-browser-column-widths* (new 'static 'boxed-array :type float 0.24 0.15 0.45))
(define *lobby-browser-headers*
  (new 'static
       'boxed-array
       :type text-id
       (text-id progress-lobby-browser-host)
       (text-id progress-lobby-browser-players)
       (text-id progress-lobby-browser-info)))
(define *browse-games-options-pc*
  (new 'static
       'menu-option-list
       :y-center #xc6
       :y-space 30
       :scale 0.82
       :options
       (new 'static
            'boxed-array
            :type menu-option
            (new 'static 'menu-lobby-browser-option :name (text-id progress-join-game)))
       :on-tick
       (lambda ((the-progress progress))
         (accept-steam-invite! the-progress)
         (none))))

(defun lobby-browser ()
  (the-as menu-lobby-browser-option (-> *browse-games-options-pc* options 0)))

(defun lobby-browser-now ()
  (if (nonnull? *display*) (-> *display* real-clock frame-counter) (the-as time-frame 0)))

(defun select-lobby-row! ((browser menu-lobby-browser-option) (row int))
  (set! (-> browser selected-row) row)
  (set! (-> browser selected-at) (lobby-browser-now))
  (none))

(defun open-lobby-browser! ((p progress))
  (when (nonnull? p)
    (prepare-steam-join!)
    (pc-multi-search-lobbies)
    (let ((browser (lobby-browser))) (select-lobby-row! browser 0) (set! (-> browser first-row) 0))
    (set! (-> p current-options) *browse-games-options-pc*))
  (none))

(defun lobby-browser-left ()
  (let ((left-x (if (= (get-aspect-ratio) 'aspect16x9) 79 69)))
    (#when PC_PORT
      (when (and (nonnull? *pc-settings*) (not (-> *pc-settings* use-vis?)))
        (set! left-x (the int (adjust-game-x (the float left-x))))))
    (the float left-x)))

(defun lobby-browser-width ()
  (let ((width (if (= (get-aspect-ratio) 'aspect16x9) 355 375)))
    (#when PC_PORT
      (when (and (nonnull? *pc-settings*) (not (-> *pc-settings* use-vis?)))
        (set! width (the int (* (-> *pc-settings* aspect-ratio-reciprocal) width)))))
    (the float width)))

(defun lobby-browser-clamp! ((browser menu-lobby-browser-option))
  (let ((selected (max 0 (min (the int (-> browser selected-row)) (+ (pc-multi-get-lobby-count) -1)))))
    (set! (-> browser selected-row) selected)
    (set! (-> browser first-row)
          (max (+ selected 1 (- LOBBY_BROWSER_VISIBLE_ROWS)) (min (the int (-> browser first-row)) selected))))
  (none))

(defun move-lobby-browser-selection! ((browser menu-lobby-browser-option) (step int))
  (let ((count (pc-multi-get-lobby-count)))
    (when (> count 1)
      (select-lobby-row! browser (mod (+ (-> browser selected-row) step count) count))
      (sound-play "roll-over")))
  (none))

(defun join-selected-lobby! ((browser menu-lobby-browser-option) (p progress))
  (if (zero? (pc-multi-lobby-compatible? (-> browser selected-row)))
    (sound-play "menu-error")
    (begin-steam-join! p (pc-multi-join-lobby (-> browser selected-row))))
  (none))

(defun refresh-lobby-browser! ((browser menu-lobby-browser-option))
  (sound-play "generic-beep")
  (select-lobby-row! browser 0)
  (set! (-> browser first-row) 0)
  (pc-multi-search-lobbies)
  (none))

(defun print-lobby-browser-text ((font-ctx font-context) (text string) (x float) (y float))
  (set! (-> font-ctx origin x) x)
  (set! (-> font-ctx origin y) y)
  (print-game-text text font-ctx #f 44 (bucket-id progress))
  (none))

(defun print-lobby-browser-centered ((font-ctx font-context)
                                     (label text-id)
                                     (left float)
                                     (width float)
                                     (y float)
                                     (scale float))
  (set-scale! font-ctx scale)
  (set-width! font-ctx (the int width))
  (set-color! font-ctx (font-color progress))
  (set-flags! font-ctx (font-flags kerning middle large))
  (print-lobby-browser-text font-ctx (lookup-text! *common-text* label #f) left y)
  (none))

(defun lobby-browser-column-width ((width float) (column int))
  (* width (-> *lobby-browser-column-widths* column)))

(defun print-lobby-browser-cell ((font-ctx font-context)
                                 (text string)
                                 (left float)
                                 (width float)
                                 (column int)
                                 (y float))
  (let ((right? (= column 1)))
    (set-width! font-ctx (the int (lobby-browser-column-width width column)))
    (set-flags! font-ctx (if right? (font-flags kerning right large) (font-flags kerning large)))
    (print-lobby-browser-text font-ctx
                              text
                              (+ left
                                 (* width
                                    (+ (-> *lobby-browser-column-starts* column)
                                       (if right? (-> *lobby-browser-column-widths* column) 0.0))))
                              y))
  (none))

(defun fit-overlay-text ((text string) (font-ctx font-context) (max-width float))
  (when (nonnull? text font-ctx *overlay-fit-text* *pc-encoded-temp-string*)
    (copy-string<-string *overlay-fit-text* text)
    (pc-encode-utf8-literal *overlay-fit-text* *pc-encoded-temp-string*)
    (let ((chars (length text)))
      (while (and (> chars 0) (> (-> (get-string-length *pc-encoded-temp-string* font-ctx) length) max-width))
        (-! chars 1)
        (while (and (> chars 0) (= (logand (-> *overlay-fit-text* data chars) #xc0) #x80))
          (-! chars 1))
        (set! (-> *overlay-fit-text* data chars) 0)
        (format *overlay-fit-text* "...")
        (pc-encode-utf8-literal *overlay-fit-text* *pc-encoded-temp-string*))))
  *pc-encoded-temp-string*)

(defun next-char-offset ((text string) (offset int))
  (let ((next (+ offset 1))) (while (= (logand (-> text data next) #xc0) #x80) (+! next 1)) next))

(defun text-suffix-width ((text string) (offset int) (font-ctx font-context))
  (string<-charp *overlay-fit-text* (&-> text data offset))
  (pc-encode-utf8-literal *overlay-fit-text* *pc-encoded-temp-string*)
  (-> (get-string-length *pc-encoded-temp-string* font-ctx) length))

(defun overflow-steps ((text string) (font-ctx font-context) (max-width float))
  (let ((offset 0)
        (steps 0))
    (while (and (nonzero? (-> text data offset)) (> (text-suffix-width text offset font-ctx) max-width))
      (set! offset (next-char-offset text offset))
      (+! steps 1))
    steps))

(defun scroll-step ((steps int) (elapsed time-frame))
  (let ((cycle-time (mod elapsed (+ (* 2 LOBBY_BROWSER_SCROLL_PAUSE) (* steps LOBBY_BROWSER_SCROLL_STEP)))))
    (max 0 (min steps (/ (- cycle-time LOBBY_BROWSER_SCROLL_PAUSE) LOBBY_BROWSER_SCROLL_STEP)))))

(defun scroll-text! ((text string) (font-ctx font-context) (max-width float) (elapsed time-frame))
  (let ((offset 0))
    (dotimes (step (scroll-step (overflow-steps text font-ctx max-width) elapsed))
      (set! offset (next-char-offset text offset)))
    (string<-charp text (&-> text data offset)))
  text)

(defun draw-lobby-browser-frame ((option menu-option) (font-ctx font-context) (left float) (width float) (alpha float))
  (set-height! font-ctx 30)
  (set-vector! (-> option box 0 color) 64 128 128 (the int (* 128.0 alpha)))
  (draw-lobby-box option left (+ left width) LOBBY_BROWSER_TOP LOBBY_BROWSER_TOP)
  (draw-lobby-box option left (+ left width) LOBBY_BROWSER_DIVIDER_Y LOBBY_BROWSER_DIVIDER_Y)
  (none))

(defun draw-lobby-browser-header ((font-ctx font-context) (left float) (width float))
  (set-scale! font-ctx 0.33)
  (set-color! font-ctx (font-color progress-option-off))
  (dotimes (column (-> *lobby-browser-headers* length))
    (print-lobby-browser-cell font-ctx
                              (lookup-text! *common-text* (-> *lobby-browser-headers* column) #f)
                              left
                              width
                              column
                              LOBBY_BROWSER_HEADER_Y))
  (none))

(defun draw-lobby-browser-highlight ((left float) (width float) (y float) (alpha float))
  (when (nonnull? *display*)
    (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id particles))
      (draw-sprite2d-xy buffer
                        (the int left)
                        (the int (+ y -3.0))
                        (the int width)
                        (the int LOBBY_BROWSER_ROW_HEIGHT)
                        (new 'static 'rgba :r #x40 :g #x40 :b #x40 :a (the int (* 64.0 alpha))))))
  (none))

(defun connection-type-icon ((connection connection-type))
  (let ((label (case connection
                 (((connection-type friend)) (text-id connection-icon-friend))
                 (((connection-type steam)) (text-id connection-icon-steam))
                 (((connection-type lan)) (text-id connection-icon-lan))
                 (((connection-type internet)) (text-id connection-icon-internet))
                 (else (text-id null)))))
    (if (= label (text-id null)) (the-as string #f) (lookup-text! *common-text* label #f))))

(defun print-lobby-browser-icon ((font-ctx font-context) (lobby-index int) (left float) (width float) (y float))
  (let ((icon (connection-type-icon (pc-multi-get-lobby-connection-type lobby-index))))
    (when icon
      (set-flags! font-ctx (font-flags kerning large))
      (print-lobby-browser-text font-ctx icon (+ left (* 0.03 width)) y)))
  (none))

(defun draw-lobby-browser-row ((font-ctx font-context)
                               (lobby-index int)
                               (left float)
                               (width float)
                               (y float)
                               (selected? symbol)
                               (scroll-time time-frame)
                               (alpha float))
  (when (nonnull? font-ctx)
    (set! (-> font-ctx alpha)
          (if (= (pc-multi-lobby-compatible? lobby-index) 1) alpha (* LOBBY_BROWSER_INCOMPATIBLE_ALPHA alpha)))
    (set-scale! font-ctx LOBBY_BROWSER_ROW_SCALE)
    (set-color! font-ctx (if selected? (font-color progress-force-selected) (font-color progress)))
    (print-lobby-browser-icon font-ctx lobby-index left width y)
    (dotimes (column (-> *lobby-browser-headers* length))
      (when (= (pc-multi-get-lobby-field lobby-index column *lobby-browser-text*) 1)
        (let ((max-width (lobby-browser-column-width width column)))
          (when selected?
            (scroll-text! *lobby-browser-text* font-ctx max-width scroll-time))
          (print-lobby-browser-cell font-ctx
                                    (fit-overlay-text *lobby-browser-text* font-ctx max-width)
                                    left
                                    width
                                    column
                                    y))))
    (set! (-> font-ctx alpha) alpha))
  (none))

(defun draw-lobby-browser-rows ((browser menu-lobby-browser-option)
                                (font-ctx font-context)
                                (left float)
                                (width float)
                                (alpha float))
  (let ((count (pc-multi-get-lobby-count))
        (selected (the int (-> browser selected-row)))
        (scroll-time (- (lobby-browser-now) (-> browser selected-at))))
    (dotimes (slot LOBBY_BROWSER_VISIBLE_ROWS)
      (let ((lobby-index (+ (-> browser first-row) slot))
            (y (+ LOBBY_BROWSER_ROW_Y (* LOBBY_BROWSER_ROW_HEIGHT (the float slot)))))
        (when (< lobby-index count)
          (when (= lobby-index selected)
            (draw-lobby-browser-highlight left width y alpha))
          (draw-lobby-browser-row font-ctx lobby-index left width y (= lobby-index selected) scroll-time alpha)))))
  (none))

(defun lobby-browser-status-text ()
  (if (= (pc-multi-get-lobby-search-status) (mp-discovery-status searching))
    (text-id progress-searching)
    (text-id progress-no-games-found)))

(defun selected-lobby-incompatible? ((browser menu-lobby-browser-option))
  (and (nonzero? (pc-multi-get-lobby-count)) (zero? (pc-multi-lobby-compatible? (-> browser selected-row)))))

(defun print-lobby-browser-prompts ((browser menu-lobby-browser-option)
                                    (font-ctx font-context)
                                    (left float)
                                    (width float)
                                    (alpha float))
  (let* ((incompatible? (selected-lobby-incompatible? browser))
         (action (lookup-text! *common-text*
                               (if incompatible? (text-id progress-lobby-browser-incompatible-prompt) (text-id progress-lobby-browser-join-prompt))
                               #f))
         (actions (lookup-text! *common-text* (text-id progress-lobby-browser-prompts) #f)))
    (when (nonnull? font-ctx action actions)
      (set-scale! font-ctx 0.35)
      (set-width! font-ctx (the int width))
      (set-color! font-ctx (font-color progress))
      (set-flags! font-ctx (font-flags kerning large))
      (let* ((action-width (+ (-> (get-string-length action font-ctx) length) LOBBY_BROWSER_PROMPT_GAP))
             (x (+ left (* 0.5 (- width action-width (-> (get-string-length actions font-ctx) length))))))
        (set! (-> font-ctx alpha) (if incompatible? (* LOBBY_BROWSER_INCOMPATIBLE_ALPHA alpha) alpha))
        (print-lobby-browser-text font-ctx action x LOBBY_BROWSER_PROMPT_Y)
        (set! (-> font-ctx alpha) alpha)
        (print-lobby-browser-text font-ctx actions (+ x action-width) LOBBY_BROWSER_PROMPT_Y))))
  (none))

(defmethod respond-progress ((this menu-lobby-browser-option) (p progress) (selected? symbol))
  (when (nonnull? p)
    (set! (-> p selected-option) #f)
    (cond
      ((cpad-pressed? 0 up l-analog-up) (cpad-clear! 0 up) (move-lobby-browser-selection! this -1))
      ((cpad-pressed? 0 down l-analog-down) (cpad-clear! 0 down) (move-lobby-browser-selection! this 1))
      ((cpad-pressed? 0 square) (cpad-clear! 0 square) (refresh-lobby-browser! this))
      ((cpad-pressed? 0 circle)
       (cpad-clear! 0 circle)
       (sound-play "generic-beep")
       (push-state p)
       (set-next-state p 'manual-join 0))
      ((cpad-pressed? 0 confirm) (cpad-clear! 0 confirm) (join-selected-lobby! this p))))
  0)

(defmethod draw-option ((this menu-lobby-browser-option)
                        (p progress)
                        (font-ctx font-context)
                        (option-index int)
                        (selected? symbol))
  (when (nonnull? p font-ctx)
    (let ((alpha (fmax 0.0 (* 2.0 (- 0.5 (-> p menu-transition)))))
          (left (lobby-browser-left))
          (width (lobby-browser-width)))
      (set! (-> font-ctx alpha) alpha)
      (draw-lobby-browser-frame this font-ctx left width alpha)
      (print-lobby-browser-centered font-ctx (text-id progress-join-game) left width 80.0 0.65)
      (draw-lobby-browser-header font-ctx left width)
      (lobby-browser-clamp! this)
      (if (zero? (pc-multi-get-lobby-count))
        (print-lobby-browser-centered font-ctx (lobby-browser-status-text) left width 200.0 0.5)
        (draw-lobby-browser-rows this font-ctx left width alpha))
      (print-lobby-browser-prompts this font-ctx left width alpha)))
  (none))
