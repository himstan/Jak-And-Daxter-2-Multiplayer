;;-*-Lisp-*-
(in-package goal)

(defun mp-player-list-string-resolver! ((owner process) (binding-index uint) (destination string))
  (when (nonnull? destination)
    (clear destination)
    (cond
      ((< binding-index (the uint MP_MAX_PLAYERS))
       (mp-player-copy-name! destination binding-index)
       (return (> (length destination) 0)))
      ((< binding-index (the uint (* MP_MAX_PLAYERS 2)))
       (let ((ping (pc-multi-get-player-ping (- binding-index MP_MAX_PLAYERS)))
             (template (mp-overlay-localized-text (text-id mp-player-list-ping-format))))
         (cond
           ((< ping 0) (format destination "--") (return #t))
           ((nonnull? template) (format destination template ping) (return #t)))))))
  #f)

(defun mp-player-list-add-headers! ((layout mp-overlay-layout) (widget mp-overlay-widget))
  (when (nonnull? layout widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) (text-id mp-player-list-header-player))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget offset-x) 20)
    (set! (-> widget offset-y) 28)
    (set! (-> widget width) 240.0)
    (set! (-> widget height) 16.0)
    (set! (-> widget scale) 0.60)
    (set! (-> widget color) (the-as uint32 (font-color white)))
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (mp-overlay-layout-add-widget! layout widget)
    (set! (-> widget text) (text-id mp-player-list-header-ping))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor right))
    (set! (-> widget offset-x) -20)
    (set! (-> widget width) 100.0)
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning right large)))
    (mp-overlay-layout-add-widget! layout widget))
  (none))

(defun mp-player-list-add-row! ((layout mp-overlay-layout) (widget mp-overlay-widget) (player-id int))
  (when (nonnull? layout widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) (text-id mp-player-list-name-format))
    (set! (-> widget parameter-kind) (mp-overlay-parameter-kind string))
    (set! (-> widget parameter-index) (the uint32 player-id))
    (set! (-> widget required-conditions) (the uint32 (ash 1 player-id)))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget offset-x) 20)
    (set! (-> widget offset-y) (+ 60 (* player-id 25)))
    (set! (-> widget width) 240.0)
    (set! (-> widget height) 16.0)
    (set! (-> widget scale) 0.62)
    (set! (-> widget color) (the-as uint32 (mp-player-font-color-by-id player-id)))
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (mp-overlay-layout-add-widget! layout widget)
    (set! (-> widget parameter-index) (the uint32 (+ MP_MAX_PLAYERS player-id)))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor right))
    (set! (-> widget offset-x) -20)
    (set! (-> widget width) 100.0)
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning right large)))
    (mp-overlay-layout-add-widget! layout widget))
  (none))

(defun mp-player-list-build-layout! ((layout mp-overlay-layout))
  (when (nonnull? layout)
    (mp-overlay-layout-clear! layout)
    (set! (-> layout bounds-x) 56)
    (set! (-> layout bounds-y) 50)
    (set! (-> layout bounds-width) 400.0)
    (set! (-> layout bounds-height) (+ 60.0 (* 25.0 (the float MP_MAX_PLAYERS))))
    (let ((widget (new 'stack 'mp-overlay-widget)))
      (when (nonnull? widget)
        (mp-overlay-widget-default! widget)
        (set! (-> widget text) (text-id mp-player-list-title))
        (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor center))
        (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
        (set! (-> widget offset-y) 6)
        (set! (-> widget width) 400.0)
        (set! (-> widget height) 20.0)
        (set! (-> widget scale) 0.75)
        (set! (-> widget color) (the-as uint32 (font-color white)))
        (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning middle large)))
        (mp-overlay-layout-add-widget! layout widget)
        (mp-player-list-add-headers! layout widget)
        (dotimes (i MP_MAX_PLAYERS)
          (mp-player-list-add-row! layout widget i)))))
  layout)

(defun mp-player-list-visible? ()
  (the symbol (and *mp-player-list* (nonzero? *mp-player-list*) (-> *mp-player-list* visible?))))

(defun mp-player-list-show! ()
  (when (and *mp-player-list* (nonzero? *mp-player-list*) *target-pool* (nonzero? *target-pool*))
    (when (not (-> *mp-player-list* visible?))
      (mp-player-list-build-layout! (-> *mp-player-list* layout))
      (let ((overlay (mp-overlay-layout-start! (the-as process *target-pool*)
                                               (-> *mp-player-list* layout)
                                               mp-player-list-string-resolver!)))
        (when (and overlay (nonzero? overlay))
          (set! (-> *mp-player-list* overlay) overlay)
          (set! (-> *mp-player-list* visible?) #t)
          (return #t)))))
  #f)

(defun mp-player-list-hide! ()
  (when (and *mp-player-list* (nonzero? *mp-player-list*) (-> *mp-player-list* visible?))
    (when (and (-> *mp-player-list* overlay)
               (nonzero? (-> *mp-player-list* overlay))
               *target-pool*
               (nonzero? *target-pool*))
      (mp-overlay-layout-stop! (-> *mp-player-list* overlay) (the-as process *target-pool*)))
    (set! (-> *mp-player-list* overlay) (the-as (pointer mp-overlay-layout-process) #f))
    (set! (-> *mp-player-list* visible?) #f)
    (return #t))
  #f)

(defun get-nametag-owner-process ((record mp-player-record))
  (unless (nonnull? record)
    (return (the-as process-drawable #f)))
  (let ((replica (mp-player-record-target record)))
    (unless (nonnull? replica)
      (return (the-as process-drawable #f)))
    (if (and (mp-player-daxter? record) (mp-target-ride-along? replica))
      (let ((jak-target (get-attached-jak-proc replica)))
        (when (nonnull? jak-target (-> jak-target sidekick))
          (let ((sidekick-proc (the-as sidekick (ppointer->process (-> jak-target sidekick)))))
            (when (nonnull? sidekick-proc)
              (return (the-as process-drawable sidekick-proc)))))
        (the-as process-drawable #f))
      (the-as process-drawable replica))))

(defun get-player-nametag-anchor! ((position vector) (record mp-player-record))
  (unless (nonnull? position record)
    (return #f))
  (let ((process (get-nametag-owner-process record)))
    (unless (nonnull? process (-> process draw) (-> process node-list))
      (return #f))
    (when (logtest? (-> process draw status) (draw-control-status uninited no-draw no-draw-temp))
      (return #f))
    (let* ((daxter? (mp-player-daxter? record))
           (nodes (-> process node-list))
           (head-index (if daxter? (joint-node-index daxter-lod0-jg head) (joint-node-index jakb-lod0-jg neckB)))
           (shoulder-sidekick? (the-as symbol (and daxter? (type? process sidekick)))))
      (unless (and (>= head-index 0) (< head-index (-> nodes length)) (nonnull? (-> nodes data)))
        (return #f))
      (let ((head (-> nodes data head-index)))
        (unless (nonnull? head (-> head bone))
          (return #f))
        (unless (!= (-> head bone transform trans w) 0.0)
          (return #f))
        (vector<-cspace! position head))
      (+! (-> position y)
          (if daxter?
            (if shoulder-sidekick? PLAYER_NAMETAG_DAXTER_RIDING_CLEARANCE PLAYER_NAMETAG_DAXTER_CLEARANCE)
            PLAYER_NAMETAG_JAK_CLEARANCE))))
  #t)

(defun set-player-nametag-matrix! ((projection matrix) (anchor vector))
  (when (nonnull? projection anchor *math-camera* *font-work* *video-params*)
    (let ((billboard (new 'stack-no-clear 'matrix))
          (glyph-scale (/ PLAYER_NAMETAG_GLYPH_HEIGHT (-> *font-work* size3-large y))))
      (matrix-copy! billboard (-> *math-camera* inv-camera-rot))
      (vector-float*! (-> billboard vector 0) (-> billboard vector 0) (- glyph-scale))
      (vector-float*! (-> billboard vector 1) (-> billboard vector 1) (- glyph-scale))
      (set! (-> billboard vector 0 w) 0.0)
      (set! (-> billboard vector 1 w) 0.0)
      (vector-copy! (-> billboard trans) anchor)
      (matrix*! projection billboard (-> *math-camera* camera-temp))
      (*! (-> projection vector 0 x) (-> *video-params* relative-x-scale-reciprical))))
  (none))

(defun draw-player-nametag! ((record mp-player-record) (buffer dma-buffer))
  (unless (nonnull? record buffer *math-camera* *font-work* *video-params* *nametag-string*)
    (return #f))
  (let ((anchor (new 'stack-no-clear 'vector))
        (clipped-position (new 'stack-no-clear 'vector))
        (projection (new 'stack-no-clear 'matrix)))
    (unless (and (get-player-nametag-anchor! anchor record)
                 (<= (vector-vector-distance (-> *math-camera* trans) anchor) PLAYER_NAMETAG_MAX_DISTANCE)
                 (transform-point-vector! clipped-position anchor))
      (return #f))
    (set-player-nametag-matrix! projection anchor)
    (let* ((player-id (the uint (-> record identity player-id)))
           (context (new 'stack
                         'font-context
                         projection
                         0
                         0
                         0.0
                         (mp-player-font-color-by-id (the int player-id))
                         (font-flags shadow kerning large))))
      (when (nonnull? context)
        (mp-player-copy-name! *nametag-string* player-id)
        (let ((width (-> (get-string-length *nametag-string* context) length)))
          (set! (-> context origin x) (* -0.5 width))
          (set! (-> context origin y) (- (- (-> *font-work* size3-large y)) 40.0))
          (set! (-> context origin z) 0.0)
          (set! (-> context width) (+ width (-> *font-work* size1-large x)))
          (set! (-> context height) (-> *font-work* size3-large y))
          (set! (-> context projection) (-> *math-camera* inv-hmge-scale w))
          (pc-encode-utf8-string *nametag-string* *nametag-string*)
          (draw-string *nametag-string* buffer context)))))
  #t)

(defun player-nametags-visible? ()
  (if (nonnull? *multiplayer-preferences*)
    (case (-> *multiplayer-preferences* nametag-visibility)
      (((player-nametag-visibility always)) #t)
      (((player-nametag-visibility hold)) (mp-player-list-visible?))
      (else #f))
    (mp-player-list-visible?)))

(defun draw-player-nametags! ()
  (when (and (mp-session-in-game?)
             (player-nametags-visible?)
             (nonnull? *display*
                       *math-camera*
                       *font-work*
                       *video-params*
                       *nametag-string*
                       (-> *display* frames (-> *display* on-screen) global-buf)))
    (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id subtitle))
      (dma-buffer-add-gs-set buffer
                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x130 :psm (gs-psm ct24) :zmsk #x1))
                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always))))
      (dotimes (i MP_MAX_PLAYERS)
        (let ((record (mp-player-record-by-id (the uint i))))
          (when (and (nonnull? record) (is-record-remote-player? record))
            (draw-player-nametag! record buffer))))
      (dma-buffer-add-gs-set buffer
                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x130 :psm (gs-psm ct24)))
                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))))))
  (none))

(defun mp-player-list-update! ()
  (let ((select-held? (and (mp-session-in-game?)
                           *cpad-list*
                           (nonzero? *cpad-list*)
                           (cpad-hold? 0 select)
                           (not (cpad-hold? 0 l3)))))
    (if select-held?
      (begin
        (when (not (mp-player-list-visible?))
          (mp-player-list-show!))
        (when (and (mp-player-list-visible?)
                   (-> *mp-player-list* overlay)
                   (nonzero? (-> *mp-player-list* overlay))
                   *target-pool*
                   (nonzero? *target-pool*))
          (let ((conditions (the uint32 0))
                (local-id (if (and *mp-player-controller* (nonzero? *mp-player-controller*)) (-> *mp-player-controller* local-player-id) (the uint 0))))
            (dotimes (i MP_MAX_PLAYERS)
              (let ((record (mp-player-record-by-id (the uint i))))
                (when (or (= (the uint i) local-id)
                          (and record (nonzero? record) (nonzero? (-> record identity identity-ready?))))
                  (logior! conditions (ash 1 i)))))
            (mp-overlay-layout-set-conditions! (-> *mp-player-list* overlay) (the-as process *target-pool*) conditions))))
      (when (mp-player-list-visible?)
        (mp-player-list-hide!))))
  #t)
