;;-*-Lisp-*-
(in-package goal)

(defun mp-player-list-string-resolver! ((owner process) (binding-index uint) (destination string))
  (when (nonnull? destination)
    (clear destination)
    (cond
      ((< binding-index (the uint MP_MAX_PLAYERS))
       (mp-player-copy-name! destination binding-index)
       (return (> (length destination) 0)))
      ((< binding-index (the uint (* MP_MAX_PLAYERS 2)))
       (let ((ping (pc-multi-get-player-ping (- binding-index MP_MAX_PLAYERS)))
             (template (mp-overlay-localized-text (text-id mp-player-list-ping-format))))
         (cond
           ((< ping 0) (format destination "--") (return #t))
           ((nonnull? template) (format destination template ping) (return #t)))))))
  #f)

(defun mp-player-list-add-headers! ((layout mp-overlay-layout) (widget mp-overlay-widget))
  (when (nonnull? layout widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) (text-id mp-player-list-header-player))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget offset-x) 20)
    (set! (-> widget offset-y) 28)
    (set! (-> widget width) 240.0)
    (set! (-> widget height) 16.0)
    (set! (-> widget scale) 0.60)
    (set! (-> widget color) (the-as uint32 (font-color flat-yellow)))
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (mp-overlay-layout-add-widget! layout widget)
    (set! (-> widget text) (text-id mp-player-list-header-ping))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor right))
    (set! (-> widget offset-x) -20)
    (set! (-> widget width) 100.0)
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning right large)))
    (mp-overlay-layout-add-widget! layout widget))
  (none))

(defun mp-player-list-add-row! ((layout mp-overlay-layout) (widget mp-overlay-widget) (player-id int))
  (when (nonnull? layout widget)
    (mp-overlay-widget-default! widget)
    (set! (-> widget text) (text-id mp-player-list-name-format))
    (set! (-> widget parameter-kind) (mp-overlay-parameter-kind string))
    (set! (-> widget parameter-index) (the uint32 player-id))
    (set! (-> widget required-conditions) (the uint32 (ash 1 player-id)))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor left))
    (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
    (set! (-> widget offset-x) 20)
    (set! (-> widget offset-y) (+ 60 (* player-id 25)))
    (set! (-> widget width) 240.0)
    (set! (-> widget height) 16.0)
    (set! (-> widget scale) 0.62)
    (set! (-> widget color) (the-as uint32 (mp-player-font-color-by-id player-id)))
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning large)))
    (mp-overlay-layout-add-widget! layout widget)
    (set! (-> widget parameter-index) (the uint32 (+ MP_MAX_PLAYERS player-id)))
    (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor right))
    (set! (-> widget offset-x) -20)
    (set! (-> widget width) 100.0)
    (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning right large)))
    (mp-overlay-layout-add-widget! layout widget))
  (none))

(defun mp-player-list-build-layout! ((layout mp-overlay-layout))
  (when (nonnull? layout)
    (mp-overlay-layout-clear! layout)
    (set! (-> layout bounds-x) 56)
    (set! (-> layout bounds-y) 50)
    (set! (-> layout bounds-width) 400.0)
    (set! (-> layout bounds-height) (+ 60.0 (* 25.0 (the float MP_MAX_PLAYERS))))
    (let ((widget (new 'stack 'mp-overlay-widget)))
      (when (nonnull? widget)
        (mp-overlay-widget-default! widget)
        (set! (-> widget text) (text-id mp-player-list-title))
        (set! (-> widget horizontal-anchor) (mp-overlay-horizontal-anchor center))
        (set! (-> widget vertical-anchor) (mp-overlay-vertical-anchor top))
        (set! (-> widget offset-y) 6)
        (set! (-> widget width) 400.0)
        (set! (-> widget height) 20.0)
        (set! (-> widget scale) 0.75)
        (set! (-> widget color) (the-as uint32 (font-color white)))
        (set! (-> widget font-flags) (the-as uint32 (font-flags shadow kerning middle large)))
        (mp-overlay-layout-add-widget! layout widget)
        (mp-player-list-add-headers! layout widget)
        (dotimes (i MP_MAX_PLAYERS)
          (mp-player-list-add-row! layout widget i)))))
  layout)

(defun mp-player-list-visible? ()
  (the symbol (and *mp-player-list* (nonzero? *mp-player-list*) (-> *mp-player-list* visible?))))

(defun mp-player-list-show! ()
  (when (and *mp-player-list* (nonzero? *mp-player-list*) *target-pool* (nonzero? *target-pool*))
    (when (not (-> *mp-player-list* visible?))
      (mp-player-list-build-layout! (-> *mp-player-list* layout))
      (let ((overlay (mp-overlay-layout-start! (the-as process *target-pool*)
                                               (-> *mp-player-list* layout)
                                               mp-player-list-string-resolver!)))
        (when (and overlay (nonzero? overlay))
          (set! (-> *mp-player-list* overlay) overlay)
          (set! (-> *mp-player-list* visible?) #t)
          (return #t)))))
  #f)

(defun mp-player-list-hide! ()
  (when (and *mp-player-list* (nonzero? *mp-player-list*) (-> *mp-player-list* visible?))
    (when (and (-> *mp-player-list* overlay)
               (nonzero? (-> *mp-player-list* overlay))
               *target-pool*
               (nonzero? *target-pool*))
      (mp-overlay-layout-stop! (-> *mp-player-list* overlay) (the-as process *target-pool*)))
    (set! (-> *mp-player-list* overlay) (the-as (pointer mp-overlay-layout-process) #f))
    (set! (-> *mp-player-list* visible?) #f)
    (return #t))
  #f)

(defun mp-player-nametag-draw! ((record mp-player-record) (local-pos vector))
  (let ((player-target (mp-player-record-target record)))
    (when (and player-target (nonzero? player-target) (-> player-target root) (nonzero? (-> player-target root)))
      (let* ((target-pos (-> player-target root trans))
             (dist (vector-vector-distance local-pos target-pos)))
        (when (<= dist MP_PLAYER_NAMETAG_MAX_DIST)
          (let ((draw-pos (new 'stack-no-clear 'vector))
                (screen-pos (new 'stack-no-clear 'vector4w))
                (player-id (the-as uint (-> record identity player-id))))
            (vector-copy! draw-pos target-pos)
            (+! (-> draw-pos y)
                (if (= (-> record identity character) (mp-player-character daxter))
                  MP_PLAYER_NAMETAG_Y_OFFSET_DAXTER
                  MP_PLAYER_NAMETAG_Y_OFFSET_JAK))
            (when (transform-point-qword! screen-pos draw-pos)
              (let ((font-ctx (new 'stack
                                   'font-context
                                   *font-default-matrix*
                                   0
                                   0
                                   0.0
                                   (mp-player-font-color-by-id (the int player-id))
                                   (font-flags shadow kerning))))
                (set-origin! font-ctx (+ (/ (-> screen-pos x) 16) -1792) (+ (/ (-> screen-pos y) 16) -1855))
                (set-depth! font-ctx (/ (-> screen-pos z) 16))
                (set-scale! font-ctx
                            (lerp-scale MP_PLAYER_NAMETAG_MAX_SCALE
                                        MP_PLAYER_NAMETAG_MIN_SCALE
                                        dist
                                        MP_PLAYER_NAMETAG_SCALE_MIN_DIST
                                        MP_PLAYER_NAMETAG_MAX_DIST))
                (mp-player-copy-name! *nametag-string* player-id)
                (let ((str-res (get-string-length *nametag-string* font-ctx)))
                  (-! (-> font-ctx origin x) (/ (-> str-res length) 2.0)))
                (with-dma-buffer-add-bucket ((buf (-> *display* frames (-> *display* on-screen) global-buf))
                                             (bucket-id subtitle))
                  (draw-string *nametag-string* buf font-ctx)))))))))
  (none))

(defun mp-player-nametags-update! ()
  (let ((local-target (mp-player-record-target (mp-local-player-record))))
    (when (and local-target (nonzero? local-target) (-> local-target root) (nonzero? (-> local-target root)))
      (let ((local-pos (-> local-target root trans)))
        (dotimes (i MP_MAX_PLAYERS)
          (let ((record (mp-player-record-by-id (the uint i))))
            (when (and record (nonzero? record) (is-record-remote-player? record))
              (mp-player-nametag-draw! record local-pos)))))))
  (none))

(defun mp-player-list-update! ()
  (let ((select-held? (and (mp-session-in-game?)
                           *cpad-list*
                           (nonzero? *cpad-list*)
                           (cpad-hold? 0 select)
                           (not (cpad-hold? 0 l3)))))
    (if select-held?
      (begin
        (when (not (mp-player-list-visible?))
          (mp-player-list-show!))
        (mp-player-nametags-update!)
        (when (and (mp-player-list-visible?)
                   (-> *mp-player-list* overlay)
                   (nonzero? (-> *mp-player-list* overlay))
                   *target-pool*
                   (nonzero? *target-pool*))
          (let ((conditions (the uint32 0))
                (local-id (if (and *mp-player-controller* (nonzero? *mp-player-controller*)) (-> *mp-player-controller* local-player-id) (the uint 0))))
            (dotimes (i MP_MAX_PLAYERS)
              (let ((record (mp-player-record-by-id (the uint i))))
                (when (or (= (the uint i) local-id)
                          (and record (nonzero? record) (nonzero? (-> record identity identity-ready?))))
                  (logior! conditions (ash 1 i)))))
            (mp-overlay-layout-set-conditions! (-> *mp-player-list* overlay) (the-as process *target-pool*) conditions))))
      (when (mp-player-list-visible?)
        (mp-player-list-hide!))))
  #t)
