;;-*-Lisp-*-
(in-package goal)

(define *player-list* (new 'static 'menu-player-list-option))
(define *nametags-requested-with-hud?* #f)

(defun player-list-open? ()
  (-> *player-list* open?))

(defun player-list-allowed? ()
  (and (mp-session-in-game?) (= *master-mode* 'game) (not *progress-process*) (progress-allowed?)))

(defun open-player-list! ()
  (set! *lobby-action-player* -1)
  (set! (-> *player-list* selected-player) (the int (mp-local-player-id)))
  (set! (-> *player-list* open?) #t)
  (none))

(defun close-player-list! ()
  (when (player-list-open?)
    (set! (-> *player-list* open?) #f)
    (set! *lobby-action-player* -1))
  (none))

(defun player-list-limit ()
  (min MP_MAX_PLAYERS (the int (pc-multi-get-session-player-limit))))

(defun move-player-list-selection! ((step int))
  (let ((limit (player-list-limit))
        (player-id (the int (-> *player-list* selected-player))))
    (dotimes (attempt (+ limit -1))
      (set! player-id (mod (+ player-id step limit) limit))
      (when (get-player-name player-id)
        (set! (-> *player-list* selected-player) player-id)
        (return #t))))
  #f)

(defun close-stale-player-actions! ((player-id int))
  (when (and (lobby-player-actions-open?)
             (or (!= *lobby-action-player* player-id) (not (lobby-player-kickable? player-id))))
    (set! *lobby-action-player* -1))
  (none))

(defun steam-player? ((player-id int))
  (let ((connection (pc-multi-get-player-connection-type (the-as uint player-id))))
    (or (= connection (connection-type steam)) (= connection (connection-type friend)))))

(defun player-profile-available? ((player-id int))
  (and (steam-player? (the int (mp-local-player-id))) (steam-player? player-id)))

(defun open-player-profile! ((player-id int))
  (if (and (player-profile-available? player-id) (= (pc-multi-open-player-steam-profile (the-as uint player-id)) 1))
    (sound-play "generic-beep")
    (sound-play "menu-error"))
  (none))

(defun respond-player-list! ()
  (when (not (get-player-name (-> *player-list* selected-player)))
    (set! (-> *player-list* selected-player) (the int (mp-local-player-id))))
  (close-stale-player-actions! (-> *player-list* selected-player))
  (when (nonzero? (logclear (cpad-pressed 0) (pad-buttons square)))
    (set! *lobby-action-player* -1))
  (cond
    ((cpad-pressed? 0 start) (cpad-clear! 0 start) (close-player-list!) (activate-progress *dproc* 'multiplayer-options))
    ((cpad-pressed? 0 square)
     (cpad-clear! 0 square)
     (if (lobby-player-actions-open?) (kick-lobby-action-player!) (open-lobby-player-actions! (-> *player-list* selected-player))))
    ((cpad-pressed? 0 circle) (cpad-clear! 0 circle) (open-player-profile! (-> *player-list* selected-player)))
    ((cpad-pressed? 0 triangle) (cpad-clear! 0 triangle) (close-player-list!))
    ((cpad-pressed? 0 up) (cpad-clear! 0 up) (move-player-list-selection! -1))
    ((cpad-pressed? 0 down) (cpad-clear! 0 down) (move-player-list-selection! 1)))
  (none))

(defun print-player-list-cell ((font-ctx font-context)
                               (text string)
                               (left float)
                               (width float)
                               (right? symbol)
                               (y float))
  (set-width! font-ctx (the int (* 0.66 width)))
  (set-flags! font-ctx (if right? (font-flags kerning right large) (font-flags kerning large)))
  (print-lobby-browser-text font-ctx text (+ left (* (if right? 0.97 0.03) width)) y)
  (none))

(defun draw-player-list-header ((font-ctx font-context) (left float) (width float))
  (set-scale! font-ctx 0.33)
  (set-color! font-ctx (font-color progress-option-off))
  (print-player-list-cell font-ctx
                          (lookup-text! *common-text* (text-id mp-player-list-header-player) #f)
                          left
                          width
                          #f
                          LOBBY_BROWSER_HEADER_Y)
  (print-player-list-cell font-ctx
                          (lookup-text! *common-text* (text-id mp-player-list-header-ping) #f)
                          left
                          width
                          #t
                          LOBBY_BROWSER_HEADER_Y)
  (none))

(defun player-list-name ((player-id int) (font-ctx font-context) (max-width float))
  (let ((player-name (the-as string (get-player-name player-id))))
    (when player-name
      (when (mp-player-record-dead-or-dying? (mp-player-record-by-id (the-as uint player-id)))
        (format player-name (lookup-text! *common-text* (text-id mp-player-list-dead-suffix) #f)))
      (fit-overlay-text player-name font-ctx max-width))))

(defun player-list-ping ((player-id int))
  (let ((ping (pc-multi-get-player-ping (the-as uint player-id))))
    (if (< ping 0)
      "--"
      (begin
        (format (clear *lobby-browser-text*) (lookup-text! *common-text* (text-id mp-player-list-ping-format) #f) ping)
        *lobby-browser-text*))))

(defun draw-player-list-row ((font-ctx font-context) (player-id int) (row int) (left float) (width float))
  (set-scale! font-ctx LOBBY_BROWSER_ROW_SCALE)
  (let* ((icon (connection-type-icon (pc-multi-get-player-connection-type (the-as uint player-id))))
         (icon-width (if icon (-> (get-string-length icon font-ctx) length) 0.0))
         (player-name (player-list-name player-id font-ctx (- (* 0.66 width) icon-width)))
         (y (+ LOBBY_BROWSER_ROW_Y (* LOBBY_BROWSER_ROW_HEIGHT (the float row)))))
    (when player-name
      (when (= player-id (-> *player-list* selected-player))
        (draw-lobby-browser-highlight left width y 1.0))
      (set-color! font-ctx (mp-player-font-color-by-id player-id))
      (when icon
        (print-player-list-cell font-ctx icon left width #f y))
      (print-player-list-cell font-ctx player-name (+ left icon-width) width #f y)
      (print-player-list-cell font-ctx (player-list-ping player-id) left width #t y))
    player-name))

(defun print-player-list-prompt ((font-ctx font-context) (label text-id) (right float))
  (let ((text (lookup-text! *common-text* label #f)))
    (set-flags! font-ctx (font-flags kerning right large))
    (print-lobby-browser-text font-ctx text right PLAYER_LIST_PROMPT_Y)
    (- right (-> (get-string-length text font-ctx) length) LOBBY_BROWSER_PROMPT_GAP)))

(defun draw-player-list-prompts ((font-ctx font-context) (left float) (width float))
  (let ((player-id (the int (-> *player-list* selected-player)))
        (right (+ left (* 0.97 width))))
    (set-scale! font-ctx 0.35)
    (set-color! font-ctx (font-color progress))
    (print-player-list-cell font-ctx
                            (lookup-text! *common-text* (text-id mp-player-list-options-prompt) #f)
                            left
                            width
                            #f
                            PLAYER_LIST_PROMPT_Y)
    (when (player-profile-available? player-id)
      (set! right (print-player-list-prompt font-ctx (text-id mp-player-list-profile) right)))
    (when (lobby-player-kickable? player-id)
      (print-player-list-prompt font-ctx
                                (if (lobby-player-actions-open?) (text-id mp-player-list-confirm-kick) (text-id mp-player-list-kick))
                                right)))
  (none))

(defun unscaled-screen-x ((x float))
  (+ 256.0 (/ (- x 256.0) (-> *video-params* relative-x-scale))))

(defun draw-player-list-background ((left float) (width float))
  (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf)) (bucket-id particles))
    (draw-sprite2d-xy buffer
                      (the int left)
                      (the int LOBBY_BROWSER_TOP)
                      (the int width)
                      (the int (- PLAYER_LIST_PANEL_BOTTOM LOBBY_BROWSER_TOP))
                      (new 'static 'rgba :a #x18)))
  (none))

(defun draw-player-list-scanlines ((left float) (width float))
  (let ((scan-box (new 'stack-no-clear 'hud-box)))
    (set! (-> scan-box min x) (unscaled-screen-x left))
    (set! (-> scan-box max x) (unscaled-screen-x (+ left width)))
    (set! (-> scan-box min y) LOBBY_BROWSER_TOP)
    (set! (-> scan-box max y) PLAYER_LIST_PANEL_BOTTOM)
    (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id progress))
      (draw-scan-and-line scan-box buffer 0.4)))
  (none))

(defun draw-player-list! ()
  (when (nonnull? *display* *video-params* *common-text*)
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 0 0 0.0 (font-color progress) (font-flags kerning large)))
          (left (lobby-browser-left))
          (width (lobby-browser-width)))
      (draw-player-list-background left width)
      (draw-lobby-browser-frame *player-list* font-ctx left width 1.0)
      (draw-lobby-box *player-list* left (+ left width) LOBBY_BROWSER_TOP PLAYER_LIST_PANEL_BOTTOM)
      (draw-lobby-box *player-list* left (+ left width) PLAYER_LIST_PROMPT_DIVIDER_Y PLAYER_LIST_PROMPT_DIVIDER_Y)
      (draw-player-list-header font-ctx left width)
      (let ((row 0))
        (dotimes (player-id (player-list-limit))
          (when (draw-player-list-row font-ctx player-id row left width)
            (+! row 1))))
      (draw-player-list-prompts font-ctx left width)
      (draw-player-list-scanlines left width)))
  (none))

(defun get-nametag-owner-process ((record mp-player-record))
  (unless (nonnull? record)
    (return (the-as process-drawable #f)))
  (let ((replica (mp-player-record-target record)))
    (unless (nonnull? replica)
      (return (the-as process-drawable #f)))
    (if (and (mp-player-daxter? record) (mp-target-ride-along? replica))
      (let ((jak-target (get-attached-jak-proc replica)))
        (when (nonnull? jak-target (-> jak-target sidekick))
          (let ((sidekick-proc (the-as sidekick (ppointer->process (-> jak-target sidekick)))))
            (when (nonnull? sidekick-proc)
              (return (the-as process-drawable sidekick-proc)))))
        (the-as process-drawable #f))
      (the-as process-drawable replica))))

(defun get-player-nametag-anchor! ((position vector) (record mp-player-record))
  (unless (nonnull? position record)
    (return #f))
  (let ((process (get-nametag-owner-process record)))
    (unless (nonnull? process (-> process draw) (-> process node-list))
      (return #f))
    (when (logtest? (-> process draw status) (draw-control-status uninited no-draw no-draw-temp))
      (return #f))
    (let* ((daxter? (mp-player-daxter? record))
           (nodes (-> process node-list))
           (head-index (if daxter? (joint-node-index daxter-lod0-jg head) (joint-node-index jakb-lod0-jg neckB)))
           (shoulder-sidekick? (the-as symbol (and daxter? (type? process sidekick)))))
      (unless (and (>= head-index 0) (< head-index (-> nodes length)) (nonnull? (-> nodes data)))
        (return #f))
      (let ((head (-> nodes data head-index)))
        (unless (nonnull? head (-> head bone))
          (return #f))
        (unless (!= (-> head bone transform trans w) 0.0)
          (return #f))
        (vector<-cspace! position head))
      (+! (-> position y)
          (if daxter?
            (if shoulder-sidekick? PLAYER_NAMETAG_DAXTER_RIDING_CLEARANCE PLAYER_NAMETAG_DAXTER_CLEARANCE)
            PLAYER_NAMETAG_JAK_CLEARANCE))))
  #t)

(defun set-player-nametag-matrix! ((projection matrix) (anchor vector))
  (when (nonnull? projection anchor *math-camera* *font-work* *video-params*)
    (let ((billboard (new 'stack-no-clear 'matrix))
          (glyph-scale (/ PLAYER_NAMETAG_GLYPH_HEIGHT (-> *font-work* size3-large y))))
      (matrix-copy! billboard (-> *math-camera* inv-camera-rot))
      (vector-float*! (-> billboard vector 0) (-> billboard vector 0) (- glyph-scale))
      (vector-float*! (-> billboard vector 1) (-> billboard vector 1) (- glyph-scale))
      (set! (-> billboard vector 0 w) 0.0)
      (set! (-> billboard vector 1 w) 0.0)
      (vector-copy! (-> billboard trans) anchor)
      (matrix*! projection billboard (-> *math-camera* camera-temp))
      (*! (-> projection vector 0 x) (-> *video-params* relative-x-scale-reciprical))))
  (none))

(defun draw-player-nametag! ((record mp-player-record) (buffer dma-buffer))
  (unless (nonnull? record buffer *math-camera* *font-work* *video-params* *nametag-string*)
    (return #f))
  (let ((anchor (new 'stack-no-clear 'vector))
        (clipped-position (new 'stack-no-clear 'vector))
        (projection (new 'stack-no-clear 'matrix)))
    (unless (and (get-player-nametag-anchor! anchor record)
                 (<= (vector-vector-distance (-> *math-camera* trans) anchor) PLAYER_NAMETAG_MAX_DISTANCE)
                 (transform-point-vector! clipped-position anchor))
      (return #f))
    (set-player-nametag-matrix! projection anchor)
    (let* ((player-id (the uint (-> record identity player-id)))
           (context (new 'stack
                         'font-context
                         projection
                         0
                         0
                         0.0
                         (mp-player-font-color-by-id (the int player-id))
                         (font-flags shadow kerning large))))
      (when (nonnull? context)
        (mp-player-copy-name! *nametag-string* player-id)
        (let ((width (-> (get-string-length *nametag-string* context) length)))
          (set! (-> context origin x) (* -0.5 width))
          (set! (-> context origin y) (- (- (-> *font-work* size3-large y)) 40.0))
          (set! (-> context origin z) 0.0)
          (set! (-> context width) (+ width (-> *font-work* size1-large x)))
          (set! (-> context height) (-> *font-work* size3-large y))
          (set! (-> context projection) (-> *math-camera* inv-hmge-scale w))
          (pc-encode-utf8-string *nametag-string* *nametag-string*)
          (draw-string *nametag-string* buffer context)))))
  #t)

(defun requested-hud-nametags-visible? ()
  (when (and *nametags-requested-with-hud?* (nonnull? *target* *hud-engine*))
    (let ((node (-> *hud-engine* alive-list next0)))
      (while (and (nonnull? node) (!= node (-> *hud-engine* alive-list-end)))
        (let ((piece (the-as hud (get-process (the-as connection node)))))
          (when (and (nonnull? piece) (not (logtest? (-> piece flags) (hud-flags show disable))) (not (hidden? piece)))
            (return #t)))
        (set! node (-> node next0)))))
  (set! *nametags-requested-with-hud?* #f)
  #f)

(defun player-nametags-visible? ()
  (let ((context-visible? (or (requested-hud-nametags-visible?) (player-list-open?))))
    (if (nonnull? *multiplayer-preferences*)
      (case (-> *multiplayer-preferences* nametag-visibility)
        (((player-nametag-visibility always)) #t)
        (((player-nametag-visibility hold)) context-visible?)
        (else #f))
      context-visible?)))

(defun draw-player-nametags! ()
  (when (and (mp-session-in-game?)
             (player-nametags-visible?)
             (nonnull? *display*
                       *math-camera*
                       *font-work*
                       *video-params*
                       *nametag-string*
                       (-> *display* frames (-> *display* on-screen) global-buf)))
    (with-dma-buffer-add-bucket ((buffer (-> *display* frames (-> *display* on-screen) global-buf))
                                 (bucket-id subtitle))
      (dma-buffer-add-gs-set buffer
                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x130 :psm (gs-psm ct24) :zmsk #x1))
                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest always))))
      (dotimes (i MP_MAX_PLAYERS)
        (let ((record (mp-player-record-by-id (the uint i))))
          (when (and (nonnull? record) (is-record-remote-player? record))
            (draw-player-nametag! record buffer))))
      (dma-buffer-add-gs-set buffer
                             (zbuf-1 (new 'static 'gs-zbuf :zbp #x130 :psm (gs-psm ct24)))
                             (test-1 (new 'static 'gs-test :zte #x1 :ztst (gs-ztest greater-equal))))))
  (none))

(defun player-list-toggle-pressed? ()
  (and (nonnull? *cpad-list*) (cpad-pressed? 0 select) (not (cpad-hold? 0 l3))))

(defun consume-player-list-buttons! ()
  (when (nonnull? *cpad-list* *cpad-history-list*)
    (let ((pad (-> *cpad-list* cpads 0))
          (history (-> *cpad-history-list* cpads 0))
          (buttons (pad-buttons x circle triangle square confirm)))
      (when (nonnull? pad history)
        (logclear! (-> pad button0) buttons)
        (dotimes (index 3)
          (logclear! (-> pad button0-abs index) buttons)
          (logclear! (-> pad button0-rel index) buttons))
        (dotimes (index 15)
          (logclear! (-> history button0-abs index) buttons)
          (logclear! (-> history button0-rel index) buttons))
        (dotimes (index 4)
          (set! (-> pad abutton (+ (abutton-idx triangle) index)) (the-as uint 0))))))
  (none))

(defun update-player-list-input! ()
  (when (nonnull? *player-list* *cpad-list* (-> *cpad-list* cpads 0))
    (let ((was-open? (player-list-open?)))
      (cond
        ((not (player-list-allowed?)) (set! *nametags-requested-with-hud?* #f) (close-player-list!))
        ((player-list-toggle-pressed?) (cpad-clear! 0 select) (if was-open? (close-player-list!) (open-player-list!)))
        (was-open? (respond-player-list!)))
      (when (and (player-list-allowed?)
                 (or (cpad-hold? 0 l3) (logtest? (-> *cpad-list* cpads 0 button0-abs 1) (pad-buttons l3))))
        (set! *nametags-requested-with-hud?* #t))
      (when (or was-open? (player-list-open?))
        (consume-player-list-buttons!))))
  (none))
