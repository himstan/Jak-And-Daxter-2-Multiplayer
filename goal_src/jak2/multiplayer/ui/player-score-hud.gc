;;-*-Lisp-*-
(in-package goal)

(defun player-score-hud-place! ((hud player-score-hud) (player-slot int) (x int) (y int))
  (set-hud-piece-position! (-> hud sprites player-slot) x y)
  (set! (-> hud sprites player-slot scale-x) 1.5)
  (set! (-> hud strings player-slot color) (mp-player-font-color-by-slot player-slot))
  (format (clear (-> hud strings player-slot text)) "~D" (-> hud values player-slot current))
  (set-as-offset-from! (the-as hud-sprite (-> hud strings player-slot pos))
                       (the-as vector4w (-> hud sprites player-slot))
                       -12
                       8)
  (none))

(defun player-score-hud-hide! ((hud player-score-hud) (player-slot int))
  (set! (-> hud sprites player-slot scale-x) 0.0)
  (set! (-> hud strings player-slot pos 0) 0)
  (none))

(defmethod draw ((this player-score-hud))
  (let ((remote-y 140))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (cond
        ((< (-> this values player-slot target) 0) (player-score-hud-hide! this player-slot))
        ((= player-slot (mp-local-player-slot)) (player-score-hud-place! this player-slot 115 90))
        (else
         (player-score-hud-place! this player-slot 480 remote-y)
         (+! remote-y 30)))))
  (call-parent-method this)
  (none))

(defmethod update-values ((this player-score-hud))
  (dotimes (player-slot MP_MAX_PLAYERS)
    (set! (-> this values player-slot target)
          (if (nonnull? (mp-player-record-by-slot (the uint player-slot)))
            ((-> this score-of) (the uint player-slot))
            -1)))
  (call-parent-method this)
  (none))

(defmethod init-callback ((this player-score-hud))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-center-right) (gui-action hidden) (-> this name) 81920.0 0))
  (logior! (-> this flags) (hud-flags show))
  (dotimes (player-slot MP_MAX_PLAYERS)
    (set! (-> this sprites player-slot tex) (get-texture hud-scoreboard-01 level-default-minimap))
    (set! (-> this sprites player-slot flags) (the-as uint 4))
    (alloc-string-if-needed this player-slot)
    (set! (-> this strings player-slot scale) 0.5)
    (set! (-> this strings player-slot flags) (font-flags kerning right large)))
  (none))

(defun draw-waiting-text! ((text text-id))
  (let ((ctx (new 'stack 'font-context *font-default-matrix* 32 280 0.0 (font-color default) (font-flags shadow kerning large))))
    (set-width! ctx 520)
    (set-height! ctx 80)
    (set-scale! ctx 0.5)
    (print-game-text (lookup-text! *common-text* text #f) ctx #f 44 (bucket-id progress)))
  (none))

(defbehavior player-score-hud-init player-score-hud ((score-of (function uint int)))
  (set! (-> self score-of) score-of)
  (hud-init-by-other))
