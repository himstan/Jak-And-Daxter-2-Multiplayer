;;-*-Lisp-*-
(in-package goal)

;; name: mp-airlock-sync.gc
;; name in dgo: mp-airlock-sync
;; dgos: GAME

(defun mp-airlock-ready? ()
  (and *mp-airlock-buffer*
       (nonzero? (the-as uint *mp-airlock-buffer*))
       *mp-local-airlock-state*
       (nonzero? (the-as uint *mp-local-airlock-state*))
       *mp-remote-airlock-state*
       (nonzero? (the-as uint *mp-remote-airlock-state*))
       )
  )

(defun mp-airlock-state-active? ((slot mp-airlock-state))
  (and slot
       (nonzero? (the-as uint slot))
       (nonzero? (-> slot airlock-aid))
       (!= (-> slot state-id) (the-as uint32 (mp-airlock-state-id none)))
       )
  )

(defun mp-airlock-copy-state! ((dst mp-airlock-state) (src mp-airlock-state))
  (when (and dst (nonzero? (the-as uint dst)) src (nonzero? (the-as uint src)))
    (set! (-> dst airlock-aid) (-> src airlock-aid))
    (set! (-> dst state-id) (-> src state-id))
    (set! (-> dst level-id) (-> src level-id))
    (set! (-> dst sequence) (-> src sequence))
    (set! (-> dst last-updated) (-> src last-updated))
    )
  (none)
  )

(defun mp-airlock-clear-state! ((slot mp-airlock-state))
  (when (and slot (nonzero? (the-as uint slot)))
    (set! (-> slot airlock-aid) (the uint32 0))
    (set! (-> slot state-id) (the-as uint32 (mp-airlock-state-id none)))
    (set! (-> slot level-id) (the uint32 0))
    (set! (-> slot sequence) (the uint32 0))
    (set! (-> slot last-updated) (the uint32 0))
    )
  (none)
  )

(defun mp-airlock-table-active-count ((table mp-airlock-state-table))
  (let ((active-count (the uint32 0)))
    (when (and table (nonzero? (the-as uint table)))
      (dotimes (i MP_AIRLOCK_STATE_COUNT)
        (when (mp-airlock-state-active? (-> table states i))
          (+! active-count 1)
          )
        )
      )
    active-count
    )
  )

(defun mp-airlock-refresh-count! ((table mp-airlock-state-table))
  (let ((active-count (mp-airlock-table-active-count table)))
    (when (and table (nonzero? (the-as uint table)))
      (set! (-> table count) active-count)
      )
    active-count
    )
  )

(defun mp-airlock-copy-table! ((dst mp-airlock-state-table) (src mp-airlock-state-table))
  (when (and dst (nonzero? (the-as uint dst)) src (nonzero? (the-as uint src)))
    (set! (-> dst count)
          (if (< (-> src count) MP_AIRLOCK_STATE_COUNT)
              (-> src count)
              MP_AIRLOCK_STATE_COUNT
              )
          )
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (mp-airlock-copy-state! (-> dst states i) (-> src states i))
      )
    )
  (none)
  )

(defun mp-airlock-find-state ((table mp-airlock-state-table) (airlock-aid uint))
  (when (and table (nonzero? (the-as uint table)) (nonzero? airlock-aid))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (let ((slot (-> table states i)))
        (when (and (mp-airlock-state-active? slot) (= (-> slot airlock-aid) airlock-aid))
          (return slot)
          )
        )
      )
    )
  (the-as mp-airlock-state #f)
  )

(defun mp-airlock-find-empty-state ((table mp-airlock-state-table))
  (when (and table (nonzero? (the-as uint table)))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (let ((slot (-> table states i)))
        (when (not (mp-airlock-state-active? slot))
          (return slot)
          )
        )
      )
    )
  (the-as mp-airlock-state #f)
  )

(defun mp-airlock-clear-table! ((table mp-airlock-state-table))
  (when (and table (nonzero? (the-as uint table)))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (mp-airlock-clear-state! (-> table states i))
      )
    (set! (-> table count) (the uint32 0))
    )
  (none)
  )

(defun mp-airlock-clear-table-aid! ((table mp-airlock-state-table) (airlock-aid uint))
  (when (and table (nonzero? (the-as uint table)) (nonzero? airlock-aid))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (let ((slot (-> table states i)))
        (when (and (mp-airlock-state-active? slot) (= (-> slot airlock-aid) airlock-aid))
          (mp-airlock-clear-state! slot)
          )
        )
      )
    (mp-airlock-refresh-count! table)
    )
  (none)
  )

(defun mp-airlock-table-has-state-id? ((table mp-airlock-state-table) (expected-state-id mp-airlock-state-id))
  (when (and table (nonzero? (the-as uint table)))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (let ((slot (-> table states i)))
        (when (and (mp-airlock-state-active? slot) (= (-> slot state-id) (the-as uint32 expected-state-id)))
          (return #t)
          )
        )
      )
    )
  #f
  )

(defun mp-airlock-loaded-by-aid? ((airlock-aid uint))
  (when (nonzero? airlock-aid)
    (let ((ent (entity-by-aid airlock-aid)))
      (when (and ent
                 (nonzero? ent)
                 (-> ent extra process)
                 (nonzero? (-> ent extra process))
                 (type? (-> ent extra process) com-airlock))
        (return #t)
        )
      )
    )
  #f
  )

(defun mp-airlock-clear-unloaded-local-states! ()
  (when (mp-airlock-ready?)
    (let ((cleared? #f))
      (dotimes (i MP_AIRLOCK_STATE_COUNT)
        (let ((slot (-> *mp-local-airlock-state* states i)))
          (when (and (mp-airlock-state-active? slot)
                     (not (mp-airlock-loaded-by-aid? (-> slot airlock-aid))))
            (mp-airlock-clear-state! slot)
            (set! cleared? #t)
            )
          )
        )
      (when cleared?
        (mp-airlock-refresh-count! *mp-local-airlock-state*)
        )
      (return cleared?)
      )
    )
  #f
  )

(defun mp-airlock-write-state! ((slot mp-airlock-state) (airlock-aid uint) (state-id mp-airlock-state-id))
  (when (and slot (nonzero? (the-as uint slot)) (nonzero? airlock-aid))
    (set! (-> slot airlock-aid) (the-as uint32 airlock-aid))
    (set! (-> slot state-id) (the-as uint32 state-id))
    (set! (-> slot level-id) (mp-current-level-packed-id))
    )
  (none)
  )

(defun mp-airlock-upsert-table-state! ((table mp-airlock-state-table)
                                       (airlock-aid uint)
                                       (state-id mp-airlock-state-id))
  (when (and table (nonzero? (the-as uint table)) (nonzero? airlock-aid))
    (let ((slot (mp-airlock-find-state table airlock-aid)))
      (when (not slot)
        (set! slot (mp-airlock-find-empty-state table))
        )
      (when (not slot)
        (set! slot (-> table states 0))
        (format 0 "[MP-Airlock] WARNING: airlock state table overflow, replacing slot 0 with aid=~D.~%" airlock-aid)
        )
      (mp-airlock-write-state! slot airlock-aid state-id)
      (mp-airlock-refresh-count! table)
      )
    )
  (none)
  )

(defun mp-airlock-next-sequence! ()
  (+! *mp-airlock-local-sequence* 1)
  (when (zero? *mp-airlock-local-sequence*)
    (+! *mp-airlock-local-sequence* 1)
    )
  *mp-airlock-local-sequence*
  )

(defun mp-airlock-stamp-local-state! ((force? symbol))
  (when (mp-airlock-ready?)
    (let ((level-id (mp-current-level-packed-id))
          (stamp-time (the-as uint32 (pc-multi-get-ticks)))
          )
      (mp-airlock-refresh-count! *mp-local-airlock-state*)
      (when (or force?
                (and (nonzero? (-> *mp-local-airlock-state* count))
                     (!= level-id *mp-airlock-last-local-level-id*)))
        (set! *mp-airlock-local-sequence* (mp-airlock-next-sequence!))
        (dotimes (i MP_AIRLOCK_STATE_COUNT)
          (let ((slot (-> *mp-local-airlock-state* states i)))
            (when (mp-airlock-state-active? slot)
              (set! (-> slot level-id) level-id)
              (set! (-> slot sequence) (the-as uint32 *mp-airlock-local-sequence*))
              (set! (-> slot last-updated) stamp-time)
              )
            )
          )
        (set! *mp-airlock-last-local-level-id* level-id)
        )
      )
    )
  (none)
  )

(defun mp-airlock-clear-local-state! ()
  (when (mp-airlock-ready?)
    (mp-airlock-clear-table! *mp-local-airlock-state*)
    (mp-airlock-stamp-local-state! #t)
    )
  (none)
  )

(defun mp-airlock-set-local-state! ((airlock-aid uint) (state-id mp-airlock-state-id))
  (when (mp-airlock-ready?)
    (if (= state-id (mp-airlock-state-id none))
        (if (zero? airlock-aid)
            (begin
              (mp-airlock-clear-table! *mp-local-airlock-state*)
              )
            (begin
              (mp-airlock-clear-table-aid! *mp-local-airlock-state* airlock-aid)
              )
            )
        (mp-airlock-upsert-table-state! *mp-local-airlock-state* airlock-aid state-id)
        )
    (mp-airlock-stamp-local-state! #t)
    )
  (none)
  )

(defun mp-airlock-get-first-state-id ((table mp-airlock-state-table))
  (when (and table (nonzero? (the-as uint table)))
    (dotimes (i MP_AIRLOCK_STATE_COUNT)
      (let ((slot (-> table states i)))
        (when (mp-airlock-state-active? slot)
          (return (the-as mp-airlock-state-id (-> slot state-id)))
          )
        )
      )
    )
  (mp-airlock-state-id none)
  )

(defun mp-airlock-get-local-state-id ()
  (mp-airlock-get-first-state-id *mp-local-airlock-state*)
  )

(defun mp-airlock-get-remote-state-id ()
  (mp-airlock-get-first-state-id *mp-remote-airlock-state*)
  )

(defun mp-is-local-state-id? ((airlock-aid uint) (expected-state-id mp-airlock-state-id))
  (let ((slot (mp-airlock-find-state *mp-local-airlock-state* airlock-aid)))
    (if (and slot (= (-> slot state-id) (the-as uint32 expected-state-id)))
        #t
        #f
        )
    )
  )

(defun mp-is-remote-state-id? ((airlock-aid uint) (expected-state-id mp-airlock-state-id))
  (let ((slot (mp-airlock-find-state *mp-remote-airlock-state* airlock-aid)))
    (if (and slot (= (-> slot state-id) (the-as uint32 expected-state-id)))
        #t
        #f
        )
    )
  )

(defun mp-airlock-sync-tick ()
  (when (mp-airlock-ready?)
    (let ((cleared-unloaded? (mp-airlock-clear-unloaded-local-states!)))
      (mp-airlock-stamp-local-state! cleared-unloaded?)
      )
    (mp-airlock-copy-table! (-> *mp-airlock-buffer* local-table) *mp-local-airlock-state*)
    (set! (-> *mp-airlock-buffer* sequence) (the-as uint32 *mp-airlock-local-sequence*))
    (pc-multi-send-airlock-state (the-as uint *mp-airlock-buffer*))
    (pc-multi-receive-airlock-state (the-as uint *mp-airlock-buffer*))
    (mp-airlock-copy-table! *mp-remote-airlock-state* (-> *mp-airlock-buffer* remote-table))
    )
  (none)
  )
