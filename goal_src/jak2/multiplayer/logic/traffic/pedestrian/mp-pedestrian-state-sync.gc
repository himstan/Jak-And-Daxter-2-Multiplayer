;;-*-Lisp-*-
(in-package goal)

;; Pedestrian ghost-driven state/prediction helpers shared by the citizen
;; common-post hijack and the external sync pass.

(defun mp-pedestrian-terminal-state? ((target-sym symbol))
  (or (= target-sym 'knocked)
      (= target-sym 'knocked-off-vehicle)
      (= target-sym 'die)
      (= target-sym 'die-falling)
      (= target-sym 'die-fast))
  )

(defun mp-pedestrian-riding-vehicle? ((ped citizen))
  "True once the citizen is really present in its vehicle's rider array."
  (when (and ped
             (nonzero? ped)
             (type? ped civilian))
    (let ((veh (the-as vehicle (handle->process-safe (-> (the-as civilian ped) vehicle)))))
      (when (and veh
                 (nonzero? veh)
                 (-> veh info)
                 (nonzero? (-> veh info)))
        (dotimes (seat-idx (-> veh info seat-count))
          (when (= (get-rider-in-seat veh seat-idx) ped)
            (return #t)
            )
          )
        )
      )
    )
  #f
  )

(defun mp-ped-predictive-move ((ped citizen))
  "Smoothly nudge a citizen's velocity and position toward the authoritative ghost position."
  (when (and ped
             (nonzero? ped)
             (not (mp-pedestrian-riding-vehicle? ped)))
    (let ((net-id (-> ped net-id)))
      (when (and (nonzero? net-id)
                 (-> ped root)
                 (nonzero? (-> ped root)))
        (let ((rec (mp-get-traffic-ghost net-id)))
          (when (and rec
                     (nonzero? rec)
                     (not (should-pause-sync? ped rec)))
            (let ((predicted-trans (new 'stack-no-clear 'vector))
                  (ghost-state (mp-ped-get-state-from-id (the uint (-> rec ghost-state-id)))))
              (mp-actor-traffic-predicted-trans! rec predicted-trans)
              (mp-actor-apply-ghost-correction!
                (-> ped root trans)
                (-> ped root transv)
                (-> ped root quat)
                predicted-trans
                (-> rec ghost-quat)
                0.85
                0.35
                (mp-pedestrian-terminal-state? ghost-state))
              )
            )
          )
        )
      )
    )
  (none)
  )

