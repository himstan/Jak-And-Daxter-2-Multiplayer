;;-*-Lisp-*-
(in-package goal)

;; --- Damage & Death Broadcasting ---

(define *old-citizen-common-post* (the-as (function citizen none) #f))
(define *old-citizen-event-handler* (the-as (function citizen process int symbol event-message-block object) #f))
;; Track whether cwi.gd subtypes have been patched yet (they load after game.gd).
(define *mp-citizen-subtypes-patched* #f)

(defun mp-pedestrian-death-started? ((e-proc citizen))
  "Has the replicated or local death path already started?"
  (and e-proc
       (nonzero? e-proc)
       (or 
       (mp-pedestrian-terminal-state? (-> e-proc state name))
       (logtest? (-> e-proc enemy-flags) (enemy-flag mp-synced-death death-start))))
  )

(defun mp-pedestrian-apply-remote-attack! ((evt mp-actor-attack-event))
  "Apply a client-requested pedestrian hit on the traffic authority."
  (let ((e-proc (mp-pedestrian-find-by-net-id (-> evt net-id))))
    (when (and e-proc (nonzero? e-proc))
      (let ((rec (mp-get-traffic-ghost (-> evt net-id))))
        (when (and rec
                   (nonzero? (-> evt attack-id))
                   (= (-> evt attack-id) (-> rec last-attack-id)))
          (format 0 "[MP-Traffic] Blocking duplicate remote attack ID ~D on nid=~D~%" (-> evt attack-id) (-> evt net-id))
          (return #f)
          )
        (let ((attacker (mp-get-remote-target-process)))
          (when (not (mp-actor-apply-authoritative-remote-damage! (the-as enemy e-proc) attacker evt 'pedestrian))
            (return #f)
            )
          (when (and rec
                     (nonzero? (-> evt attack-id)))
            (set! (-> rec last-attack-id) (-> evt attack-id))
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-get-death-hint ((e-proc citizen))
  "Capture the visual death path before cleanup mutates citizen state."
  (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f)))
    (cond
      ((= cur-state 'die-fast)
       (mp-enemy-death-hint die-fast)
       )
      ((or (= cur-state 'die-falling)
           (= cur-state 'knocked)
           (= cur-state 'knocked-off-vehicle)
           (!= (-> e-proc incoming knocked-type) (knocked-type knocked-type-0)))
       (mp-enemy-death-hint die-falling)
       )
      (else
       (mp-enemy-death-hint die)
       )
      )
    )
  )

;; --- Hijacks ---

(defun mp-citizen-event-handler-hijack ((this citizen) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "Handles traffic-off events for puppet peds. No state forcing — the vanilla AI owns
   the state machine. Forcing transitions externally bypasses the setup that active's
   :trans does (decelerate, set wait-return-state) and causes enter-state to immediately
   call wait's :trans with wait-return-state == 0, crashing with pp->next-state == 0."
  (case arg2
    (('event-death)
     (when (zero? (-> this hit-points))
         (do-effect (-> this skel effect) 'death-default 0.0 -1)
         )
     )
    (('attack)
     (when (= (mp-actor-handle-attack-hijack 'pedestrian (the-as enemy this) arg0 arg3) 'block)
       (return #f)
       )
     )
    (('traffic-off 'traffic-off-force)
     ;; GRACEFUL CLEANUP: Don't immediately deactivate if we are in the middle of dying.
     ;; This allows the death animation to finish playing before the process is killed.
     (when (not (mp-pedestrian-death-started? this))
       (format 0 "[MP-Traffic-Hijacks] Cleaning up ~A nid=~D pid=~D inactive=~A status=~A because it was dead/inactive~%" (-> this name) (-> this net-id) (-> this pid) (focus-test? this inactive) (-> this status))
       (set! (-> this net-id) (the uint 0))
       (deactivate this)
       )
     (return #t)
     )
  )

  ;; Fallback to vanilla handler
  (if *old-citizen-event-handler*
      (*old-citizen-event-handler* this arg0 arg1 arg2 arg3)
      #f
      )
  )

(defun mp-pedestrian-state-current-or-pending? ((this citizen) (target-sym symbol))
  (or (and (-> this state) (= (-> this state name) target-sym))
      (and (-> this next-state) (= (-> this next-state name) target-sym)))
  )

(defun mp-pedestrian-state-retry-ready? ((rec mp-traffic-ghost-record))
  (mp-actor-state-retry-ready? (-> rec last-state-bump-time))
  )

(defun mp-pedestrian-puppet-locked? ((this citizen))
  "True when this pedestrian is a non-authoritative ghost-driven puppet."
  (and (not (mp-is-traffic-authoritative?))
       (nonzero? (-> this net-id))
       (mp-get-traffic-ghost (-> this net-id)))
  )

(defun mp-pedestrian-authorize-remote-trans! ((rec mp-traffic-ghost-record) (target-state-id uint))
  "Mark the next state entry as coming from the ghost controller, not local AI."
  (set! (-> rec authorized-trans-state-id) (the-as uint32 target-state-id))
  (set! (-> rec authorized-trans-frame) (current-time))
  (none)
  )

(defun mp-pedestrian-lock-local-state-manager! ((this citizen) (rec mp-traffic-ghost-record))
  "Disable local transition ticks for puppet pedestrians after ghost sync."
  (when (and rec (mp-pedestrian-puppet-locked? this))
    (set! (-> this trans-hook) #f)
    )
  (none)
  )

(defun mp-pedestrian-prepare-wait-state! ((this citizen))
  "Mirror active's setup before entering wait from remote state sync."
  (let ((active-st (method-state (-> this type) (the-as basic 'active))))
    (when (and active-st (nonzero? active-st))
      (set! (-> this wait-return-state) (the-as (state citizen) active-st))
      (set! (-> this wait-time) (the-as time-frame (rnd-int-range this 300 1500)))
      )
    )
  (none)
  )

(defun mp-pedestrian-enter-remote-state! ((this citizen) (rec mp-traffic-ghost-record) (target-state-id uint) (target-sym symbol))
  "Enter a replicated pedestrian state once per authoritative state-id edge."
  (let ((st (method-state (-> this type) (the-as basic target-sym))))
    (when (and st (nonzero? st))
      (when (= target-sym 'wait)
        (mp-pedestrian-prepare-wait-state! this)
        )
      (mp-pedestrian-authorize-remote-trans! rec target-state-id)
      (set! (-> this next-state) (the-as state st))
      (enter-state (the-as object st) (the-as object #f) (the-as object #f) (the-as object #f) (the-as object #f) (the-as object #f))
      (mp-pedestrian-lock-local-state-manager! this rec)
      (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
      (set! (-> rec last-state-bump-time) (current-time))
      )
    )
  (none)
  )

(defun mp-pedestrian-schedule-remote-state! ((this citizen) (rec mp-traffic-ghost-record) (target-state-id uint) (target-sym symbol))
  "Queue remote state entry on the citizen's own main thread.
   This is the stack-safe path for vehicle/passenger fallback sync."
  (when (and this
             (nonzero? this)
             rec
             (-> this main-thread)
             (nonzero? (-> this main-thread)))
    (let ((st (method-state (-> this type) (the-as basic target-sym))))
      (when (and st (nonzero? st))
        (when (= target-sym 'wait)
          (mp-pedestrian-prepare-wait-state! this)
          )
        (mp-pedestrian-authorize-remote-trans! rec target-state-id)
        (set! (-> this next-state) (the-as state st))
        (process-mask-clear! (-> this mask) sleep sleep-code)
        (set-to-run (-> this main-thread)
                    enter-state
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f))
        (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
        (set! (-> rec last-state-bump-time) (current-time))
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-sync-remote-state! ((this citizen) (rec mp-traffic-ghost-record))
  "Edge-trigger remote state entry so locomotion anims start once, then keep looping."
  (let ((target-state-id (the uint (-> rec ghost-state-id))))
    (when (nonzero? target-state-id)
      (let ((target-sym (mp-ped-get-state-from-id target-state-id)))
        (when (and target-sym
                   (or (not (mp-pedestrian-death-started? this))
                       (mp-pedestrian-terminal-state? target-sym))
                   (not (is-in-pausable-state? target-sym)))
          (if (mp-pedestrian-state-current-or-pending? this target-sym)
              (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
              (when (or (!= (the-as uint32 target-state-id) (-> rec last-applied-state-id))
                        (mp-pedestrian-state-retry-ready? rec))
                (mp-pedestrian-enter-remote-state! this rec target-state-id target-sym)
                )
              )
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-sync-remote-state-deferred! ((this citizen) (rec mp-traffic-ghost-record))
  "Vehicle/passenger fallback: schedule state entry on the citizen's main thread."
  (let ((target-state-id (the uint (-> rec ghost-state-id))))
    (when (nonzero? target-state-id)
      (let ((target-sym (mp-ped-get-state-from-id target-state-id)))
        (when (and target-sym
                   (or (not (mp-pedestrian-death-started? this))
                       (mp-pedestrian-terminal-state? target-sym)))
          (if (mp-pedestrian-state-current-or-pending? this target-sym)
              (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
              (when (or (!= (the-as uint32 target-state-id) (-> rec last-applied-state-id))
                        (mp-pedestrian-state-retry-ready? rec))
                (mp-pedestrian-schedule-remote-state! this rec target-state-id target-sym)
                )
              )
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-ghost-focus-proc ((rec mp-traffic-ghost-record))
  "Resolve a synced pedestrian target role to the local process that represents it."
  (when (nonzero? (-> rec ghost-target-aid))
    (let ((target-role (the-as uint8 (+ -1 (-> rec ghost-target-aid)))))
      (if (= target-role (-> *local-info* role))
          (return (the-as process-focusable *target*))
          (return (the-as process-focusable (mp-get-remote-target-process)))
          )
      )
    )
  (the-as process-focusable #f)
  )

(defun mp-pedestrian-sync-guard-target! ((this citizen) (rec mp-traffic-ghost-record))
  "Mirror authoritative crimson-guard targeting before local AI chooses a target."
  (when (and *mp-set-guard-target* (nonzero? (-> rec ghost-target-aid)))
    (let ((focus-proc (mp-pedestrian-ghost-focus-proc rec)))
      (when (mp-guard-target-debug-ready? (-> rec net-id))
        (let ((focus-handle (the-as handle #f)))
          (if (and (-> this focus) (nonzero? (-> this focus)))
              (set! focus-handle (-> this focus handle))
              )
          (format 0
                  "[MP-GuardTarget] nid=~D phase=set state=pre aid=~D focus=~S focus-type=~S "
                  (-> rec net-id)
                  (-> rec ghost-target-aid)
                  (mp-guard-target-debug-handle-label focus-handle)
                  (mp-guard-target-debug-handle-type focus-handle)
                  )
          (let ((target-handle (if *mp-get-guard-target*
                                  (*mp-get-guard-target* this)
                                  (if (and (-> this focus) (nonzero? (-> this focus)))
                                      (-> this focus handle)
                                      (the-as handle #f))
                                  )))
            (format 0
                    "traffic=~S traffic-type=~S resolved=~S resolved-type=~S lock=0~%"
                    (mp-guard-target-debug-handle-label target-handle)
                    (mp-guard-target-debug-handle-type target-handle)
                  (mp-guard-target-debug-process-label focus-proc)
                  (mp-guard-target-debug-process-type focus-proc)
                  )
            )
          )
        )
      (when (and focus-proc (nonzero? focus-proc))
        (*mp-set-guard-target* this (process->handle focus-proc))
        (when (mp-guard-target-debug-ready? (-> rec net-id))
          (let ((focus-handle (the-as handle #f)))
            (if (and (-> this focus) (nonzero? (-> this focus)))
                (set! focus-handle (-> this focus handle))
                )
            (format 0
                    "[MP-GuardTarget] nid=~D phase=set state=post aid=~D focus=~S focus-type=~S "
                    (-> rec net-id)
                    (-> rec ghost-target-aid)
                    (mp-guard-target-debug-handle-label focus-handle)
                    (mp-guard-target-debug-handle-type focus-handle)
                    )
            (let ((target-handle (if *mp-get-guard-target*
                                    (*mp-get-guard-target* this)
                                    (if (and (-> this focus) (nonzero? (-> this focus)))
                                        (-> this focus handle)
                                        (the-as handle #f))
                                    )))
              (format 0
                      "traffic=~S traffic-type=~S lock=1~%"
                      (mp-guard-target-debug-handle-label target-handle)
                      (mp-guard-target-debug-handle-type target-handle)
                    )
              )
            )
          (mp-guard-target-debug-bump!)
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-run-puppet-sync! ((this citizen) (rec mp-traffic-ghost-record))
  "Apply authoritative ghost state to a puppet citizen after vanilla post-processing."
  (when (and this
             (nonzero? this)
             rec)
    ;; 1. HP Sync (Puppet side)
    (let ((old-hp (the int32 (-> this hit-points)))
          (new-hp (-> rec ghost-hp)))

      ;; Sync HP normally if not dead yet
      (when (and (> new-hp 0) (not (mp-pedestrian-death-started? this)))
        (when (!= old-hp new-hp)
          (set! (-> this hit-points) new-hp)
          )
        )
      )

    (when (and (nonzero? (-> this net-id))
               (not (mp-pedestrian-death-started? this)))
      (when (not (should-pause-sync? this rec))
          ;; 2. State Sync
          (mp-pedestrian-sync-remote-state! this rec)
    
          ;; 3. Keep the target pinned after vanilla logic as well.
          (mp-pedestrian-sync-guard-target! this rec)
          (mp-pedestrian-lock-local-state-manager! this rec)
        )
      ;; 4. Position correction: applied last so it overrides the nav/AI result.
      (mp-ped-predictive-move this)
      )
    )
  (none)
  )

(defun mp-pedestrian-external-sync-needed? ()
  "Use the multiplayer-owned fallback only while the local player is riding in a vehicle."
  (and *target*
       (nonzero? *target*)
       (focus-test? *target* pilot)
       (-> *target* pilot)
       (nonzero? (-> *target* pilot)))
  )

(defun mp-pedestrian-run-external-post-sync! ((this citizen))
  "Lightweight fallback when vanilla civilian ticks stall in vehicles.
   Keep this limited to multiplayer-owned ghost sync work; do not invoke vanilla
   common-post from the multiplayer tick context."
  (when (and this
             (nonzero? this)
             (not (type? this crimson-guard))
             (not (focus-test? this inactive))
             (not (logtest? (-> this mask) (process-mask sleep)))
             (!= (-> this status) 'dead)
             (nonzero? (-> this net-id))
             (nonzero? (-> this controller branch)))
    (let ((rec (mp-get-traffic-ghost (-> this net-id))))
      (when (and rec (-> this root) (nonzero? (-> this root)))
        ;; Queue state bumps on the citizen's own main thread so ambient civilians
        ;; can keep following authoritative active/wait edges even while the local
        ;; player is riding in a vehicle.
        (when (not (should-pause-sync? this rec))
            (mp-pedestrian-sync-remote-state-deferred! this rec)
          )
        (mp-ped-predictive-move this)
        (when (type? (-> this root) collide-shape)
          (update-transforms (-> this root))
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-run-external-sync-pass ()
  "Fallback civilian sync pass for vehicle/passenger contexts where ambient common-post stops ticking."
  (when (and (not (mp-is-traffic-authoritative?))
             (mp-pedestrian-external-sync-needed?))
    (dotimes (i (the int MP_MAX_SYNC_PEDESTRIANS))
      (let ((slot (-> *mp-traffic-buffer* ped-enemies i)))
        (when (nonzero? (-> slot net-id))
          (let ((proc (mp-pedestrian-find-by-net-id (-> slot net-id))))
            (when (and proc (nonzero? proc))
              (mp-pedestrian-run-external-post-sync! proc)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-citizen-common-post-hijack ((this citizen))
  "Run original citizen common-post first, then state sync and position correction.
   Both run here (not via send-event) because pp == this == *current-process* in
   common-post context, making enter-state safe. send-event context is unreliable
   for enter-state since pp may differ from the target citizen."
  (when (and (not (mp-is-traffic-authoritative?))
             (nonzero? (-> this net-id)))
    (let ((rec (mp-get-traffic-ghost (-> this net-id))))
      (when rec
        (when (not (should-pause-sync? this rec))
          (mp-pedestrian-sync-guard-target! this rec)
          (mp-pedestrian-lock-local-state-manager! this rec)
          )
        ;; Predict before vanilla logic so local AI/nav starts from a fresher pose.
        (mp-ped-predictive-move this)
        )
      )
    )
  (if *old-citizen-common-post*
      (*old-citizen-common-post* this)
      )
  (when (and (not (mp-is-traffic-authoritative?))
             (nonzero? (-> this net-id)))
    ;; State sync: read desired state from ghost record, transition if desynced.
    (let ((rec (mp-get-traffic-ghost (-> this net-id))))
      (when (and rec (not (should-pause-sync? this rec)))
        (mp-pedestrian-run-puppet-sync! this rec)
        )
      )
    )
  (none)
  )

;; --- Hijack Application ---

(defun mp-apply-traffic-hijacks ()
  "Apply citizen hijacks for ghost correction and state syncing.
   Must patch citizen + all civilian subtypes individually — defmethod on a parent
   does not retroactively update slots already copied by cwi.gd subtypes.
   Uses method-set! with compile-time indices for forward-declared cwi.gd types.
   Safe to call multiple times: citizen is patched once on connect; subtypes are
   patched lazily once cwi.gd has loaded (their GOAL symbol table entries become
   non-zero after deftype runs in that DGO)."
  (let ((cpost-id (method-id-of-type citizen common-post))
        (evhnd-id (method-id-of-type citizen general-event-handler)))

    ;; --- Phase 1: patch citizen (always available, in game.gd) ---
    ;; Use method-set! directly so the slot holds the exact function pointer.
    ;; defmethod wraps in a lambda, so the slot != the function → guard fires every frame.
    (let ((cur-common-post (method-of-type citizen common-post)))
      (when (!= cur-common-post mp-citizen-common-post-hijack)
        (format 0 "[MP-Traffic] Applying citizen common-post hijack (slot ~D)~%" cpost-id)
        (set! *old-citizen-common-post* (the-as (function citizen none) cur-common-post))
        (method-set! citizen cpost-id mp-citizen-common-post-hijack)
        )
      )

    (let ((cur-event-handler (method-of-type citizen general-event-handler)))
      (when (!= cur-event-handler (the-as function mp-citizen-event-handler-hijack))
        (format 0 "[MP-Traffic] Applying citizen event-handler hijack (slot ~D)~%" evhnd-id)
        (set! *old-citizen-event-handler* (the-as (function citizen process int symbol event-message-block object) cur-event-handler))
        (method-set! citizen evhnd-id (the-as function mp-citizen-event-handler-hijack))
        )
      )

    ;; Phase 2: patch cwi.gd subtypes (civilian, citizen-norm, fat, chick)
    ;; These types live in cwi.gd which loads only when the city level loads — AFTER
    ;; game.gd and after our first call on connect. Their GOAL symbol table values are
    ;; 0 until deftype runs, so we guard every method-set! with a null check and retry
    ;; each frame until all four are loaded.
    (when (and (nonzero? (the-as uint civilian))
               (nonzero? (the-as uint citizen-norm))
               (nonzero? (the-as uint citizen-fat))
               (nonzero? (the-as uint citizen-chick)))
      (let ((cur-cpost (-> (the-as type civilian) method-table 55)))
        (when (!= cur-cpost mp-citizen-common-post-hijack)
          (method-set! civilian      cpost-id mp-citizen-common-post-hijack)
          (method-set! civilian      evhnd-id (the-as function mp-citizen-event-handler-hijack))
          (method-set! citizen-norm  cpost-id mp-citizen-common-post-hijack)
          (method-set! citizen-norm  evhnd-id (the-as function mp-citizen-event-handler-hijack))
          (method-set! citizen-fat   cpost-id mp-citizen-common-post-hijack)
          (method-set! citizen-fat   evhnd-id (the-as function mp-citizen-event-handler-hijack))
          (method-set! citizen-chick cpost-id mp-citizen-common-post-hijack)
          (method-set! citizen-chick evhnd-id (the-as function mp-citizen-event-handler-hijack))
          (format 0 "[MP-Traffic] All citizen subtypes patched (common-post=~D event-handler=~D)~%"
                  cpost-id evhnd-id)
          )
        )
      )
    )
  (none)
  )
