;;-*-Lisp-*-
(in-package goal)

(defconstant MP_TRAFFIC_AUTHORITY_ACQUIRE_DISTANCE (meters 250.0))
(defconstant MP_TRAFFIC_AUTHORITY_RETAIN_DISTANCE (meters 310.0))

(defun mp-traffic-clear-authority-map! ((authority-map mp-traffic-authority-map))
  (when (and authority-map (nonzero? authority-map))
    (dotimes (player-id MP_MAX_PLAYERS)
      (set! (-> authority-map assignments player-id) (the-as uint8 #xff))))
  authority-map)

(defun mp-traffic-copy-authority-map! ((dst mp-traffic-authority-map) (src mp-traffic-authority-map))
  (when (and dst (nonzero? dst) src (nonzero? src))
    (dotimes (player-id MP_MAX_PLAYERS)
      (set! (-> dst assignments player-id) (-> src assignments player-id))))
  dst)

(defun mp-traffic-authority-for-player ((authority-map mp-traffic-authority-map) (player-id uint))
  (if (and authority-map (nonzero? authority-map) (< player-id (the uint MP_MAX_PLAYERS)))
    (let ((compact-source (the-as uint (-> authority-map assignments player-id))))
      (if (= compact-source #xff) MP_INVALID_PLAYER_ID compact-source))
    MP_INVALID_PLAYER_ID))

(defun mp-traffic-set-authority-for-player! ((authority-map mp-traffic-authority-map)
                                             (player-id uint)
                                             (source-player-id uint))
  (when (and authority-map (nonzero? authority-map) (< player-id (the uint MP_MAX_PLAYERS)))
    (set! (-> authority-map assignments player-id)
          (the-as uint8 (if (= source-player-id MP_INVALID_PLAYER_ID) #xff (logand source-player-id #xff)))))
  authority-map)

(defun mp-traffic-record-death-root-held? ((record mp-player-record))
  (and record
       (nonzero? record)
       (logtest? (-> record action respawn-flags) MP_RESPAWN_FLAG_TRAFFIC_DEATH_ROOT_HOLD)
       (not (logtest? (-> record action respawn-flags) MP_RESPAWN_FLAG_TRAFFIC_AUTHORITY_RELEASED))))

(defun mp-traffic-root-incumbent-held? ((player-id uint)
                                        (record mp-player-record)
                                        (previous-map mp-traffic-authority-map))
  (and (< player-id (the uint MP_MAX_PLAYERS))
       (mp-traffic-record-death-root-held? record)
       (= (mp-traffic-authority-for-player previous-map player-id) player-id)))

(defun mp-traffic-record-can-establish-root? ((player-id uint)
                                              (record mp-player-record)
                                              (previous-map mp-traffic-authority-map))
  (and record
       (nonzero? record)
       (or (not (mp-player-record-dead-or-dying? record))
           (mp-traffic-root-incumbent-held? player-id record previous-map))))

(defun mp-traffic-local-incumbent-root? ()
  (let ((local-player-id (mp-local-player-id)))
    (and (< local-player-id (the uint MP_MAX_PLAYERS))
         (= (mp-traffic-authority-for-player *mp-traffic-authority-assignments* local-player-id) local-player-id))))

(defun mp-traffic-clear-death-spectate-state! ()
  (set! *mp-traffic-death-spectate-active?* #f)
  (set! *mp-traffic-death-root-hold?* #f)
  (set! *mp-traffic-authority-released?* #f)
  (mp-pack-local-respawn-policy!)
  (none))

(defun mp-traffic-begin-local-death-spectate! ()
  (set! *mp-traffic-death-spectate-active?* #t)
  (set! *mp-traffic-authority-released?* #f)
  (set! *mp-traffic-death-root-hold?* (mp-traffic-local-incumbent-root?))
  (mp-pack-local-respawn-policy!)
  (log 'debug
       "[MP-Traffic-Auth] death begin hold=~A incumbent=~A released=~A~%"
       *mp-traffic-death-root-hold?*
       (mp-traffic-local-incumbent-root?)
       *mp-traffic-authority-released?*)
  (none))

(defun mp-traffic-log-death-spectator-state! ((target-id uint) (distance float) (within? symbol))
  (when (time-elapsed? *mp-traffic-death-state-log-time* (seconds 1))
    (log 'debug
         "[MP-Traffic-Auth] death active=~A hold=~A released=~A target=~D dist=~D~%"
         *mp-traffic-death-spectate-active?*
         *mp-traffic-death-root-hold?*
         *mp-traffic-authority-released?*
         target-id
         distance)
    (log 'debug
         "[MP-Traffic-Auth] death target-within=~A selected-source=~D~%"
         within?
         *mp-traffic-selected-authority-id*)
    (set! *mp-traffic-death-state-log-time* (current-time)))
  (none))

(defun mp-traffic-player-eligible? ((record mp-player-record))
  (if (or (not record) (zero? record))
    #f
    (let ((player-id (-> record identity player-id))
          (position (mp-player-record-position record))
          (primary-level-id (mp-player-primary-level-id record)))
      (the-as symbol
              (and (< player-id (the uint MP_MAX_PLAYERS))
                   (nonzero? (-> record identity identity-ready?))
                   (nonzero? (-> record identity joined?))
                   (= (-> record identity spectator-only?) 0)
                   (or (= player-id (mp-local-player-id))
                       (= (-> record connection activity) (mp-player-activity in-game)))
                   (or (not (mp-player-record-dead-or-dying? record)) (mp-traffic-record-death-root-held? record))
                   (or (!= player-id (mp-local-player-id))
                       (not (mp-spectate-active?))
                       (mp-traffic-record-death-root-held? record))
                   (nonzero? primary-level-id)
                   position
                   (nonzero? position))))))

(defun mp-traffic-record-advertises-level? ((record mp-player-record) (level-id uint))
  (if (or (not record) (zero? record) (= level-id (the uint 0)))
    #f
    (let ((advertised? #f))
      (dotimes (level-slot MP_PLAYER_LEVEL_SLOT_COUNT)
        (when (= (the-as uint (-> record transform levels level-slot level-id)) level-id)
          (set! advertised? #t)))
      advertised?)))

(defun mp-traffic-records-share-level-context? ((record mp-player-record) (root-record mp-player-record))
  (if (or (not record) (zero? record) (not root-record) (zero? root-record))
    #f
    (let ((record-level (mp-player-primary-level-id record))
          (root-level (mp-player-primary-level-id root-record)))
      (and (nonzero? record-level)
           (nonzero? root-level)
           (or (= record-level root-level)
               (mp-traffic-record-advertises-level? record root-level)
               (mp-traffic-record-advertises-level? root-record record-level))))))

(defun mp-traffic-update-death-spectator-state! ()
  (when (and *mp-traffic-death-spectate-active?*
             *mp-traffic-death-root-hold?*
             (not *mp-traffic-authority-released?*)
             (mp-spectate-active?))
    (let ((local-record (mp-local-player-record))
          (target-record (mp-spectated-player-record))
          (target-id MP_INVALID_PLAYER_ID)
          (distance (the float -1.0))
          (within? #f))
      (when (and local-record (nonzero? local-record) target-record (nonzero? target-record))
        (set! target-id (-> target-record identity player-id))
        (let ((local-pos (mp-player-record-position local-record))
              (target-pos (mp-player-record-position target-record)))
          (when (and local-pos (nonzero? local-pos) target-pos (nonzero? target-pos))
            (set! distance (vector-vector-distance local-pos target-pos))
            (set! within?
                  (and (mp-traffic-records-share-level-context? local-record target-record)
                       (<= distance MP_TRAFFIC_AUTHORITY_RETAIN_DISTANCE)))
            (when (not within?)
              (set! *mp-traffic-authority-released?* #t)
              (mp-pack-local-respawn-policy!)
              (log 'debug
                   "[MP-Traffic-Auth] death spectator target left retained bubble; releasing authority target=~D dist=~D~%"
                   target-id
                   distance)))))
      (mp-traffic-log-death-spectator-state! target-id distance within?)))
  (none))

(defun mp-traffic-records-within? ((record mp-player-record) (root-record mp-player-record) (radius float))
  (if (or (not (mp-traffic-player-eligible? record)) (not (mp-traffic-player-eligible? root-record)))
    #f
    (let ((record-pos (mp-player-record-position record))
          (root-pos (mp-player-record-position root-record)))
      (the-as symbol
              (and (mp-traffic-records-share-level-context? record root-record)
                   record-pos
                   (nonzero? record-pos)
                   root-pos
                   (nonzero? root-pos)
                   (<= (vector-vector-distance record-pos root-pos) radius))))))

(defun mp-traffic-find-acquire-root ((player-id uint) (record mp-player-record) (root-mask uint))
  (dotimes (root-id player-id)
    (when (logtest? root-mask (ash 1 root-id))
      (let ((root-record (mp-player-record-by-id (the-as uint root-id))))
        (when (and root-record
                   (nonzero? root-record)
                   (mp-traffic-records-within? record root-record MP_TRAFFIC_AUTHORITY_ACQUIRE_DISTANCE))
          (return (the-as uint root-id))))))
  MP_INVALID_PLAYER_ID)

(defun mp-traffic-retained-root ((player-id uint)
                                 (record mp-player-record)
                                 (previous-map mp-traffic-authority-map)
                                 (root-mask uint))
  (let ((previous-source (mp-traffic-authority-for-player previous-map player-id)))
    (when (< previous-source (the uint MP_MAX_PLAYERS))
      (let ((root-record (mp-player-record-by-id previous-source)))
        (when (and root-record
                   (nonzero? root-record)
                   (logtest? root-mask (ash 1 previous-source))
                   (or (< previous-source player-id)
                       (mp-traffic-root-incumbent-held? previous-source root-record previous-map))
                   (mp-traffic-records-within? record root-record MP_TRAFFIC_AUTHORITY_RETAIN_DISTANCE))
          (return previous-source)))))
  MP_INVALID_PLAYER_ID)

(defun mp-traffic-race-host-pinned? ()
  (let ((manager (process-by-type-exact 'race-manager *active-pool*)))
    (and manager (nonzero? manager) (= (-> manager state name) 'active))))

(defun mp-traffic-seed-held-roots! ((previous-map mp-traffic-authority-map))
  (let ((root-mask (the uint 0)))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (mp-traffic-player-eligible? record)
                   (mp-traffic-root-incumbent-held? (the-as uint player-id) record previous-map))
          (logior! root-mask (ash 1 player-id)))))
    root-mask))

(defun mp-traffic-log-authority-map-transitions! ((previous-map mp-traffic-authority-map)
                                                  (authority-map mp-traffic-authority-map))
  (when (time-elapsed? *mp-traffic-authority-transition-log-time* (seconds 1))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((old-source (mp-traffic-authority-for-player previous-map (the-as uint player-id)))
            (new-source (mp-traffic-authority-for-player authority-map (the-as uint player-id))))
        (when (!= old-source new-source)
          (log 'debug "[MP-Traffic-Auth] map player=~D old-source=~D new-source=~D~%" player-id old-source new-source))))
    (set! *mp-traffic-authority-transition-log-time* (current-time)))
  (none))

(defun mp-traffic-build-authority-map ((previous-map mp-traffic-authority-map))
  (let ((authority-map *mp-traffic-working-authority-map*)
        (root-mask (mp-traffic-seed-held-roots! previous-map)))
    (mp-traffic-clear-authority-map! authority-map)
    (when (mp-traffic-race-host-pinned?)
      (let ((host-player-id (mp-host-player-id)))
        (when (< host-player-id (the uint MP_MAX_PLAYERS))
          (dotimes (player-id MP_MAX_PLAYERS)
            (let ((record (mp-player-record-by-id (the-as uint player-id))))
              (when (and record (nonzero? record) (nonzero? (-> record identity joined?)))
                (mp-traffic-set-authority-for-player! authority-map (the-as uint player-id) host-player-id))))))
      (return authority-map))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record (nonzero? record) (mp-traffic-player-eligible? record))
          (let ((source-player-id (mp-traffic-retained-root (the-as uint player-id) record previous-map root-mask)))
            (when (= source-player-id MP_INVALID_PLAYER_ID)
              (set! source-player-id (mp-traffic-find-acquire-root (the-as uint player-id) record root-mask)))
            (when (= source-player-id MP_INVALID_PLAYER_ID)
              (when (mp-traffic-record-can-establish-root? (the-as uint player-id) record previous-map)
                (set! source-player-id (the-as uint player-id))
                (logior! root-mask (ash 1 player-id))))
            (mp-traffic-set-authority-for-player! authority-map (the-as uint player-id) source-player-id)))))
    (mp-traffic-log-authority-map-transitions! previous-map authority-map)
    authority-map))

(defun mp-traffic-interest-player-id ()
  (when (mp-spectate-active?)
    (let ((spectated-record (mp-spectated-player-record)))
      (when (and spectated-record (nonzero? spectated-record))
        (let ((spectated-id (-> spectated-record identity player-id)))
          (when (< spectated-id (the uint MP_MAX_PLAYERS))
            (return spectated-id))))))
  (mp-local-player-id))

(defun mp-traffic-selected-authority-record ()
  (if (< *mp-traffic-selected-authority-id* (the uint MP_MAX_PLAYERS))
    (mp-player-record-by-id *mp-traffic-selected-authority-id*)
    (the-as mp-player-record #f)))

(defun mp-traffic-map-has-follower? ((authority-map mp-traffic-authority-map) (root-player-id uint))
  (when (< root-player-id (the uint MP_MAX_PLAYERS))
    (dotimes (player-id MP_MAX_PLAYERS)
      (when (and (!= (the-as uint player-id) root-player-id)
                 (= (mp-traffic-authority-for-player authority-map (the-as uint player-id)) root-player-id))
        (return #t))))
  #f)

(defun mp-traffic-cleanup-authority-handoff! ()
  (mp-traffic-cleanup-after-sync-exit!)
  (none))

(defun mp-traffic-apply-authority-map! ((authority-map mp-traffic-authority-map) (revision uint))
  (let* ((local-player-id (mp-local-player-id))
         (interest-player-id (mp-traffic-interest-player-id))
         (selected-source (mp-traffic-authority-for-player authority-map interest-player-id))
         (local-authoritative? (and (< local-player-id (the uint MP_MAX_PLAYERS)) (= selected-source local-player-id)))
         (has-followers? (and local-authoritative? (mp-traffic-map-has-follower? authority-map local-player-id)))
         (source-changed? (!= selected-source *mp-traffic-selected-authority-id*)))
    (when source-changed?
      (log 'debug
           "[MP-Traffic-Auth] local=~D old-root=~D new-root=~D rev=~D~%"
           local-player-id
           *mp-traffic-selected-authority-id*
           selected-source
           revision)
      (mp-traffic-cleanup-authority-handoff!))
    (mp-traffic-copy-authority-map! *mp-traffic-authority-assignments* authority-map)
    (set! *mp-traffic-authority-revision* revision)
    (set! *mp-traffic-selected-authority-id* selected-source)
    (set! *mp-traffic-local-authoritative?* local-authoritative?)
    (set! *mp-traffic-local-root-has-followers?* has-followers?)
    (set! *mp-traffic-sync-active* (< selected-source (the uint MP_MAX_PLAYERS)))
    (set! *mp-traffic-suppressed* (not local-authoritative?))
    (set! *mp-traffic-drain-active* (not local-authoritative?))
    (when source-changed?
      (if local-authoritative?
        (mp-traffic-refill-local-active-cells!)
        (when (and *traffic-manager* (nonzero? *traffic-manager*))
          (mp-traffic-force-clear-local-vehicles!)))))
  (none))

(defun mp-traffic-reset-offline-authority! ()
  (let ((was-authoritative? *mp-traffic-local-authoritative?*)
        (had-source? (< *mp-traffic-selected-authority-id* (the uint MP_MAX_PLAYERS))))
    (when had-source?
      (mp-traffic-cleanup-authority-handoff!))
    (mp-traffic-clear-authority-map! *mp-traffic-authority-assignments*)
    (mp-traffic-clear-authority-map! *mp-traffic-working-authority-map*)
    (set! *mp-traffic-selected-authority-id* MP_INVALID_PLAYER_ID)
    (set! *mp-traffic-local-authoritative?* #t)
    (set! *mp-traffic-local-root-has-followers?* #f)
    (set! *mp-traffic-suppressed* #f)
    (set! *mp-traffic-sync-active* #f)
    (set! *mp-traffic-drain-active* #f)
    (when (and (not was-authoritative?) *traffic-manager* (nonzero? *traffic-manager*))
      (mp-traffic-refill-local-active-cells!)))
  (none))

(defun mp-update-traffic-authority ()
  (let ((in-game? (mp-session-in-game?)))
    (when in-game?
      (mp-traffic-update-death-spectator-state!))
    (cond
      ((not in-game?) (mp-traffic-reset-offline-authority!))
      ((not (nonnull? *traffic-manager*))
       (mp-traffic-reset-offline-authority!)
       (when (and (mp-session-host?) (zero? *mp-traffic-authority-revision*))
         (set! *mp-traffic-authority-revision* (the uint 1))))
      ((mp-session-host?)
       (when (nonnull? *mp-traffic-authority-assignments*)
         (let ((new-map (mp-traffic-build-authority-map *mp-traffic-authority-assignments*))
               (changed? #f))
           (when (nonnull? new-map)
             (dotimes (player-id MP_MAX_PLAYERS)
               (when (!= (-> new-map assignments player-id)
                         (-> *mp-traffic-authority-assignments* assignments player-id))
                 (set! changed? #t)))
             (when (or changed? (zero? *mp-traffic-authority-revision*))
               (let ((revision (+ *mp-traffic-authority-revision* (the uint 1))))
                 (mp-traffic-apply-authority-map! new-map revision)))))))
      (else
       (when (nonnull? *mp-replication-state* *mp-traffic-working-authority-map*)
         (let ((revision (-> *mp-replication-state* remote authority revision)))
           (when (or (> revision *mp-traffic-authority-revision*)
                     (!= (mp-traffic-authority-for-player *mp-traffic-working-authority-map*
                                                          (mp-traffic-interest-player-id))
                         *mp-traffic-selected-authority-id*))
             (mp-traffic-apply-authority-map! *mp-traffic-working-authority-map* revision)))))))
  (none))
