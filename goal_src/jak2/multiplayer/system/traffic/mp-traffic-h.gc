(define-extern mp-traffic-spawn-registered-transport-guard! (function process uint citizen))

;; --- Transport-spawned Pedestrian Context ---

(defconstant MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE 32)
(defconstant MP_TRAFFIC_TRANSPORT_ID_SLUMS_BASE 1)
(defconstant MP_TRAFFIC_TRANSPORT_ID_HAL3 1024)

(deftype mp-traffic-transport-record (structure)
  ((transport-id     uint32)
   (transport-handle handle)
   )
  )

(define *mp-traffic-transport-registry*
  (new 'static 'inline-array mp-traffic-transport-record MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE))

(defun mp-pedestrian-slot-transport-id ((slot mp-pedestrian-state))
  (if (and slot (nonzero? slot))
      (-> slot transport-id)
      (the uint 0)
      )
  )

(defun mp-pedestrian-set-transport-id! ((slot mp-pedestrian-state) (transport-id uint))
  (when (and slot (nonzero? slot))
    (set! (-> slot transport-id) transport-id)
    )
  (none)
  )

(defun mp-pedestrian-transport-spawned? ((slot mp-pedestrian-state))
  (nonzero? (mp-pedestrian-slot-transport-id slot))
  )

(defun mp-pedestrian-set-transport-side! ((slot mp-pedestrian-state) (transport-side uint))
  (when (and slot (nonzero? slot))
    (set! (-> slot transport-side) (the uint8 (logand transport-side #xff)))
    )
  (none)
  )

(defun mp-traffic-register-transport! ((transport-id uint) (transport-handle handle))
  (let ((free-rec (the-as mp-traffic-transport-record #f))
        (done? #f))
    (when (nonzero? transport-id)
      (dotimes (rec-idx MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE)
        (when (not done?)
          (let ((rec (-> *mp-traffic-transport-registry* rec-idx)))
            (cond
              ((= (-> rec transport-id) transport-id)
               (set! (-> rec transport-handle) transport-handle)
               (set! done? #t)
               )
              ((and (zero? (-> rec transport-id))
                    (not free-rec))
               (set! free-rec rec)
               )
              )
            )
          )
        )
      (when (and (not done?) free-rec)
        (set! (-> free-rec transport-id) transport-id)
        (set! (-> free-rec transport-handle) transport-handle)
        )
      )
    )
  (none)
  )

(defun mp-traffic-unregister-transport! ((transport-id uint))
  (when (nonzero? transport-id)
    (dotimes (rec-idx MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE)
      (let ((rec (-> *mp-traffic-transport-registry* rec-idx)))
        (when (= (-> rec transport-id) transport-id)
          (set! (-> rec transport-id) (the uint32 0))
          (set! (-> rec transport-handle) (the-as handle #f))
          )
        )
      )
    )
  (none)
  )

(defun mp-traffic-find-transport ((transport-id uint))
  (let ((found-transport (the-as process #f)))
    (when (nonzero? transport-id)
      (dotimes (rec-idx MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE)
        (when (not found-transport)
          (let ((rec (-> *mp-traffic-transport-registry* rec-idx)))
            (when (= (-> rec transport-id) transport-id)
              (let ((proc (handle->process-safe (-> rec transport-handle))))
                (when (and proc
                           (nonzero? proc))
                  (set! found-transport proc)
                  )
                )
              )
            )
          )
        )
      )
    found-transport
    )
  )

(defun mp-traffic-transport-id-for-process ((transport-proc process))
  (let ((transport-id (the uint 0)))
    (when (and transport-proc
               (nonzero? transport-proc))
      (dotimes (rec-idx MP_TRAFFIC_TRANSPORT_REGISTRY_SIZE)
        (when (zero? transport-id)
          (let ((rec (-> *mp-traffic-transport-registry* rec-idx)))
            (when (nonzero? (-> rec transport-id))
              (let ((proc (handle->process-safe (-> rec transport-handle))))
                (when (and proc
                           (nonzero? proc)
                           (= proc transport-proc))
                  (set! transport-id (-> rec transport-id))
                  )
                )
              )
            )
          )
        )
      )
    transport-id
    )
  )

(defun mp-traffic-spawn-transport-guard! ((transport-id uint) (net-id uint))
  (when (and (nonzero? transport-id)
             (nonzero? net-id))
    (let ((transport-proc (mp-traffic-find-transport transport-id)))
      (when (and transport-proc (nonzero? transport-proc))
      (debug-log *mp-debug-log?* "[MP-Traffic-H] Attempting to spawn guard puppet in a transport transport-id=~D with nid=~D~%" transport-id net-id)
        (let ((guard-proc (mp-traffic-spawn-registered-transport-guard! transport-proc net-id)))
          (when (and guard-proc (nonzero? guard-proc))
            (debug-log *mp-debug-log?* "[MP-Traffic-H] Spawned ~A puppet in a transport transport-id=~D with nid=~D~%" guard-proc transport-id net-id)
            (return guard-proc)
          )
        )
      )
    )
  )
  (the-as citizen #f)
)

;; Remote traffic snapshots can land slightly off the local traffic graph during
;; zone churn. Use a linked level branch as a last-resort non-null controller seed.
(defun mp-traffic-fallback-spawn-branch ()
  (let ((best-branch (the-as nav-branch #f))
        (best-active-count (the uint 0)))
    (when (and *traffic-engine*
               (nonzero? (the-as uint *traffic-engine*)))
      (dotimes (slot-idx 2)
        (let ((level-data (-> *traffic-engine* level-data-array slot-idx)))
          (let ((city-info (-> level-data city-info)))
            (when (and city-info
                       (nonzero? city-info)
                       (-> city-info nav-graph)
                       (nonzero? (-> city-info nav-graph)))
              (let ((graph (-> city-info nav-graph))
                    (active-count (the uint (-> level-data active-cell-count))))
                (when (> (-> graph branch-count) 0)
                  (let ((candidate-branch (-> graph branch-array 0)))
                    (when (and candidate-branch
                               (nonzero? candidate-branch)
                               (or (not best-branch)
                                   (> active-count best-active-count)))
                      (set! best-branch candidate-branch)
                      (set! best-active-count active-count)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    best-branch
    )
  )

;; Safe cross-module hooks for guard target assignment
(define *mp-set-guard-target* (the-as (function citizen handle none) #f))
(define *mp-get-guard-target* (the-as (function citizen handle) #f))

(define-extern mp-traffic-force-clear-local-vehicles! (function none))

(defun mp-is-traffic-ready? ()
  "Is the traffic system fully initialized and ready for sync? (Client Side)"
  (and *traffic-manager*
       (nonzero? *traffic-manager*)
       *lwide-entity*
       (nonzero? (the-as uint *lwide-entity*))
       )
  )

(defun mp-is-traffic-spawn-ready? ()
  "True when it is safe to materialize remote traffic puppets that need level art."
  (and (mp-is-traffic-ready?)
       *level*
       (nonzero? *level*)
       (= (-> *level* loading-level) (-> *level* default-level))
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       )
  )

(defun mp-is-traffic-existing-update-ready? ()
  "True when existing traffic puppets may consume state without materializing level art."
  (and (mp-is-traffic-ready?)
       *level*
       (nonzero? *level*)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       )
  )

(defun mp-local-world-ready-for-remote-sync? ()
  "True when local player/world state is stable enough for remote puppet and traffic state changes."
  (and *level*
       (nonzero? *level*)
       (= (-> *level* loading-level) (-> *level* default-level))
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       (not (and (-> *target* next-state)
                 (nonzero? (-> *target* next-state))
                 (= (-> *target* next-state name) 'target-load-wait)))
       )
  )

(defun mp-traffic-art-context! ((kind symbol) (net-id uint) (object-type uint) (state-id uint))
  "Remember the latest MP traffic spawn/update path for loader error correlation."
  (set! *mp-traffic-art-context-kind* kind)
  (set! *mp-traffic-art-context-net-id* net-id)
  (set! *mp-traffic-art-context-object-type* object-type)
  (set! *mp-traffic-art-context-state-id* state-id)
  (set! *mp-traffic-art-context-time* (current-time))
  (none)
  )

(defun mp-traffic-debug-update-frame-context! ()
  "Capture per-frame traffic sync context using only primitive debug fields."
  (if (and *mp-traffic-buffer* (nonzero? (the-as uint *mp-traffic-buffer*)))
      (begin
        (set! *mp-traffic-art-context-ped-count* (-> *mp-traffic-buffer* ped-count))
        (set! *mp-traffic-art-context-veh-count* (-> *mp-traffic-buffer* veh-count))
        )
      (begin
        (set! *mp-traffic-art-context-ped-count* (the uint 0))
        (set! *mp-traffic-art-context-veh-count* (the uint 0))
        )
      )
  (if (and *local-info* (nonzero? *local-info*))
      (set! *mp-traffic-art-context-local-level* (-> *local-info* level))
      (set! *mp-traffic-art-context-local-level* (the uint 0))
      )
  (if (and *remote-info* (nonzero? *remote-info*))
      (set! *mp-traffic-art-context-remote-level* (-> *remote-info* level))
      (set! *mp-traffic-art-context-remote-level* (the uint 0))
      )
  (if (mp-is-traffic-spawn-ready?)
      (set! *mp-traffic-art-context-spawn-ready* #t)
      (set! *mp-traffic-art-context-spawn-ready* #f)
      )
  (set! *mp-traffic-art-context-riding* #f)
  (when (and *target*
             (nonzero? *target*)
             (focus-test? *target* pilot)
             (-> *target* pilot)
             (nonzero? (-> *target* pilot)))
    (set! *mp-traffic-art-context-riding* #t)
    )
  (none)
  )

(defun mp-traffic-type-loaded? ((t-type traffic-type))
  "Check if the art group for a given traffic type is already loaded in memory. (Client Side)"
  ;; GLOBAL SAFETY: Spawning remote traffic requires stable level art.
  (if (not (mp-is-traffic-spawn-ready?))
      (return #f))

  (let ((ag-name (the-as string #f)))
    (case t-type
      (((traffic-type bikea)) (set! ag-name "skel-bikea"))
      (((traffic-type bikeb)) (set! ag-name "skel-bikeb"))
      (((traffic-type bikec)) (set! ag-name "skel-bikec"))
      (((traffic-type cara)) (set! ag-name "skel-cara"))
      (((traffic-type carb)) (set! ag-name "skel-carb"))
      (((traffic-type carc)) (set! ag-name "skel-carc"))
      (((traffic-type guard-bike)) (set! ag-name "skel-guard-bike"))
      (((traffic-type hellcat)) (set! ag-name "skel-hellcat"))
      (((traffic-type citizen-norm-1) (traffic-type citizen-norm-2)) (set! ag-name "skel-citizen-norm"))
      (((traffic-type tt5)) (set! ag-name "skel-citizen-rebel"))
      (((traffic-type citizen-chick)) (set! ag-name "skel-citizen-chick"))
      (((traffic-type citizen-fat)) (set! ag-name "skel-citizen-fat"))
      (((traffic-type metalhead-predator)) (set! ag-name "skel-metalhead-predator"))
      (((traffic-type metalhead-grunt)) (set! ag-name "skel-grunt"))
      (((traffic-type metalhead-flitter)) (set! ag-name "skel-flitter"))
      (((traffic-type crimson-guard-1) (traffic-type crimson-guard-0)) (set! ag-name "skel-crimson-guard"))
      )
    (if ag-name
        (let ((skel (the-as skeleton-group (art-group-get-by-name *level* ag-name (the-as (pointer uint32) #f)))))
          (if (and skel (nonzero? skel))
              ;; The skeleton-group doesn't have the data array, the actual art-group does.
              (let ((ag (art-group-get-by-name *level* (-> skel art-group-name) (the-as (pointer uint32) #f))))
                (if (and ag
                         (nonzero? ag)
                         (> (-> ag length) 0)
                         (-> ag data 0)
                         (nonzero? (-> ag data 0)))
                    #t
                    #f
                    )
                )
              #f
              )
          )
        #f
        )
    )
  )

(none)
