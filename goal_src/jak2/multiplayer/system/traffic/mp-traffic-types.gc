(in-package goal)

(define-perm *mp-traffic-suppressed* symbol #f)
(define-perm *mp-traffic-sync-active* symbol #f)
(define-perm *mp-traffic-drain-active* symbol #f)
(define-perm *mp-traffic-local-authoritative?* symbol #t)
(define-perm *mp-traffic-local-root-has-followers?* symbol #f)
(define-perm *mp-traffic-selected-authority-id* uint (the uint #xff))
(define-perm *mp-traffic-death-spectate-active?* symbol #f)
(define-perm *mp-traffic-death-root-hold?* symbol #f)
(define-perm *mp-traffic-authority-released?* symbol #f)
(define-perm *mp-traffic-death-state-log-time* time-frame 0)
(define-perm *mp-traffic-authority-transition-log-time* time-frame 0)
(define-perm *mp-pedestrian-net-id-counter* uint (the uint 1))
(define-perm *mp-vehicle-net-id-counter* uint (the uint 32768))

(defconstant MP_RESPAWN_FLAG_TRAFFIC_DEATH_ROOT_HOLD #x2)
(defconstant MP_RESPAWN_FLAG_TRAFFIC_AUTHORITY_RELEASED #x4)
(defconstant MP_TRAFFIC_NET_ID_SEQUENCE_MASK (the uint #x00ffffff))
(defconstant MP_TRAFFIC_NET_ID_ORIGIN_SHIFT 24)
(defconstant MP_TRAFFIC_PEDESTRIAN_NET_ID_BASE (the uint #x10000000))
(defconstant MP_TRAFFIC_VEHICLE_NET_ID_BASE (the uint #x20000000))
(defconstant MP_CLIENT_VEHICLE_NET_ID_BASE (the uint #x40000000))

(define-perm *mp-client-vehicle-net-id-counter* uint MP_CLIENT_VEHICLE_NET_ID_BASE)
(define-perm *mp-last-local-state-id* uint (the uint 0))

(defun mp-traffic-build-net-id ((class-base uint) (player-id uint) (sequence uint))
  (if (and (< player-id (the uint MP_MAX_PLAYERS))
           (<= sequence MP_TRAFFIC_NET_ID_SEQUENCE_MASK)
           (or (= class-base MP_TRAFFIC_PEDESTRIAN_NET_ID_BASE)
               (= class-base MP_TRAFFIC_VEHICLE_NET_ID_BASE)
               (= class-base MP_CLIENT_VEHICLE_NET_ID_BASE)))
    (logior class-base (shl player-id MP_TRAFFIC_NET_ID_ORIGIN_SHIFT) sequence)
    (the uint 0)))

(defenum mp-veh-state-id
  (uint8)
  (none 0)
  (idle 1)
  (inactive 2)
  (active 3)
  (waiting 4)
  (player-control 5)
  (crash 6)
  (explode 7)
  (die 8)
  (measure-control-parameters 9)
  (hostile 10)
  (stop-and-shoot 11)
  (slow-pursuit 12)
  (waiting-ambush 13)
  (waiting-race 14)
  (waiting-for-start 15)
  (racing 16)
  (race-finished 17))

(define MP_VEHICLE_STATE_FLAG_DEAD (the uint 1))
(define MP_VEHICLE_STATE_FLAG_HIGH_FLIGHT (the uint 2))
(define MP_VEHICLE_STATE_FLAG_PHYSICS (the uint 4))
(define MP_VEHICLE_STATE_FLAG_PARKING_MINIMAP (the uint 8))
(define MP_VEHICLE_STATE_FLAG_RESPAWN_PROTECTED (the uint 16))
(define MP_VEHICLE_RIDER_CIVILIAN_ID (the uint #xfffffffe))

(deftype mp-vehicle-state (structure)
  ((net-id           uint32)
   (vehicle-type     uint8)
   (color-index      uint8)
   (state-id         uint8)
   (target-player-id uint8)
   (x                float)
   (y                float)
   (z                float)
   (quat-x           float)
   (quat-y           float)
   (quat-z           float)
   (quat-w           float)
   (lin-vel-x        float)
   (lin-vel-y        float)
   (lin-vel-z        float)
   (ang-vel-x        float)
   (ang-vel-y        float)
   (ang-vel-z        float)
   (state-flags      uint8)
   (hit-points       uint8)
   (level-id         uint16)
   (rider-player-ids uint32 4))
  :size-assert 80)

(defenum mp-ped-state-id
  (uint8)
  (none 0)
  (inactive 1)
  (wait 2)
  (active 3)
  (flee 4)
  (avoid-danger 5)
  (clear-path 6)
  (on-ground 7)
  (dive 8)
  (cower-ground 9)
  (get-up-front 10)
  (get-up-back 11)
  (knocked 12)
  (knocked-off-vehicle 13)
  (wait-for-ride 14)
  (move-to-vehicle 15)
  (board-vehicle 16)
  (ride 17)
  (exit-vehicle 18)
  (wait-at-dest 19)
  (in-ditch 20)
  (idle 21)
  (dormant 22)
  (notice 23)
  (hostile 24)
  (stare 25)
  (hit 26)
  (die 27)
  (walk 28)
  (run 29)
  (talk 30)
  (hide 31)
  (search 32)
  (close-attack 33)
  (close-attack-active 34)
  (gun-shoot 35)
  (roll-right 36)
  (roll-left 37)
  (arrest 38)
  (waiting-ambush 39)
  (attack 40)
  (exit-transport 41)
  (die-falling 42)
  (die-fast 43))

(defenum mp-pedestrian-flags
  :type uint8
  :bitfield #t
  (dead)
  (dark-guard))

(defconstant PEDESTRIAN_WALK_ANIMATION_SEED (the uint #x13579bdf))
(defconstant PEDESTRIAN_RUN_ANIMATION_SEED (the uint #x2468ace0))
(defconstant PEDESTRIAN_PANIC_ANIMATION_SEED (the uint #x31415926))
(defconstant PEDESTRIAN_WAIT_ANIMATION_SEED (the uint #x27182818))
(defconstant PEDESTRIAN_WAIT_REPEAT_SEED (the uint #x16180339))
(defconstant PEDESTRIAN_WAIT_SPEED_SEED (the uint #x9e3779b9))

(defconstant PEDESTRIAN_TRAVEL_SPEED_RESOLUTION 512.0)

(defconstant PEDESTRIAN_SCALE_MIN 1.0)
(defconstant PEDESTRIAN_SCALE_MAX 1.25)
(defconstant PEDESTRIAN_SCALE_STEPS 15)

(deftype pedestrian-appearance (uint32)
  ((parts        uint32 :offset 0  :size 24)
   (width-scale  uint8  :offset 24 :size 4)
   (height-scale uint8 :offset 28 :size 4)))

(deftype mp-pedestrian-state (structure)
  ((net-id            uint32)
   (object-type       uint8)
   (state-id          uint8)
   (x                 float)
   (y                 float)
   (z                 float)
   (quat-x            float)
   (quat-y            float)
   (quat-z            float)
   (quat-w            float)
   (hp                int32)
   (flags             mp-pedestrian-flags)
   (target-player-id  uint8)
   (vehicle-net-id    uint32)
   (transport-id      uint32)
   (appearance-mask   uint32)
   (level-id          uint16)
   (transport-side    uint8)
   (travel-speed      uint8))
  :size-assert 60)

(defconstant MP_MAX_SYNC_PEDESTRIANS 128)
(defconstant MP_MAX_SYNC_VEHICLES 64)

(deftype mp-traffic-sync-buffer (structure)
  ((ped-count   uint32)
   (ped-enemies mp-pedestrian-state MP_MAX_SYNC_PEDESTRIANS :inline)
   (veh-count   uint32)
   (veh-enemies mp-vehicle-state MP_MAX_SYNC_VEHICLES :inline)
   (generation  uint64))
  :size-assert 13352)

(define-perm *mp-traffic-buffer* mp-traffic-sync-buffer (new 'static 'mp-traffic-sync-buffer))

(deftype traffic-record (structure)
  ((net-id                         uint32)
   (entity-kind                    uint8)
   (last-seen                      time-frame)
   (trans                          vector :inline)
   (quat                           quaternion :inline)
   (linvel                         vector :inline)
   (angvel                         vector :inline)
   (hp                             int32)
   (state-id                       uint8)
   (aux-state                      uint8)
   (last-attack-source-player-id   uint8)
   (travel-speed                   uint8)
   (last-attack-id                 uint32)
   (last-local-attack-id           uint32)
   (last-local-attack-time         time-frame)
   (last-correction-time           uint64)
   (last-applied-state-id          uint32)
   (last-state-bump-time           time-frame)))

(defconstant MAX_TRAFFIC_RECORDS 192)

(define-perm *traffic-records* (inline-array traffic-record) (new 'static 'inline-array traffic-record 192))

(define-extern mp-vehicle-player-driving? (function vehicle symbol))
(define-extern get-traffic-record (function uint traffic-record))
(define-extern get-free-traffic-record (function traffic-record))
(define-extern mp-ped-get-state-id (function citizen uint))
(define-extern mp-ped-get-state-from-id (function uint symbol))
(define-extern mp-veh-get-state-id (function vehicle uint))
(define-extern mp-veh-get-state-from-id (function uint symbol))
(define-extern mp-vehicle-promote-local-driver! (function vehicle none))
(define-extern mp-vehicle-seat-reserved-by-remote? (function vehicle int symbol))
(define-extern mp-resolve-local-vehicle-seat-conflict! (function none))
(define-extern mp-ped-predictive-move (function citizen none))
(define-extern mp-pedestrian-terminal-state? (function symbol symbol))
(define-extern mp-vehicle-apply-network-presentation (function vehicle none))
(define-extern mp-race-vehicle-id? (function uint symbol))
(define-extern cleanup-traffic-records (function none))
(define-extern mp-traffic-cleanup-after-sync-exit! (function none))
(define-extern mp-traffic-refill-local-active-cells! (function none))
(define-extern mp-is-traffic-spawn-ready? (function object))
