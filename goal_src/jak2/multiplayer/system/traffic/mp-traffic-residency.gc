;;-*-Lisp-*-
(in-package goal)

(define-extern mp-bootstrap-in-progress? (function symbol))
(define-extern mp-spectate-owns-level-request? (function symbol))
(define-extern get-level-nav-graph-by-id (function int nav-graph))
(define-extern mp-level-active? (function symbol symbol))

(defun mp-traffic-level-resident? ((lev level))
  (if (nonnull? lev (-> lev bsp) (-> lev bsp city-level-info) (-> lev bsp city-level-info nav-graph))
      (or (= (-> lev status) 'loaded) (= (-> lev status) 'alive) (= (-> lev status) 'active))
      #f))

(defun mp-traffic-level-collision-ready? ((lev level))
  (if (nonnull? lev (-> lev bsp) (-> lev bsp collide-hash))
      (or (= (-> lev status) 'active)
          (and *mp-traffic-local-authoritative?*
               (mp-traffic-level-resident? lev)
               (-> lev bsp city-level-info nav-graph patched)))
      #f))

(defun mp-traffic-link-branch! ((graph nav-graph) (link nav-graph-link))
  (when (and (nonnull? graph link) (not (-> link dest-graph)))
    (let ((dest-graph (get-level-nav-graph-by-id (the int (-> link dest-graph-id)))))
      (when (and (nonnull? dest-graph) (-> dest-graph patched))
        (dotimes (idx (-> dest-graph node-count))
          (when (and (nonnull? (-> dest-graph node-array idx))
                     (= (-> link dest-node-id) (-> dest-graph node-array idx id)))
            (set! (-> link dest-graph) dest-graph)
            (set-dst-node (-> graph branch-array (-> link src-branch-id)) (-> dest-graph node-array idx)))))))
  (none))

(defun mp-traffic-link-graph! ((graph nav-graph))
  (when (and (nonnull? graph) (-> graph patched))
    (dotimes (idx (-> graph link-count))
      (mp-traffic-link-branch! graph (-> graph link-array idx))))
  (none))

(defun mp-traffic-unlink-graph! ((graph nav-graph) (unloading nav-graph))
  (when (and (nonnull? graph unloading) (-> graph patched))
    (dotimes (idx (-> graph link-count))
      (let ((link (-> graph link-array idx)))
        (when (and (nonnull? link) (or (= graph unloading) (= (-> link dest-graph) unloading)))
          (set-dst-node (-> graph branch-array (-> link src-branch-id)) (-> link dummy-node))
          (set! (-> link dest-graph) #f)))))
  (none))

(defun mp-traffic-branch-in-level? ((branch nav-branch) (name symbol))
  (if (nonnull? branch)
      (or (if (nonnull? (-> branch src-node)) (= (-> branch src-node level) name) #f)
          (if (nonnull? (-> branch dest-node)) (= (-> branch dest-node level) name) #f))
      #f))

(defun mp-traffic-level-event! ((lev level) (event symbol))
  (when (mp-traffic-level-resident? lev)
    (let ((manager (process-by-type-exact 'traffic-manager *active-pool*)))
      (when (nonnull? manager)
        (send-event manager event lev))))
  (none))

(defun mp-traffic-prefetch-fits? ((name symbol))
  (let ((used-mask 0)
        (info (if name (lookup-level-info name) (the-as level-load-info #f))))
    (when (and name (nonnull? info *level*))
      (when (nonnull? (level-get *level* name))
        (return #t))
      (dotimes (idx (-> *level* length))
        (let ((lev (-> *level* level idx)))
          (when (nonnull? lev)
            (logior! used-mask (-> lev memory-mask)))))
      (case (-> info memory-mode)
        (((load-buffer-mode small-edge))
         (return (or (zero? (logand used-mask #b000011)) (zero? (logand used-mask #b110000)))))
        (((load-buffer-mode small-center))
         (return (zero? (logand used-mask #b001100))))
        (((load-buffer-mode medium))
         (return (or (zero? (logand used-mask #b000111)) (zero? (logand used-mask #b111000)))))
        (((load-buffer-mode large))
         (return (or (zero? (logand used-mask #b001111)) (zero? (logand used-mask #b111100))))))))
  #f)

(defun mp-traffic-prefetch-request! ((state load-state) (name symbol))
  (let ((free-slot -1))
    (when (and name (nonnull? state))
      (dotimes (idx LEVEL_MAX)
        (when (= (-> state want idx name) name)
          (return 0))
        (when (and (< free-slot 0) (not (-> state want idx name)))
          (set! free-slot idx)))
      (when (and (>= free-slot 0) (mp-traffic-prefetch-fits? name))
        (set! (-> state want free-slot name) name)
        (set! (-> state want free-slot display?) #f)
        (set! (-> state want free-slot force-vis?) #f)
        (set! (-> state want free-slot force-inside?) #f)
        (return (ash 1 free-slot))))
    0))

(defun mp-traffic-prefetch-graph! ((state load-state) (graph nav-graph))
  (let ((request-mask 0))
    (when (and (nonnull? state graph) (-> graph patched))
      (dotimes (idx (-> graph link-count))
        (let ((node (-> graph link-array idx dummy-node)))
          (when (and (nonnull? node)
                     (mp-any-player-near-pos-xz? (-> node position) (meters 200.0)))
            (logior! request-mask (mp-traffic-prefetch-request! state (-> node level)))))))
    request-mask))

(defun mp-traffic-prefetch-levels! ((state load-state))
  (let ((request-mask 0))
    (when (and *mp-traffic-local-authoritative?* (nonnull? state *level*)
               (not (mp-bootstrap-in-progress?)) (not (mp-spectate-owns-level-request?)))
      (dotimes (idx LEVEL_MAX)
        (when (and (-> state want idx name) (not (mp-level-active? (-> state want idx name))))
          (return 0)))
      (dotimes (idx (-> *level* length))
        (let ((lev (-> *level* level idx)))
          (when (mp-traffic-level-resident? lev)
            (logior! request-mask (mp-traffic-prefetch-graph! state (-> lev bsp city-level-info nav-graph)))))))
    request-mask))

(defun mp-traffic-clear-prefetch-requests! ((state load-state) (request-mask int))
  (when (nonnull? state)
    (dotimes (idx LEVEL_MAX)
      (when (and (logtest? request-mask (ash 1 idx)) (not (-> state want idx display?)))
        (set! (-> state want idx name) #f))))
  (none))
