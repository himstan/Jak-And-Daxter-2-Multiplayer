;;-*-Lisp-*-
(in-package goal)

(define-extern set-guard-target (function citizen handle none))

(defun is-record-in-pausable-state? ((rec traffic-record))
  (let ((state-name (if (and rec (-> rec state-id)) (mp-target-get-state-from-id (-> rec state-id)) #f)))
    (is-in-pausable-state? state-name)))

(defun should-pause-sync? ((e enemy) (rec traffic-record))
  (or (logtest? (-> e enemy-flags) (enemy-flag stop-syncing))
      (is-enemy-in-pausable-state? e)
      (is-record-in-pausable-state? rec)))

(defun mp-pedestrian-terminal-state? ((target-sym symbol))
  (or (= target-sym 'knocked)
      (= target-sym 'knocked-off-vehicle)
      (= target-sym 'die)
      (= target-sym 'die-falling)
      (= target-sym 'die-fast)))

(defun mp-pedestrian-riding-vehicle? ((ped citizen))
  (when (and ped (nonzero? ped) (type? ped civilian))
    (let ((veh (the-as vehicle (handle->process-safe (-> (the-as civilian ped) vehicle)))))
      (when (and veh (nonzero? veh) (-> veh info) (nonzero? (-> veh info)))
        (dotimes (seat-idx (-> veh info seat-count))
          (when (= (get-rider-in-seat veh seat-idx) ped)
            (return #t))))))
  #f)

(defun mp-pedestrian-playback! ((ped citizen) (rec traffic-record))
  (when (nonnull? ped rec (-> ped root))
    (mp-actor-apply-presentation! (-> ped root) (-> rec trans) (-> rec quat) (-> rec linvel)))
  (none))

(defun mp-ped-predictive-move ((ped citizen))
  (when (and ped (nonzero? ped))
    (let ((net-id (-> ped net-id)))
      (when (and (nonzero? net-id) (-> ped root) (nonzero? (-> ped root)))
        (let ((rec (get-traffic-record net-id)))
          (when (and rec (nonzero? rec))
            (when (and (not (mp-pedestrian-riding-vehicle? ped)) (not (should-pause-sync? ped rec)))
              (mp-pedestrian-playback! ped rec)))))))
  (none))

(defun mp-pedestrian-death-started? ((e-proc citizen))
  (and e-proc
       (nonzero? e-proc)
       (or (and (-> e-proc state) (nonzero? (-> e-proc state)) (mp-pedestrian-terminal-state? (-> e-proc state name)))
           (logtest? (-> e-proc enemy-flags) (enemy-flag death-start)))))

(defun mp-pedestrian-state-current-or-pending? ((this citizen) (target-sym symbol))
  (or (and (-> this state) (= (-> this state name) target-sym))
      (and (-> this next-state) (= (-> this next-state name) target-sym))))

(defun mp-pedestrian-state-retry-ready? ((rec traffic-record))
  (mp-actor-state-retry-ready? (-> rec last-state-bump-time)))

(defun pedestrian-replica-locked? ((this citizen))
  (and (not *mp-traffic-local-authoritative?*) (nonzero? (-> this net-id)) (get-traffic-record (-> this net-id))))

(defun mp-pedestrian-authorize-remote-trans! ((rec traffic-record) (target-state-id uint))
  (set! (-> rec authorized-trans-state-id) (the-as uint32 target-state-id))
  (set! (-> rec authorized-trans-frame) (current-time))
  (none))

(defun mp-pedestrian-lock-local-state-manager! ((this citizen) (rec traffic-record))
  (when (and rec (pedestrian-replica-locked? this))
    (set! (-> this trans-hook) #f))
  (none))

(defun mp-pedestrian-prepare-wait-state! ((this citizen))
  (let ((active-st (method-state (-> this type) (the-as basic 'active))))
    (when (and active-st (nonzero? active-st))
      (set! (-> this wait-return-state) (the-as (state citizen) active-st))
      (set! (-> this wait-time) (the-as time-frame (rnd-int-range this 300 1500)))))
  (none))

(defun mp-pedestrian-enter-remote-state! ((this citizen)
                                          (rec traffic-record)
                                          (target-state-id uint)
                                          (target-sym symbol))
  (let ((st (method-state (-> this type) (the-as basic target-sym))))
    (when (and st (nonzero? st))
      (when (= target-sym 'wait)
        (mp-pedestrian-prepare-wait-state! this))
      (mp-pedestrian-authorize-remote-trans! rec target-state-id)
      (set! (-> this next-state) (the-as state st))
      (enter-state (the-as object st)
                   (the-as object #f)
                   (the-as object #f)
                   (the-as object #f)
                   (the-as object #f)
                   (the-as object #f))
      (mp-pedestrian-lock-local-state-manager! this rec)
      (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
      (set! (-> rec last-state-bump-time) (current-time))))
  (none))

(defun mp-pedestrian-schedule-remote-state! ((this citizen)
                                             (rec traffic-record)
                                             (target-state-id uint)
                                             (target-sym symbol))
  (when (and this (nonzero? this) rec (-> this main-thread) (nonzero? (-> this main-thread)))
    (let ((st (method-state (-> this type) (the-as basic target-sym))))
      (when (and st (nonzero? st))
        (when (= target-sym 'wait)
          (mp-pedestrian-prepare-wait-state! this))
        (mp-pedestrian-authorize-remote-trans! rec target-state-id)
        (set! (-> this next-state) (the-as state st))
        (process-mask-clear! (-> this mask) sleep sleep-code)
        (set-to-run (-> this main-thread)
                    enter-state
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f))
        (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
        (set! (-> rec last-state-bump-time) (current-time)))))
  (none))

(defun mp-pedestrian-sync-remote-state! ((this citizen) (rec traffic-record))
  (let ((target-state-id (the uint (-> rec state-id))))
    (when (nonzero? target-state-id)
      (let ((target-sym (mp-ped-get-state-from-id target-state-id)))
        (when (and target-sym
                   (or (not (mp-pedestrian-death-started? this)) (mp-pedestrian-terminal-state? target-sym))
                   (not (is-in-pausable-state? target-sym)))
          (if (mp-pedestrian-state-current-or-pending? this target-sym)
            (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
            (when (or (!= (the-as uint32 target-state-id) (-> rec last-applied-state-id))
                      (mp-pedestrian-state-retry-ready? rec))
              (mp-pedestrian-enter-remote-state! this rec target-state-id target-sym)))))))
  (none))

(defun mp-pedestrian-sync-remote-state-deferred! ((this citizen) (rec traffic-record))
  (let ((target-state-id (the uint (-> rec state-id))))
    (when (nonzero? target-state-id)
      (let ((target-sym (mp-ped-get-state-from-id target-state-id)))
        (when (and target-sym (or (not (mp-pedestrian-death-started? this)) (mp-pedestrian-terminal-state? target-sym)))
          (if (mp-pedestrian-state-current-or-pending? this target-sym)
            (set! (-> rec last-applied-state-id) (the-as uint32 target-state-id))
            (when (or (!= (the-as uint32 target-state-id) (-> rec last-applied-state-id))
                      (mp-pedestrian-state-retry-ready? rec))
              (mp-pedestrian-schedule-remote-state! this rec target-state-id target-sym)))))))
  (none))

(defun get-pedestrian-record-focus-proc ((rec traffic-record))
  (when (and rec (nonzero? rec) (mp-player-id-valid? (the-as uint (-> rec aux-state))))
    (return (the-as process-focusable (mp-player-target-by-id (the-as uint (-> rec aux-state))))))
  (the-as process-focusable #f))

(defun mp-pedestrian-sync-guard-target! ((this citizen) (rec traffic-record))
  (when (mp-player-id-valid? (the-as uint (-> rec aux-state)))
    (let ((focus-proc (get-pedestrian-record-focus-proc rec)))
      (when (and focus-proc (nonzero? focus-proc))
        (set-guard-target this (process->handle focus-proc)))))
  (none))

(defun pedestrian-run-replica-sync! ((this citizen) (rec traffic-record))
  (when (nonnull? this rec)
    (let ((old-hp (the int32 (-> this hit-points)))
          (new-hp (-> rec hp)))
      (when (and (> new-hp 0)
                 (not (mp-enemy-death-presentation-active? this))
                 (or (not (or (is-enemy-in-pausable-state? this) (mp-actor-in-hit-reaction? this))) (< new-hp old-hp)))
        (when (!= old-hp new-hp)
          (set! (-> this hit-points) new-hp))))
    (when (nonzero? (-> this net-id))
      (when (and (not (mp-pedestrian-death-started? this)) (not (should-pause-sync? this rec)))
        (mp-pedestrian-sync-remote-state! this rec)
        (mp-pedestrian-sync-guard-target! this rec)
        (mp-pedestrian-lock-local-state-manager! this rec))
      (mp-ped-predictive-move this)))
  (none))

(defun mp-pedestrian-run-common-post-pre! ((this citizen))
  (when (and this (nonzero? this) (not *mp-traffic-local-authoritative?*) (nonzero? (-> this net-id)))
    (let ((rec (get-traffic-record (-> this net-id))))
      (when rec
        (when (not (should-pause-sync? this rec))
          (mp-pedestrian-sync-guard-target! this rec)
          (mp-pedestrian-lock-local-state-manager! this rec)))))
  (none))

(defun mp-pedestrian-run-common-post-post! ((this citizen))
  (when (and (nonnull? this) (not *mp-traffic-local-authoritative?*) (nonzero? (-> this net-id)))
    (let ((rec (get-traffic-record (-> this net-id))))
      (when (nonnull? rec)
        (pedestrian-run-replica-sync! this rec))))
  (none))

(defun mp-pedestrian-external-sync-needed? ()
  (and *target* (nonzero? *target*) (focus-test? *target* pilot) (-> *target* pilot) (nonzero? (-> *target* pilot))))

(defun mp-pedestrian-run-external-post-sync! ((this citizen))
  (when (and this
             (nonzero? this)
             (not (type? this crimson-guard))
             (not (focus-test? this inactive))
             (not (logtest? (-> this mask) (process-mask sleep)))
             (!= (-> this status) 'dead)
             (nonzero? (-> this net-id))
             (nonzero? (-> this controller branch)))
    (let ((rec (get-traffic-record (-> this net-id))))
      (when (and rec (-> this root) (nonzero? (-> this root)))
        (when (not (should-pause-sync? this rec))
          (mp-pedestrian-sync-remote-state-deferred! this rec))
        (mp-ped-predictive-move this)
        (when (type? (-> this root) collide-shape)
          (update-transforms (-> this root))))))
  (none))

(defun mp-pedestrian-run-external-sync-pass ()
  (when (and (not *mp-traffic-local-authoritative?*) (mp-pedestrian-external-sync-needed?))
    (dotimes (i (the int MP_MAX_SYNC_PEDESTRIANS))
      (let ((slot (-> *mp-traffic-buffer* ped-enemies i)))
        (when (nonzero? (-> slot net-id))
          (let ((proc (mp-pedestrian-find-by-net-id (-> slot net-id))))
            (when (and proc (nonzero? proc))
              (mp-pedestrian-run-external-post-sync! proc)))))))
  (none))

(defun mp-pedestrian-handle-event! ((this citizen) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  arg1
  (case arg2
    (('event-death)
     (when (and this (nonzero? this) (zero? (-> this hit-points)))
       (do-effect (-> this skel effect) 'death-default 0.0 -1))
     #f)
    (('traffic-off 'traffic-off-force)
     (when (and this (nonzero? this) (not (mp-pedestrian-death-started? this)))
       (set! (-> this net-id) (the uint 0))
       (deactivate this))
     'handled)
    (else #f)))
