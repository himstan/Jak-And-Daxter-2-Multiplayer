;;-*-Lisp-*-
(in-package goal)

(defun get-pedestrian-travel-speed ((ped citizen))
  (when (nonnull? ped)
    (when (and (not *mp-traffic-local-authoritative?*) (nonzero? (-> ped net-id)))
      (let ((record (get-traffic-record (-> ped net-id))))
        (when (nonnull? record)
          (return (* (the float (-> record travel-speed)) PEDESTRIAN_TRAVEL_SPEED_RESOLUTION)))))
    (when (nonnull? (-> ped nav) (-> ped nav state))
      (return (-> ped nav state speed))))
  0.0)

(defun get-pedestrian-animation-choice ((ped citizen) (salt uint) (count int))
  (if (nonnull? ped)
    (if (zero? (-> ped net-id))
      (rnd-int-count ped count)
      (let* ((seed (logxor (logxor (-> ped net-id) (the uint (-> ped traffic-type))) salt))
             (choice (logand (shr (+ (* seed 1103515245) 12345) 16) #x7fff)))
        (mod (the-as int choice) count)))
    0))

(defun get-pedestrian-wait-animation-speed ((ped citizen))
  (let ((choice (get-pedestrian-animation-choice ped PEDESTRIAN_WAIT_SPEED_SEED 32768)))
    (/ 1.0 (+ 10.0 (* 3.0 (/ (the float choice) 32768.0))))))
