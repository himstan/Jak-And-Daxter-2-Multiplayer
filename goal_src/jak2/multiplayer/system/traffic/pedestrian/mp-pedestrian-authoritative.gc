;;-*-Lisp-*-
(in-package goal)

;; --- Pedestrian State ID Mapping ---


;; --- Pedestrian Packing (Authoritative Side) ---

(defun mp-pedestrian-apply-remote-attack! ((evt mp-actor-attack-event))
  "Apply a client-requested pedestrian hit on the traffic authority."
  (let ((e-proc (mp-pedestrian-find-by-net-id (-> evt net-id))))
    (when (and e-proc (nonzero? e-proc))
      (let ((rec (mp-get-traffic-ghost (-> evt net-id))))
        (when (and rec
                   (nonzero? (-> evt attack-id))
                   (= (-> evt attack-id) (-> rec last-attack-id)))
          (debug-log *mp-debug-log?* "[MP-Traffic] Blocking duplicate remote attack ID ~D on nid=~D~%" (-> evt attack-id) (-> evt net-id))
          (return #f)
          )
        (let ((attacker (mp-player-target-by-id (-> evt source-player-id))))
          (when (and attacker (nonzero? attacker))
            (when (not (mp-actor-apply-authoritative-remote-damage! (the-as enemy e-proc) attacker evt 'pedestrian))
              (return #f)
              )
            (when (and rec (nonzero? (-> evt attack-id)))
              (set! (-> rec last-attack-id) (-> evt attack-id))
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-target-player-id-from-process ((focus process))
  "Return the focused player's canonical ID, or the compact invalid sentinel."
  (when (and focus (nonzero? focus))
    (let ((player-id (mp-player-id-from-process focus)))
      (when (mp-player-id-valid? player-id)
        (return (the-as uint8 player-id))))
    )
  MP_INVALID_COMPACT_PLAYER_ID
  )

(defun mp-pedestrian-guard-target-player-id ((e-proc citizen))
  "Read a pedestrian guard's synced player target from guard combat state."
  (let ((target-handle (if *mp-get-guard-target*
                           (*mp-get-guard-target* e-proc)
                           (if (and (-> e-proc focus) (nonzero? (-> e-proc focus)))
                               (-> e-proc focus handle)
                               (the-as handle #f))
                           )))
    (mp-pedestrian-target-player-id-from-process (handle->process-safe target-handle))
    )
  )

(defun mp-pedestrian-debug-pack-guard-target! ((e-proc citizen) (slot mp-pedestrian-state) (target-handle handle))
  (when (mp-guard-target-debug-ready? (-> slot net-id))
    (debug-log *mp-debug-log?*
            "[MP-GuardTarget] nid=~D phase=pack state=~S aid=~D src=~S src-type=~S "
            (-> slot net-id)
            (mp-ped-get-state-from-id (the uint (-> slot state-id)))
            (-> slot target-player-id)
            (mp-guard-target-debug-handle-label target-handle)
            (mp-guard-target-debug-handle-type target-handle)
            )
    (let ((focus-handle (the-as handle #f)))
      (if (and (-> e-proc focus) (nonzero? (-> e-proc focus)))
          (set! focus-handle (-> e-proc focus handle))
          )
      (debug-log *mp-debug-log?*
              "focus=~S focus-type=~S traffic=~S traffic-type=~S lock=~D~%"
              (mp-guard-target-debug-handle-label focus-handle)
              (mp-guard-target-debug-handle-type focus-handle)
              (mp-guard-target-debug-handle-label target-handle)
              (mp-guard-target-debug-handle-type target-handle)
              0
              )
      )
    (mp-guard-target-debug-bump!)
    )
  (none)
  )

(defun mp-pedestrian-clear-vehicle-context! ((slot mp-pedestrian-state))
  (when (and slot (nonzero? slot))
    (set! (-> slot vehicle-net-id) (the uint32 0))
    (set! (-> slot transport-id) (the uint32 0))
    (set! (-> slot transport-side) (the uint8 0))
    )
  (none)
  )

(defun mp-pedestrian-pack-state-uses-vehicle-context? ((state-id uint))
  (or (= state-id (the uint (mp-ped-state-id board-vehicle)))
      (= state-id (the uint (mp-ped-state-id ride)))
      (= state-id (the uint (mp-ped-state-id exit-vehicle))))
  )

(defun mp-pedestrian-pack-vehicle-context! ((e-proc citizen) (slot mp-pedestrian-state))
  "Encode civilian vehicle/seat context into spare pad bytes for ride-state sync."
  (mp-pedestrian-clear-vehicle-context! slot)
  (when (and e-proc
             (nonzero? e-proc)
             slot
             (nonzero? slot)
             (mp-pedestrian-pack-state-uses-vehicle-context? (the uint (-> slot state-id)))
             (type? e-proc civilian)
             (not (type? e-proc crimson-guard)))
    (let ((civilian-proc (the-as civilian e-proc)))
      (let ((vehicle-proc (the-as vehicle (handle->process-safe (-> civilian-proc vehicle)))))
        (when (and vehicle-proc
                   (nonzero? vehicle-proc)
                   (type? vehicle-proc vehicle)
                   (nonzero? (-> vehicle-proc net-id)))
          (let ((vehicle-net-id (-> vehicle-proc net-id)))
            (set! (-> slot vehicle-net-id) vehicle-net-id)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-pack-transport-context! ((e-proc citizen) (slot mp-pedestrian-state))
  "Encode transport-spawned guard context."
  (when (and e-proc
             (nonzero? e-proc)
             slot
             (nonzero? slot)
             (type? e-proc crimson-guard))
    (let ((transport-id (mp-crimson-guard-transport-id e-proc)))
      (when (nonzero? transport-id)
        (mp-pedestrian-set-transport-id! slot transport-id)
        (mp-pedestrian-set-transport-side! slot (mp-crimson-guard-transport-side e-proc))
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-refresh-authoritative-ghost! ((e-proc citizen))
  "Keep a host-side traffic ghost record available."
  (when (and e-proc
             (nonzero? e-proc)
             (mp-is-traffic-authoritative?)
             (nonzero? (-> e-proc net-id)))
    (let ((rec (mp-traffic-get-or-create-ghost! (-> e-proc net-id) (the uint 0))))
      (when rec
        (set! (-> rec last-seen) (current-time))
        )
      )
    )
  (none)
  )

(defun mp-pedestrian-pack ((e-proc citizen) (slot mp-pedestrian-state))
  (set! (-> slot net-id) (-> e-proc net-id))
  (mp-pedestrian-refresh-authoritative-ghost! e-proc)
  (set! (-> slot object-type) (the uint8 (-> e-proc traffic-type)))
  (set! (-> slot object-variance) (the uint8 0))
  (set! (-> slot animation-profile) (mp-pedestrian-get-animation-profile e-proc))
  (set! (-> slot x) (-> e-proc root trans x))
  (set! (-> slot y) (-> e-proc root trans y))
  (set! (-> slot z) (-> e-proc root trans z))
  (set! (-> slot quat-x) (-> e-proc root quat x))
  (set! (-> slot quat-y) (-> e-proc root quat y))
  (set! (-> slot quat-z) (-> e-proc root quat z))
  (set! (-> slot quat-w) (-> e-proc root quat w))

  ;; State-based sync: send numeric state ID instead of raw animation data
  (set! (-> slot state-id) (the uint8 (mp-ped-get-state-id e-proc)))

  (set! (-> slot hp) (the int32 (-> e-proc hit-points)))

  (let ((flags (the uint 0)))
    (when (logtest? (-> e-proc focus-status) (focus-status dead))
      (set! flags (logior flags (the uint (mp-pedestrian-flags dead))))
      )
    (when (and (type? e-proc crimson-guard)
               (logtest? (-> e-proc flags) (citizen-flag dark-guard)))
      (set! flags (logior flags (the uint (mp-pedestrian-flags dark-guard))))
      )
    (set! (-> slot flags) (the-as mp-pedestrian-flags flags))
    )

  ;; Sync target for Crimson Guards
  (let ((target-handle (if *mp-get-guard-target*
                           (*mp-get-guard-target* e-proc)
                           (if (and (-> e-proc focus) (nonzero? (-> e-proc focus)))
                               (-> e-proc focus handle)
                               (the-as handle #f))
                           )))
    (set! (-> slot target-player-id) (mp-pedestrian-target-player-id-from-process (handle->process-safe target-handle)))
    (mp-pedestrian-debug-pack-guard-target! e-proc slot target-handle)
    )

  (mp-pedestrian-pack-vehicle-context! e-proc slot)
  (mp-pedestrian-pack-transport-context! e-proc slot)

  (none)
  )
