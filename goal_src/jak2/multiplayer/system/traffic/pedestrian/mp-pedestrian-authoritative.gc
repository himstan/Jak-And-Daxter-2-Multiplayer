;;-*-Lisp-*-
(in-package goal)

(define-extern get-guard-target (function citizen handle))

(defun mp-pedestrian-remote-attack-duplicate? ((rec traffic-record) (evt mp-actor-attack-event))
  (and rec
       (nonzero? rec)
       (nonnull? evt)
       (nonzero? (-> evt payload attack-id))
       (= (-> evt payload attack-id) (-> rec last-attack-id))
       (= (-> evt source-player-id) (the uint (-> rec last-attack-source-player-id)))))

(defun mp-pedestrian-note-remote-attack! ((rec traffic-record) (evt mp-actor-attack-event))
  (when (and rec (nonzero? rec) (nonnull? evt) (nonzero? (-> evt payload attack-id)))
    (set! (-> rec last-attack-id) (-> evt payload attack-id))
    (set! (-> rec last-attack-source-player-id) (the-as uint8 (-> evt source-player-id))))
  (none))

(defun mp-pedestrian-apply-remote-attack! ((evt mp-actor-attack-event))
  (when (not (nonnull? evt))
    (return #f))
  (let ((e-proc (mp-pedestrian-find-by-net-id (-> evt payload net-id))))
    (when (and e-proc (nonzero? e-proc))
      (let ((rec (get-traffic-record (-> evt payload net-id))))
        (when (mp-pedestrian-remote-attack-duplicate? rec evt)
          (log 'debug
               "[MP-Traffic] Blocking duplicate remote attack ID ~D on nid=~D~%"
               (-> evt payload attack-id)
               (-> evt payload net-id))
          (return #f))
        (let ((attacker (mp-player-target-by-id (-> evt source-player-id))))
          (when (and attacker (nonzero? attacker))
            (when (not (mp-actor-apply-authoritative-remote-damage! (the-as enemy e-proc) attacker evt 'pedestrian))
              (return #f))
            (mp-pedestrian-note-remote-attack! rec evt))))))
  (none))

(defun mp-pedestrian-replay-remote-attack! ((evt mp-actor-attack-event))
  (when (not (nonnull? evt))
    (return #f))
  (let ((e-proc (mp-pedestrian-find-by-net-id (-> evt payload net-id))))
    (when (and e-proc (nonzero? e-proc))
      (let ((rec (get-traffic-record (-> evt payload net-id))))
        (when (mp-pedestrian-remote-attack-duplicate? rec evt)
          (return #f))
        (let ((attacker (mp-player-target-by-id (-> evt source-player-id))))
          (when (and attacker
                     (nonzero? attacker)
                     (mp-actor-apply-authoritative-remote-damage! (the-as enemy e-proc) attacker evt 'pedestrian))
            (mp-pedestrian-note-remote-attack! rec evt)
            (return #t))))))
  #f)

(defun mp-pedestrian-target-player-id-from-process ((focus process))
  (when (and focus (nonzero? focus))
    (let ((player-id (mp-player-id-from-process focus)))
      (when (mp-player-id-valid? player-id)
        (return (the-as uint8 player-id)))))
  MP_INVALID_PLAYER_ID)

(defun mp-pedestrian-clear-vehicle-context! ((slot mp-pedestrian-state))
  (when (and slot (nonzero? slot))
    (set! (-> slot vehicle-net-id) (the uint32 0))
    (set! (-> slot transport-id) (the uint32 0))
    (set! (-> slot transport-side) (the uint8 0)))
  (none))

(defun mp-pedestrian-pack-state-uses-vehicle-context? ((state-id uint))
  (or (= state-id (the uint (mp-ped-state-id board-vehicle)))
      (= state-id (the uint (mp-ped-state-id ride)))
      (= state-id (the uint (mp-ped-state-id exit-vehicle)))))

(defun mp-pedestrian-pack-vehicle-context! ((e-proc citizen) (slot mp-pedestrian-state))
  (mp-pedestrian-clear-vehicle-context! slot)
  (when (and e-proc
             (nonzero? e-proc)
             slot
             (nonzero? slot)
             (mp-pedestrian-pack-state-uses-vehicle-context? (the uint (-> slot state-id)))
             (type? e-proc civilian)
             (not (type? e-proc crimson-guard)))
    (let ((civilian-proc (the-as civilian e-proc)))
      (let ((vehicle-proc (the-as vehicle (handle->process-safe (-> civilian-proc vehicle)))))
        (when (and vehicle-proc
                   (nonzero? vehicle-proc)
                   (type? vehicle-proc vehicle)
                   (nonzero? (-> vehicle-proc net-id)))
          (let ((vehicle-net-id (-> vehicle-proc net-id))) (set! (-> slot vehicle-net-id) vehicle-net-id))))))
  (none))

(defun mp-pedestrian-pack-transport-context! ((e-proc citizen) (slot mp-pedestrian-state))
  (when (and e-proc (nonzero? e-proc) slot (nonzero? slot) (type? e-proc crimson-guard))
    (let ((transport-id (mp-crimson-guard-transport-id e-proc)))
      (when (nonzero? transport-id)
        (mp-pedestrian-set-transport-id! slot transport-id)
        (mp-pedestrian-set-transport-side! slot (mp-crimson-guard-transport-side e-proc)))))
  (none))

(defun pedestrian-refresh-authoritative-record! ((e-proc citizen))
  (when (and e-proc (nonzero? e-proc) *mp-traffic-local-authoritative?* (nonzero? (-> e-proc net-id)))
    (let ((rec (get-or-create-traffic-record! (-> e-proc net-id) (the uint 0))))
      (when rec
        (set! (-> rec last-seen) (current-time)))))
  (none))

(defun mp-pedestrian-pack ((e-proc citizen) (slot mp-pedestrian-state))
  (set! (-> slot net-id) (-> e-proc net-id))
  (when (and e-proc (nonzero? e-proc) slot (nonzero? slot))
    (set! (-> slot level-id) (the uint16 (mp-traffic-level-id-for-process e-proc))))
  (pedestrian-refresh-authoritative-record! e-proc)
  (set! (-> slot object-type) (the uint8 (-> e-proc traffic-type)))
  (set! (-> slot appearance-mask) (the uint32 (pedestrian-pack-appearance! e-proc)))
  (set! (-> slot animation-profile) (mp-pedestrian-get-animation-profile e-proc))
  (set! (-> slot x) (-> e-proc root trans x))
  (set! (-> slot y) (-> e-proc root trans y))
  (set! (-> slot z) (-> e-proc root trans z))
  (set! (-> slot quat-x) (-> e-proc root quat x))
  (set! (-> slot quat-y) (-> e-proc root quat y))
  (set! (-> slot quat-z) (-> e-proc root quat z))
  (set! (-> slot quat-w) (-> e-proc root quat w))
  (set! (-> slot state-id) (the uint8 (mp-ped-get-state-id e-proc)))
  (set! (-> slot hp) (the int32 (-> e-proc hit-points)))
  (let ((flags (the uint 0)))
    (when (logtest? (-> e-proc focus-status) (focus-status dead))
      (set! flags (logior flags (the uint (mp-pedestrian-flags dead)))))
    (when (and (type? e-proc crimson-guard) (logtest? (-> e-proc flags) (citizen-flag dark-guard)))
      (set! flags (logior flags (the uint (mp-pedestrian-flags dark-guard)))))
    (set! (-> slot flags) (the-as mp-pedestrian-flags flags)))
  (set! (-> slot target-player-id)
        (mp-pedestrian-target-player-id-from-process (handle->process-safe (get-guard-target e-proc))))
  (mp-pedestrian-pack-vehicle-context! e-proc slot)
  (mp-pedestrian-pack-transport-context! e-proc slot)
  (none))
