;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-authoritative-traffic-ghost-cleanup-time* time-frame 0)
(define-perm *mp-traffic-ghost-allocation-failure-log-time* time-frame 0)

(defun mp-traffic-ghost-used-count ()
  "Count allocated records in the shared traffic ghost registry."
  (let ((used-count (the int 0)))
    (dotimes (i MP_MAX_TRAFFIC_GHOST_RECORDS)
      (let ((rec (-> *mp-traffic-ghosts* i)))
        (when (and rec
                   (nonzero? rec)
                   (nonzero? (-> rec net-id)))
          (+! used-count 1)
          )
        )
      )
    used-count
    )
  )

(defun mp-release-traffic-ghost! ((rec mp-traffic-ghost-record))
  "Release a traffic ghost slot and reset state that must not survive reuse."
  (when (and rec (nonzero? rec))
    (set! (-> rec net-id) (the uint32 0))
    (set! (-> rec entity-kind) (the uint8 0))
    (set! (-> rec last-seen) 0)
    (set! (-> rec ghost-hp) (the int32 0))
    (set! (-> rec ghost-state-id) (the uint8 0))
    (set! (-> rec ghost-aux-state) MP_INVALID_COMPACT_PLAYER_ID)
    (set! (-> rec presentation-valid) (the uint8 0))
    (set! (-> rec last-attack-source-player-id) MP_INVALID_COMPACT_PLAYER_ID)
    (set! (-> rec ghost-animation-profile) (the uint32 0))
    (set! (-> rec last-applied-animation-profile) (the uint32 0))
    (set! (-> rec last-attack-id) (the uint32 0))
    (set! (-> rec last-local-attack-id) (the uint32 0))
    (set! (-> rec last-local-attack-time) 0)
    (set! (-> rec last-correction-time) (the uint64 0))
    (set! (-> rec last-applied-state-id) (the uint32 0))
    (set! (-> rec last-state-bump-time) 0)
    (set! (-> rec authorized-trans-state-id) (the uint32 0))
    (set! (-> rec authorized-trans-frame) 0)
    )
  (none)
  )

(defun mp-get-traffic-ghost ((net-id uint))
  "Find an existing ghost record by net-id. Returns #f if not found."
  (dotimes (i MP_MAX_TRAFFIC_GHOST_RECORDS)
    (let ((rec (-> *mp-traffic-ghosts* i)))
      (when (= (-> rec net-id) net-id)
        (return rec)
        )
      )
    )
  (the-as mp-traffic-ghost-record #f)
  )

(defun mp-get-free-traffic-ghost ()
  "Find an empty ghost record slot. Returns #f if array is full."
  (dotimes (i MP_MAX_TRAFFIC_GHOST_RECORDS)
    (let ((rec (-> *mp-traffic-ghosts* i)))
      (when (zero? (-> rec net-id))
        (return rec)
        )
      )
    )
  (the-as mp-traffic-ghost-record #f)
  )

(defun mp-traffic-get-or-create-ghost! ((net-id uint) (entity-kind uint))
  "Find or allocate a traffic ghost record for sync bookkeeping."
  (let ((rec (the-as mp-traffic-ghost-record #f)))
    (when (nonzero? net-id)
      (set! rec (mp-get-traffic-ghost net-id))
      (when (not rec)
        (set! rec (mp-get-free-traffic-ghost))
        (if (and rec (nonzero? rec))
            (begin
              (mp-release-traffic-ghost! rec)
              (set! (-> rec net-id) net-id)
              )
            (when (time-elapsed? *mp-traffic-ghost-allocation-failure-log-time* (seconds 1))
              (debug-log *mp-debug-log?*
                      "[MP-TrafficGhost] Allocation failed nid=~D kind=~D used=~D/~D~%"
                      net-id
                      entity-kind
                      (mp-traffic-ghost-used-count)
                      MP_MAX_TRAFFIC_GHOST_RECORDS)
              (set! *mp-traffic-ghost-allocation-failure-log-time* (current-time))
              )
          )
        )
      (when (and rec (nonzero? rec))
        (set! (-> rec entity-kind) (the-as uint8 entity-kind))
        )
      )
    rec
    )
  )

(defun mp-authoritative-pedestrian-ghost-missing? ((rec mp-traffic-ghost-record))
  "Return true when a pedestrian ghost no longer has a corresponding process."
  (when (or (not rec)
            (not (nonzero? rec))
            (!= (-> rec entity-kind) (the uint8 0)))
    (return #f)
    )
  (let ((ped-proc (mp-pedestrian-find-by-net-id (-> rec net-id))))
    (or (not ped-proc)
        (not (nonzero? ped-proc)))
    )
  )

(defun mp-cleanup-authoritative-traffic-ghosts! ()
  "Reclaim stale and missing pedestrian records on the traffic authority."
  (when (and (mp-is-traffic-authoritative?)
             (time-elapsed? *mp-authoritative-traffic-ghost-cleanup-time* (seconds 1)))
    (let ((stale-count (the int 0))
          (missing-ped-count (the int 0)))
      (dotimes (i MP_MAX_TRAFFIC_GHOST_RECORDS)
        (let ((rec (-> *mp-traffic-ghosts* i)))
          (when (and rec
                     (nonzero? rec)
                     (nonzero? (-> rec net-id)))
            (cond
              ((time-elapsed? (-> rec last-seen) (seconds 10))
               (+! stale-count 1)
               (mp-release-traffic-ghost! rec)
               )
              ((mp-authoritative-pedestrian-ghost-missing? rec)
               (+! missing-ped-count 1)
               (mp-release-traffic-ghost! rec)
               )
              )
            )
          )
        )
      (when (or (nonzero? stale-count)
                (nonzero? missing-ped-count))
        (debug-log *mp-debug-log?*
                "[MP-TrafficGhost] Authority cleanup stale=~D missing-ped=~D used=~D/~D~%"
                stale-count
                missing-ped-count
                (mp-traffic-ghost-used-count)
                MP_MAX_TRAFFIC_GHOST_RECORDS)
        )
      )
    (set! *mp-authoritative-traffic-ghost-cleanup-time* (current-time))
    )
  (none)
  )

(defun mp-cleanup-traffic-ghosts ()
  "Clear ghost records not updated in the last 10 seconds."
  (dotimes (i MP_MAX_TRAFFIC_GHOST_RECORDS)
    (let ((rec (-> *mp-traffic-ghosts* i)))
      (when (and (nonzero? (-> rec net-id))
                 (time-elapsed? (-> rec last-seen) (seconds 10)))
        (debug-log *mp-debug-log?*
                "[MP-TrafficGhost] Cleaning up stale nid=~D after 10 seconds.~%"
                (-> rec net-id))
        (mp-release-traffic-ghost! rec)
        )
      )
    )
  (none)
  )
