;;-*-Lisp-*-
(in-package goal)

(defconstant VEHICLE_HORN_BIKE 0)

(defconstant VEHICLE_HORN_CAR 1)

(defconstant VEHICLE_HORN_HELLCAT 2)

(defconstant VEHICLE_HORN_FUNNY 3)

(defconstant VEHICLE_HORN_FUNNY_COUNT 2)

(defconstant VEHICLE_HORN_FUNNY_PERCENT 1)

(define *vehicle-horns*
  (new 'static 'boxed-array :type custom-spatial-audio-entry
    (new 'static 'custom-spatial-audio-entry :key "bike-horn" :path "jad2mp/bike-horn.wav" :group (sound-group sfx))
    (new 'static 'custom-spatial-audio-entry :key "car-horn" :path "jad2mp/car-horn.wav" :group (sound-group sfx))
    (new 'static 'custom-spatial-audio-entry :key "big-car-horn" :path "jad2mp/big-car-horn.wav" :group (sound-group sfx))
    (new 'static 'custom-spatial-audio-entry :key "duck-car-horn" :path "jad2mp/duck-car-horn.wav" :group (sound-group sfx))
    (new 'static 'custom-spatial-audio-entry :key "goofy-car-horn" :path "jad2mp/goofy-car-horn.wav" :group (sound-group sfx))))

(dotimes (horn (-> *vehicle-horns* length))
  (register-custom-spatial-audio! (-> *vehicle-horns* horn)))

(define *funny-horn-second* -1)

(define *funny-horn* -1)

(defun horn-channel ((player-slot uint))
  (the-as gui-channel
          (+ (the-as uint (gui-channel horn)) (if (mp-player-slot-valid? player-slot) player-slot (the-as uint 0)))))

(dotimes (player-slot MP_MAX_PLAYERS)
  (set! (-> *gui-control* cmd (horn-channel (the-as uint player-slot))) '((64 . wait))))

(defun roll-funny-horn ()
  (let ((second (the int (/ (-> *display* game-clock frame-counter) (seconds 1)))))
    (when (!= second *funny-horn-second*)
      (set! *funny-horn-second* second)
      (set! *funny-horn* (if (< (rand-vu-int-count 100) VEHICLE_HORN_FUNNY_PERCENT)
                             (+ VEHICLE_HORN_FUNNY (rand-vu-int-count VEHICLE_HORN_FUNNY_COUNT))
                             -1))))
  *funny-horn*)

(defun vehicle-horn ((veh vehicle))
  (cond
    ((type? veh hellcat) VEHICLE_HORN_HELLCAT)
    ((or (type? veh bike-base) (type? veh guard-bike)) VEHICLE_HORN_BIKE)
    ((type? veh car-base) VEHICLE_HORN_CAR)
    (else -1)))

(defun local-vehicle-horn ((veh vehicle))
  (let ((horn (vehicle-horn veh)))
    (if (and (>= horn 0) (>= (roll-funny-horn) 0)) *funny-horn* horn)))

(defun stop-horn! ((channel gui-channel))
  (let ((sounding (lookup-gui-connection *gui-control* (the-as process #f) channel (the-as string #f) (new 'static 'sound-id))))
    (when (nonnull? sounding)
      (stop-str *gui-control* sounding)
      (move-to-dead sounding)))
  (none))

(defun note-horn-press! ((veh vehicle))
  (let ((driver (the-as target (get-rider-in-seat veh 0))))
    (when (and (nonnull? driver) (type? driver target) (nonnull? (-> driver pilot)))
      (set! (-> driver pilot horn-time) (-> *display* game-clock frame-counter))))
  (none))

(defun honk-vehicle-horn! ((veh vehicle) (player-slot uint) (horn int))
  (let ((channel (horn-channel player-slot)))
    (stop-horn! channel)
    (play-custom-spatial-audio (-> *vehicle-horns* horn) veh channel 10 80)
    (note-horn-press! veh))
  (none))

(defconstant HORN_PRESS_PULLBACK (meters 0.05))

(defun horn-press-amount ((pilot pilot-info))
  (let ((elapsed (the float (- (-> *display* game-clock frame-counter) (-> pilot horn-time)))))
    (fmin (lerp-scale 0.0 1.0 elapsed 0.0 (the float (seconds 0.05)))
          (lerp-scale 1.0 0.0 elapsed (the float (seconds 0.2)) (the float (seconds 0.3))))))

(defun press-horn-with-free-hand! ((driver target) (veh vehicle) (hands matrix))
  (when (and (nonnull? driver (-> driver pilot) veh (-> veh node-list) hands)
             (or (type? veh car-base) (type? veh hellcat)))
    (let ((amount (horn-press-amount (-> driver pilot))))
      (when (> amount 0.0)
        (let ((free-hand (-> hands vector (if (focus-test? driver indax) 1 0)))
              (centre (new 'stack-no-clear 'vector))
              (pullback (new 'stack-no-clear 'vector)))
          (vector-lerp! centre (-> hands vector 0) (-> hands vector 1) 0.5)
          (vector-normalize-copy! pullback (-> veh node-list data 0 bone transform vector 2) HORN_PRESS_PULLBACK)
          (vector-! centre centre pullback)
          (vector-lerp! free-hand free-hand centre amount)))))
  (none))

(defun send-vehicle-honk! ((net-id uint) (horn int))
  (let ((event (new 'stack-no-clear 'vehicle-honk-event)))
    (when (mp-event-prepare! event MP_EVENT_VEHICLE_HONK)
      (set! (-> event payload aid) net-id)
      (set! (-> event payload horn) horn)
      (mp-event-enqueue! event)))
  (none))

(defun honk-local-vehicle-horn! ((veh vehicle))
  (let ((horn (if (nonnull? veh) (local-vehicle-horn veh) -1)))
    (when (>= horn 0)
      (honk-vehicle-horn! veh (mp-local-player-slot) horn)
      (send-vehicle-honk! (-> veh net-id) horn)))
  (none))

(defun receive-vehicle-honk! ((evt vehicle-honk-event) (player-slot uint))
  (when (and (nonnull? evt) (< (-> evt payload horn) (the-as uint (-> *vehicle-horns* length))))
    (let ((veh (mp-vehicle-find-by-net-id (-> evt payload aid))))
      (when (nonnull? veh)
        (honk-vehicle-horn! veh player-slot (the-as int (-> evt payload horn))))))
  (none))
