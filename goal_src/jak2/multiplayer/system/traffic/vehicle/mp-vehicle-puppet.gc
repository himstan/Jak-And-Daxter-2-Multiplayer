;;-*-Lisp-*-
(in-package goal)

(define MP_VEHICLE_PARKING_MINIMAP_ATTACHED (the uint8 173))
(define MP_VEHICLE_AUTHORITY_HANDOFF_GRACE (seconds 1))
(define MP_MAX_VEHICLE_AUTHORITY_HANDOFFS 8)
(define *mp-vehicle-missing-branch-log-time* (the-as time-frame 0))

(define *mp-race-vehicle-handles* (new 'static 'array handle 10))

(deftype mp-vehicle-authority-handoff (structure)
  ((net-id               uint32)
   (pad                  uint32)
   (start-time           time-frame)
   (last-owner-sync-time uint64)
   )
  :size-assert 24)

(define-perm *mp-vehicle-authority-handoffs*
  (inline-array mp-vehicle-authority-handoff)
  (new 'static 'inline-array mp-vehicle-authority-handoff 8))

(define *mp-vehicle-last-driver-net-ids*
  (new 'static 'array uint32 MP_MAX_PLAYERS))

(defun mp-vehicle-reset-authority-handoffs! ()
  (dotimes (player-id MP_MAX_PLAYERS)
    (set! (-> *mp-vehicle-last-driver-net-ids* player-id) (the uint32 0)))
  (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
    (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
      (set! (-> handoff net-id) (the uint32 0))
      (set! (-> handoff start-time) 0)
      (set! (-> handoff last-owner-sync-time) (the uint64 0))))
  (none))

(defun mp-vehicle-begin-authority-handoff! ((net-id uint))
  "Keep a formerly player-driven vehicle materialized until host traffic resumes."
  (when (nonzero? net-id)
    (let ((free-slot -1)
          (already-active? #f))
      (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
        (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
          (when (= (-> handoff net-id) net-id)
            (set! already-active? #t))
          (when (and (< free-slot 0) (zero? (-> handoff net-id)))
            (set! free-slot slot-idx))))
      (when (and (not already-active?) (>= free-slot 0))
        (let ((handoff (-> *mp-vehicle-authority-handoffs* free-slot))
              (ghost (mp-get-traffic-ghost net-id))
              (received-time (pc-multi-get-vehicle-sync-time net-id)))
          (set! (-> handoff net-id) net-id)
          (set! (-> handoff start-time) (current-time))
          (set! (-> handoff last-owner-sync-time)
                (if (and ghost
                         (nonzero? ghost)
                         (> (-> ghost last-correction-time) received-time))
                    (-> ghost last-correction-time)
                    received-time))))))
  (none))

(defun mp-vehicle-clear-authority-handoff! ((net-id uint))
  (when (nonzero? net-id)
    (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
      (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
        (when (= (-> handoff net-id) net-id)
          (set! (-> handoff net-id) (the uint32 0))
          (set! (-> handoff start-time) 0)
          (set! (-> handoff last-owner-sync-time) (the uint64 0))))))
  (none))

(defun mp-vehicle-update-authority-handoff! ((record mp-player-record))
  "Register a handoff whenever this record's explicit driver claim changes."
  (when (and record (nonzero? record))
    (let ((player-id (-> record identity player-id)))
      (when (< player-id (the uint MP_MAX_PLAYERS))
        (let* ((previous-net-id (-> *mp-vehicle-last-driver-net-ids* player-id))
               (current-net-id (-> record vehicle state net-id)))
          (when (!= previous-net-id current-net-id)
            (when (nonzero? previous-net-id)
              (mp-vehicle-begin-authority-handoff! previous-net-id))
            (set! (-> *mp-vehicle-last-driver-net-ids* player-id)
                  current-net-id))))))
  (none))

(defun mp-vehicle-complete-authority-handoff-if-fresh! ((net-id uint))
  "Clear a handoff only after traffic has produced a newer sample than its driver."
  (when (nonzero? net-id)
    (let ((received-time (pc-multi-get-vehicle-sync-time net-id)))
      (when (nonzero? received-time)
        (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
          (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
            (when (and (= (-> handoff net-id) net-id)
                       (> received-time (-> handoff last-owner-sync-time)))
              (mp-vehicle-clear-authority-handoff! net-id)))))))
  (none))

(defun mp-vehicle-authority-handoff-active? ((net-id uint))
  (when (nonzero? net-id)
    (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
      (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
        (when (= (-> handoff net-id) net-id)
          (return #t)))))
  #f)

(defun mp-vehicle-authority-handoff-pending? ((net-id uint))
  (when (nonzero? net-id)
    (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
      (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
        (when (= (-> handoff net-id) net-id)
          (return
            (not (time-elapsed? (-> handoff start-time)
                                MP_VEHICLE_AUTHORITY_HANDOFF_GRACE)))))))
  #f)

(defun mp-player-record-current-vehicle ((record mp-player-record))
  (if (and record (nonzero? record))
      (the-as vehicle
        (handle->process-safe (-> record runtime vehicle-handle)))
      (the-as vehicle #f)))

(defun mp-player-record-drives-vehicle? ((record mp-player-record) (veh vehicle))
  (and record
       (nonzero? record)
       veh
       (nonzero? veh)
       (nonzero? (-> veh net-id))
       (= (-> veh net-id) (-> record vehicle state net-id))))

(defun mp-vehicle-player-record ((veh vehicle) (remote-only? symbol))
  (when (and veh (nonzero? veh))
    (mp-for-each-player-record (player-id record)
      (when (and (or (not remote-only?)
                     (mp-player-record-remote? *mp-player-controller* record))
                 (mp-player-record-drives-vehicle? record veh))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-vehicle-net-id-player-driven? ((net-id uint) (remote-only? symbol))
  (when (nonzero? net-id)
    (mp-for-each-player-record (player-id record)
      (when (and (or (not remote-only?)
                     (mp-player-record-remote? *mp-player-controller* record))
                 (= net-id (-> record vehicle state net-id)))
        (return #t))))
  #f)

(defun mp-race-vehicle-register! ((racer-index int) (vehicle vehicle))
  (when (and (>= racer-index 0)
             (< racer-index MP_MAX_RACE_VEHICLES)
             vehicle
             (nonzero? vehicle)
             *mp-race-vehicle-handles*
             (nonzero? *mp-race-vehicle-handles*))
    (set! (-> *mp-race-vehicle-handles* racer-index)
          (process->handle vehicle)))
  (none))

(defun mp-race-vehicle-find-by-net-id ((net-id uint))
  (when (mp-race-vehicle-id? net-id)
    (let ((racer-index (mp-race-vehicle-racer-index net-id)))
      (when (and (>= racer-index 0)
                 (< racer-index MP_MAX_RACE_VEHICLES)
                 *mp-race-vehicle-handles*
                 (nonzero? *mp-race-vehicle-handles*))
        (let ((vehicle
                (handle->process-safe
                  (-> *mp-race-vehicle-handles* racer-index))))
          (when (and vehicle
                     (nonzero? vehicle)
                     (= (-> (the-as vehicle vehicle) net-id) net-id))
            (return (the-as vehicle vehicle)))))))
  (the-as vehicle #f))

(defun mp-race-clear-vehicle-handles! ()
  (dotimes (i MP_MAX_RACE_VEHICLES)
    (set! (-> *mp-race-vehicle-handles* i) (the-as handle #f)))
  (none))

(defun mp-vehicle-param-nav-branch-ready? ((params traffic-object-spawn-params))
  (and params
       (nonzero? params)
       (-> params nav-branch)
       (nonzero? (the-as uint (-> params nav-branch))))
  )

(defun mp-vehicle-find-spawn-branch ((params traffic-object-spawn-params))
  "Find a road branch for this vehicle spawn from the currently linked traffic levels."
  (let ((branch (the-as nav-branch #f)))
    (when (and params
               (nonzero? params)
               *traffic-engine*
               (nonzero? (the-as uint *traffic-engine*)))
      (let ((facing-dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> params rotation))))
        (let ((seg (find-best-segment *traffic-engine* (-> params position) facing-dir 1)))
          (when (and seg
                     (nonzero? seg)
                     (-> seg branch)
                     (nonzero? (the-as uint (-> seg branch))))
            (set! branch (-> seg branch))
            )
          )
        )
      )
    (when (not branch)
      (set! branch (mp-traffic-fallback-spawn-branch))
      )
    branch
    )
  )

(defun mp-vehicle-debug-level-data-linked? ((slot-idx int))
  (let ((linked? #f))
    (when (and *traffic-engine*
               (nonzero? (the-as uint *traffic-engine*)))
      (let ((level-data (-> *traffic-engine* level-data-array slot-idx)))
        (when (and (-> level-data city-info)
                   (nonzero? (the-as uint (-> level-data city-info))))
          (set! linked? #t)
          )
        )
      )
    linked?
    )
  )

(defun mp-vehicle-debug-level-data-active-count ((slot-idx int))
  (let ((active-count (the uint 0)))
    (when (and *traffic-engine*
               (nonzero? (the-as uint *traffic-engine*)))
      (let ((level-data (-> *traffic-engine* level-data-array slot-idx)))
        (set! active-count (the uint (-> level-data active-cell-count)))
        )
      )
    active-count
    )
  )

(defun mp-vehicle-log-spawn-params! ((reason symbol) (slot mp-vehicle-state) (params traffic-object-spawn-params))
  (when (and slot
             (nonzero? slot)
             params
             (nonzero? params))
    (debug-log *mp-debug-log?*
      "[MP-VehSpawn] ~S nid=~D type=~D state=~D "
      reason
      (-> slot net-id)
      (the uint (-> slot vehicle-type))
      (the uint (-> slot state-id))
      )
    (debug-log *mp-debug-log?*
      "nav-branch=~A riding=~A local-level=~D remote-level=~D "
      (mp-vehicle-param-nav-branch-ready? params)
      *mp-traffic-art-context-riding*
      *mp-traffic-art-context-local-level*
      *mp-traffic-art-context-authority-level*
      )
    (debug-log *mp-debug-log?*
      "peds=~D vehs=~D slot0-linked=~A slot0-active=~D "
      *mp-traffic-art-context-ped-count*
      *mp-traffic-art-context-veh-count*
      (mp-vehicle-debug-level-data-linked? 0)
      (mp-vehicle-debug-level-data-active-count 0)
      )
    (debug-log *mp-debug-log?*
      "slot1-linked=~A slot1-active=~D pos=(~f,~f,~f)~%"
      (mp-vehicle-debug-level-data-linked? 1)
      (mp-vehicle-debug-level-data-active-count 1)
      (-> params position x)
      (-> params position y)
      (-> params position z)
      )
    )
  (none)
  )

(defun mp-vehicle-log-skipped-spawn! ((slot mp-vehicle-state) (params traffic-object-spawn-params))
  (when (time-elapsed? *mp-vehicle-missing-branch-log-time* (seconds 1))
    (mp-vehicle-log-spawn-params! 'skip-missing-branch slot params)
    (set! *mp-vehicle-missing-branch-log-time* (current-time))
    )
  (none)
  )

(defun mp-vehicle-get-pad-index ((this vehicle))
  "Return the leased pad for the explicit remote driver authority claim."
  (if (and this (nonzero? this))
      (let ((record (mp-vehicle-player-record this #t)))
        (if (and record (nonzero? record))
            (the-as int (-> record runtime pad-index))
            0))
      0))

(defun mp-vehicle-local-target-driving? ((veh vehicle))
  "True only while the local player is actually attached to driver seat 0."
  (if (and veh
           (nonzero? veh)
           *target*
           (nonzero? *target*)
           (focus-test? *target* pilot)
           (-> *target* pilot)
           (nonzero? (-> *target* pilot)))
      (let* ((pilot-info (-> *target* pilot))
             (vehicle-proc (the-as vehicle (handle->process-safe (-> pilot-info vehicle)))))
        (and vehicle-proc
             (nonzero? vehicle-proc)
             (= vehicle-proc veh)
             (zero? (-> pilot-info seat-index)))
        )
      #f
      )
  )

(defun mp-vehicle-local-target-riding? ((veh vehicle))
  "True while the local player is attached to any seat in this vehicle."
  (if (and veh
           (nonzero? veh)
           *target*
           (nonzero? *target*)
           (focus-test? *target* pilot)
           (-> *target* pilot)
           (nonzero? (-> *target* pilot)))
      (let* ((pilot-info (-> *target* pilot))
             (vehicle-proc (the-as vehicle (handle->process-safe (-> pilot-info vehicle)))))
        (and vehicle-proc
             (nonzero? vehicle-proc)
             (= vehicle-proc veh))
        )
      #f
      )
  )

(defun mp-vehicle-remote-puppet-driving? ((veh vehicle))
  "True while any non-local record legitimately owns this driver seat."
  (let ((record (mp-vehicle-player-record veh #t)))
    (and record
         (nonzero? record)
         (= (get-rider-in-seat veh 0) (mp-player-record-target record))))
  )

(defun mp-vehicle-remote-puppet-currently-driving? ()
  "True while any remote target is safely attached to a driver seat."
  (mp-for-each-player-target (player-id record puppet)
    (when (and (mp-player-record-remote? *mp-player-controller* record)
               (focus-test? puppet pilot)
               (-> puppet pilot)
               (nonzero? (-> puppet pilot))
               (zero? (-> puppet pilot seat-index)))
      (let ((vehicle-process
              (handle->process-safe (-> puppet pilot vehicle))))
        (when (and vehicle-process
                   (nonzero? vehicle-process)
                   (type? vehicle-process vehicle)
                   (mp-vehicle-remote-puppet-driving?
                     (the-as vehicle vehicle-process)))
          (return #t)))))
  (the-as symbol #f)
  )

(defun mp-vehicle-stale-player-driver? ((veh vehicle))
  "Detect target handles that leaked into an ambient traffic driver's seat."
  (when (and veh
             (nonzero? veh))
    (let ((driver (get-rider-in-seat veh 0)))
      (when (and driver
                 (nonzero? driver)
                 (mp-player-process-record driver))
        (let ((record (mp-player-process-record driver)))
          (return
            (not (if (= (-> record identity player-id) (mp-local-player-id))
                     (mp-vehicle-local-target-driving? veh)
                     (mp-vehicle-remote-puppet-driving? veh)))))
        )
      )
    )
  #f
  )

(defun mp-vehicle-clear-stale-player-driver! ((veh vehicle))
  "Clear leaked player target handles before/after ambient rider spawning."
  (when (mp-vehicle-stale-player-driver? veh)
    (put-rider-in-seat veh 0 (the-as process-focusable #f))
    )
  (none)
  )

(defun mp-vehicle-driver-sync-claimed? ((veh vehicle))
  "True when a vehicle is currently claimed by any player's driver sync state."
  (if (and veh (nonzero? veh) (nonzero? (-> veh net-id)))
      (mp-vehicle-net-id-player-driven? (-> veh net-id) #f)
      #f
      )
  )

(defun mp-vehicle-release-stale-player-control! ((veh vehicle))
  "Leave player-control when no real local or puppet driver owns the vehicle."
  (when (and veh
             (nonzero? veh)
             (-> veh state)
             (= (-> veh state name) 'player-control)
             (not (mp-vehicle-driver-sync-claimed? veh))
             (not (mp-vehicle-local-target-driving? veh)))
    (let ((current-pilot (get-rider-in-seat veh 0)))
      (if current-pilot
          (send-event veh 'change-state 'active)
          (send-event veh 'change-state 'waiting)
          )
      (when (and (-> veh next-state) (= (-> veh next-state name) 'player-control))
        (set! (-> veh next-state) (the-as state #f))
        )
      )
    )
  (none)
  )

(defun mp-vehicle-ensure-guard-minimap! ((veh vehicle))
  "Attach the vanilla guard minimap icon to a spawned or refreshed guard vehicle."
  (when (and veh
             (nonzero? veh)
             (type? veh vehicle-guard)
             *minimap*
             (nonzero? *minimap*))
    (turn-traffic-vehicle-on! (the-as vehicle-guard veh))
    )
  (none)
  )

(defun mp-vehicle-remove-guard-minimap! ((veh vehicle))
  "Fade out the vanilla guard minimap icon before the vehicle is force-culled."
  (when (and veh
             (nonzero? veh)
             (type? veh vehicle-guard))
    (turn-traffic-vehicle-off! (the-as vehicle-guard veh))
    )
  (none)
  )

(defun mp-vehicle-slot-parking-minimap? ((slot mp-vehicle-state))
  "True when the host reports that this vehicle is represented by a parking spot icon."
  (and slot
       (nonzero? slot)
       (logtest? (-> slot state-flags) MP_VEHICLE_STATE_FLAG_PARKING_MINIMAP))
  )

(defun vehicle-parking-minimap? ((veh vehicle))
  "True when the host reports that this vehicle is represented by a parking spot icon."
  (if (and veh (nonzero? veh) (= (-> veh pad-bytes 1) MP_VEHICLE_PARKING_MINIMAP_ATTACHED))
       #t
       #f
       )
  )

(defun mp-vehicle-ensure-parking-minimap! ((veh vehicle))
  "Attach the gray parking-spot minimap icon to a remote waiting vehicle."
  (when (and veh
             (nonzero? veh)
             *minimap*
             (nonzero? *minimap*)
             (or (not (-> veh is-parked?)) (zero? (-> veh is-parked?))))
    (let ((conn (add-icon! *minimap* veh (the-as uint (minimap-class parking-spot)) (the-as int #f) (the-as vector #t) 0)))
      (when (and conn (nonzero? conn))
        (debug-log *mp-debug-log?* "Adding MP_VEHICLE_PARKING_MINIMAP_ATTACHED flag to vehicle with id: ~D current pad-bytes 1: ~A~%" (-> veh net-id) (-> veh pad-bytes 1))
        (set! (-> veh is-parked?) #t)
        (set! (-> veh pad-bytes 1) MP_VEHICLE_PARKING_MINIMAP_ATTACHED)
        )
      )
    )
  (none)
  )

(defun mp-vehicle-remove-parking-minimap! ((veh vehicle))
  "Fade out any parking-spot minimap icon attached to this remote vehicle."
  (when (and veh
             (nonzero? veh)
             *minimap*
             (nonzero? *minimap*))
    (let ((curr (the-as connection-pers (-> *minimap* engine alive-list))))
      (while curr
        (let ((conn (the-as connection-minimap curr)))
          (let ((handle (handle->process-safe (-> conn handle))))
            (when (and handle (nonzero? handle) (type? handle vehicle))
              (let ((minimap-veh (the-as vehicle handle)))
                (when (= (-> veh net-id) (-> minimap-veh net-id))
                  (logior! (-> conn flags) (minimap-flag fade-out))
                  (set! conn #f)
                )
              )
            )
          )
        )
        (set! curr (-> curr next))
      )
    )
    (set! (-> veh pad-bytes 1) (the uint8 0))
    (set! (-> veh is-parked?) #f)
  )
  (none)
)

(defun mp-vehicle-clear-local-riders! ((veh vehicle))
  "Detach stale non-player riders before force-culling a local traffic vehicle."
  (when (and veh (nonzero? veh))
    (dotimes (seat-index 4)
      (let ((rider-proc (handle->process-safe (-> veh rider-array seat-index))))
        (cond
          ((not rider-proc)
           (set! (-> veh rider-array seat-index) (the-as handle #f))
           )
          ((and (nonzero? rider-proc)
                (not (mp-player-process-record rider-proc)))
           (cond
             ((type? rider-proc vehicle-rider)
              (send-event rider-proc 'rider-off)
              (deactivate rider-proc)
              )
             ((type? rider-proc citizen)
              (send-event rider-proc 'traffic-off-force)
              )
             (else
              (remove-rider veh rider-proc)
              )
             )
           (set! (-> veh rider-array seat-index) (the-as handle #f))
           )
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-force-cull-local! ((veh vehicle))
  "Remove a stale local traffic vehicle that no longer exists on the authority."
  (when (and veh
             (nonzero? veh)
             (not (mp-vehicle-local-target-riding? veh)))
    (let ((owner-record (mp-vehicle-player-record veh #t)))
      (when (and owner-record (nonzero? owner-record))
        (set! (-> owner-record runtime vehicle-handle) (the-as handle #f))))
    (mp-vehicle-remove-guard-minimap! veh)
    (mp-vehicle-remove-parking-minimap! veh)
    (mp-vehicle-clear-local-riders! veh)
    (logclear! (-> veh flags)
               (rigid-body-object-flag persistent player-driving riding ai-driving alert in-pursuit target-in-sight rammed-target))
    (set! (-> veh net-id) (the uint 0))
    (send-event veh 'traffic-off-force)
    (deactivate veh)
    )
  (none)
  )

(defun mp-vehicle-slot-state-id-safe ((slot mp-vehicle-state))
  "Read the host vehicle state id without assuming the slot pointer is valid."
  (if (and slot (nonzero? slot))
      (the uint (-> slot state-id))
      (the uint 0)
      )
  )

(defun mp-vehicle-parking-minimap-debug! ((action symbol) (veh vehicle) (slot-state-id uint))
  "Log parking minimap decisions without dereferencing the vehicle state object."
  (when (and veh (nonzero? veh))
    (debug-log *mp-debug-log?*
      "[MP-Vehicle] parking-minimap ~A nid=~D slot-state=~D veh-state=#x~X~%"
      action
      (-> veh net-id)
      slot-state-id
      (-> veh state)
      )
    (debug-log *mp-debug-log?*
      "[MP-Vehicle] parking-minimap parked=~A pad1=~D local-riding=~A spawn-ready=~A~%"
      (-> veh is-parked?)
      (-> veh pad-bytes 1)
      (mp-vehicle-local-target-riding? veh)
      (mp-is-traffic-spawn-ready?)
      )
    )
  (none)
  )

(defun mp-vehicle-refresh-parking-minimap! ((veh vehicle) (slot mp-vehicle-state))
  "Mirror the host-side parking-spot minimap state without syncing parking spots."
  (when (and veh (nonzero? veh))
    (let ((slot-state-id (mp-vehicle-slot-state-id-safe slot)))
      (cond
        ((mp-vehicle-local-target-riding? veh)
         (when (vehicle-parking-minimap? veh)
           (mp-vehicle-parking-minimap-debug! 'remove-local-riding veh slot-state-id)
           (mp-vehicle-remove-parking-minimap! veh)
           )
         )
        ((not (mp-is-traffic-spawn-ready?))
         (when (mp-vehicle-slot-parking-minimap? slot)
           (mp-vehicle-parking-minimap-debug! 'skip-not-spawn-ready veh slot-state-id)
           )
         )
        (else
         (when (and (mp-vehicle-slot-parking-minimap? slot)
                    (or (not (-> veh is-parked?)) (zero? (-> veh is-parked?)))
                    (= slot-state-id (the uint 4)))
           (mp-vehicle-ensure-parking-minimap! veh)
           (mp-vehicle-parking-minimap-debug! 'ensure veh slot-state-id)
           )
         (when (and (vehicle-parking-minimap? veh) (!= slot-state-id (the uint 4)))
           (mp-vehicle-parking-minimap-debug! 'remove veh slot-state-id)
           (mp-vehicle-remove-parking-minimap! veh)
           )
         )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-remote-driven? ((veh vehicle))
  (let ((record (mp-vehicle-player-record veh #t)))
    (and record (nonzero? record)))
  )

(defun mp-vehicle-is-local-authoritative? ((veh vehicle))
  "Check if the local machine has authority over this vehicle's physics."
  (if (and veh (nonzero? veh))
      (let ((flags (-> veh flags)))
        (cond
          ((mp-vehicle-remote-driven? veh)
           #f)

          ((and (logtest? flags (rigid-body-object-flag player-driving))
                (mp-vehicle-local-target-driving? veh))
           #t)

          ((mp-race-vehicle-id? (-> veh net-id))
           (mp-session-host?))

          (else
           (mp-is-traffic-authoritative?))))
      #f))

(defun mp-should-apply-vehicle-camera? ((veh vehicle))
  "Returns #t if the local camera should follow this vehicle."
  (cond
    ((mp-vehicle-local-target-riding? veh)
     #t)
    (else
     (mp-vehicle-is-local-authoritative? veh))
    )
  )

(defun mp-vehicle-find-by-net-id ((net-id uint))
  (let ((found-proc (the-as vehicle #f)))
    (when (and *traffic-manager* (nonzero? net-id))
      (let ((curr (-> *traffic-manager* child)))
        (while (and curr (nonzero? curr))
          (let ((proc (ppointer->process curr)))
            (when (and proc (type? proc vehicle) (= (-> (the-as vehicle proc) net-id) net-id))
              (set! found-proc (the-as vehicle proc))
              (set! curr (the-as (pointer process-tree) #f))
              )
            (if curr (set! curr (-> curr 0 brother)))
            )
          )
        )
      )
    (when (and (not found-proc) (mp-mission-vehicle-id? net-id))
      (set! found-proc (mp-mission-vehicle-find-by-net-id net-id))
      )
    (when (and (not found-proc) (mp-race-vehicle-id? net-id))
      (set! found-proc (mp-race-vehicle-find-by-net-id net-id)))
    found-proc)
)

(defun mp-clear-traffic-ghost-by-net-id! ((net-id uint))
  "Clear a traffic ghost record immediately when local authority takes over."
  (when (nonzero? net-id)
    (let ((rec (mp-get-traffic-ghost net-id)))
      (when rec
        (set! (-> rec net-id) (the uint 0))
        (set! (-> rec entity-kind) (the uint8 0))
        (set! (-> rec ghost-state-id) (the uint8 0))
        (set! (-> rec ghost-aux-state) (the uint8 0))
        (set! (-> rec last-applied-state-id) (the uint32 0))
        (set! (-> rec last-state-bump-time) 0)
        (set! (-> rec authorized-trans-state-id) (the uint32 0))
        (set! (-> rec authorized-trans-frame) 0)
        )
      )
    )
  (none)
  )

(defun mp-vehicle-play-flight-level-sound! ((veh vehicle))
  "Play the synced flight-level sound from the vehicle position."
  (when (and veh (nonzero? veh))
    (let ((veh-root (-> veh root)))
      (when (and veh-root (nonzero? veh-root))
        (if (zero? (-> veh mp-flight-level-index))
            (sound-play-by-spec (static-sound-spec "bike-down" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> veh-root trans))
            (sound-play-by-spec (static-sound-spec "bike-up" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> veh-root trans))
            )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-apply-authoritative-flight-level! ((veh vehicle) (state-flags uint) (play-sound? symbol))
  "Force synced high/low flight level without running local transition logic."
  (when (and veh (nonzero? veh))
    (let ((initial-index (-> veh mp-flight-level-index)))
      (if (logtest? state-flags MP_VEHICLE_STATE_FLAG_HIGH_FLIGHT)
            (begin
              (set! (-> veh flight-level-index) 1)
              (set! (-> veh flight-level-index-prev) 1)
              (set! (-> veh mp-flight-level-index) 1)
              (logior! (-> veh flags) (rigid-body-object-flag on-flight-level))
              )
            (begin
              (set! (-> veh flight-level-index) 0)
              (set! (-> veh flight-level-index-prev) 0)
              (set! (-> veh mp-flight-level-index) 0)
              (logclear! (-> veh flags) (rigid-body-object-flag on-flight-level))
              )
            )
      (when (and play-sound? (logtest? (-> veh flags) (rigid-body-object-flag player-driving)) (!= initial-index (-> veh mp-flight-level-index)))
        (mp-vehicle-play-flight-level-sound! veh)
        )
      )
    (logclear! (-> veh flags) (rigid-body-object-flag flight-level-transition flight-level-transition-ending))
    (disable-rapid-camera-tracking veh)
    (none)
    )
  (none)
  )

(defun mp-vehicle-refuse-traffic-off? ((veh vehicle))
  "True when traffic cleanup must preserve a player-associated vehicle or handoff."
  (when (and veh (nonzero? veh))
    (let ((v-net-id (-> veh net-id)))
      (when (or (mp-vehicle-local-target-driving? veh)
                (mp-vehicle-local-target-riding? veh)
                (mp-vehicle-remote-puppet-driving? veh)
                (mp-player-record-by-vehicle-id v-net-id)
                (mp-vehicle-authority-handoff-pending? v-net-id))
        (return #t)
        )
      )
    )
  #f
  )

(defun mp-vehicle-send-attack-event! ((this vehicle) (attacker process) (arg3 event-message-block))
  "Send an attack event to the authoritative owner of this vehicle."
  (when (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) (mp-connection-status in-game)))
    (return #f))
  (let ((net-id (-> this net-id)))
    (when (nonzero? net-id)
      (let ((info (mp-actor-event-attack-info arg3)))
        (let ((auth-player-id (the uint *mp-traffic-selected-authority-id*))
              (driver-rec (mp-vehicle-player-record this #t)))
          (when (and driver-rec (nonzero? driver-rec))
            (set! auth-player-id (-> driver-rec identity player-id))
            )
          (when (< auth-player-id (the uint MP_MAX_PLAYERS))
            (let* ((penetrate (if (and info (nonzero? info))
                                  (-> info penetrate-using)
                                  (if (and attacker (nonzero? attacker) (type? attacker process-drawable))
                                      (get-penetrate-using-from-attack-event (the-as process-drawable attacker) arg3)
                                      (the-as penetrate 0))))
                   (attack-id (if (and info (nonzero? info)) (-> info id) (the uint 0)))
                   (details (new 'stack-no-clear 'mp-actor-attack-build-data))
                   (event (new 'stack-no-clear 'mp-actor-attack-event)))
              (set! (-> details net-id) net-id)
              (set! (-> details attack-id) attack-id)
              (set! (-> details flags) 0)
              (set! (-> details knocked-type) (the-as uint 0))
              (set! (-> details new-hp) (the int (* 255.0 (-> this hit-points))))
              (set! (-> details shove-back) (meters 0))
              (set! (-> details shove-up) (meters 0))
              (set! (-> details hit-sound-id) (the-as uint32 0))
              (set! (-> details penetrate) (the-as uint penetrate))
              (set! event (mp-event-build-actor-attack! event MP_EVENT_ATTACK_PED details))
              (when event
                (set! (-> event traffic-authority-player-id) (the-as uint32 auth-player-id))
                (set! (-> event payload-size) (the uint 76))
                (if (and attacker (nonzero? attacker) (type? attacker process-drawable) (-> (the-as process-drawable attacker) root))
                    (begin
                      (set! (-> event source-pos quad) (-> (the-as process-drawable attacker) root trans quad))
                      (logior! (-> event flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
                      )
                    (set! (-> event source-pos quad) (-> this root trans quad))
                    )
                (if (and info (nonzero? info) (logtest? (attack-mask vector) (-> info mask)))
                    (begin
                      (set! (-> event attack-dir quad) (-> info vector quad))
                      (logior! (-> event flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
                      )
                    (begin
                      (vector-! (-> event attack-dir) (-> this root trans) (-> event source-pos))
                      (set! (-> event attack-dir y) 0.0)
                      (vector-xz-normalize! (-> event attack-dir) 1.0)
                      (logior! (-> event flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
                      )
                    )
                (debug-log *mp-debug-log?*
                           "[MP-Vehicle] Queue vehicle attack nid=~D auth=~D attack-id=~D~%"
                           net-id
                           auth-player-id
                           attack-id)
                (mp-event-enqueue! event)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-apply-remote-attack! ((evt mp-actor-attack-event))
  "Apply a client-requested vehicle hit on the vehicle authority."
  (when (or (not evt) (zero? evt))
    (return #f))
  (let ((v-proc (mp-vehicle-find-by-net-id (-> evt net-id))))
    (when (and v-proc (nonzero? v-proc))
      (let ((attacker (mp-player-target-by-id (-> evt source-player-id))))
        (when (and attacker (nonzero? attacker))
          (let ((atk (new 'stack-no-clear 'attack-info)))
            (set! (-> atk id) (-> evt attack-id))
            (set! (-> atk mask) (attack-mask id vector penetrate-using))
            (set! (-> atk penetrate-using) (the-as penetrate (-> evt penetrate)))
            (set! (-> atk vector quad) (-> evt attack-dir quad))
            (debug-log *mp-debug-log?* "[MP-Vehicle] Applying remote attack to authoritative vehicle nid=~D~%" (-> evt net-id))
            (send-event v-proc 'attack #f atk)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-handle-event! ((this vehicle) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (let ((v-net-id (-> this net-id)))
    (when (and (nonzero? v-net-id)
               (mp-vehicle-net-id-player-driven? v-net-id #t))
      (case arg2
        (('attack)
         (when (and (mp-is-local-attacker? arg0)
                    (not (mp-vehicle-is-local-authoritative? this)))
           (mp-vehicle-send-attack-event! this arg0 arg3)
           )
         (return 'block)
         )
        (('touch 'impulse)
         (return 'block)
         )
        )
      )
    (when (and (nonzero? v-net-id)
               (= arg2 'attack)
               (mp-is-local-attacker? arg0)
               (not (mp-vehicle-is-local-authoritative? this)))
      (mp-vehicle-send-attack-event! this arg0 arg3)
      )
    )

  (case arg2
    (('traffic-off 'traffic-off-force)
     (when (mp-vehicle-refuse-traffic-off? this)
       (return 'block)
       )
     (when (not (mp-is-traffic-authoritative?))
       (set! (-> this net-id) (the uint 0))
       (deactivate this)
       (return 'handled)
       )
     )
    )
  #f
  )

(defun mp-vehicle-guard-clear-combat! ((veh vehicle-guard))
  (when (and veh (nonzero? veh))
    (set! (-> veh flags)
          (the-as rigid-body-object-flag
                  (logclear (-> veh flags)
                            (rigid-body-object-flag alert in-pursuit target-in-sight rammed-target))))
    (end-vehicle-pursuit! veh)
    (when (and (-> veh next-state)
               (or (= (-> veh next-state name) 'hostile)
                   (= (-> veh next-state name) 'stop-and-shoot)
                   (= (-> veh next-state name) 'slow-pursuit)
                   (= (-> veh next-state name) 'waiting-ambush)))
      (set! (-> veh next-state) (the-as state #f))
      )
    )
  (none)
  )

(defun mp-vehicle-guard-local-driver? ((veh vehicle))
  (and veh
       (nonzero? veh)
       (type? veh vehicle-guard)
       (logtest? (-> veh flags) (rigid-body-object-flag player-driving))
       (or (mp-vehicle-local-target-driving? veh)
           (mp-vehicle-remote-puppet-driving? veh))
       )
  )

(defun mp-vehicle-guard-remote-combat-state? ((state-sym symbol))
  (or (= state-sym 'hostile)
      (= state-sym 'stop-and-shoot)
      (= state-sym 'slow-pursuit)
      (= state-sym 'waiting-ambush))
  )

(defun mp-client-vehicle-local-net-id-base ()
  (mp-traffic-build-net-id
    MP_CLIENT_VEHICLE_NET_ID_BASE
    (mp-local-player-id)
    (the uint 0))
  )

(defun mp-client-vehicle-net-id-in-range? ((net-id uint))
  (let ((local-base (mp-client-vehicle-local-net-id-base)))
    (and (nonzero? local-base)
         (>= net-id local-base)
         (< net-id (+ local-base (the uint #x01000000))))
    )
  )

(defun mp-client-vehicle-next-net-id ()
  "Allocate an ID from the local client's ambient vehicle range."
  (let ((local-base (mp-client-vehicle-local-net-id-base))
        (attempts 0)
        (candidate *mp-client-vehicle-net-id-counter*))
    (when (zero? local-base)
      (return (the uint 0))
      )
    (while (< attempts 1024)
      (when (not (mp-client-vehicle-net-id-in-range? candidate))
        (set! candidate local-base)
        )
      (set! *mp-client-vehicle-net-id-counter* (+ candidate 1))
      (when (not (mp-client-vehicle-net-id-in-range? *mp-client-vehicle-net-id-counter*))
        (set! *mp-client-vehicle-net-id-counter* local-base)
        )
      (when (not (mp-vehicle-find-by-net-id candidate))
        (return candidate)
        )
      (set! candidate *mp-client-vehicle-net-id-counter*)
      (+! attempts 1)
      )
    (the uint 0)
    )
  )

(defun mp-vehicle-promote-local-driver! ((veh vehicle))
  "Give a client-owned local traffic vehicle a network identity once driven."
  (when (and veh
             (nonzero? veh)
             (mp-session-client?)
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             (zero? (-> veh net-id))
             (mp-vehicle-local-target-driving? veh))
    (let ((new-net-id (mp-client-vehicle-next-net-id)))
      (when (nonzero? new-net-id)
        (set! (-> veh net-id) new-net-id)
        (logior! (-> veh flags) (rigid-body-object-flag persistent player-driving riding))
        (logclear! (-> veh flags) (rigid-body-object-flag ai-driving alert in-pursuit target-in-sight rammed-target))
        (set! (-> veh pad-index) (the-as uint (-> *target* control cpad number)))
        (debug-log *mp-debug-log?* "[MP-Traffic] Promoted client-driven local vehicle to nid=~D for player=~D.~%" new-net-id (mp-local-player-id))
        )
      )
    )
  (none)
  )

(defun mp-vehicle-claim-local-driver-sync! ((veh vehicle))
  "Make vanilla vehicle input see the local driver immediately after hijack."
  (when (and veh
             (nonzero? veh)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             (nonzero? (-> veh net-id))
             (mp-vehicle-local-target-driving? veh))
    (set! (-> (mp-local-player-record) vehicle vehicle-id) (-> veh net-id))
    (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 0))
    (mp-vehicle-pack veh (-> (mp-local-player-record) vehicle state))
    (logior! (-> veh flags) (rigid-body-object-flag player-driving riding))
    (logclear! (-> veh flags) (rigid-body-object-flag ai-driving alert in-pursuit target-in-sight rammed-target))
    (set! (-> veh pad-index) (the-as uint (-> *target* control cpad number)))
    )
  (none)
  )

(defun mp-vehicle-pack-local-crash-snapshot? ()
  "Refresh the local crash state before vehicle occupancy is cleared."
  (let ((record (mp-local-player-record))
        (veh (the-as vehicle #f)))
    (when (and record
               (nonzero? record)
               (nonzero? (-> record vehicle state net-id)))
      (set! veh (mp-vehicle-find-by-net-id (-> record vehicle state net-id)))
      (when (and veh
                 (nonzero? veh)
                 (-> veh state)
                 (nonzero? (-> veh state))
                 (= (-> veh state name) 'crash))
        (mp-vehicle-pack veh (-> record vehicle state))
        (return #t)
        )
      )
    )
  #f
  )

(defun mp-vehicle-explode-already-applied? ((veh vehicle))
  "True when this vehicle's ghost already consumed the explode presentation."
  (let ((applied? #f))
    (when (and veh
               (nonzero? veh)
               (nonzero? (-> veh net-id)))
      (let ((rec (mp-get-traffic-ghost (-> veh net-id))))
        (when (and rec
                   (nonzero? rec)
                   (= (-> rec entity-kind) (the uint8 1))
                   (= (-> rec last-applied-state-id)
                      (the uint32 (mp-veh-state-id explode))))
          (set! applied? #t)
          )
        )
      )
    applied?
    )
  )

(defun mp-vehicle-mark-explode-applied! ((veh vehicle))
  "Remember that this vehicle has already played its explode presentation."
  (when (and veh
             (nonzero? veh)
             (nonzero? (-> veh net-id)))
    (let ((rec (mp-get-traffic-ghost (-> veh net-id))))
      (when (and rec
                 (nonzero? rec)
                 (= (-> rec entity-kind) (the uint8 1)))
        (set! (-> rec last-applied-state-id)
              (the uint32 (mp-veh-state-id explode)))
        )
      )
    )
  (none)
  )

(defun mp-vehicle-pack-local-player-snapshot! ()
  "Pack the local target's current vehicle occupancy into local-info."
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (focus-test? *target* pilot)
             (nonzero? (-> *target* pilot))
             (nonzero? (-> *target* pilot vehicle))
             (-> *target* state)
             (nonzero? (-> *target* state))
             (not (mp-target-death-state? (-> *target* state name)))
             (!= (-> *target* state name) 'target-pilot-get-off)
             (!= (-> *target* state name) 'target-indax-pilot-get-off))
    (let* ((pilot-info (-> *target* pilot))
           (v-proc (the-as vehicle (handle->process-safe (-> pilot-info vehicle)))))
      (when (and v-proc (nonzero? v-proc))
        (mp-vehicle-promote-local-driver! v-proc)
        )
      (when (and v-proc (nonzero? v-proc) (nonzero? (-> v-proc net-id)))
        (set! (-> (mp-local-player-record) vehicle vehicle-id) (-> v-proc net-id))
        (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 (-> pilot-info seat-index)))
        (when (zero? (-> pilot-info seat-index))
          (mp-vehicle-pack v-proc (-> (mp-local-player-record) vehicle state))
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-guard-ensure-remote-combat! ((veh vehicle-guard))
  (when (and veh
             (nonzero? veh)
             (not (mp-vehicle-is-local-authoritative? veh)))
    (logior! (-> veh flags) (rigid-body-object-flag alert in-pursuit target-in-sight persistent))
    (let ((owner-record (mp-vehicle-player-record veh #t)))
      (cond
      ((and owner-record
            (nonzero? owner-record)
            (mp-player-record-target owner-record))
       (handle-offending-process! veh (mp-player-record-target owner-record))
       )
      ((and *target* (nonzero? *target*))
       (handle-offending-process! veh *target*)
       )
      ))
    )
  (none)
  )

(defun mp-vehicle-guard-handle-event! ((this vehicle) (arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  "Preserve guard alert/pursuit events while keeping MP vehicle protections."
  (when (and (type? this vehicle-guard)
             (or (= arg2 'pilot-on)
                 (mp-vehicle-guard-local-driver? this)))
    (mp-vehicle-guard-clear-combat! (the-as vehicle-guard this))
    (case arg2
      (('alert-begin 'alert-end 'end-pursuit)
       (return 'handled)
       )
      )
    )

  (let ((v-net-id (-> this net-id)))
    (when (and (nonzero? v-net-id)
               (mp-vehicle-net-id-player-driven? v-net-id #t))
      (case arg2
        (('attack 'touch 'impulse)
         (return 'block)
         )
        )
      )
    )

  (case arg2
    (('traffic-off 'traffic-off-force)
     (when (mp-vehicle-refuse-traffic-off? this)
       (return 'block)
       )
     (when (not (mp-is-traffic-authoritative?))
       (set! (-> this net-id) (the uint 0))
       (deactivate this)
       (return 'handled)
       )
     )
    )
  #f
  )

(defun mp-vehicle-frame-blend ((rate float))
  (fmin 1.0 (fmax 0.0 (* rate (seconds-per-frame))))
  )

(defun mp-vehicle-copy-ghost-to-rbody! ((veh vehicle) (rec mp-traffic-ghost-record) (target-trans vector))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh rbody)
             (nonzero? (-> veh rbody))
             (-> veh rbody state)
             (nonzero? (-> veh rbody state)))
    (vector-copy! (-> veh rbody state position) target-trans)
    (vector-copy! (-> veh rbody state lin-velocity) (-> rec ghost-linvel))
    (quaternion-copy! (-> veh rbody state rotation) (-> rec ghost-quat))
    (vector-copy! (-> veh rbody state ang-velocity) (-> rec ghost-angvel))
    )
  (none)
  )

(defun mp-vehicle-hard-snap-to-ghost! ((veh vehicle) (rec mp-traffic-ghost-record) (target-trans vector))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (set! (-> veh pad-bytes 0) (the uint8 2))
    (vector-copy! (-> veh root trans) target-trans)
    (vector-copy! (-> veh root transv) (-> rec ghost-linvel))
    (quaternion-copy! (-> veh root quat) (-> rec ghost-quat))
    (mp-vehicle-copy-ghost-to-rbody! veh rec target-trans)
    )
  (none)
  )

(defun mp-vehicle-nudge-rbody-to-target! ((veh vehicle) (target-trans vector) (nudge-rate float))
  (when (and veh
             (nonzero? veh)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root))
             (-> veh rbody)
             (nonzero? (-> veh rbody))
             (-> veh rbody state)
             (nonzero? (-> veh rbody state)))
    (let ((nudge (new 'stack-no-clear 'vector)))
      (vector-! nudge target-trans (-> veh root trans))
      (vector-float*! nudge nudge (* nudge-rate (seconds-per-frame)))
      (vector+! (-> veh rbody state lin-velocity) (-> veh rbody state lin-velocity) nudge)
      (vector-copy! (-> veh root transv) (-> veh rbody state lin-velocity))
      )
    )
  (none)
  )

(defun mp-vehicle-apply-driven-ghost-correction! ((veh vehicle) (rec mp-traffic-ghost-record) (target-trans vector) (dist float))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (if (> dist (meters 15))
        (mp-vehicle-hard-snap-to-ghost! veh rec target-trans)
        (begin
          (set! (-> veh pad-bytes 0) (the uint8 1))
          (vector-lerp! (-> veh root trans) (-> veh root trans) target-trans (mp-vehicle-frame-blend 12.0))
          (mp-vehicle-nudge-rbody-to-target! veh target-trans 300.0)
          (quaternion-slerp! (-> veh root quat) (-> veh root quat) (-> rec ghost-quat) (mp-vehicle-frame-blend 24.0))
          (when (and (-> veh rbody)
                     (nonzero? (-> veh rbody))
                     (-> veh rbody state)
                     (nonzero? (-> veh rbody state)))
            (vector-lerp! (-> veh rbody state ang-velocity)
                          (-> veh rbody state ang-velocity)
                          (-> rec ghost-angvel)
                          (mp-vehicle-frame-blend 18.0))
            )
          )
        )
    )
  (none)
  )

(defun mp-vehicle-apply-ambient-ghost-correction! ((veh vehicle) (rec mp-traffic-ghost-record) (target-trans vector) (dist float))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (cond
      ((> dist (meters 15))
       (mp-vehicle-hard-snap-to-ghost! veh rec target-trans)
       )
      ((> dist (meters 0.05))
       (let ((position-rate 6.0))
         (when (> dist (meters 2))
           (set! position-rate 12.0)
           )
         (when (> dist (meters 5))
           (set! position-rate 30.0)
           )
         (vector-lerp! (-> veh root trans)
                       (-> veh root trans)
                       target-trans
                       (mp-vehicle-frame-blend position-rate))
         )
       )
      )
    (quaternion-slerp! (-> veh root quat)
                       (-> veh root quat)
                       (-> rec ghost-quat)
                       (mp-vehicle-frame-blend 6.0))
    )
  (none)
  )

(defun mp-vehicle-apply-racer-ghost-correction! ((veh vehicle) (rec mp-traffic-ghost-record) (target-trans vector) (dist float))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (if (> dist (meters 40))
        (mp-vehicle-hard-snap-to-ghost! veh rec target-trans)
        (begin
          (set! (-> veh pad-bytes 0) (the uint8 1))
          (vector-lerp! (-> veh root trans) (-> veh root trans) target-trans (mp-vehicle-frame-blend 12.0))
          (mp-vehicle-nudge-rbody-to-target! veh target-trans 300.0)
          (quaternion-slerp! (-> veh root quat) (-> veh root quat) (-> rec ghost-quat) (mp-vehicle-frame-blend 24.0))
          (when (and (-> veh rbody)
                     (nonzero? (-> veh rbody))
                     (-> veh rbody state)
                     (nonzero? (-> veh rbody state)))
            (vector-lerp! (-> veh rbody state ang-velocity)
                          (-> veh rbody state ang-velocity)
                          (-> rec ghost-angvel)
                          (mp-vehicle-frame-blend 18.0))
            )
          )
        )
    )
  (none)
  )

(defun mp-vehicle-apply-ghost-correction ((veh vehicle))
  "Smooth a puppet vehicle's rbody velocity toward the authoritative ghost position."
  (when (and veh
             (nonzero? veh)
             (nonzero? (-> veh net-id))
             (-> veh root)
             (nonzero? (-> veh root))
             (-> veh rbody)
             (nonzero? (-> veh rbody)))
    (let ((rec (mp-get-traffic-ghost (-> veh net-id))))
      (when (and rec
                 (nonzero? rec)
                 (nonzero? (-> rec last-correction-time)))
        (let ((target-trans (new 'stack-no-clear 'vector)))
          (mp-actor-traffic-predicted-trans! rec target-trans)
          (let ((dist (vector-vector-distance (-> veh root trans) target-trans)))
            (cond
              ((mp-race-vehicle-id? (-> veh net-id))
               (mp-vehicle-apply-racer-ghost-correction! veh rec target-trans dist))
              ((mp-vehicle-remote-driven? veh)
               (mp-vehicle-apply-driven-ghost-correction! veh rec target-trans dist))
              (else
               (mp-vehicle-apply-ambient-ghost-correction! veh rec target-trans dist))
              )
            )
          )
        (when (and (-> veh rbody state)
                   (nonzero? (-> veh rbody state)))
          (rigid-body-method-26 (-> veh rbody state) (-> veh root trans) (-> veh root quat))
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-common-post-sync ((this vehicle))
  "Unified synchronization logic for all vehicle post-processing methods."
  (if (not (and this (nonzero? this))) (return #f))

  (set! (-> this pad-bytes 0) (the uint8 0))
  (mp-vehicle-clear-stale-player-driver! this)
  (mp-vehicle-release-stale-player-control! this)

  (when (and (not (mp-vehicle-is-local-authoritative? this))
             (nonzero? (-> this net-id)))
    (let ((rec (mp-get-traffic-ghost (-> this net-id))))
      (when rec
        (when (= (-> rec entity-kind) (the uint8 1))
          (mp-vehicle-apply-authoritative-flight-level! this (-> rec ghost-aux-state) (nonzero? (-> rec last-seen)))
          )
        (let ((target-sym (mp-veh-get-state-from-id (the uint (-> rec ghost-state-id)))))
          (when (and (type? this vehicle-guard)
                     (mp-vehicle-guard-remote-combat-state? target-sym))
            (mp-vehicle-guard-ensure-remote-combat! (the-as vehicle-guard this))
            )

          (when (and target-sym (-> this state) (!= (-> this state name) target-sym))
            (let ((st (the-as state #f)))
              (case target-sym
                (('active) (set! st (method-of-object this active)))
                (('waiting) (set! st (method-of-object this waiting)))
                (('player-control) (set! st (method-of-object this player-control)))
                (('idle) (set! st (method-of-object this idle)))
                (('inactive) (set! st (method-of-object this inactive)))
                (('crash) (set! st (method-of-object this crash)))
                (('explode) (set! st (method-of-object this explode)))
                (('die) (set! st (method-of-object this die)))
                (('hostile) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 148))))
                (('stop-and-shoot) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 149))))
                (('slow-pursuit) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 150))))
                (('waiting-ambush) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 153))))
                )

              (when (type? this vehicle-racer)
                (case target-sym
                  (('waiting-race)
                   (set! st (method-of-object (the-as vehicle-racer this) waiting-race)))
                  (('waiting-for-start)
                   (set! st (method-of-object (the-as vehicle-racer this) waiting-for-start)))
                  (('racing)
                   (set! st (method-of-object (the-as vehicle-racer this) racing)))
                  (('race-finished)
                   (set! st (method-of-object (the-as vehicle-racer this) race-finished)))))

              (when (and st (nonzero? st))
                (set! (-> this next-state) st)
                (enter-state (the-as object st) (the-as object #f) (the-as object #f) (the-as object #f) (the-as object #f) (the-as object #f))
                )
              )
            )
          )
        )
      )

    (mp-vehicle-apply-ghost-correction this)

    (when (and (-> this state)
               (!= (-> this state name) 'player-control)
               (not (mp-race-vehicle-id? (-> this net-id))))
      (let ((rb (-> this rbody state)))
        (when rb
          (vector-reset! (-> rb lin-momentum))
          (vector-reset! (-> rb ang-momentum))
          (vector-reset! (-> rb lin-velocity))
          (vector-reset! (-> rb ang-velocity))
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-apply-neutral-input! ((this vehicle))
  "Consume a stale player-control frame without falling back to vanilla pad 1."
  (if (and this (nonzero? this))
      (let ((input (new 'stack-no-clear 'vector)))
        (set-vector! input 0.0 0.0 0.0 0.0)
        (vehicle-method-95 this (the-as vector (&-> input x)))
        #t)
      #f))

(defun mp-vehicle-apply-leased-pad-input! ((this vehicle) (pad-idx int))
  "Apply the explicit remote driver's leased pad to this vehicle."
  (when (and this
             (nonzero? this)
             (> pad-idx 0)
             (< pad-idx MP_MAX_PLAYERS)
             *cpad-list*
             (nonzero? *cpad-list*))
    (let ((pad (-> *cpad-list* cpads pad-idx)))
      (when (and pad (nonzero? pad))
        (let ((input (new 'stack-no-clear 'vector)))
          (set! (-> input x) (analog-input (the-as int (-> pad leftx)) 128.0 48.0 110.0 -1.0))
          (set! (-> input w) (analog-input (the-as int (-> pad lefty)) 128.0 48.0 110.0 -1.0))
          (set! (-> input y) (fmin 1.0 (* 0.023529412 (the float (-> pad abutton (abutton-idx x))))))
          (set! (-> input z) (fmin 1.0 (* 0.023529412 (the float (-> pad abutton (abutton-idx square))))))
          (vehicle-method-95 this (the-as vector (&-> input x))))
        (when (or (cpad-hold? pad-idx l1)
                  (and (-> this info)
                       (nonzero? (-> this info))
                       (logtest? (-> this info flags) 512)
                       (cpad-hold? pad-idx r1)))
          (start-jump this))
        (when (cpad-pressed? pad-idx circle)
          (activate-turbo-boost! this))
        (return #t))))
  #f)

(defun mp-vehicle-stale-input-release-needed? ((this vehicle))
  "Detect a lingering player-driving/player-control state with no driver claim."
  (and this
       (nonzero? this)
       (not (mp-vehicle-local-target-driving? this))
       (not (mp-vehicle-driver-sync-claimed? this))
       (or (logtest? (-> this flags) (rigid-body-object-flag player-driving))
           (and (-> this state)
                (nonzero? (-> this state))
                (= (-> this state name) 'player-control)))))

(defun mp-vehicle-run-puppet-input! ((this vehicle))
  "Run explicit remote driver input and safely consume stale control frames."
  (when (and this (nonzero? this))
    (mp-vehicle-claim-local-driver-sync! this)
    (let ((release-input? (mp-vehicle-stale-input-release-needed? this)))
      (mp-vehicle-clear-stale-player-driver! this)
      (mp-vehicle-release-stale-player-control! this)
      (let ((pad-idx (mp-vehicle-get-pad-index this))
            (remote-driver (mp-vehicle-player-record this #t)))
        (cond
          ((mp-vehicle-apply-leased-pad-input! this pad-idx)
           (return #t))
          ((and remote-driver (nonzero? remote-driver))
           (return (mp-vehicle-apply-neutral-input! this)))
          (release-input?
           (return (mp-vehicle-apply-neutral-input! this)))))))
  #f)

(defun mp-vehicle-remote-needs-physics? ((this vehicle))
  (let ((rec (mp-get-traffic-ghost (-> this net-id))))
    (if rec
        (logtest? (-> rec ghost-aux-state) MP_VEHICLE_STATE_FLAG_PHYSICS)
        (or (nonzero? (-> this net-id))
            (and (-> this state) (= (-> this state name) 'player-control))
            (mp-session-client?)
            )
        )
    )
  )

(defun mp-vehicle-apply-color-index! ((proc vehicle) (slot mp-vehicle-state))
  (when (and proc (nonzero? proc) (-> proc info) (> (-> proc info color-option-count) 0))
    (let ((state-id (-> slot state-id))
          (cur-state (if (-> proc state) (-> proc state name) 'none)))
      (when (and (!= state-id (the uint (mp-veh-state-id explode)))
                 (!= state-id (the uint (mp-veh-state-id die)))
                 (!= cur-state 'explode)
                 (!= cur-state 'die))
        (let ((color-index (mod (the-as int (-> slot color-index)) (-> proc info color-option-count))))
          (set! (-> proc draw color-mult quad) (-> proc info color-option-array color-index quad))
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-clear-seat-occupant! ((proc vehicle) (seat-index int) (replacement object))
  "Remove stale civilian occupants before a synced player claims a vehicle seat."
  (let ((client-rider-proc (get-rider-in-seat proc seat-index)))
    (when (and client-rider-proc
               (nonzero? client-rider-proc)
               (!= client-rider-proc replacement)
               (not (mp-player-process-record client-rider-proc)))
      (cond
        ((type? client-rider-proc vehicle-rider)
         (send-event client-rider-proc 'rider-off)
         (deactivate client-rider-proc)
         )
        ((type? client-rider-proc citizen)
         (send-event client-rider-proc 'traffic-off-force)
         )
        (else
         (remove-rider proc client-rider-proc)
         )
        )
      (set! (-> proc rider-array seat-index) (the-as handle #f))
      )
    )
  (none)
  )

(defun mp-vehicle-update-riders ((proc vehicle) (slot mp-vehicle-state))
  "Spawn or despawn civilian riders on a puppet vehicle to match the authoritative state."
  (dotimes (i 4)
    (let ((client-rider-proc (handle->process (-> proc rider-array i)))
          (host-rider-id (-> slot rider-player-ids i)))
      (cond
        ((and (= host-rider-id MP_VEHICLE_RIDER_CIVILIAN_ID)
              (not client-rider-proc))
         (when (and (= i 0)
                    (mp-traffic-type-loaded?
                      (the-as traffic-type (-> slot vehicle-type))))
           (let ((is-local-hijacking?
                   (and *target*
                        (nonzero? *target*)
                        (-> *target* pilot)
                        (nonzero? (-> *target* pilot))
                        (nonzero? (-> *target* pilot vehicle))
                        (= (handle->process (-> *target* pilot vehicle))
                           proc))))
             (when (not is-local-hijacking?)
               (let ((params
                       (new 'stack 'traffic-object-spawn-params)))
                 (mp-traffic-art-context!
                   'veh-rider-spawn
                   (-> slot net-id)
                   (the uint (-> slot vehicle-type))
                   (the uint (-> slot state-id)))

                 (set! (-> params object-type)
                       (the-as traffic-type (-> slot vehicle-type)))
                 (set! (-> params behavior) (the uint64 0))
                 (set! (-> params id) (the uint32 0))
                 (set! (-> params nav-mesh) #f)
                 (set! (-> params nav-branch) #f)
                 (set! (-> params proc) #f)
                 (set! (-> params handle) (the-as handle #f))
                 (set! (-> params user-data) (the uint 0))
                 (set! (-> params flags)
                       (traffic-spawn-flags
                         skip-lwide-entity-hack
                         spawn-rider))
                 (set! (-> params guard-type) (the uint8 0))

                 (set-vector!
                   (-> params position)
                   (-> slot x)
                   (-> slot y)
                   (-> slot z)
                   1.0)

                 (quaternion-set!
                   (-> params rotation)
                   (-> slot quat-x)
                   (-> slot quat-y)
                   (-> slot quat-z)
                   (-> slot quat-w))

                 (set-vector!
                   (-> params velocity)
                   0.0
                   0.0
                   0.0
                   1.0)

                 (spawn-default-vehicle-rider! proc params)
                 )
               )
             )
           )
         )
        ((and (= host-rider-id MP_INVALID_PLAYER_ID)
              client-rider-proc
              (type? client-rider-proc vehicle-rider))
         (when (and client-rider-proc
                    (nonzero? client-rider-proc)
                    (not
                      (logtest?
                        (-> client-rider-proc mask)
                        (process-mask sleep)))
                    (!= (-> client-rider-proc status) 'dead))
           (send-event client-rider-proc 'rider-off)
           (deactivate client-rider-proc)
           )
         (set! (-> proc rider-array i) (the-as handle #f))
         )
        ((and (mp-player-id-valid? host-rider-id)
              client-rider-proc
              (type? client-rider-proc vehicle-rider))
         (mp-vehicle-clear-seat-occupant!
           proc
           i
           (the-as object #f))
         )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-record-ghost-sample! ((proc vehicle) (slot mp-vehicle-state) (rec mp-traffic-ghost-record))
  "Record movement only when the network sample for this vehicle advances."
  (let ((fresh-sample? #f))
    (when (and proc
               (nonzero? proc)
               slot
               (nonzero? slot)
               rec
               (nonzero? rec)
               (nonzero? (-> slot net-id)))
      (let ((received-time (pc-multi-get-vehicle-sync-time (-> slot net-id)))
            (previous-time (-> rec last-correction-time)))
        (when (or (zero? previous-time)
                  (> received-time previous-time))
          (let ((sample-time (if (nonzero? received-time)
                                 received-time
                                 (pc-multi-get-ticks)))
                (had-remote-sample? (nonzero? (-> rec last-seen))))
            (set! (-> rec entity-kind) (the uint8 1))
            (set-vector! (-> rec ghost-trans) (-> slot x) (-> slot y) (-> slot z) 1.0)
            (quaternion-set! (-> rec ghost-quat) (-> slot quat-x) (-> slot quat-y) (-> slot quat-z) (-> slot quat-w))
            (set-vector! (-> rec ghost-linvel) (-> slot lin-vel-x) (-> slot lin-vel-y) (-> slot lin-vel-z) 0.0)
            (set-vector! (-> rec ghost-angvel) (-> slot ang-vel-x) (-> slot ang-vel-y) (-> slot ang-vel-z) 0.0)
            (when (and (!= (-> slot state-id) (the uint (mp-veh-state-id explode)))
                       (= (-> rec last-applied-state-id)
                          (the uint32 (mp-veh-state-id explode))))
              (set! (-> rec last-applied-state-id) (the uint32 0))
              )
            (set! (-> rec ghost-state-id) (-> slot state-id))
            (set! (-> rec ghost-aux-state) (-> slot state-flags))
            (set! (-> rec last-correction-time) sample-time)
            (set! (-> rec last-seen) (current-time))
            (mp-vehicle-apply-authoritative-flight-level! proc (-> rec ghost-aux-state) had-remote-sample?)
            (set! fresh-sample? #t)
            )
          )
        )
      )
    fresh-sample?
    )
  )

(defun mp-vehicle-apply-ghost-state ((proc vehicle) (slot mp-vehicle-state))
  "Update the ghost record for a vehicle from the latest remote data."
  (if (not (and proc (nonzero? proc))) (return #f))
  (if (not (and slot (nonzero? slot))) (return #f))

  (let ((local-pilot (get-rider-in-seat proc 0)))
    (when (and local-pilot
               (nonzero? local-pilot)
               *target*
               (nonzero? *target*)
               (= local-pilot *target*))
      (return #f)
      )
    )

  (when (type? proc vehicle-racer)
    (set! (-> (the-as vehicle-racer proc) respawn-protected?)
          (logtest? (-> slot state-flags)
                    MP_VEHICLE_STATE_FLAG_RESPAWN_PROTECTED)))

  (let ((rec (mp-traffic-get-or-create-ghost! (-> slot net-id) (the uint 1))))
    (when (and rec (nonzero? rec))
      (mp-vehicle-record-ghost-sample! proc slot rec)
      )
    )

  (mp-vehicle-apply-color-index! proc slot)
  (mp-vehicle-update-riders proc slot)
  (mp-vehicle-ensure-guard-minimap! proc)
  (mp-vehicle-refresh-parking-minimap! proc slot)
  (when (not (mp-vehicle-local-target-riding? proc))
    (logclear! (-> proc root penetrated-by) (penetrate jak-yellow-shot jak-red-shot jak-blue-shot jak-dark-shot))
    )
  (when (not (mp-vehicle-is-local-authoritative? proc))
    (if (> (-> slot hit-points) 0)
        (set! (-> proc hit-points) (/ (the float (-> slot hit-points)) 255.0))
        (when (or (= (-> slot state-id) (the uint (mp-veh-state-id crash)))
                  (= (-> slot state-id) (the uint (mp-veh-state-id explode)))
                  (= (-> slot state-id) (the uint (mp-veh-state-id die))))
          (set! (-> proc hit-points) 0.0)
          )
        )
    )
  (none)
)

(defun mp-vehicle-spawn-puppet ((slot mp-vehicle-state))
  (let ((spawned? #f))
    (when (and slot
               (nonzero? slot)
               (mp-is-traffic-ready?))
      (when (mp-traffic-type-loaded? (the-as traffic-type (-> slot vehicle-type)))
        (mp-traffic-art-context!
          'veh-spawn
          (-> slot net-id)
          (the uint (-> slot vehicle-type))
          (the uint (-> slot state-id)))
        (let ((params (new 'stack 'traffic-object-spawn-params)))
          (mem-set32! (the-as pointer params) 0 (/ (size-of traffic-object-spawn-params) 4))
          (set! (-> params object-type) (the-as traffic-type (-> slot vehicle-type)))
          (set! (-> params behavior) (the uint64 0))
          (set! (-> params id) (the uint32 0))
          (set! (-> params net-id) (-> slot net-id))
          (set! (-> params nav-mesh) #f)
          (set! (-> params nav-branch) #f)
          (set! (-> params proc) #f)
          (set! (-> params handle) (the-as handle #f))
          (set! (-> params user-data) (the uint 0))
          (set! (-> params guard-type) (the uint8 0))
          (set-vector! (-> params position) (-> slot x) (-> slot y) (-> slot z) 1.0)
          (quaternion-set! (-> params rotation) (-> slot quat-x) (-> slot quat-y) (-> slot quat-z) (-> slot quat-w))
          (set-vector! (-> params velocity) 0.0 0.0 0.0 1.0)
          (set! (-> params nav-branch) (mp-vehicle-find-spawn-branch params))

          (if (mp-vehicle-param-nav-branch-ready? params)
              (begin
                (when *mp-traffic-art-context-riding*
                  (mp-vehicle-log-spawn-params! 'before-spawn slot params)
                  )
                (if (= (-> slot rider-player-ids 0) MP_VEHICLE_RIDER_CIVILIAN_ID)
                    (set! (-> params flags) (traffic-spawn-flags spawn-rider))
                    (set! (-> params flags) (the-as traffic-spawn-flags 0))
                    )
                (let ((proc (traffic-object-spawn (the-as process *traffic-manager*) params)))
                  (if (and proc (nonzero? proc) (type? proc vehicle))
                      (begin
                        (set! (-> (the-as vehicle proc) pad-bytes 1) (the uint8 0))
                        (mp-vehicle-apply-color-index! (the-as vehicle proc) slot)
                        (mp-vehicle-ensure-guard-minimap! (the-as vehicle proc))
                        (mp-vehicle-refresh-parking-minimap! (the-as vehicle proc) slot)
                        (if (> (-> slot hit-points) 0)
                            (set! (-> (the-as vehicle proc) hit-points) (/ (the float (-> slot hit-points)) 255.0))
                            (set! (-> (the-as vehicle proc) hit-points) 1.0)
                            )
                        (set! spawned? #t)
                        )
                      (mp-vehicle-log-spawn-params! 'spawn-failed slot params)
                      )
                    )
                )
              (mp-vehicle-log-skipped-spawn! slot params)
              )
          )
        )
      )
    spawned?
    )
)

(defun mp-vehicle-can-spawn-puppet? ((net-id uint))
  "Most mission vehicles are task-owned locally; city-shuttle needs a puppet if the client has no task copy."
  (and (nonzero? net-id)
       (or (= net-id MP_MISSION_VEHICLE_CITY_SHUTTLE)
           (not (mp-mission-vehicle-id? net-id))))
  )

(defun mp-vehicle-apply-player-piggyback ((record mp-player-record))
  "Apply one remote record's independently owned vehicle state."
  (when (or (not record)
            (zero? record))
    (return #f))
  (mp-vehicle-update-authority-handoff! record)
  (let ((spawn-ready? (mp-is-traffic-spawn-ready?))
        (driven-net-id (-> record vehicle state net-id))
        (old-veh (mp-player-record-current-vehicle record)))
    (when (and (nonzero? (-> record runtime vehicle-handle))
               (or (not old-veh)
                   (zero? old-veh)
                   (!= driven-net-id (-> (the-as vehicle old-veh) net-id))))
      (when (and old-veh (nonzero? old-veh))
        (mp-vehicle-clear-stale-player-driver! (the-as vehicle old-veh))
        (mp-vehicle-release-stale-player-control! (the-as vehicle old-veh))
        )
      (set! (-> record runtime vehicle-handle) (the-as handle #f))
      )
    (when (nonzero? driven-net-id)
      (let ((proc (mp-vehicle-find-by-net-id driven-net-id))
            (vehicle-can-spawn? (mp-vehicle-can-spawn-puppet? driven-net-id)))
        (if (and proc (nonzero? proc))
            (begin
              (set! (-> record runtime vehicle-handle) (process->handle proc))
              (logior! (-> proc flags) (rigid-body-object-flag persistent))
              (logclear! (-> proc mask) (process-mask pause sleep actor-pause))
              (if (<= (-> record vehicle state state-id) 2)
                  (when vehicle-can-spawn?
                    (mp-vehicle-force-cull-local! proc)
                    )
                  (begin
                    (mp-vehicle-apply-ghost-state proc (-> record vehicle state))
                    (when spawn-ready?
                      (mp-vehicle-ensure-guard-minimap! proc)
                      )
                    )
                  )
            )
            (when (and spawn-ready?
                       vehicle-can-spawn?
                       (> (-> record vehicle state state-id) 2)
                       (not (mp-player-runtime-flag?
                              record (mp-player-runtime-flags was-far))))
              (debug-log *mp-debug-log?*
                "[MP-Traffic] Missing player ~D vehicle ~D; spawning.~%"
                (-> record identity player-id) driven-net-id)
              (when (mp-vehicle-spawn-puppet (-> record vehicle state))
                (let ((spawned-vehicle
                        (mp-vehicle-find-by-net-id driven-net-id)))
                  (when (and spawned-vehicle (nonzero? spawned-vehicle))
                    (set! (-> record runtime vehicle-handle)
                          (process->handle spawned-vehicle)))))
            )
          )
        )
      )
    (when (zero? driven-net-id)
      (set! (-> record runtime vehicle-handle) (the-as handle #f))
      )
    (when (and old-veh (nonzero? old-veh))
      (mp-vehicle-release-stale-player-control! (the-as vehicle old-veh))
      )
    )
  (none)
)

(defun mp-vehicle-apply-piggyback ()
  (mp-for-each-player-record (player-id record)
    (when (mp-player-record-remote? *mp-player-controller* record)
      (mp-vehicle-apply-player-piggyback record)))
  (none))

(defun mp-vehicle-apply-race-remote ()
  "Apply authoritative race samples only to race vehicles already spawned by the race manager."
  (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
    (let ((slot (-> *mp-traffic-buffer* veh-enemies i)))
      (when (and (nonzero? (-> slot net-id))
                 (mp-race-vehicle-id? (-> slot net-id))
                 (not (mp-vehicle-net-id-player-driven? (-> slot net-id) #f)))
        (let ((proc (mp-race-vehicle-find-by-net-id (-> slot net-id))))
          (when (and proc (nonzero? proc))
            (mp-vehicle-apply-ghost-state proc slot)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-vehicle-apply-remote ()
  (let ((spawn-budget 2))
    (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
      (let ((slot (-> *mp-traffic-buffer* veh-enemies i)))
        (when (and (nonzero? (-> slot net-id))
                   (mp-traffic-slot-locally-admitted? (-> slot level-id))
                   (not (mp-vehicle-net-id-player-driven?
                          (-> slot net-id) #f)))
          (mp-vehicle-complete-authority-handoff-if-fresh! (-> slot net-id))
          (when (not (mp-vehicle-authority-handoff-active? (-> slot net-id)))
            (let ((proc (mp-vehicle-find-by-net-id (-> slot net-id))))
              (if (and proc (nonzero? proc))
                  (if (<= (-> slot state-id) 2)
                      (begin
                        (mp-vehicle-force-cull-local! proc)
                        )
                      (begin
                        (mp-vehicle-apply-ghost-state proc slot)
                        (mp-vehicle-ensure-guard-minimap! proc)
                        )
                      )
                  (when (and (> spawn-budget 0)
                             (mp-traffic-level-materialization-ready? (-> slot level-id))
                             (> (-> slot state-id) 2)
                             (mp-vehicle-can-spawn-puppet? (-> slot net-id)))
                    (when (mp-vehicle-spawn-puppet slot)
                      (-! spawn-budget 1)
                      )
                    )
                  )
              )
            )
          )
        )
      )
    (when (and *traffic-manager*
               (nonzero? *traffic-manager*)
               (not (mp-is-traffic-authoritative?)))
      (let ((curr (-> *traffic-manager* child)))
        (while (and curr (nonzero? curr))
          (let ((proc (ppointer->process curr)))
            (let ((next-ptr (-> curr 0 brother)))
              (when (and proc
                         (nonzero? proc)
                         (type? proc vehicle)
                         (nonzero? (-> (the-as vehicle proc) net-id)))
                (let ((found-in-buffer? #f)
                      (v-net-id (-> (the-as vehicle proc) net-id)))
                  (cond
                    ((or (mp-player-record-by-vehicle-id v-net-id)
                         (mp-vehicle-authority-handoff-pending? v-net-id))
                     (set! found-in-buffer? #t)
                     )
                    ((not (mp-vehicle-authority-handoff-active? v-net-id))
                     (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
                       (when (and (= (-> *mp-traffic-buffer* veh-enemies i net-id) v-net-id)
                                  (mp-traffic-slot-locally-admitted?
                                    (-> *mp-traffic-buffer* veh-enemies i level-id)))
                         (set! found-in-buffer? #t)))
                     )
                    )
                  (when (not found-in-buffer?)
                    (mp-vehicle-force-cull-local! (the-as vehicle proc))
                    (mp-vehicle-clear-authority-handoff! v-net-id)
                    )
                  )
                )
              (set! curr next-ptr)
              )
            )
          )
        )
      )
    )
  (none)
)

