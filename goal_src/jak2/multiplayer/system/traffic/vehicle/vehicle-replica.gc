;;-*-Lisp-*-
(in-package goal)

(define MP_VEHICLE_PARKING_MINIMAP_ATTACHED (the uint8 173))
(define MP_VEHICLE_AUTHORITY_HANDOFF_GRACE (seconds 1))
(define MP_MAX_VEHICLE_AUTHORITY_HANDOFFS 8)
(define *mp-race-vehicle-handles* (new 'static 'array handle 10))

(deftype mp-vehicle-authority-handoff (structure)
  ((net-id                uint32)
   (start-time            time-frame)
   (last-owner-generation uint64))
  :size-assert 24)

(define-perm *mp-vehicle-authority-handoffs*
             (inline-array mp-vehicle-authority-handoff)
             (new 'static 'inline-array mp-vehicle-authority-handoff 8))
(define *mp-vehicle-last-driver-net-ids* (new 'static 'array uint32 MP_MAX_PLAYERS))

(defun mp-vehicle-clear-authority-handoff-record! ((handoff mp-vehicle-authority-handoff))
  (when (and handoff (nonzero? handoff))
    (set! (-> handoff net-id) (the uint32 0))
    (set! (-> handoff start-time) 0)
    (set! (-> handoff last-owner-generation) (the uint64 0)))
  (none))

(defun mp-vehicle-authority-handoff-record ((net-id uint))
  (when (and (nonzero? net-id) *mp-vehicle-authority-handoffs* (nonzero? *mp-vehicle-authority-handoffs*))
    (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
      (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
        (when (and handoff (nonzero? handoff) (= (-> handoff net-id) net-id))
          (return handoff)))))
  (the-as mp-vehicle-authority-handoff #f))

(defun mp-vehicle-reset-authority-handoffs! ()
  (dotimes (player-id MP_MAX_PLAYERS)
    (set! (-> *mp-vehicle-last-driver-net-ids* player-id) (the uint32 0)))
  (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
    (mp-vehicle-clear-authority-handoff-record! (-> *mp-vehicle-authority-handoffs* slot-idx)))
  (none))

(defun mp-vehicle-begin-authority-handoff! ((net-id uint))
  (when (and (nonzero? net-id) (not (mp-vehicle-authority-handoff-record net-id)))
    (let ((free-handoff (the-as mp-vehicle-authority-handoff #f)))
      (dotimes (slot-idx MP_MAX_VEHICLE_AUTHORITY_HANDOFFS)
        (let ((handoff (-> *mp-vehicle-authority-handoffs* slot-idx)))
          (when (and (not free-handoff) handoff (nonzero? handoff) (zero? (-> handoff net-id)))
            (set! free-handoff handoff))))
      (when (and free-handoff (nonzero? free-handoff))
        (let ((generation (if (nonnull? *mp-replication-state*) (the-as uint64 (-> *mp-replication-state* remote traffic generation)) (the uint64 0))))
          (set! (-> free-handoff net-id) net-id)
          (set! (-> free-handoff start-time) (current-time))
          (set! (-> free-handoff last-owner-generation) generation)))))
  (none))

(defun mp-vehicle-update-authority-handoff! ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((player-id (-> record identity player-id)))
      (when (< player-id (the uint MP_MAX_PLAYERS))
        (let* ((previous-net-id (-> *mp-vehicle-last-driver-net-ids* player-id))
               (current-net-id (-> record vehicle state net-id)))
          (when (!= previous-net-id current-net-id)
            (when (nonzero? previous-net-id)
              (mp-vehicle-begin-authority-handoff! previous-net-id))
            (set! (-> *mp-vehicle-last-driver-net-ids* player-id) current-net-id))))))
  (none))

(defun mp-vehicle-complete-authority-handoff-if-fresh! ((net-id uint))
  (let ((handoff (mp-vehicle-authority-handoff-record net-id))
        (generation (if (nonnull? *mp-replication-state*) (the-as uint64 (-> *mp-replication-state* remote traffic generation)) (the uint64 0))))
    (when (and handoff (nonzero? handoff) (nonzero? generation) (!= generation (-> handoff last-owner-generation)))
      (mp-vehicle-clear-authority-handoff-record! handoff)))
  (none))

(defun mp-vehicle-authority-handoff-pending? ((net-id uint))
  (let ((handoff (mp-vehicle-authority-handoff-record net-id)))
    (and handoff (nonzero? handoff) (not (time-elapsed? (-> handoff start-time) MP_VEHICLE_AUTHORITY_HANDOFF_GRACE)))))

(defun mp-race-vehicle-register! ((racer-index int) (vehicle vehicle))
  (when (and (>= racer-index 0)
             (< racer-index MP_MAX_RACE_VEHICLES)
             vehicle
             (nonzero? vehicle)
             *mp-race-vehicle-handles*
             (nonzero? *mp-race-vehicle-handles*))
    (set! (-> *mp-race-vehicle-handles* racer-index) (process->handle vehicle)))
  (none))

(defun mp-race-vehicle-find-by-net-id ((net-id uint))
  (when (mp-race-vehicle-id? net-id)
    (let ((racer-index (mp-race-vehicle-racer-index net-id)))
      (when (and (>= racer-index 0)
                 (< racer-index MP_MAX_RACE_VEHICLES)
                 *mp-race-vehicle-handles*
                 (nonzero? *mp-race-vehicle-handles*))
        (let ((vehicle (handle->process-safe (-> *mp-race-vehicle-handles* racer-index))))
          (when (and vehicle (nonzero? vehicle) (= (-> (the-as vehicle vehicle) net-id) net-id))
            (return (the-as vehicle vehicle)))))))
  (the-as vehicle #f))

(defun mp-race-clear-vehicle-handles! ()
  (dotimes (i MP_MAX_RACE_VEHICLES)
    (set! (-> *mp-race-vehicle-handles* i) (the-as handle #f)))
  (none))

(defun mp-vehicle-param-nav-branch-ready? ((params traffic-object-spawn-params))
  (and params (nonzero? params) (-> params nav-branch) (nonzero? (the-as uint (-> params nav-branch)))))

(defun mp-vehicle-find-spawn-branch ((params traffic-object-spawn-params))
  (let ((branch (the-as nav-branch #f)))
    (when (and params (nonzero? params) *traffic-engine* (nonzero? (the-as uint *traffic-engine*)))
      (let ((facing-dir (vector-z-quaternion! (new 'stack-no-clear 'vector) (-> params rotation))))
        (let ((seg (find-best-segment *traffic-engine* (-> params position) facing-dir 1)))
          (when (and seg (nonzero? seg) (-> seg branch) (nonzero? (the-as uint (-> seg branch))))
            (set! branch (-> seg branch))))))
    (when (not branch)
      (set! branch (mp-traffic-fallback-spawn-branch)))
    branch))

(defun mp-vehicle-local-pilot ((veh vehicle))
  (when (and veh (nonzero? veh) *target* (nonzero? *target*) (focus-test? *target* pilot))
    (let ((pilot-info (-> *target* pilot)))
      (when (and pilot-info (nonzero? pilot-info))
        (let ((vehicle-proc (handle->process-safe (-> pilot-info vehicle))))
          (when (and vehicle-proc (nonzero? vehicle-proc) (type? vehicle-proc vehicle) (= vehicle-proc veh))
            (return pilot-info))))))
  (the-as pilot-info #f))

(defun mp-vehicle-local-target-driving? ((veh vehicle))
  (let ((pilot-info (mp-vehicle-local-pilot veh)))
    (and pilot-info (nonzero? pilot-info) (zero? (-> pilot-info seat-index)))))

(defun mp-vehicle-local-target-riding? ((veh vehicle))
  (let ((pilot-info (mp-vehicle-local-pilot veh))) (and pilot-info (nonzero? pilot-info))))

(defun mp-vehicle-player-driving? ((veh vehicle))
  (when (and veh (nonzero? veh))
    (when (mp-vehicle-local-target-driving? veh)
      (return #t))
    (let ((record (mp-player-driver-record-by-vehicle-id (-> veh net-id))))
      (when (and record (nonzero? record) (is-record-remote-player? record))
        (let ((driver-target (mp-player-record-target record)))
          (when (and driver-target (nonzero? driver-target) (= (get-rider-in-seat veh 0) driver-target))
            (return #t))))))
  #f)

(defun mp-any-remote-players-driving? ()
  (mp-for-each-player-target (player-id record replica)
    (when (and (is-record-remote-player? record)
               (focus-test? replica pilot)
               (-> replica pilot)
               (nonzero? (-> replica pilot))
               (zero? (-> replica pilot seat-index)))
      (let ((vehicle-process (handle->process-safe (-> replica pilot vehicle))))
        (when (and vehicle-process
                   (nonzero? vehicle-process)
                   (type? vehicle-process vehicle)
                   (= record (mp-player-driver-record-by-vehicle-id (-> (the-as vehicle vehicle-process) net-id))))
          (return #t)))))
  (the-as symbol #f))

(defun mp-vehicle-clear-stale-player-driver! ((veh vehicle))
  (when (and veh (nonzero? veh))
    (let ((driver (get-rider-in-seat veh 0)))
      (when (and driver (nonzero? driver))
        (let ((record (mp-player-process-record driver)))
          (when (and record
                     (nonzero? record)
                     (not (if (= (-> record identity player-id) (mp-local-player-id))
                            (mp-vehicle-local-target-driving? veh)
                            (= record (mp-player-driver-record-by-vehicle-id (-> veh net-id))))))
            (put-rider-in-seat veh 0 (the-as process-focusable #f)))))))
  (none))

(defun mp-vehicle-release-stale-player-control! ((veh vehicle))
  (when (and veh
             (nonzero? veh)
             (-> veh state)
             (nonzero? (-> veh state))
             (= (-> veh state name) 'player-control)
             (not (mp-player-driver-record-by-vehicle-id (-> veh net-id)))
             (not (mp-vehicle-local-target-driving? veh)))
    (let ((current-pilot (get-rider-in-seat veh 0)))
      (if current-pilot (send-event veh 'change-state 'active) (send-event veh 'change-state 'waiting))
      (when (and (-> veh next-state) (nonzero? (-> veh next-state)) (= (-> veh next-state name) 'player-control))
        (set! (-> veh next-state) (the-as state #f)))))
  (none))

(defun mp-vehicle-ensure-guard-minimap! ((veh vehicle))
  (when (and veh (nonzero? veh) (type? veh vehicle-guard) *minimap* (nonzero? *minimap*))
    (turn-traffic-vehicle-on! (the-as vehicle-guard veh)))
  (none))

(defun mp-vehicle-remove-guard-minimap! ((veh vehicle))
  (when (and veh (nonzero? veh) (type? veh vehicle-guard))
    (turn-traffic-vehicle-off! (the-as vehicle-guard veh)))
  (none))

(defun mp-vehicle-slot-parking-minimap? ((slot mp-vehicle-state))
  (and slot (nonzero? slot) (logtest? (-> slot state-flags) MP_VEHICLE_STATE_FLAG_PARKING_MINIMAP)))

(defun vehicle-parking-minimap? ((veh vehicle))
  (if (and veh (nonzero? veh) (= (-> veh pad-bytes 1) MP_VEHICLE_PARKING_MINIMAP_ATTACHED)) #t #f))

(defun mp-vehicle-ensure-parking-minimap! ((veh vehicle))
  (when (and veh
             (nonzero? veh)
             *minimap*
             (nonzero? *minimap*)
             (or (not (-> veh is-parked?)) (zero? (-> veh is-parked?))))
    (let ((conn (add-icon! *minimap* veh (the-as uint (minimap-class parking-spot)) (the-as int #f) (the-as vector #t) 0)))
      (when (and conn (nonzero? conn))
        (set! (-> veh is-parked?) #t)
        (set! (-> veh pad-bytes 1) MP_VEHICLE_PARKING_MINIMAP_ATTACHED))))
  (none))

(defun mp-vehicle-remove-parking-minimap! ((veh vehicle))
  (when (and veh (nonzero? veh) *minimap* (nonzero? *minimap*))
    (let ((curr (the-as connection-pers (-> *minimap* engine alive-list))))
      (while curr
        (let ((conn (the-as connection-minimap curr)))
          (let ((handle (handle->process-safe (-> conn handle))))
            (when (and handle (nonzero? handle) (type? handle vehicle))
              (let ((minimap-veh (the-as vehicle handle)))
                (when (= (-> veh net-id) (-> minimap-veh net-id))
                  (logior! (-> conn flags) (minimap-flag fade-out))
                  (set! conn #f))))))
        (set! curr (-> curr next))))
    (set! (-> veh pad-bytes 1) (the uint8 0))
    (set! (-> veh is-parked?) #f))
  (none))

(defun mp-vehicle-force-cull-local! ((veh vehicle))
  (when (and veh (nonzero? veh) (not (mp-vehicle-local-target-riding? veh)))
    (let ((owner-record (mp-player-driver-record-by-vehicle-id (-> veh net-id))))
      (when (and owner-record (nonzero? owner-record) (is-record-remote-player? owner-record))
        (set! (-> owner-record runtime vehicle-handle) (the-as handle #f))))
    (mp-vehicle-remove-guard-minimap! veh)
    (mp-vehicle-remove-parking-minimap! veh)
    (dotimes (seat-index 4)
      (mp-vehicle-clear-seat-occupant! veh seat-index (the-as object #f)))
    (logclear! (-> veh flags)
               (rigid-body-object-flag persistent
                                       player-driving
                                       riding
                                       ai-driving
                                       alert
                                       in-pursuit
                                       target-in-sight
                                       rammed-target))
    (set! (-> veh net-id) (the uint 0))
    (send-event veh 'traffic-off-force)
    (deactivate veh))
  (none))

(defun mp-vehicle-refresh-parking-minimap! ((veh vehicle) (slot mp-vehicle-state))
  (when (and veh (nonzero? veh))
    (let ((slot-state-id (if (and slot (nonzero? slot)) (the uint (-> slot state-id)) (the uint 0))))
      (cond
        ((mp-vehicle-local-target-riding? veh)
         (when (vehicle-parking-minimap? veh)
           (mp-vehicle-remove-parking-minimap! veh)))
        ((not (mp-is-traffic-spawn-ready?)))
        (else
         (when (and (mp-vehicle-slot-parking-minimap? slot)
                    (or (not (-> veh is-parked?)) (zero? (-> veh is-parked?)))
                    (= slot-state-id (the uint 4)))
           (mp-vehicle-ensure-parking-minimap! veh))
         (when (and (vehicle-parking-minimap? veh) (!= slot-state-id (the uint 4)))
           (mp-vehicle-remove-parking-minimap! veh))))))
  (none))

(defun mp-vehicle-remote-driven? ((veh vehicle))
  (when (and veh (nonzero? veh))
    (let ((record (mp-player-driver-record-by-vehicle-id (-> veh net-id))))
      (when (and record (nonzero? record) (is-record-remote-player? record))
        (return #t))))
  #f)

(defun mp-vehicle-is-local-authoritative? ((veh vehicle))
  (if (and veh (nonzero? veh))
    (let ((flags (-> veh flags)))
      (cond
        ((mp-vehicle-remote-driven? veh) #f)
        ((and (logtest? flags (rigid-body-object-flag player-driving)) (mp-vehicle-local-target-driving? veh)) #t)
        ((mp-race-vehicle-id? (-> veh net-id)) (mp-session-host?))
        (else *mp-traffic-local-authoritative?*)))
    #f))

(defun mp-should-apply-vehicle-camera? ((veh vehicle))
  (cond
    ((mp-vehicle-local-target-riding? veh) #t)
    (else (mp-vehicle-is-local-authoritative? veh))))

(defun mp-vehicle-find-by-net-id ((net-id uint))
  (let ((found-proc (the-as vehicle #f)))
    (when (and *traffic-manager* (nonzero? net-id))
      (let ((curr (-> *traffic-manager* child)))
        (while (and curr (nonzero? curr))
          (let ((proc (ppointer->process curr)))
            (when (and proc (type? proc vehicle) (= (-> (the-as vehicle proc) net-id) net-id))
              (set! found-proc (the-as vehicle proc))
              (set! curr (the-as (pointer process-tree) #f)))
            (if curr (set! curr (-> curr 0 brother)))))))
    (when (and (not found-proc) (mp-mission-vehicle-id? net-id))
      (set! found-proc (mp-mission-vehicle-find-by-net-id net-id)))
    (when (and (not found-proc) (mp-race-vehicle-id? net-id))
      (set! found-proc (mp-race-vehicle-find-by-net-id net-id)))
    found-proc))

(defun mp-vehicle-play-flight-level-sound! ((veh vehicle))
  (when (and veh (nonzero? veh))
    (let ((veh-root (-> veh root)))
      (when (and veh-root (nonzero? veh-root))
        (if (zero? (-> veh mp-flight-level-index))
          (sound-play-by-spec (static-sound-spec "bike-down" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                              (new-sound-id)
                              (-> veh-root trans))
          (sound-play-by-spec (static-sound-spec "bike-up" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                              (new-sound-id)
                              (-> veh-root trans))))))
  (none))

(defun mp-vehicle-apply-authoritative-flight-level! ((veh vehicle) (state-flags uint) (play-sound? symbol))
  (when (and veh (nonzero? veh))
    (let ((initial-index (-> veh mp-flight-level-index)))
      (if (logtest? state-flags MP_VEHICLE_STATE_FLAG_HIGH_FLIGHT)
        (begin
          (set! (-> veh flight-level-index) 1)
          (set! (-> veh flight-level-index-prev) 1)
          (set! (-> veh mp-flight-level-index) 1)
          (logior! (-> veh flags) (rigid-body-object-flag on-flight-level)))
        (begin
          (set! (-> veh flight-level-index) 0)
          (set! (-> veh flight-level-index-prev) 0)
          (set! (-> veh mp-flight-level-index) 0)
          (logclear! (-> veh flags) (rigid-body-object-flag on-flight-level))))
      (when (and play-sound?
                 (logtest? (-> veh flags) (rigid-body-object-flag player-driving))
                 (!= initial-index (-> veh mp-flight-level-index)))
        (mp-vehicle-play-flight-level-sound! veh)))
    (logclear! (-> veh flags) (rigid-body-object-flag flight-level-transition flight-level-transition-ending))
    (disable-rapid-camera-tracking veh)
    (none))
  (none))

(defun mp-vehicle-refuse-traffic-off? ((veh vehicle))
  (when (nonnull? veh)
    (dotimes (seat-index 4)
      (let ((rider (get-rider-in-seat veh seat-index)))
        (when (and (nonnull? rider)
                   (type? rider target)
                   (or (= rider *target*) (mp-player-id-valid? (the uint (-> (the-as target rider) player-id)))))
          (return #t))))
    (let ((v-net-id (-> veh net-id)))
      (when (or (mp-vehicle-local-target-riding? veh)
                (mp-player-record-by-vehicle-id v-net-id)
                (mp-vehicle-authority-handoff-pending? v-net-id))
        (return #t))))
  #f)

(defun mp-vehicle-send-attack-event! ((this vehicle) (attacker process) (arg3 event-message-block))
  (let ((net-id (-> this net-id)))
    (when (nonzero? net-id)
      (let ((info (mp-actor-event-attack-info arg3)))
        (let ((auth-player-id (the uint *mp-traffic-selected-authority-id*))
              (driver-rec (mp-player-driver-record-by-vehicle-id net-id)))
          (when (and driver-rec (nonzero? driver-rec) (is-record-remote-player? driver-rec))
            (set! auth-player-id (-> driver-rec identity player-id)))
          (when (< auth-player-id (the uint MP_MAX_PLAYERS))
            (let* ((penetrate (if (and info (nonzero? info))
                                (-> info penetrate-using)
                                (if (and attacker (nonzero? attacker) (type? attacker process-drawable))
                                  (get-penetrate-using-from-attack-event (the-as process-drawable attacker) arg3)
                                  (the-as penetrate 0))))
                   (attack-id (if (and info (nonzero? info)) (-> info id) (the uint 0)))
                   (details (new 'stack-no-clear 'mp-ped-attack-event-data)))
              (set! (-> details net-id) net-id)
              (set! (-> details attack-id) attack-id)
              (set! (-> details flags) 0)
              (set! (-> details knocked-type) (the-as uint8 0))
              (set! (-> details new-hp) (the int (* 255.0 (-> this hit-points))))
              (set! (-> details shove-back) (meters 0))
              (set! (-> details shove-up) (meters 0))
              (set! (-> details hit-sound-id) (the-as uint8 0))
              (set! (-> details penetrate) (the-as uint64 penetrate))
              (set! (-> details traffic-authority-player-id) (the-as uint8 auth-player-id))
              (if (and attacker
                       (nonzero? attacker)
                       (type? attacker process-drawable)
                       (-> (the-as process-drawable attacker) root))
                (begin
                  (set! (-> details source-pos quad) (-> (the-as process-drawable attacker) root trans quad))
                  (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS))
                (set! (-> details source-pos quad) (-> this root trans quad)))
              (if (and info (nonzero? info) (logtest? (attack-mask vector) (-> info mask)))
                (begin
                  (set! (-> details attack-dir quad) (-> info vector quad))
                  (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_DIRECTION))
                (begin
                  (vector-! (-> details attack-dir) (-> this root trans) (-> details source-pos))
                  (set! (-> details attack-dir y) 0.0)
                  (vector-xz-normalize! (-> details attack-dir) 1.0)
                  (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_DIRECTION)))
              (mp-event-enqueue-actor-attack! MP_EVENT_ATTACK_PED details)))))))
  (none))

(defun mp-vehicle-apply-remote-attack! ((evt mp-actor-attack-event))
  (when (or (not (nonnull? evt)) (zero? evt))
    (return #f))
  (let ((v-proc (mp-vehicle-find-by-net-id (-> evt payload net-id))))
    (when (and v-proc (nonzero? v-proc))
      (let ((attacker (mp-player-target-by-id (-> evt source-player-id))))
        (when (and attacker (nonzero? attacker))
          (let ((atk (new 'stack-no-clear 'attack-info)))
            (set! (-> atk id) (-> evt payload attack-id))
            (set! (-> atk mask) (attack-mask id vector penetrate-using))
            (set! (-> atk penetrate-using) (the-as penetrate (-> evt payload penetrate)))
            (set! (-> atk vector quad) (-> evt payload attack-dir quad))
            (send-event v-proc 'attack #f atk))))))
  (none))

(defun mp-vehicle-handle-traffic-off! ((this vehicle))
  (when (nonnull? this)
    (when (mp-vehicle-refuse-traffic-off? this)
      (return 'refused))
    (when (not *mp-traffic-local-authoritative?*)
      (set! (-> this net-id) (the uint 0))
      (deactivate this)
      (return 'deactivated)))
  #f)

(defun mp-vehicle-guard-clear-combat! ((veh vehicle-guard))
  (when (and veh (nonzero? veh))
    (set! (-> veh flags)
          (the-as rigid-body-object-flag
                  (logclear (-> veh flags) (rigid-body-object-flag alert in-pursuit target-in-sight rammed-target))))
    (end-vehicle-pursuit! veh)
    (when (and (-> veh next-state)
               (or (= (-> veh next-state name) 'hostile)
                   (= (-> veh next-state name) 'stop-and-shoot)
                   (= (-> veh next-state name) 'slow-pursuit)
                   (= (-> veh next-state name) 'waiting-ambush)))
      (set! (-> veh next-state) (the-as state #f))))
  (none))

(defun mp-vehicle-guard-remote-combat-state? ((state-sym symbol))
  (or (= state-sym 'hostile) (= state-sym 'stop-and-shoot) (= state-sym 'slow-pursuit) (= state-sym 'waiting-ambush)))

(defun mp-client-vehicle-local-net-id-base ()
  (mp-traffic-build-net-id MP_CLIENT_VEHICLE_NET_ID_BASE (mp-local-player-id) (the uint 0)))

(defun mp-client-vehicle-net-id-in-range? ((net-id uint))
  (let ((local-base (mp-client-vehicle-local-net-id-base)))
    (and (nonzero? local-base) (>= net-id local-base) (< net-id (+ local-base (the uint #x01000000))))))

(defun mp-client-vehicle-next-net-id ()
  (let ((local-base (mp-client-vehicle-local-net-id-base))
        (attempts 0)
        (candidate *mp-client-vehicle-net-id-counter*))
    (when (zero? local-base)
      (return (the uint 0)))
    (while (< attempts 1024)
      (when (not (mp-client-vehicle-net-id-in-range? candidate))
        (set! candidate local-base))
      (set! *mp-client-vehicle-net-id-counter* (+ candidate 1))
      (when (not (mp-client-vehicle-net-id-in-range? *mp-client-vehicle-net-id-counter*))
        (set! *mp-client-vehicle-net-id-counter* local-base))
      (when (not (mp-vehicle-find-by-net-id candidate))
        (return candidate))
      (set! candidate *mp-client-vehicle-net-id-counter*)
      (+! attempts 1))
    (the uint 0)))

(defun mp-vehicle-promote-local-driver! ((veh vehicle))
  (when (and veh
             (nonzero? veh)
             (mp-session-client?)
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             (zero? (-> veh net-id))
             (mp-vehicle-local-target-driving? veh))
    (let ((new-net-id (mp-client-vehicle-next-net-id)))
      (when (nonzero? new-net-id)
        (set! (-> veh net-id) new-net-id)
        (logior! (-> veh flags) (rigid-body-object-flag persistent player-driving riding))
        (logclear! (-> veh flags) (rigid-body-object-flag ai-driving alert in-pursuit target-in-sight rammed-target))
        (set! (-> veh pad-index) (the-as uint (-> *target* control cpad number))))))
  (none))

(defun mp-vehicle-claim-local-driver-sync! ((veh vehicle))
  (when (and veh
             (nonzero? veh)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             (nonzero? (-> veh net-id))
             (mp-vehicle-local-target-driving? veh))
    (set! (-> (mp-local-player-record) vehicle vehicle-id) (-> veh net-id))
    (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 0))
    (mp-vehicle-pack veh (-> (mp-local-player-record) vehicle state))
    (logior! (-> veh flags) (rigid-body-object-flag player-driving riding))
    (logclear! (-> veh flags) (rigid-body-object-flag ai-driving alert in-pursuit target-in-sight rammed-target))
    (set! (-> veh pad-index) (the-as uint (-> *target* control cpad number))))
  (none))

(defun mp-vehicle-pack-local-crash-snapshot? ()
  (let ((record (mp-local-player-record))
        (veh (the-as vehicle #f)))
    (when (and record (nonzero? record) (nonzero? (-> record vehicle state net-id)))
      (set! veh (mp-vehicle-find-by-net-id (-> record vehicle state net-id)))
      (when (and veh (nonzero? veh) (-> veh state) (nonzero? (-> veh state)) (= (-> veh state name) 'crash))
        (mp-vehicle-pack veh (-> record vehicle state))
        (return #t))))
  #f)

(defun mp-vehicle-explode-already-applied? ((veh vehicle))
  (let ((applied? #f))
    (when (and veh (nonzero? veh) (nonzero? (-> veh net-id)))
      (let ((rec (get-traffic-record (-> veh net-id))))
        (when (and rec
                   (nonzero? rec)
                   (= (-> rec entity-kind) (the uint8 1))
                   (= (-> rec last-applied-state-id) (the uint32 (mp-veh-state-id explode))))
          (set! applied? #t))))
    applied?))

(defun mp-vehicle-mark-explode-applied! ((veh vehicle))
  (when (and veh (nonzero? veh) (nonzero? (-> veh net-id)))
    (let ((rec (get-traffic-record (-> veh net-id))))
      (when (and rec (nonzero? rec) (= (-> rec entity-kind) (the uint8 1)))
        (set! (-> rec last-applied-state-id) (the uint32 (mp-veh-state-id explode))))))
  (none))

(defun mp-vehicle-pack-local-player-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (focus-test? *target* pilot)
             (nonzero? (-> *target* pilot))
             (nonzero? (-> *target* pilot vehicle))
             (-> *target* state)
             (nonzero? (-> *target* state))
             (not (mp-target-death-state? (-> *target* state name)))
             (!= (-> *target* state name) 'target-pilot-get-off)
             (!= (-> *target* state name) 'target-indax-pilot-get-off))
    (let* ((pilot-info (-> *target* pilot))
           (v-proc (the-as vehicle (handle->process-safe (-> pilot-info vehicle)))))
      (when (and v-proc (nonzero? v-proc))
        (mp-vehicle-promote-local-driver! v-proc))
      (when (and v-proc (nonzero? v-proc) (nonzero? (-> v-proc net-id)))
        (set! (-> (mp-local-player-record) vehicle vehicle-id) (-> v-proc net-id))
        (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 (-> pilot-info seat-index)))
        (when (zero? (-> pilot-info seat-index))
          (mp-vehicle-pack v-proc (-> (mp-local-player-record) vehicle state))))))
  (none))

(defun mp-vehicle-guard-ensure-remote-combat! ((veh vehicle-guard))
  (when (and veh (nonzero? veh) (not (mp-vehicle-is-local-authoritative? veh)))
    (logior! (-> veh flags) (rigid-body-object-flag alert in-pursuit target-in-sight persistent))
    (let* ((owner-record (mp-player-driver-record-by-vehicle-id (-> veh net-id)))
           (owner-target (if (and owner-record (nonzero? owner-record) (is-record-remote-player? owner-record))
                           (mp-player-record-target owner-record)
                           (the-as target #f))))
      (if (and owner-target (nonzero? owner-target))
        (handle-offending-process! veh owner-target)
        (when (and *target* (nonzero? *target*))
          (handle-offending-process! veh *target*)))))
  (none))

(defun mp-vehicle-frame-blend ((rate float))
  (fmin 1.0 (fmax 0.0 (* rate (seconds-per-frame)))))

(defun mp-vehicle-copy-presentation-to-rbody! ((veh vehicle) (rec traffic-record) (target-trans vector))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh rbody)
             (nonzero? (-> veh rbody))
             (-> veh rbody state)
             (nonzero? (-> veh rbody state)))
    (vector-copy! (-> veh rbody state position) target-trans)
    (vector-copy! (-> veh rbody state lin-velocity) (-> rec linvel))
    (quaternion-copy! (-> veh rbody state rotation) (-> rec quat))
    (vector-copy! (-> veh rbody state ang-velocity) (-> rec angvel)))
  (none))

(defun mp-vehicle-snap-to-presentation! ((veh vehicle) (rec traffic-record) (target-trans vector))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (set! (-> veh pad-bytes 0) (the uint8 2))
    (vector-copy! (-> veh root trans) target-trans)
    (vector-copy! (-> veh root transv) (-> rec linvel))
    (quaternion-copy! (-> veh root quat) (-> rec quat))
    (mp-vehicle-copy-presentation-to-rbody! veh rec target-trans))
  (none))

(defun mp-vehicle-nudge-rbody-to-target! ((veh vehicle) (target-trans vector) (nudge-rate float))
  (when (and veh
             (nonzero? veh)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root))
             (-> veh rbody)
             (nonzero? (-> veh rbody))
             (-> veh rbody state)
             (nonzero? (-> veh rbody state)))
    (let ((nudge (new 'stack-no-clear 'vector)))
      (vector-! nudge target-trans (-> veh root trans))
      (vector-float*! nudge nudge (* nudge-rate (seconds-per-frame)))
      (vector+! (-> veh rbody state lin-velocity) (-> veh rbody state lin-velocity) nudge)
      (vector-copy! (-> veh root transv) (-> veh rbody state lin-velocity))))
  (none))

(defun mp-vehicle-reconcile-driven-presentation! ((veh vehicle)
                                                  (rec traffic-record)
                                                  (target-trans vector)
                                                  (dist float)
                                                  (snap-distance float))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (if (> dist snap-distance)
      (mp-vehicle-snap-to-presentation! veh rec target-trans)
      (begin
        (set! (-> veh pad-bytes 0) (the uint8 1))
        (when (> dist (meters 0.05))
          (let ((position-rate 10.0))
            (when (> dist (meters 2))
              (set! position-rate 18.0))
            (vector-lerp! (-> veh root trans) (-> veh root trans) target-trans (mp-vehicle-frame-blend position-rate))))
        (quaternion-slerp! (-> veh root quat) (-> veh root quat) (-> rec quat) (mp-vehicle-frame-blend 12.0))
        (when (and (-> veh rbody) (nonzero? (-> veh rbody)) (-> veh rbody state) (nonzero? (-> veh rbody state)))
          (vector-lerp! (-> veh rbody state lin-velocity)
                        (-> veh rbody state lin-velocity)
                        (-> rec linvel)
                        (mp-vehicle-frame-blend 12.0))
          (vector-copy! (-> veh root transv) (-> veh rbody state lin-velocity))
          (vector-lerp! (-> veh rbody state ang-velocity)
                        (-> veh rbody state ang-velocity)
                        (-> rec angvel)
                        (mp-vehicle-frame-blend 12.0))))))
  (none))

(defun mp-vehicle-apply-ambient-presentation! ((veh vehicle) (rec traffic-record) (target-trans vector))
  (when (and veh
             (nonzero? veh)
             rec
             (nonzero? rec)
             target-trans
             (nonzero? target-trans)
             (-> veh root)
             (nonzero? (-> veh root)))
    (mp-vehicle-snap-to-presentation! veh rec target-trans))
  (none))

(defun mp-vehicle-apply-network-presentation ((veh vehicle))
  (when (and veh
             (nonzero? veh)
             (nonzero? (-> veh net-id))
             (-> veh root)
             (nonzero? (-> veh root))
             (-> veh rbody)
             (nonzero? (-> veh rbody)))
    (let ((rec (get-traffic-record (-> veh net-id))))
      (when (and rec (nonzero? rec) (nonzero? (-> rec last-correction-time)))
        (let ((target-trans (new 'stack-no-clear 'vector)))
          (mp-actor-copy-traffic-presentation! rec target-trans)
          (let ((dist (vector-vector-distance (-> veh root trans) target-trans)))
            (cond
              ((mp-race-vehicle-id? (-> veh net-id))
               (mp-vehicle-reconcile-driven-presentation! veh rec target-trans dist (meters 40)))
              ((mp-vehicle-remote-driven? veh)
               (mp-vehicle-reconcile-driven-presentation! veh rec target-trans dist (meters 15)))
              (else (mp-vehicle-apply-ambient-presentation! veh rec target-trans)))))
        (when (and (-> veh rbody state) (nonzero? (-> veh rbody state)))
          (rigid-body-method-26 (-> veh rbody state) (-> veh root trans) (-> veh root quat))))))
  (none))

(defun mp-vehicle-common-post-sync ((this vehicle))
  (if (not (and this (nonzero? this))) (return #f))
  (set! (-> this pad-bytes 0) (the uint8 0))
  (mp-vehicle-clear-stale-player-driver! this)
  (mp-vehicle-release-stale-player-control! this)
  (when (and (not (mp-vehicle-is-local-authoritative? this)) (nonzero? (-> this net-id)))
    (let ((rec (get-traffic-record (-> this net-id))))
      (when rec
        (when (= (-> rec entity-kind) (the uint8 1))
          (mp-vehicle-apply-authoritative-flight-level! this (-> rec aux-state) (nonzero? (-> rec last-seen))))
        (let ((target-sym (mp-veh-get-state-from-id (the uint (-> rec state-id)))))
          (when (and (type? this vehicle-guard) (mp-vehicle-guard-remote-combat-state? target-sym))
            (mp-vehicle-guard-ensure-remote-combat! (the-as vehicle-guard this)))
          (when (and target-sym (-> this state) (!= (-> this state name) target-sym))
            (let ((st (the-as state #f)))
              (case target-sym
                (('active) (set! st (method-of-object this active)))
                (('waiting) (set! st (method-of-object this waiting)))
                (('player-control) (set! st (method-of-object this player-control)))
                (('idle) (set! st (method-of-object this idle)))
                (('inactive) (set! st (method-of-object this inactive)))
                (('crash) (set! st (method-of-object this crash)))
                (('explode) (set! st (method-of-object this explode)))
                (('die) (set! st (method-of-object this die)))
                (('hostile) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 148))))
                (('stop-and-shoot) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 149))))
                (('slow-pursuit) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 150))))
                (('waiting-ambush) (set! st (the-as state (-> (the-as (pointer uint32) (-> this type)) 153)))))
              (when (type? this vehicle-racer)
                (case target-sym
                  (('waiting-race) (set! st (method-of-object (the-as vehicle-racer this) waiting-race)))
                  (('waiting-for-start) (set! st (method-of-object (the-as vehicle-racer this) waiting-for-start)))
                  (('racing) (set! st (method-of-object (the-as vehicle-racer this) racing)))
                  (('race-finished) (set! st (method-of-object (the-as vehicle-racer this) race-finished)))))
              (when (and st (nonzero? st))
                (set! (-> this next-state) st)
                (enter-state (the-as object st)
                             (the-as object #f)
                             (the-as object #f)
                             (the-as object #f)
                             (the-as object #f)
                             (the-as object #f))))))))
    (mp-vehicle-apply-network-presentation this)
    (when (and (-> this state) (!= (-> this state name) 'player-control) (not (mp-race-vehicle-id? (-> this net-id))))
      (let ((rb (-> this rbody state)))
        (when rb
          (vector-reset! (-> rb lin-momentum))
          (vector-reset! (-> rb ang-momentum))
          (vector-reset! (-> rb lin-velocity))
          (vector-reset! (-> rb ang-velocity))))))
  (none))

(defun mp-vehicle-remote-needs-physics? ((this vehicle))
  (let ((rec (get-traffic-record (-> this net-id))))
    (if rec
      (logtest? (-> rec aux-state) MP_VEHICLE_STATE_FLAG_PHYSICS)
      (or (nonzero? (-> this net-id))
          (and (-> this state) (= (-> this state name) 'player-control))
          (mp-session-client?)))))

(defun mp-vehicle-apply-color-index! ((proc vehicle) (slot mp-vehicle-state))
  (when (and proc (nonzero? proc) (-> proc info) (> (-> proc info color-option-count) 0))
    (let ((state-id (-> slot state-id))
          (cur-state (if (-> proc state) (-> proc state name) 'none)))
      (when (and (!= state-id (the uint (mp-veh-state-id explode)))
                 (!= state-id (the uint (mp-veh-state-id die)))
                 (!= cur-state 'explode)
                 (!= cur-state 'die))
        (let ((color-index (mod (the-as int (-> slot color-index)) (-> proc info color-option-count))))
          (set! (-> proc draw color-mult quad) (-> proc info color-option-array color-index quad))))))
  (none))

(defun mp-vehicle-clear-seat-occupant! ((proc vehicle) (seat-index int) (replacement object))
  (let ((client-rider-proc (get-rider-in-seat proc seat-index)))
    (when (and client-rider-proc
               (nonzero? client-rider-proc)
               (!= client-rider-proc replacement)
               (not (mp-player-process-record client-rider-proc)))
      (cond
        ((type? client-rider-proc vehicle-rider)
         (send-event client-rider-proc 'rider-off)
         (deactivate client-rider-proc))
        ((type? client-rider-proc citizen) (send-event client-rider-proc 'traffic-off-force))
        (else (remove-rider proc client-rider-proc)))
      (set! (-> proc rider-array seat-index) (the-as handle #f))))
  (none))

(defun mp-vehicle-init-spawn-params! ((params traffic-object-spawn-params) (slot mp-vehicle-state))
  (when (and params (nonzero? params) slot (nonzero? slot))
    (mem-set32! (the-as pointer params) 0 (/ (size-of traffic-object-spawn-params) 4))
    (set! (-> params object-type) (the-as traffic-type (-> slot vehicle-type)))
    (set-vector! (-> params position) (-> slot x) (-> slot y) (-> slot z) 1.0)
    (quaternion-set! (-> params rotation) (-> slot quat-x) (-> slot quat-y) (-> slot quat-z) (-> slot quat-w))
    (set-vector! (-> params velocity) 0.0 0.0 0.0 1.0))
  (none))

(defun mp-vehicle-spawn-civilian-rider! ((proc vehicle) (slot mp-vehicle-state))
  (when (and proc
             (nonzero? proc)
             slot
             (nonzero? slot)
             (mp-traffic-type-loaded? (the-as traffic-type (-> slot vehicle-type)))
             (not (mp-vehicle-local-target-riding? proc)))
    (let ((params (new 'stack-no-clear 'traffic-object-spawn-params)))
      (mp-vehicle-init-spawn-params! params slot)
      (set! (-> params flags) (traffic-spawn-flags skip-lwide-entity-hack spawn-rider))
      (spawn-default-vehicle-rider! proc params)))
  (none))

(defun mp-vehicle-update-riders ((proc vehicle) (slot mp-vehicle-state))
  (when (and proc (nonzero? proc) slot (nonzero? slot))
    (dotimes (seat-index 4)
      (let ((client-rider (handle->process-safe (-> proc rider-array seat-index)))
            (host-rider-id (-> slot rider-player-ids seat-index)))
        (cond
          ((and (= seat-index 0) (= host-rider-id MP_VEHICLE_RIDER_CIVILIAN_ID) (not client-rider))
           (mp-vehicle-spawn-civilian-rider! proc slot))
          ((and (= host-rider-id MP_INVALID_PLAYER_ID)
                client-rider
                (nonzero? client-rider)
                (type? client-rider vehicle-rider))
           (when (and (not (logtest? (-> client-rider mask) (process-mask sleep))) (!= (-> client-rider status) 'dead))
             (send-event client-rider 'rider-off)
             (deactivate client-rider))
           (set! (-> proc rider-array seat-index) (the-as handle #f)))
          ((and (mp-player-id-valid? host-rider-id)
                client-rider
                (nonzero? client-rider)
                (type? client-rider vehicle-rider))
           (mp-vehicle-clear-seat-occupant! proc seat-index (the-as object #f)))))))
  (none))

(defun get-vehicle-record-sample-generation ((proc vehicle))
  (when (and (nonnull? proc) (nonnull? *mp-replication-state*))
    (let ((driver-record (mp-player-driver-record-by-vehicle-id (-> proc net-id))))
      (if (nonnull? driver-record)
        (return (the-as uint64 (-> *mp-replication-state* remote generation)))
        (return (the-as uint64 (-> *mp-replication-state* remote traffic generation))))))
  (the uint64 0))

(defun vehicle-record-sample! ((proc vehicle) (slot mp-vehicle-state) (rec traffic-record))
  (let ((fresh-sample? #f))
    (when (and proc (nonzero? proc) slot (nonzero? slot) rec (nonzero? rec) (nonzero? (-> slot net-id)))
      (set-vector! (-> rec trans) (-> slot x) (-> slot y) (-> slot z) 1.0)
      (quaternion-set! (-> rec quat) (-> slot quat-x) (-> slot quat-y) (-> slot quat-z) (-> slot quat-w))
      (set-vector! (-> rec linvel) (-> slot lin-vel-x) (-> slot lin-vel-y) (-> slot lin-vel-z) 0.0)
      (set-vector! (-> rec angvel) (-> slot ang-vel-x) (-> slot ang-vel-y) (-> slot ang-vel-z) 0.0)
      (let ((generation (get-vehicle-record-sample-generation proc))
            (previous-generation (-> rec last-correction-time)))
        (when (or (zero? previous-generation) (!= generation previous-generation))
          (let ((sample-generation generation)
                (had-remote-sample? (nonzero? (-> rec last-seen))))
            (set! (-> rec entity-kind) (the uint8 1))
            (when (and (!= (-> slot state-id) (the uint (mp-veh-state-id explode)))
                       (= (-> rec last-applied-state-id) (the uint32 (mp-veh-state-id explode))))
              (set! (-> rec last-applied-state-id) (the uint32 0)))
            (set! (-> rec state-id) (-> slot state-id))
            (set! (-> rec aux-state) (-> slot state-flags))
            (set! (-> rec last-correction-time) sample-generation)
            (set! (-> rec last-seen) (current-time))
            (mp-vehicle-apply-authoritative-flight-level! proc (-> rec aux-state) had-remote-sample?)
            (set! fresh-sample? #t)))))
    fresh-sample?))

(defun vehicle-apply-record ((proc vehicle) (slot mp-vehicle-state))
  (if (not (and proc (nonzero? proc))) (return #f))
  (if (not (and slot (nonzero? slot))) (return #f))
  (let ((local-pilot (get-rider-in-seat proc 0)))
    (when (and local-pilot (nonzero? local-pilot) *target* (nonzero? *target*) (= local-pilot *target*))
      (return #f)))
  (when (type? proc vehicle-racer)
    (set! (-> (the-as vehicle-racer proc) respawn-protected?)
          (logtest? (-> slot state-flags) MP_VEHICLE_STATE_FLAG_RESPAWN_PROTECTED)))
  (let ((rec (get-or-create-traffic-record! (-> slot net-id) (the uint 1))))
    (when (and rec (nonzero? rec))
      (vehicle-record-sample! proc slot rec)))
  (mp-vehicle-apply-color-index! proc slot)
  (mp-vehicle-update-riders proc slot)
  (mp-vehicle-ensure-guard-minimap! proc)
  (mp-vehicle-refresh-parking-minimap! proc slot)
  (when (not (mp-vehicle-local-target-riding? proc))
    (logclear! (-> proc root penetrated-by) (penetrate jak-yellow-shot jak-red-shot jak-blue-shot jak-dark-shot)))
  (when (not (mp-vehicle-is-local-authoritative? proc))
    (if (> (-> slot hit-points) 0)
      (set! (-> proc hit-points) (/ (the float (-> slot hit-points)) 255.0))
      (when (or (= (-> slot state-id) (the uint (mp-veh-state-id crash)))
                (= (-> slot state-id) (the uint (mp-veh-state-id explode)))
                (= (-> slot state-id) (the uint (mp-veh-state-id die))))
        (set! (-> proc hit-points) 0.0))))
  (none))

(defun vehicle-spawn-replica ((slot mp-vehicle-state))
  (let ((spawned? #f))
    (when (and slot
               (nonzero? slot)
               (mp-is-traffic-ready?)
               (mp-traffic-type-loaded? (the-as traffic-type (-> slot vehicle-type))))
      (let ((params (new 'stack-no-clear 'traffic-object-spawn-params)))
        (mp-vehicle-init-spawn-params! params slot)
        (set! (-> params net-id) (-> slot net-id))
        (set! (-> params nav-branch) (mp-vehicle-find-spawn-branch params))
        (when (mp-vehicle-param-nav-branch-ready? params)
          (if (= (-> slot rider-player-ids 0) MP_VEHICLE_RIDER_CIVILIAN_ID)
            (set! (-> params flags) (traffic-spawn-flags spawn-rider))
            (set! (-> params flags) (the-as traffic-spawn-flags 0)))
          (let ((spawned-proc (traffic-object-spawn (the-as process *traffic-manager*) params)))
            (when (and spawned-proc (nonzero? spawned-proc) (type? spawned-proc vehicle))
              (let ((vehicle-proc (the-as vehicle spawned-proc)))
                (set! (-> vehicle-proc pad-bytes 1) (the uint8 0))
                (mp-vehicle-apply-color-index! vehicle-proc slot)
                (mp-vehicle-ensure-guard-minimap! vehicle-proc)
                (mp-vehicle-refresh-parking-minimap! vehicle-proc slot)
                (set! (-> vehicle-proc hit-points)
                      (if (> (-> slot hit-points) 0) (/ (the float (-> slot hit-points)) 255.0) 1.0))
                (set! spawned? #t)))))))
    spawned?))

(defun vehicle-can-spawn-replica? ((net-id uint))
  (and (nonzero? net-id) (or (= net-id MP_MISSION_VEHICLE_CITY_SHUTTLE) (not (mp-mission-vehicle-id? net-id)))))

(defun mp-vehicle-apply-player-piggyback ((record mp-player-record))
  (when (or (not record) (zero? record))
    (return #f))
  (mp-vehicle-update-authority-handoff! record)
  (let ((spawn-ready? (mp-is-traffic-spawn-ready?))
        (driven-net-id (-> record vehicle state net-id))
        (old-veh (the-as vehicle (handle->process-safe (-> record runtime vehicle-handle)))))
    (when (and (nonzero? (-> record runtime vehicle-handle))
               (or (not old-veh) (zero? old-veh) (!= driven-net-id (-> (the-as vehicle old-veh) net-id))))
      (when (and old-veh (nonzero? old-veh))
        (mp-vehicle-clear-stale-player-driver! (the-as vehicle old-veh))
        (mp-vehicle-release-stale-player-control! (the-as vehicle old-veh)))
      (set! (-> record runtime vehicle-handle) (the-as handle #f)))
    (when (nonzero? driven-net-id)
      (let ((proc (mp-vehicle-find-by-net-id driven-net-id))
            (vehicle-can-spawn? (vehicle-can-spawn-replica? driven-net-id)))
        (if (and proc (nonzero? proc))
          (begin
            (set! (-> record runtime vehicle-handle) (process->handle proc))
            (logior! (-> proc flags) (rigid-body-object-flag persistent))
            (logclear! (-> proc mask) (process-mask pause sleep actor-pause))
            (if (<= (-> record vehicle state state-id) 2)
              (when vehicle-can-spawn?
                (mp-vehicle-force-cull-local! proc))
              (vehicle-apply-record proc
                                    (-> record
                                        vehicle
                                        state))))
          (when (and spawn-ready?
                     vehicle-can-spawn?
                     (> (-> record vehicle state state-id) 2)
                     (not (mp-player-runtime-flag? record (mp-player-runtime-flags was-far))))
            (when (vehicle-spawn-replica (-> record vehicle state))
              (let ((spawned-vehicle (mp-vehicle-find-by-net-id driven-net-id)))
                (when (and spawned-vehicle (nonzero? spawned-vehicle))
                  (set! (-> record runtime vehicle-handle) (process->handle spawned-vehicle)))))))))
    (when (zero? driven-net-id)
      (set! (-> record runtime vehicle-handle) (the-as handle #f)))
    (when (and old-veh (nonzero? old-veh))
      (mp-vehicle-release-stale-player-control! (the-as vehicle old-veh))))
  (none))

(defun mp-vehicle-apply-piggyback ()
  (mp-for-each-player-record (player-id record)
    (when (is-record-remote-player? record)
      (mp-vehicle-apply-player-piggyback record)))
  (none))

(defun mp-vehicle-apply-race-remote ()
  (when (nonnull? *mp-traffic-buffer*)
    (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
      (let ((slot (-> *mp-traffic-buffer* veh-enemies i)))
        (when (and (nonnull? slot)
                   (nonzero? (-> slot net-id))
                   (mp-race-vehicle-id? (-> slot net-id))
                   (not (mp-player-driver-record-by-vehicle-id (-> slot net-id))))
          (let ((proc (mp-race-vehicle-find-by-net-id (-> slot net-id))))
            (when (nonnull? proc (-> proc root) (-> proc rbody) (-> proc rbody state)
                           (-> proc draw) (-> proc info))
              (vehicle-apply-record proc slot)))))))
  (none))

(defun mp-vehicle-apply-remote ()
  (let ((spawn-budget 2))
    (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
      (let ((slot (-> *mp-traffic-buffer* veh-enemies i)))
        (when (and (nonzero? (-> slot net-id))
                   (mp-traffic-slot-locally-admitted? (-> slot level-id))
                   (not (mp-player-driver-record-by-vehicle-id (-> slot net-id))))
          (mp-vehicle-complete-authority-handoff-if-fresh! (-> slot net-id))
          (when (not (mp-vehicle-authority-handoff-record (-> slot net-id)))
            (let ((proc (mp-vehicle-find-by-net-id (-> slot net-id))))
              (if (and proc (nonzero? proc))
                (if (<= (-> slot state-id) 2) (mp-vehicle-force-cull-local! proc) (vehicle-apply-record proc slot))
                (when (and (> spawn-budget 0)
                           (mp-traffic-level-materialization-ready? (-> slot level-id))
                           (> (-> slot state-id) 2)
                           (vehicle-can-spawn-replica? (-> slot net-id)))
                  (when (vehicle-spawn-replica slot)
                    (-! spawn-budget 1)))))))))
    (when (and *traffic-manager* (nonzero? *traffic-manager*) (not *mp-traffic-local-authoritative?*))
      (let ((curr (-> *traffic-manager* child)))
        (while (and curr (nonzero? curr))
          (let ((proc (ppointer->process curr)))
            (let ((next-ptr (-> curr 0 brother)))
              (when (and proc (nonzero? proc) (type? proc vehicle) (nonzero? (-> (the-as vehicle proc) net-id)))
                (let ((found-in-buffer? #f)
                      (v-net-id (-> (the-as vehicle proc) net-id)))
                  (cond
                    ((or (mp-player-record-by-vehicle-id v-net-id) (mp-vehicle-authority-handoff-pending? v-net-id))
                     (set! found-in-buffer? #t))
                    ((not (mp-vehicle-authority-handoff-record v-net-id))
                     (dotimes (i (the-as int (-> *mp-traffic-buffer* veh-count)))
                       (when (and (= (-> *mp-traffic-buffer* veh-enemies i net-id) v-net-id)
                                  (mp-traffic-slot-locally-admitted? (-> *mp-traffic-buffer* veh-enemies i level-id)))
                         (set! found-in-buffer? #t)))))
                  (when (not found-in-buffer?)
                    (mp-vehicle-force-cull-local! (the-as vehicle proc))
                    (mp-vehicle-clear-authority-handoff-record! (mp-vehicle-authority-handoff-record v-net-id)))))
              (set! curr next-ptr)))))))
  (none))
