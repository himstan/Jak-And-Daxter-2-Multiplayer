;;-*-Lisp-*-
(in-package goal)

(defconstant HELLCAT_GUNNER_SEAT 2)
(defconstant HELLCAT_GUNNER_SHOT_DELAY (seconds 0.35))
(defconstant HELLCAT_GUNNER_CAMERA_DISTANCE (meters 5))
(defconstant HELLCAT_GUNNER_CAMERA_HEIGHT (meters 1.5))
(defconstant HELLCAT_TURRET_PIVOT_Z -11754.068)
(defconstant HELLCAT_GUNNER_LEG_SCALE 0.01)

(defun hellcat-local-gunner? ((veh hellcat))
  (let ((pilot-info (mp-vehicle-local-pilot veh)))
    (if (and (nonnull? pilot-info)
             (= (-> pilot-info seat-index) HELLCAT_GUNNER_SEAT)
             (focus-test? *target* pilot-riding)
             (not (focus-test? *target* dead)))
      #t
      #f)))

(defun hellcat-remote-gunner-record ((veh hellcat))
  (let ((record (mp-remote-vehicle-seat-claimant veh HELLCAT_GUNNER_SEAT)))
    (if (and (nonnull? record) (nonzero? (-> record vehicle turret-active?)))
      record
      (the-as mp-player-record #f))))

(defun hellcat-gunner-aim! ((turret turret-control) (yaw float) (pitch float))
  (set! (-> turret aim-rot-y) (the float (sar (shl (the int yaw) 48) 48)))
  (set! (-> turret aim-rot-x) (fmax (-> turret info rot-x-min) (fmin (-> turret info rot-x-max) pitch)))
  (none))

(defun hellcat-gunner-steer! ((turret turret-control) (pad cpad-info))
  (let ((dt (seconds-per-frame)))
    (+! (-> turret aim-rot-vel-y)
        (* dt (analog-input-horizontal-first (the-as int (-> pad leftx)) 128.0 32.0 110.0 -98304.0)))
    (+! (-> turret aim-rot-vel-x)
        (* dt (- (analog-input-vertical-first (the-as int (-> pad lefty)) 128.0 32.0 110.0 -65536.0))))
    (seek! (-> turret aim-rot-vel-y) 0.0 (* 32768.0 dt))
    (seek! (-> turret aim-rot-vel-x) 0.0 (* 32768.0 dt))
    (set! (-> turret aim-rot-vel-y) (fmax -14563.556 (fmin 14563.556 (-> turret aim-rot-vel-y))))
    (set! (-> turret aim-rot-vel-x) (fmax -9102.223 (fmin 9102.223 (-> turret aim-rot-vel-x))))
    (let ((pitch (+ (-> turret aim-rot-x) (* dt (-> turret aim-rot-vel-x)))))
      (if (or (< pitch (-> turret info rot-x-min)) (< (-> turret info rot-x-max) pitch))
        (set! (-> turret aim-rot-vel-x) 0.0))
      (hellcat-gunner-aim! turret (+ (-> turret aim-rot-y) (* dt (-> turret aim-rot-vel-y))) pitch)))
  (none))

(defun hellcat-gunner-follow! ((turret turret-control) (yaw float) (pitch float) (rate float))
  (let ((blend (mp-vehicle-frame-blend rate)))
    (hellcat-gunner-aim! turret
                         (+ (-> turret aim-rot-y) (* blend (deg- yaw (-> turret aim-rot-y))))
                         (+ (-> turret aim-rot-x) (* blend (- pitch (-> turret aim-rot-x))))))
  (none))

(defun hellcat-gunner-fire! ((veh hellcat) (shooter process))
  (set! (-> veh rear-turret owner-handle) (process->handle shooter))
  (turret-control-method-17 (-> veh rear-turret) veh)
  (set! (-> veh rear-turret owner-handle) (the-as handle #f))
  (none))

(defun hellcat-gunner-control! ((veh hellcat))
  (let ((pad (-> *target* control cpad)))
    (when (and (nonnull? pad) (= *master-mode* 'game))
      (hellcat-gunner-steer! (-> veh rear-turret) pad)
      (when (and (cpad-hold? (-> pad number) r1)
                 (time-elapsed? (-> veh rear-turret shoot-time) HELLCAT_GUNNER_SHOT_DELAY))
        (hellcat-gunner-fire! veh *target*)
        (mp-event-enqueue-aid! MP_EVENT_GUARD_VEHICLE_SHOT (-> veh net-id)))))
  (none))

(defun hellcat-gunner-draw-laser! ((veh hellcat) (gunner process))
  (let* ((info (-> veh rear-turret info))
         (joint (-> veh node-list data (-> info joint-index) bone transform))
         (muzzle (new 'stack-no-clear 'vector)))
    (dotimes (barrel (-> info barrel-count))
      (vector-matrix*! muzzle (-> info barrel-array barrel local-pos) joint)
      (vehicle-draw-turret-laser veh gunner muzzle (-> joint vector 2) (-> info attack-range))))
  (none))

(defun hellcat-gunner-use-camera! ((veh hellcat) (enable? symbol))
  (when (!= enable? (-> veh gunner-camera?))
    (if enable?
      (set-setting *setting-control* veh 'mode-name 'cam-hellcat-gunner 0.0 0)
      (remove-setting *setting-control* veh 'mode-name))
    (set! (-> veh gunner-camera?) enable?))
  (none))

(defun hellcat-gunner-pose-turret! ((veh hellcat))
  (when (nonnull? (-> veh rear-turret-yaw-jm) (-> veh rear-turret-pitch-jm))
    (quaternion-vector-angle! (-> veh rear-turret-yaw-jm rotation) *y-vector* (-> veh rear-turret aim-rot-y))
    (quaternion-vector-angle! (-> veh rear-turret-pitch-jm rotation) *x-vector* (- (-> veh rear-turret aim-rot-x))))
  (none))

(defun hellcat-gunner-update! ((veh hellcat))
  (when (nonnull? (-> veh rear-turret info) (-> veh node-list))
    (let ((local? (hellcat-local-gunner? veh))
          (remote (hellcat-remote-gunner-record veh)))
      (cond
        (local?
         (hellcat-gunner-control! veh)
         (hellcat-gunner-draw-laser! veh *target*))
        ((nonnull? remote)
         (hellcat-gunner-follow! (-> veh rear-turret) (-> remote vehicle turret-roty) (-> remote vehicle turret-rotx) 15.0)
         (hellcat-gunner-draw-laser! veh (mp-player-record-target remote)))
        (else
         (hellcat-gunner-follow! (-> veh rear-turret) 0.0 0.0 2.0)))
      (hellcat-gunner-pose-turret! veh)
      (hellcat-gunner-use-camera! veh local?)))
  (none))

(defun hellcat-gunner-replay-shot! ((veh hellcat) (shooter process))
  (when (and (nonnull? shooter (-> veh rear-turret info) (-> veh node-list))
             (type? shooter target)
             (not (focus-test? veh dead inactive))
             (not (hellcat-local-gunner? veh)))
    (hellcat-gunner-fire! veh shooter))
  (none))

(defun hellcat-gunner-pack-aim! ((veh hellcat) (vehicle-state mp-player-vehicle-state))
  (when (and (nonnull? vehicle-state) (hellcat-local-gunner? veh))
    (set! (-> vehicle-state turret-active?) (the uint8 1))
    (set! (-> vehicle-state turret-roty) (-> veh rear-turret aim-rot-y))
    (set! (-> vehicle-state turret-rotx) (-> veh rear-turret aim-rot-x)))
  (none))

(defbehavior hellcat-gunner-leg-tuck target ()
  (let ((thigh (-> self node-list data (joint-node-index jakb-lod0-jg Lthigh))))
    (if (= (-> thigh param0) joint-mod-set-local-callback)
      (the-as joint-mod-set-local (-> thigh param1))
      (let ((tuck (new 'process 'joint-mod-set-local self (joint-node-index jakb-lod0-jg Lthigh) #f #f #t)))
        (set-vector! (-> tuck transform scale) HELLCAT_GUNNER_LEG_SCALE HELLCAT_GUNNER_LEG_SCALE
                     HELLCAT_GUNNER_LEG_SCALE 1.0)
        (set! (-> tuck enable) #f)
        tuck))))

(defun hellcat-gunner-hook-joint! ((joint cspace) (tuck joint-mod-set-local))
  (set! (-> joint param0) joint-mod-set-local-callback)
  (set! (-> joint param1) tuck)
  (none))

(defbehavior hellcat-gunner-hook-leg! target ((thigh int) (knee int) (ankle int) (toes int) (tuck joint-mod-set-local))
  (hellcat-gunner-hook-joint! (-> self node-list data thigh) tuck)
  (hellcat-gunner-hook-joint! (-> self node-list data knee) tuck)
  (hellcat-gunner-hook-joint! (-> self node-list data ankle) tuck)
  (hellcat-gunner-hook-joint! (-> self node-list data toes) tuck)
  (none))

(defbehavior hellcat-gunner-release-leg! target ((knee int) (leg-ik joint-mod-ik) (foot joint-mod))
  (let ((joint (-> self node-list data knee)))
    (set! (-> joint param0) joint-mod-ik-callback)
    (set! (-> joint param1) leg-ik))
  (mode-set! foot (joint-mod-mode foot-rot))
  (none))

(defbehavior hellcat-gunner-tuck-legs! target ((tuck? symbol))
  (when (and (nonnull? (-> self node-list) (-> self leg-ik 0) (-> self leg-ik 1) (-> self foot 0) (-> self foot 1))
             (or tuck? (= (-> self node-list data (joint-node-index jakb-lod0-jg Lthigh) param0) joint-mod-set-local-callback)))
    (let ((tuck (hellcat-gunner-leg-tuck)))
      (when (!= tuck? (-> tuck enable))
        (set! (-> tuck enable) tuck?)
        (cond
          (tuck?
           (hellcat-gunner-hook-leg! (joint-node-index jakb-lod0-jg Lthigh) (joint-node-index jakb-lod0-jg Lknee)
                                     (joint-node-index jakb-lod0-jg Lankle) (joint-node-index jakb-lod0-jg Ltoes) tuck)
           (hellcat-gunner-hook-leg! (joint-node-index jakb-lod0-jg Rthigh) (joint-node-index jakb-lod0-jg Rknee)
                                     (joint-node-index jakb-lod0-jg Rankle) (joint-node-index jakb-lod0-jg Rtoes) tuck))
          (else
           (hellcat-gunner-release-leg! (joint-node-index jakb-lod0-jg Lknee) (-> self leg-ik 0) (-> self foot 0))
           (hellcat-gunner-release-leg! (joint-node-index jakb-lod0-jg Rknee) (-> self leg-ik 1) (-> self foot 1)))))))
  (none))

(defbehavior hellcat-gunner-place-rider! target ((veh process))
  (let ((gunner? (and (nonnull? veh (-> self pilot))
                      (= (-> self pilot seat-index) HELLCAT_GUNNER_SEAT)
                      (type? veh hellcat)
                      (nonnull? (-> (the-as hellcat veh) rear-turret info) (-> (the-as hellcat veh) node-list)))))
    (when gunner?
      (let ((hellcat (the-as hellcat veh))
            (seat (new 'stack-no-clear 'vector)))
        (set! (-> seat quad) (-> hellcat info seat-array HELLCAT_GUNNER_SEAT position quad))
        (set! (-> seat z) (- (-> seat z) HELLCAT_TURRET_PIVOT_Z))
        (vector-rotate-y! seat seat (-> hellcat rear-turret aim-rot-y))
        (set! (-> seat z) (+ (-> seat z) HELLCAT_TURRET_PIVOT_Z))
        (set! (-> seat w) 1.0)
        (vector-matrix*! (-> self control trans) seat (-> hellcat node-list data 0 bone transform))
        (quaternion-rotate-local-y! (-> self control quat) (-> self control quat) (-> hellcat rear-turret aim-rot-y))))
    (hellcat-gunner-tuck-legs! (the-as symbol (and gunner? (not (-> self pilot as-daxter?)) (not (mp-target-daxter? self))))))
  (none))

(defmethod vehicle-method-120 ((this hellcat))
  (hellcat-gunner-update! this)
  (call-parent-method this)
  (none))

(defmethod rigid-body-object-method-46 ((this hellcat) (proc process-drawable) (argc int) (message symbol) (block event-message-block))
  (case message
    (('replay-guard-shot)
     (if (= (-> block param 0) HELLCAT_GUNNER_SEAT)
       (hellcat-gunner-replay-shot! this proc)
       (call-parent-method this proc argc message block)))
    (('pack-gunner-aim)
     (hellcat-gunner-pack-aim! this (the-as mp-player-vehicle-state (-> block param 0))))
    (else
     (call-parent-method this proc argc message block))))

(defun hellcat-gunner-camera-vehicle ()
  (when (nonnull? *target* (-> *target* pilot))
    (let ((veh (handle->process-safe (-> *target* pilot vehicle))))
      (when (and (nonnull? veh) (type? veh hellcat))
        (return (the-as hellcat veh)))))
  (the-as hellcat #f))

(defun hellcat-gunner-place-camera! ((cam camera-slave))
  (let ((veh (hellcat-gunner-camera-vehicle)))
    (when (nonnull? veh (-> veh node-list) (-> veh rear-turret info))
      (let* ((turret (-> veh rear-turret))
             (joint (-> veh node-list data (-> turret info joint-index) bone transform))
             (aim-point (vector+float*! (new 'stack-no-clear 'vector) (-> joint trans) (-> joint vector 2) (-> turret info attack-range)))
             (forward (new 'stack-no-clear 'vector)))
        (set! (-> forward quad) (-> joint vector 2 quad))
        (set! (-> forward y) 0.0)
        (vector-normalize! forward 1.0)
        (vector+float*! (-> cam trans) (-> joint trans) forward (- HELLCAT_GUNNER_CAMERA_DISTANCE))
        (+! (-> cam trans y) HELLCAT_GUNNER_CAMERA_HEIGHT)
        (vector-! forward aim-point (-> cam trans))
        (forward-down->inv-matrix (-> cam tracking inv-mat) forward (-> *camera* local-down)))))
  (none))

(defstate cam-hellcat-gunner (camera-slave)
  :event cam-standard-event-handler
  :enter (behavior ()
    (when (not (-> self enter-has-run))
      (set! (-> self saved-pt quad) (-> self trans quad))
      (set! (-> self blend-from-type) (the-as uint 1))
      (set! (-> self blend-to-type) (camera-blend-to-type unknown-0))))
  :trans (behavior ()
    (if (not (logtest? (-> *camera* master-options) (cam-master-options-u32 HAVE_TARGET)))
      (cam-slave-go cam-free-floating)))
  :code (behavior ()
    (until #f
      (when (not (paused?))
        (hellcat-gunner-place-camera! self))
      (suspend))
    #f))
