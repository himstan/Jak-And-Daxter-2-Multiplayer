;;-*-Lisp-*-
(in-package goal)

(define-extern mp-pedestrian-find-by-net-id (function uint citizen))

(define-perm *authoritative-traffic-record-cleanup-time* time-frame 0)
(define-perm *traffic-record-allocation-failure-log-time* time-frame 0)

(defun get-traffic-record-count ()
  (let ((used-count (the int 0)))
    (dotimes (i MAX_TRAFFIC_RECORDS)
      (let ((rec (-> *traffic-records* i)))
        (when (and rec (nonzero? rec) (nonzero? (-> rec net-id)))
          (+! used-count 1))))
    used-count))

(defun release-traffic-record! ((rec traffic-record))
  (when (and rec (nonzero? rec))
    (set! (-> rec net-id) (the uint32 0))
    (set! (-> rec entity-kind) (the uint8 0))
    (set! (-> rec last-seen) 0)
    (set! (-> rec hp) (the int32 0))
    (set! (-> rec state-id) (the uint8 0))
    (set! (-> rec aux-state) MP_INVALID_PLAYER_ID)
    (set! (-> rec last-attack-source-player-id) MP_INVALID_PLAYER_ID)
    (set! (-> rec animation-profile) (the uint32 0))
    (set! (-> rec last-applied-animation-profile) (the uint32 0))
    (set! (-> rec last-attack-id) (the uint32 0))
    (set! (-> rec last-local-attack-id) (the uint32 0))
    (set! (-> rec last-local-attack-time) 0)
    (set! (-> rec last-correction-time) (the uint64 0))
    (set! (-> rec last-applied-state-id) (the uint32 0))
    (set! (-> rec last-state-bump-time) 0)
    (set! (-> rec authorized-trans-state-id) (the uint32 0))
    (set! (-> rec authorized-trans-frame) 0))
  (none))

(defun get-traffic-record ((net-id uint))
  (dotimes (i MAX_TRAFFIC_RECORDS)
    (let ((rec (-> *traffic-records* i))) (when (= (-> rec net-id) net-id) (return rec))))
  (the-as traffic-record #f))

(defun get-free-traffic-record ()
  (dotimes (i MAX_TRAFFIC_RECORDS)
    (let ((rec (-> *traffic-records* i))) (when (zero? (-> rec net-id)) (return rec))))
  (the-as traffic-record #f))

(defun get-or-create-traffic-record! ((net-id uint) (entity-kind uint))
  (let ((rec (the-as traffic-record #f)))
    (when (nonzero? net-id)
      (set! rec (get-traffic-record net-id))
      (when (not rec)
        (set! rec (get-free-traffic-record))
        (if (and rec (nonzero? rec))
          (begin
            (release-traffic-record! rec)
            (set! (-> rec net-id) net-id))
          (when (time-elapsed? *traffic-record-allocation-failure-log-time*
                               (seconds 1))
            (log 'debug
                 "[TrafficRecords] Allocation failed nid=~D kind=~D used=~D/~D~%"
                 net-id
                 entity-kind
                 (get-traffic-record-count)
                 MAX_TRAFFIC_RECORDS)
            (set! *traffic-record-allocation-failure-log-time* (current-time)))))
      (when (and rec (nonzero? rec))
        (set! (-> rec entity-kind) (the-as uint8 entity-kind))))
    rec))

(defun authoritative-pedestrian-record-missing? ((rec traffic-record))
  (when (or (not rec) (not (nonzero? rec)) (!= (-> rec entity-kind) (the uint8 0)))
    (return #f))
  (let ((ped-proc (mp-pedestrian-find-by-net-id (-> rec net-id)))) (or (not ped-proc) (not (nonzero? ped-proc)))))

(defun cleanup-authoritative-traffic-records! ()
  (when (and *mp-traffic-local-authoritative?* (time-elapsed? *authoritative-traffic-record-cleanup-time* (seconds 1)))
    (let ((stale-count (the int 0))
          (missing-ped-count (the int 0)))
      (dotimes (i MAX_TRAFFIC_RECORDS)
        (let ((rec (-> *traffic-records* i)))
          (when (and rec (nonzero? rec) (nonzero? (-> rec net-id)))
            (cond
              ((time-elapsed? (-> rec last-seen) (seconds 10)) (+! stale-count 1) (release-traffic-record! rec))
              ((authoritative-pedestrian-record-missing? rec) (+! missing-ped-count 1) (release-traffic-record! rec))))))
      (when (or (nonzero? stale-count) (nonzero? missing-ped-count))
        (log 'debug
             "[TrafficRecords] Authority cleanup stale=~D missing-ped=~D used=~D/~D~%"
             stale-count
             missing-ped-count
             (get-traffic-record-count)
             MAX_TRAFFIC_RECORDS)))
    (set! *authoritative-traffic-record-cleanup-time* (current-time)))
  (none))

(defun cleanup-traffic-records ()
  (dotimes (i MAX_TRAFFIC_RECORDS)
    (let ((rec (-> *traffic-records* i)))
      (when (and (nonzero? (-> rec net-id)) (time-elapsed? (-> rec last-seen) (seconds 10)))
        (log 'debug "[TrafficRecords] Cleaning up stale nid=~D after 10 seconds.~%" (-> rec net-id))
        (release-traffic-record! rec))))
  (none))
