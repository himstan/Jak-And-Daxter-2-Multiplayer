;;-*-Lisp-*-
(in-package goal)

(defun task-timer-remaining ((task task-manager))
  (if (nonnull? task (-> task clock))
      (max 0 (- (-> task time-limit) (- (-> task clock frame-counter) (-> task start-time))))
      (the-as time-frame 0)))

(defbehavior task-timer-heartbeat-source task-timer-heartbeat ()
  (when (nonnull? self)
    (let ((proc (handle->process-safe (-> self source))))
      (when (and (nonnull? proc) (type? proc task-manager))
        (let ((task (the-as task-manager proc)))
          (when (and (nonnull? task (-> task clock))
                     (nonzero? (-> task start-time))
                     (= (handle->process-safe (-> task hud-timer)) (ppointer->process (-> self parent))))
            (return task))))))
  (the-as task-manager #f))

(defun update-task-timer-hud! ((task task-manager))
  (when (and (mp-session-client?) (nonnull? task *game-info*))
    (let ((remaining (task-timer-remaining task)))
      (set! (-> *game-info* timer) remaining)
      (set! (-> *game-info* timer-flash) (< remaining (seconds 10)))))
  (none))

(defun send-task-timer-state! ((task task-manager) (task-node uint))
  (when (nonnull? task)
    (let ((event (new 'stack-no-clear 'task-timer-state-event)))
      (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_TASK_TIMER_STATE))
        (set! (-> event payload task-node) (the uint16 task-node))
        (set! (-> event payload time-limit) (-> task time-limit))
        (set! (-> event payload remaining-time) (task-timer-remaining task))
        (mp-event-enqueue! event))))
  (none))

(defstate run (task-timer-heartbeat)
  :virtual #t
  :code (behavior ()
    (until #f
      (let ((task (task-timer-heartbeat-source)))
        (when (or (not (mp-session-in-game?)) (not (nonnull? task))
                  (task-node-closed? (the game-task-node (-> self task-node))))
          (deactivate self))
        (when (mp-session-host?)
          (send-task-timer-state! task (the uint (-> self task-node)))))
      (suspend-for (seconds 1)))
    #f)
  :post (behavior ()
    (update-task-timer-hud! (task-timer-heartbeat-source))))

(defbehavior task-timer-heartbeat-init task-timer-heartbeat ((task task-manager) (task-node uint))
  (when (nonnull? self task *display* (-> *display* real-clock))
    (stack-size-set! (-> self main-thread) 512)
    (set! (-> self source) (process->handle task))
    (set! (-> self task-node) (the uint16 task-node))
    (set! (-> self clock) (-> *display* real-clock))
    (set! (-> self mask) (process-mask menu))
    (go-virtual run))
  (none))

(defun ensure-task-timer-sync! ((task task-manager) (task-node uint))
  (when (and (mp-session-in-game?) (nonnull? task)
             (nonzero? (-> task start-time)) (not (task-node-closed? (the game-task-node task-node))))
    (when (and (nonnull? *target*) (not (nonnull? (handle->process-safe (-> task hud-timer)))))
      (set! (-> task hud-timer) (ppointer->handle (process-spawn hud-timer :init hud-init-by-other :to *target*))))
    (let ((timer (handle->process-safe (-> task hud-timer))))
      (when (and (nonnull? timer) (not (nonnull? (process-by-type-exact 'task-timer-heartbeat timer))))
        (process-spawn task-timer-heartbeat :init task-timer-heartbeat-init task task-node :to timer))))
  (none))

(defun receive-task-timer-state! ((event task-timer-state-event))
  (when (not (and (mp-session-client?) (nonnull? event *game-info* (-> *game-info* sub-task-list))
                  (= (-> event source-player-slot) (mp-host-player-slot))))
    (return (the-as none 0)))
  (let* ((nodes (-> *game-info* sub-task-list))
         (task-node (the uint (-> event payload task-node))))
    (when (or (zero? task-node) (>= task-node (-> nodes length))
              (<= (-> event payload time-limit) 0) (task-node-closed? (the game-task-node task-node)))
      (return (the-as none 0)))
    (let ((node (-> nodes task-node)))
      (when (not (nonnull? node (-> node info)))
        (return (the-as none 0)))
      (let ((proc (handle->process-safe (-> node info manager))))
        (when (or (not (nonnull? proc)) (not (type? proc task-manager)))
          (return (the-as none 0)))
        (let ((task (the-as task-manager proc))
              (limit (-> event payload time-limit))
              (remaining (max 0 (min (-> event payload time-limit) (-> event payload remaining-time)))))
          (when (nonnull? task (-> task clock))
            (set! (-> task time-limit) limit)
            (set! (-> task start-time) (- (-> task clock frame-counter) (- limit remaining)))
            (update-task-timer-hud! task)
            (ensure-task-timer-sync! task task-node))))))
  (none))
