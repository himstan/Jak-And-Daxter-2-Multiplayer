(in-package goal)

(defun enemy-hit-deterministic? ((proc enemy))
  (if (and (nonnull? proc) (nonzero? (-> proc net-id)) (nonzero? (-> proc incoming attack-id))) #t #f))

(defun enemy-knocked-rand-factor ((proc enemy) (low float) (high float))
  (if (enemy-hit-deterministic? proc)
    (let* ((seed (logxor (-> proc net-id) (* (-> proc incoming attack-id) 1103515245)))
           (hash (logand (logxor seed (ash seed -16)) #xffff)))
      (+ low (* (- high low) (/ (the float hash) 65536.0))))
    (rnd-float-range proc low high)))

(defun enemy-hit-rand-count ((proc enemy) (count int))
  (if (enemy-hit-deterministic? proc)
    (the int (* (enemy-knocked-rand-factor proc 0.0 1.0) (the float count)))
    (rnd-int-count proc count)))

(defun enemy-hit-rand-bit ((proc enemy) (count int) (excluded int))
  (if (not (enemy-hit-deterministic? proc))
    (return (rnd-bit proc count excluded)))
  (let ((available 0))
    (dotimes (index count)
      (unless (logtest? excluded (ash 1 index))
        (+! available 1)))
    (when (> available 0)
      (let ((choice (enemy-hit-rand-count proc available)))
        (dotimes (index count)
          (unless (logtest? excluded (ash 1 index))
            (when (zero? choice)
              (return index))
            (-! choice 1))))))
  0)

(defun enemy-hit-history-mask ((proc enemy) (previous int))
  (if (enemy-hit-deterministic? proc) 0 (ash 1 previous)))

(defun enemy-hit-record ((proc enemy))
  (when (and (enemy-hit-deterministic? proc) (not (type? proc citizen)))
    (let ((record (mp-get-enemy-auth (-> proc net-id))))
      (when (and (nonnull? record) (= (-> record reaction-attack-id) (-> proc incoming attack-id)))
        (return record))))
  (the-as mp-enemy-auth-record #f))

(defun enemy-hit-facing-angle ((proc enemy))
  (let ((record (enemy-hit-record proc)))
    (cond
      ((nonnull? record) (-> record reaction-facing-angle))
      ((nonnull? proc (-> proc root)) (quaternion-y-angle (-> proc root quat)))
      (else 0.0))))

(defun enemy-hit-forward! ((proc enemy) (direction vector))
  (when (nonnull? proc direction (-> proc root))
    (if (nonnull? (enemy-hit-record proc))
      (let ((angle (enemy-hit-facing-angle proc)))
        (set-vector! direction (sin angle) 0.0 (cos angle) 0.0))
      (vector-z-quaternion! direction (-> proc root quat))))
  direction)

(defun enemy-hit-airborne? ((proc enemy) (fallback object))
  (let ((record (enemy-hit-record proc)))
    (if (nonnull? record) (logtest? (-> record reaction-flags) ENEMY_HIT_AIRBORNE) (if fallback #t #f))))

(defun enemy-hit-distance-squared ((proc enemy) (fallback vector))
  (let ((record (enemy-hit-record proc)))
    (if (nonnull? record)
      (-> record reaction-distance-squared)
      (if (nonnull? proc fallback (-> proc root))
        (vector-vector-xz-distance-squared fallback (-> proc root trans))
        0.0))))

(defun enemy-hit-remember-variant! ((proc enemy) (variant int))
  (let ((record (enemy-hit-record proc)))
    (when (nonnull? record)
      (set! (-> record reaction-variant) (the uint8 variant))))
  variant)

(defun enemy-hit-landing-variant ((proc enemy) (fallback int))
  (let ((record (enemy-hit-record proc)))
    (if (nonnull? record) (the int (-> record reaction-variant)) fallback)))

(defun enemy-hit-posture-flags ((proc enemy))
  (when (nonnull? proc (-> proc root))
    (when (and (type? proc grunt)
               (nonnull? (-> proc skel) (-> proc draw) (-> proc draw art-group))
               (> (-> proc skel active-channels) 0))
      (let ((animation (-> proc skel root-channel 0 frame-group))
            (art (-> proc draw art-group)))
        (return (if (or (= animation (-> art data 16))
                        (= animation (-> art data 38))
                        (= animation (-> art data 39))
                        (= animation (-> art data 40)))
                  ENEMY_HIT_AIRBORNE
                  (the uint8 0)))))
    (return (if (logtest? (-> proc root status) (collide-status on-ground)) (the uint8 0) ENEMY_HIT_AIRBORNE)))
  (the uint8 0))

(defun enemy-hit-prepare! ((proc enemy) (remote-event mp-actor-attack-event))
  (when (and (nonnull? proc remote-event)
             (= (-> remote-event payload attack-id) (-> proc incoming attack-id)))
    (when (logtest? (-> remote-event payload flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
      (vector-copy! (-> proc incoming attacker-pos) (-> remote-event payload source-pos)))
    (when (logtest? (-> remote-event payload flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
      (vector-copy! (-> proc incoming attack-direction) (-> remote-event payload attack-dir))))
  (when (and (enemy-hit-deterministic? proc) (not (type? proc citizen)) (nonnull? (-> proc root)))
    (let ((record (mp-get-enemy-auth (-> proc net-id))))
      (when (nonnull? record)
        (set! (-> record reaction-attack-id) (-> proc incoming attack-id))
        (set! (-> record reaction-variant) 0)
        (if (and (nonnull? remote-event)
                 (= (-> remote-event etype) MP_EVENT_ATTACK_ENEMY)
                 (= (-> remote-event payload attack-id) (-> proc incoming attack-id)))
          (let ((payload (-> (the-as enemy-hit-event remote-event) payload)))
            (set! (-> record reaction-facing-angle) (-> payload facing-angle))
            (set! (-> record reaction-distance-squared) (-> payload distance-squared))
            (set! (-> record reaction-flags) (-> payload flags))
            (set! (-> proc incoming blue-juggle-count) (-> payload blue-juggle-count)))
          (begin
            (set! (-> record reaction-facing-angle) (quaternion-y-angle (-> proc root quat)))
            (set! (-> record reaction-distance-squared)
                  (vector-vector-xz-distance-squared (-> proc incoming attacker-pos) (-> proc root trans)))
            (set! (-> record reaction-flags) (enemy-hit-posture-flags proc)))))))
  (none))

(defun enemy-hit-capture! ((proc enemy) (payload enemy-hit-event-data))
  (when (nonnull? proc payload (-> proc root))
    (let ((record (enemy-hit-record proc)))
      (if (and (nonnull? record) (= (-> payload attack-id) (-> proc incoming attack-id)))
        (begin
          (set! (-> payload facing-angle) (-> record reaction-facing-angle))
          (set! (-> payload distance-squared) (-> record reaction-distance-squared))
          (logior! (-> payload flags) (-> record reaction-flags))
          (set! (-> payload blue-juggle-count) (-> proc incoming blue-juggle-count)))
        (begin
          (set! (-> payload facing-angle) (quaternion-y-angle (-> proc root quat)))
          (set! (-> payload distance-squared)
                (vector-vector-xz-distance-squared (-> payload source-pos) (-> proc root trans)))
          (logior! (-> payload flags) (enemy-hit-posture-flags proc))
          (set! (-> payload blue-juggle-count)
                (if (= (-> payload knocked-type) (the uint8 (knocked-type knocked-type-6)))
                  (if (time-elapsed? (-> proc incoming attack-time) (seconds 1))
                    1
                    (min 255 (+ 1 (-> proc incoming blue-juggle-count))))
                  0))))))
  (none))

(defun enemy-hover-knock-velocity! ((proc enemy) (velocity vector))
  (when (nonnull? proc velocity (-> proc root) (-> proc enemy-info))
    (let ((root (-> proc root))
          (info (-> proc enemy-info))
          (attacker (the-as process-focusable (handle->process-safe (-> proc incoming attacker-handle))))
          (networked? (enemy-hit-deterministic? proc)))
      (cond
        (networked? (vector-negate! velocity (-> proc incoming attack-direction)))
        ((nonnull? attacker (-> attacker root)) (vector-! velocity (-> attacker root trans) (-> root trans)))
        (else (vector-! velocity (-> proc incoming attacker-pos) (-> root trans))))
      (set! (-> velocity y) 0.0)
      (vector-normalize! velocity 1.0)
      (vector-rotate90-around-y! velocity velocity)
      (when (if networked?
              (zero? (enemy-hit-rand-count proc 2))
              (< 0.0 (vector-dot
                       (vector-! (new 'stack-no-clear 'vector) (-> proc incoming attacker-pos) (-> root trans))
                       (vector-x-quaternion! (new 'stack-no-clear 'vector) (-> root quat)))))
        (vector-negate! velocity velocity))
      (let ((factor (enemy-knocked-rand-factor proc 0.0 1.0)))
        (vector-float*! velocity velocity (lerp (-> info knocked-hard-vxz-lo) (-> info knocked-hard-vxz-hi) factor))
        (set! (-> velocity y) (lerp (-> info knocked-hard-vy-lo) (-> info knocked-hard-vy-hi) factor)))))
  (none))

(defun enemy-hit-yellow-fatal-fall? ((proc enemy))
  (when (nonnull? proc (-> proc root))
    (let ((networked? (enemy-hit-deterministic? proc))
          (next (-> proc next-state)))
      (when (and (= (-> proc incoming knocked-type) (knocked-type knocked-type-4))
                 (or networked?
                     (not (and (nonnull? next)
                               (case (-> next name)
                                 (('knocked 'jump 'jump-land) #t)
                                 (else #f)))))
                 (zero? (enemy-hit-rand-count proc 3)))
        (if networked?
          (return (>= (enemy-hit-distance-squared proc (-> proc incoming attacker-pos)) (square (meters 8))))
          (when (nonnull? *target* (-> *target* root))
            (return (>= (vector-vector-distance-squared (-> proc root trans) (target-pos 0)) (square (meters 8)))))))))
  #f)
