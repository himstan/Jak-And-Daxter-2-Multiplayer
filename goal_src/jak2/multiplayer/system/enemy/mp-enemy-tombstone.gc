;;-*-Lisp-*-
(in-package goal)

(defun mp-battle-enemy-id? ((aid uint))
  (and (>= aid #x60000000) (< aid #x70000000)))

(defun mp-mark-aid-dead-perm! ((aid uint))
  (when (or (zero? aid) (mp-battle-enemy-id? aid))
    (return #f))
  (mp-record-aid-dead-in-perm-list! aid))

(defun mp-aid-dead-perm? ((aid uint))
  (and (nonzero? aid) (not (mp-battle-enemy-id? aid)) (mp-aid-dead-in-perm-list? aid)))

(defun mp-deactivate-dead-aid-if-loaded! ((aid uint))
  (when (or (not (mp-aid-dead-perm? aid)) (mp-battle-enemy-id? aid))
    (return #f))
  (let ((ent (entity-by-aid aid)))
    (when (nonnull? ent (-> ent extra) (-> ent extra perm))
      (let ((perm (-> ent extra perm))) (when (nonnull? perm) (logior! (-> perm status) (entity-perm-status dead)))))
    (when (nonnull? ent (-> ent extra) (-> ent extra process))
      (let ((proc (-> ent extra process)))
        (when (nonnull? proc)
          (log 'debug "[MP-Tombstone] Deactivating loaded dead aid=~D proc=~A.~%" aid proc)
          (deactivate proc)
          (return #t)))))
  #f)
