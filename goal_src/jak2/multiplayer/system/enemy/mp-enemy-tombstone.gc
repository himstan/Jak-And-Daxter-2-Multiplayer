;;-*-Lisp-*-
(in-package goal)

(defun mp-battle-enemy-id? ((aid uint))
  (and (>= aid #x60000000) (< aid #x70000000)))

(defun mp-mark-aid-dead-perm! ((aid uint))
  (when (or (zero? aid) (mp-battle-enemy-id? aid))
    (return #f))
  (let ((recorded? (mp-record-aid-dead-in-perm-list! aid))
        (ent (if (nonnull? *level*) (entity-by-aid aid) (the-as entity-actor #f))))
    (when (nonnull? ent (-> ent extra) (-> ent extra perm))
      (logior! (-> ent extra perm status) (entity-perm-status dead)))
    recorded?))

(defun mp-aid-dead-perm? ((aid uint))
  (and (nonzero? aid) (not (mp-battle-enemy-id? aid)) (mp-aid-dead-in-perm-list? aid)))

(defun enemy-restore-actor-tombstone! ((ent entity-actor))
  (when (and (mp-session-in-game?)
             (nonnull? ent)
             (type? ent entity-actor)
             (nonnull? (-> ent extra) (-> ent extra perm) (-> ent etype))
             (type-type? (-> ent etype) enemy)
             (mp-aid-dead-perm? (-> ent aid)))
    (logior! (-> ent extra perm status) (entity-perm-status dead)))
  (none))
