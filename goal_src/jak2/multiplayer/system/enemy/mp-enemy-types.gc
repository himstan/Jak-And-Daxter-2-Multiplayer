(in-package goal)

(defconstant MP_MISSION_ENEMY_ATOLL_ASHELIN (the uint #x6f000001))

(deftype mp-enemy-state (structure)
  ((actor-id        uint32)
   (x               float)
   (y               float)
   (z               float)
   (quat-x          float)
   (quat-y          float)
   (quat-z          float)
   (quat-w          float)
   (hp              int32)
   (state           uint32)
   (focus-player-id uint32)
   (attack-flag     uint8)
   (owner-player-id uint8)
   (is-aggro        uint8)
   (generation      uint64))
  :size-assert 56)

(defconstant MP_MAX_SYNC_ENEMIES 128)
(defconstant MP_MAX_REMOTE_ENEMIES (* MP_MAX_SYNC_ENEMIES (- MP_MAX_PLAYERS 1)))
(defconstant MP_MAX_ENEMY_AUTH_RECORDS (* MP_MAX_SYNC_ENEMIES MP_MAX_PLAYERS))

(deftype mp-enemy-sync-buffer (structure)
  ((local-count    uint32)
   (local-enemies  mp-enemy-state MP_MAX_SYNC_ENEMIES :inline)
   (remote-count   uint32)
   (remote-enemies mp-enemy-state MP_MAX_REMOTE_ENEMIES :inline)
   (generation     uint64))
  :size-assert
  (+
   40
   (* 64 (+ MP_MAX_SYNC_ENEMIES MP_MAX_REMOTE_ENEMIES))))

(defenum mp-enemy-state-id
  (uint32)
  (none 0)
  (active 1)
  (notice 2)
  (hostile 3)
  (hit 4)
  (knocked 5)
  (stare 6)
  (idle 7)
  (victory 8)
  (die 9)
  (dormant 10)
  (dormant-aware 11)
  (ambush 12)
  (flee 13)
  (jump 14)
  (jump-blocked 15)
  (chase 16)
  (patrol 17)
  (pacing 18)
  (circling 19)
  (taunt 20)
  (stop-chase 21)
  (staredown 22)
  (gun-shoot 23)
  (get-up-front 24)
  (get-up-back 25)
  (close-attack 26)
  (grenade-attack 27)
  (exit-transport 28)
  (blast-hostile 29)
  (grenade-hostile 30)
  (tazer-hostile 31)
  (roll-right 32)
  (roll-left 33)
  (arrest 34)
  (attack 35)
  (falling-ambush 36)
  (jumping-ambush 37)
  (jumping-ambush-cont 38)
  (wait-for-focus 39)
  (spin-attack 40)
  (traveling 41)
  (traveling-blocked 42)
  (waiting-far 43)
  (waiting-close 44)
  (waiting-turn 45)
  (waiting-crouched 46)
  (die-falling 47)
  (failed 48)
  (hidden 49)
  (sig-path-run 50)
  (sig-path-jump 51)
  (sig-path-jump-land 52)
  (sig-path-shoot-jump 53)
  (sig-path-shoot-jump-land 54)
  (sig-path-idle 55)
  (charge-plasma 56)
  (gun-jam 57)
  (repair-gun 58)
  (clean-gun 59)
  (whip 60)
  (blast 61)
  (chase-attack 62)
  (stare-idle 63)
  (attack-forward 64)
  (attack-forward-lunge 65)
  (attack-forward-end 66)
  (attack-spin 67)
  (tongue-attack 68)
  (run-away 69)
  (stop-run 70)
  (charge 71)
  (waiting 72)
  (scare 73)
  (waiting-idle 74)
  (standing-idle 75)
  (standing-turn 76)
  (standing-blast 77)
  (back-spring 78)
  (cartwheel-left 79)
  (tumble-right 80)
  (turn 81)
  (attack-recover 82)
  (explode 83)
  (fly-away 84)
  (go-to-door 85)
  (key 86)
  (land 87)
  (stand 88)
  (directed 89)
  (fire 90))

(deftype mp-enemy-auth-record (structure)
  ((aid                         uint32)
   (process-handle              handle)
   (request-pending?            uint8)
   (owner-player-id             uint8)
   (level-id                    uint8)
   (loaded-player-mask          uint8)
   (combat-owner-player-id      uint8)
   (is-aggro                    symbol)
   (last-transfer-time          time-frame)
   (request-time                time-frame)
   (last-attack-id              uint32)
   (last-local-attack-id        uint32)
   (last-local-attack-time      time-frame)
   (trans                       vector :inline)
   (quat                        quaternion :inline)
   (linvel                      vector :inline)
   (generation                  uint32)
   (state                       mp-enemy-state-id)
   (focus-player-id             uint32)
   (just-taken-authority        symbol)
   (last-applied-remote-state   mp-enemy-state-id)
   (last-remote-state-bump-time time-frame)
   (locomotion-animation        int16)
   (locomotion-frame            float)))

(deftype mp-enemy-auth-table (structure)
  ((records mp-enemy-auth-record MP_MAX_ENEMY_AUTH_RECORDS :inline)))

(define-perm *mp-enemy-buffer* mp-enemy-sync-buffer (new 'static 'mp-enemy-sync-buffer))
(define-perm *mp-enemy-auth* (inline-array mp-enemy-auth-record) (-> (new 'static 'mp-enemy-auth-table) records))

(define-extern find-enemy-by-aid (function uint enemy))
(define-extern find-any-enemy-by-aid (function uint enemy))
(define-extern mp-get-enemy-aid (function enemy uint))
(define-extern mp-get-enemy-auth (function uint mp-enemy-auth-record))
(define-extern mp-enemy-reserve-auth-record! (function uint uint mp-enemy-auth-record))
(define-extern mp-enemy-release-auth-record! (function mp-enemy-auth-record none))
(define-extern mp-enemy-track-authority! (function enemy uint mp-enemy-auth-record))
(define-extern mp-enemy-take-local-control! (function enemy mp-enemy-auth-record none))
(define-extern mp-enemy-reclaim-auth-records! (function none))
(define-extern mp-reset-enemy-authority! (function none))
(define-extern mp-enemy-level-id (function enemy uint))
(define-extern mp-enemy-aggro? (function enemy symbol))
(define-extern mp-enemy-delegatable? (function enemy uint symbol))
(define-extern mp-event-apply-enemy-authority! (function mp-enemy-auth-record enemy uint none))
(define-extern mp-enemy-request-if-needed! (function mp-enemy-auth-record enemy none))
(define-extern mp-enemy-authority-tick! (function none))
(define-extern mp-enemy-reassign-authority! (function mp-enemy-auth-record enemy uint none))
(define-extern mp-enemy-broadcast-death (function enemy none))
(define-extern mp-enemy-get-state-id (function enemy uint))
(define-extern mp-enemy-pack-state (function enemy mp-enemy-state uint none))
(define-extern mp-enemy-apply-state (function enemy mp-enemy-state none))
(define-extern mp-enemy-note-remote-battle-spawn! (function enemy none))
(define-extern mp-sync-enemies-update (function none))
(define-extern mp-enemy-authoritative? (function enemy symbol))
(define-extern mp-battle-handle-local-trigger! (function battle symbol))
(define-extern mp-battle-local-owner? (function battle symbol))
(define-extern mp-battle-owner-player-id (function battle int))
(define-extern mp-battle-epoch (function battle uint))
(define-extern mp-battle-dynamic-aid-valid? (function uint symbol))
(define-extern mp-battle-enemy-owner-player-id (function enemy int))
(define-extern mp-battle-note-local-spawn! (function battle int int symbol uint none))
(define-extern mp-battle-note-local-end! (function battle none))
(define-extern mp-battle-note-enemy-death! (function enemy none))
(define-extern mp-battle-request-rosters! (function none))
(define-extern mp-battle-sync-tick (function mp-connection-status none))
(define-extern mp-reset-battle-sync-state! (function none))
(define-extern mp-arm-mission-failed-bootstrap-after-spawn (function none))
(define-extern mp-request-mission-failed-bootstrap-when-ready (function none))
(define-extern *mp-battle-spawn-counter* uint)
(define-extern mp-generate-battle-enemy-aid (function uint))
(define-extern mp-local-player-id (function uint))
