(in-package goal)

(defun mp-enemy-locomotion-ready? ((proc enemy) (rec mp-enemy-auth-record) (slot mp-enemy-state))
  (and (nonnull? proc
                 rec
                 slot
                 (-> proc state)
                 (-> proc skel)
                 (-> proc draw)
                 (-> proc draw art-group)
                 (-> proc enemy-info))
       (type? proc nav-enemy)
       (type? (-> proc enemy-info) nav-enemy-info)
       (mp-enemy-remote-transform-ready? proc slot)
       (= (-> rec owner-player-id) (-> slot owner-player-id))
       (= (mp-enemy-get-state-id proc) (-> slot state))
       (or (not (nonnull? (-> proc next-state))) (= (-> proc next-state) (-> proc state)))
       (case (-> proc state name)
         (('active 'patrol 'pacing 'chase) #t)
         (else #f))
       (> (-> proc skel active-channels) 0)
       (or (= (-> proc skel generate-frame-function) create-interpolated-joint-animation-frame)
           (= (-> proc skel generate-frame-function) create-interpolated2-joint-animation-frame))))

(defun mp-enemy-locomotion-animation ((info nav-enemy-info) (rec mp-enemy-auth-record) (speed float))
  (when (not (nonnull? info rec))
    (return -1))
  (cond
    ((< speed (if (= (-> rec locomotion-animation) (-> info idle-anim)) (meters 0.15) (meters 0.08)))
     (-> info idle-anim))
    ((and (> (-> info run-travel-speed) (-> info walk-travel-speed))
          (> speed
             (* (+ (-> info walk-travel-speed) (-> info run-travel-speed))
                (if (= (-> rec locomotion-animation) (-> info run-anim)) 0.45 0.55))))
     (-> info run-anim))
    (else (-> info walk-anim))))

(defun mp-enemy-prepare-locomotion! ((proc enemy) (rec mp-enemy-auth-record))
  (when (not (nonnull? proc rec (-> proc enemy-info) (-> proc draw) (-> proc draw art-group)))
    (return #f))
  (let* ((info (the-as nav-enemy-info (-> proc enemy-info)))
         (speed (vector-xz-length (-> rec linvel)))
         (anim-index (mp-enemy-locomotion-animation info rec speed))
         (art (-> proc draw art-group)))
    (when (or (< anim-index 0) (> anim-index 32767) (>= anim-index (-> art length)))
      (return #f))
    (let ((anim (the-as art-joint-anim (-> art data anim-index))))
      (when (not (and (nonnull? anim)
                      (type? anim art-joint-anim)
                      (nonnull? (-> anim frames))
                      (> (-> anim frames num-frames) 1)
                      (nonnull? *anim-manager*)))
        (return #f))
      (when (logtest? (-> anim frames flags) 1)
        (decompress *anim-manager* anim))
      (when (logtest? (-> anim frames flags) 2)
        (update-time-stamp *anim-manager* anim))
      (if (!= anim-index (-> rec locomotion-animation))
        (set! (-> rec locomotion-frame) 0.0)
        (let* ((travel-speed (cond
                               ((= anim-index (-> info idle-anim)) 0.0)
                               ((= anim-index (-> info run-anim)) (-> info run-travel-speed))
                               (else (-> info walk-travel-speed))))
               (rate (if (> travel-speed 0.0) (fmax 0.5 (fmin 1.5 (/ speed travel-speed))) 1.0))
               (elapsed (/ (the float (- (current-time) (-> rec locomotion-time))) (the float (seconds 1))))
               (frame-max (the float (- (-> anim frames num-frames) 1)))
               (frame (+ (-> rec locomotion-frame) (* (fmin elapsed 0.1) 60.0 (-> anim speed) rate))))
          (set! (-> rec locomotion-frame) (- frame (* (the float (the int (/ frame frame-max))) frame-max)))))
      (set! (-> rec locomotion-animation) anim-index)
      (set-time! (-> rec locomotion-time))
      #t)))

(defun mp-enemy-generate-locomotion-frame ((frame joint-anim-frame) (num-joints int) (control joint-control))
  (when (not (nonnull? frame control))
    (return 0))
  (with-pp
    (let* ((proc (the-as enemy pp))
           (rec (if (nonnull? proc) (mp-get-enemy-auth (mp-get-enemy-aid proc)) (the-as mp-enemy-auth-record #f))))
      (when (not (nonnull? rec proc (-> proc draw) (-> proc draw art-group)))
        (return (create-interpolated-joint-animation-frame frame num-joints control)))
      (let* ((channel (-> control channel 0))
             (saved-channel (new 'stack-no-clear 'joint-control-channel))
             (saved-root (-> control root-channel))
             (saved-active (-> control active-channels))
             (saved-float (-> control float-channels)))
        (mem-copy! (the-as pointer saved-channel) (the-as pointer channel) (size-of joint-control-channel))
        (set! (-> channel frame-group)
              (the-as art-joint-anim (-> proc draw art-group data (-> rec locomotion-animation))))
        (set! (-> channel frame-num) (-> rec locomotion-frame))
        (set! (-> channel command) (joint-control-command push))
        (set! (-> control root-channel) (the-as (inline-array joint-control-channel) channel))
        (set! (-> control active-channels) 1)
        (set! (-> control float-channels) 0)
        (create-interpolated-joint-animation-frame frame num-joints control)
        (mem-copy! (the-as pointer channel) (the-as pointer saved-channel) (size-of joint-control-channel))
        (set! (-> control root-channel) saved-root)
        (set! (-> control active-channels) saved-active)
        (set! (-> control float-channels) saved-float))))
  0)

(defbehavior mp-enemy-animation-post enemy ()
  (if (and (nonnull? self (mp-local-player-record)) (type? self nav-enemy))
    (let* ((aid (mp-get-enemy-aid self))
           (rec (if (nonzero? aid) (mp-get-enemy-auth aid) (the-as mp-enemy-auth-record #f)))
           (slot (if (nonzero? aid) (mp-enemy-find-remote-slot aid) (the-as mp-enemy-state #f))))
      (if (and (mp-enemy-locomotion-ready? self rec slot) (mp-enemy-prepare-locomotion! self rec))
        (let* ((control (-> self skel))
               (generator (-> control generate-frame-function))
               (sync-math? (logtest? (-> control status) (joint-control-status sync-math))))
          (set! (-> control generate-frame-function) mp-enemy-generate-locomotion-frame)
          (logior! (-> control status) (joint-control-status sync-math))
          (ja-post)
          (set! (-> control generate-frame-function) generator)
          (unless sync-math?
            (logclear! (-> control status) (joint-control-status sync-math))))
        (begin
          (when (nonnull? rec)
            (set! (-> rec locomotion-animation) -1))
          (ja-post))))
    (ja-post))
  (none))
