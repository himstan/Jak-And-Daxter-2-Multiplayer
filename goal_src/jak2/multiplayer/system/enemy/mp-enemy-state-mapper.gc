;;-*-Lisp-*-
(in-package goal)

(defun mp-enemy-get-state-id ((e-proc enemy))
  "Get a numeric ID for the current virtual state of an enemy."
  (let ((s-name (if (and e-proc
                            (nonzero? e-proc)
                            (-> e-proc state)
                            (nonzero? (-> e-proc state)))
                       (-> e-proc state name)
                       #f)))
    (case s-name
      (('active) (the-as uint32 1))
      (('notice) (the-as uint32 2))
      (('hostile) (the-as uint32 3))
      (('hit) (the-as uint32 4))
      (('knocked 'knocked-vicinity) (the-as uint32 5))
      (('stare) (the-as uint32 6))
      (('idle) (the-as uint32 7))
      (('victory) (the-as uint32 8))
      (('die 'die-falling 'die-fast) (the-as uint32 9))
      (('dormant) (the-as uint32 10))
      (('dormant-aware) (the-as uint32 11))
      (('ambush) (the-as uint32 12))
      (('flee) (the-as uint32 13))
      (('jump) (the-as uint32 14))
      (('jump-blocked) (the-as uint32 15))
      (('chase) (the-as uint32 16))
      (('patrol) (the-as uint32 17))
      (('pacing) (the-as uint32 18))
      (('circling) (the-as uint32 19))
      (('taunt) (the-as uint32 20))
      (('stop-chase) (the-as uint32 21))
      (('staredown) (the-as uint32 22))
      (('gun-shoot) (the-as uint32 23))
      (('get-up-front) (the-as uint32 24))
      (('get-up-back) (the-as uint32 25))
      (('close-attack) (the-as uint32 26))
      (('grenade-attack) (the-as uint32 27))
      (('exit-transport) (the-as uint32 28))
      (('blast-hostile) (the-as uint32 29))
      (('grenade-hostile) (the-as uint32 30))
      (('tazer-hostile) (the-as uint32 31))
      (('roll-right) (the-as uint32 32))
      (('roll-left) (the-as uint32 33))
      (('arrest) (the-as uint32 34))
      (('attack) (the-as uint32 35))
      (('falling-ambush) (the-as uint32 36))
      (('jumping-ambush) (the-as uint32 37))
      (('jumping-ambush-cont) (the-as uint32 38))
      (('wait-for-focus) (the-as uint32 39))
      (('spin-attack) (the-as uint32 40))
      (('traveling) (the-as uint32 41))
      (('traveling-blocked) (the-as uint32 42))
      (('waiting-far) (the-as uint32 43))
      (('waiting-close) (the-as uint32 44))
      (('waiting-turn) (the-as uint32 45))
      (('waiting-crouched) (the-as uint32 46))
      (('die-falling) (the-as uint32 47))
      (('failed) (the-as uint32 48))
      (('hidden) (the-as uint32 49))
      (('sig-path-run) (the-as uint32 50))
      (('sig-path-jump) (the-as uint32 51))
      (('sig-path-jump-land) (the-as uint32 52))
      (('sig-path-shoot-jump) (the-as uint32 53))
      (('sig-path-shoot-jump-land) (the-as uint32 54))
      (('sig-path-idle) (the-as uint32 55))
      (('charge-plasma) (the-as uint32 56))
      (('gun-jam) (the-as uint32 57))
      (('repair-gun) (the-as uint32 58))
      (('clean-gun) (the-as uint32 59))
      (('whip) (the-as uint32 60))
      (('blast) (the-as uint32 61))
      (('chase-attack) (the-as uint32 62))
      (('stare-idle) (the-as uint32 63))
      (('attack-forward) (the-as uint32 64))
      (('attack-forward-lunge) (the-as uint32 65))
      (('attack-forward-end) (the-as uint32 66))
      (('attack-spin) (the-as uint32 67))
      (('tongue-attack) (the-as uint32 68))
      (('run-away) (the-as uint32 69))
      (('stop-run) (the-as uint32 70))
      (('charge) (the-as uint32 71))
      (('waiting) (the-as uint32 72))
      (('scare) (the-as uint32 73))
      (('waiting-idle) (the-as uint32 74))
      (('standing-idle) (the-as uint32 75))
      (('standing-turn) (the-as uint32 76))
      (('standing-blast) (the-as uint32 77))
      (('back-spring) (the-as uint32 78))
      (('cartwheel-left) (the-as uint32 79))
      (('tumble-right) (the-as uint32 80))
      (('turn) (the-as uint32 81))
      (('attack-recover) (the-as uint32 82))
      (('explode) (the-as uint32 83))
      (('fly-away) (the-as uint32 84))
      (('go-to-door) (the-as uint32 85))
      (('key) (the-as uint32 86))
      (('land) (the-as uint32 87))
      (('stand) (the-as uint32 88))
      (('directed) (the-as uint32 89))
      (else (the-as uint32 0))
      )
    )
  )

(defun mp-enemy-get-state-from-id ((id uint))
  "Map a numeric ID back to a virtual state symbol."
  (case (the-as mp-enemy-state-id id)
    (((mp-enemy-state-id active)) 'active)
    (((mp-enemy-state-id notice)) 'notice)
    (((mp-enemy-state-id hostile)) 'hostile)
    (((mp-enemy-state-id hit)) 'hit)
    (((mp-enemy-state-id knocked)) 'knocked)
    (((mp-enemy-state-id stare)) 'stare)
    (((mp-enemy-state-id idle)) 'idle)
    (((mp-enemy-state-id victory)) 'victory)
    (((mp-enemy-state-id die)) 'die)
    (((mp-enemy-state-id dormant)) 'dormant)
    (((mp-enemy-state-id dormant-aware)) 'dormant-aware)
    (((mp-enemy-state-id ambush)) 'ambush)
    (((mp-enemy-state-id flee)) 'flee)
    (((mp-enemy-state-id jump)) 'jump)
    (((mp-enemy-state-id jump-blocked)) 'jump-blocked)
    (((mp-enemy-state-id chase)) 'chase)
    (((mp-enemy-state-id patrol)) 'patrol)
    (((mp-enemy-state-id pacing)) 'pacing)
    (((mp-enemy-state-id circling)) 'circling)
    (((mp-enemy-state-id taunt)) 'taunt)
    (((mp-enemy-state-id stop-chase)) 'stop-chase)
    (((mp-enemy-state-id staredown)) 'staredown)
    (((mp-enemy-state-id gun-shoot)) 'gun-shoot)
    (((mp-enemy-state-id get-up-front)) 'get-up-front)
    (((mp-enemy-state-id get-up-back)) 'get-up-back)
    (((mp-enemy-state-id close-attack)) 'close-attack)
    (((mp-enemy-state-id grenade-attack)) 'grenade-attack)
    (((mp-enemy-state-id exit-transport)) 'exit-transport)
    (((mp-enemy-state-id blast-hostile)) 'blast-hostile)
    (((mp-enemy-state-id grenade-hostile)) 'grenade-hostile)
    (((mp-enemy-state-id tazer-hostile)) 'tazer-hostile)
    (((mp-enemy-state-id roll-right)) 'roll-right)
    (((mp-enemy-state-id roll-left)) 'roll-left)
    (((mp-enemy-state-id arrest)) 'arrest)
    (((mp-enemy-state-id attack)) 'attack)
    (((mp-enemy-state-id falling-ambush)) 'falling-ambush)
    (((mp-enemy-state-id jumping-ambush)) 'jumping-ambush)
    (((mp-enemy-state-id jumping-ambush-cont)) 'jumping-ambush-cont)
    (((mp-enemy-state-id wait-for-focus)) 'wait-for-focus)
    (((mp-enemy-state-id spin-attack)) 'spin-attack)
    (((mp-enemy-state-id traveling)) 'traveling)
    (((mp-enemy-state-id traveling-blocked)) 'traveling-blocked)
    (((mp-enemy-state-id waiting-far)) 'waiting-far)
    (((mp-enemy-state-id waiting-close)) 'waiting-close)
    (((mp-enemy-state-id waiting-turn)) 'waiting-turn)
    (((mp-enemy-state-id waiting-crouched)) 'waiting-crouched)
    (((mp-enemy-state-id die-falling)) 'die-falling)
    (((mp-enemy-state-id failed)) 'failed)
    (((mp-enemy-state-id hidden)) 'hidden)
    (((mp-enemy-state-id sig-path-run)) 'sig-path-run)
    (((mp-enemy-state-id sig-path-jump)) 'sig-path-jump)
    (((mp-enemy-state-id sig-path-jump-land)) 'sig-path-jump-land)
    (((mp-enemy-state-id sig-path-shoot-jump)) 'sig-path-shoot-jump)
    (((mp-enemy-state-id sig-path-shoot-jump-land)) 'sig-path-shoot-jump-land)
    (((mp-enemy-state-id sig-path-idle)) 'sig-path-idle)
    (((mp-enemy-state-id charge-plasma)) 'charge-plasma)
    (((mp-enemy-state-id gun-jam)) 'gun-jam)
    (((mp-enemy-state-id repair-gun)) 'repair-gun)
    (((mp-enemy-state-id clean-gun)) 'clean-gun)
    (((mp-enemy-state-id whip)) 'whip)
    (((mp-enemy-state-id blast)) 'blast)
    (((mp-enemy-state-id chase-attack)) 'chase-attack)
    (((mp-enemy-state-id stare-idle)) 'stare-idle)
    (((mp-enemy-state-id attack-forward)) 'attack-forward)
    (((mp-enemy-state-id attack-forward-lunge)) 'attack-forward-lunge)
    (((mp-enemy-state-id attack-forward-end)) 'attack-forward-end)
    (((mp-enemy-state-id attack-spin)) 'attack-spin)
    (((mp-enemy-state-id tongue-attack)) 'tongue-attack)
    (((mp-enemy-state-id run-away)) 'run-away)
    (((mp-enemy-state-id stop-run)) 'stop-run)
    (((mp-enemy-state-id charge)) 'charge)
    (((mp-enemy-state-id waiting)) 'waiting)
    (((mp-enemy-state-id scare)) 'scare)
    (((mp-enemy-state-id waiting-idle)) 'waiting-idle)
    (((mp-enemy-state-id standing-idle)) 'standing-idle)
    (((mp-enemy-state-id standing-turn)) 'standing-turn)
    (((mp-enemy-state-id standing-blast)) 'standing-blast)
    (((mp-enemy-state-id back-spring)) 'back-spring)
    (((mp-enemy-state-id cartwheel-left)) 'cartwheel-left)
    (((mp-enemy-state-id tumble-right)) 'tumble-right)
    (((mp-enemy-state-id turn)) 'turn)
    (((mp-enemy-state-id attack-recover)) 'attack-recover)
    (((mp-enemy-state-id explode)) 'explode)
    (((mp-enemy-state-id fly-away)) 'fly-away)
    (((mp-enemy-state-id go-to-door)) 'go-to-door)
    (((mp-enemy-state-id key)) 'key)
    (((mp-enemy-state-id land)) 'land)
    (((mp-enemy-state-id stand)) 'stand)
    (((mp-enemy-state-id directed)) 'directed)
    (else 'active)
    )
  )

