;;-*-Lisp-*-
(in-package goal)

(define-extern mp-get-enemy-auth (function uint mp-enemy-auth-record))
(define-extern mp-get-free-enemy-auth (function mp-enemy-auth-record))
(define-extern mp-enemy-find-remote-slot (function uint mp-enemy-state))

(defun is-in-pausable-state? ((state-name symbol))
  (case state-name
    (('knocked 'get-up-front 'get-up-back 'die 'die-falling 'die-fast)
     #t
     )
    (else #f)
    )
  )

(defun is-enemy-in-pausable-state? ((e enemy))
  (let ((state-name (if (-> e state) (-> e state name) #f)))
    (is-in-pausable-state? state-name)
    )
  )

(defun mp-enemy-death-presentation-active? ((e enemy))
  "True once a loaded enemy should finish its local death presentation."
  (and e
       (nonzero? e)
       (or (<= (-> e hit-points) 0)
           (= (-> e status) 'dead)
           (logtest? (-> e enemy-flags) (enemy-flag death-start mp-synced-death)))
       )
  )

(defun mp-enemy-terminal-sync? ((e-proc enemy) (enemy-aid uint))
  "True once sync/authority must stop treating this enemy as alive."
  (and e-proc
       (nonzero? e-proc)
       (or (<= (-> e-proc hit-points) 0)
           (= (-> e-proc status) 'dead)
           (logtest? (-> e-proc enemy-flags) (enemy-flag death-start mp-synced-death))
           (and (nonzero? enemy-aid)
                (mp-aid-dead-perm? enemy-aid)))
       )
  )

(defun mp-enemy-state-current-or-pending? ((e-proc enemy) (target-state symbol))
  (or (and (-> e-proc state) (= (-> e-proc state name) target-state))
      (and (-> e-proc next-state) (= (-> e-proc next-state name) target-state)))
  )

(defun mp-enemy-state-retry-ready? ((rec mp-enemy-auth-record))
  (mp-actor-state-retry-ready? (-> rec last-remote-state-bump-time))
  )

(defun mp-enemy-sync-remote-state! ((e-proc enemy) (rec mp-enemy-auth-record) (remote-state-id uint))
  "Edge-trigger remote enemy state entry so repeated sync packets do not rebuild animation channels."
  (when (and (nonzero? remote-state-id)
             (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start))))
    (let ((target-state (mp-enemy-get-state-from-id remote-state-id)))
      (when (and target-state (!= target-state 'die) (!= target-state 'mp-puppet))
        (if (mp-enemy-state-current-or-pending? e-proc target-state)
            (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id remote-state-id))
            (when (or (!= (the-as mp-enemy-state-id remote-state-id) (-> rec last-applied-remote-state))
                      (mp-enemy-state-retry-ready? rec))
              (let ((st (method-state (-> e-proc type) (the-as basic target-state))))
                (when (and st (nonzero? st))
                  (set! *mp-processing-remote-event* #t)
                  (send-event e-proc 'go-state target-state)
                  (set! *mp-processing-remote-event* #f)
                  (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id remote-state-id))
                  (set! (-> rec last-remote-state-bump-time) (current-time))
                  )
                )
              )
            )
        )
      )
    )
  (none)
  )

(defun mp-enemy-restore-interrupted-root-collision! ((e-proc enemy)
                                                      (target-state symbol))
  "Restore temporary root collision when a forced state interrupts code with no exit cleanup."
  (when (or (not (and e-proc (nonzero? e-proc)))
            (not target-state)
            (mp-enemy-authoritative? e-proc))
    (return #f)
    )
  (let ((current-state (-> e-proc state)))
    (when (or (not (and current-state (nonzero? current-state)))
              (-> current-state exit))
      (return #f)
      )
    (let ((e-root (-> e-proc root)))
      (when (not (and e-root (nonzero? e-root)))
        (return #f)
        )
      (let ((root-prim (-> e-root root-prim)))
        (when (not (and root-prim (nonzero? root-prim)))
          (return #f)
          )
        (let ((backup-as (-> e-root backup-collide-as))
              (backup-with (-> e-root backup-collide-with))
              (restored? #f))
          (when (and (zero? (-> root-prim prim-core collide-as))
                     (nonzero? backup-as))
            (set! (-> root-prim prim-core collide-as) backup-as)
            (set! restored? #t)
            )
          (when (and (zero? (-> root-prim prim-core collide-with))
                     (nonzero? backup-with))
            (set! (-> root-prim prim-core collide-with) backup-with)
            (set! restored? #t)
            )
          restored?
          )
        )
      )
    )
  )

(defun mp-enemy-force-remote-state! ((e-proc enemy) (target-state symbol))
  "Force an inbound authoritative enemy state without compile-time state dispatch."
  (when (and e-proc
             (nonzero? e-proc)
             target-state)
    (let ((e-root (-> e-proc root))
          (enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and e-root
                 (nonzero? e-root)
                 (not (mp-enemy-terminal-sync? e-proc enemy-aid)))
        (let ((current-state (-> e-proc state)))
          (let ((cur-state (if (and current-state (nonzero? current-state))
                               (-> current-state name)
                               #f)))
            (when (!= cur-state target-state)
              (let ((st (method-state (-> e-proc type) (the-as basic target-state))))
                (when (and st (nonzero? st))
                  (mp-enemy-restore-interrupted-root-collision! e-proc target-state)
                  (process-mask-clear! (-> e-proc mask) sleep sleep-code)
                  (set! (-> e-proc next-state) (the-as state st))
                  (enter-state
                    (the-as object (-> e-root trans))
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f)
                    (the-as object #f))
                  (with-pp
                    (when (and (= (-> *kernel-context* current-process) pp)
                               (= (-> pp main-thread) (-> pp top-thread))
                               (= (-> pp state) (-> pp next-state)))
                      (throw 'go #t)
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  #t
  )

(defun mp-enemy-handle-go-state-event! ((e-proc enemy) (event-block event-message-block))
  (if (and event-block (nonzero? event-block))
      (mp-enemy-force-remote-state! e-proc (the-as symbol (-> event-block param 0)))
      #t)
  )

(defun mp-enemy-pack-state ((e-proc enemy) (slot mp-enemy-state) (aid uint))
  "Pack local enemy state into a sync slot (Owner Side)."
  (set! (-> slot actor-id) (the-as uint32 aid))
  (set! (-> slot x) (-> e-proc root trans x))
  (set! (-> slot y) (-> e-proc root trans y))
  (set! (-> slot z) (-> e-proc root trans z))
  (set! (-> slot quat-x) (-> e-proc root quat x))
  (set! (-> slot quat-y) (-> e-proc root quat y))
  (set! (-> slot quat-z) (-> e-proc root quat z))
  (set! (-> slot quat-w) (-> e-proc root quat w))
  (set! (-> slot hp) (-> e-proc hit-points))
  (set! (-> slot state) (mp-enemy-get-state-id e-proc))
  (set! (-> slot focus-player-id) MP_INVALID_PLAYER_ID)
  (let ((focus (the-as process #f)))
    (if (and (-> e-proc focus) (nonzero? (-> e-proc focus)))
        (set! focus (handle->process-safe (-> e-proc focus handle)))
        )
    (when (and focus (nonzero? focus))
      (let ((focus-player-id (mp-player-id-from-process focus)))
        (when (mp-player-id-valid? focus-player-id)
          (set! (-> slot focus-player-id) (the-as uint32 focus-player-id))))
      )
    )
  (none)
  )

(defun mp-enemy-reset-remote-motion-sample! ((rec mp-enemy-auth-record))
  (when (and rec (nonzero? rec))
    (vector-reset! (-> rec ghost-linvel))
    (set! (-> rec ghost-sample-time) (the uint 0))
    (set! (-> rec presentation-valid) (the uint8 0))
    )
  (none)
  )

(defun mp-enemy-release-auth-record! ((rec mp-enemy-auth-record))
  (when (and rec (nonzero? rec))
    (mp-enemy-reset-remote-motion-sample! rec)
    (set! (-> rec aid) (the-as uint32 0))
    )
  (none)
  )

(defun mp-enemy-update-remote-linvel! ((rec mp-enemy-auth-record)
                                       (slot mp-enemy-state)
                                       (sample-time uint)
                                       (previous-time uint))
  (when (and rec (nonzero? rec) slot (nonzero? slot))
    (let ((remote-pos (new 'stack-no-clear 'vector)))
      (set-vector! remote-pos (-> slot x) (-> slot y) (-> slot z) 1.0)
      (if (and (nonzero? previous-time)
               (> sample-time previous-time)
               (< (- sample-time previous-time) (the uint 500))
               (< (vector-vector-distance remote-pos (-> rec ghost-trans)) (meters 10)))
          (let ((sample-seconds (* 0.001 (the float (- sample-time previous-time))))
                (measured-linvel (new 'stack-no-clear 'vector)))
            (vector-float*! measured-linvel
                            (vector-! measured-linvel remote-pos (-> rec ghost-trans))
                            (/ 1.0 sample-seconds))
            (vector-lerp! (-> rec ghost-linvel) (-> rec ghost-linvel) measured-linvel 0.5)
            )
          (vector-reset! (-> rec ghost-linvel))
          )
      )
    )
  (none)
  )

(defun mp-enemy-note-remote-transform-sample! ((rec mp-enemy-auth-record)
                                                (slot mp-enemy-state))
  "Update the authoritative sample and derive velocity only once per network packet."
  (when (and rec
             (nonzero? rec)
             slot
             (nonzero? slot)
             (nonzero? (-> slot last-updated))
             (!= (-> slot last-updated) (-> rec ghost-sample-time)))
    (let ((sample-time (the-as uint (-> slot last-updated)))
          (previous-time (-> rec ghost-sample-time)))
      (mp-enemy-update-remote-linvel! rec slot sample-time previous-time)
      (set-vector! (-> rec ghost-trans) (-> slot x) (-> slot y) (-> slot z) 1.0)
      (set! (-> rec ghost-quat x) (-> slot quat-x))
      (set! (-> rec ghost-quat y) (-> slot quat-y))
      (set! (-> rec ghost-quat z) (-> slot quat-z))
      (set! (-> rec ghost-quat w) (-> slot quat-w))
      (set! (-> rec ghost-sample-time) sample-time)
      )
    )
  (none)
  )

(defun mp-enemy-apply-state ((e-proc enemy) (slot mp-enemy-state))
  "Apply remote sync data to local enemy proxy (Non-Owner Side)."
  (when (and e-proc (nonzero? e-proc) (not (logtest? (-> e-proc mask) (process-mask sleep))) (!= (-> e-proc status) 'dead))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (nonzero? enemy-aid)
        (let ((rec (mp-get-enemy-auth enemy-aid)))
          (when (and rec (nonzero? rec))
            (mp-enemy-note-remote-transform-sample! rec slot)
            (set! (-> rec ghost-state) (the-as mp-enemy-state-id (-> slot state)))
            (set! (-> rec ghost-focus-player-id) (-> slot focus-player-id))
            )
          )
        )
      )

    (when (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start)))
      (let ((old-hp (-> e-proc hit-points))
            (new-hp (-> slot hp)))
        (when (!= old-hp new-hp)
          (set! (-> e-proc hit-points) new-hp)
          )
        )

      (when (and (= (-> slot state) 9) (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start))))
        (set! (-> e-proc hit-points) 0)
        (send-event e-proc 'die)
        )
      )

    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (nonzero? enemy-aid)
        (let ((rec (mp-get-enemy-auth enemy-aid)))
          (when rec
            (mp-enemy-sync-remote-state! e-proc rec (-> slot state))
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-enemy-sync-post-behavior ()
  (with-pp
    (let ((self (the-as enemy pp)))
      (when (and self (type? self enemy))
        (common-post self)
        (if (and (nonzero? (-> self root)) (type? (-> self root) collide-shape))
            (update-transforms (-> self root))
            )
        )
      )
    )
  (none)
  )

(defun mp-get-enemy-auth ((enemy-aid uint))
  "Get the authority record for an enemy AID."
  (let ((u32-aid (the-as uint32 enemy-aid)))
    (dotimes (i 128)
      (let ((rec (-> *mp-enemy-auth* i)))
        (when (= (-> rec aid) u32-aid)
          (return rec)
          )
        )
      )
    )
  (the-as mp-enemy-auth-record #f)
  )

(defun mp-get-free-enemy-auth ()
  (dotimes (i 128)
    (let ((rec (-> *mp-enemy-auth* i)))
      (when (= (-> rec aid) 0)
          (set! (-> rec last-remote-seen) (current-time))
          (set! (-> rec just-taken-authority) #f)
          (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
          (set! (-> rec last-remote-state-bump-time) 0)
          (mp-enemy-reset-remote-motion-sample! rec)
          (return rec)
          )
      )
    )
  (the-as mp-enemy-auth-record #f)
  )

(defun mp-enemy-authoritative? ((e-proc enemy))
  (when (mp-enemy-host-only? e-proc)
    (return (mp-session-host?))
    )
  (when (and e-proc
             (nonzero? e-proc)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (let ((battle-owner (mp-battle-enemy-owner-player-id e-proc)))
      (when (>= battle-owner 0)
        (return (= battle-owner (-> (mp-local-player-record) identity player-id)))
        )
      )
    )
  (when (type? e-proc bot)
    (return (mp-session-host?))
  )
  (let ((enemy-aid (mp-get-enemy-aid e-proc)))
    (when (nonzero? enemy-aid)
      (let ((rec (mp-get-enemy-auth enemy-aid)))
        (if rec
            (return (= (-> rec owner-player-id) (-> (mp-local-player-record) identity player-id)))
            )
        )
      )
    )
  (mp-session-host?)
  )

(defun mp-enemy-broadcast-death ((e-proc enemy))
  "Queue one authoritative enemy death tombstone for the remote peer."
  (when (and e-proc
             (nonzero? e-proc)
             (mp-enemy-authoritative? e-proc))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and (nonzero? enemy-aid)
                 (not (mp-battle-enemy-id? enemy-aid)))
        (mp-event-enqueue-enemy-death! enemy-aid)
        )
      )
    )
  (none)
  )

(defun mp-enemy-awaiting-battle-network-id? ((e-proc enemy))
  "True while a recycled battle enemy has not received its new dynamic network ID."
  (and e-proc
       (nonzero? e-proc)
       (logtest? (-> e-proc enemy-flags) (enemy-flag mp-battle-enemy))
       (zero? (-> e-proc net-id)))
  )

(defun mp-enemy-battle-state-unmapped? ((e-proc enemy)
                                        (rec mp-enemy-auth-record))
  "Allow vanilla transitions for battle replicas while the owner state is unmapped."
  (if (and e-proc
           (nonzero? e-proc)
           rec
           (nonzero? rec)
           (logtest? (-> e-proc enemy-flags) (enemy-flag mp-battle-enemy))
           (zero? (-> rec ghost-state)))
      #t
      #f)
  )

(defun mp-enemy-allow-local-state-transition? ((e-proc enemy))
  "Allow startup transitions until ownership is known, then defer to the owner."
  (if (and e-proc
           (nonzero? e-proc))
      (if (mp-enemy-awaiting-battle-network-id? e-proc)
          #t
          (let ((enemy-aid (mp-get-enemy-aid e-proc)))
            (if (nonzero? enemy-aid)
                (let ((rec (mp-get-enemy-auth enemy-aid)))
                  (if (and rec (nonzero? rec))
                      (if (and (mp-local-player-record)
                               (nonzero? (mp-local-player-record)))
                          (or (= (-> rec owner-player-id) (-> (mp-local-player-record) identity player-id))
                              *mp-processing-remote-event*
                              (mp-enemy-battle-state-unmapped? e-proc rec))
                          #t)
                      #t))
                #t)))
      #f)
  )

(defun mp-process-allow-local-state-transition? ((proc process))
  "Allow normal state transitions except for non-authoritative enemy replicas."
  (if (and proc
           (nonzero? proc)
           (logtest? (-> proc mask) (process-mask enemy))
           (type? proc enemy))
      (mp-enemy-allow-local-state-transition? (the-as enemy proc))
      #t)
  )

(defun mp-enemy-restore-local-state-transition! ((e-proc enemy))
  "Restore an enemy's current state transition hook after authority arrives locally."
  (when (and e-proc
             (nonzero? e-proc))
    (process-mask-clear! (-> e-proc mask) sleep-code)
    (let ((current-state (-> e-proc state)))
      (when (and current-state
                 (nonzero? current-state))
        (set! (-> e-proc trans-hook) (-> current-state trans))
        (when (and (-> e-proc focus)
                   (nonzero? (-> e-proc focus))
                   (or (= (-> current-state name) 'chase)
                       (= (-> current-state name) 'hostile)
                       (= (-> current-state name) 'notice)))
          (set! (-> e-proc focus aware) (enemy-aware enemy-aware-3))
          (let ((enemy-aid (mp-get-enemy-aid e-proc)))
            (when (nonzero? enemy-aid)
              (let ((rec (mp-get-enemy-auth enemy-aid)))
                (when (and rec
                           (mp-player-id-valid? (the-as uint (-> rec ghost-focus-player-id))))
                  (let ((target-player-id (the-as uint (-> rec ghost-focus-player-id))))
                    (let ((focus-proc
                            (the-as process-focusable
                              (mp-player-target-by-id target-player-id))))
                      (when (and focus-proc (nonzero? focus-proc))
                        (set! (-> e-proc focus handle) (process->handle focus-proc))
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-enemy-allow-kill-prefer-falling? ((e-proc enemy))
  "Death can run for owners, remote replays, or enemies already confirmed dead."
  (if (and e-proc (nonzero? e-proc))
      (or (mp-enemy-authoritative? e-proc)
          *mp-processing-remote-event*
          (<= (-> e-proc hit-points) 0))
      #f)
  )

(defun mp-enemy-should-run-dying? ((e-proc enemy))
  "Vanilla dying cleanup should only run for authoritative or confirmed-dead enemies."
  (mp-enemy-allow-kill-prefer-falling? e-proc)
  )

(defun mp-enemy-retired-host-bot-proxy? ((e-proc enemy))
  "True when a client-side host-owned bot proxy has been locally suspended/retired."
  (and e-proc
       (nonzero? e-proc)
       (not (mp-session-host?))
       (type? e-proc bot)
       (= (-> e-proc status) 'suspended)
       )
  )

(defun mp-enemy-remote-slot-fresh? ((slot mp-enemy-state))
  "Does this slot contain a recent authoritative enemy sample?"
  (when (and slot
             (nonzero? slot)
             (nonzero? (-> slot actor-id))
             (nonzero? (-> slot last-updated)))
    (let ((now (pc-multi-get-ticks))
          (last-updated (-> slot last-updated)))
      (return (and (>= now last-updated)
                   (< (- now last-updated) (the uint64 2000))))
      )
    )
  #f
  )

(defun mp-enemy-remote-transform-ready? ((e-proc enemy) (slot mp-enemy-state))
  "Can this non-owner safely follow the supplied authoritative sample?"
  (when (and e-proc
             (nonzero? e-proc)
             slot
             (nonzero? slot)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             (-> e-proc root)
             (nonzero? (-> e-proc root)))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (return (and (nonzero? enemy-aid)
                   (= enemy-aid (-> slot actor-id))
                   (mp-enemy-remote-slot-fresh? slot)
                   (not (mp-enemy-authoritative? e-proc))
                   (not (mp-enemy-terminal-sync? e-proc enemy-aid))))
      )
    )
  #f
  )

(defun mp-enemy-predicted-remote-trans! ((rec mp-enemy-auth-record) (out vector))
  "Predict a short distance beyond the latest sample to hide packet cadence and latency."
  (when (and rec (nonzero? rec) out (nonzero? out))
    (vector-copy! out (-> rec ghost-trans))
    (let ((sample-time (-> rec ghost-sample-time))
          (now (the-as uint (pc-multi-get-ticks))))
      (when (and (nonzero? sample-time) (>= now sample-time))
        (let ((ahead-ms (fmin 100.0
                              (fmax 0.0
                                    (+ (the float (- now sample-time))
                                       (* 0.5 (the float (pc-multi-get-ping))))))))
          (vector+float*! out (-> rec ghost-trans) (-> rec ghost-linvel) (* 0.001 ahead-ms))
          )
        )
      )
    )
  (none)
  )

(defun mp-enemy-smooth-remote-transform! ((e-proc enemy)
                                          (rec mp-enemy-auth-record)
                                          (slot mp-enemy-state))
  "Render a non-owner from an independent host-derived presentation transform."
  (when (and e-proc
             (nonzero? e-proc)
             rec
             (nonzero? rec)
             slot
             (nonzero? slot)
             (-> e-proc root)
             (nonzero? (-> e-proc root)))
    (let ((root (-> e-proc root))
          (predicted-pos (new 'stack-no-clear 'vector)))
      (mp-enemy-predicted-remote-trans! rec predicted-pos)
      (let ((replica-dist (if (nonzero? (-> rec presentation-valid))
                              (vector-vector-distance (-> rec presentation-trans) predicted-pos)
                              0.0)))
        (mp-actor-update-presentation! (-> rec presentation-trans)
                                       (-> rec presentation-quat)
                                       predicted-pos
                                       (-> rec ghost-quat)
                                       (nonzero? (-> rec presentation-valid))
                                       #f)
        (set! (-> rec presentation-valid) (the uint8 1))
        (mp-actor-apply-presentation! root
                                      (-> rec presentation-trans)
                                      (-> rec presentation-quat)
                                      (-> rec ghost-linvel))
        )
      )
    )
  (none)
  )

(defun mp-enemy-apply-remote-focus! ((e-proc enemy) (rec mp-enemy-auth-record))
  (when (and e-proc
             (nonzero? e-proc)
             rec
             (nonzero? rec)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             (mp-player-id-valid? (the-as uint (-> rec ghost-focus-player-id)))
             (-> e-proc focus)
             (nonzero? (-> e-proc focus)))
    (let ((target-player-id (the-as uint (-> rec ghost-focus-player-id))))
      (let ((focus-proc
              (the-as process-focusable (mp-player-target-by-id target-player-id))))
        (when (and focus-proc (nonzero? focus-proc))
          (set! (-> e-proc focus handle) (process->handle focus-proc))
          )
        )
      )
    )
  (none)
  )

(defun mp-enemy-apply-remote-transform-from-slot! ((e-proc enemy) (slot mp-enemy-state))
  (when (mp-enemy-remote-transform-ready? e-proc slot)
    (let ((rec (mp-get-enemy-auth (mp-get-enemy-aid e-proc))))
      (when (and rec (nonzero? rec))
        (mp-enemy-note-remote-transform-sample! rec slot)
        (mp-enemy-smooth-remote-transform! e-proc rec slot)
        (mp-enemy-apply-remote-focus! e-proc rec)
        )
      )
    )
  (none)
  )

(defun mp-enemy-apply-remote-transform! ((e-proc enemy))
  "Apply the latest fresh remote slot after local enemy post logic."
  (when (and e-proc
             (nonzero? e-proc)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and (nonzero? enemy-aid)
                 (not (mp-enemy-authoritative? e-proc))
                 (not (mp-enemy-terminal-sync? e-proc enemy-aid)))
        (let ((slot (mp-enemy-find-remote-slot enemy-aid)))
          (when (and slot (nonzero? slot))
            (mp-enemy-apply-remote-transform-from-slot! e-proc slot)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-enemy-note-remote-battle-spawn! ((e-proc enemy))
  "Seed authority for an enemy spawned by an inbound battle-spawn event."
  (when (and e-proc (nonzero? e-proc))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (if (nonzero? enemy-aid)
          (let ((rec (mp-get-enemy-auth enemy-aid))
                (battle-owner (mp-battle-enemy-owner-player-id e-proc)))
            (when (not rec)
              (set! rec (mp-get-free-enemy-auth))
              )
            (if rec
                (begin
                  (set! (-> rec aid) (the-as uint32 enemy-aid))
                  (set! (-> rec owner-player-id)
                        (the-as uint8
                          (if (mp-enemy-host-only? e-proc)
                              (mp-host-player-id)
                              (if (>= battle-owner 0)
                                  (the-as uint battle-owner)
                                  MP_INVALID_COMPACT_PLAYER_ID))))
                  (set! (-> rec is-aggro) #f)
                  (set! (-> rec last-transfer-time) (current-time))
                  (set! (-> rec last-remote-seen) (current-time))
                  (set! (-> rec last-attack-id) 0)
                  (set! (-> rec last-local-attack-id) 0)
                  (set! (-> rec last-local-attack-time) 0)
                  (set! (-> rec just-taken-authority) #f)
                  (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
                  (set! (-> rec last-remote-state-bump-time) 0)
                  (mp-enemy-reset-remote-motion-sample! rec)
                  (when (and (-> e-proc root) (nonzero? (-> e-proc root)))
                    (vector-copy! (-> rec ghost-trans) (-> e-proc root trans))
                    (quaternion-copy! (-> rec ghost-quat) (-> e-proc root quat))
                    )
                  (set! (-> rec ghost-state) (the-as mp-enemy-state-id (mp-enemy-get-state-id e-proc)))
                  (debug-log *mp-debug-log?*
                    "[MP-BattleSpawn][~A][AUTH-SEED] proc=~A aid=~D owner=~D state=~D root=~A~%"
                    (if (mp-session-host?) "HOST" "CLIENT")
                    e-proc
                    enemy-aid
                    (-> rec owner-player-id)
                    (mp-enemy-get-state-id e-proc)
                    (-> e-proc root)
                    )
                  )
                (debug-log *mp-debug-log?*
                  "[MP-BattleSpawn][~A][AUTH-SEED-FAIL] no free auth record proc=~A aid=~D~%"
                  (if (mp-session-host?) "HOST" "CLIENT")
                  e-proc
                  enemy-aid
                  )
                )
              )
          (debug-log *mp-debug-log?*
            "[MP-BattleSpawn][~A][AUTH-SEED-WAIT] spawned proc has no AID yet proc=~A~%"
            (if (mp-session-host?) "HOST" "CLIENT")
            e-proc
            )
          )
      )
    )
  (none)
  )

(defun mp-enemy-focused-on-local? ((e-proc enemy))
  "Check if the enemy is currently focused on the local player."
  (if (and (-> e-proc focus) (nonzero? (-> e-proc focus)))
      (let ((focus-proc (handle->process-safe (-> e-proc focus handle))))
        (and focus-proc (nonzero? focus-proc) *target* (nonzero? *target*) (= focus-proc *target*))
        )
      #f
      )
  )

(defun mp-enemy-find-remote-slot ((enemy-aid uint))
  "Find the latest remote sync slot for an enemy AID."
  (dotimes (i MP_MAX_SYNC_ENEMIES)
    (let ((slot (-> *mp-enemy-buffer* remote-enemies i)))
      (when (and (nonzero? (-> slot actor-id))
                 (= (-> slot actor-id) (the-as uint32 enemy-aid)))
        (return slot)
        )
      )
    )
  (the-as mp-enemy-state #f)
  )

(defun mp-enemy-copy-player-pos!
       ((out vector) (record mp-player-record))
  (when (and out (nonzero? out) record (nonzero? record))
    (let ((position (mp-player-record-position record)))
      (when (and position (nonzero? position))
        (set! (-> out x) (-> position x))
        (set! (-> out y) (-> position y))
        (set! (-> out z) (-> position z)))))
  (none)
  )

(defun mp-enemy-init-auth-record! ((rec mp-enemy-auth-record)
                                   (e-proc enemy)
                                   (enemy-aid uint)
                                   (local-player-id uint))
  "Initialize a new enemy authority record from the current local process."
  (when (and rec
             e-proc
             (nonzero? e-proc))
    (set! (-> rec aid) (the-as uint32 enemy-aid))
    (set! (-> rec is-aggro) #f)
    (set! (-> rec last-transfer-time) 0)
    (set! (-> rec last-remote-seen) (current-time))
    (set! (-> rec last-attack-id) 0)
    (set! (-> rec last-local-attack-id) 0)
    (set! (-> rec last-local-attack-time) 0)
    (set! (-> rec just-taken-authority) #f)
    (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
    (set! (-> rec last-remote-state-bump-time) 0)
    (mp-enemy-reset-remote-motion-sample! rec)
    (set! (-> rec owner-player-id) (the-as uint8 local-player-id))
    (when (and (-> e-proc root)
               (nonzero? (-> e-proc root)))
      (vector-copy! (-> rec ghost-trans) (-> e-proc root trans))
      (quaternion-copy! (-> rec ghost-quat) (-> e-proc root quat))
      )
    (set! (-> rec ghost-state) (the-as mp-enemy-state-id (mp-enemy-get-state-id e-proc)))
    )
  (none)
  )

(defun mp-enemy-snap-to-ghost-on-takeover! ((e-proc enemy) (rec mp-enemy-auth-record) (enemy-aid uint))
  (when (and e-proc
             (nonzero? e-proc)
             rec
             (nonzero? rec)
             (-> rec just-taken-authority)
             (-> e-proc root)
             (nonzero? (-> e-proc root)))
    (set! (-> rec just-taken-authority) #f)
    (if (mp-enemy-terminal-sync? e-proc enemy-aid)
        (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Skipping takeover snap for terminal enemy aid=~D nid=~D~%" enemy-aid (-> e-proc net-id))
        (begin
          (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Snapping ~A aid=~D nid=~D to ghost position on authority takeover.~%" e-proc enemy-aid (-> e-proc net-id))
          (vector-copy! (-> e-proc root trans) (-> rec ghost-trans))
          (quaternion-copy! (-> e-proc root quat) (-> rec ghost-quat))
          (vector-reset! (-> e-proc root transv))
          )
        )
    )
  (none)
  )

(defun mp-enemy-local-player-pos ()
  "Return local target position only while the local target is stable."
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *level*
             (nonzero? *level*)
             (= (-> *level* loading-level) (-> *level* default-level))
             (not (load-in-progress? *level*))
             (not (focus-test? *target* teleporting))
             (not (logtest? (-> *target* focus-status) (focus-status dead))))
    (return (-> *target* control trans))
    )
  (the-as vector #f)
  )

(defun mp-sync-enemies-update-callback ((p process-tree))
  (let ((proc (the-as process p)))
    (when (and proc (logtest? (-> proc mask) (process-mask enemy collectable bot)) (type? proc enemy) (not (logtest? (-> proc mask) (process-mask civilian guard))))
      (let ((e-proc (the-as enemy proc))
            (enemy-nid (-> (the-as enemy p) net-id))
            (enemy-aid (mp-get-enemy-aid (the-as enemy proc))))
        (when (!= enemy-aid 0)
          (when (mp-aid-dead-perm? enemy-aid)
            (let ((rec (mp-get-enemy-auth enemy-aid)))
              (when (and rec (nonzero? rec))
                (mp-enemy-release-auth-record! rec)
                )
              )
            (if (mp-enemy-death-presentation-active? e-proc)
               (logior! (-> e-proc enemy-flags) (enemy-flag stop-syncing))
               (when (not (mp-deactivate-dead-aid-if-loaded! enemy-aid))
                  (deactivate e-proc)
               )
              )
            (return #t)
            )

          (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f)))
            (let ((is-culled (or (= cur-state 'inactive)
                                 (= cur-state 'process-drawable-art-error))))
              (when is-culled
                (let ((rec (mp-get-enemy-auth enemy-aid)))
                  (when (and rec (nonzero? rec))
                    (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Cleaning up culled/errored enemy ~A aid=~D nid=~D in state ~A.~%" e-proc enemy-aid enemy-nid cur-state)
                    (mp-enemy-release-auth-record! rec)
                    )
                  )
                (return #t)
                )
              )
            )

          (let ((rec (mp-get-enemy-auth enemy-aid))
                (local-player-id (the-as uint8 (-> (mp-local-player-record) identity player-id)))
                (nearest-record
                  (if (and (-> e-proc root) (nonzero? (-> e-proc root)))
                      (mp-nearest-remote-player-record-to-position
                        (-> e-proc root trans) #f)
                      (the-as mp-player-record #f)))
                (nearest-remote-player-id MP_INVALID_COMPACT_PLAYER_ID)
                (host-player-id (the-as uint8 (mp-host-player-id)))
                )
            (when (and nearest-record (nonzero? nearest-record))
              (set! nearest-remote-player-id
                    (the-as uint8 (-> nearest-record identity player-id))))

            (when (not rec)
              (set! rec (mp-get-free-enemy-auth))
              (when rec
                (mp-enemy-init-auth-record! rec e-proc enemy-aid local-player-id)

                (let* ((slot (mp-enemy-find-remote-slot enemy-aid))
                       (slot-owner-player-id
                         (if (and slot
                                  (nonzero? slot)
                                  (mp-player-id-valid?
                                    (the-as uint (-> slot owner-player-id))))
                             (-> slot owner-player-id)
                             nearest-remote-player-id)))
                  (when (and slot
                             (nonzero? slot)
                             (mp-enemy-remote-slot-fresh? slot))
                      (if (= (-> slot is-aggro) 1)
                          (begin
                            (set! (-> rec owner-player-id) slot-owner-player-id)
                            (set! (-> rec is-aggro) #t)
                            )
                          (begin
                            (let ((is-bot (type? e-proc bot)))
                              (if is-bot
                                  (set! (-> rec owner-player-id) host-player-id)
                                  (let ((local-pos (mp-enemy-local-player-pos)))
                                    (if (and local-pos
                                             (nonzero? local-pos)
                                             (-> e-proc root)
                                             (nonzero? (-> e-proc root))
                                             nearest-record
                                             (nonzero? nearest-record))
                                        (let ((local-dist (vector-vector-distance (-> e-proc root trans) local-pos))
                                              (rem-pos (new 'stack 'vector)))
                                          (mp-enemy-copy-player-pos! rem-pos nearest-record)
                                          (let ((remote-dist (vector-vector-distance (-> e-proc root trans) rem-pos)))
                                            (if (or (and (mp-session-client?) (> local-dist remote-dist))
                                                    (and (mp-session-host?) (> local-dist (+ remote-dist (meters 10)))))
                                                (set! (-> rec owner-player-id) nearest-remote-player-id)
                                                )
                                            )
                                          )
                                        (set! (-> rec owner-player-id) nearest-remote-player-id)
                                        )
                                     )
                                  )
                              )
                            )
                          )
                      )
                  )
                )
              )

            (when rec
              (when (mp-enemy-host-only? e-proc)
                (set! (-> rec owner-player-id) host-player-id)
                )
              (let* ((is-bot (type? e-proc bot))
                     (battle-owner (mp-battle-enemy-owner-player-id e-proc))
                     (is-daxter-and-riding-along (mp-target-ride-along? *target*))
                     (remote-slot (mp-enemy-find-remote-slot enemy-aid))
                     (remote-owner-player-id
                       (if (and remote-slot
                                (nonzero? remote-slot)
                                (mp-player-id-valid?
                                  (the-as uint (-> remote-slot owner-player-id))))
                           (-> remote-slot owner-player-id)
                           nearest-remote-player-id)))

                (when (and remote-slot
                           (nonzero? remote-slot)
                           (mp-enemy-remote-slot-fresh? remote-slot))
                  (set! (-> rec last-remote-seen) (current-time))

                  (if (>= battle-owner 0)
                      (set! (-> rec owner-player-id) (the-as uint8 battle-owner))
                      (if (or is-bot is-daxter-and-riding-along)
                      (set! (-> rec owner-player-id) host-player-id)
                      (when (and (mp-session-client?)
                                 (= (-> remote-slot owner-player-id) host-player-id)
                                 (= (-> rec owner-player-id) local-player-id))
                        (if (or (and (-> rec is-aggro) (not (= (-> remote-slot is-aggro) 1)))
                                (< (- (current-time) (-> rec last-transfer-time)) (seconds 2)))
                            (none)
                            (begin
                              (set! (-> rec owner-player-id) host-player-id)
                              (set! (-> rec is-aggro) (= (-> remote-slot is-aggro) 1))
                              )
                            )
                        )
                      )
                      )

                  (when (and (< battle-owner 0) (not is-bot) (not is-daxter-and-riding-along))
                    (cond
                      ((and (= (-> remote-slot is-aggro) 1) (not (-> rec is-aggro)) (>= (- (current-time) (-> rec last-transfer-time)) (seconds 2)))
                       (set! (-> rec owner-player-id) remote-owner-player-id)
                       (set! (-> rec is-aggro) #t)
                       )
                      ((and (mp-player-id-valid? (the-as uint remote-owner-player-id))
                            (!= remote-owner-player-id local-player-id)
                            (not (-> rec is-aggro))
                            (>= (- (current-time) (-> rec last-transfer-time)) (seconds 2)))
                       (let ((local-pos (mp-enemy-local-player-pos)))
                         (if (and local-pos
                                  (nonzero? local-pos)
                                  (-> e-proc root)
                                  (nonzero? (-> e-proc root))
                                  nearest-record
                                  (nonzero? nearest-record))
                             (let ((local-dist (vector-vector-distance (-> e-proc root trans) local-pos))
                                   (rem-pos (new 'stack 'vector)))
                               (mp-enemy-copy-player-pos! rem-pos nearest-record)
                               (let ((remote-dist (vector-vector-distance (-> e-proc root trans) rem-pos)))
                                 (if (or (mp-session-client?)
                                         (and (mp-session-host?)
                                              (> local-dist (+ remote-dist (meters 15)))))
                                     (set! (-> rec owner-player-id) remote-owner-player-id)
                                     )
                                 )
                               )
                             (set! (-> rec owner-player-id) remote-owner-player-id)
                             )
                         )
                       )
                      )
                    )
                  )

                (when (and (not (mp-enemy-host-only? e-proc))
                           (< battle-owner 0)
                           (not is-bot)
                           (not is-daxter-and-riding-along)
                           (not (mp-enemy-terminal-sync? e-proc enemy-aid)))
                  (when (and (not (-> rec is-aggro))
                             (or (and (-> e-proc focus) (nonzero? (-> e-proc focus)) (>= (the-as int (-> e-proc focus aware)) (the-as int (enemy-aware enemy-aware-3))))
                                 (nonzero? (-> e-proc incoming attack-id)))
                             (mp-enemy-focused-on-local? e-proc))
                    (if (!= (-> rec owner-player-id) local-player-id)
                        (begin
                          (when (>= (- (current-time) (-> rec last-transfer-time)) (seconds 2))
                            (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Requesting authority over ~A aid=~D nid=~D - Local Aggro Detected!~%" e-proc enemy-aid enemy-nid)
                            (mp-event-enqueue-aid! MP_EVENT_ENEMY_AUTHORITY_REQUEST enemy-aid)
                            (set! (-> rec last-transfer-time) (current-time))
                            (set! (-> rec is-aggro) #t)
                            )
                          )
                        (begin
                          (set! (-> rec is-aggro) #t)
                          )
                        )
                    )

                  (when (and (not (mp-enemy-host-only? e-proc))
                             (not is-bot)
                             (not is-daxter-and-riding-along)
                             (not (-> rec is-aggro))
                             (>= (- (current-time) (-> rec last-transfer-time)) (seconds 5)))
                    (let ((local-pos (mp-enemy-local-player-pos)))
                      (when (and local-pos
                                 (nonzero? local-pos)
                                 (-> e-proc root)
                                 (nonzero? (-> e-proc root))
                                 (-> e-proc enemy-info)
                                 (nonzero? (-> e-proc enemy-info))
                                 nearest-record
                                 (nonzero? nearest-record))
                        (let ((local-dist (vector-vector-distance (-> e-proc root trans) local-pos))
                              (rem-pos (new 'stack 'vector)))
                          (mp-enemy-copy-player-pos! rem-pos nearest-record)
                          (let ((remote-dist (vector-vector-distance (-> e-proc root trans) rem-pos)))
                            (when (and (< local-dist (-> e-proc enemy-info notice-distance))
                                       (< local-dist (- remote-dist (meters 10))))
                              (when (!= (-> rec owner-player-id) local-player-id)
                                (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Requesting authority over ~A aid=~D nid=~D via proximity.~%" e-proc enemy-aid enemy-nid)
                                (mp-event-enqueue-aid! MP_EVENT_ENEMY_AUTHORITY_REQUEST enemy-aid)
                                (set! (-> rec last-transfer-time) (current-time))
                                )
                              )
                            )
                          )
                        )
                      )
                    )
                  )

                (if (mp-enemy-host-only? e-proc)
                    (begin
                      (set! (-> rec owner-player-id) host-player-id)
                      (set! (-> rec just-taken-authority) #f)
                      )
                    (when (>= battle-owner 0)
                      (set! (-> rec owner-player-id) (the-as uint8 battle-owner))
                      (set! (-> rec just-taken-authority) #f)
                      )
                    )

                (when (and (< battle-owner 0)
                           is-bot
                           (!= (-> rec owner-player-id) host-player-id))
                  (set! (-> rec owner-player-id) host-player-id)
                  )

                (if (mp-enemy-terminal-sync? e-proc enemy-aid)
                    (begin
                      (set! (-> rec just-taken-authority) #f)
                      (logior! (-> e-proc enemy-flags) (enemy-flag stop-syncing))
                      )
                    (if (= (-> rec owner-player-id) local-player-id)
                    (begin
                      (when (-> rec just-taken-authority)
                        (mp-enemy-restore-local-state-transition! e-proc)
                        )
                      (mp-enemy-snap-to-ghost-on-takeover! e-proc rec enemy-aid)
                      (when (and (!= (-> e-proc status) 'dead)
                                 (not (logtest? (-> e-proc enemy-flags) (enemy-flag stop-syncing)))
                                 (nonzero? (-> e-proc root))
                                 (< (-> *mp-enemy-buffer* local-count) (the-as uint MP_MAX_SYNC_ENEMIES)))
                        (let ((slot (-> *mp-enemy-buffer* local-enemies (-> *mp-enemy-buffer* local-count))))
                          (mp-enemy-pack-state e-proc slot enemy-aid)
                          (set! (-> slot owner-player-id) local-player-id)
                          (set! (-> slot is-aggro) (the-as uint (if (-> rec is-aggro) 1 0)))
                        )
                        (+! (-> *mp-enemy-buffer* local-count) 1)
                        (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
                        (set! (-> rec last-remote-state-bump-time) 0)
                        (mp-enemy-reset-remote-motion-sample! rec)
                        (vector-copy! (-> rec ghost-trans) (-> e-proc root trans))
                        (quaternion-copy! (-> rec ghost-quat) (-> e-proc root quat))
                        (set! (-> rec ghost-state) (the-as mp-enemy-state-id (mp-enemy-get-state-id e-proc)))
                        )
                      )
                    (begin
                      (if (or (and remote-slot (< (- (current-time) (-> rec last-remote-seen)) (seconds 2)))
                              (< (- (current-time) (-> rec last-transfer-time)) (seconds 2)))
                          (begin
                            (when (and remote-slot
                                       (nonzero? remote-slot)
                                       (mp-enemy-remote-slot-fresh? remote-slot)
                                       (-> e-proc root)
                                       (nonzero? (-> e-proc root)))
                              (mp-enemy-apply-state e-proc remote-slot)
                              )
                            )
                          (begin
                            (cond
                              ((or (logtest? (-> e-proc enemy-flags) (enemy-flag death-start))
                                   (and remote-slot (= (-> remote-slot state) 2)))
                               (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Remote sync stale for ~A aid=~D nid=~D during DEATH. Severing sync and killing locally.~%" e-proc enemy-aid enemy-nid)
                               (set! (-> rec owner-player-id) local-player-id)
                               (logior! (-> e-proc enemy-flags) (enemy-flag mp-synced-death))
                               (set! (-> e-proc hit-points) 0)
                               (send-event e-proc 'die)
                               )
                              ((>= battle-owner 0)
                               (set! (-> rec owner-player-id) (the-as uint8 battle-owner))
                               (set! (-> rec just-taken-authority) #f)
                               )
                              ((and is-bot (not (mp-session-host?)))
                               (set! (-> rec owner-player-id) host-player-id)
                               (set! (-> rec just-taken-authority) #f)
                               )
                              ((logtest? (-> e-proc enemy-flags) (enemy-flag boss-spawned))
                               (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Remote sync stale for ~A aid=~D nid=~D. Severing sync and killing locally since it's a boss spawned enemy.~%" e-proc enemy-aid enemy-nid)
                               (set! (-> rec owner-player-id) host-player-id)
                               (logior! (-> e-proc enemy-flags) (enemy-flag mp-synced-death))
                               (set! (-> e-proc hit-points) 0)
                               (send-event e-proc 'die)
                               )
                              (else
                               (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Remote sync stale for ~A aid=~D nid=~D. Reclaiming authority.~%" e-proc enemy-aid enemy-nid)
                               (set! (-> rec owner-player-id) local-player-id)
                               (set! (-> rec just-taken-authority) #t)
                               )
                              )
                            )
                          )
                      )
                    )
                  )
                )
              )
            )

          (when (mp-session-client?)
            (dotimes (i (the-as int (-> *mp-bootstrap-state* synchronized-aid-count)))
              (when (= (-> *mp-bootstrap-state* synchronized-aids i) (the-as uint32 enemy-aid))
                (let ((ent (-> e-proc entity)))
                  (if (and ent (nonzero? ent)) (logior! (-> ent extra perm status) (entity-perm-status dead)))
                  )
                (debug-log *mp-debug-log?* "[MP-Enemy-Sync] Deactivating enemy ~A aid=~D nid=~D via Remote sync-aids.~%" e-proc enemy-aid enemy-nid)
                (deactivate e-proc)
                (return (the-as symbol 'dead))
                )
              )
            )
          )
        )
      )
    )
  #t
  )

(defun mp-sync-enemies-update ()
  (dotimes (i 128)
    (let ((rec (-> *mp-enemy-auth* i)))
      (when (nonzero? (-> rec aid))
        (if (>= (- (current-time) (-> rec last-remote-seen)) (seconds 10))
            (begin
              (mp-enemy-release-auth-record! rec)
              )
            )
        )
      )
    )

  (set! (-> *mp-enemy-buffer* local-count) (the-as uint 0))
  (iterate-process-tree *active-pool* mp-sync-enemies-update-callback *kernel-context*)
  (mp-enemy-debug-draw)
  (none)
  )

(defun mp-reset-enemy-state! ()
  (set! *mp-battle-spawn-counter* (the uint 0))
  (when (and *mp-enemy-buffer*
             (nonzero? (the-as uint *mp-enemy-buffer*)))
    (mem-set32! (the-as pointer *mp-enemy-buffer*) (/ (size-of mp-enemy-sync-buffer) 4) 0)
    )
  (when (and *mp-enemy-auth*
             (nonzero? (the-as uint *mp-enemy-auth*)))
    (mem-set32! (the-as pointer *mp-enemy-auth*) (/ (* 128 (size-of mp-enemy-auth-record)) 4) 0)
    )
  (none))
