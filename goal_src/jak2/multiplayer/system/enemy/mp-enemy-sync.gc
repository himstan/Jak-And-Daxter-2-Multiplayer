;;-*-Lisp-*-
(in-package goal)

(define-extern mp-enemy-find-remote-slot (function uint mp-enemy-state))

(defun is-in-pausable-state? ((state-name symbol))
  (case state-name
    (('knocked 'knocked-vicinity 'hit 'get-up-front 'get-up-back 'die 'die-falling 'die-fast) #t)
    (else #f)))

(defun is-enemy-in-pausable-state? ((e enemy))
  (let ((state-name (if (-> e state) (-> e state name) #f))) (is-in-pausable-state? state-name)))

(defun mp-enemy-death-presentation-active? ((e enemy))
  (and e
       (nonzero? e)
       (or (<= (-> e hit-points) 0) (= (-> e status) 'dead) (logtest? (-> e enemy-flags) (enemy-flag death-start)))))

(defun mp-enemy-terminal-sync? ((e-proc enemy) (enemy-aid uint))
  (and e-proc
       (nonzero? e-proc)
       (or (<= (-> e-proc hit-points) 0)
           (= (-> e-proc status) 'dead)
           (logtest? (-> e-proc enemy-flags) (enemy-flag death-start))
           (and (nonzero? enemy-aid) (mp-aid-dead-perm? enemy-aid)))))

(defun mp-enemy-state-current-or-pending? ((e-proc enemy) (target-state symbol))
  (or (and (-> e-proc state) (= (-> e-proc state name) target-state))
      (and (-> e-proc next-state) (= (-> e-proc next-state name) target-state))))

(defun mp-enemy-state-retry-ready? ((rec mp-enemy-auth-record))
  (mp-actor-state-retry-ready? (-> rec last-remote-state-bump-time)))

(defun mp-enemy-sync-remote-state! ((e-proc enemy) (rec mp-enemy-auth-record) (remote-state-id uint))
  (when (and (nonnull? e-proc rec)
             (nonzero? remote-state-id)
             (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start)))
             (not (is-enemy-in-pausable-state? e-proc)))
    (let ((target-state (mp-enemy-get-state-from-id remote-state-id)))
      (when (and target-state (not (is-in-pausable-state? target-state)))
        (if (mp-enemy-state-current-or-pending? e-proc target-state)
          (begin
            (when (and (zero? (-> rec last-applied-remote-state))
                       (nonnull? (-> e-proc state))
                       (= (-> e-proc state name) target-state))
              (process-mask-clear! (-> e-proc mask) sleep-code))
            (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id remote-state-id)))
          (when (or (!= (the-as mp-enemy-state-id remote-state-id) (-> rec last-applied-remote-state))
                    (mp-enemy-state-retry-ready? rec))
            (let ((st (method-state (-> e-proc type) (the-as basic target-state))))
              (when (and st (nonzero? st))
                (let ((saved-context *mp-processing-remote-event*))
                  (set! *mp-processing-remote-event* #t)
                  (send-event e-proc 'go-state target-state)
                  (set! *mp-processing-remote-event* saved-context))
                (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id remote-state-id))
                (set! (-> rec last-remote-state-bump-time) (current-time)))))))))
  (none))

(defun mp-enemy-restore-interrupted-root-collision! ((e-proc enemy) (target-state symbol))
  (when (or (not (and e-proc (nonzero? e-proc))) (not target-state) (mp-enemy-authoritative? e-proc))
    (return #f))
  (let ((current-state (-> e-proc state)))
    (when (or (not (and current-state (nonzero? current-state))) (-> current-state exit))
      (return #f))
    (let ((e-root (-> e-proc root)))
      (when (not (and e-root (nonzero? e-root)))
        (return #f))
      (let ((root-prim (-> e-root root-prim)))
        (when (not (and root-prim (nonzero? root-prim)))
          (return #f))
        (let ((backup-as (-> e-root backup-collide-as))
              (backup-with (-> e-root backup-collide-with))
              (restored? #f))
          (when (and (zero? (-> root-prim prim-core collide-as)) (nonzero? backup-as))
            (set! (-> root-prim prim-core collide-as) backup-as)
            (set! restored? #t))
          (when (and (zero? (-> root-prim prim-core collide-with)) (nonzero? backup-with))
            (set! (-> root-prim prim-core collide-with) backup-with)
            (set! restored? #t))
          restored?)))))

(defun mp-enemy-force-remote-state! ((e-proc enemy) (target-state symbol))
  (when (and e-proc (nonzero? e-proc) target-state)
    (let ((e-root (-> e-proc root))
          (enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and e-root (nonzero? e-root) (not (mp-enemy-terminal-sync? e-proc enemy-aid)))
        (let ((current-state (-> e-proc state)))
          (let ((cur-state (if (and current-state (nonzero? current-state)) (-> current-state name) #f)))
            (when (!= cur-state target-state)
              (let ((st (method-state (-> e-proc type) (the-as basic target-state))))
                (when (and st (nonzero? st))
                  (mp-enemy-restore-interrupted-root-collision! e-proc target-state)
                  (process-mask-clear! (-> e-proc mask) sleep sleep-code)
                  (set! (-> e-proc next-state) (the-as state st))
                  (enter-state (the-as object (-> e-root trans))
                               (the-as object #f)
                               (the-as object #f)
                               (the-as object #f)
                               (the-as object #f)
                               (the-as object #f))
                  (with-pp
                    (when (and (= (-> *kernel-context* current-process) pp)
                               (= (-> pp main-thread) (-> pp top-thread))
                               (= (-> pp state) (-> pp next-state)))
                      (throw 'go #t)))))))))))
  #t)

(defun mp-enemy-handle-go-state-event! ((e-proc enemy) (event-block event-message-block))
  (if (and event-block (nonzero? event-block))
    (mp-enemy-force-remote-state! e-proc (the-as symbol (-> event-block param 0)))
    #t))

(defun mp-enemy-pack-state ((e-proc enemy) (slot mp-enemy-state) (aid uint))
  (set! (-> slot actor-id) (the-as uint32 aid))
  (set! (-> slot x) (-> e-proc root trans x))
  (set! (-> slot y) (-> e-proc root trans y))
  (set! (-> slot z) (-> e-proc root trans z))
  (set! (-> slot quat-x) (-> e-proc root quat x))
  (set! (-> slot quat-y) (-> e-proc root quat y))
  (set! (-> slot quat-z) (-> e-proc root quat z))
  (set! (-> slot quat-w) (-> e-proc root quat w))
  (set! (-> slot hp) (-> e-proc hit-points))
  (set! (-> slot state) (mp-enemy-get-state-id e-proc))
  (set! (-> slot focus-player-id) MP_INVALID_PLAYER_ID)
  (let ((focus (the-as process #f)))
    (if (and (-> e-proc focus) (nonzero? (-> e-proc focus))) (set! focus (handle->process-safe (-> e-proc focus handle))))
    (when (and focus (nonzero? focus))
      (let ((focus-player-id (mp-player-id-from-process focus)))
        (when (mp-player-id-valid? focus-player-id)
          (set! (-> slot focus-player-id) (the-as uint32 focus-player-id))))))
  (none))

(defun mp-enemy-reset-remote-motion-sample! ((rec mp-enemy-auth-record))
  (when (nonnull? rec)
    (vector-reset! (-> rec linvel))
    (set! (-> rec generation) (the uint 0)))
  (none))

(defun mp-enemy-reset-presentation! ((rec mp-enemy-auth-record) (proc enemy))
  (when (nonnull? rec proc)
    (set! (-> rec last-attack-id) 0)
    (set! (-> rec last-local-attack-id) 0)
    (set! (-> rec last-local-attack-time) 0)
    (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
    (set! (-> rec last-remote-state-bump-time) 0)
    (set! (-> rec focus-player-id) MP_INVALID_PLAYER_ID)
    (set! (-> rec locomotion-animation) -1)
    (set! (-> rec locomotion-frame) 0.0)
    (mp-enemy-reset-remote-motion-sample! rec)
    (when (nonnull? (-> proc root))
      (vector-copy! (-> rec trans) (-> proc root trans))
      (quaternion-copy! (-> rec quat) (-> proc root quat)))
    (set! (-> rec state) (the-as mp-enemy-state-id (mp-enemy-get-state-id proc))))
  (none))

(defun mp-enemy-copy-remote-presentation! ((rec mp-enemy-auth-record) (slot mp-enemy-state))
  (when (nonnull? rec slot *mp-replication-state*)
    (set-vector! (-> rec trans) (-> slot x) (-> slot y) (-> slot z) 1.0)
    (set! (-> rec quat x) (-> slot quat-x))
    (set! (-> rec quat y) (-> slot quat-y))
    (set! (-> rec quat z) (-> slot quat-z))
    (set! (-> rec quat w) (-> slot quat-w))
    (set! (-> rec generation) (-> *mp-replication-state* remote enemies generation)))
  (none))

(defun mp-enemy-apply-state ((e-proc enemy) (slot mp-enemy-state))
  (when (and e-proc
             (nonzero? e-proc)
             (not (mp-enemy-authoritative? e-proc))
             (not (logtest? (-> e-proc mask) (process-mask sleep)))
             (!= (-> e-proc status) 'dead))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (nonzero? enemy-aid)
        (let ((rec (mp-get-enemy-auth enemy-aid)))
          (when (and rec (nonzero? rec))
            (mp-enemy-copy-remote-presentation! rec slot)
            (set! (-> rec state) (the-as mp-enemy-state-id (-> slot state)))
            (set! (-> rec focus-player-id) (-> slot focus-player-id))))))
    (when (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start)))
      (let ((old-hp (-> e-proc hit-points))
            (new-hp (-> slot hp)))
        (when (or (not (is-enemy-in-pausable-state? e-proc)) (< new-hp old-hp))
          (when (!= old-hp new-hp)
            (set! (-> e-proc hit-points) new-hp))))
      (when (and (= (-> slot state) (mp-enemy-state-id die))
                 (not (logtest? (-> e-proc enemy-flags) (enemy-flag death-start))))
        (set! (-> e-proc hit-points) 0)
        (send-event e-proc 'die)))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (nonzero? enemy-aid)
        (let ((rec (mp-get-enemy-auth enemy-aid))) (when rec (mp-enemy-sync-remote-state! e-proc rec (-> slot state)))))))
  (none))

(defun mp-enemy-broadcast-death ((e-proc enemy))
  (when (and e-proc (nonzero? e-proc) (mp-enemy-authoritative? e-proc))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and (nonzero? enemy-aid) (not (mp-battle-enemy-id? enemy-aid)))
        (mp-mark-aid-dead-perm! enemy-aid)
        (mp-event-enqueue-enemy-death! enemy-aid))))
  (none))

(defun mp-enemy-remote-slot-valid? ((slot mp-enemy-state))
  (and (nonnull? slot)
       (nonnull? *mp-replication-state*)
       (nonzero? (-> *mp-replication-state* remote enemies valid?))
       (nonzero? (-> slot actor-id))))

(defun mp-enemy-remote-transform-ready? ((e-proc enemy) (slot mp-enemy-state))
  (when (nonnull? e-proc slot (mp-local-player-record) (-> e-proc root))
    (let ((enemy-aid (mp-get-enemy-aid e-proc))
          (target-state (mp-enemy-get-state-from-id (-> slot state))))
      (return (and (nonnull? enemy-aid)
                   (= enemy-aid (-> slot actor-id))
                   (mp-enemy-remote-slot-valid? slot)
                   (not (mp-enemy-authoritative? e-proc))
                   (not (mp-enemy-terminal-sync? e-proc enemy-aid))
                   (not (is-enemy-in-pausable-state? e-proc))
                   (not (is-in-pausable-state? target-state))))))
  #f)

(defun mp-enemy-converge-presentation! ((root collide-shape)
                                        (target-trans vector)
                                        (target-quat quaternion)
                                        (target-linvel vector))
  (when (nonnull? root target-trans target-quat target-linvel)
    (let ((error-dist (vector-vector-distance (-> root trans) target-trans)))
      (cond
        ((or (< error-dist (meters 0.05)) (> error-dist (meters 5.0)))
         (vector-copy! (-> root trans) target-trans)
         (quaternion-copy! (-> root quat) target-quat))
        (else
         (vector-lerp! (-> root trans) (-> root trans) target-trans 0.25)
         (quaternion-slerp! (-> root quat) (-> root quat) target-quat 0.25))))
    (vector-copy! (-> root transv) target-linvel))
  (none))

(defun mp-enemy-apply-remote-presentation! ((e-proc enemy) (rec mp-enemy-auth-record))
  (when (nonnull? e-proc rec (-> e-proc root))
    (mp-enemy-converge-presentation! (-> e-proc root) (-> rec trans) (-> rec quat) (-> rec linvel)))
  (none))

(defun mp-enemy-apply-remote-focus! ((e-proc enemy) (rec mp-enemy-auth-record))
  (when (and e-proc
             (nonzero? e-proc)
             rec
             (nonzero? rec)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             (mp-player-id-valid? (the-as uint (-> rec focus-player-id)))
             (-> e-proc focus)
             (nonzero? (-> e-proc focus)))
    (let ((target-player-id (the-as uint (-> rec focus-player-id))))
      (let ((focus-proc (the-as process-focusable (mp-player-target-by-id target-player-id))))
        (when (and focus-proc (nonzero? focus-proc))
          (set! (-> e-proc focus handle) (process->handle focus-proc))))))
  (none))

(defun mp-enemy-apply-remote-transform-from-slot! ((e-proc enemy) (slot mp-enemy-state))
  (when (mp-enemy-remote-transform-ready? e-proc slot)
    (let ((rec (mp-get-enemy-auth (mp-get-enemy-aid e-proc))))
      (when (and rec (nonzero? rec))
        (mp-enemy-copy-remote-presentation! rec slot)
        (mp-enemy-apply-remote-presentation! e-proc rec)
        (mp-enemy-apply-remote-focus! e-proc rec))))
  (none))

(defun mp-enemy-apply-remote-transform! ((e-proc enemy))
  (when (and e-proc (nonzero? e-proc) (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (let ((enemy-aid (mp-get-enemy-aid e-proc)))
      (when (and (nonzero? enemy-aid)
                 (not (mp-enemy-authoritative? e-proc))
                 (not (mp-enemy-terminal-sync? e-proc enemy-aid)))
        (let ((slot (mp-enemy-find-remote-slot enemy-aid)))
          (when (and slot (nonzero? slot))
            (mp-enemy-apply-remote-transform-from-slot! e-proc slot))))))
  (none))

(defun mp-enemy-find-remote-slot ((enemy-aid uint))
  (let ((local-id (mp-local-player-id)))
    (dotimes (i (min MP_MAX_REMOTE_ENEMIES (-> *mp-enemy-buffer* remote-count)))
      (let ((slot (-> *mp-enemy-buffer* remote-enemies i)))
        (when (and (nonzero? (-> slot actor-id))
                   (= (-> slot actor-id) (the-as uint32 enemy-aid))
                   (or (not (mp-player-id-valid? local-id)) (!= (-> slot owner-player-id) local-id)))
          (return slot)))))
  (the-as mp-enemy-state #f))

(defun enemy-snap-to-record-on-takeover! ((proc enemy) (rec mp-enemy-auth-record) (aid uint))
  (when (and (nonnull? proc rec (-> proc root)) (not (mp-enemy-terminal-sync? proc aid)))
    (vector-copy! (-> proc root trans) (-> rec trans))
    (quaternion-copy! (-> proc root quat) (-> rec quat))
    (vector-reset! (-> proc root transv)))
  (none))

(defun is-enemy-retired? ((proc enemy) (aid uint))
  (let ((terminal (mp-enemy-terminal-sync? proc aid))
        (dead-perm (mp-aid-dead-perm? aid))
        (culled (and (nonnull? proc (-> proc state))
                     (or (= (-> proc state name) 'inactive) (= (-> proc state name) 'process-drawable-art-error)))))
    (when (or terminal dead-perm culled)
      (let ((rec (mp-get-enemy-auth aid))) (when (nonnull? rec) (mp-enemy-release-auth-record! rec)))
      (cond
        ((mp-enemy-death-presentation-active? proc) (logior! (-> proc enemy-flags) (enemy-flag stop-syncing)))
        (dead-perm (when (not (mp-deactivate-dead-aid-if-loaded! aid)) (deactivate proc)))
        ((and terminal (not culled)) (logior! (-> proc enemy-flags) (enemy-flag stop-syncing))))
      (return #t)))
  #f)

(defun mp-enemy-publish-local-state! ((proc enemy) (rec mp-enemy-auth-record) (aid uint))
  (when (and (nonnull? proc rec *mp-enemy-buffer* (-> proc root))
             (!= (-> proc status) 'dead)
             (not (logtest? (-> proc enemy-flags) (enemy-flag stop-syncing)))
             (< (-> *mp-enemy-buffer* local-count) MP_MAX_SYNC_ENEMIES))
    (let ((slot (-> *mp-enemy-buffer* local-enemies (-> *mp-enemy-buffer* local-count))))
      (mp-enemy-pack-state proc slot aid)
      (set! (-> slot owner-player-id) (the uint8 (mp-local-player-id)))
      (set! (-> slot is-aggro) (the uint8 (if (-> rec is-aggro) 1 0))))
    (+! (-> *mp-enemy-buffer* local-count) 1)
    (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
    (set! (-> rec last-remote-state-bump-time) 0)
    (mp-enemy-reset-remote-motion-sample! rec)
    (vector-copy! (-> rec trans) (-> proc root trans))
    (quaternion-copy! (-> rec quat) (-> proc root quat))
    (set! (-> rec state) (the-as mp-enemy-state-id (mp-enemy-get-state-id proc))))
  (none))

(defun mp-enemy-apply-bootstrap-death! ((proc enemy) (aid uint))
  (when (and (mp-bootstrap-in-progress?) (nonnull? proc *mp-bootstrap-state*))
    (dotimes (index (the int (-> *mp-bootstrap-state* synchronized-aid-count)))
      (when (= (-> *mp-bootstrap-state* synchronized-aids index) (the uint32 aid))
        (when (nonnull? (-> proc entity) (-> proc entity extra) (-> proc entity extra perm))
          (logior! (-> proc entity extra perm status) (entity-perm-status dead)))
        (deactivate proc)
        (return #t))))
  #f)

(defun mp-sync-enemies-update-callback ((p process-tree))
  (let ((proc (the-as process p)))
    (when (and (nonnull? proc)
               (type? proc enemy)
               (logtest? (-> proc mask) (process-mask enemy collectable bot))
               (not (logtest? (-> proc mask) (process-mask civilian guard))))
      (let* ((enemy (the-as enemy proc))
             (aid (mp-get-enemy-aid enemy)))
        (when (and (nonzero? aid) (not (is-enemy-retired? enemy aid)))
          (let ((rec (mp-enemy-track-authority! enemy aid)))
            (when (nonnull? rec)
              (if (mp-enemy-authoritative? enemy)
                (begin
                  (mp-enemy-take-local-control! enemy rec)
                  (mp-enemy-publish-local-state! enemy rec aid))
                (let ((slot (mp-enemy-find-remote-slot aid)))
                  (when (and (mp-enemy-remote-slot-valid? slot)
                             (= (-> slot owner-player-id) (-> rec owner-player-id))
                             (nonnull? (-> enemy root)))
                    (mp-enemy-apply-state enemy slot))))))
          (mp-enemy-apply-bootstrap-death! enemy aid)))))
  #t)

(defun mp-sync-enemies-update ()
  (mp-enemy-reclaim-auth-records!)
  (set! (-> *mp-enemy-buffer* local-count) (the-as uint 0))
  (iterate-process-tree *active-pool* mp-sync-enemies-update-callback *kernel-context*)
  (mp-enemy-authority-tick!)
  (mp-enemy-debug-draw)
  (none))

(defun mp-reset-enemy-state! ()
  (set! *mp-battle-spawn-counter* (the uint 0))
  (when (nonnull? *mp-enemy-buffer*)
    (mem-set32! (the-as pointer *mp-enemy-buffer*) (/ (size-of mp-enemy-sync-buffer) 4) 0))
  (mp-reset-enemy-authority!)
  (none))
