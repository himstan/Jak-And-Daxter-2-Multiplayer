;;-*-Lisp-*-
(in-package goal)

(define-extern mp-get-enemy-auth (function uint mp-enemy-auth-record))
(define-extern mp-get-free-enemy-auth (function mp-enemy-auth-record))
(define-extern mp-enemy-find-remote-slot (function uint mp-enemy-state))
(define-extern *mp-enemy-debug-auth?* symbol)

(defun is-in-pausable-state? ((state-name symbol))
  (case state-name
    (('knocked 'get-up-front 'get-up-back 'die 'die-falling 'die-fast)
     #t
     )
    (else #f)
    )
  )

(defun is-enemy-in-pausable-state? ((e enemy))
  (let ((state-name (if (-> e state) (-> e state name) #f)))
    (is-in-pausable-state? state-name)
    )
  )

(defun mp-enemy-death-presentation-active? ((e enemy))
  "True once a loaded enemy should finish its local death presentation."
  (and e
       (nonzero? e)
       (or (<= (-> e hit-points) 0)
           (= (-> e status) 'dead)
           (logtest? (-> e enemy-flags) (enemy-flag death-start mp-synced-death)))
       )
  )

(defun mp-enemy-terminal-sync? ((e-proc enemy) (enemy-aid uint))
  "True once sync/authority must stop treating this enemy as alive."
  (and e-proc
       (nonzero? e-proc)
       (or (<= (-> e-proc hit-points) 0)
           (= (-> e-proc status) 'dead)
           (logtest? (-> e-proc enemy-flags) (enemy-flag death-start mp-synced-death))
           (and (nonzero? enemy-aid)
                (mp-aid-dead-perm? enemy-aid)))
       )
  )

(defun mp-enemy-get-death-hint ((e-proc enemy))
  "Capture the visual death path the owner is starting."
  (when (and e-proc (nonzero? e-proc))
    (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f))
          (info (-> e-proc enemy-info)))
      (cond
        ((= cur-state 'die-fast)
         (mp-enemy-death-hint die-fast)
         )
        ((and info (nonzero? info)
              (-> info use-die-falling)
              (or (= cur-state 'die-falling)
                  (= cur-state 'knocked)
                  (= cur-state 'knocked-vicinity)
                  (!= (-> e-proc incoming knocked-type) (knocked-type knocked-type-0))))
         (mp-enemy-death-hint die-falling)
         )
        (else
         (mp-enemy-death-hint die)
         )
        )
      )
    )
  )

;; --- State ID Mapping ---

(defun mp-enemy-get-state-id ((e-proc enemy))
  "Get a numeric ID for the current virtual state of an enemy."
  (let ((s-name (if (-> e-proc state) (-> e-proc state name) #f)))
    (case s-name
      (('active) (the-as uint32 1))
      (('notice) (the-as uint32 2))
      (('hostile) (the-as uint32 3))
      (('hit) (the-as uint32 4))
      (('knocked 'knocked-vicinity) (the-as uint32 5))
      (('stare) (the-as uint32 6))
