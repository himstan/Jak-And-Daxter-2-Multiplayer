      (('sig-path-run) (the-as uint32 50))
      (('sig-path-jump) (the-as uint32 51))
      (('sig-path-jump-land) (the-as uint32 52))
      (('sig-path-shoot-jump) (the-as uint32 53))
      (('sig-path-shoot-jump-land) (the-as uint32 54))
      (('sig-path-idle) (the-as uint32 55))
      (('charge-plasma) (the-as uint32 56))
      (('gun-jam) (the-as uint32 57))
      (('repair-gun) (the-as uint32 58))
      (('clean-gun) (the-as uint32 59))
      (('whip) (the-as uint32 60))
      (('blast) (the-as uint32 61))
      (('chase-attack) (the-as uint32 62))
      (('stare-idle) (the-as uint32 63))
      (('attack-forward) (the-as uint32 64))
