(in-package goal)

(define-extern mp-get-free-enemy-auth (function mp-enemy-auth-record))
(define-extern mp-enemy-current-battle-owner (function enemy int))
(define-extern mp-enemy-local-player-pos (function vector))
(define-extern mp-enemy-request-authority! (function mp-enemy-auth-record uint none))
(define-extern pedestrian-replica-locked? (function citizen object))

(defconstant MP_ENEMY_COMBAT_AUTHORITY_DISTANCE (meters 100.0))

(defun mp-enemy-level-id ((proc enemy))
  (when (nonnull? proc (-> proc entity) (-> proc entity extra) (-> proc entity extra level))
    (return (mp-level-symbol->id (-> proc entity extra level name))))
  (mp-player-primary-level-id (mp-local-player-record)))

(defun mp-enemy-aggro? ((proc enemy))
  (the symbol
       (and (nonnull? proc (-> proc focus))
            (>= (the int (-> proc focus aware)) (the int (enemy-aware enemy-aware-3)))
            (mp-player-slot-valid? (mp-player-slot-from-process (handle->process-safe (-> proc focus handle)))))))

(defun mp-enemy-delegatable? ((proc enemy) (aid uint))
  (the symbol
       (and (nonzero? aid)
            (not (mp-battle-enemy-id? aid))
            (not (mp-aid-dead-perm? aid))
            (or (not (nonnull? proc))
                (and (not (mp-enemy-terminal-sync? proc aid))
                     (not (mp-enemy-host-only? proc))
                     (not (type? proc bot))
                     (< (mp-enemy-current-battle-owner proc) 0))))))

(defun mp-enemy-authority-process ((rec mp-enemy-auth-record))
  (when (nonnull? rec)
    (let ((proc (handle->process-safe (-> rec process-handle))))
      (when (and (nonnull? proc)
                 (type? proc enemy)
                 (= (mp-get-enemy-aid (the-as enemy proc)) (the uint (-> rec aid)))
                 (mp-enemy-lookup-candidate? (the-as enemy proc)))
        (return (the-as enemy proc)))))
  (the-as enemy #f))

(defun mp-enemy-player-eligible? ((record mp-player-record) (level-id uint))
  (when (and (nonnull? record)
             (nonzero? level-id)
             (nonzero? (-> record identity joined?))
             (zero? (-> record identity spectator-only?))
             (or (= (the uint (-> record identity player-slot)) (mp-local-player-slot))
                 (and (nonzero? (-> record identity state-ready?))
                      (nonzero? (-> record connection state-cached?))
                      (= (-> record connection activity) (mp-player-activity in-game))))
             (not (mp-player-record-dead-or-dying? record))
             (or (!= (the uint (-> record identity player-slot)) (mp-local-player-slot))
                 (and (not (mp-bootstrap-in-progress?)) (nonnull? (mp-enemy-local-player-pos)))))
    (dotimes (index MP_PLAYER_LEVEL_SLOT_COUNT)
      (when (and (= (the uint (-> record transform levels index level-id)) level-id)
                 (or (zero? index)
                     (nonzero? (logand (-> record transform levels index flags) MP_PLAYER_LEVEL_MODE_MASK))))
        (return #t))))
  #f)

(defun mp-enemy-owner-candidate? ((rec mp-enemy-auth-record) (player-slot uint) (excluded uint))
  (let ((record (mp-player-record-by-slot player-slot)))
    (the symbol
         (and (nonnull? rec record)
              (!= player-slot excluded)
              (mp-enemy-player-eligible? record (the uint (-> rec level-id)))
              (not (and (mp-player-daxter? record)
                        (mp-player-slot-valid? (the uint (-> record action riding-along-player-slot)))))
              (or (not (mp-session-host?))
                  (if (= player-slot (mp-host-player-slot))
                    (let ((proc (mp-enemy-authority-process rec)))
                      (and (nonnull? proc (-> proc root)) (run-logic? proc)))
                    (nonzero? (logand (-> rec loaded-player-mask) (shl 1 player-slot)))))))))

(defun mp-enemy-combat-owner ((rec mp-enemy-auth-record) (excluded uint))
  (when (not (nonnull? rec (-> rec is-aggro)))
    (return MP_INVALID_PLAYER_SLOT))
  (let* ((locked (the uint (-> rec combat-owner-player-slot)))
         (player-slot (if (mp-player-slot-valid? locked) locked (the uint (-> rec focus-player-slot))))
         (record (mp-player-record-by-slot player-slot)))
    (when (and (nonnull? record)
               (mp-enemy-owner-candidate? rec player-slot excluded)
               (<= (vector-vector-distance (-> rec trans) (-> record transform position))
                   MP_ENEMY_COMBAT_AUTHORITY_DISTANCE))
      (return player-slot)))
  MP_INVALID_PLAYER_SLOT)

(defun mp-enemy-preferred-owner ((rec mp-enemy-auth-record) (excluded uint))
  (when (not (nonnull? rec))
    (return MP_INVALID_PLAYER_SLOT))
  (let ((combat-owner (mp-enemy-combat-owner rec excluded)))
    (when (mp-player-slot-valid? combat-owner)
      (return combat-owner)))
  (let ((owner (the uint (-> rec owner-player-slot)))
        (best-id MP_INVALID_PLAYER_SLOT)
        (best-distance (meters 1000000.0)))
    (when (mp-enemy-owner-candidate? rec owner excluded)
      (let ((record (mp-player-record-by-slot owner)))
        (when (nonnull? record)
          (set! best-id owner)
          (set! best-distance (vector-vector-distance (-> rec trans) (-> record transform position))))))
    (mp-for-each-player-record (player-slot record)
      (when (and (!= (the uint player-slot) best-id) (mp-enemy-owner-candidate? rec (the uint player-slot) excluded))
        (let ((distance (vector-vector-distance (-> rec trans) (-> record transform position))))
          (when (or (= best-id MP_INVALID_PLAYER_SLOT)
                    (< distance (- best-distance (if (= best-id owner) *mp-combat-retarget-distance-bias* 0.0)))
                    (and (!= best-id owner) (= distance best-distance) (< (the uint player-slot) best-id)))
            (set! best-id (the uint player-slot))
            (set! best-distance distance)))))
    best-id))

(defun mp-event-apply-enemy-authority! ((rec mp-enemy-auth-record) (proc enemy) (owner uint))
  (when (nonnull? rec)
    (set! (-> rec owner-player-slot) (the uint8 owner))
    (when (or (nonnull? (-> rec is-aggro)) (mp-player-slot-valid? (the uint (-> rec combat-owner-player-slot))))
      (set! (-> rec combat-owner-player-slot) (the uint8 owner)))
    (set! (-> rec request-pending?) (the uint8 0))
    (set! (-> rec last-transfer-time) (current-time))
    (set! (-> rec just-taken-authority) (= owner (mp-local-player-slot)))
    (when (and (nonnull? proc) (mp-enemy-lookup-candidate? proc) (!= owner (mp-local-player-slot)))
      (set! (-> proc trans-hook) #f)
      (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
      (when (nonnull? (-> proc state))
        (logior! (-> proc mask) (process-mask sleep-code))))
    (when (and (not (mp-enemy-lookup-candidate? proc))
               (or (= owner (mp-host-player-slot)) (= owner (mp-local-player-slot))))
      (mp-enemy-release-auth-record! rec)))
  (none))

(defun mp-enemy-reassign-authority! ((rec mp-enemy-auth-record) (proc enemy) (excluded uint))
  (when (and (mp-session-host?) (nonnull? rec))
    (let* ((previous (the uint (-> rec owner-player-slot)))
           (preferred (mp-enemy-preferred-owner rec excluded))
           (owner (if (= preferred MP_INVALID_PLAYER_SLOT) (mp-host-player-slot) preferred)))
      (when (or (nonnull? (-> rec is-aggro)) (mp-player-slot-valid? (the uint (-> rec combat-owner-player-slot))))
        (set! (-> rec combat-owner-player-slot) (the uint8 preferred)))
      (cond
        ((and (= owner previous) (= preferred MP_INVALID_PLAYER_SLOT) (not (nonnull? proc)))
         (mem-set32! (the-as pointer rec) (/ (size-of mp-enemy-auth-record) 4) 0))
        ((and (!= owner previous)
              (or (= previous excluded)
                  (not (mp-enemy-owner-candidate? rec previous MP_INVALID_PLAYER_SLOT))
                  (>= (- (current-time) (-> rec last-transfer-time)) (seconds 2)))
              (mp-event-enqueue-authority-grant! (the uint (-> rec aid)) owner))
         (mp-event-apply-enemy-authority! rec proc owner)))))
  (none))

(defun mp-enemy-request-if-needed! ((rec mp-enemy-auth-record) (proc enemy))
  (when (and (mp-session-client?)
             (nonnull? rec proc (-> proc root))
             (!= (the uint (-> rec owner-player-slot)) (mp-local-player-slot))
             (mp-enemy-player-eligible? (mp-local-player-record) (the uint (-> rec level-id))))
    (when (or (zero? (-> rec request-time))
              (not (mp-enemy-remote-slot-valid? (mp-enemy-find-remote-slot (the uint (-> rec aid)))))
              (= (mp-enemy-preferred-owner rec MP_INVALID_PLAYER_SLOT) (mp-local-player-slot)))
      (mp-enemy-request-authority! rec (the uint (-> rec aid)))))
  (none))

(defun mp-enemy-authority-sample! ((rec mp-enemy-auth-record) (proc enemy))
  (when (nonnull? rec)
    (cond
      ((and (nonnull? proc (-> proc root)) (= (the uint (-> rec owner-player-slot)) (mp-local-player-slot)))
       (vector-copy! (-> rec trans) (-> proc root trans))
       (set! (-> rec is-aggro) (mp-enemy-aggro? proc))
       (set! (-> rec focus-player-slot) MP_INVALID_PLAYER_SLOT)
       (when (nonnull? (-> proc focus))
         (set! (-> rec focus-player-slot) (mp-player-slot-from-process (handle->process-safe (-> proc focus handle))))))
      (else
       (let ((slot (mp-enemy-find-remote-slot (the uint (-> rec aid)))))
         (when (and (mp-enemy-remote-slot-valid? slot) (= (-> slot owner-player-slot) (-> rec owner-player-slot)))
           (set-vector! (-> rec trans) (-> slot x) (-> slot y) (-> slot z) 1.0)
           (set! (-> rec is-aggro) (nonzero? (-> slot is-aggro)))
           (set! (-> rec focus-player-slot) (-> slot focus-player-slot)))))))
  (none))

(defun mp-enemy-authority-tick! ()
  (when (and (mp-session-host?) (nonnull? *mp-enemy-auth*))
    (dotimes (index MP_MAX_ENEMY_AUTH_RECORDS)
      (let ((rec (-> *mp-enemy-auth* index)))
        (when (and (nonzero? (-> rec aid))
                   (nonzero? (-> rec level-id))
                   (not (mp-battle-enemy-id? (the uint (-> rec aid))))
                   (not (mp-aid-dead-perm? (the uint (-> rec aid)))))
          (let ((proc (mp-enemy-authority-process rec)))
            (when (mp-enemy-delegatable? proc (the uint (-> rec aid)))
              (mp-enemy-authority-sample! rec proc)
              (mp-enemy-reassign-authority! rec proc MP_INVALID_PLAYER_SLOT)))))))
  (none))

(defun mp-get-enemy-auth ((enemy-aid uint))
  (let ((u32-aid (the-as uint32 enemy-aid)))
    (dotimes (i MP_MAX_ENEMY_AUTH_RECORDS)
      (let ((rec (-> *mp-enemy-auth* i))) (when (= (-> rec aid) u32-aid) (return rec)))))
  (the-as mp-enemy-auth-record #f))

(defun mp-get-free-enemy-auth ()
  (dotimes (i MP_MAX_ENEMY_AUTH_RECORDS)
    (let ((rec (-> *mp-enemy-auth* i)))
      (when (= (-> rec aid) 0)
        (set! (-> rec combat-owner-player-slot) (the uint8 MP_INVALID_PLAYER_SLOT))
        (set! (-> rec is-aggro) #f)
        (set! (-> rec just-taken-authority) #f)
        (set! (-> rec last-applied-remote-state) (the-as mp-enemy-state-id 0))
        (set! (-> rec last-remote-state-bump-time) 0)
        (set! (-> rec pending-cue) (the uint8 0))
        (mp-enemy-reset-remote-motion-sample! rec)
        (return rec))))
  (the-as mp-enemy-auth-record #f))

(defun mp-enemy-reserve-auth-record! ((aid uint) (owner uint))
  (when (and (nonnull? *mp-enemy-auth*) (nonzero? aid) (not (mp-battle-enemy-id? aid)) (mp-player-slot-valid? owner))
    (let ((rec (mp-get-enemy-auth aid)))
      (when (not (nonnull? rec))
        (set! rec (mp-get-free-enemy-auth))
        (when (nonnull? rec)
          (set! (-> rec aid) (the uint32 aid))
          (set! (-> rec owner-player-slot) (the uint8 owner))
          (set! (-> rec focus-player-slot) MP_INVALID_PLAYER_SLOT)))
      (return rec)))
  (the-as mp-enemy-auth-record #f))

(defun mp-enemy-current-battle-owner ((proc enemy))
  (let ((owner (mp-battle-enemy-owner-player-slot proc)))
    (if (and (>= owner 0) (not (nonnull? (mp-player-record-by-slot (the uint owner))))) (the int (mp-host-player-slot)) owner)))

(defun mp-enemy-authoritative? ((e-proc enemy))
  (when (mp-enemy-host-only? e-proc)
    (return (mp-session-host?)))
  (when (and e-proc (nonzero? e-proc) (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (let ((battle-owner (mp-enemy-current-battle-owner e-proc)))
      (when (>= battle-owner 0)
        (return (= battle-owner (-> (mp-local-player-record) identity player-slot))))))
  (when (type? e-proc bot)
    (return (mp-session-host?)))
  (let ((enemy-aid (mp-get-enemy-aid e-proc)))
    (when (nonzero? enemy-aid)
      (let ((rec (mp-get-enemy-auth enemy-aid)))
        (if rec (return (= (-> rec owner-player-slot) (-> (mp-local-player-record) identity player-slot)))))))
  (mp-session-host?))

(defun mp-enemy-awaiting-battle-network-id? ((e-proc enemy))
  (and e-proc
       (nonzero? e-proc)
       (logtest? (-> e-proc enemy-flags) (enemy-flag battle-spawned))
       (zero? (-> e-proc net-id))))

(defun mp-enemy-battle-state-unmapped? ((e-proc enemy) (rec mp-enemy-auth-record))
  (if (and e-proc
           (nonzero? e-proc)
           rec
           (nonzero? rec)
           (logtest? (-> e-proc enemy-flags) (enemy-flag battle-spawned))
           (zero? (-> rec state)))
    #t
    #f))

(defun mp-enemy-allow-local-state-transition? ((e-proc enemy))
  (if (and e-proc (nonzero? e-proc))
    (if (mp-enemy-awaiting-battle-network-id? e-proc)
      #t
      (let ((enemy-aid (mp-get-enemy-aid e-proc)))
        (if (and (nonzero? enemy-aid) (not (logtest? (-> e-proc enemy-flags) (enemy-flag stop-syncing))))
          (let ((rec (mp-get-enemy-auth enemy-aid)))
            (if (and rec (nonzero? rec))
              (if (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
                (or (= (-> rec owner-player-slot) (-> (mp-local-player-record) identity player-slot))
                    *mp-processing-remote-event*
                    (mp-enemy-battle-state-unmapped? e-proc rec))
                #t)
              #t))
          #t)))
    #f))

(defun mp-process-allow-local-state-transition? ((proc process) (entering-state? symbol))
  (when (and (nonnull? proc) (type? proc citizen) (pedestrian-replica-locked? (the-as citizen proc)))
    (return (or (not entering-state?)
                *mp-processing-remote-event*
                (logtest? (-> (the-as citizen proc) enemy-flags) (enemy-flag stop-syncing))
                (is-enemy-in-pausable-state? (the-as citizen proc)))))
  (if (and proc (nonzero? proc) (logtest? (-> proc mask) (process-mask enemy)) (type? proc enemy))
    (mp-enemy-allow-local-state-transition? (the-as enemy proc))
    #t))

(defun mp-enemy-allow-kill-prefer-falling? ((e-proc enemy))
  (if (and e-proc (nonzero? e-proc))
    (or (mp-enemy-authoritative? e-proc) *mp-processing-remote-event* (<= (-> e-proc hit-points) 0))
    #f))

(defun mp-enemy-restore-local-state-transition! ((e-proc enemy))
  (when (and e-proc (nonzero? e-proc))
    (process-mask-clear! (-> e-proc mask) sleep-code)
    (let ((current-state (-> e-proc state)))
      (when (and current-state (nonzero? current-state))
        (set! (-> e-proc trans-hook) (-> current-state trans))
        (when (and (-> e-proc focus)
                   (nonzero? (-> e-proc focus))
                   (or (= (-> current-state name) 'chase)
                       (= (-> current-state name) 'hostile)
                       (= (-> current-state name) 'notice)))
          (set! (-> e-proc focus aware) (enemy-aware enemy-aware-3))
          (let ((enemy-aid (mp-get-enemy-aid e-proc)))
            (when (nonzero? enemy-aid)
              (let ((rec (mp-get-enemy-auth enemy-aid)))
                (when (and rec (mp-player-slot-valid? (the-as uint (-> rec focus-player-slot))))
                  (let ((target-player-slot (the-as uint (-> rec focus-player-slot))))
                    (let ((focus-proc (the-as process-focusable (mp-player-target-by-slot target-player-slot))))
                      (when (and focus-proc (nonzero? focus-proc))
                        (set! (-> e-proc focus handle) (process->handle focus-proc)))))))))))))
  (none))

(defun mp-enemy-host-delegated? ((rec mp-enemy-auth-record))
  (and (nonnull? rec)
       (mp-session-host?)
       (nonzero? (-> rec aid))
       (not (mp-battle-enemy-id? (the uint (-> rec aid))))
       (not (mp-aid-dead-perm? (the uint (-> rec aid))))
       (!= (the uint (-> rec owner-player-slot)) (mp-host-player-slot))))

(defun mp-enemy-release-auth-record! ((rec mp-enemy-auth-record))
  (when (nonnull? rec)
    (let ((proc (handle->process-safe (-> rec process-handle))))
      (when (and (nonnull? proc)
                 (type? proc enemy)
                 (= (mp-get-enemy-aid (the-as enemy proc)) (the uint (-> rec aid)))
                 (mp-enemy-terminal-sync? (the-as enemy proc) (the uint (-> rec aid)))
                 (not (logtest? (-> (the-as enemy proc) enemy-flags) (enemy-flag called-dying))))
        (return (the-as none 0))))
    (cond
      ((mp-enemy-host-delegated? rec)
       (set! (-> rec process-handle) (the-as handle 0))
       (mp-enemy-reset-remote-motion-sample! rec))
      ((and (mp-session-host?)
            (nonzero? (-> rec aid))
            (nonzero? (-> rec level-id))
            (mp-enemy-delegatable? (find-any-enemy-by-aid (the uint (-> rec aid))) (the uint (-> rec aid))))
       (set! (-> rec process-handle) (the-as handle 0))
       (mp-enemy-reassign-authority! rec (the-as enemy #f) (mp-host-player-slot)))
      ((and (mp-session-client?)
            (nonzero? (-> rec aid))
            (or (= (the uint (-> rec owner-player-slot)) (mp-local-player-slot))
                (nonzero? (logand (-> rec loaded-player-mask) (shl 1 (mp-local-player-slot)))))
            (not (mp-battle-enemy-id? (the uint (-> rec aid))))
            (not (mp-event-enqueue-authority-grant! (the uint (-> rec aid)) (mp-host-player-slot))))
       (none))
      (else (mem-set32! (the-as pointer rec) (/ (size-of mp-enemy-auth-record) 4) 0))))
  (none))

(defun mp-enemy-local-player-pos ()
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *level*
             (nonzero? *level*)
             (= (-> *level* loading-level) (-> *level* default-level))
             (not (load-in-progress? *level*))
             (not (focus-test? *target* teleporting))
             (not (logtest? (-> *target* focus-status) (focus-status dead))))
    (return (-> *target* control trans)))
  (the-as vector #f))

(defun mp-enemy-request-authority! ((rec mp-enemy-auth-record) (aid uint))
  (when (and (nonnull? rec)
             (>= (- (current-time) (-> rec last-transfer-time)) (seconds 2))
             (or (zero? (-> rec request-pending?)) (>= (- (current-time) (-> rec request-time)) (seconds 2))))
    (let ((event (new 'stack-no-clear 'mp-enemy-authority-request-event)))
      (when (mp-event-prepare! event MP_EVENT_ENEMY_AUTHORITY_REQUEST)
        (set! (-> event payload aid) (the uint32 aid))
        (set! (-> event payload x) (-> rec trans x))
        (set! (-> event payload y) (-> rec trans y))
        (set! (-> event payload z) (-> rec trans z))
        (set! (-> event payload level-id) (-> rec level-id))
        (when (mp-event-enqueue! event)
          (logior! (-> rec loaded-player-mask) (the uint8 (shl 1 (mp-local-player-slot))))
          (set! (-> rec request-pending?) (the uint8 1))
          (set! (-> rec request-time) (current-time))))))
  (none))

(defun reassign-player-owned-enemies ((player-slot uint))
  (when (nonnull? *mp-enemy-auth*)
    (dotimes (index MP_MAX_ENEMY_AUTH_RECORDS)
      (let ((rec (-> *mp-enemy-auth* index)))
        (logclear! (-> rec loaded-player-mask) (the uint8 (shl 1 player-slot)))
        (when (and (nonzero? (-> rec aid)) (= (the uint (-> rec owner-player-slot)) player-slot))
          (set! (-> rec request-pending?) (the uint8 0))
          (set! (-> rec is-aggro) #f)
          (if (and (mp-session-host?)
                   (mp-enemy-delegatable? (find-any-enemy-by-aid (the uint (-> rec aid))) (the uint (-> rec aid))))
            (mp-enemy-reassign-authority! rec (find-enemy-by-aid (the uint (-> rec aid))) player-slot)
            (mp-event-apply-enemy-authority! rec (find-any-enemy-by-aid (the uint (-> rec aid))) (mp-host-player-slot)))))))
  (none))

(defun mp-enemy-reclaim-auth-records! ()
  (when (nonnull? *mp-enemy-auth*)
    (dotimes (index MP_MAX_ENEMY_AUTH_RECORDS)
      (let ((rec (-> *mp-enemy-auth* index)))
        (when (nonzero? (-> rec aid))
          (let ((proc (handle->process-safe (-> rec process-handle))))
            (cond
              ((or (not (nonnull? proc))
                   (not (type? proc enemy))
                   (!= (mp-get-enemy-aid (the-as enemy proc)) (the uint (-> rec aid)))
                   (not (mp-enemy-lookup-candidate? (the-as enemy proc)))
                   (mp-enemy-terminal-sync? (the-as enemy proc) (the uint (-> rec aid))))
               (mp-enemy-release-auth-record! rec))
              (else
               (when (and (mp-session-client?)
                          (not (nonnull? (mp-player-record-by-slot (the uint (-> rec owner-player-slot))))))
                 (set! (-> rec owner-player-slot) (the uint8 (mp-host-player-slot)))
                 (set! (-> rec request-pending?) (the uint8 0))
                 (set! (-> rec is-aggro) #f)
                 (set! (-> rec just-taken-authority) #f))
               (when (not (nonnull? (mp-enemy-find-remote-slot (the uint (-> rec aid)))))
                 (mp-enemy-reset-remote-motion-sample! rec)))))))))
  (none))

(defun mp-enemy-init-auth-record! ((rec mp-enemy-auth-record) (proc enemy) (aid uint))
  (when (nonnull? rec proc)
    (set! (-> rec aid) (the uint32 aid))
    (set! (-> rec process-handle) (process->handle proc))
    (set! (-> rec request-pending?) (the uint8 0))
    (set! (-> rec level-id) (the uint8 (mp-enemy-level-id proc)))
    (set! (-> rec loaded-player-mask) (the uint8 0))
    (set! (-> rec request-time) 0)
    (set! (-> rec is-aggro) #f)
    (set! (-> rec last-transfer-time) 0)
    (set! (-> rec combat-owner-player-slot) (the uint8 MP_INVALID_PLAYER_SLOT))
    (set! (-> rec just-taken-authority) #f)
    (set! (-> rec owner-player-slot) (the uint8 (mp-host-player-slot)))
    (mp-enemy-reset-presentation! rec proc))
  (none))

(defun mp-enemy-bind-auth-record! ((proc enemy) (aid uint))
  (let ((rec (mp-get-enemy-auth aid)))
    (when (not (nonnull? rec))
      (set! rec (mp-get-free-enemy-auth))
      (when (nonnull? rec)
        (mp-enemy-init-auth-record! rec proc aid)
        (let ((slot (mp-enemy-find-remote-slot aid)))
          (when (and (mp-session-client?)
                     (mp-enemy-remote-slot-valid? slot)
                     (mp-player-slot-valid? (the uint (-> slot owner-player-slot))))
            (set! (-> rec owner-player-slot) (-> slot owner-player-slot))
            (set! (-> rec is-aggro) (nonzero? (-> slot is-aggro)))))))
    (when (nonnull? rec proc)
      (when (and (zero? (the uint64 (-> rec process-handle))) (nonnull? (-> proc root)))
        (vector-copy! (-> rec trans) (-> proc root trans))
        (quaternion-copy! (-> rec quat) (-> proc root quat)))
      (set! (-> rec process-handle) (process->handle proc)))
    rec))

(defun mp-enemy-track-authority! ((proc enemy) (aid uint))
  (when (not (nonnull? proc))
    (return (the-as mp-enemy-auth-record #f)))
  (let ((rec (mp-enemy-bind-auth-record! proc aid))
        (battle-owner (mp-enemy-current-battle-owner proc)))
    (when (nonnull? rec)
      (when (= (the uint (-> rec owner-player-slot)) (mp-local-player-slot))
        (set! (-> rec is-aggro) (mp-enemy-aggro? proc)))
      (cond
        ((mp-enemy-host-only? proc)
         (set! (-> rec owner-player-slot) (the uint8 (mp-host-player-slot)))
         (set! (-> rec just-taken-authority) #f))
        ((>= battle-owner 0)
         (set! (-> rec owner-player-slot) (the uint8 battle-owner))
         (set! (-> rec just-taken-authority) #f))
        ((type? proc bot) (set! (-> rec owner-player-slot) (the uint8 (mp-host-player-slot))))
        (else
         (let ((slot (mp-enemy-find-remote-slot aid)))
           (when (and (mp-enemy-remote-slot-valid? slot)
                      (!= (the uint (-> rec owner-player-slot)) (mp-local-player-slot))
                      (= (-> slot owner-player-slot) (-> rec owner-player-slot)))
             (set! (-> rec is-aggro) (nonzero? (-> slot is-aggro)))))
         (when (not (mp-target-ride-along? *target*))
           (mp-enemy-request-if-needed! rec proc)))))
    rec))

(defun mp-enemy-take-local-control! ((proc enemy) (rec mp-enemy-auth-record))
  (when (and (nonnull? proc rec) (-> rec just-taken-authority))
    (mp-enemy-restore-local-state-transition! proc)
    (when (nonnull? (-> proc root))
      (enemy-snap-to-record-on-takeover! proc rec (the uint (-> rec aid)))
      (send-event proc 'mp-authority-taken)
      (set! (-> rec just-taken-authority) #f)))
  (none))

(defun mp-enemy-note-remote-battle-spawn! ((proc enemy))
  (when (nonnull? proc)
    (let ((aid (mp-get-enemy-aid proc))
          (battle-owner (mp-enemy-current-battle-owner proc)))
      (when (nonzero? aid)
        (let ((rec (mp-get-enemy-auth aid)))
          (when (not (nonnull? rec))
            (set! rec (mp-get-free-enemy-auth)))
          (when (nonnull? rec)
            (mp-enemy-init-auth-record! rec proc aid)
            (set! (-> rec owner-player-slot)
                  (the uint8
                       (if (mp-enemy-host-only? proc) (mp-host-player-slot) (if (>= battle-owner 0) (the uint battle-owner) MP_INVALID_PLAYER_SLOT))))
            (set! (-> rec last-transfer-time) (current-time)))))))
  (none))

(defun mp-reset-enemy-authority! ()
  (when (nonnull? *mp-enemy-auth*)
    (mem-set32! (the-as pointer *mp-enemy-auth*) (/ (* MP_MAX_ENEMY_AUTH_RECORDS (size-of mp-enemy-auth-record)) 4) 0))
  (none))

(defun mp-event-handler-authority-request ((evt mp-enemy-authority-request-event))
  (when (and (mp-session-host?)
             (nonnull? evt)
             (nonzero? (-> evt payload aid))
             (not (mp-battle-enemy-id? (the uint (-> evt payload aid))))
             (not (mp-aid-dead-perm? (the uint (-> evt payload aid))))
             (mp-enemy-player-eligible? (mp-player-record-by-slot (the uint (-> evt source-player-slot)))
                                        (the uint (-> evt payload level-id)))
             (< (abs (-> evt payload x)) (meters 1000000.0))
             (< (abs (-> evt payload y)) (meters 1000000.0))
             (< (abs (-> evt payload z)) (meters 1000000.0)))
    (let ((proc (find-any-enemy-by-aid (the uint (-> evt payload aid)))))
      (when (mp-enemy-delegatable? proc (the uint (-> evt payload aid)))
        (let ((rec (mp-get-enemy-auth (the uint (-> evt payload aid)))))
          (when (not (nonnull? rec))
            (set! rec (mp-enemy-reserve-auth-record! (the uint (-> evt payload aid)) (mp-host-player-slot)))
            (when (and (nonnull? rec) (mp-enemy-lookup-candidate? proc))
              (mp-enemy-init-auth-record! rec proc (the uint (-> evt payload aid)))))
          (when (nonnull? rec)
            (when (zero? (-> rec level-id))
              (set! (-> rec level-id) (-> evt payload level-id))
              (set-vector! (-> rec trans) (-> evt payload x) (-> evt payload y) (-> evt payload z) 1.0))
            (when (= (-> rec level-id) (-> evt payload level-id))
              (logior! (-> rec loaded-player-mask) (the uint8 (shl 1 (-> evt source-player-slot))))
              (mp-enemy-authority-sample! rec proc)
              (mp-enemy-reassign-authority! rec proc MP_INVALID_PLAYER_SLOT)))))))
  (none))

(defun mp-event-handler-authority-ack ((evt mp-enemy-authority-grant-event))
  (when (and (nonnull? evt) (nonzero? (-> evt payload aid)) (not (mp-battle-enemy-id? (the uint (-> evt payload aid)))))
    (let ((rec (mp-get-enemy-auth (the uint (-> evt payload aid))))
          (proc (find-any-enemy-by-aid (the uint (-> evt payload aid))))
          (owner (the uint (-> evt payload owner-player-slot)))
          (source (the uint (-> evt source-player-slot))))
      (cond
        ((and (mp-session-host?) (nonnull? rec) (= owner (mp-host-player-slot)) (!= source (mp-host-player-slot)))
         (logclear! (-> rec loaded-player-mask) (the uint8 (shl 1 source)))
         (when (= source (the uint (-> rec owner-player-slot)))
           (mp-enemy-authority-sample! rec proc)
           (mp-enemy-reassign-authority! rec proc source)))
        ((and (= source (mp-host-player-slot))
              (nonnull? (mp-player-record-by-slot owner))
              (or (not (nonnull? proc))
                  (and (not (mp-enemy-host-only? proc))
                       (not (type? proc bot))
                       (< (mp-enemy-current-battle-owner proc) 0))))
         (when (and (not (nonnull? rec)) (or (mp-enemy-lookup-candidate? proc) (= owner (mp-local-player-slot))))
           (set! rec (mp-enemy-reserve-auth-record! (the uint (-> evt payload aid)) source))
           (when (and (nonnull? rec) (mp-enemy-lookup-candidate? proc))
             (mp-enemy-init-auth-record! rec proc (the uint (-> evt payload aid)))))
         (when (nonnull? rec)
           (mp-event-apply-enemy-authority! rec proc owner))))))
  (none))
