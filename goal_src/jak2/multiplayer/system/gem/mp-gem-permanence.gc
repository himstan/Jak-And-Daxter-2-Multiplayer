;;-*-Lisp-*-
(in-package goal)

(defglobalconstant MP_GEM_COLLECTION_CACHE_CAPACITY (the int 4096))

(define *mp-gem-collected-aids* (new 'global 'boxed-array uint32 MP_GEM_COLLECTION_CACHE_CAPACITY))
(define-perm *mp-gem-collected-aid-count* int 0)
(define *mp-gem-collected-source-aids* (new 'global 'boxed-array uint32 MP_GEM_COLLECTION_CACHE_CAPACITY))
(define *mp-gem-collected-indices* (new 'global 'boxed-array uint32 MP_GEM_COLLECTION_CACHE_CAPACITY))
(define-perm *mp-gem-collected-enemy-count* int 0)
(define *mp-gem-aid-cache-full-logged?* #f)
(define *mp-enemy-gem-cache-full-logged?* #f)

(defun mp-gem-aid-cache-index ((aid uint))
  (when (or (zero? aid) (not (nonnull? *mp-gem-collected-aids*)))
    (return -1))
  (let ((index 0))
    (while (< index *mp-gem-collected-aid-count*)
      (when (= aid (-> *mp-gem-collected-aids* data index))
        (return index))
      (+! index 1)))
  -1)

(defun mp-gem-cache-aid-collected! ((aid uint))
  (when (zero? aid)
    (return #f))
  (when (>= (mp-gem-aid-cache-index aid) 0)
    (return #t))
  (when (not (nonnull? *mp-gem-collected-aids*))
    (return #f))
  (when (< *mp-gem-collected-aid-count* MP_GEM_COLLECTION_CACHE_CAPACITY)
    (set! (-> *mp-gem-collected-aids* data *mp-gem-collected-aid-count*) aid)
    (+! *mp-gem-collected-aid-count* 1)
    (return #t))
  (when (not *mp-gem-aid-cache-full-logged?*)
    (log 'warn "[MP-Gem] Collected AID cache is full; cannot retain aid=~D across level loads.~%" aid)
    (set! *mp-gem-aid-cache-full-logged?* #t))
  #f)

(defun mp-gem-note-local-aid-collected! ((aid uint))
  (when (and (mp-session-in-game?) (nonzero? aid))
    (mp-gem-cache-aid-collected! aid)
    (mp-record-aid-dead-in-perm-list! aid))
  (none))

(defun mp-gem-record-aid-collected! ((aid uint))
  (when (zero? aid)
    (return #f))
  (let ((already-collected? (>= (mp-gem-aid-cache-index aid) 0)))
    (mp-gem-cache-aid-collected! aid)
    (mp-record-aid-dead-in-perm-list! aid)
    (not already-collected?)))

(defun mp-enemy-gem-cache-index ((source-aid uint) (gem-index uint))
  (when (or (zero? source-aid) (not (nonnull? *mp-gem-collected-source-aids* *mp-gem-collected-indices*)))
    (return -1))
  (let ((index 0))
    (while (< index *mp-gem-collected-enemy-count*)
      (when (and (= source-aid (-> *mp-gem-collected-source-aids* data index))
                 (= gem-index (-> *mp-gem-collected-indices* data index)))
        (return index))
      (+! index 1)))
  -1)

(defun mp-enemy-gem-collected? ((source-aid uint) (gem-index uint))
  (>= (mp-enemy-gem-cache-index source-aid gem-index) 0))

(defun mp-enemy-gem-cache-collected! ((source-aid uint) (gem-index uint))
  (when (zero? source-aid)
    (return #f))
  (when (>= (mp-enemy-gem-cache-index source-aid gem-index) 0)
    (return #t))
  (when (not (nonnull? *mp-gem-collected-source-aids* *mp-gem-collected-indices*))
    (return #f))
  (when (< *mp-gem-collected-enemy-count* MP_GEM_COLLECTION_CACHE_CAPACITY)
    (set! (-> *mp-gem-collected-source-aids* data *mp-gem-collected-enemy-count*) source-aid)
    (set! (-> *mp-gem-collected-indices* data *mp-gem-collected-enemy-count*) gem-index)
    (+! *mp-gem-collected-enemy-count* 1)
    (return #t))
  (when (not *mp-enemy-gem-cache-full-logged?*)
    (log 'warn "[MP-Gem] Enemy gem cache is full; cannot retain source aid=~D index=~D.~%" source-aid gem-index)
    (set! *mp-enemy-gem-cache-full-logged?* #t))
  #f)

(defun mp-enemy-gem-note-local-collected! ((source-aid uint) (gem-index uint))
  (when (and (mp-session-in-game?) (nonzero? source-aid))
    (mp-enemy-gem-cache-collected! source-aid gem-index))
  (none))

(defun mp-enemy-gem-record-collected! ((source-aid uint) (gem-index uint))
  (when (zero? source-aid)
    (return #f))
  (let ((already-collected? (mp-enemy-gem-collected? source-aid gem-index)))
    (mp-enemy-gem-cache-collected! source-aid gem-index)
    (not already-collected?)))

(defun mp-gem-restore-collected-aids! ()
  (when (nonnull? *game-info* *mp-gem-collected-aids*)
    (dotimes (index *mp-gem-collected-aid-count*)
      (mp-record-aid-dead-in-perm-list! (-> *mp-gem-collected-aids* data index))))
  (none))

(defun mp-reset-gem-permanence-state! ()
  (set! *mp-gem-collected-aid-count* 0)
  (set! *mp-gem-collected-enemy-count* 0)
  (set! *mp-gem-aid-cache-full-logged?* #f)
  (set! *mp-enemy-gem-cache-full-logged?* #f)
  (none))
