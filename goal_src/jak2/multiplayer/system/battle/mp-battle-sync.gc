;;-*-Lisp-*-
(in-package goal)

(defconstant MP_MAX_BATTLE_RECORDS 16)
(defconstant MP_MAX_BATTLE_SPAWN_RECORDS 128)

(deftype mp-battle-sync-record (structure)
  ((active?             symbol)
   (claim-sent?         symbol)
   (start-applied?      symbol)
   (owner-role          int32)
   (pending-owner-role  int32)
   (epoch               uint32)
   (roster-generation   uint32)
   (receiving-generation uint32)
   (missing-since       time-frame)
   (battle-name         uint8 32)
   )
  )

(deftype mp-battle-spawn-record (structure)
  ((active?          symbol)
   (initial?         symbol)
   (epoch            uint32)
   (spawner-index    int32)
   (breed-index      int32)
   (enemy-aid        uint32)
   (seen-generation  uint32)
   (last-attempt     time-frame)
   (battle-name      uint8 32)
   )
  )

(define-extern mp-battle-dispatch-start! (function mp-battle-sync-record battle none))

(define-perm *mp-battle-records*
  (inline-array mp-battle-sync-record)
  (new 'static 'inline-array mp-battle-sync-record MP_MAX_BATTLE_RECORDS))
(define-perm *mp-battle-spawn-records*
  (inline-array mp-battle-spawn-record)
  (new 'static 'inline-array mp-battle-spawn-record MP_MAX_BATTLE_SPAWN_RECORDS))
(define-perm *mp-battle-name-scratch* string (new 'global 'string 32 ""))
(define-perm *mp-battle-last-session-status* int -1)
(define-perm *mp-battle-last-roster-request* time-frame (the-as time-frame 0))
(define-perm *mp-battle-sync-initialized?* symbol #f)

;; --- Battle name helpers ---

(defun mp-battle-copy-name-bytes! ((dst (pointer uint8)) (src string))
  (when (and dst (nonzero? dst) src (nonzero? src))
    (dotimes (idx 32)
      (set! (-> dst idx) (the-as uint8 0))
      )
    (let ((name-length (min 31 (length src))))
      (dotimes (idx name-length)
        (set! (-> dst idx) (-> src data idx))
        )
      )
    )
  (none)
  )

(defun mp-battle-copy-name-from-event! ((dst string) (evt mp-battle-event))
  (when (and dst (nonzero? dst) evt (nonzero? evt))
    (dotimes (idx 32)
      (set! (-> dst data idx) (-> evt battle-name idx))
      )
    (let ((name-length 0))
      (while (and (< name-length 31) (nonzero? (-> dst data name-length)))
        (1+! name-length)
        )
      (set! (-> dst data -4) (the-as uint name-length))
      )
    )
  (none)
  )

(defun mp-battle-copy-record-name! ((dst string) (src (pointer uint8)))
  (when (and dst (nonzero? dst) src (nonzero? src))
    (dotimes (idx 32)
      (set! (-> dst data idx) (-> src idx))
      )
    (let ((name-length 0))
      (while (and (< name-length 31) (nonzero? (-> dst data name-length)))
        (1+! name-length)
        )
      (set! (-> dst data -4) (the-as uint name-length))
      )
    )
  (none)
  )

(defun mp-battle-process-name ((proc process-tree))
  (clear *mp-battle-name-scratch*)
  (when (and proc (nonzero? proc))
    (let ((name-value (-> proc name)))
      (when (nonzero? name-value)
        (let ((raw-name (the-as basic name-value)))
          (cond
            ((type? raw-name string)
             (copy-string<-string *mp-battle-name-scratch* (the-as string raw-name))
             )
            ((type? raw-name symbol)
             (copy-string<-string *mp-battle-name-scratch* (symbol->string (the-as symbol raw-name)))
             )
            )
          )
        )
      )
    )
  *mp-battle-name-scratch*
  )

(defun mp-battle-name-bytes-match? ((name-bytes (pointer uint8)) (name string))
  (when (and name-bytes (nonzero? name-bytes) name (nonzero? name))
    (let ((name-length (min 31 (length name))))
      (dotimes (idx name-length)
        (when (!= (-> name-bytes idx) (-> name data idx))
          (return #f)
          )
        )
      (return (zero? (-> name-bytes name-length)))
      )
    )
  #f
  )

(defun mp-battle-name-present? ((name-bytes (pointer uint8)))
  (and name-bytes
       (nonzero? name-bytes)
       (nonzero? (-> name-bytes 0)))
  )

;; --- Registry lookup ---

(defun mp-battle-owner-role-valid? ((owner-role int))
  (and (>= owner-role 0) (<= owner-role 1))
  )

(defun mp-battle-record-allocated? ((record mp-battle-sync-record))
  (and record
       (nonzero? record)
       (mp-battle-name-present? (-> record battle-name)))
  )

(defun mp-battle-record-authoritative? ((record mp-battle-sync-record))
  (and (mp-battle-record-allocated? record)
       (= (-> record active?) #t)
       (mp-battle-owner-role-valid? (-> record owner-role))
       (> (-> record epoch) 0))
  )

(defun mp-battle-record-pending-claim? ((record mp-battle-sync-record))
  (and (mp-battle-record-allocated? record)
       (= (-> record active?) #t)
       (= (-> record claim-sent?) #t)
       (= (-> record owner-role) -1)
       (= (-> record pending-owner-role) 1))
  )

(defun mp-battle-find-record ((name string))
  (when (and name (nonzero? name) (> (length name) 0))
    (dotimes (idx MP_MAX_BATTLE_RECORDS)
      (let ((record (-> *mp-battle-records* idx)))
        (when (and (mp-battle-record-allocated? record)
                   (mp-battle-name-bytes-match? (-> record battle-name) name))
          (return record)
          )
        )
      )
    )
  (the-as mp-battle-sync-record #f)
  )

(defun mp-battle-clear-record! ((record mp-battle-sync-record))
  (when (and record (nonzero? record))
    (set! (-> record active?) #f)
    (set! (-> record claim-sent?) #f)
    (set! (-> record start-applied?) #f)
    (set! (-> record owner-role) -1)
    (set! (-> record pending-owner-role) -1)
    (set! (-> record epoch) (the uint32 0))
    (set! (-> record roster-generation) (the uint32 0))
    (set! (-> record receiving-generation) (the uint32 0))
    (set! (-> record missing-since) (the-as time-frame 0))
    (dotimes (idx 32)
      (set! (-> record battle-name idx) (the-as uint8 0))
      )
    )
  (none)
  )

(defun mp-battle-clear-spawn-record! ((spawn-record mp-battle-spawn-record))
  (when (and spawn-record (nonzero? spawn-record))
    (set! (-> spawn-record active?) #f)
    (set! (-> spawn-record initial?) #f)
    (set! (-> spawn-record epoch) (the uint32 0))
    (set! (-> spawn-record spawner-index) 0)
    (set! (-> spawn-record breed-index) 0)
    (set! (-> spawn-record enemy-aid) (the uint32 0))
    (set! (-> spawn-record seen-generation) (the uint32 0))
    (set! (-> spawn-record last-attempt) (the-as time-frame 0))
    (dotimes (idx 32)
      (set! (-> spawn-record battle-name idx) (the-as uint8 0))
      )
    )
  (none)
  )

(defun mp-battle-initialize-storage! ()
  (dotimes (idx MP_MAX_BATTLE_RECORDS)
    (mp-battle-clear-record! (-> *mp-battle-records* idx))
    )
  (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
    (mp-battle-clear-spawn-record! (-> *mp-battle-spawn-records* idx))
    )
  (set! *mp-battle-spawn-counter* (the uint 0))
  (set! *mp-battle-last-session-status* -1)
  (set! *mp-battle-last-roster-request* (the-as time-frame 0))
  (set! *mp-battle-sync-initialized?* #t)
  (none)
  )

(defun mp-battle-ensure-initialized! ()
  (when (!= *mp-battle-sync-initialized?* #t)
    (mp-battle-initialize-storage!)
    )
  (none)
  )

(defun mp-battle-get-free-record ()
  (dotimes (idx MP_MAX_BATTLE_RECORDS)
    (let ((record (-> *mp-battle-records* idx)))
      (when (zero? (-> record battle-name 0))
        (return record)
        )
      )
    )
  (the-as mp-battle-sync-record #f)
  )

(defun mp-battle-get-or-create-record! ((name string))
  (when (not (and name (nonzero? name) (> (length name) 0)))
    (return (the-as mp-battle-sync-record #f))
    )
  (let ((record (mp-battle-find-record name)))
    (when (not record)
      (set! record (mp-battle-get-free-record))
      (when (and record (nonzero? record))
        (mp-battle-clear-record! record)
        (mp-battle-copy-name-bytes! (-> record battle-name) name)
        )
      )
    record
    )
  )

(defun mp-battle-record-for-process ((battle-proc battle))
  (if (and battle-proc (nonzero? battle-proc))
      (mp-battle-find-record (mp-battle-process-name battle-proc))
      (the-as mp-battle-sync-record #f)
      )
  )

(defun mp-battle-process-for-record ((record mp-battle-sync-record))
  (when (mp-battle-record-allocated? record)
    (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> record battle-name))
    (let ((proc (process-by-name *mp-battle-name-scratch* *active-pool*)))
      (when (and proc (nonzero? proc) (type? proc battle))
        (return (the-as battle proc))
        )
      )
    )
  (the-as battle #f)
  )

;; --- Event queue helpers ---

(defun mp-battle-fill-event-name! ((evt mp-battle-event) (record mp-battle-sync-record))
  (when (and evt (nonzero? evt) record (nonzero? record))
    (dotimes (idx 32)
      (set! (-> evt battle-name idx) (-> record battle-name idx))
      )
    )
  (none)
  )

(defun mp-battle-record-event-sendable? ((record mp-battle-sync-record)
                                          (battle-evt uint))
  (if (= battle-evt MP_BATTLE_EVT_CLAIM)
      (mp-battle-record-pending-claim? record)
      (mp-battle-record-authoritative? record))
  )

(defun mp-battle-queue-record-event! ((record mp-battle-sync-record)
                                      (battle-evt uint)
                                      (spawner-index int)
                                      (breed-index int)
                                      (initial? symbol)
                                      (enemy-aid uint)
                                      (roster-generation uint))
  (when (and (mp-battle-record-event-sendable? record battle-evt)
             *multi-sync-enabled?*
             (= (pc-multi-get-status) 6))
    (let ((queue-index *mp-event-queue-write-ptr*))
      (let ((evt (the-as mp-battle-event (-> *mp-event-queue* queue-index))))
        (set! (-> evt etype) MP_EVENT_BATTLE_EVENT)
        (set! (-> evt battle-evt) battle-evt)
        (mp-battle-fill-event-name! evt record)
        (set! (-> evt spawner-index) (the-as uint32 spawner-index))
        (set! (-> evt breed-index) (the-as uint32 breed-index))
        (set! (-> evt initial?) (if initial? (the uint32 1) (the uint32 0)))
        (set! (-> evt enemy-aid) (the-as uint32 enemy-aid))
        (set! (-> evt owner-role)
              (if (= battle-evt MP_BATTLE_EVT_CLAIM)
                  (-> record pending-owner-role)
                  (-> record owner-role)))
        (set! (-> evt epoch) (-> record epoch))
        (set! (-> evt roster-generation) (the-as uint32 roster-generation))
        )
      (set! *mp-event-queue-write-ptr* (logand (+ queue-index 1) 31))
      )
    )
  (none)
  )

;; --- Ownership ---

(defun mp-battle-owner-role ((battle-proc battle))
  (let ((record (mp-battle-record-for-process battle-proc)))
    (if (mp-battle-record-authoritative? record)
        (the-as int (-> record owner-role))
        (the-as int -1)
        )
    )
  )

(defun mp-battle-epoch ((battle-proc battle))
  (let ((record (mp-battle-record-for-process battle-proc)))
    (if (mp-battle-record-authoritative? record)
        (the-as uint (-> record epoch))
        (the uint 0)
        )
    )
  )

(defun mp-battle-dynamic-aid-valid? ((enemy-aid uint))
  (and (>= enemy-aid #x60000000)
       (< enemy-aid #x70000000))
  )

(defun mp-battle-local-owner? ((battle-proc battle))
  (when (not *multi-sync-enabled?*)
    (return #t)
    )
  (when (and battle-proc
             (nonzero? battle-proc)
             *local-info*
             (nonzero? *local-info*))
    (return (= (mp-battle-owner-role battle-proc) (-> *local-info* role)))
    )
  #f
  )

(defun mp-battle-update-spawn-epochs! ((record mp-battle-sync-record))
  (when (and record (nonzero? record))
    (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> record battle-name))
    (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
      (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
        (when (and (nonzero? (-> spawn-record enemy-aid))
                   (mp-battle-name-bytes-match? (-> spawn-record battle-name) *mp-battle-name-scratch*))
          (set! (-> spawn-record epoch) (-> record epoch))
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-grant-owner! ((record mp-battle-sync-record) (owner-role int))
  (when (and record (nonzero? record))
    (set! (-> record active?) #t)
    (set! (-> record claim-sent?) #f)
    (set! (-> record owner-role) owner-role)
    (set! (-> record pending-owner-role) -1)
    (+! (-> record epoch) (the uint32 1))
    (when (zero? (-> record epoch))
      (set! (-> record epoch) (the uint32 1))
      )
    (set! (-> record missing-since) (the-as time-frame 0))
    (mp-battle-update-spawn-epochs! record)
    (mp-battle-queue-record-event! record MP_BATTLE_EVT_START 0 0 #f (the uint 0) (the uint 0))
    (debug-log *mp-debug-log?* "[MP-BattleSync] Granted battle owner=~D epoch=~D.~%"
            owner-role
            (-> record epoch))
    )
  (none)
  )

(defun mp-battle-handle-local-trigger! ((battle-proc battle))
  (mp-battle-ensure-initialized!)
  (when (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) 6))
    (return #t)
    )
  (when (not (and battle-proc
                  (nonzero? battle-proc)
                  *local-info*
                  (nonzero? *local-info*)))
    (return #f)
    )
  (let ((record (mp-battle-get-or-create-record! (mp-battle-process-name battle-proc)))
        (local-role (-> *local-info* role)))
    (when (not (and record (nonzero? record)))
      (return #f)
      )
    (when (mp-battle-record-authoritative? record)
      (return (= (-> record owner-role) local-role))
      )
    (if (= local-role 0)
        (begin
          (mp-battle-grant-owner! record 0)
          (set! (-> record start-applied?) #t)
          )
        (when (not (-> record claim-sent?))
          (set! (-> record active?) #t)
          (set! (-> record owner-role) -1)
          (set! (-> record pending-owner-role) 1)
          (set! (-> record claim-sent?) #t)
          (mp-battle-queue-record-event! record MP_BATTLE_EVT_CLAIM 0 0 #f (the uint 0) (the uint 0))
          (format
            0
            "[MP-BattleSync][CLAIM-WAIT] owner=~D epoch=~D local=~D dispatch=LOCAL~%"
            (-> record owner-role)
            (-> record epoch)
            local-role
            )
          )
        )
    (= (-> record owner-role) local-role)
    )
  )

;; --- Spawn registry ---

(defun mp-battle-spawn-record-active? ((spawn-record mp-battle-spawn-record))
  (and spawn-record
       (nonzero? spawn-record)
       (= (-> spawn-record active?) #t)
       (mp-battle-name-present? (-> spawn-record battle-name))
       (> (-> spawn-record epoch) 0)
       (mp-battle-dynamic-aid-valid? (the-as uint (-> spawn-record enemy-aid))))
  )

(defun mp-battle-spawn-record-matches? ((spawn-record mp-battle-spawn-record)
                                        (name string)
                                        (enemy-aid uint))
  (and spawn-record
       (nonzero? spawn-record)
       (= (-> spawn-record enemy-aid) (the-as uint32 enemy-aid))
       (mp-battle-name-bytes-match? (-> spawn-record battle-name) name)
       )
  )

(defun mp-battle-find-spawn-record ((name string) (enemy-aid uint))
  (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
    (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
      (when (mp-battle-spawn-record-matches? spawn-record name enemy-aid)
        (return spawn-record)
        )
      )
    )
  (the-as mp-battle-spawn-record #f)
  )

(defun mp-battle-find-spawn-by-aid ((enemy-aid uint))
  (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
    (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
      (when (= (-> spawn-record enemy-aid) (the-as uint32 enemy-aid))
        (return spawn-record)
        )
      )
    )
  (the-as mp-battle-spawn-record #f)
  )

(defun mp-battle-get-free-spawn-record ()
  (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
    (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
      (when (or (zero? (-> spawn-record enemy-aid))
                (not (mp-battle-spawn-record-active? spawn-record)))
        (return spawn-record)
        )
      )
    )
  (the-as mp-battle-spawn-record #f)
  )

(defun mp-battle-store-spawn! ((record mp-battle-sync-record)
                               (spawner-index int)
                               (breed-index int)
                               (initial? symbol)
                               (enemy-aid uint)
                               (seen-generation uint))
  (when (and (mp-battle-record-authoritative? record) (nonzero? enemy-aid))
    (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> record battle-name))
    (let ((spawn-record (mp-battle-find-spawn-record *mp-battle-name-scratch* enemy-aid)))
      (when (not spawn-record)
        (set! spawn-record (mp-battle-get-free-spawn-record))
        )
      (when (and spawn-record (nonzero? spawn-record))
        (set! (-> spawn-record active?) #t)
        (set! (-> spawn-record initial?) initial?)
        (set! (-> spawn-record epoch) (-> record epoch))
        (set! (-> spawn-record spawner-index) spawner-index)
        (set! (-> spawn-record breed-index) breed-index)
        (set! (-> spawn-record enemy-aid) (the-as uint32 enemy-aid))
        (set! (-> spawn-record seen-generation) (the-as uint32 seen-generation))
        (set! (-> spawn-record last-attempt) (the-as time-frame 0))
        (dotimes (idx 32)
          (set! (-> spawn-record battle-name idx) (-> record battle-name idx))
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-note-local-spawn! ((battle-proc battle)
                                    (spawner-index int)
                                    (breed-index int)
                                    (initial? symbol)
                                    (enemy-aid uint))
  (mp-battle-ensure-initialized!)
  (let ((record (mp-battle-record-for-process battle-proc)))
    (when (mp-battle-record-authoritative? record)
      (mp-battle-store-spawn! record spawner-index breed-index initial? enemy-aid (the uint 0))
      (mp-battle-queue-record-event! record
                                     MP_BATTLE_EVT_SPAWN
                                     spawner-index
                                     breed-index
                                     initial?
                                     enemy-aid
                                     (the uint 0))
      )
    )
  (none)
  )

(defun mp-battle-note-local-end! ((battle-proc battle))
  (mp-battle-ensure-initialized!)
  (let ((record (mp-battle-record-for-process battle-proc)))
    (when (and (mp-battle-record-authoritative? record)
               *local-info*
               (nonzero? *local-info*)
               (= (-> record owner-role) (-> *local-info* role)))
      (mp-battle-queue-record-event! record MP_BATTLE_EVT_END 0 0 #f (the uint 0) (the uint 0))
      (set! (-> record active?) #f)
      )
    )
  (none)
  )

(defun mp-battle-spawn-record-process ((spawn-record mp-battle-spawn-record))
  (when (and spawn-record (nonzero? spawn-record) (nonzero? (-> spawn-record enemy-aid)))
    (return (find-enemy-by-aid (the-as uint (-> spawn-record enemy-aid))))
    )
  (the-as enemy #f)
  )

(defun mp-battle-apply-latest-state! ((enemy-proc enemy))
  (when (and enemy-proc (nonzero? enemy-proc))
    (let ((remote-slot (mp-enemy-find-remote-slot (mp-get-enemy-aid enemy-proc))))
      (when (and remote-slot
                 (nonzero? remote-slot)
                 (mp-enemy-remote-slot-fresh? remote-slot))
        (mp-enemy-apply-state enemy-proc remote-slot)
        )
      )
    )
  (none)
  )

(defun mp-battle-remote-death-aid-index ((enemy-aid uint))
  (when (and *remote-info* (nonzero? *remote-info*))
    (let ((sync-aid-count (min 128 (the-as int (-> *remote-info* sync-aids-count)))))
      (dotimes (idx sync-aid-count)
        (when (= (-> *remote-info* sync-aids idx) (the-as uint32 enemy-aid))
          (return idx)
          )
        )
      )
    )
  -1
  )

(defun mp-battle-log-recovery-remote-state! ((spawn-record mp-battle-spawn-record))
  (when (and spawn-record (nonzero? spawn-record))
    (let ((enemy-aid (the-as uint (-> spawn-record enemy-aid))))
      (let ((remote-slot (mp-enemy-find-remote-slot enemy-aid))
            (death-aid-index (mp-battle-remote-death-aid-index enemy-aid)))
        (if (and remote-slot (nonzero? remote-slot))
            (begin
              (debug-log *mp-debug-log?*
                "[MP-BattleSync][RECOVER-DIAG][REMOTE] aid=~D slot=~A fresh=~A hp=~D state=~D owner=~D.~%"
                enemy-aid
                remote-slot
                (mp-enemy-remote-slot-fresh? remote-slot)
                (-> remote-slot hp)
                (-> remote-slot state)
                (-> remote-slot owner))
              (debug-log *mp-debug-log?*
                "[MP-BattleSync][RECOVER-DIAG][REMOTE] aid=~D aggro=~D updated=~D.~%"
                enemy-aid
                (-> remote-slot is-aggro)
                (-> remote-slot last-updated))
              )
            (debug-log *mp-debug-log?*
              "[MP-BattleSync][RECOVER-DIAG][REMOTE] aid=~D slot=#f.~%"
              enemy-aid)
            )
        (debug-log *mp-debug-log?*
          "[MP-BattleSync][RECOVER-DIAG][REMOTE] aid=~D sync-aids-index=~D sync-aids-count=~D.~%"
          enemy-aid
          death-aid-index
          (if (and *remote-info* (nonzero? *remote-info*))
              (min 128 (the-as int (-> *remote-info* sync-aids-count)))
              0))
        )
      )
    )
  (none)
  )

(defun mp-battle-log-recovery-enemy! ((enemy-aid uint)
                                      (creature-handle handle)
                                      (enemy-proc enemy))
  (when (and enemy-proc (nonzero? enemy-proc))
    (let ((state (-> enemy-proc state)))
      (debug-log *mp-debug-log?*
        "[MP-BattleSync][RECOVER-DIAG][LOCAL] expected-aid=~D handle=~D proc=~A observed-aid=~D nid=~D status=~A.~%"
        enemy-aid
        (the-as uint creature-handle)
        enemy-proc
        (mp-get-enemy-aid enemy-proc)
        (-> enemy-proc net-id)
        (-> enemy-proc status))
      (debug-log *mp-debug-log?*
        "[MP-BattleSync][RECOVER-DIAG][LOCAL] hp=~D state=~A.~%"
        (-> enemy-proc hit-points)
        (if (and state (nonzero? state)) (-> state name) #f))
      (debug-log *mp-debug-log?*
        "[MP-BattleSync][RECOVER-DIAG][LOCAL] inactive=~A death-start=~A synced-death=~A stop-syncing=~A mask=~D enemy-flags=~D.~%"
        (focus-test? enemy-proc inactive)
        (logtest? (-> enemy-proc enemy-flags) (enemy-flag death-start))
        (logtest? (-> enemy-proc enemy-flags) (enemy-flag mp-synced-death))
        (logtest? (-> enemy-proc enemy-flags) (enemy-flag stop-syncing))
        (-> enemy-proc mask)
        (-> enemy-proc enemy-flags))
      )
    )
  (none)
  )

(defun mp-battle-log-recovery-process! ((spawn-record mp-battle-spawn-record)
                                        (spawner battle-spawner))
  (when (and spawn-record (nonzero? spawn-record) spawner (nonzero? spawner))
    (let ((enemy-aid (the-as uint (-> spawn-record enemy-aid)))
          (creature-handle (-> spawner creature)))
      (if (zero? creature-handle)
          (debug-log *mp-debug-log?*
            "[MP-BattleSync][RECOVER-DIAG][LOCAL] aid=~D spawner-handle=#f reason=EMPTY-HANDLE.~%"
            enemy-aid)
          (let ((proc (handle->process creature-handle)))
            (cond
              ((not (and proc (nonzero? proc)))
               (debug-log *mp-debug-log?*
                 "[MP-BattleSync][RECOVER-DIAG][LOCAL] aid=~D spawner-handle=~D reason=STALE-HANDLE.~%"
                 enemy-aid
                 (the-as uint creature-handle))
               )
              ((not (type? proc enemy))
               (debug-log *mp-debug-log?*
                 "[MP-BattleSync][RECOVER-DIAG][LOCAL] aid=~D spawner-handle=~D proc=~A reason=WRONG-TYPE.~%"
                 enemy-aid
                 (the-as uint creature-handle)
                 proc)
               )
              (else
               (mp-battle-log-recovery-enemy!
                 enemy-aid creature-handle (the-as enemy proc))
               )
              )
            )
          )
      )
    )
  (none)
  )

(defun mp-battle-log-recovery-diagnostics! ((battle-proc battle)
                                            (spawn-record mp-battle-spawn-record))
  (when (and battle-proc
             (nonzero? battle-proc)
             spawn-record
             (nonzero? spawn-record))
    (let ((spawner (get-spawner-by-index battle-proc (-> spawn-record spawner-index))))
      (if (and spawner (nonzero? spawner))
          (mp-battle-log-recovery-process! spawn-record spawner)
          (debug-log *mp-debug-log?*
            "[MP-BattleSync][RECOVER-DIAG][LOCAL] aid=~D spawner=~D reason=MISSING-SPAWNER.~%"
            (-> spawn-record enemy-aid)
            (-> spawn-record spawner-index))
          )
      )
    (mp-battle-log-recovery-remote-state! spawn-record)
    )
  (none)
  )

(defun mp-battle-respawn-record! ((record mp-battle-sync-record)
                                  (spawn-record mp-battle-spawn-record)
                                  (battle-proc battle))
  (when (and record
             (nonzero? record)
             spawn-record
             (nonzero? spawn-record)
             battle-proc
             (nonzero? battle-proc)
             (not (logtest? (-> battle-proc flags) (battle-flags beaten))))
    (set! *mp-processing-remote-event* #t)
    (send-event battle-proc
                'mp-battle-spawn
                (-> spawn-record spawner-index)
                (-> spawn-record breed-index)
                (if (-> spawn-record initial?) 1 0)
                (the-as int (-> spawn-record enemy-aid)))
    (set! *mp-processing-remote-event* #f)
    (let ((enemy-proc (mp-battle-spawn-record-process spawn-record)))
      (when (and enemy-proc (nonzero? enemy-proc))
        (mp-battle-apply-latest-state! enemy-proc)
        (debug-log *mp-debug-log?* "[MP-BattleSync] Recovered aid=~D spawner=~D epoch=~D.~%"
                (-> spawn-record enemy-aid)
                (-> spawn-record spawner-index)
                (-> record epoch))
        )
      )
    )
  (none)
  )

(defun mp-battle-reconcile-spawn! ((spawn-record mp-battle-spawn-record))
  (when (mp-battle-spawn-record-active? spawn-record)
    (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> spawn-record battle-name))
    (let ((record (mp-battle-find-record *mp-battle-name-scratch*)))
      (when (and (mp-battle-record-authoritative? record)
                 (= (-> record epoch) (-> spawn-record epoch)))
        (let ((battle-proc (mp-battle-process-for-record record))
              (enemy-proc (mp-battle-spawn-record-process spawn-record)))
          (cond
            ((and enemy-proc (nonzero? enemy-proc))
             (mp-battle-apply-latest-state! enemy-proc)
             )
            ((and battle-proc
                  (nonzero? battle-proc)
                  (>= (- (current-time) (-> spawn-record last-attempt)) (seconds 1)))
             (set! (-> spawn-record last-attempt) (current-time))
             (mp-battle-log-recovery-diagnostics! battle-proc spawn-record)
             (mp-battle-respawn-record! record spawn-record battle-proc)
             )
            )
          )
        )
      )
    )
  (none)
  )

;; --- Death and roster reconciliation ---

(defun mp-battle-note-enemy-death! ((enemy-proc enemy))
  (mp-battle-ensure-initialized!)
  (when (and enemy-proc
             (nonzero? enemy-proc)
             (logtest? (-> enemy-proc enemy-flags) (enemy-flag mp-battle-enemy)))
    (let ((spawn-record (mp-battle-find-spawn-by-aid (mp-get-enemy-aid enemy-proc))))
      (when (mp-battle-spawn-record-active? spawn-record)
        (set! (-> spawn-record active?) #f)
        (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> spawn-record battle-name))
        (let ((record (mp-battle-find-record *mp-battle-name-scratch*)))
          (when (and (mp-battle-record-authoritative? record)
                     *local-info*
                     (nonzero? *local-info*)
                     (= (-> record owner-role) (-> *local-info* role)))
            (mp-battle-queue-record-event! record
                                           MP_BATTLE_EVT_DESPAWN
                                           (-> spawn-record spawner-index)
                                           (-> spawn-record breed-index)
                                           (-> spawn-record initial?)
                                           (the-as uint (-> spawn-record enemy-aid))
                                           (the uint 0))
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-send-roster! ((record mp-battle-sync-record))
  (when (mp-battle-record-authoritative? record)
    (+! (-> record roster-generation) (the uint32 1))
    (let ((generation (-> record roster-generation)))
      (mp-battle-queue-record-event! record MP_BATTLE_EVT_ROSTER_BEGIN 0 0 #f (the uint 0) generation)
      (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> record battle-name))
      (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
        (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
          (when (and (mp-battle-spawn-record-active? spawn-record)
                     (= (-> spawn-record epoch) (-> record epoch))
                     (mp-battle-name-bytes-match? (-> spawn-record battle-name) *mp-battle-name-scratch*))
            (mp-battle-queue-record-event! record
                                           MP_BATTLE_EVT_SPAWN
                                           (-> spawn-record spawner-index)
                                           (-> spawn-record breed-index)
                                           (-> spawn-record initial?)
                                           (the-as uint (-> spawn-record enemy-aid))
                                           generation)
            )
          )
        )
      (mp-battle-queue-record-event! record MP_BATTLE_EVT_ROSTER_END 0 0 #f (the uint 0) generation)
      )
    )
  (none)
  )

(defun mp-battle-retire-unseen-spawns! ((record mp-battle-sync-record) (generation uint))
  (when (mp-battle-record-authoritative? record)
    (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> record battle-name))
    (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
      (let ((spawn-record (-> *mp-battle-spawn-records* idx)))
        (when (and (mp-battle-spawn-record-active? spawn-record)
                   (= (-> spawn-record epoch) (-> record epoch))
                   (!= (-> spawn-record seen-generation) (the-as uint32 generation))
                   (mp-battle-name-bytes-match? (-> spawn-record battle-name) *mp-battle-name-scratch*))
          (set! (-> spawn-record active?) #f)
          (let ((enemy-proc (mp-battle-spawn-record-process spawn-record)))
            (when (and enemy-proc (nonzero? enemy-proc))
              (deactivate enemy-proc)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-request-rosters! ()
  (mp-battle-ensure-initialized!)
  (when (and (or (zero? *mp-battle-last-roster-request*)
                 (>= (- (current-time) *mp-battle-last-roster-request*) (seconds 1)))
             *local-info*
             (nonzero? *local-info*))
    (set! *mp-battle-last-roster-request* (current-time))
    (dotimes (idx MP_MAX_BATTLE_RECORDS)
      (let ((record (-> *mp-battle-records* idx)))
        (when (and (mp-battle-record-authoritative? record)
                   (!= (-> record owner-role) (-> *local-info* role)))
          (mp-battle-queue-record-event! record MP_BATTLE_EVT_ROSTER_REQUEST 0 0 #f (the uint 0) (the uint 0))
          )
        )
      )
    )
  (none)
  )

;; --- Receive dispatch ---

(defun mp-battle-lifecycle-event-type? ((battle-evt uint))
  (or (= battle-evt MP_BATTLE_EVT_START)
      (= battle-evt MP_BATTLE_EVT_END)
      (= battle-evt MP_BATTLE_EVT_SPAWN)
      (= battle-evt MP_BATTLE_EVT_DESPAWN)
      (= battle-evt MP_BATTLE_EVT_ROSTER_REQUEST)
      (= battle-evt MP_BATTLE_EVT_ROSTER_BEGIN)
      (= battle-evt MP_BATTLE_EVT_ROSTER_END)
      (= battle-evt MP_BATTLE_EVT_RELEASE))
  )

(defun mp-battle-inbound-event-valid? ((evt mp-battle-event) (name string))
  (when (and evt
             (nonzero? evt)
             name
             (nonzero? name)
             (> (length name) 0))
    (let ((battle-evt (the-as uint (-> evt battle-evt)))
          (owner-role (the-as int (-> evt owner-role))))
      (if (= battle-evt MP_BATTLE_EVT_CLAIM)
          (return (= owner-role 1))
          (when (and (mp-battle-lifecycle-event-type? battle-evt)
                     (mp-battle-owner-role-valid? owner-role)
                     (> (-> evt epoch) 0))
            (return #t)
            )
          )
      )
    )
  #f
  )

(defun mp-battle-accept-owner-event! ((record mp-battle-sync-record) (evt mp-battle-event))
  (when (and record (nonzero? record) evt (nonzero? evt))
    (when (and (> (-> evt epoch) 0)
               (>= (-> evt owner-role) 0)
               (<= (-> evt owner-role) 1)
               (>= (-> evt epoch) (-> record epoch)))
      (set! (-> record active?) #t)
      (set! (-> record claim-sent?) #f)
      (set! (-> record owner-role) (-> evt owner-role))
      (set! (-> record epoch) (-> evt epoch))
      (set! (-> record missing-since) (the-as time-frame 0))
      (return #t)
      )
    )
  #f
  )

(defun mp-battle-event-current? ((record mp-battle-sync-record) (evt mp-battle-event))
  (and (mp-battle-record-authoritative? record)
       evt
       (nonzero? evt)
       (= (-> evt epoch) (-> record epoch))
       (= (-> evt owner-role) (-> record owner-role))
       *local-info*
       (nonzero? *local-info*)
       (!= (-> record owner-role) (-> *local-info* role))
       )
  )

(defun mp-battle-handle-claim! ((record mp-battle-sync-record) (evt mp-battle-event))
  (when (and record
             (nonzero? record)
             evt
             (nonzero? evt)
             *local-info*
             (nonzero? *local-info*)
             (= (-> *local-info* role) 0)
             (= (-> evt owner-role) 1))
    (if (mp-battle-record-authoritative? record)
        (mp-battle-queue-record-event! record MP_BATTLE_EVT_START 0 0 #f (the uint 0) (the uint 0))
        (mp-battle-grant-owner! record (-> evt owner-role))
        )
    )
  (none)
  )

(defun mp-battle-handle-start! ((record mp-battle-sync-record)
                                (evt mp-battle-event))
  (when (and *local-info*
             (nonzero? *local-info*)
             (= (-> *local-info* role) 1)
             (mp-battle-accept-owner-event! record evt))
    (let ((battle-proc (mp-battle-process-for-record record)))
      (if (and battle-proc (nonzero? battle-proc))
          (begin
            (set! (-> record start-applied?) #t)
            (mp-battle-dispatch-start! record battle-proc)
            )
          (set! (-> record start-applied?) #f)
          )
      )
    )
  (none)
  )

(defun mp-battle-handle-spawn! ((record mp-battle-sync-record)
                                (evt mp-battle-event))
  (when (and record (nonzero? record) evt (nonzero? evt))
    (if (not (mp-battle-dynamic-aid-valid? (the-as uint (-> evt enemy-aid))))
        (debug-log *mp-debug-log?*
          "[MP-BattleSync] Rejecting invalid spawn aid=~D owner=~D epoch=~D.~%"
          (-> evt enemy-aid)
          (-> evt owner-role)
          (-> evt epoch))
        (when (mp-battle-event-current? record evt)
          (mp-battle-store-spawn! record
                                  (the-as int (-> evt spawner-index))
                                  (the-as int (-> evt breed-index))
                                  (nonzero? (-> evt initial?))
                                  (the-as uint (-> evt enemy-aid))
                                  (the-as uint (-> evt roster-generation)))
          (let ((spawn-record (mp-battle-find-spawn-record *mp-battle-name-scratch*
                                                           (the-as uint (-> evt enemy-aid)))))
            (when (and spawn-record (nonzero? spawn-record))
              (mp-battle-reconcile-spawn! spawn-record)
              )
            )
          )
        )
      )
  (none)
  )

(defun mp-battle-handle-despawn! ((record mp-battle-sync-record)
                                  (evt mp-battle-event))
  (when (mp-battle-event-current? record evt)
    (let ((spawn-record (mp-battle-find-spawn-record *mp-battle-name-scratch*
                                                     (the-as uint (-> evt enemy-aid)))))
      (when (and spawn-record (nonzero? spawn-record))
        (set! (-> spawn-record active?) #f)
        (let ((enemy-proc (mp-battle-spawn-record-process spawn-record)))
          (when (and enemy-proc (nonzero? enemy-proc))
            (deactivate enemy-proc)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-handle-end! ((record mp-battle-sync-record)
                              (evt mp-battle-event))
  (when (mp-battle-event-current? record evt)
    (set! (-> record active?) #f)
    (let ((battle-proc (mp-battle-process-for-record record)))
      (when (and battle-proc (nonzero? battle-proc))
        (send-event battle-proc 'mp-battle-end)
        )
      )
    )
  (none)
  )

(defun mp-battle-handle-roster-event! ((record mp-battle-sync-record)
                                       (evt mp-battle-event))
  (when (mp-battle-event-current? record evt)
    (case (-> evt battle-evt)
      ((MP_BATTLE_EVT_ROSTER_BEGIN)
       (set! (-> record receiving-generation) (-> evt roster-generation))
       )
      ((MP_BATTLE_EVT_ROSTER_END)
       (when (= (-> record receiving-generation) (-> evt roster-generation))
         (mp-battle-retire-unseen-spawns! record (the-as uint (-> evt roster-generation)))
         (set! (-> record receiving-generation) (the uint32 0))
         )
       )
      )
    )
  (none)
  )

(defun mp-battle-handle-release! ((record mp-battle-sync-record)
                                  (evt mp-battle-event))
  (when (and (mp-battle-event-current? record evt)
             *local-info*
             (nonzero? *local-info*))
    (if (= (-> *local-info* role) 0)
        (mp-battle-grant-owner! record 0)
        (set! (-> record active?) #f)
        )
    )
  (none)
  )

(defun mp-battle-receive-event! ((evt mp-battle-event) (name string))
  (mp-battle-ensure-initialized!)
  (when (mp-battle-inbound-event-valid? evt name)
    (let ((record (mp-battle-get-or-create-record! name)))
      (when (and record (nonzero? record))
        (copy-string<-string *mp-battle-name-scratch* name)
        (case (-> evt battle-evt)
          ((MP_BATTLE_EVT_CLAIM)
           (mp-battle-handle-claim! record evt)
           )
          ((MP_BATTLE_EVT_START)
           (mp-battle-handle-start! record evt)
           )
          ((MP_BATTLE_EVT_END)
           (mp-battle-handle-end! record evt)
           )
          ((MP_BATTLE_EVT_SPAWN)
           (mp-battle-handle-spawn! record evt)
           )
          ((MP_BATTLE_EVT_DESPAWN)
           (mp-battle-handle-despawn! record evt)
           )
          ((MP_BATTLE_EVT_ROSTER_REQUEST)
           (when (and (mp-battle-record-authoritative? record)
                      (= (-> evt epoch) (-> record epoch))
                      (= (-> evt owner-role) (-> record owner-role))
                      *local-info*
                      (nonzero? *local-info*)
                      (= (-> record owner-role) (-> *local-info* role)))
             (mp-battle-send-roster! record)
             )
           )
          ((MP_BATTLE_EVT_ROSTER_BEGIN MP_BATTLE_EVT_ROSTER_END)
           (mp-battle-handle-roster-event! record evt)
           )
          ((MP_BATTLE_EVT_RELEASE)
           (mp-battle-handle-release! record evt)
           )
          )
        )
      )
    )
  (none)
  )

;; --- Enemy ownership and periodic maintenance ---

(defun mp-battle-dispatch-start! ((record mp-battle-sync-record)
                                  (battle-proc battle))
  (when (and (mp-battle-record-authoritative? record)
             battle-proc
             (nonzero? battle-proc)
             *local-info*
             (nonzero? *local-info*))
    (let ((previous-remote-event? *mp-processing-remote-event*)
          (local-role (-> *local-info* role)))
      (let ((local-owner? (= (-> record owner-role) local-role)))
        (debug-log *mp-debug-log?*
          "[MP-BattleSync] START owner=~D epoch=~D local=~D dispatch=~A previous-remote=~A.~%"
          (-> record owner-role)
          (-> record epoch)
          local-role
          (if local-owner? "OWNER" "REPLICA")
          previous-remote-event?)
        (set! *mp-processing-remote-event* (not local-owner?))
        (send-event battle-proc 'mp-battle-start)
        (set! *mp-processing-remote-event* previous-remote-event?)
        )
      )
    )
  (none)
  )

(defun mp-battle-enemy-owner-role ((enemy-proc enemy))
  (when (and enemy-proc
             (nonzero? enemy-proc)
             (logtest? (-> enemy-proc enemy-flags) (enemy-flag mp-battle-enemy)))
    (let ((spawn-record (mp-battle-find-spawn-by-aid (mp-get-enemy-aid enemy-proc))))
      (when (and spawn-record (nonzero? spawn-record))
        (mp-battle-copy-record-name! *mp-battle-name-scratch* (-> spawn-record battle-name))
        (let ((record (mp-battle-find-record *mp-battle-name-scratch*)))
          (when (mp-battle-record-authoritative? record)
            (return (the-as int (-> record owner-role)))
            )
          )
        )
      )
    )
  (the-as int -1)
  )

(defun mp-battle-apply-pending-start! ((record mp-battle-sync-record))
  (when (and (mp-battle-record-authoritative? record)
             (not (-> record start-applied?)))
    (let ((battle-proc (mp-battle-process-for-record record)))
      (when (and battle-proc (nonzero? battle-proc))
        (set! (-> record start-applied?) #t)
        (mp-battle-dispatch-start! record battle-proc)
        )
      )
    )
  (none)
  )

(defun mp-battle-note-missing-owner-process! ((record mp-battle-sync-record))
  (when (and (mp-battle-record-authoritative? record)
             *local-info*
             (nonzero? *local-info*)
             (= (-> record start-applied?) #t)
             (= (-> record owner-role) (-> *local-info* role)))
    (let ((battle-proc (mp-battle-process-for-record record)))
      (if (and battle-proc (nonzero? battle-proc))
          (set! (-> record missing-since) (the-as time-frame 0))
          (if (zero? (-> record missing-since))
              (set! (-> record missing-since) (current-time))
              (when (and (>= (- (current-time) (-> record missing-since)) (seconds 2))
                         (= (pc-multi-get-status) 6))
                (mp-battle-queue-record-event! record MP_BATTLE_EVT_RELEASE 0 0 #f (the uint 0) (the uint 0))
                (set! (-> record active?) #f)
                (set! (-> record start-applied?) #f)
                (set! (-> record missing-since) (the-as time-frame 0))
                )
              )
          )
      )
    )
  (none)
  )

(defun mp-battle-host-adopt-disconnected-client! ((status int))
  (when (and (= status 7)
             *local-info*
             (nonzero? *local-info*)
             (= (-> *local-info* role) 0))
    (dotimes (idx MP_MAX_BATTLE_RECORDS)
      (let ((record (-> *mp-battle-records* idx)))
        (when (and (mp-battle-record-authoritative? record)
                   (= (-> record owner-role) 1))
          (mp-battle-grant-owner! record 0)
          )
        )
      )
    )
  (none)
  )

(defun mp-battle-sync-tick ((status int))
  (mp-battle-ensure-initialized!)
  (when (and (= status 6) (!= *mp-battle-last-session-status* 6))
    (mp-battle-request-rosters!)
    )
  (mp-battle-host-adopt-disconnected-client! status)
  (set! *mp-battle-last-session-status* status)
  (dotimes (idx MP_MAX_BATTLE_RECORDS)
    (let ((record (-> *mp-battle-records* idx)))
      (when (mp-battle-record-authoritative? record)
        (mp-battle-apply-pending-start! record)
        (mp-battle-note-missing-owner-process! record)
        )
      )
    )
  (dotimes (idx MP_MAX_BATTLE_SPAWN_RECORDS)
    (mp-battle-reconcile-spawn! (-> *mp-battle-spawn-records* idx))
    )
  (none)
  )

(defun mp-reset-battle-sync-state! ()
  (mp-battle-initialize-storage!)
  (none)
  )
