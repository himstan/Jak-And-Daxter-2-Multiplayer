(in-package goal)

(define-extern mp-widow-go-state! (function widow uint none))
(define-extern mp-widow-bomb-process-queue (function widow none))
(define-extern mp-widow-bomb-process-kick-events (function widow none))
(define-extern mp-widow-bomb-process-fizzle-events (function widow none))
(define-extern find-widow-proc (function widow))
(define-extern mp-widow-replay-catwalk-hit! (function widow int none))

(defun mp-widow-current-state-name ((proc widow))
  (when (and proc (nonzero? proc))
    (let ((next-state (-> proc next-state))
          (current-state (-> proc state)))
      (when (and next-state (nonzero? next-state))
        (return (-> next-state name)))
      (when (and current-state (nonzero? current-state))
        (return (-> current-state name)))
      )
    )
  #f
  )

(defun mp-widow-state->id ((state-name symbol))
  (case state-name
    (('beaten)                    (the uint (mp-widow-state-id beaten)))
    (('kaboom)                    (the uint (mp-widow-state-id kaboom)))
    (('hover-low-stage-3)         (the uint (mp-widow-state-id hover-low-stage-3)))
    (('hover-shooting-stage-3)    (the uint (mp-widow-state-id hover-shooting-stage-3)))
    (('hover-launch-bombs-stage-3) (the uint (mp-widow-state-id hover-launch-bombs-stage-3)))
    (('hover-big-blast-stage-3)   (the uint (mp-widow-state-id hover-big-blast-stage-3)))
    (('hover-rise-stage-3)         (the uint (mp-widow-state-id hover-rise-stage-3)))
    (('hover-seek-under-stage-3)   (the uint (mp-widow-state-id hover-seek-under-stage-3)))
    (('hover-jump-down-stage-3)    (the uint (mp-widow-state-id hover-jump-down-stage-3)))
    (('big-reaction-stage-2)       (the uint (mp-widow-state-id big-reaction-stage-2)))
    (('watch-bombs-stage-2)        (the uint (mp-widow-state-id watch-bombs-stage-2)))
    (('launch-bombs-stage-2)       (the uint (mp-widow-state-id launch-bombs-stage-2)))
    (('back-to-perch-stage-2)      (the uint (mp-widow-state-id back-to-perch-stage-2)))
    (('hover-low-stage-2)          (the uint (mp-widow-state-id hover-low-stage-2)))
    (('hover-shooting-stage-2)     (the uint (mp-widow-state-id hover-shooting-stage-2)))
    (('hover-rise-stage-2)         (the uint (mp-widow-state-id hover-rise-stage-2)))
    (('hover-seek-under-stage-2)   (the uint (mp-widow-state-id hover-seek-under-stage-2)))
    (('hover-jump-down-stage-2)    (the uint (mp-widow-state-id hover-jump-down-stage-2)))
    (('launch-droids-stage-2)      (the uint (mp-widow-state-id launch-droids-stage-2)))
    (('big-reaction-stage-1)       (the uint (mp-widow-state-id big-reaction-stage-1)))
    (('watch-bombs-stage-1)        (the uint (mp-widow-state-id watch-bombs-stage-1)))
    (('launch-bombs-stage-1)       (the uint (mp-widow-state-id launch-bombs-stage-1)))
    (('watch-droids-stage-1)       (the uint (mp-widow-state-id watch-droids-stage-1)))
    (('launch-droids-stage-1)      (the uint (mp-widow-state-id launch-droids-stage-1)))
    (('hidden)                     (the uint (mp-widow-state-id hidden)))
    (else                          (the uint (mp-widow-state-id none)))
    )
  )

(defun mp-widow-state-id->name ((state-id uint))
  (case (the-as mp-widow-state-id (the int state-id))
    (((mp-widow-state-id beaten))                    'beaten)
    (((mp-widow-state-id kaboom))                    'kaboom)
    (((mp-widow-state-id hover-low-stage-3))         'hover-low-stage-3)
    (((mp-widow-state-id hover-shooting-stage-3))    'hover-shooting-stage-3)
    (((mp-widow-state-id hover-launch-bombs-stage-3)) 'hover-launch-bombs-stage-3)
    (((mp-widow-state-id hover-big-blast-stage-3))   'hover-big-blast-stage-3)
    (((mp-widow-state-id hover-rise-stage-3))        'hover-rise-stage-3)
    (((mp-widow-state-id hover-seek-under-stage-3))  'hover-seek-under-stage-3)
    (((mp-widow-state-id hover-jump-down-stage-3))   'hover-jump-down-stage-3)
    (((mp-widow-state-id big-reaction-stage-2))      'big-reaction-stage-2)
    (((mp-widow-state-id watch-bombs-stage-2))       'watch-bombs-stage-2)
    (((mp-widow-state-id launch-bombs-stage-2))      'launch-bombs-stage-2)
    (((mp-widow-state-id back-to-perch-stage-2))     'back-to-perch-stage-2)
    (((mp-widow-state-id hover-low-stage-2))         'hover-low-stage-2)
    (((mp-widow-state-id hover-shooting-stage-2))    'hover-shooting-stage-2)
    (((mp-widow-state-id hover-rise-stage-2))        'hover-rise-stage-2)
    (((mp-widow-state-id hover-seek-under-stage-2))  'hover-seek-under-stage-2)
    (((mp-widow-state-id hover-jump-down-stage-2))   'hover-jump-down-stage-2)
    (((mp-widow-state-id launch-droids-stage-2))     'launch-droids-stage-2)
    (((mp-widow-state-id big-reaction-stage-1))      'big-reaction-stage-1)
    (((mp-widow-state-id watch-bombs-stage-1))       'watch-bombs-stage-1)
    (((mp-widow-state-id launch-bombs-stage-1))      'launch-bombs-stage-1)
    (((mp-widow-state-id watch-droids-stage-1))      'watch-droids-stage-1)
    (((mp-widow-state-id launch-droids-stage-1))     'launch-droids-stage-1)
    (((mp-widow-state-id hidden))                    'hidden)
    (else                                            'none)
    )
  )

(defun mp-widow-pack-state! ((proc widow) (slot mp-widow-state))
  (when (and proc (nonzero? proc)
             slot (nonzero? slot)
             (-> proc root) (nonzero? (-> proc root)))
    (set! (-> slot active) (the uint32 1))
    (set! (-> slot state-id)
          (mp-widow-state->id (mp-widow-current-state-name proc)))
    (set! (-> slot x) (-> proc root trans x))
    (set! (-> slot y) (-> proc root trans y))
    (set! (-> slot z) (-> proc root trans z))
    (set! (-> slot last-updated) (the-as uint32 (current-time)))
    (set! (-> slot quat-x) (-> proc root quat x))
    (set! (-> slot quat-y) (-> proc root quat y))
    (set! (-> slot quat-z) (-> proc root quat z))
    (set! (-> slot quat-w) (-> proc root quat w))
    )
  (none)
  )

(defun mp-widow-apply-state! ((proc widow) (slot mp-widow-state))
  (when (and proc (nonzero? proc)
             slot (nonzero? slot)
             (nonzero? (-> slot active))
             (-> proc root) (nonzero? (-> proc root)))
    (set! (-> proc root trans x) (-> slot x))
    (set! (-> proc root trans y) (-> slot y))
    (set! (-> proc root trans z) (-> slot z))
    (quaternion-set! (-> proc root quat)
                     (-> slot quat-x)
                     (-> slot quat-y)
                     (-> slot quat-z)
                     (-> slot quat-w))
    (when (!= *mp-widow-last-applied-state-id* (-> slot state-id))
      (set! *mp-widow-last-applied-state-id* (-> slot state-id))
      (mp-widow-go-state! proc (-> slot state-id))
      )
    )
  (none)
  )

(defun mp-widow-sync-tick ((proc widow))
  (when (and proc (nonzero? proc)
             *mp-widow-buffer*
             (nonzero? (the-as uint *mp-widow-buffer*))
             *multi-sync-enabled?*
             (= (pc-multi-get-status) 6))
    (if (mp-is-jak?)
        (begin
          (mp-widow-pack-state! proc (-> *mp-widow-buffer* local-state))
          (mp-widow-bomb-process-kick-events proc)
          (pc-multi-send-widow (the-as uint *mp-widow-buffer*))
          )
        (begin
          (pc-multi-receive-widow (the-as uint *mp-widow-buffer*))
          (mp-widow-bomb-process-queue proc)
          (mp-widow-bomb-process-fizzle-events proc)
          (mp-widow-bomb-process-kick-events proc)
          (mp-widow-apply-state! proc (-> *mp-widow-buffer* remote-state))
          )
        )
    )
  (none)
  )

(defun mp-widow-spydroid-send-event ((spydroid-aid uint)
                                     (launch-slot int)
                                     (spawn-trans vector)
                                     (spawn-quat quaternion)
                                     (launch-dest vector))
  (when (and (mp-is-jak?)
             *multi-sync-enabled?*
             (= (pc-multi-get-status) 6)
             (not *mp-processing-remote-event*)
             (> spydroid-aid 0))
    (let ((q-idx *mp-event-queue-write-ptr*))
        (let ((evt (the-as mp-widow-spydroid-event (-> *mp-event-queue* q-idx))))
        (set! (-> evt etype) MP_EVENT_WIDOW_SPYDROID)
        (set! (-> evt spydroid-aid) (the-as uint32 spydroid-aid))
        (set! (-> evt launch-slot) (the-as int32 launch-slot))
        (set! (-> evt spawn-trans quad) (-> spawn-trans quad))
        (set! (-> evt spawn-quat quad) (-> spawn-quat quad))
        (set! (-> evt launch-dest quad) (-> launch-dest quad))
        (debug-log *mp-debug-log?*
                   "[MP-Widow][HOST] launch aid=~D slot=~D trans=(~F,~F,~F) floor=~F~%"
                   spydroid-aid launch-slot
                   (-> spawn-trans x) (-> spawn-trans y) (-> spawn-trans z)
                   (-> launch-dest y))
        )
      (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
      )
    )
  (none)
  )

(defun mp-widow-bomb-send-event ((launch-slot int) (launch-dest vector))
  (when (and (mp-is-jak?)
             *multi-sync-enabled?*
             (= (pc-multi-get-status) 6)
             (not *mp-processing-remote-event*)
             (>= launch-slot 0)
             (< launch-slot 8))
    (let ((q-idx *mp-event-queue-write-ptr*))
      (let ((evt (the-as mp-widow-bomb-event (-> *mp-event-queue* q-idx))))
        (set! (-> evt etype) MP_EVENT_WIDOW_BOMB)
        (set! (-> evt launch-slot) (the-as int32 launch-slot))
        (set! (-> evt launch-dest quad) (-> launch-dest quad))
        (debug-log *mp-debug-log?* "[MP-Widow][HOST] bomb launch slot=~D dest=(~F,~F,~F)~%"
                   launch-slot
                   (-> launch-dest x)
                   (-> launch-dest y)
                   (-> launch-dest z))
        )
      (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
      )
    )
  (none)
  )

(defun mp-widow-bomb-hit-send-event ((hit-amount int) (hit-position vector))
  (when (and *multi-sync-enabled?*
             (= (pc-multi-get-status) 6)
             (not *mp-processing-remote-event*)
             hit-position
             (nonzero? hit-position)
             (or (= hit-amount 1) (= hit-amount 4)))
    (let ((q-idx *mp-event-queue-write-ptr*))
      (let ((event (the-as mp-widow-bomb-hit-event
                           (-> *mp-event-queue* q-idx))))
        (set! (-> event etype) MP_EVENT_WIDOW_BOMB_HIT)
        (set! (-> event amount) (the-as int32 hit-amount))
        (set! (-> event hit-position quad) (-> hit-position quad))
        )
      (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
      )
    )
  (none)
  )

(defun mp-widow-catwalk-hit-send-event ((catwalk-index int))
  (when (and *multi-sync-enabled?*
             (= (pc-multi-get-status) 6)
             (mp-is-jak?)
             (not *mp-processing-remote-event*)
             (>= catwalk-index 1)
             (<= catwalk-index 7))
    (let ((q-idx *mp-event-queue-write-ptr*))
      (let ((event (the-as mp-widow-catwalk-hit-event
                           (-> *mp-event-queue* q-idx))))
        (set! (-> event etype) MP_EVENT_WIDOW_CATWALK_HIT)
        (set! (-> event catwalk-index) (the-as int32 catwalk-index))
        )
      (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
      )
    )
  (none)
  )

(define-extern mp-widow-spydroid-queue! (function widow mp-widow-spydroid-event none))
(define-extern mp-widow-bomb-queue! (function widow mp-widow-bomb-event none))

(defun mp-widow-spydroid-process ((evt mp-widow-spydroid-event))
  (when (and evt (nonzero? evt))
    (debug-log *mp-debug-log?* "[MP-Widow][REMOTE] received aid=~D~%"
               (-> evt spydroid-aid))
    (let ((widow-proc (find-widow-proc)))
      (when (and widow-proc
                 (nonzero? widow-proc)
                 (type? widow-proc widow))
        (mp-widow-spydroid-queue! (the-as widow widow-proc) evt)
        )
      )
    )
  (none)
  )

(defun mp-receive-widow-spydroid-event ((evt mp-widow-spydroid-event))
  (mp-widow-spydroid-process evt)
  (none)
  )

(defun mp-widow-bomb-process ((evt mp-widow-bomb-event))
  (when (and evt (nonzero? evt))
    (debug-log *mp-debug-log?* "[MP-Widow][REMOTE] received bomb slot=~D~%"
               (-> evt launch-slot))
    (let ((widow-proc (find-widow-proc)))
      (when (and widow-proc
                 (nonzero? widow-proc)
                 (type? widow-proc widow))
        (mp-widow-bomb-queue! (the-as widow widow-proc) evt)
        )
      )
    )
  (none)
  )

(defun mp-receive-widow-bomb-event ((evt mp-widow-bomb-event))
  (mp-widow-bomb-process evt)
  (none)
  )

(defun mp-receive-widow-bomb-hit-event ((evt mp-widow-bomb-hit-event))
  (when (and evt (nonzero? evt))
    (let ((widow-proc (find-widow-proc)))
      (when (and widow-proc (nonzero? widow-proc))
        (send-event widow-proc 'bomb-hit (-> evt hit-position) (-> evt amount) 'mp-replica)
        )
      )
    )
  (none)
  )

(defun mp-receive-widow-catwalk-hit-event ((evt mp-widow-catwalk-hit-event))
  (when (and evt (nonzero? evt))
    (let ((catwalk-index (-> evt catwalk-index)))
      (when (and (>= catwalk-index 1) (<= catwalk-index 7))
        (let ((widow-proc (find-widow-proc)))
          (when (and widow-proc (nonzero? widow-proc))
            (let ((old-remote-context *mp-processing-remote-event*))
              (set! *mp-processing-remote-event* #t)
              (mp-widow-replay-catwalk-hit! widow-proc catwalk-index)
              (set! *mp-processing-remote-event* old-remote-context)
              )
            )
          )
        )
      )
    )
  (none)
  )
