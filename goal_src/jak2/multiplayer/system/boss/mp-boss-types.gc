(in-package goal)

(defenum boss-kind
  :type uint8
  (none 0)
  (palace-squid 1)
  (widow 2)
  (metalkor 3))

(define *palace-squid-boss-states*
  '(hidden
    idle
    fire
    fire-grenades
    fire-whirlwind
    headbut
    fly-to-shoot-spot
    fly-to-post
    recharge
    pre-flee
    flee
    wait-beside-building
    wait-around-corner
    beaten
    test))

(define *widow-boss-states*
  '(beaten
    kaboom
    hover-low-stage-3
    hover-shooting-stage-3
    hover-launch-bombs-stage-3
    hover-big-blast-stage-3
    hover-rise-stage-3
    hover-seek-under-stage-3
    hover-jump-down-stage-3
    big-reaction-stage-2
    watch-bombs-stage-2
    launch-bombs-stage-2
    back-to-perch-stage-2
    hover-low-stage-2
    hover-shooting-stage-2
    hover-rise-stage-2
    hover-seek-under-stage-2
    hover-jump-down-stage-2
    launch-droids-stage-2
    big-reaction-stage-1
    watch-bombs-stage-1
    launch-bombs-stage-1
    watch-droids-stage-1
    launch-droids-stage-1
    hidden))

(define *metalkor-boss-states*
  '(chase-target
    get-close
    standing-shot
    tail-attack
    foot-attack
    fall-down
    overload-recover))

(define-extern mp-palace-squid-tick (function squid none))
(define-extern mp-palace-squid-target-pos! (function squid vector vector))
(define-extern mp-palace-squid-local-action-authorized? (function squid symbol))
(define-extern mp-palace-squid-note-grenade-spawn! (function squid int int float squid-grenade-holder none))
(define-extern mp-palace-squid-note-whirlwind-spawn! (function squid none))
(define-extern mp-palace-squid-note-resolution! (function squid none))
(define-extern mp-palace-squid-start-shooting-local! (function none :behavior squid))
(define-extern mp-widow-sync-tick (function widow none))
