(in-package goal)

(defenum mp-palace-squid-state-id
  (uint32)
  (none 0)
  (hidden 1)
  (idle 2)
  (fire 3)
  (fire-grenades 4)
  (fire-whirlwind 5)
  (headbut 6)
  (fly-to-shoot-spot 7)
  (fly-to-post 8)
  (recharge 9)
  (pre-flee 10)
  (flee 11)
  (wait-beside-building 12)
  (wait-around-corner 13)
  (beaten 14)
  (test 15))

(deftype mp-palace-squid-state (structure)
  ((active            uint32)
   (state-id          uint32)
   (stage             int32)
   (hit-points        int32)
   (shield-hit-points float)
   (target-player-id  int32)
   (draw-force-fade   uint32)
   (action-seq        uint32)
   (x                 float)
   (y                 float)
   (z                 float)
   (quat-x            float)
   (quat-y            float)
   (quat-z            float)
   (quat-w            float)
   (root-x            float)
   (root-y            float)
   (root-z            float)
   (root-quat-x       float)
   (root-quat-y       float)
   (root-quat-z       float)
   (root-quat-w       float)
   (traj-src-x        float)
   (traj-src-y        float)
   (traj-src-z        float)
   (traj-dest-x       float)
   (traj-dest-y       float)
   (traj-dest-z       float)
   (traj-duration     float)
   (traj-age          int32)
   (generation        uint64))
  :size-assert 128)

(deftype mp-palace-squid-sync-buffer (structure)
  ((local-state  mp-palace-squid-state :inline)
   (remote-state mp-palace-squid-state :inline)
   (generation   uint64))
  :size-assert 264)

(defenum mp-widow-state-id
  (uint32)
  (none 0)
  (beaten 1)
  (kaboom 2)
  (hover-low-stage-3 3)
  (hover-shooting-stage-3 4)
  (hover-launch-bombs-stage-3 5)
  (hover-big-blast-stage-3 6)
  (hover-rise-stage-3 7)
  (hover-seek-under-stage-3 8)
  (hover-jump-down-stage-3 9)
  (big-reaction-stage-2 10)
  (watch-bombs-stage-2 11)
  (launch-bombs-stage-2 12)
  (back-to-perch-stage-2 13)
  (hover-low-stage-2 14)
  (hover-shooting-stage-2 15)
  (hover-rise-stage-2 16)
  (hover-seek-under-stage-2 17)
  (hover-jump-down-stage-2 18)
  (launch-droids-stage-2 19)
  (big-reaction-stage-1 20)
  (watch-bombs-stage-1 21)
  (launch-bombs-stage-1 22)
  (watch-droids-stage-1 23)
  (launch-droids-stage-1 24)
  (hidden 25))

(deftype mp-widow-state (structure)
  ((active     uint32)
   (state-id   uint32)
   (x          float)
   (y          float)
   (z          float)
   (generation uint32)
   (quat-x     float)
   (quat-y     float)
   (quat-z     float)
   (quat-w     float))
  :size-assert 40)

(deftype mp-widow-sync-buffer (structure)
  ((local-state  mp-widow-state :inline)
   (remote-state mp-widow-state :inline)
   (generation   uint64))
  :size-assert 96)

(define-perm *mp-palace-squid-buffer* mp-palace-squid-sync-buffer (new 'static 'mp-palace-squid-sync-buffer))
(define-perm *mp-widow-buffer* mp-widow-sync-buffer (new 'static 'mp-widow-sync-buffer))
(define-perm *mp-widow-last-applied-state-id* uint (the uint 0))

(define-extern mp-palace-squid-tick (function squid none))
(define-extern mp-palace-squid-target-pos! (function squid vector vector))
(define-extern mp-palace-squid-local-action-authorized? (function squid symbol))
(define-extern mp-palace-squid-note-grenade-spawn! (function squid int int float squid-grenade-holder none))
(define-extern mp-palace-squid-note-whirlwind-spawn! (function squid none))
(define-extern mp-palace-squid-note-resolution! (function squid none))
(define-extern mp-palace-squid-start-shooting-local! (function none :behavior squid))
(define-extern mp-widow-sync-tick (function widow none))
(define-extern mp-widow-state-id->name (function uint symbol))
