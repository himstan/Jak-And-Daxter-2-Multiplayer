;;-*-Lisp-*-
(in-package goal)

(defconstant PALACE_SQUID_MAX_HIT_POINTS 10.0)

(define *mp-palace-squid-target-player-slot* (the-as int MP_INVALID_PLAYER_SLOT))

(defun mp-palace-squid-state-authority? ()
  (or (not (mp-session-in-game?)) (mp-session-host?)))

(defun mp-palace-squid-local-player-valid? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       (not (logtest? (-> *target* focus-status) (focus-status dead)))))

(defun mp-palace-squid-remote-player-valid? ((record mp-player-record))
  (let ((remote (mp-player-record-target record)))
    (if (and remote
             (nonzero? remote)
             (-> remote root)
             (nonzero? (-> remote root))
             (not (logtest? (-> remote mask) (process-mask sleep))))
      #t
      #f)))

(defun mp-palace-squid-target-pos! ((proc squid) (out vector))
  (let ((remote-record (if (and (-> proc root) (nonzero? (-> proc root)))
                         (mp-nearest-remote-player-record-to-position (-> proc root trans) #t)
                         (the-as mp-player-record #f)))
        (remote (the-as target #f))
        (local-ok? (mp-palace-squid-local-player-valid?))
        (remote-ok? #f))
    (when (and remote-record (nonzero? remote-record))
      (set! remote (mp-player-record-target remote-record))
      (set! remote-ok? (mp-palace-squid-remote-player-valid? remote-record)))
    (cond
      ((and (mp-session-host?) local-ok? remote-ok?)
       (let ((local-dist (vector-vector-distance-squared (-> proc root trans) (-> *target* control trans)))
             (remote-dist (vector-vector-distance-squared (-> proc root trans) (-> remote root trans))))
         (if (< remote-dist local-dist)
           (begin
             (set! *mp-palace-squid-target-player-slot* (the-as int (-> remote-record identity player-slot)))
             (vector-copy! out (-> remote root trans)))
           (begin
             (set! *mp-palace-squid-target-player-slot* (the-as int (mp-local-player-slot)))
             (set! (-> out quad) (-> (get-trans *target* 3) quad))))))
      ((and (mp-session-host?) remote-ok?)
       (set! *mp-palace-squid-target-player-slot* (the-as int (-> remote-record identity player-slot)))
       (vector-copy! out (-> remote root trans)))
      ((and (mp-session-host?) local-ok?)
       (set! *mp-palace-squid-target-player-slot* (the-as int (mp-local-player-slot)))
       (set! (-> out quad) (-> (get-trans *target* 3) quad)))
      ((and (not (mp-session-host?))
            (nonnull? (remote-boss-state (boss-kind palace-squid)))
            (= (-> (remote-boss-state (boss-kind palace-squid)) target-player-slot) (mp-local-player-slot))
            local-ok?)
       (set! (-> out quad) (-> (get-trans *target* 3) quad)))
      ((and (not (mp-session-host?)) remote-ok?) (vector-copy! out (-> remote root trans)))
      (else (set! (-> out quad) (-> proc nav state mesh bounds quad))))
    out))

(defun mp-palace-squid-pack-state! ((proc squid))
  (let ((slot (publish-boss-state! (boss-kind palace-squid) proc)))
    (set! (-> slot stage) (the uint8 (-> proc stage)))
    (set! (-> slot health) (/ (the float (-> proc hit-points)) PALACE_SQUID_MAX_HIT_POINTS))
    (set! (-> slot shield) (-> proc shield-hit-points))
    (set! (-> slot target-player-slot) (the uint8 *mp-palace-squid-target-player-slot*))
    (set! (-> slot draw-force-fade) (if (nonnull? (-> proc draw)) (the uint8 (-> proc draw force-fade)) (the uint8 0)))
    (store-boss-transform! (-> slot anchor-position) (-> slot anchor-quaternion) (-> proc trans) (-> proc quat))
    (mem-copy! (the-as pointer (-> slot trajectory-source)) (the-as pointer (-> proc traj-src)) 12)
    (mem-copy! (the-as pointer (-> slot trajectory-destination)) (the-as pointer (-> proc traj-dest)) 12)
    (set! (-> slot trajectory-duration) (-> proc traj-duration))
    (set! (-> slot trajectory-age) (- (current-time) (-> proc traj-timer))))
  (none))

(defun mp-palace-squid-apply-trajectory! ((proc squid) (slot mp-replication-boss-state))
  (let ((height 49152.0))
    (boss-state-trans! (-> slot trajectory-source) (-> proc traj-src))
    (set! (-> proc traj initial-position quad) (-> proc traj-src quad))
    (boss-state-trans! (-> slot trajectory-destination) (-> proc traj-dest))
    (set! (-> proc traj-duration) (fmax 1.0 (-> slot trajectory-duration)))
    (set! (-> proc traj-timer) (- (current-time) (-> slot trajectory-age)))
    (if (< (-> proc traj-src y) (-> proc traj-dest y)) (+! height (- (-> proc traj-dest y) (-> proc traj-src y))))
    (setup-from-to-duration-and-height! (-> proc traj) (-> proc traj-src) (-> proc traj-dest) 1.0 height))
  (none))

(defun mp-palace-squid-apply-stage! ((proc squid) (host-stage int))
  (when (!= (-> proc stage) host-stage)
    (log 'debug "[Squid] Authoritative stage change: ~D -> ~D~%" (-> proc stage) host-stage)
    (set! (-> proc stage) host-stage)
    (change-to (nav-mesh-from-res-tag (-> proc entity) 'nav-mesh-actor host-stage) proc)
    (set! (-> proc current-nav-poly) #f))
  (none))

(defun mp-palace-squid-apply-state! ((proc squid) (slot mp-replication-boss-state))
  (when (nonnull? (-> proc root))
    (boss-state-trans! (-> slot anchor-position) (-> proc trans))
    (boss-state-quat! (-> slot anchor-quaternion) (-> proc quat))
    (mp-palace-squid-apply-stage! proc (the int (-> slot stage)))
    (set! (-> proc hit-points) (the int (+ 0.5 (* PALACE_SQUID_MAX_HIT_POINTS (-> slot health)))))
    (set! (-> proc shield-hit-points) (-> slot shield))
    (when (nonnull? (-> proc draw))
      (set! (-> proc draw force-fade) (-> slot draw-force-fade)))
    (let ((host-state (boss-state-name *palace-squid-boss-states* (-> slot state-id))))
      (when (and host-state (!= host-state (boss-current-state-name proc)) (!= host-state 'fire))
        (log 'debug "[Squid] Correcting remote state: ~S -> ~S~%" (boss-current-state-name proc) host-state)
        (go-boss-state! proc host-state)))
    (mp-palace-squid-apply-trajectory! proc slot)
    (apply-boss-presentation! proc slot))
  (none))

(defun mp-palace-squid-local-action-authorized? ((proc squid))
  (the-as symbol
          (or (not (mp-session-in-game?)) (mp-session-host?) (and proc (nonzero? proc) (-> proc mp-applying-action)))))

(defun mp-palace-squid-queue-event! ((evt-kind uint)
                                     (sequence uint)
                                     (param0 int)
                                     (param1 int)
                                     (charge float)
                                     (target-pos vector)
                                     (source-pos vector))
  (if (or (not (mp-session-in-game?)) *mp-processing-remote-event*) (return #f))
  (let ((details (new 'stack-no-clear 'mp-palace-squid-build-data)))
    (set! (-> details evt-kind) (the-as uint8 evt-kind))
    (set! (-> details sequence) (the-as uint32 sequence))
    (set! (-> details param0) (the-as int32 param0))
    (set! (-> details param1) (the-as uint8 param1))
    (set! (-> details charge) charge)
    (set! (-> details target-pos) target-pos)
    (set! (-> details source-pos) source-pos)
    (mp-event-enqueue-palace-squid! details))
  (none))

(defun mp-palace-squid-send-hit-request! ((proc squid) (msg event-message-block))
  (let ((attack-id (the uint (current-time)))
        (dark-bomb? 0))
    (when (and msg (nonzero? msg) (-> msg param 1))
      (let ((attack (the-as attack-info (-> msg param 1))))
        (set! attack-id (-> attack id))
        (when (and (logtest? (attack-mask penetrate-using) (-> attack mask))
                   (logtest? (penetrate dark-bomb) (-> attack penetrate-using)))
          (set! dark-bomb? 1))))
    (when (!= (-> proc mp-last-hit-request) attack-id)
      (set! (-> proc mp-last-hit-request) attack-id)
      (mp-palace-squid-queue-event! MP_PALACE_SQUID_EVT_HIT_REQUEST
                                    attack-id
                                    (the-as int attack-id)
                                    dark-bomb?
                                    0.0
                                    (-> proc root trans)
                                    (if (mp-palace-squid-local-player-valid?) (-> *target* control trans) (the-as vector #f)))))
  (none))

(defun mp-palace-squid-should-swallow-attack? ((proc squid) (attacker process) (msg event-message-block))
  (if (and (mp-session-in-game?) (not (mp-session-host?)) (not *mp-processing-remote-event*) proc (nonzero? proc))
    (begin
      (when (and attacker (nonzero? attacker) *target* (nonzero? *target*) (= attacker *target*))
        (mp-palace-squid-send-hit-request! proc msg))
      #t)
    #f))

(defun mp-palace-squid-note-grenade-spawn! ((proc squid)
                                            (joint-id int)
                                            (holder-index int)
                                            (charge float)
                                            (holder squid-grenade-holder))
  (when (and (mp-session-in-game?) (mp-session-host?) proc (nonzero? proc) holder)
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event! MP_PALACE_SQUID_EVT_GRENADE
                                  (-> proc mp-last-action-seq)
                                  joint-id
                                  holder-index
                                  charge
                                  (-> holder target-position)
                                  (-> proc root trans)))
  (none))

(defun mp-palace-squid-note-whirlwind-spawn! ((proc squid))
  (when (and (mp-session-in-game?) (mp-session-host?) proc (nonzero? proc))
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event! MP_PALACE_SQUID_EVT_WHIRLWIND
                                  (-> proc mp-last-action-seq)
                                  0
                                  0
                                  0.0
                                  (-> proc root trans)
                                  (-> proc root trans)))
  (none))

(defun mp-palace-squid-note-resolution! ((proc squid))
  (when (and (mp-session-in-game?) (mp-session-host?) proc (nonzero? proc))
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event! MP_PALACE_SQUID_EVT_RESOLUTION
                                  (-> proc mp-last-action-seq)
                                  0
                                  0
                                  0.0
                                  (-> proc root trans)
                                  (-> proc root trans)))
  (none))

(defun mp-palace-squid-resolution-safe-to-start? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not *scene-player*)
       (not (focus-test? *target* indax grabbed teleporting))
       (not (logtest? (-> *target* focus-status) (focus-status dead)))))

(defun mp-palace-squid-apply-resolution-event! ((proc squid) (sequence uint))
  (when (and proc (nonzero? proc) (mp-palace-squid-resolution-safe-to-start?))
    (go-boss-state! proc 'beaten)
    (process-spawn scene-player :init scene-player-init "palace-boss-res" #t #f)
    (remove-setting! 'music)
    (set! (-> proc mp-last-action-seq) sequence)
    (set! (-> proc mp-pending-resolution-seq) (the uint 0)))
  (none))

(defun mp-palace-squid-poll-resolution! ((proc squid))
  (when (and proc
             (nonzero? proc)
             (mp-session-client?)
             (> (-> proc mp-pending-resolution-seq) (-> proc mp-last-action-seq)))
    (mp-palace-squid-apply-resolution-event! proc (-> proc mp-pending-resolution-seq)))
  (none))

(defun mp-palace-squid-tick ((proc squid))
  (when (mp-session-in-game?)
    (if (mp-session-host?)
      (mp-palace-squid-pack-state! proc)
      (let ((slot (remote-boss-state (boss-kind palace-squid))))
        (when slot
          (mp-palace-squid-apply-state! proc slot))
        (mp-palace-squid-poll-resolution! proc))))
  (none))
