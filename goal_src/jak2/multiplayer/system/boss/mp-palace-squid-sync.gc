;;-*-Lisp-*-
(in-package goal)

(define *mp-palace-squid-last-applied-state* (the uint 0))
(define *mp-palace-squid-target-player-id* (the-as int MP_INVALID_PLAYER_ID))
(define *mp-palace-squid-last-state-name* (the-as symbol 'none))

(define-extern mp-palace-squid-reset-presentation! (function squid none))
(define-extern mp-palace-squid-interpolate-presentation! (function squid vector quaternion none))

(defun mp-palace-squid-ready? ()
  (and *multi-sync-enabled?*
       (= (pc-multi-get-status) (mp-connection-status in-game))
       *mp-palace-squid-buffer*
       (nonzero? (the-as uint *mp-palace-squid-buffer*))
       )
  )

(defun mp-palace-squid-state-authority? ()
  (or (not (mp-palace-squid-ready?))
      (mp-session-host?))
  )

(defun mp-palace-squid-local-player-valid? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       (not (logtest? (-> *target* focus-status) (focus-status dead)))
       )
  )

(defun mp-palace-squid-remote-player-valid? ((record mp-player-record))
  (let ((remote (mp-player-record-target record)))
    (if (and remote
             (nonzero? remote)
             (-> remote root)
             (nonzero? (-> remote root))
             (not (logtest? (-> remote mask) (process-mask sleep))))
        #t
        #f)
    )
  )

(defun mp-palace-squid-target-pos! ((proc squid) (out vector))
  (let ((remote-record
          (if (and (-> proc root) (nonzero? (-> proc root)))
              (mp-nearest-remote-player-record-to-position
                (-> proc root trans) #t)
              (the-as mp-player-record #f)))
        (remote (the-as target #f))
        (local-ok? (mp-palace-squid-local-player-valid?))
        (remote-ok? #f)
        )
    (when (and remote-record (nonzero? remote-record))
      (set! remote (mp-player-record-target remote-record))
      (set! remote-ok? (mp-palace-squid-remote-player-valid? remote-record)))
    (cond
      ((and (mp-session-host?) local-ok? remote-ok?)
       (let ((local-dist (vector-vector-distance-squared (-> proc root trans) (-> *target* control trans)))
             (remote-dist (vector-vector-distance-squared (-> proc root trans) (-> remote root trans)))
             )
         (if (< remote-dist local-dist)
             (begin
               (set! *mp-palace-squid-target-player-id*
                     (the-as int (-> remote-record identity player-id)))
               (vector-copy! out (-> remote root trans))
               )
             (begin
               (set! *mp-palace-squid-target-player-id* (the-as int (mp-local-player-id)))
               (set! (-> out quad) (-> (get-trans *target* 3) quad))
               )
             )
         )
       )
      ((and (mp-session-host?) remote-ok?)
       (set! *mp-palace-squid-target-player-id*
             (the-as int (-> remote-record identity player-id)))
       (vector-copy! out (-> remote root trans))
       )
      ((and (mp-session-host?) local-ok?)
       (set! *mp-palace-squid-target-player-id* (the-as int (mp-local-player-id)))
       (set! (-> out quad) (-> (get-trans *target* 3) quad))
       )
      ((and (not (mp-session-host?))
            (mp-palace-squid-ready?)
            (= (-> *mp-palace-squid-buffer* remote-state target-player-id)
               (the-as int (mp-local-player-id)))
            local-ok?)
       (set! (-> out quad) (-> (get-trans *target* 3) quad))
       )
      ((and (not (mp-session-host?)) remote-ok?)
       (vector-copy! out (-> remote root trans))
       )
      (else
        (set! (-> out quad) (-> proc nav state mesh bounds quad))
        )
      )
    out
    )
  )

(defun mp-palace-squid-current-state-name ((proc squid))
  (if (and proc (nonzero? proc) (-> proc next-state))
      (-> proc next-state name)
      (if (and proc (nonzero? proc) (-> proc state))
          (-> proc state name)
          #f
          )
      )
  )


(defun mp-palace-squid-pack-state! ((proc squid) (slot mp-palace-squid-state))
  (set! (-> slot active) (the uint32 1))
  (set! (-> slot state-id) (the-as uint32 (mp-palace-squid-state->id (mp-palace-squid-current-state-name proc))))
  (set! (-> slot stage) (-> proc stage))
  (set! (-> slot hit-points) (-> proc hit-points))
  (set! (-> slot shield-hit-points) (-> proc shield-hit-points))
  (set! (-> slot target-player-id) *mp-palace-squid-target-player-id*)
  (set! (-> slot draw-force-fade)
        (if (and (-> proc draw) (nonzero? (-> proc draw)))
            (-> proc draw force-fade)
            (the uint 0)))
  (set! (-> slot action-seq) (-> proc mp-last-action-seq))
  (set! (-> slot x) (-> proc trans x))
  (set! (-> slot y) (-> proc trans y))
  (set! (-> slot z) (-> proc trans z))
  (set! (-> slot quat-x) (-> proc quat x))
  (set! (-> slot quat-y) (-> proc quat y))
  (set! (-> slot quat-z) (-> proc quat z))
  (set! (-> slot quat-w) (-> proc quat w))
  (if (and (-> proc root)
           (nonzero? (-> proc root)))
      (begin
        (set! (-> slot root-x) (-> proc root trans x))
        (set! (-> slot root-y) (-> proc root trans y))
        (set! (-> slot root-z) (-> proc root trans z))
        (set! (-> slot root-quat-x) (-> proc root quat x))
        (set! (-> slot root-quat-y) (-> proc root quat y))
        (set! (-> slot root-quat-z) (-> proc root quat z))
        (set! (-> slot root-quat-w) (-> proc root quat w))
        )
      (begin
        (set! (-> slot root-x) (-> proc trans x))
        (set! (-> slot root-y) (-> proc trans y))
        (set! (-> slot root-z) (-> proc trans z))
        (set! (-> slot root-quat-x) (-> proc quat x))
        (set! (-> slot root-quat-y) (-> proc quat y))
        (set! (-> slot root-quat-z) (-> proc quat z))
        (set! (-> slot root-quat-w) (-> proc quat w))
        )
      )
  (set! (-> slot traj-src-x) (-> proc traj-src x))
  (set! (-> slot traj-src-y) (-> proc traj-src y))
  (set! (-> slot traj-src-z) (-> proc traj-src z))
  (set! (-> slot traj-dest-x) (-> proc traj-dest x))
  (set! (-> slot traj-dest-y) (-> proc traj-dest y))
  (set! (-> slot traj-dest-z) (-> proc traj-dest z))
  (set! (-> slot traj-duration) (-> proc traj-duration))
  (set! (-> slot traj-age) (- (current-time) (-> proc traj-timer)))
  (set! (-> slot last-updated) (the-as uint64 (current-time)))
  (none)
  )

(defun mp-palace-squid-apply-trajectory! ((proc squid) (slot mp-palace-squid-state))
  (let ((height 49152.0))
    (set-vector! (-> proc traj-src) (-> slot traj-src-x) (-> slot traj-src-y) (-> slot traj-src-z) 1.0)
    (set! (-> proc traj initial-position quad) (-> proc traj-src quad))
    (set-vector! (-> proc traj-dest) (-> slot traj-dest-x) (-> slot traj-dest-y) (-> slot traj-dest-z) 1.0)
    (set! (-> proc traj-duration) (fmax 1.0 (-> slot traj-duration)))
    (set! (-> proc traj-timer) (- (current-time) (-> slot traj-age)))
    (if (< (-> proc traj-src y) (-> proc traj-dest y))
        (+! height (- (-> proc traj-dest y) (-> proc traj-src y)))
        )
    (setup-from-to-duration-and-height! (-> proc traj) (-> proc traj-src) (-> proc traj-dest) 1.0 height)
    )
  (none)
  )

(defun mp-palace-squid-apply-state! ((proc squid) (slot mp-palace-squid-state))
  (when (and proc
             (nonzero? proc)
             (-> proc root)
             (nonzero? (-> proc root))
             (nonzero? (-> slot active)))
    (let ((gameplay-trans (new 'stack-no-clear 'vector))
          (gameplay-quat (new 'stack-no-clear 'quaternion))
          (presentation-trans (new 'stack-no-clear 'vector))
          (presentation-quat (new 'stack-no-clear 'quaternion)))
      (set-vector! gameplay-trans (-> slot x) (-> slot y) (-> slot z) 1.0)
      (quaternion-set! gameplay-quat (-> slot quat-x) (-> slot quat-y) (-> slot quat-z) (-> slot quat-w))
      (set-vector! presentation-trans (-> slot root-x) (-> slot root-y) (-> slot root-z) 1.0)
      (quaternion-set! presentation-quat (-> slot root-quat-x) (-> slot root-quat-y) (-> slot root-quat-z) (-> slot root-quat-w))
      (vector-copy! (-> proc trans) gameplay-trans)
      (quaternion-copy! (-> proc quat) gameplay-quat)

      (let ((old-stage (-> proc stage))
            (host-stage (-> slot stage)))
        (when (!= old-stage host-stage)
          (set! (-> proc stage) host-stage)
          (change-to (nav-mesh-from-res-tag (-> proc entity) 'nav-mesh-actor host-stage) proc)
          (set! (-> proc current-nav-poly) #f)
          (debug-log *mp-debug-log?* "[Squid] Authoritative stage change: ~D -> ~D~%" old-stage host-stage)
          )
        (set! (-> proc stage) host-stage)
        )
      (set! (-> proc hit-points) (-> slot hit-points))
      (set! (-> proc shield-hit-points) (-> slot shield-hit-points))

      (when (and (-> proc draw) (nonzero? (-> proc draw)))
        (set! (-> proc draw force-fade) (-> slot draw-force-fade))
        )

      (let ((desired-state-id (-> slot state-id))
            (local-state-id (mp-palace-squid-state->id (mp-palace-squid-current-state-name proc))))
        (set! *mp-palace-squid-last-applied-state* desired-state-id)
        (when (and (!= local-state-id desired-state-id)
                   (!= desired-state-id (mp-palace-squid-state-id fire)))
          (let ((old-name (mp-palace-squid-current-state-name proc)))
            (mp-palace-squid-go-state! proc desired-state-id)
            (let ((new-name (mp-palace-squid-current-state-name proc)))
              (debug-log *mp-debug-log?* "[Squid] Correcting remote state: ~S -> ~S~%" old-name new-name)
              (set! *mp-palace-squid-last-state-name* new-name)
              )
            )
          )
        )

      (mp-palace-squid-apply-trajectory! proc slot)
      (mp-palace-squid-interpolate-presentation! proc presentation-trans presentation-quat)
      )
    )
  (none)
  )

(defun mp-palace-squid-local-action-authorized? ((proc squid))
  (the-as symbol 
    (or (not (mp-palace-squid-ready?))
      (mp-session-host?)
      (and proc
           (nonzero? proc)
           (-> proc mp-applying-action))
      )
    )
  )

(defun mp-palace-squid-queue-event! ((evt-kind uint)
                                      (sequence uint)
                                      (param0 int)
                                      (param1 int)
                                      (param2 int)
                                      (charge float)
                                      (target-pos vector)
                                      (source-pos vector))
  (if (or (not (mp-palace-squid-ready?)) *mp-processing-remote-event*)
      (return #f))
  (let ((details (new 'stack-no-clear 'mp-palace-squid-build-data)))
    (set! (-> details evt-kind) evt-kind)
    (set! (-> details sequence) sequence)
    (set! (-> details param0) param0)
    (set! (-> details param1) param1)
    (set! (-> details param2) param2)
    (set! (-> details charge) charge)
    (set! (-> details target-pos) target-pos)
    (set! (-> details source-pos) source-pos)
    (mp-event-enqueue-palace-squid! details))
  (none)
  )

(defun mp-palace-squid-send-hit-request! ((proc squid) (msg event-message-block))
  (let ((attack-id (the uint (current-time)))
        (dark-bomb? 0))
    (when (and msg
               (nonzero? msg)
               (-> msg param 1))
      (let ((attack (the-as attack-info (-> msg param 1))))
        (set! attack-id (-> attack id))
        (when (and
                (logtest?
                  (attack-mask penetrate-using)
                  (-> attack mask))
                (logtest?
                  (penetrate dark-bomb)
                  (-> attack penetrate-using)))
          (set! dark-bomb? 1)
          )
        )
      )
    (when (!= (-> proc mp-last-hit-request) attack-id)
      (set! (-> proc mp-last-hit-request) attack-id)
      (mp-palace-squid-queue-event!
        MP_PALACE_SQUID_EVT_HIT_REQUEST
        attack-id
        (the-as int attack-id)
        dark-bomb?
        0
        0.0
        (-> proc root trans)
        (if (mp-palace-squid-local-player-valid?)
            (-> *target* control trans)
            (the-as vector #f))
        )
      )
    )
  (none)
  )

(defun mp-palace-squid-should-swallow-attack? ((proc squid) (attacker process) (msg event-message-block))
  (if (and (mp-palace-squid-ready?)
           (not (mp-session-host?))
           (not *mp-processing-remote-event*)
           proc
           (nonzero? proc))
      (begin
        (when (and attacker
                   (nonzero? attacker)
                   *target*
                   (nonzero? *target*)
                   (= attacker *target*))
          (mp-palace-squid-send-hit-request! proc msg)
          )
        #t
        )
      #f
      )
  )

(defun mp-palace-squid-note-grenade-spawn! ((proc squid) (joint-id int) (holder-index int) (charge float) (holder squid-grenade-holder))
  (when (and (mp-palace-squid-ready?) (mp-session-host?) proc (nonzero? proc) holder)
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event!
      MP_PALACE_SQUID_EVT_GRENADE
      (-> proc mp-last-action-seq)
      joint-id
      holder-index
      0
      charge
      (-> holder target-position)
      (-> proc root trans)
      )
    )
  (none)
  )

(defun mp-palace-squid-note-whirlwind-spawn! ((proc squid))
  (when (and (mp-palace-squid-ready?) (mp-session-host?) proc (nonzero? proc))
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event!
      MP_PALACE_SQUID_EVT_WHIRLWIND
      (-> proc mp-last-action-seq)
      0
      0
      0
      0.0
      (-> proc root trans)
      (-> proc root trans)
      )
    )
  (none)
  )

(defun mp-palace-squid-note-resolution! ((proc squid))
  (when (and (mp-palace-squid-ready?) (mp-session-host?) proc (nonzero? proc))
    (+! (-> proc mp-last-action-seq) 1)
    (mp-palace-squid-queue-event!
      MP_PALACE_SQUID_EVT_RESOLUTION
      (-> proc mp-last-action-seq)
      0
      0
      0
      0.0
      (-> proc root trans)
      (-> proc root trans)
      )
    )
  (none)
  )

(defun mp-palace-squid-resolution-safe-to-start? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not *scene-player*)
       (not (focus-test? *target* indax grabbed teleporting))
       (not (logtest? (-> *target* focus-status) (focus-status dead)))
       )
  )

(defun mp-palace-squid-apply-resolution-event! ((proc squid) (sequence uint))
  (when (and proc
             (nonzero? proc)
             (mp-palace-squid-resolution-safe-to-start?))
    (mp-palace-squid-go-state! proc (the-as uint (mp-palace-squid-state-id beaten)))
    (process-spawn scene-player :init scene-player-init "palace-boss-res" #t #f)
    (remove-setting! 'music)
    (set! (-> proc mp-last-action-seq) sequence)
    (set! (-> proc mp-pending-resolution-seq) (the uint 0))
    )
  (none)
  )

(defun mp-palace-squid-poll-resolution! ((proc squid))
  (when (and proc
             (nonzero? proc)
             (mp-session-client?)
             (> (-> proc mp-pending-resolution-seq)
                (-> proc mp-last-action-seq)))
    (mp-palace-squid-apply-resolution-event! proc (-> proc mp-pending-resolution-seq))
    )
  (none)
  )

(defun mp-palace-squid-tick ((proc squid))
  (if (not (mp-palace-squid-ready?))
      (mp-palace-squid-reset-presentation! proc)
      (if (mp-session-host?)
          (begin
            (mp-palace-squid-pack-state! proc (-> *mp-palace-squid-buffer* local-state))
            (pc-multi-send-palace-squid (the-as uint *mp-palace-squid-buffer*))
            )
          (begin
            (pc-multi-receive-palace-squid (the-as uint *mp-palace-squid-buffer*))
            (mp-palace-squid-apply-state! proc (-> *mp-palace-squid-buffer* remote-state))
            (mp-palace-squid-poll-resolution! proc)
            (let ((cur-name (mp-palace-squid-current-state-name proc)))
              (when (and cur-name (!= cur-name *mp-palace-squid-last-state-name*))
                (debug-log *mp-debug-log?* "[Squid] State change (LOCAL): ~S -> ~S~%" *mp-palace-squid-last-state-name* cur-name)
                (set! *mp-palace-squid-last-state-name* cur-name)
                )
              )
            )
          )
      )
  (none)
  )
