;;-*-Lisp-*-
(in-package goal)

(defglobalconstant MP_ORB_AID_CACHE_CAPACITY (the int 4096))

(define *mp-orb-collected-aids* (new 'global 'boxed-array uint32 MP_ORB_AID_CACHE_CAPACITY))
(define-perm *mp-orb-collected-aid-count* int 0)
(define *mp-aid-perm-list-full-logged?* #f)
(define *mp-orb-aid-cache-full-logged?* #f)

(define *actor-sync-handlers* '())

(defun dispatch-actor-sync! ((aid uint) (message symbol))
  (let ((handlers *actor-sync-handlers*))
    (while (and (not (null? handlers)) (pair? handlers))
      (let ((handler (the-as (function uint symbol symbol) (car handlers))))
        (when (handler aid message)
          (return #t)))
      (set! handlers (cdr handlers))))
  #f)

(defun perm-list-entry! ((aid uint))
  (when (or (zero? aid) (not (nonnull? *game-info* (-> *game-info* perm-list))))
    (return (the-as entity-perm #f)))
  (let ((game-perms (-> *game-info* perm-list))
        (perm (actor-perm *game-info* (the-as actor-id aid))))
    (when (nonnull? perm)
      (return perm))
    (when (< (-> game-perms length) (-> game-perms allocated-length))
      (let ((new-perm (-> game-perms data (-> game-perms length))))
        (when (nonnull? new-perm)
          (set! (-> new-perm quad) (the-as uint128 0))
          (set! (-> new-perm aid) (the-as actor-id aid))
          (+! (-> game-perms length) 1)
          (return new-perm))))
    (when (not *mp-aid-perm-list-full-logged?*)
      (log 'debug "[MP-AID] Could not store aid=~D: perm-list is full.~%" aid)
      (set! *mp-aid-perm-list-full-logged?* #t)))
  (the-as entity-perm #f))

(defun mp-record-aid-dead-in-perm-list! ((aid uint))
  (let ((perm (perm-list-entry! aid)))
    (when (nonnull? perm)
      (logior! (-> perm status) (entity-perm-status dead))
      (return #t)))
  #f)

(defun mp-aid-dead-in-perm-list? ((aid uint))
  (when (or (zero? aid) (not (nonnull? *game-info*)))
    (return #f))
  (let ((perm (actor-perm *game-info* (the-as actor-id aid))))
    (and (nonnull? perm) (logtest? (-> perm status) (entity-perm-status dead)))))

(defun mp-orb-mark-aid-dead-in-perm-list! ((aid uint))
  (when (not (mp-record-aid-dead-in-perm-list! aid))
    (return #f))
  (when (not (nonnull? *game-info*))
    (return #f))
  (let ((perm (actor-perm *game-info* (the-as actor-id aid))))
    (when (nonnull? perm)
      (set! (-> perm task) (game-task complete))
      (logior! (-> perm status) (entity-perm-status dead))
      (return #t)))
  #f)

(defun mp-orb-aid-cache-index ((aid uint))
  (when (or (zero? aid) (not (nonnull? *mp-orb-collected-aids*)))
    (return -1))
  (let ((index 0))
    (while (< index *mp-orb-collected-aid-count*)
      (when (= aid (-> *mp-orb-collected-aids* data index))
        (return index))
      (+! index 1)))
  -1)

(defun mp-orb-cache-collected-aid! ((aid uint))
  (when (zero? aid)
    (return #f))
  (when (>= (mp-orb-aid-cache-index aid) 0)
    (return #t))
  (when (not (nonnull? *mp-orb-collected-aids*))
    (return #f))
  (when (< *mp-orb-collected-aid-count* MP_ORB_AID_CACHE_CAPACITY)
    (set! (-> *mp-orb-collected-aids* data *mp-orb-collected-aid-count*) aid)
    (+! *mp-orb-collected-aid-count* 1)
    (return #t))
  (when (not *mp-orb-aid-cache-full-logged?*)
    (log 'warn "[MP-Orb] Collected AID cache is full; cannot retain aid=~D across level loads.~%" aid)
    (set! *mp-orb-aid-cache-full-logged?* #t))
  #f)

(defun mp-orb-aid-collected? ((aid uint))
  (or (>= (mp-orb-aid-cache-index aid) 0) (mp-aid-dead-in-perm-list? aid)))

(defun mp-orb-record-collected-aid! ((aid uint))
  (when (zero? aid)
    (return #f))
  (let ((cached? (if (mp-session-in-game?) (mp-orb-cache-collected-aid! aid) #f))
        (recorded? (mp-orb-mark-aid-dead-in-perm-list! aid)))
    (or cached? recorded?)))

(defun mp-orb-record-remote-collected-aid! ((aid uint))
  (when (zero? aid)
    (return #f))
  (let ((cached? (mp-orb-cache-collected-aid! aid))
        (recorded? (mp-orb-mark-aid-dead-in-perm-list! aid)))
    (or cached? recorded?)))

(defun mp-orb-restore-collected-aids! ()
  (when (nonnull? *game-info* *mp-orb-collected-aids*)
    (dotimes (index *mp-orb-collected-aid-count*)
      (mp-orb-mark-aid-dead-in-perm-list! (-> *mp-orb-collected-aids* data index))))
  (none))

(defun mp-reset-orb-permanence-state! ()
  (set! *mp-orb-collected-aid-count* 0)
  (set! *mp-aid-perm-list-full-logged?* #f)
  (set! *mp-orb-aid-cache-full-logged?* #f)
  (none))
