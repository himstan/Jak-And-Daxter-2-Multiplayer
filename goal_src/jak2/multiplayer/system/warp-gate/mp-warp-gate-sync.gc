;;-*-Lisp-*-
(in-package goal)

(declare-type warp-gate process-drawable)

(defun mp-warp-gate-indax? ((evt mp-warp-gate-event))
  (unless (nonnull? evt)
    (return #f))
  (logtest? (-> evt payload flags) MP_WARP_GATE_FLAG_INDAX))

(defun mp-warp-gate-build-vector! ((dst vector) (x float) (y float) (z float))
  (set-vector! dst x y z 1.0)
  (none))

(defun mp-warp-gate-target-state ((phase uint) (as-indax? symbol))
  (case phase
    ((MP_WARP_GATE_PHASE_BEGIN) (if as-indax? target-indax-warp-out target-warp-out))
    ((MP_WARP_GATE_PHASE_ARRIVE) (if as-indax? target-indax-warp-in target-warp-in))
    (else #f)))

(defun mp-warp-gate-send-change-state! ((actor target)
                                        (state object)
                                        (start-pos vector)
                                        (end-pos vector)
                                        (gate-handle handle))
  (when (and actor (nonzero? actor) state start-pos (nonzero? start-pos) end-pos (nonzero? end-pos))
    (let ((msg (new 'stack-no-clear 'event-message-block))
          (start-copy (new 'static 'vector))
          (end-copy (new 'static 'vector)))
      (set! (-> start-copy quad) (-> start-pos quad))
      (set! (-> end-copy quad) (-> end-pos quad))
      (set! (-> msg from) (process->ppointer actor))
      (set! (-> msg num-params) 4)
      (set! (-> msg message) 'change-state)
      (set! (-> msg param 0) (the-as uint state))
      (set! (-> msg param 1) (the-as uint start-copy))
      (set! (-> msg param 2) (the-as uint end-copy))
      (set! (-> msg param 3) (the-as uint gate-handle))
      (send-event-function actor msg)))
  (none))

(defun warp-gate-play-replica! ((replica target)
                                (phase uint)
                                (as-indax? symbol)
                                (start-pos vector)
                                (end-pos vector)
                                (gate-handle handle))
  (when (player-replica-valid? replica)
    (mp-warp-gate-send-change-state! replica (mp-warp-gate-target-state phase as-indax?) start-pos end-pos gate-handle))
  (none))

(defun remote-warp-arrival-for ((player-slot uint))
  (-> *remote-warp-arrivals* players player-slot))

(defun remote-warp-arrival-time ((replica target))
  (-> (remote-warp-arrival-for (-> replica player-slot)) time))

(defun remote-warp-arrival-pending? ((record mp-player-record))
  (let ((arrival (remote-warp-arrival-for (-> record identity player-slot))))
    (and (-> arrival pending?) (not (time-elapsed? (-> arrival time) (seconds 2))))))

(defun play-pending-warp-arrival! ((record mp-player-record) (replica target))
  (let ((arrival (remote-warp-arrival-for (-> record identity player-slot))))
    (when (remote-warp-arrival-pending? record)
      (warp-gate-play-replica! replica
                               MP_WARP_GATE_PHASE_ARRIVE
                               (-> arrival indax?)
                               (-> arrival start)
                               (-> arrival end)
                               (the-as handle #f)))
    (set! (-> arrival pending?) #f))
  (none))

(defun mp-warp-gate-find-proc ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (if (and ent (nonzero? ent) (-> ent extra process) (nonzero? (-> ent extra process)))
      (the-as warp-gate (-> ent extra process))
      (the-as warp-gate #f))))

(defun mp-warp-gate-queue-event! ((gate-aid uint)
                                  (continue continue-point)
                                  (phase uint)
                                  (as-indax? symbol)
                                  (start-pos vector)
                                  (end-pos vector))
  (when (and (nonzero? gate-aid) (nonnull? start-pos end-pos))
    (mp-event-enqueue-warp-gate! gate-aid
                                 phase
                                 (the-as uint (if as-indax? MP_WARP_GATE_FLAG_INDAX 0))
                                 (if (nonnull? continue (-> continue name)) (-> continue name) (the-as string #f))
                                 start-pos
                                 end-pos))
  (none))

(defun update-remote-warp-hold! ((record mp-player-record))
  (when (mp-player-runtime-flag? record (mp-player-runtime-flags warping))
    (let ((state (mp-target-get-state-from-id (-> record action target-state-id))))
      (cond
        ((replica-warp-state? state)
         (mp-player-runtime-set-flag! record (mp-player-runtime-flags warp-observed)))
        ((and state (mp-player-runtime-flag? record (mp-player-runtime-flags warp-observed)))
         (mp-player-runtime-clear-flag! record (mp-player-runtime-flags warping warp-observed))))))
  (none))

(defun mp-warp-gate-apply-remote-event! ((evt mp-warp-gate-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((gate-proc (mp-warp-gate-find-proc (-> evt payload gate-aid)))
        (phase (the-as uint (-> evt payload phase)))
        (as-indax? (mp-warp-gate-indax? evt))
        (record (mp-player-record-by-slot (-> evt source-player-slot)))
        (start-pos (new 'stack-no-clear 'vector))
        (end-pos (new 'stack-no-clear 'vector)))
    (mp-warp-gate-build-vector! start-pos (-> evt payload start-x) (-> evt payload start-y) (-> evt payload start-z))
    (mp-warp-gate-build-vector! end-pos (-> evt payload end-x) (-> evt payload end-y) (-> evt payload end-z))
    (when (nonnull? record)
      (let ((arrival (remote-warp-arrival-for (-> evt source-player-slot))))
        (case phase
          ((MP_WARP_GATE_PHASE_BEGIN)
           (mp-player-runtime-set-flag! record (mp-player-runtime-flags warping))
           (set! (-> arrival pending?) #f)
           (warp-gate-play-replica! (mp-player-record-target record)
                                    phase
                                    as-indax?
                                    start-pos
                                    end-pos
                                    (if (nonnull? gate-proc) (process->handle gate-proc) (the-as handle #f))))
          ((MP_WARP_GATE_PHASE_ARRIVE)
           (mp-player-runtime-clear-flag! record (mp-player-runtime-flags warping warp-observed))
           (vector-copy! (-> arrival start) start-pos)
           (vector-copy! (-> arrival end) end-pos)
           (set! (-> arrival time) (current-time))
           (set! (-> arrival indax?) as-indax?)
           (set! (-> arrival pending?) #t)))))
    (when (and (mp-session-client?)
               (mp-target-ride-along? *target*)
               (= phase MP_WARP_GATE_PHASE_BEGIN)
               gate-proc
               (nonzero? gate-proc))
      (log 'debug "[MP-WarpGate] Following remote gate locally for ride-along.~%")
      (send-event gate-proc 'mp-use)))
  (none))
