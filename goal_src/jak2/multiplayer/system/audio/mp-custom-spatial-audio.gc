;;-*-Lisp-*-
(in-package goal)

(deftype custom-spatial-audio-entry (structure)
  ((key          string)
   (path         string)
   (probability  int32)
   (available?   symbol)
   )
  )

(defun custom-spatial-audio-pool-total ((pool (array custom-spatial-audio-entry)))
  (when (not (nonzero? pool))
    (return -1)
    )
  (let ((total 0))
    (dotimes (idx (-> pool length))
      (let ((entry (-> pool idx)))
        (when (not (nonzero? entry))
          (return -1)
          )
        (let ((probability (-> entry probability)))
          (when (or (< probability 1) (> probability 100))
            (return -1)
            )
          (+! total probability)
          (when (> total 100)
            (return -1)
            )
          )
        )
      )
    total
    )
  )

(defun register-custom-spatial-audio-pool! ((pool (array custom-spatial-audio-entry)))
  (when (< (custom-spatial-audio-pool-total pool) 0)
    (return #f)
    )
  (dotimes (idx (-> pool length))
    (let ((entry (-> pool idx)))
      (when (nonzero? entry)
        (let ((key (-> entry key))
              (path (-> entry path))
              )
          (set! (-> entry available?)
                (and (nonzero? key)
                     (nonzero? path)
                     (pc-register-custom-spatial-audio key path)
                     )
                )
          )
        )
      )
    )
  #t
  )

(defun choose-custom-spatial-audio ((pool (array custom-spatial-audio-entry)))
  (when (not (nonzero? pool))
    (return (the-as string #f))
    )
  (let ((roll (+ (rand-vu-int-count 100) 1))
        (cumulative 0)
        )
    (dotimes (idx (-> pool length))
      (let ((entry (-> pool idx)))
        (when (nonzero? entry)
          (+! cumulative (-> entry probability))
          (when (<= roll cumulative)
            (if (and (-> entry available?) (nonzero? (-> entry key)))
                (return (-> entry key))
                (return (the-as string #f))
                )
            )
          )
        )
      )
    )
  (the-as string #f)
  )
