;;-*-Lisp-*-
(in-package goal)

(defun mp-sync-clock-host ()
  "Update Host Clock BEFORE sync"
  (if (mp-is-jak?)
      (set! (-> *local-info* clock) (-> *display* shared-clock frame-counter)))
  (none))

(defun mp-sync-clock-client ()
  "Update Client Clock AFTER sync - GUARDED to avoid black screen during load"
  (with-pp
    (if (and (mp-is-daxter?)
             (= (pc-multi-get-status) (mp-connection-status in-game))
             *multi-sync-enabled?*
             (zero? (-> *local-info* sync-flag))
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             (not (and *progress-process* (nonzero? *progress-process*)))
             *level*
             (nonzero? *level*)
             (= (-> *level* loading-level) (-> *level* default-level))
             (not (load-in-progress? *level*)))
        (let* ((host-clock (-> *remote-info* clock))
               (diff (- host-clock (-> *display* shared-clock frame-counter))))
          ;; Only sync if Host clock is AHEAD of local clock to avoid jittering/stalling
          ;; Also sync if we are vastly ahead (e.g. host started game after us)
          (when (and (nonzero? host-clock)
                     (or (> diff 0) (< diff -60)))
            ;; Synchronize the entity and pusher gameplay clock.
            (set! (-> *display* shared-clock frame-counter) host-clock)
            (set! (-> *display* shared-clock old-frame-counter) (+ host-clock -1))
            ))))
  (none))
