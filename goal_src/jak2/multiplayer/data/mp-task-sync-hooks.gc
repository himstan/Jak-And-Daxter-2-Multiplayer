;;-*-Lisp-*-
(in-package goal)

(defun mp-task-hook-atoll-sig-resolution-close! ()
  (when (and *setting-control* (nonzero? *setting-control*))
    (remove-setting! 'airlock)
    (apply-settings *setting-control*)
    (log 'debug "[MP-TaskSync] Cleared atoll Sig airlock setting after remote task close.~%"))
  (none))

(defun mp-task-hook-atoll-battle-battle-close! ()
  (when (and *setting-control* (nonzero? *setting-control*))
    (remove-setting! 'sound-mode)
    (remove-setting! 'airlock)
    (apply-settings *setting-control*)
    (log 'debug "[MP-TaskSync] Cleared atoll battle settings after remote task close.~%"))
  (none))

(defun mp-task-sync-after-remote-close! ((node game-task-node))
  (case node
    (((game-task-node atoll-sig-resolution)) (mp-task-hook-atoll-sig-resolution-close!))
    (((game-task-node atoll-battle-battle)) (mp-task-hook-atoll-battle-battle-close!)))
  (none))

(defun mp-task-sync-after-remote-open! ((node game-task-node))
  node
  (none))
