;;-*-Lisp-*-
(in-package goal)

(define-extern mp-tomb-scene-sync-suppressed? (function symbol))
(define-extern mp-tomb-scene-transport-suppressed? (function string symbol))

(defun mp-teleport-to-remote ()
  (let ((record (mp-teleport-destination-record)))
    (when (and *target*
               (nonzero? *target*)
               (-> *target* control)
               (nonzero? (-> *target* control))
               record
               (nonzero? record))
      (set! (-> *target* control trans x) (-> record transform position x))
      (set! (-> *target* control trans y) (-> record transform position y))
      (set! (-> *target* control trans z) (-> record transform position z))
      (set! (-> *target* control camera-pos quad) (-> *target* control trans quad))
      (when (and *camera* (nonzero? *camera*))
        (send-event *camera* 'teleport))))
  (none)
  )

(defun mp-restore-local-target-after-scene! ()
  "Restore the local target's role-specific base state after a scene ends."
  (when (and *target* (nonzero? *target*))
    (if *mp-was-riding-before-scene*
        (begin
          (debug-log *mp-debug-log?* "[MP-Scene-Transition] Scene ended. Restoring ride-along state...~%")
          (set! *has-ridden-before?* #f)
          )
        (begin
          (debug-log *mp-debug-log?* "[MP-Scene-Transition] Scene ended. Restoring base Daxter state...~%")
          (set! *has-ridden-before?* #t)
          )
        )
    )
  (none))

(defun mp-handle-scene-transition ()
  "Handle state changes when entering/exiting scenes"
  (let ((in-scene? (not (not *scene-player*))))
    (when in-scene?
      (mp-record-active-local-scene-name!)
      )

    ;; 1. Handle Exiting Scene
    (when (and *mp-last-scene-player*
               (not in-scene?))
      (when (mp-session-client?)
        (mp-restore-local-target-after-scene!)
        )
      (mp-scene-sync-after-local-end! *mp-active-local-scene-name*)
      (mp-clear-active-local-scene-name!)
      )

    (when (not in-scene?)
      (mp-request-intro-skip-bootstrap-when-ready!)
      (mp-hold-intro-skip-blackout!)
      ;; SAFETY: Force client-side black presentation state off once we are no longer in a scene.
      (if (and *mp-last-scene-player*
               (not *mp-intro-skip-blackout-pending?*))
          (begin
            (debug-log *mp-debug-log?* "[MP-Scene-Transition] Forcing blackout off after scene end.~%")
            (mp-clear-client-presentation-blackout!)
            )
          )
      )

    (set! *mp-last-scene-player* in-scene?)
    )
  (none))
