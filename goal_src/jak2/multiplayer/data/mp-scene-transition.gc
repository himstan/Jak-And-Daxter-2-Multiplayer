;;-*-Lisp-*-
(in-package goal)

(define-extern mp-tomb-scene-sync-suppressed? (function symbol))
(define-extern mp-tomb-scene-transport-suppressed? (function string symbol))

(defun mp-teleport-to-remote ()
  (let ((record (mp-teleport-destination-record)))
    (when (and *target*
               (nonzero? *target*)
               (-> *target* control)
               (nonzero? (-> *target* control))
               record
               (nonzero? record))
      (set! (-> *target* control trans x) (-> record transform position x))
      (set! (-> *target* control trans y) (-> record transform position y))
      (set! (-> *target* control trans z) (-> record transform position z))
      (set! (-> *target* control camera-pos quad) (-> *target* control trans quad))
      (when (and *camera* (nonzero? *camera*))
        (send-event *camera* 'teleport))))
  (none)
  )

(defun mp-restore-local-target-after-scene! ()
  "Restore the local target's role-specific base state after a scene ends."
  (when (and *target* (nonzero? *target*))
    (if *mp-was-riding-before-scene*
        (begin
          (debug-log *mp-debug-log?* "[MP-Scene-Transition] Scene ended. Restoring ride-along state...~%")
          (set! *has-ridden-before?* #f)
          )
        (begin
          (debug-log *mp-debug-log?* "[MP-Scene-Transition] Scene ended. Restoring base Daxter state...~%")
          (set! *has-ridden-before?* #t)
          )
        )
    )
  (none))

(defun mp-scene-catchup-client-connected? ()
  (mp-any-remote-player-connected?)
  )

(defun mp-connected-scene-broadcast-current? ((scene-name string))
  (and scene-name
       (nonzero? scene-name)
       *mp-connected-scene-broadcast-name*
       (nonzero? *mp-connected-scene-broadcast-name*)
       (nonzero? (length *mp-connected-scene-broadcast-name*))
       (string= scene-name *mp-connected-scene-broadcast-name*))
  )

(defun mp-note-connected-scene-broadcast! ((scene-name string))
  "Remember that the active scene was announced after the client connected."
  (when (and (mp-session-host?)
             (mp-scene-catchup-client-connected?)
             scene-name
             (nonzero? scene-name)
             *mp-connected-scene-broadcast-name*
             (nonzero? *mp-connected-scene-broadcast-name*))
    (copy-string<-string *mp-connected-scene-broadcast-name* scene-name)
    )
  (none)
  )

(defun mp-replay-active-scene-for-connected-client! ()
  "Catch up a client that connected after this scene-player started."
  (when (and (mp-session-host?)
             *multi-sync-enabled?*
             (= (pc-multi-get-status) (mp-connection-status in-game))
             (mp-scene-catchup-client-connected?)
             *mp-active-local-scene-name*
             (nonzero? *mp-active-local-scene-name*)
             (nonzero? (length *mp-active-local-scene-name*)))
    (cond
      ((mp-local-scene-aborted?)
       (when (not *mp-aborted-scene-catchup-logged?*)
         (debug-log *mp-debug-log?* "[MP-Scene-Transition] Suppressing catch-up broadcast for aborted scene-player.~%")
         (set! *mp-aborted-scene-catchup-logged?* #t)
         )
       )
      ((mp-tomb-scene-transport-suppressed? *mp-active-local-scene-name*)
       (debug-log *mp-debug-log?* "[MP-Scene-Transition] Suppressing tomb scene catch-up: ~S~%"
               *mp-active-local-scene-name*)
       )
      ((not (mp-connected-scene-broadcast-current? *mp-active-local-scene-name*))
       (debug-log *mp-debug-log?* "[MP-Scene-Transition] Broadcasting catch-up scene start: ~S~%"
               *mp-active-local-scene-name*)
       (mp-event-hook-scene! (mp-scene-state started) *mp-active-local-scene-name*)
       )
      )
    )
  (none)
  )

(defun mp-clear-player-scene-latch! ((record mp-player-record))
  (when (and record (nonzero? record))
    (set! (-> record action scene-latched?) (the uint8 0))
    (set! (-> record action last-replayed-sequence) (the uint 0)))
  (none)
  )

(defun mp-reconcile-remote-scene-latch! ()
  "Let each player's fresh heartbeat retire only that player's scene latch."
  (when (not *mp-pending-scene-sync?*)
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (mp-player-record-remote? *mp-player-controller* record)
                   (nonzero? (-> record action scene-latched?))
                   (or (zero? (-> record connection status))
                       (and (zero? (-> record action scene-state))
                            (!= (-> record connection latest-state-sequence)
                                (-> record action last-replayed-sequence)))))
          (debug-log *mp-debug-log?*
            "[MP-Scene-Transition] Clearing player ~D scene latch after fresh inactive heartbeat.~%"
            player-id)
          (mp-clear-player-scene-latch! record)))))
  (none)
  )

(defun mp-handle-scene-transition ()
  "Handle state changes when entering/exiting scenes"
  (mp-reconcile-remote-scene-latch!)
  (let ((in-scene? (not (not *scene-player*))))
    (when in-scene?
      (mp-record-active-local-scene-name!)
      (if (mp-scene-catchup-client-connected?)
          (mp-replay-active-scene-for-connected-client!)
          (mp-clear-connected-scene-broadcast!)
          )
      )

    ;; 1. Handle Exiting Scene
    (when (and *mp-last-scene-player*
               (not in-scene?))
      (when (mp-session-client?)
        (mp-restore-local-target-after-scene!)
        )
      (mp-scene-sync-after-local-end! *mp-active-local-scene-name*)
      (mp-clear-active-local-scene-name!)
      (mp-clear-connected-scene-broadcast!)
      )

    (when (not in-scene?)
      (set! *mp-aborted-scene-catchup-logged?* #f)
      (mp-request-intro-skip-bootstrap-when-ready!)
      (mp-hold-intro-skip-blackout!)
      (set! *mp-remote-wants-skip* #f)
      (set! *mp-local-wants-skip* #f)
      ;; SAFETY: Force client-side black presentation state off once we are no longer in a scene.
      (if (and *mp-last-scene-player*
               (not *mp-intro-skip-blackout-pending?*))
          (begin
            (debug-log *mp-debug-log?* "[MP-Scene-Transition] Forcing blackout off after scene end.~%")
            (mp-clear-client-presentation-blackout!)
            )
          )
      )

    (set! *mp-last-scene-player* in-scene?)
    )
  (none))
