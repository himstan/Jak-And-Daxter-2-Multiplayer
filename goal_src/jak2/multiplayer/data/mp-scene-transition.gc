;;-*-Lisp-*-
(in-package goal)

(define-extern mp-request-intro-skip-bootstrap-when-ready! (function none))
(define-extern mp-hold-intro-skip-blackout! (function none))
(define-extern mp-update-player-target-visibility! (function target symbol none))

(defun mp-handle-scene-transition ()
  (let ((in-scene? (not (not *scene-player*))))
    (when in-scene?
      (mp-record-active-local-scene-name!))
    (when (and *mp-last-scene-player* (not in-scene?))
      (mp-scene-sync-after-local-end! *mp-active-local-scene-name*)
      (mp-clear-active-local-scene-name!)
      (when (and *mp-last-scene-name* (nonzero? (the-as uint *mp-last-scene-name*)))
        (set! (-> *mp-last-scene-name* data 0) (the uint 0)))
      (remove-setting! 'process-mask)
      (remove-setting! 'movie)
      (remove-setting! 'movie-name)
      (apply-settings *setting-control*)
      (when (and *target* (nonzero? *target*))
        (send-event *target* 'draw #t)
        (mp-update-player-target-visibility! *target* #f)))
    (when (not in-scene?)
      (mp-request-intro-skip-bootstrap-when-ready!)
      (mp-hold-intro-skip-blackout!)
      (if (and *mp-last-scene-player* (not *mp-intro-skip-blackout-pending?*))
        (begin
          (log 'debug "[MP-Scene-Transition] Forcing blackout off after scene end.~%")
          (mp-clear-client-presentation-blackout!))))
    (set! *mp-last-scene-player* in-scene?))
  (none))
