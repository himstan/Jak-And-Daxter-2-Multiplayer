;;-*-Lisp-*-
(in-package goal)

(define-extern num-func-loop! (function joint-control-channel float float float float :behavior process))
(define-extern num-func-loop-speedless! (function joint-control-channel float float float float :behavior process))
(define-extern num-func-seek! (function joint-control-channel float float float float :behavior process))
(define-extern num-func-none (function joint-control-channel float float float float :behavior process))

(declare-type squid-grenade projectile)
(declare-type parking-spot process-drawable)
(declare-type camera-start process-hidden)
(declare-type security-wall process-drawable)
(declare-type centurion nav-enemy)

(defun mp-battle-enemy-id? ((aid uint))
  "True if the AID is a dynamic battle-spawned enemy ID."
  (and (>= aid #x60000000) (< aid #x70000000))
  )

(define *mp-dead-aid-perm-full-logged?* #f)

(defun mp-mark-aid-dead-perm! ((aid uint))
  "Record an actor AID as dead in the existing save perm-list."
  (when (or (zero? aid) (mp-battle-enemy-id? aid))
    (return #f)
    )
  (when (not (and *game-info* (nonzero? *game-info*)))
    (return #f)
    )
  (let ((game-perms (-> *game-info* perm-list)))
    (when (not (and game-perms (nonzero? game-perms)))
      (return #f)
      )
    (let ((perm (actor-perm *game-info* (the-as actor-id aid))))
      (if (and perm (nonzero? perm))
          (begin
            (logior! (-> perm status) (entity-perm-status dead))
            (return #t)
            )
          )
      )
    (if (< (-> game-perms length) (-> game-perms allocated-length))
        (let ((new-perm (-> game-perms data (-> game-perms length))))
          (set! (-> new-perm quad) (the-as uint128 0))
          (set! (-> new-perm aid) (the-as actor-id aid))
          (set! (-> new-perm status) (entity-perm-status dead))
          (+! (-> game-perms length) 1)
          (return #t)
          )
        (when (not *mp-dead-aid-perm-full-logged?*)
          (format 0 "[MP-Tombstone] Could not store dead AID ~D: perm-list is full.~%" aid)
          (set! *mp-dead-aid-perm-full-logged?* #t)
          )
        )
    )
  #f
  )

(defun mp-aid-dead-perm? ((aid uint))
  "True if an actor AID is already tombstoned as dead."
  (when (or (zero? aid) (mp-battle-enemy-id? aid) (not (and *game-info* (nonzero? *game-info*))))
    (return #f)
    )
  (let ((perm (actor-perm *game-info* (the-as actor-id aid))))
    (and perm
         (nonzero? perm)
         (logtest? (-> perm status) (entity-perm-status dead))
         )
    )
  )

(defun mp-deactivate-dead-aid-if-loaded! ((aid uint))
  "Apply a dead-AID tombstone to a loaded entity/process if it exists."
  (when (or (not (mp-aid-dead-perm? aid)) (mp-battle-enemy-id? aid))
    (return #f)
    )
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (let ((perm (-> ent extra perm)))
        (when (and perm (nonzero? perm))
          (logior! (-> perm status) (entity-perm-status dead))
          )
        )
      (let ((proc (-> ent extra process)))
        (when (and proc (nonzero? proc))
          (format 0 "[MP-Tombstone] Deactivating loaded dead AID ~D proc=~A.~%" aid proc)
          (deactivate proc)
          (return #t)
          )
        )
      )
    )
  #f
  )

(defun mp-current-active-level-hash ()
  "Return a stable hash for the currently active local level."
  (let ((hash (the-as uint 0)))
    (when (and *level* (nonzero? *level*))
      (let ((lev (-> *level* level 0)))
        (when (and lev (nonzero? lev) (= (-> lev status) 'active))
          (let ((lev-name (-> lev name)))
            (when (and lev-name (nonzero? lev-name))
              (set! hash (string-crc32 (symbol->string lev-name)))
              )
            )
          )
        )
      )
    hash
    )
  )

(defun mp-should-block-break-sync? ((proc process))
  "BREAK events are for simple destructibles, not traffic, enemies, or actors."
  (and proc
       (nonzero? proc)
       (not (type? proc crate))
       (or (type? proc citizen)
           (type? proc vehicle)
           (type? proc enemy)
           (type? proc bot)
           (type? proc process-focusable)
           (type? proc com-airlock)
           (type? proc squid)
           (type? proc squid-grenade)
           (type? proc guard-shot)
           (type? proc battle)
           (type? proc part-spawner)
           (type? proc parking-spot)
           (type? proc scene-stage)
           (type? proc camera-start)
           (type? proc security-wall)
           (type? proc guard-lazer-shot)
           (type? proc centurion)
           (type-type? (-> proc type) part-spawner)
           (type-type? (-> proc type) parking-spot)
           (type-type? (-> proc type) scene-stage)
           (type-type? (-> proc type) camera-start)
           (type-type? (-> proc type) security-wall)
           )
       )
  )

(defun is-in-pausable-state? ((state-name symbol))
  (case state-name
        (('knocked 'get-up-front 'get-up-back 'die 'die-falling 'die-fast)
          #t
          )
        (else #f)
        )
)

(defun is-enemy-in-pausable-state? ((e enemy))
  (let ((state-name (if (-> e state) (-> e state name) #f)))
    (is-in-pausable-state? state-name)
    )
  )

(defun mp-enemy-death-presentation-active? ((e enemy))
  "True once a loaded enemy should finish its local death presentation."
  (and e
       (nonzero? e)
       (or (logtest? (-> e enemy-flags) (enemy-flag death-start mp-synced-death stop-syncing))
           (is-enemy-in-pausable-state? e))
       )
  )

(defun is-ghost-in-pausable-state? ((rec mp-traffic-ghost-record))
  (let ((state-name (if (and rec (-> rec ghost-state-id)) (mp-target-get-state-from-id (-> rec ghost-state-id)) #f)))
    (is-in-pausable-state? state-name)
    )
  )

(defun should-pause-sync? ((e enemy) (rec mp-traffic-ghost-record))
  (or (logtest? (-> e enemy-flags) (enemy-flag stop-syncing))
      (is-enemy-in-pausable-state? e)
      (is-ghost-in-pausable-state? rec))
  )

(define *mp-current-remote-hit-sound-id* (the-as uint32 0))

(defun mp-hit-sound-id-from-attack-mode ((mode symbol))
  "Map a target attack mode to the connect sound played by target-send-attack."
  (cond
    ((or (= mode 'spin) (= mode 'spin-air))
     (the-as uint (mp-hit-sound-id spin))
     )
    ((or (= mode 'punch) (= mode 'flip) (= mode 'flut-attack))
     (the-as uint (mp-hit-sound-id punch))
     )
    ((= mode 'uppercut)
     (the-as uint (mp-hit-sound-id uppercut))
     )
    ((or (= mode 'flop) (= mode 'flop-down))
     (the-as uint (mp-hit-sound-id flop))
     )
    ((= mode 'board-spin)
     (the-as uint (mp-hit-sound-id board-spin))
     )
    ((= mode 'mech-punch)
     (the-as uint (mp-hit-sound-id mech-punch))
     )
    (else
     (the-as uint (mp-hit-sound-id spin))
     )
    )
  )

(defun mp-hit-sound-id-from-attack-info ((info attack-info))
  (if (and info (nonzero? info))
      (mp-hit-sound-id-from-attack-mode (-> info mode))
      (the-as uint (mp-hit-sound-id spin))
      )
  )

(defun mp-play-remote-hit-sound! ((e-proc enemy) (hit-sound-id uint))
  "Play the initiator-side hit connect sound for an accepted remote-player hit."
  (when (and e-proc (nonzero? e-proc))
    (case hit-sound-id
      (((the-as uint (mp-hit-sound-id punch)))
       (sound-play-by-spec (static-sound-spec "punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id uppercut)))
       (sound-play-by-spec (static-sound-spec "uppercut-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id flop)))
       (sound-play-by-spec (static-sound-spec "flop-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id board-spin)))
       (sound-play-by-spec (static-sound-spec "board-impact" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id mech-punch)))
       (sound-play-by-spec (static-sound-spec "mech-punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (else
       (sound-play-by-spec (static-sound-spec "spin-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      )
    )
  (none)
  )

(defun mp-is-local-attacker? ((proc process))
  "Is the process either the local target or in its parentage (e.g., projectile)?"
  (if (or (not proc) (zero? proc)) (return #f))
  (let ((curr proc))
    (while (and curr (nonzero? curr))
      (if (= curr *target*) (return #t))
      (set! curr (if (and (-> curr parent) (nonzero? (-> curr parent))) (the-as process (ppointer->process (-> curr parent))) (the-as process #f)))
      )
    )
  #f)

(defun mp-is-remote-attacker? ((proc process))
  "Is the process either the remote puppet or in its parentage (e.g., projectile)?"
  (if (or (not proc) (zero? proc)) (return #f))
  (let ((puppet *mp-puppet*))
    (if (not puppet) (return #f))
    (let ((curr proc))
      (while (and curr (nonzero? curr))
        (if (= curr puppet) (return #t))
        (set! curr (if (and (-> curr parent) (nonzero? (-> curr parent))) (the-as process (ppointer->process (-> curr parent))) (the-as process #f)))
        )
      )
    )
  #f)

;; --- Generic Puppet States ---

(defun mp-handle-process-entity-status! ((arg0 process) (arg1 entity-perm-status) (arg2 symbol))
  ;; Detect when an entity is being marked as dead or task-complete locally
  (when (and arg2
             (logtest? (the-as int arg1) (the-as int (logior (entity-perm-status dead) (entity-perm-status subtask-complete))))
             (not *mp-processing-remote-event*)
             (mp-is-jak?) ;; CRITICAL: Only the Host (Jak) should broadcast world-status changes (BREAK events)
             arg0
             (nonzero? arg0)
             (-> arg0 entity)
             (nonzero? (-> arg0 entity))
             (not (movie?))
             (not (mp-should-block-break-sync? arg0))
             )
    (format 0 "[MP-WorldEvent] Sending BREAK for process ~A~%" arg0)
    (mp-send-world-event MP_EVENT_BREAK (-> arg0 entity aid)))
  (none)
  )

(defun mp-send-world-event ((etype uint) (aid uint))
  "Send a world event to the network buffer (Outbound)."
  ;; GUARD: Only send if synced and in-game
  (if (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) 6))
      (return #f))
  (let ((q-idx *mp-event-queue-write-ptr*))
    ;; (format 0 "[MP-Queue-Debug] Queueing event ~D for AID ~D at index ~D~%" etype aid q-idx)
    (let ((evt (the-as mp-world-event (-> *mp-event-queue* q-idx))))
      (set! (-> evt etype) etype)
      (set! (-> evt aid) (the-as uint32 aid))
      )
    (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
    )
  (none))

(defun mp-send-enemy-gem-pickup-event ((source-id uint) (gem-index uint))
  "Send pickup for a skull gem spawned by an enemy."
  (if (or (not *multi-sync-enabled?*)
          (!= (pc-multi-get-status) 6)
          *mp-processing-remote-event*
          (zero? source-id))
      (return #f))
  (let ((q-idx *mp-event-queue-write-ptr*))
    (let ((evt (the-as mp-enemy-gem-event (-> *mp-event-queue* q-idx))))
      (set! (-> evt etype) MP_EVENT_ENEMY_GEM)
      (set! (-> evt source-id) (the-as uint32 source-id))
      (set! (-> evt gem-index) (the-as uint32 gem-index))
      )
    (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
    )
  (none))

(defun mp-enemy-get-death-hint ((e-proc enemy))
  "Capture the visual death path the owner is starting."
  (when (and e-proc (nonzero? e-proc))
    (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f))
          (info (-> e-proc enemy-info)))
      (cond
        ((= cur-state 'die-fast)
         (mp-enemy-death-hint die-fast)
         )
        ((and info (nonzero? info)
              (-> info use-die-falling)
              (or (= cur-state 'die-falling)
                  (= cur-state 'knocked)
                  (= cur-state 'knocked-vicinity)
                  (!= (-> e-proc incoming knocked-type) (knocked-type knocked-type-0))))
         (mp-enemy-death-hint die-falling)
         )
        (else
         (mp-enemy-death-hint die)
         )
        )
      )
    )
  )

(define-extern scene-lookup (function basic scene))

(defun mp-multiplayer-scene-or-load-active? ()
  "True while local/remote cutscene or level paging state can make gameplay death/sync unsafe."
  (the symbol
    (or *scene-player*
        (movie?)
        (real-movie?)
        (and *level*
             (nonzero? *level*)
             (-> *level* loading-level)
             (-> *level* default-level)
             (!= (-> *level* loading-level) (-> *level* default-level)))
        (and *remote-info*
             (nonzero? *remote-info*)
             (nonzero? (-> *remote-info* scene-active)))
        )
    )
  )

(defun mp-scene-sync-active-or-pending? ()
  "True while local or remote scene sync still owns actors, grabs, or level paging."
  (the symbol
    (or (mp-multiplayer-scene-or-load-active?)
        *mp-pending-scene-sync?*
        )
    )
  )

(defun mp-should-suppress-local-endlessfall? ()
  "Suppress bogus player endlessfall while MP cutscene/level transitions own the world."
  (the symbol
    (and *multi-sync-enabled?*
         (= (pc-multi-get-status) 6)
         (mp-multiplayer-scene-or-load-active?))
    )
  )

