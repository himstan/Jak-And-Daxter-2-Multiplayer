(defun mp-level-symbol->id ((level-name symbol))
  (when (and level-name *mp-level-id-table* (nonzero? *mp-level-id-table*))
    (dotimes (idx (-> *mp-level-id-table* length))
      (when (= (-> *mp-level-id-table* idx) level-name)
        (return (the-as uint (+ idx 1))))))
  (the uint 0))

(defun mp-level-id->symbol ((level-id uint))
  (let ((idx (- (the int (logand level-id #xffff)) 1)))
    (if (and *mp-level-id-table* (nonzero? *mp-level-id-table*) (>= idx 0) (< idx (-> *mp-level-id-table* length)))
      (-> *mp-level-id-table* idx)
      #f)))

(defun mp-fort-elec-gate-remote-level-ready? ()
  (when (not (mp-session-in-game?))
    (return #t))
  (when (not (and *load-state* (nonzero? *load-state*)))
    (return #t))
  (let ((local-level-id (mp-level-symbol->id (-> *load-state* vis-nick))))
    (mp-for-each-player-record (player-id record)
      (when (and (is-record-remote-player? record) (>= (-> record connection activity) (mp-player-activity lobby)))
        (let ((remote-level-id (mp-player-primary-level-id record)))
          (when (and (nonzero? local-level-id) (nonzero? remote-level-id) (!= local-level-id remote-level-id))
            (return #f)))))
    #t))

(defun mp-city-level? ((level-name symbol))
  (case level-name
    (('ctywide
      'ctysluma
      'ctyslumb
      'ctyslumc
      'ctyinda
      'ctyindb
      'ctygena
      'ctygenb
      'ctygenc
      'ctyfarma
      'ctyfarmb
      'ctymarka
      'ctymarkb
      'ctyport
      'ctypal
      'ctykora
      'ctyasha
      'stadium)
     #t)
    (else #f)))

(defun mp-current-active-level-symbol ()
  (when (and *target* (nonzero? *target*) (-> *target* current-level) (nonzero? (-> *target* current-level)))
    (let ((target-level (-> *target* current-level))) (when (-> target-level name) (return (-> target-level name)))))
  (when (and *level* (nonzero? *level*))
    (let ((lev (-> *level* level 0)))
      (when (and lev (nonzero? lev) (= (-> lev status) 'active))
        (let ((level-name (-> lev name))) (when level-name (return level-name))))))
  #f)

(defun mp-current-active-level-id ()
  (let ((level-name (mp-current-active-level-symbol))) (if level-name (mp-level-symbol->id level-name) (the uint 0))))

(defun mp-level-active? ((level-name symbol))
  (if (and level-name *level* (nonzero? *level*))
    (let ((status (level-status *level* level-name))) (or (= status 'active) (= status 'alive) (= status 'loaded)))
    #f))

(defun mp-player-primary-level-id ((record mp-player-record))
  (if (and record (nonzero? record)) (the-as uint (-> record transform levels 0 level-id)) (the uint 0)))

(defun mp-level-display->mode ((display symbol))
  (cond
    ((not display) (the uint 0))
    ((= display 'display) (the uint 1))
    ((= display 'special) (the uint 2))
    ((= display 'display-no-wait) (the uint 3))
    (else (the uint 0))))

(defun mp-level-mode->display ((flags uint))
  (let ((mode (logand flags MP_PLAYER_LEVEL_MODE_MASK)))
    (cond
      ((= mode 1) 'display)
      ((= mode 2) 'special)
      ((= mode 3) 'display-no-wait)
      (else #f))))

(defun mp-level-flags-borrow-owner-index ((flags uint))
  (let ((encoded (logand (shr flags MP_PLAYER_LEVEL_BORROW_OWNER_SHIFT) #x7))) (if (> encoded 0) (- encoded 1) -1)))

(defun mp-level-flags-borrow-slot ((flags uint))
  (if (nonzero? (logand flags MP_PLAYER_LEVEL_BORROW_SLOT)) 1 0))

(defun mp-level-borrow? ((level-name symbol))
  (and level-name (= (-> (lookup-level-info level-name) memory-mode) (load-buffer-mode borrow))))

(defun mp-symbol-array-index ((arr (pointer symbol)) (len int) (value symbol))
  (dotimes (idx len)
    (when (= (-> arr idx) value)
      (return idx)))
  -1)

(defun mp-symbol-array-has? ((arr (pointer symbol)) (len int) (value symbol))
  (>= (mp-symbol-array-index arr len value) 0))

(defun mp-level-find-want-index ((level-name symbol))
  (when (and level-name *load-state* (nonzero? *load-state*))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (when (= (-> *load-state* want idx name) level-name)
        (return idx))))
  -1)

(defun mp-level-current-display ((level-name symbol))
  (let ((want-idx (mp-level-find-want-index level-name)))
    (when (>= want-idx 0)
      (return (-> *load-state* want want-idx display?))))
  (when (and *level* (nonzero? *level*))
    (let ((lev (level-get *level* level-name))) (when (and lev (nonzero? lev)) (return (-> lev display?)))))
  #f)

(defun mp-level-current-force-vis ((level-name symbol))
  (let ((want-idx (mp-level-find-want-index level-name)))
    (when (>= want-idx 0)
      (return (-> *load-state* want want-idx force-vis?))))
  (when (and *level* (nonzero? *level*))
    (let ((lev (level-get *level* level-name))) (when (and lev (nonzero? lev)) (return (-> lev force-all-visible?)))))
  #f)

(defun mp-level-current-force-inside ((level-name symbol))
  (let ((want-idx (mp-level-find-want-index level-name)))
    (when (>= want-idx 0)
      (return (-> *load-state* want want-idx force-inside?))))
  (when (and *level* (nonzero? *level*))
    (let ((lev (level-get *level* level-name))) (when (and lev (nonzero? lev)) (return (-> lev force-inside?)))))
  #f)

(defun mp-level-borrow-metadata-flags ((child-name symbol) (names (pointer symbol)))
  (when (and child-name *level* (nonzero? *level*))
    (let ((child (level-get *level* child-name)))
      (when (and child (nonzero? child) (-> child borrow-from-level) (nonzero? (-> child borrow-from-level)))
        (let* ((owner (-> child borrow-from-level))
               (owner-idx (mp-symbol-array-index names MP_PLAYER_LEVEL_SLOT_COUNT (-> owner name))))
          (when (>= owner-idx 0)
            (dotimes (borrow-slot 2)
              (when (= (-> owner borrow-level borrow-slot) child)
                (return (the-as uint
                                (logior (shl (+ owner-idx 1) MP_PLAYER_LEVEL_BORROW_OWNER_SHIFT)
                                        (if (= borrow-slot 1) MP_PLAYER_LEVEL_BORROW_SLOT 0)))))))))))
  (dotimes (owner-idx MP_PLAYER_LEVEL_SLOT_COUNT)
    (let ((owner-name (-> names owner-idx)))
      (when (and owner-name (not (mp-level-borrow? owner-name)))
        (let ((owner-info (lookup-level-info owner-name)))
          (dotimes (borrow-slot 2)
            (when (and (= (-> owner-info borrow-level borrow-slot) child-name)
                       (nonzero? (-> owner-info borrow-size borrow-slot)))
              (return (the-as uint
                              (logior (shl (+ owner-idx 1) MP_PLAYER_LEVEL_BORROW_OWNER_SHIFT)
                                      (if (= borrow-slot 1) MP_PLAYER_LEVEL_BORROW_SLOT 0))))))))))
  (the uint 0))

(defun mp-level-borrow-policy-display ((flags uint) (names (pointer symbol)))
  (let ((owner-idx (mp-level-flags-borrow-owner-index flags)))
    (when (and (>= owner-idx 0) (< owner-idx MP_PLAYER_LEVEL_SLOT_COUNT))
      (let ((owner-name (-> names owner-idx)))
        (when owner-name
          (return (-> (lookup-level-info owner-name) borrow-display? (mp-level-flags-borrow-slot flags)))))))
  #f)

(defun mp-level-pack-slot-flags ((level-name symbol) (names (pointer symbol)))
  (let ((flags (the uint 0)))
    (cond
      ((mp-level-borrow? level-name)
       (let ((borrow-flags (mp-level-borrow-metadata-flags level-name names)))
         (logior! flags borrow-flags)
         (if (>= (mp-level-flags-borrow-owner-index borrow-flags) 0)
           (logior! flags (mp-level-display->mode (mp-level-borrow-policy-display borrow-flags names)))
           (logior! flags (mp-level-display->mode (mp-level-current-display level-name))))))
      (else
       (logior! flags (mp-level-display->mode (mp-level-current-display level-name)))
       (when (mp-level-current-force-vis level-name)
         (logior! flags MP_PLAYER_LEVEL_FORCE_VIS))
       (when (mp-level-current-force-inside level-name)
         (logior! flags MP_PLAYER_LEVEL_FORCE_INSIDE))))
    flags))

(defun mp-pack-local-level-state! ((record mp-player-record))
  (when (and record (nonzero? record))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (set! (-> record transform levels idx level-id) (the uint8 0))
      (set! (-> record transform levels idx flags) (the uint8 0)))
    (when (and *load-state* (nonzero? *load-state*))
      (add-borrow-levels *load-state*))
    (let ((primary-level (mp-current-active-level-symbol)))
      (when (and primary-level (> (mp-level-symbol->id primary-level) 0))
        (let ((names (new 'stack-no-clear 'array 'symbol MP_PLAYER_LEVEL_SLOT_COUNT))
              (next-idx 1)
              (has-valid-wants? #f))
          (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
            (set! (-> names idx) #f))
          (set! (-> names 0) primary-level)
          (when (and *load-state* (nonzero? *load-state*))
            (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
              (let ((level-name (-> *load-state* want idx name)))
                (when (and level-name (> (mp-level-symbol->id level-name) 0))
                  (set! has-valid-wants? #t)
                  (when (and (< next-idx MP_PLAYER_LEVEL_SLOT_COUNT)
                             (not (mp-symbol-array-has? names next-idx level-name)))
                    (set! (-> names next-idx) level-name)
                    (+! next-idx 1))))))
          (when (and (not has-valid-wants?) *level* (nonzero? *level*))
            (dotimes (idx (-> *level* length))
              (let ((lev (-> *level* level idx)))
                (when (and lev
                           (nonzero? lev)
                           (or (= (-> lev status) 'active) (= (-> lev status) 'alive) (= (-> lev status) 'loaded)))
                  (let ((level-name (-> lev name)))
                    (when (and level-name
                               (> (mp-level-symbol->id level-name) 0)
                               (< next-idx MP_PLAYER_LEVEL_SLOT_COUNT)
                               (not (mp-symbol-array-has? names next-idx level-name)))
                      (set! (-> names next-idx) level-name)
                      (+! next-idx 1)))))))
          (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
            (let ((level-name (-> names idx)))
              (when level-name
                (set! (-> record transform levels idx level-id) (the-as uint8 (mp-level-symbol->id level-name)))
                (set! (-> record transform levels idx flags) (the-as uint8 (mp-level-pack-slot-flags level-name names))))))))))
  (none))

(defun mp-player-level-state-symbols! ((record mp-player-record) (out-symbols (pointer symbol)))
  (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
    (set! (-> out-symbols idx) #f)
    (let ((level-id (the-as uint (-> record transform levels idx level-id))))
      (when (> level-id 0)
        (set! (-> out-symbols idx) (mp-level-id->symbol level-id)))))
  (none))

(defun mp-player-level-state-valid? ((record mp-player-record) (names (pointer symbol)))
  (let ((saw-empty? #f))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (let* ((slot (-> record transform levels idx))
             (level-id (the-as uint (-> slot level-id)))
             (flags (the-as uint (-> slot flags)))
             (level-name (-> names idx)))
        (cond
          ((zero? level-id) (when (nonzero? flags) (return #f)) (set! saw-empty? #t))
          (else
           (when (or saw-empty? (not level-name))
             (return #f))
           (dotimes (prev idx)
             (when (= (-> record transform levels prev level-id) (-> slot level-id))
               (return #f)))
           (let* ((owner-encoded (logand (shr flags MP_PLAYER_LEVEL_BORROW_OWNER_SHIFT) #x7))
                  (owner-idx (mp-level-flags-borrow-owner-index flags))
                  (borrow-slot (mp-level-flags-borrow-slot flags)))
             (when (= owner-encoded 7)
               (return #f))
             (cond
               ((< owner-idx 0)
                (when (or (nonzero? (logand flags MP_PLAYER_LEVEL_BORROW_SLOT)) (mp-level-borrow? level-name))
                  (return #f)))
               (else
                (when (or (>= owner-idx MP_PLAYER_LEVEL_SLOT_COUNT)
                          (= owner-idx idx)
                          (not (-> names owner-idx))
                          (not (mp-level-borrow? level-name))
                          (mp-level-borrow? (-> names owner-idx)))
                  (return #f))
                (let ((owner-info (lookup-level-info (-> names owner-idx))))
                  (when (zero? (-> owner-info borrow-size borrow-slot))
                    (return #f)))
                (dotimes (prev idx)
                  (let* ((prev-flags (the-as uint (-> record transform levels prev flags)))
                         (prev-owner (mp-level-flags-borrow-owner-index prev-flags)))
                    (when (and (= prev-owner owner-idx) (= (mp-level-flags-borrow-slot prev-flags) borrow-slot))
                      (return #f))))))))))))
  #t)

(defun mp-level-clear-owner-borrow-slots! ((owner-name symbol))
  (when (and owner-name (not (mp-level-borrow? owner-name)))
    (let ((owner-info (lookup-level-info owner-name)))
      (dotimes (borrow-slot 2)
        (set! (-> owner-info borrow-level borrow-slot) #f)
        (set! (-> owner-info borrow-display? borrow-slot) #f))))
  (none))

(defun mp-level-clear-authoritative-borrow-links! ((incoming-names (pointer symbol)))
  (when (and *load-state* (nonzero? *load-state*))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (let ((level-name (-> *load-state* want idx name)))
        (when level-name
          (mp-level-clear-owner-borrow-slots! level-name)))))
  (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
    (let ((level-name (-> incoming-names idx))) (when level-name (mp-level-clear-owner-borrow-slots! level-name))))
  (none))

(defun mp-level-runtime-borrow-slot ((child level) (owner level))
  (when (and child (nonzero? child) owner (nonzero? owner))
    (dotimes (borrow-slot 2)
      (when (= (-> owner borrow-level borrow-slot) child)
        (return borrow-slot))))
  -1)

(defun mp-level-reload-borrow-on-topology-change! ((record mp-player-record) (names (pointer symbol)))
  (when (and *level* (nonzero? *level*))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (let* ((slot (-> record transform levels idx))
             (flags (the-as uint (-> slot flags)))
             (owner-idx (mp-level-flags-borrow-owner-index flags)))
        (when (>= owner-idx 0)
          (let* ((child-name (-> names idx))
                 (expected-owner-name (-> names owner-idx))
                 (expected-borrow-slot (mp-level-flags-borrow-slot flags))
                 (child (level-get *level* child-name)))
            (when (and child (nonzero? child))
              (let ((actual-owner (-> child borrow-from-level)))
                (when (or (not (and actual-owner (nonzero? actual-owner)))
                          (!= (-> actual-owner name) expected-owner-name)
                          (!= (mp-level-runtime-borrow-slot child actual-owner) expected-borrow-slot))
                  (unload! child)))))))))
  (none))

(defun mp-level-install-borrow-links! ((record mp-player-record) (names (pointer symbol)))
  (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
    (let* ((slot (-> record transform levels idx))
           (flags (the-as uint (-> slot flags)))
           (owner-idx (mp-level-flags-borrow-owner-index flags)))
      (when (>= owner-idx 0)
        (let* ((child-name (-> names idx))
               (owner-name (-> names owner-idx))
               (borrow-slot (mp-level-flags-borrow-slot flags))
               (owner-info (lookup-level-info owner-name))
               (existing-child (-> owner-info borrow-level borrow-slot)))
          (when (and existing-child (!= existing-child child-name))
            (return #f))
          (set! (-> owner-info borrow-level borrow-slot) child-name)
          (set! (-> owner-info borrow-display? borrow-slot) (mp-level-mode->display flags))))))
  #t)

(defun mp-level-set-want-state! ((level-name symbol) (display symbol) (force-vis symbol) (force-inside symbol))
  (let ((want-idx (mp-level-find-want-index level-name)))
    (when (>= want-idx 0)
      (set! (-> *load-state* want want-idx display?) display)
      (set! (-> *load-state* want want-idx force-vis?) force-vis)
      (set! (-> *load-state* want want-idx force-inside?) force-inside)
      (return #t)))
  #f)

(defun mp-level-sync-log-invalid! ((level-id uint))
  (when (>= (current-time) *mp-level-sync-next-unknown-log-time*)
    (log 'warn "[MP-LevelSync] Invalid remote level state near id ~D.~%" level-id)
    (set! *mp-level-sync-next-unknown-log-time* (+ (current-time) (seconds 2))))
  (none))

(defun mp-apply-player-level-state! ((record mp-player-record))
  (when (and record
             (nonzero? record)
             (not (mp-respawn-policy-blocks-remote-placement?))
             *load-state*
             (nonzero? *load-state*))
    (let ((names (new 'stack-no-clear 'array 'symbol MP_PLAYER_LEVEL_SLOT_COUNT)))
      (mp-player-level-state-symbols! record names)
      (when (or (zero? (mp-player-primary-level-id record)) (not (mp-player-level-state-valid? record names)))
        (mp-level-sync-log-invalid! (mp-player-primary-level-id record))
        (return #f))
      (mp-level-reload-borrow-on-topology-change! record names)
      (mp-level-clear-authoritative-borrow-links! names)
      (when (not (mp-level-install-borrow-links! record names))
        (mp-level-sync-log-invalid! (mp-player-primary-level-id record))
        (return #f))
      (let ((base-levels (new 'stack-no-clear 'array 'symbol MP_PLAYER_LEVEL_SLOT_COUNT))
            (base-count 0))
        (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
          (set! (-> base-levels idx) #f))
        (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
          (let* ((slot (-> record transform levels idx))
                 (flags (the-as uint (-> slot flags)))
                 (level-name (-> names idx)))
            (when (and level-name (< (mp-level-flags-borrow-owner-index flags) 0))
              (set! (-> base-levels base-count) level-name)
              (+! base-count 1))))
        (want-levels *load-state* base-levels)
        (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
          (let* ((slot (-> record transform levels idx))
                 (flags (the-as uint (-> slot flags)))
                 (level-name (-> names idx)))
            (when (and level-name (< (mp-level-flags-borrow-owner-index flags) 0))
              (mp-level-set-want-state! level-name
                                        (mp-level-mode->display flags)
                                        (if (nonzero? (logand flags MP_PLAYER_LEVEL_FORCE_VIS)) #t #f)
                                        (if (nonzero? (logand flags MP_PLAYER_LEVEL_FORCE_INSIDE)) #t #f)))))
        (add-borrow-levels *load-state*)
        (want-vis-level *load-state* (-> names 0))
        (return #t))))
  #f)

(defun mp-level-status-ready-for-display? ((level-name symbol) (display symbol))
  (if (and level-name *level* (nonzero? *level*))
    (let ((lev (level-get *level* level-name)))
      (if (and lev (nonzero? lev))
        (let ((status (-> lev status)))
          (if display (= status 'active) (or (= status 'active) (= status 'alive) (= status 'loaded))))
        #f))
    #f))

(defun mp-level-borrow-topology-ready? ((record mp-player-record) (names (pointer symbol)) (idx int))
  (let* ((slot (-> record transform levels idx))
         (flags (the-as uint (-> slot flags)))
         (owner-idx (mp-level-flags-borrow-owner-index flags)))
    (when (< owner-idx 0)
      (return #t))
    (when (and *level* (nonzero? *level*))
      (let* ((child-name (-> names idx))
             (owner-name (-> names owner-idx))
             (child (level-get *level* child-name)))
        (when (and child
                   (nonzero? child)
                   (-> child borrow-from-level)
                   (nonzero? (-> child borrow-from-level))
                   (= (-> child borrow-from-level name) owner-name)
                   (= (mp-level-runtime-borrow-slot child (-> child borrow-from-level))
                      (mp-level-flags-borrow-slot flags)))
          (return #t)))))
  #f)

(defun mp-level-slot-expected-display ((record mp-player-record) (names (pointer symbol)) (idx int))
  (let* ((slot (-> record transform levels idx))
         (flags (the-as uint (-> slot flags)))
         (owner-idx (mp-level-flags-borrow-owner-index flags)))
    (if (< owner-idx 0)
      (mp-level-mode->display flags)
      (let ((owner-want-idx (mp-level-find-want-index (-> names owner-idx))))
        (if (and (>= owner-want-idx 0) (-> *load-state* want owner-want-idx display?)) (mp-level-mode->display flags) #f)))))

(define-perm *mp-level-ready-next-log-time* time-frame 0)

(defun mp-player-level-ready? ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((primary-id (mp-player-primary-level-id record))
          (log? #f))
      (when (>= (current-time) *mp-level-ready-next-log-time*)
        (set! log? #t)
        (set! *mp-level-ready-next-log-time* (+ (current-time) (seconds 2))))
      (when (zero? primary-id)
        (when log?
          (log 'debug "[MP-LevelReady] primary level is zero.~%"))
        (return #f))
      (let ((names (new 'stack-no-clear 'array 'symbol MP_PLAYER_LEVEL_SLOT_COUNT)))
        (mp-player-level-state-symbols! record names)
        (when (not (mp-player-level-state-valid? record names))
          (when log?
            (log 'debug "[MP-LevelReady] advertised state failed validation.~%"))
          (return #f))
        (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
          (let* ((slot (-> record transform levels idx))
                 (level-id (the-as uint (-> slot level-id))))
            (when (> level-id 0)
              (let* ((flags (the-as uint (-> slot flags)))
                     (level-name (-> names idx))
                     (want-idx (mp-level-find-want-index level-name))
                     (expected-display (mp-level-slot-expected-display record names idx))
                     (owner-idx (mp-level-flags-borrow-owner-index flags))
                     (is-borrow? (>= owner-idx 0))
                     (lev (if (and *level* (nonzero? *level*)) (level-get *level* level-name) (the-as level #f))))
                (when (< want-idx 0)
                  (when log?
                    (log 'debug "[MP-LevelReady] slot ~D ~A: missing from want[]. flags=#x~X~%" idx level-name flags))
                  (return #f))
                (when (!= (-> *load-state* want want-idx display?) expected-display)
                  (when log?
                    (log 'debug
                         "[MP-LevelReady] slot ~D ~A: display mismatch actual=~A expected=~A flags=#x~X~%"
                         idx
                         level-name
                         (-> *load-state* want want-idx display?)
                         expected-display
                         flags))
                  (return #f))
                (if is-borrow?
                  (begin
                    (when (or (-> *load-state* want want-idx force-vis?) (-> *load-state* want want-idx force-inside?))
                      (when log?
                        (log 'debug
                             "[MP-LevelReady] slot ~D ~A: borrow has force flags vis=~A inside=~A~%"
                             idx
                             level-name
                             (-> *load-state* want want-idx force-vis?)
                             (-> *load-state* want want-idx force-inside?)))
                      (return #f))
                    (when (not (mp-level-borrow-topology-ready? record names idx))
                      (when log?
                        (let* ((expected-owner (-> names owner-idx))
                               (expected-slot (mp-level-flags-borrow-slot flags))
                               (actual-owner (if (and lev
                                                      (nonzero? lev)
                                                      (-> lev borrow-from-level)
                                                      (nonzero? (-> lev borrow-from-level)))
                                               (-> lev borrow-from-level)
                                               (the-as level #f)))
                               (actual-slot (if actual-owner (mp-level-runtime-borrow-slot lev actual-owner) -1)))
                          (log 'debug
                               ("[MP-LevelReady] slot ~D ~A: BORROW TOPOLOGY mismatch expected-owner=~A expected-slot=~D"
                                idx
                                level-name
                                expected-owner
                                expected-slot)
                               ("actual-owner=~A actual-slot=~D flags=#x~X~%"
                                (if actual-owner (-> actual-owner name) #f)
                                actual-slot
                                flags))))
                      (return #f)))
                  (begin
                    (when (!= (-> *load-state* want want-idx force-vis?)
                              (if (nonzero? (logand flags MP_PLAYER_LEVEL_FORCE_VIS)) #t #f))
                      (when log?
                        (log 'debug "[MP-LevelReady] slot ~D ~A: force-vis mismatch.~%" idx level-name))
                      (return #f))
                    (when (!= (-> *load-state* want want-idx force-inside?)
                              (if (nonzero? (logand flags MP_PLAYER_LEVEL_FORCE_INSIDE)) #t #f))
                      (when log?
                        (log 'debug "[MP-LevelReady] slot ~D ~A: force-inside mismatch.~%" idx level-name))
                      (return #f))))
                (when (not (mp-level-status-ready-for-display? level-name expected-display))
                  (when log?
                    (log 'debug
                         "[MP-LevelReady] slot ~D ~A: status not ready status=~A display=~A flags=#x~X~%"
                         idx
                         level-name
                         (if (and lev (nonzero? lev)) (-> lev status) #f)
                         expected-display
                         flags))
                  (return #f)))))))
      (return #t)))
  #f)

(defun mp-player-primary-level-matches-local? ((record mp-player-record))
  (let ((remote-primary-id (mp-player-primary-level-id record))
        (local-primary-id (mp-current-active-level-id)))
    (the symbol (and (> remote-primary-id 0) (> local-primary-id 0) (= remote-primary-id local-primary-id)))))

(defun mp-ensure-player-level-wanted! ((record mp-player-record))
  (when (and record (nonzero? record))
    (if (> (mp-player-primary-level-id record) 0)
      (mp-apply-player-level-state! record)
      (mp-level-sync-log-invalid! (the uint 0))))
  (none))

(defun mp-player-spectate-level-ready? ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((primary-id (mp-player-primary-level-id record)))
      (when (and (> primary-id 0) (mp-level-id->symbol primary-id))
        (return (mp-player-level-ready? record)))))
  #f)
