;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-level-sync-next-unknown-log-time* time-frame 0)
(define-perm *mp-level-sync-policy-next-log-time* time-frame 0)

(defun mp-level-sync-log-policy-blocked! ()
  (when (and *mp-debug-log?*
             (>= (current-time) *mp-level-sync-policy-next-log-time*))
    (let ((vis-level 'none))
      (when (and *load-state* (nonzero? *load-state*))
        (set! vis-level (-> *load-state* vis-nick))
        )
      (debug-log *mp-debug-log?*
                 "[MP-LevelSync] Remote placement blocked by respawn policy; preserving vis=~S.~%"
                 vis-level)
      (set! *mp-level-sync-policy-next-log-time* (+ (current-time) (seconds 1)))
      )
    )
  (none)
  )

(define *mp-level-id-table* (new 'static 'boxed-array :type symbol
                              'default-level 'intro 'demo 'ctywide 'ctysluma 'hideout 'title 'vinroom
                              'ctyinda 'drillmid 'drill 'drillmtn 'drillb 'sewer 'sewerb 'sewesc
                              'sewescb 'tomba 'tombb 'tombc 'tombe 'tombd 'tombext 'tombboss
                              'under 'underb 'palcab 'palroof 'palshaft 'throne 'palent 'palboss
                              'palout 'outrocst 'lbrnermk 'lashthrn 'lthrnout 'prison 'forexita
                              'introcst 'ldjakbrn 'lprsncst 'forexitb 'ctyslumb 'forresca 'forrescb
                              'fordumpa 'fordumpb 'fordumpc 'fordumpd 'strip 'ruins 'sagehut 'atoll
                              'atollext 'mountain 'mtnext 'mincan 'forest 'forestb 'lwidea 'lwideb
                              'lwidec 'ctykora 'ctyasha 'ctygena 'ctyfarma 'ctygenb 'ctygenc 'ctypal
                              'ctyindb 'ltrntess 'lyskdcd 'ctyslumc 'ljakdax 'ctyport 'hiphog
                              'gungame 'ljkdxash 'ctyfarmb 'ctymarka 'consiteb 'consite 'ctymarkb
                              'kiosk 'stadium 'stadiumd 'stadblmp 'stadiumb 'stadiumc 'skatea 'garage
                              'lwidesta 'lerrol 'lkeirift 'lracelit 'lracebb 'lracebf 'lracecb
                              'lracecf 'lracedb 'lracedf 'lgarcsta 'lsamergd 'lerbrngd 'lsmysbrt
                              'lashgrd 'onintent 'ltentout 'ltentob 'oracle 'ltrnkrkd 'ltrnysam
                              'lysamsam 'lkiddoge 'lhelldog 'lpackage 'lsack 'lportrun 'lshuttle
                              'lmeetbrt 'lpower 'lerlchal 'lprtrace 'lbombbot 'lbbush 'lprotect
                              'ltess 'lhipout 'lwhack 'lguard 'lcguard 'lerltess 'dig1 'caspad
                              'dig3a 'dig3b 'castle 'casboss 'cascity 'casext 'village1 'lcitylow
                              'lintcstb 'nest 'nestb 'portwall 'loutcstb 'island1 'skatepark
                              'halfpipe 'vistest 'woodstest 'tobytest 'chartest 'dptest 'ctyfence
                              '4aaron '4pal01 'andrew01 'bsbs 'eitest 'miketest 'tatetest 'teststdc
                              'teststdd 'wasall 'stadocc 'test-zone
                              )
  )

(defun mp-level-symbol->id ((level-name symbol))
  "Return the reversible MP level id for a level symbol. 0 is reserved for unknown."
  (when (and level-name
             *mp-level-id-table*
             (nonzero? *mp-level-id-table*))
    (dotimes (idx (-> *mp-level-id-table* length))
      (when (= (-> *mp-level-id-table* idx) level-name)
        (return (the-as uint (+ idx 1)))
        )
      )
    )
  (the uint 0)
  )

(defun mp-level-id->symbol ((level-id uint))
  "Resolve a reversible MP level id back to its level symbol."
  (let ((idx (- (the int (logand level-id #xffff)) 1)))
    (if (and *mp-level-id-table*
             (nonzero? *mp-level-id-table*)
             (>= idx 0)
             (< idx (-> *mp-level-id-table* length)))
        (-> *mp-level-id-table* idx)
        #f
        )
    )
  )

(defun mp-level-pack-ids ((primary-id uint) (extra-id uint))
  "Pack the primary level id plus one extra loaded city level into the existing uint32 field."
  (the-as uint (logior (logand primary-id #xff) (shl (logand extra-id #xff) 8)))
  )

(defun mp-level-packed-primary-id ((packed-level uint))
  (the-as uint (logand packed-level #xff))
  )

(defun mp-fort-elec-gate-remote-level-ready? ()
  (when (or (not *multi-sync-enabled?*)
            (!= (pc-multi-get-status) (mp-connection-status in-game)))
    (return #t)
    )
  (when (not (and *load-state* (nonzero? *load-state*)))
    (return #t))
  (let ((local-level-id (mp-level-symbol->id (-> *load-state* vis-nick))))
    (mp-for-each-player-record (player-id record)
      (when (and (mp-player-record-remote? *mp-player-controller* record)
                 (>= (-> record connection status) 4))
        (let ((remote-level-id
                (mp-level-packed-primary-id (-> record transform level))))
          (when (and (nonzero? local-level-id)
                     (nonzero? remote-level-id)
                     (!= local-level-id remote-level-id))
            (return #f)))))
  #t))

(defun mp-level-packed-extra-id ((packed-level uint))
  (the-as uint (logand (shr packed-level 8) #xff))
  )

(defun mp-city-level? ((level-name symbol))
  (case level-name
    (('ctywide 'ctysluma 'ctyslumb 'ctyslumc 'ctyinda 'ctyindb
      'ctygena 'ctygenb 'ctygenc 'ctyfarma 'ctyfarmb 'ctymarka
      'ctymarkb 'ctyport 'ctypal 'ctykora 'ctyasha 'stadium)
     #t
     )
    (else #f)
    )
  )

(defun mp-current-active-level-symbol ()
  "Prefer the local target's actual region, falling back to the first active level slot."
  (when (and *target*
             (nonzero? *target*)
             (-> *target* current-level)
             (nonzero? (-> *target* current-level)))
    (let ((target-level (-> *target* current-level)))
      (when (-> target-level name)
        (return (-> target-level name))
        )
      )
    )
  (when (and *level* (nonzero? *level*))
    (let ((lev (-> *level* level 0)))
      (when (and lev
                 (nonzero? lev)
                 (= (-> lev status) 'active))
        (let ((level-name (-> lev name)))
          (when level-name
            (return level-name)
            )
          )
        )
      )
    )
  #f
  )

(defun mp-array-has-uint8? ((arr (pointer uint8)) (len int) (val uint))
  (dotimes (idx len)
    (if (= (the-as uint (-> arr idx)) val)
        (return #t)
        )
    )
  #f
  )

(defun mp-symbol-array-has? ((arr (pointer symbol)) (len int) (val symbol))
  (dotimes (idx len)
    (if (= (-> arr idx) val)
        (return #t)
        )
    )
  #f
  )

(defun mp-add-desired-level-if-room! ((desired-levels (pointer symbol)) (dest-idx int) (level-name symbol))
  (if (and level-name
           (< dest-idx 6)
           (not (mp-symbol-array-has? desired-levels dest-idx level-name)))
      (begin
        (set! (-> desired-levels dest-idx) level-name)
        (+ dest-idx 1)
        )
      dest-idx
      )
  )

(defun mp-add-city-neighbor-levels! ((desired-levels (pointer symbol)) (dest-idx int) (level-name symbol))
  "Add nearby Haven City partitions for border teleports where the peer has not loaded adjacency yet."
  (case level-name
    (('ctysluma)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyindb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyslumb))
     )
    (('ctyslumb)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctysluma))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygenb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyslumc))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctykora))
     )
    (('ctyslumc)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyslumb))
     )
    (('ctygena)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyfarma))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygenb))
     )
    (('ctygenb)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygena))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyslumb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'stadium))
     )
    (('ctygenc)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctypal))
     )
    (('ctyfarma)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygena))
     )
    (('ctyfarmb)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyport))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarka))
     )
    (('ctyinda)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyindb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyport))
     )
    (('ctyindb)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyinda))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarkb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctysluma))
     )
    (('ctymarka)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyfarmb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarkb))
     )
    (('ctymarkb)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarka))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyindb))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctypal))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyasha))
     )
    (('ctypal)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygenc))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyport))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarkb))
     )
    (('ctyport)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctypal))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyinda))
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyfarmb))
     )
    (('stadium)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctygenb))
     )
    (('ctykora)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctyslumb))
     )
    (('ctyasha)
     (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctymarkb))
     )
    )
  dest-idx
  )

(defun mp-remote-levels-city-only? ((levels (pointer symbol)))
  "Only speculate city neighbors when the advertised remote set has no non-city level."
  (let ((has-city? #f))
    (dotimes (idx 4)
      (let ((lvl (-> levels idx)))
        (when lvl
          (if (mp-city-level? lvl)
              (set! has-city? #t)
              (return #f)
              )
          )
        )
      )
    has-city?
    )
  )

(defun mp-current-active-level-id ()
  "Return the reversible MP level id for the local player's current level."
  (let ((level-name (mp-current-active-level-symbol)))
    (if level-name
        (mp-level-symbol->id level-name)
        (the uint 0)
        )
    )
  )

(defun mp-current-level-packed-id ()
  "Pack the primary and desired levels, falling back to resident levels when no valid wants exist."
  (let ((primary-level (mp-current-active-level-symbol)))
    (if primary-level
        (let ((ids (new 'stack-no-clear 'array 'uint8 4)))
          (set! (-> ids 0) (the uint8 (mp-level-symbol->id primary-level)))
          (set! (-> ids 1) (the uint8 0))
          (set! (-> ids 2) (the uint8 0))
          (set! (-> ids 3) (the uint8 0))
          (let ((next-idx 1)
                (has-valid-wants? #f))
            ;; Desired levels are authoritative because resident levels may be awaiting unload.
            (when (and *load-state* (nonzero? *load-state*))
              (dotimes (idx 6)
                (let ((level-name (-> *load-state* want idx name)))
                  (when level-name
                    (let ((lid (mp-level-symbol->id level-name)))
                      (when (> lid 0)
                        (set! has-valid-wants? #t)
                        (when (and (!= level-name primary-level)
                                   (< next-idx 4)
                                   (not (mp-array-has-uint8? ids next-idx lid)))
                          (set! (-> ids next-idx) (the uint8 lid))
                          (+! next-idx 1)
                          )
                        )
                      )
                    )
                  )
                )
              )
            ;; Fall back only when load-state has no usable desired levels.
            (when (and (not has-valid-wants?)
                       *level*
                       (nonzero? *level*))
              (dotimes (idx 7)
                (let ((lev (-> *level* level idx)))
                  (when (and lev
                             (nonzero? lev)
                             (or (= (-> lev status) 'active)
                                 (= (-> lev status) 'alive)
                                 (= (-> lev status) 'loaded)))
                    (let ((level-name (-> lev name)))
                      (when (and level-name
                                 (!= level-name primary-level)
                                 (< next-idx 4))
                        (let ((lid (mp-level-symbol->id level-name)))
                          (when (and (> lid 0) (not (mp-array-has-uint8? ids next-idx lid)))
                            (set! (-> ids next-idx) (the uint8 lid))
                            (+! next-idx 1)
                            )
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          ;; Pack the 4 uint8 IDs into a single uint32
          (the-as uint (logior (the-as uint (-> ids 0))
                               (shl (the-as uint (-> ids 1)) 8)
                               (shl (the-as uint (-> ids 2)) 16)
                               (shl (the-as uint (-> ids 3)) 24)))
          )
        (the uint 0)
        )
    )
  )

(defun mp-remote-level-symbols-for-teleport! ((packed-level uint) (out-symbols (pointer symbol)))
  "Extract up to 4 loaded levels from the packed uint32 into a preallocated array."
  (dotimes (idx 4)
    (set! (-> out-symbols idx) #f)
    )
  (let ((id0 (logand packed-level #xff))
        (id1 (logand (shr packed-level 8) #xff))
        (id2 (logand (shr packed-level 16) #xff))
        (id3 (logand (shr packed-level 24) #xff)))
    (when (> id0 0)
      (set! (-> out-symbols 0) (mp-level-id->symbol id0))
      )
    (when (> id1 0)
      (set! (-> out-symbols 1) (mp-level-id->symbol id1))
      )
    (when (> id2 0)
      (set! (-> out-symbols 2) (mp-level-id->symbol id2))
      )
    (when (> id3 0)
      (set! (-> out-symbols 3) (mp-level-id->symbol id3))
      )
    )
  (none)
  )

(defun mp-level-active? ((level-name symbol))
  (if (and level-name
           *level*
           (nonzero? *level*))
      (let ((status (level-status *level* level-name)))
        (or (= status 'active)
            (= status 'alive)
            (= status 'loaded)
            )
        )
      #f
      )
  )

(defun mp-player-primary-level-id ((record mp-player-record))
  "Return one player's advertised primary level id."
  (if (and record (nonzero? record))
      (mp-level-packed-primary-id (-> record transform level))
      (the uint 0)
      )
  )

(defun mp-player-primary-level-matches-local? ((record mp-player-record))
  "True when the player and local target occupy the same advertised primary level."
  (let ((remote-primary-id (mp-player-primary-level-id record))
        (local-primary-id (mp-current-active-level-id)))
    (the symbol
         (and (> remote-primary-id 0)
              (> local-primary-id 0)
              (= remote-primary-id local-primary-id)))
    )
  )

(defun mp-level-sync-log-unknown! ((packed-level uint))
  (when (>= (current-time) *mp-level-sync-next-unknown-log-time*)
    (debug-log *mp-debug-log?* "[MP-LevelSync] Remote level id ~D is unknown. Falling back to current teleport behavior.~%"
            packed-level)
    (set! *mp-level-sync-next-unknown-log-time* (+ (current-time) (seconds 2)))
    )
  (none)
  )

(defun mp-want-multiple-levels-for-remote-teleport! ((levels (pointer symbol)))
  "Request expanded level context for intentional multiplayer teleports."
  (when (mp-respawn-policy-blocks-remote-placement?)
    (mp-level-sync-log-policy-blocked!)
    )
  (when (and (not (mp-respawn-policy-blocks-remote-placement?))
             levels
             (nonzero? levels)
             *load-state*
             (nonzero? *load-state*))
    (let ((desired-levels (new 'stack-no-clear 'array 'symbol 6)))
      (dotimes (idx 6)
        (set! (-> desired-levels idx) #f)
        )
      ;; Copy the synced levels into desired-levels
      (let ((dest-idx 0))
        (dotimes (src-idx 4)
          (let ((lvl (-> levels src-idx)))
            (when (and lvl (!= lvl 'ctywide))
              (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx lvl))
              )
            )
          )
        (when (mp-remote-levels-city-only? levels)
          (dotimes (src-idx 4)
            (let ((lvl (-> levels src-idx)))
              (when (and lvl (mp-city-level? lvl) (!= lvl 'ctywide))
                (set! dest-idx (mp-add-city-neighbor-levels! desired-levels dest-idx lvl))
                )
              )
            )
          )
        ;; Always make sure ctywide is in slot 1 or 2 if any level is a city level
        (let ((has-city? #f))
          (dotimes (src-idx 4)
            (let ((lvl (-> levels src-idx)))
              (when (and lvl (mp-city-level? lvl) (!= lvl 'ctywide))
                (set! has-city? #t)
                )
              )
            )
          (when has-city?
            ;; Insert ctywide at the first empty slot
            (set! dest-idx (mp-add-desired-level-if-room! desired-levels dest-idx 'ctywide))
            )
          )
        )
      
      (want-levels *load-state* desired-levels)
      
      ;; Set display for each desired level
      (dotimes (idx 6)
        (let ((lvl (-> desired-levels idx)))
          (when lvl
            (want-display-level *load-state* lvl 'display)
            )
          )
        )
      
      ;; Set visibility level to the primary level (first element of levels)
      (let ((primary (-> levels 0)))
        (when primary
          (want-vis-level *load-state* primary)
          )
        )
      )
    )
  (none)
  )

(defun mp-want-exact-levels-for-spectate! ((levels (pointer symbol)))
  "Request only the levels advertised by the selected spectate player."
  (when (mp-respawn-policy-blocks-remote-placement?)
    (mp-level-sync-log-policy-blocked!)
    )
  (when (and (not (mp-respawn-policy-blocks-remote-placement?))
             levels
             (nonzero? levels)
             *load-state*
             (nonzero? *load-state*))
    (let ((desired-levels (new 'stack-no-clear 'array 'symbol 6))
          (want-levels-input (new 'stack-no-clear 'array 'symbol 6))
          (desired-count 0))
      (dotimes (idx 6)
        (set! (-> desired-levels idx) #f)
        (set! (-> want-levels-input idx) #f)
        )
      (dotimes (idx 4)
        (let ((level-name (-> levels idx)))
          (when level-name
            (set! desired-count
                  (mp-add-desired-level-if-room!
                    desired-levels desired-count level-name))
            )
          )
        )
      (when (> desired-count 0)
        (dotimes (idx desired-count)
          (set! (-> want-levels-input idx) (-> desired-levels idx))
          )
        (want-levels *load-state* want-levels-input)
        (dotimes (idx desired-count)
          (let ((level-name (-> desired-levels idx)))
            (when level-name
              (want-display-level *load-state* level-name 'display)
              )
            )
          )
        (let ((primary-level (-> levels 0)))
          (when primary-level
            (want-vis-level *load-state* primary-level)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-request-player-spectate-levels! ((record mp-player-record))
  "Request the selected player's exact advertised context without inventing levels."
  (when (and record (nonzero? record))
    (let ((packed-level (-> record transform level)))
      (if (> packed-level 0)
          (let ((levels (new 'stack-no-clear 'array 'symbol 4)))
            (mp-remote-level-symbols-for-teleport! packed-level levels)
            (mp-want-exact-levels-for-spectate! levels)
            )
          (mp-level-sync-log-unknown! packed-level)
          )
      )
    )
  (none)
  )

(defun mp-ensure-player-level-wanted! ((record mp-player-record))
  "Request expanded level context before an intentional multiplayer teleport."
  (when (and record (nonzero? record))
    (let ((packed (-> record transform level)))
      (if (> packed 0)
          (let ((symbols (new 'stack-no-clear 'array 'symbol 4)))
            (mp-remote-level-symbols-for-teleport! packed symbols)
            (mp-want-multiple-levels-for-remote-teleport! symbols)
            )
          (mp-level-sync-log-unknown! packed)
          )
      )
    )
  (none)
  )

(defun mp-player-level-ready? ((record mp-player-record))
  "Check if one player's packed levels are currently active on our side."
  (when (and record (nonzero? record))
    (let ((packed (-> record transform level)))
      (if (> packed 0)
          (let ((symbols (new 'stack-no-clear 'array 'symbol 4)))
            (mp-remote-level-symbols-for-teleport! packed symbols)
            (dotimes (idx 4)
              (let ((lvl (-> symbols idx)))
                (when (and lvl (not (mp-level-active? lvl)))
                  (return #f)
                  )
                )
              )
            )
          #t
          )
      )
    )
  #t
  )

(defun mp-player-spectate-level-ready? ((record mp-player-record))
  "Require every advertised selected-player level before taking camera ownership."
  (when (and record (nonzero? record))
    (let ((primary-id (mp-player-primary-level-id record)))
      (when (and (> primary-id 0)
                 (mp-level-id->symbol primary-id))
        (return (mp-player-level-ready? record))
        )
      )
    )
  #f
  )

