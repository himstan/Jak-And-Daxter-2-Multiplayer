;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-bootstrap-wait-log-time* time-frame 0)
(define-perm *mp-bootstrap-local-phase* uint (the-as uint 0))

(deftype mp-bootstrap-controller (process)
  ((destination          mp-player-record :inline)
   (bootstrap-generation uint32)
   (host-lifecycle       uint32)
   (applied?             uint8))
  (:state-methods
   idle
   loading
   wait-for-levels
   applying)
  (:methods
   (mp-close-bootstrap-progress-ui! (_type_) none)
   (mp-force-clear-bootstrap-progress-ui! (_type_) none)
   (mp-bootstrap-client-ready-for-apply? (_type_) object)
   (mp-log-bootstrap-wait! (_type_ symbol) none)
   (mp-log-bootstrap-apply-wait! (_type_) none)
   (mp-copy-host-continue-name! (_type_) int)
   (mp-bootstrap-client-active? (_type_) symbol)
   (mp-bootstrap-sync-flag (_type_) uint)
   (mp-bootstrap-start-load! (_type_) symbol)
   (mp-bootstrap-levels-ready? (_type_) symbol)
   (mp-bootstrap-host-levels-ready? (_type_) symbol)
   (mp-bootstrap-capture-destination! (_type_) symbol)
   (mp-bootstrap-apply-player-values! (_type_) none)
   (mp-bootstrap-apply-task-snapshot! (_type_) none)
   (mp-bootstrap-start-active-task-managers! (_type_) none)
   (mp-bootstrap-deactivate-aid-in-level! (_type_ uint level) none)
   (mp-bootstrap-apply-aids! (_type_) none)
   (mp-bootstrap-place-client! (_type_) symbol)
   (mp-bootstrap-restore-local-camera! (_type_) none)
   (mp-bootstrap-finish! (_type_) none)))

(defmethod mp-close-bootstrap-progress-ui! ((this mp-bootstrap-controller))
  (when (and *progress-process* (nonzero? *progress-process*))
    (log 'debug "[MP-Bootstrap] Closing progress UI for bootstrap load.~%")
    (set-next-state (-> *progress-process* 0) 'go-away 0))
  (none))

(defmethod mp-force-clear-bootstrap-progress-ui! ((this mp-bootstrap-controller))
  (when (and *progress-process* (nonzero? *progress-process*))
    (log 'debug "[MP-Bootstrap] Forcing stale progress UI closed after bootstrap.~%")
    (deactivate (-> *progress-process* 0)))
  (when (and *blit-displays-work* (nonzero? *blit-displays-work*))
    (set! (-> *blit-displays-work* menu-mode) #f))
  (none))

(defmethod mp-bootstrap-client-ready-for-apply? ((this mp-bootstrap-controller))
  (if (and *target* (nonzero? *target*))
    (let ((control (-> *target* control))
          (target-state (-> *target* state))
          (target-next-state (-> *target* next-state)))
      (and control
           (nonzero? control)
           *camera*
           (nonzero? *camera*)
           *camera-combiner*
           (nonzero? *camera-combiner*)
           (not (focus-test? *target* teleporting))
           (not (logtest? (-> *target* focus-status) (focus-status dead)))
           (nonnull? (-> *target* fact))
           (> (-> *target* fact health) 0.0)
           (not (and target-state (nonzero? target-state) (= (-> target-state name) 'target-load-wait)))
           (not (and target-next-state (nonzero? target-next-state) (= (-> target-next-state name) 'target-load-wait)))
           (mp-bootstrap-levels-ready? this)))
    #f))

(defmethod mp-log-bootstrap-wait! ((this mp-bootstrap-controller) (reason symbol))
  (when (>= (- (current-time) *mp-bootstrap-wait-log-time*) (seconds 2))
    (log 'debug "[MP-Bootstrap] Waiting: ~A.~%" reason)
    (set! *mp-bootstrap-wait-log-time* (current-time)))
  (none))

(defmethod mp-log-bootstrap-apply-wait! ((this mp-bootstrap-controller))
  (cond
    ((not (and *target* (nonzero? *target*))) (mp-log-bootstrap-wait! this 'missing-target))
    ((not (and (-> *target* control) (nonzero? (-> *target* control))))
     (mp-log-bootstrap-wait! this 'missing-target-control))
    ((not (and *camera* (nonzero? *camera*))) (mp-log-bootstrap-wait! this 'missing-camera))
    ((not (and *camera-combiner* (nonzero? *camera-combiner*))) (mp-log-bootstrap-wait! this 'missing-camera-combiner))
    ((focus-test? *target* teleporting) (mp-log-bootstrap-wait! this 'target-teleporting))
    ((and (-> *target* state) (nonzero? (-> *target* state)) (= (-> *target* state name) 'target-load-wait))
     (mp-log-bootstrap-wait! this 'target-load-wait))
    ((and (-> *target* next-state)
          (nonzero? (-> *target* next-state))
          (= (-> *target* next-state name) 'target-load-wait))
     (mp-log-bootstrap-wait! this 'target-next-load-wait))
    ((not (and *level* (nonzero? *level*))) (mp-log-bootstrap-wait! this 'missing-level-group))
    ((load-in-progress? *level*) (mp-log-bootstrap-wait! this 'level-load-in-progress))
    ((!= (-> *level* loading-level) (-> *level* default-level)) (mp-log-bootstrap-wait! this 'level-paging-not-idle))
    (else (mp-log-bootstrap-wait! this 'waiting-to-apply)))
  (none))

(defun mp-clear-client-presentation-blackout! ()
  (set-blackout-frames 0)
  (when (and *game-info* (nonzero? *game-info*))
    (set! (-> *game-info* blackout-time) 0))
  (when (and *setting-control* (nonzero? *setting-control*))
    (kill-persister *setting-control* (the-as engine-pers 'blackout) 'bg-a-force)
    (kill-persister *setting-control* (the-as engine-pers 'bg-a) 'bg-a)
    (kill-persister *setting-control* (the-as engine-pers 'bg-a-speed) 'bg-a-speed)
    (remove-setting! 'bg-a)
    (remove-setting! 'bg-a-force)
    (let ((user-default (-> *setting-control* user-default))
          (user-current (-> *setting-control* user-current)))
      (when (and user-default (nonzero? user-default))
        (set! (-> user-default bg-a) 0.0)
        (set! (-> user-default bg-a-force) 0.0))
      (when (and user-current (nonzero? user-current))
        (set! (-> user-current bg-a) 0.0)
        (set! (-> user-current bg-a-force) 0.0)))
    (apply-settings *setting-control*))
  (when (and *screen-filter* (nonzero? *screen-filter*))
    (disable *screen-filter*))
  (when (and *blit-displays-work* (nonzero? *blit-displays-work*))
    (set! (-> *blit-displays-work* menu-mode) #f))
  (when (and *display* (nonzero? *display*))
    (set! (-> *display* pmode alp) 255)
    (put-display-env 255))
  (none))

(defmethod mp-copy-host-continue-name! ((this mp-bootstrap-controller))
  (if (and (nonnull? *mp-continue-name*) (nonnull? (mp-local-player-record)) (nonnull? *mp-bootstrap-state*))
    (let ((dst (-> *mp-continue-name* data))
          (src (-> *mp-bootstrap-state* host-continue))
          (len 0))
      (dotimes (i 32)
        (set! (-> dst i) (the uint 0)))
      (while (and (< len 31) (nonzero? (-> src len)))
        (set! (-> dst len) (-> src len))
        (+! len 1))
      (set! (-> dst len) (the uint 0))
      len)
    0))

(defmethod mp-bootstrap-client-active? ((this mp-bootstrap-controller))
  (the symbol (and (mp-session-client?) (mp-local-player-record) (nonzero? (mp-local-player-record)))))

(defmethod mp-bootstrap-sync-flag ((this mp-bootstrap-controller))
  (when (and (nonnull? this *mp-bootstrap-state*)
             (nonzero? (-> this bootstrap-generation))
             (!= (-> this bootstrap-generation) (-> *mp-bootstrap-state* sequence)))
    (set! *mp-bootstrap-local-phase* (the uint 1)))
  (the uint
       (if (nonnull? (mp-local-player-record) *mp-bootstrap-state*)
         (if (nonzero? *mp-bootstrap-local-phase*) *mp-bootstrap-local-phase* (-> *mp-bootstrap-state* phase))
         0)))

(defun mp-bootstrap-in-progress? ()
  (the symbol
       (and (mp-session-client?)
            (or (nonzero? *mp-bootstrap-local-phase*)
                (and (nonnull? *mp-bootstrap-state*) (nonzero? (-> *mp-bootstrap-state* phase)))))))

(defmethod mp-bootstrap-start-load! ((this mp-bootstrap-controller))
  (let ((name-len (mp-copy-host-continue-name! this)))
    (set! name-len (mp-tomb-boulder-prepare-bootstrap-continue! *mp-continue-name* name-len))
    (cond
      ((zero? name-len) (mp-log-bootstrap-wait! this 'empty-continue) #f)
      ((not (and *game-info*
                 (nonzero? *game-info*)
                 *mp-continue-name*
                 (nonzero? *mp-continue-name*)
                 (get-continue-by-name *game-info* *mp-continue-name*)))
       (mp-log-bootstrap-wait! this 'unknown-continue)
       #f)
      (else
       (set! (-> this bootstrap-generation) (-> *mp-bootstrap-state* sequence))
       (set! (-> this applied?) (the uint8 0))
       (set! (-> this host-lifecycle) (the uint32 0))
       (set! *task-manager-spawn-suppressed?* #t)
       (mp-death-spectate-abort!)
       (mp-close-local-fail-mission!)
       (log 'debug "[MP-Bootstrap] Starting authoritative load for ~S...~%" *mp-continue-name*)
       (mp-close-bootstrap-progress-ui! this)
       (when (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
         (set! *mp-bootstrap-local-phase* (the uint 2))
         (set! (-> *mp-bootstrap-state* phase) (the-as uint 2)))
       (when (and *game-info* (nonzero? *game-info*))
         (set-continue! *game-info* *mp-continue-name* #t)
         (initialize! *game-info* 'game (the-as game-save #f) *mp-continue-name*))
       #t))))

(defmethod mp-bootstrap-capture-destination! ((this mp-bootstrap-controller))
  (let ((host (mp-host-player-record)))
    (when (and (nonnull? this host *mp-replication-state*)
               (nonzero? (-> host identity state-ready?))
               (nonzero? (-> host connection state-cached?))
               (= (-> host connection activity) (mp-player-activity in-game))
               (mp-player-id-valid? (the uint (-> host identity player-id))))
      (let ((source (-> *mp-replication-state* remote players (-> host identity player-id))))
        (when (and (nonzero? (-> source valid?)) (nonzero? (-> source identity state-ready?)))
          (when (!= (-> this host-lifecycle) (-> source lifecycle-generation))
            (set! (-> this applied?) (the uint8 0)))
          (set! (-> this host-lifecycle) (-> source lifecycle-generation))
          (mem-copy! (the-as pointer (-> this destination)) (the-as pointer host) (size-of mp-player-record))
          (vector-copy! (-> this destination transform position) (-> source transform position))
          (vector-copy! (-> this destination transform velocity) (-> source transform velocity))
          (return #t)))))
  #f)

(defmethod mp-bootstrap-host-levels-ready? ((this mp-bootstrap-controller))
  (when (not (mp-bootstrap-capture-destination! this))
    (mp-log-bootstrap-wait! this 'host-state-not-ready)
    (return #f))
  (let ((host-record (-> this destination)))
    (cond
      ((not (nonnull? host-record)) (mp-log-bootstrap-wait! this 'missing-host-record) #f)
      ((zero? (mp-player-primary-level-id host-record)) (mp-log-bootstrap-wait! this 'missing-host-level) #f)
      (else
       (mp-ensure-player-level-wanted! host-record)
       (cond
         ((not (mp-player-level-ready? host-record))
          (set-blackout-frames (seconds 10.0))
          (mp-log-bootstrap-wait! this 'host-levels-not-ready)
          #f)
         ((load-in-progress? *level*) (mp-log-bootstrap-wait! this 'level-load-in-progress) #f)
         ((!= (-> *level* loading-level) (-> *level* default-level))
          (mp-log-bootstrap-wait! this 'bootstrap-level-paging)
          #f)
         (else #t))))))

(defmethod mp-bootstrap-levels-ready? ((this mp-bootstrap-controller))
  (let ((cont (if (and (nonnull? *game-info*) (nonnull? *mp-continue-name*)) (get-continue-by-name *game-info* *mp-continue-name*) #f)))
    (cond
      ((not (nonnull? cont)) (mp-log-bootstrap-wait! this 'missing-bootstrap-continue) #f)
      ((not (nonnull? *level*)) (mp-log-bootstrap-wait! this 'missing-bootstrap-level-group) #f)
      ((mp-tomb-boulder-skip-bootstrap-host-teleport?)
       (let ((cont-level (-> (the-as continue-point cont) level)))
         (cond
           ((not (mp-level-active? cont-level)) (mp-log-bootstrap-wait! this 'bootstrap-level-not-active) #f)
           ((load-in-progress? *level*) (mp-log-bootstrap-wait! this 'level-load-in-progress) #f)
           ((!= (-> *level* loading-level) (-> *level* default-level))
            (mp-log-bootstrap-wait! this 'bootstrap-level-paging)
            #f)
           (else #t))))
      (else (mp-bootstrap-host-levels-ready? this)))))

(defmethod mp-bootstrap-apply-player-values! ((this mp-bootstrap-controller))
  (when (nonnull? *game-info* *mp-world-state* (mp-local-player-record))
    (set! (-> *game-info* money) (-> *mp-world-state* money))
    (set! (-> *game-info* gem) (-> *mp-world-state* gems))
    (set! (-> *game-info* skill) (-> *mp-world-state* skill))
    (set! (-> *game-info* skill-total) (-> *mp-world-state* skill)))
  (none))

(defmethod mp-bootstrap-apply-task-snapshot! ((this mp-bootstrap-controller))
  (when (and *game-info* (nonzero? *game-info*) *mp-world-state* (nonzero? *mp-world-state*))
    (let ((nodes (-> *game-info* sub-task-list))
          (task-mask (-> *mp-world-state* task-mask))
          (changed-count 0))
      (when (and nodes (nonzero? nodes) task-mask (nonzero? task-mask))
        (dotimes (node-id (min 512 (-> nodes length)))
          (let ((node (-> nodes data node-id)))
            (when (and node (nonzero? node))
              (let ((byte-index (/ node-id 8))
                    (bit-index (logand node-id 7))
                    (local-closed? (logtest? (-> node flags) (game-task-node-flag closed))))
                (let ((host-closed? (logtest? (-> task-mask byte-index) (ash 1 bit-index))))
                  (mp-tomb-boulder-note-remote-task-state! node-id host-closed?)
                  (when (!= host-closed? local-closed?)
                    (if host-closed?
                      (begin
                        (logior! (-> node flags) (game-task-node-flag closed))
                        (mp-task-sync-after-remote-close! (the-as game-task-node node-id)))
                      (begin
                        (logclear! (-> node flags) (game-task-node-flag closed))
                        (mp-task-sync-after-remote-open! (the-as game-task-node node-id))))
                    (+! (-> *game-info* task-counter) 1)
                    (+! changed-count 1)))))))
        (set! *task-manager-spawn-suppressed?* #t)
        (update-task-masks 'mp-bootstrap-snapshot)
        (log 'debug "[MP-Bootstrap] Applied task snapshot with ~D changed nodes.~%" changed-count))))
  (none))

(defmethod mp-bootstrap-start-active-task-managers! ((this mp-bootstrap-controller))
  (when (and *game-info* (nonzero? *game-info*) *level* (nonzero? *level*) *mp-world-state* (nonzero? *mp-world-state*))
    (let ((nodes (-> *game-info* sub-task-list))
          (active-mask (-> *mp-world-state* active-task-mask)))
      (when (and nodes (nonzero? nodes) active-mask (nonzero? active-mask))
        (dotimes (node-id (min 512 (-> nodes length)))
          (let ((node (-> nodes data node-id))
                (byte-index (/ node-id 8))
                (bit-index (logand node-id 7)))
            (when (and node
                       (nonzero? node)
                       (logtest? (-> active-mask byte-index) (ash 1 bit-index))
                       (logtest? (-> node flags) (game-task-node-flag task-manager)))
              (let ((manager-info (-> node info)))
                (when (and manager-info (nonzero? manager-info))
                  (let ((manager-level (-> manager-info level))
                        (manager (handle->process-safe (-> manager-info manager))))
                    (when (and (not (and manager (nonzero? manager)))
                               (or (not manager-level) (= (level-status *level* manager-level) 'active)))
                      (script-eval '(task-manager) :key node)))))))))))
  (none))

(defmethod mp-bootstrap-deactivate-aid-in-level! ((this mp-bootstrap-controller) (aid uint) (lev level))
  (when (and lev (nonzero? lev) (= (-> lev status) 'active))
    (let ((entities (-> lev entity)))
      (when (and entities (nonzero? entities))
        (dotimes (j (-> entities length))
          (let ((ent (-> entities data j)))
            (when (and ent (nonzero? ent) (= (-> ent aid) (the-as uint aid)))
              (logior! (-> ent perm status) (entity-perm-status dead))
              (let ((proc (-> ent process)))
                (when (and proc (nonzero? proc))
                  (log 'debug "[MP-Bootstrap] Surgical deactivate: aid=~D level=~S~%" aid (-> lev name))
                  (deactivate proc)))))))))
  (none))

(defmethod mp-bootstrap-apply-aids! ((this mp-bootstrap-controller))
  (when (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (let ((count (-> *mp-bootstrap-state* synchronized-aid-count)))
      (when (> count MP_MAX_BOOTSTRAP_AIDS)
        (set! count (the-as uint MP_MAX_BOOTSTRAP_AIDS)))
      (log 'debug "[MP-Bootstrap] Marking ~D actors as dead in fresh perm-list...~%" count)
      (dotimes (i (the-as int count))
        (let ((aid (-> *mp-bootstrap-state* synchronized-aids i)))
          (when (not (mp-mark-aid-dead-perm! aid))
            (log 'debug "[MP-Bootstrap] WARNING: Failed to store dead aid=~D.~%" aid))
          (when (and *level* (nonzero? *level*))
            (dotimes (l 6)
              (mp-bootstrap-deactivate-aid-in-level! this aid (-> *level* level l))))))))
  (none))

(defmethod mp-bootstrap-place-client! ((this mp-bootstrap-controller))
  (when (not (mp-bootstrap-client-ready-for-apply? this))
    (return #f))
  (when (mp-tomb-boulder-skip-bootstrap-host-teleport?)
    (mp-tomb-boulder-restore-local-bootstrap-camera!)
    (return #t))
  (when (mp-teleport-bootstrap-to-record! *target* (-> this destination))
    (return #t))
  (mp-log-bootstrap-wait! this 'no-safe-placement)
  #f)

(defmethod mp-bootstrap-restore-local-camera! ((this mp-bootstrap-controller))
  (let ((local-record (mp-local-player-record)))
    (when (and local-record
               (nonzero? local-record)
               *mp-player-controller*
               (nonzero? *mp-player-controller*)
               *target*
               (nonzero? *target*)
               *camera*
               (nonzero? *camera*)
               *camera-combiner*
               (nonzero? *camera-combiner*))
      (let ((control (-> *target* control))
            (local-player-id (the-as uint (-> local-record identity player-id))))
        (when (and control (nonzero? control) (mp-player-id-valid? local-player-id))
          (mp-player-controller-bind-target! *mp-player-controller* local-player-id *target*)
          (vector-copy! (-> control camera-pos) (-> control trans))
          (when (not (mp-spectate-requested?))
            (set! *external-cam-mode* #f)
            (send-event *camera* 'change-target *target*)
            (send-event *camera* 'teleport))
          (cam-master-activate-slave #t)
          (log 'debug "[MP-Bootstrap] Camera restored to local player ~D.~%" local-player-id)))))
  (none))

(defmethod mp-bootstrap-finish! ((this mp-bootstrap-controller))
  (when (or (mp-spectate-active?) (mp-spectate-requested?))
    (mp-death-spectate-abort!))
  (set-setting! 'allow-recharge #f 0.0 0)
  (mp-force-apply-remote-environment-state)
  (mp-force-clear-bootstrap-progress-ui! this)
  (mp-clear-client-presentation-blackout!)
  (set! *task-manager-spawn-suppressed?* #f)
  (set! *mp-bootstrap-local-phase* (the uint 0))
  (set! (-> this bootstrap-generation) (the uint32 0))
  (when (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (set! (-> *mp-bootstrap-state* phase) (the-as uint 0)))
  (when (nonnull? *target*)
    (target-timed-invulnerable-off *target* 1))
  (pc-multi-session-enter-game)
  (set! *mp-intro-skip-blackout-pending?* #f)
  (mp-tomb-boulder-bootstrap-complete!)
  (log 'debug "[MP-Bootstrap] Client world bootstrap complete.~%")
  (none))

(defstate idle (mp-bootstrap-controller)
  :virtual #t
  :code
    (behavior ()
      (until #f
        (cond
          ((not (mp-bootstrap-client-active? self)) (suspend))
          ((zero? (mp-bootstrap-sync-flag self)) (suspend))
          ((mp-tomb-boulder-suppress-bootstrap?) (mp-tomb-boulder-consume-bootstrap!) (suspend))
          ((= (mp-bootstrap-sync-flag self) (the uint 1)) (go-virtual loading))
          ((= (mp-bootstrap-sync-flag self) (the uint 2)) (go-virtual wait-for-levels))
          ((= (mp-bootstrap-sync-flag self) (the uint 3)) (go-virtual applying))
          (else (mp-log-bootstrap-wait! self 'unexpected-bootstrap-flag) (suspend))))
      #f))

(defstate loading (mp-bootstrap-controller)
  :virtual #t
  :code
    (behavior ()
      (until #f
        (cond
          ((not (mp-bootstrap-client-active? self)) (go-virtual idle))
          ((not (= (mp-bootstrap-sync-flag self) (the uint 1))) (go-virtual idle))
          ((mp-tomb-boulder-suppress-bootstrap?) (mp-tomb-boulder-consume-bootstrap!) (go-virtual idle))
          ((mp-bootstrap-start-load! self) (go-virtual wait-for-levels))
          (else (suspend))))
      #f))

(defstate wait-for-levels (mp-bootstrap-controller)
  :virtual #t
  :code
    (behavior ()
      (until #f
        (cond
          ((not (mp-bootstrap-client-active? self)) (go-virtual idle))
          ((= (mp-bootstrap-sync-flag self) (the uint 1)) (go-virtual loading))
          ((= (mp-bootstrap-sync-flag self) (the uint 2))
           (if (mp-bootstrap-client-ready-for-apply? self)
             (begin
               (log 'debug "[MP-Bootstrap] Promoting bootstrap phase ~D -> 3.~%" (mp-bootstrap-sync-flag self))
               (set! *mp-bootstrap-local-phase* (the uint 3))
               (set! (-> *mp-bootstrap-state* phase) (the uint 3))
               (log 'debug "[MP-Bootstrap] Local target/world ready; bootstrap apply armed.~%")
               (suspend))
             (begin
               (mp-log-bootstrap-wait! self 'waiting-for-local-readiness)
               (suspend))))
          ((= (mp-bootstrap-sync-flag self) (the uint 3)) (go-virtual applying))
          (else (go-virtual idle))))
      #f))

(defstate applying (mp-bootstrap-controller)
  :virtual #t
  :code
    (behavior ()
      (until #f
        (cond
          ((not (mp-bootstrap-client-active? self)) (go-virtual idle))
          ((= (mp-bootstrap-sync-flag self) (the uint 1)) (go-virtual loading))
          ((= (mp-bootstrap-sync-flag self) (the uint 2)) (go-virtual wait-for-levels))
          ((not (= (mp-bootstrap-sync-flag self) (the uint 3))) (go-virtual idle))
          ((not (mp-bootstrap-client-ready-for-apply? self)) (mp-log-bootstrap-apply-wait! self) (suspend))
          ((zero? (-> self applied?))
           (mp-bootstrap-apply-player-values! self)
           (mp-bootstrap-apply-task-snapshot! self)
           (mp-bootstrap-apply-aids! self)
           (mp-bootstrap-start-active-task-managers! self)
           (set! (-> self applied?) (the uint8 1))
           (suspend))
          (else
           (if (mp-bootstrap-place-client! self)
             (begin
               (mp-bootstrap-restore-local-camera! self)
               (mp-bootstrap-finish! self)
               (go-virtual idle))
             (suspend)))))
      #f))

(defbehavior mp-bootstrap-controller-init mp-bootstrap-controller ()
  (go-virtual idle)
  (none))

(defun mp-bootstrap-note-local-spawn! ((status mp-connection-status))
  (let ((local-record (mp-local-player-record)))
    (when (and (mp-session-client?)
               (= status (mp-connection-status game-starting))
               local-record
               (nonzero? local-record)
               (= *mp-bootstrap-local-phase* (the uint 2)))
      (set! *mp-bootstrap-local-phase* (the uint 3))
      (set! (-> *mp-bootstrap-state* phase) (the uint 3))
      (log 'debug "[MP-Bootstrap] Local player spawned; bootstrap apply armed.~%")))
  (none))

(defun mp-bootstrap-controller-kill-all! ()
  (when (and *active-pool* (nonzero? *active-pool*))
    (kill-by-type mp-bootstrap-controller *active-pool*))
  (none))

(defun mp-bootstrap-controller-start! ()
  (when (and (nonnull? *active-pool* *mid-pool*)
             (not (nonnull? (process-by-type-exact 'mp-bootstrap-controller *active-pool*))))
    (process-spawn mp-bootstrap-controller :init mp-bootstrap-controller-init :to *mid-pool*))
  (none))

(defun mp-bootstrap-controller-reset! ()
  (when (and (mp-bootstrap-in-progress?) (nonnull? *target*))
    (target-timed-invulnerable-off *target* 1))
  (mp-bootstrap-controller-kill-all!)
  (set! *mp-bootstrap-local-phase* (the uint 0))
  (when (nonnull? *mp-bootstrap-state*)
    (set! (-> *mp-bootstrap-state* phase) (the uint 0))
    (set! (-> *mp-bootstrap-state* sequence) (the uint 0))
    (dotimes (i 32)
      (set! (-> *mp-bootstrap-state* host-continue i) (the-as uint 0))))
  (when (nonnull? *mp-continue-name*)
    (dotimes (i 32)
      (set! (-> *mp-continue-name* data i) (the uint 0))))
  (set! *task-manager-spawn-suppressed?* #f)
  (none))

(defun mp-apply-remote-world-state ()
  (when (mp-session-client?)
    (let ((mask (-> *mp-world-state* task-mask))
          (active-mask (-> *mp-world-state* active-task-mask)))
      (let ((nodes (-> *game-info* sub-task-list)))
        (when nodes
          (dotimes (i (min 512 (-> nodes length)))
            (let ((byte-idx (/ i 8))
                  (bit-idx (logand i 7)))
              (let ((remote-closed? (logtest? (-> mask byte-idx) (ash 1 bit-idx))))
                (mp-tomb-boulder-note-remote-task-state! i remote-closed?)
                (unless (or (= i (the-as uint (game-task-node city-vehicle-training-map)))
                            (= i (the-as uint (game-task-node city-vehicle-training-hover-zone-1)))
                            (= i (the-as uint (game-task-node city-vehicle-training-hover-zone-2)))
                            (= i (the-as uint (game-task-node city-vehicle-training-resolution))))
                  (when (and remote-closed? (not (logtest? (-> nodes data i flags) (game-task-node-flag closed))))
                    (log 'debug "[MP-Sync-State] Remote closed task node ~D. Applying locally.~%" i)
                    (task-node-close! (the-as game-task-node i))
                    (mp-task-sync-after-remote-close! (the-as game-task-node i)))
                  (when (and (logtest? (-> active-mask byte-idx) (ash 1 bit-idx))
                             (task-node-closed? (the-as game-task-node i)))
                    (let ((should-open? #t))
                      (when (or (mp-scene-coordinator-vote-active?) *mp-processing-remote-event* *scene-player*)
                        (set! should-open? #f))
                      (when (mp-tomb-boulder-block-remote-task-open? i)
                        (set! should-open? #f))
                      (when should-open?
                        (log 'debug "[MP-Sync-State] Remote has active task node ~D. Opening locally.~%" i)
                        (let ((saved-context *mp-processing-remote-event*))
                          (set! *mp-processing-remote-event* #t)
                          (task-node-open! (the-as game-task-node i))
                          (mp-task-sync-after-remote-open! (the-as game-task-node i))
                          (set! *mp-processing-remote-event* saved-context)))))))))))))
  (none))
