;;-*-Lisp-*-
(in-package goal)

(define-extern scene-lookup (function basic scene))

(defun mp-multiplayer-level-load-active? ()
  (the symbol
       (and *level*
            (nonzero? *level*)
            (-> *level* loading-level)
            (-> *level* default-level)
            (!= (-> *level* loading-level) (-> *level* default-level)))))

(defun mp-multiplayer-scene-active? ()
  (the symbol (or *scene-player* (movie?) (real-movie?) (mp-any-remote-player-scene-active?))))

(defun mp-multiplayer-scene-or-load-active? ()
  (the symbol (or (mp-multiplayer-scene-active?) (mp-multiplayer-level-load-active?))))

(defun mp-scene-sync-active-or-pending? ()
  (the symbol (or (mp-multiplayer-scene-or-load-active?) *mp-pending-scene-sync?*)))

(defun mp-should-suppress-local-endlessfall? ()
  (the symbol (or (mp-bootstrap-in-progress?) (and (mp-session-in-game?) (mp-multiplayer-scene-or-load-active?)))))
