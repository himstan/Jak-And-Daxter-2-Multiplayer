(in-package goal)

(deftype mp-replication-player-identity (structure)
  ((skin            mp-player-skin :inline)
   (name            uint8 16)
   (player-id       uint8)
   (character       uint8)
   (identity-ready? uint8)
   (state-ready?    uint8)
   (joined?         uint8)
   (spectator-only? uint8)
   (lobby-ready?    uint8))
  :size-assert 279)

(deftype mp-replication-player-level-slot (structure)
  ((level-id uint8)
   (flags    uint8))
  :pack-me
  :size-assert 2)

(deftype mp-replication-player-transform (structure)
  ((position vector :inline)
   (velocity vector :inline)
   (angle    float)
   (levels   mp-replication-player-level-slot MP_PLAYER_LEVEL_SLOT_COUNT :inline))
  :size-assert 48)

(deftype mp-replication-player-action (structure)
  ((target-state-id        uint32)
   (authoritative-sequence uint32)
   (action-state-id        uint32)
   (darkjak-stage          uint8)
   (scene-state            uint8)
   (respawn-flags          uint8)
   (riding-along-player-id uint8)
   (visual-secrets         uint8))
  :size-assert 17)

(deftype mp-replication-player-input (structure)
  ((camera-angle-y  float)
   (buttons         uint16)
   (leftx           uint8)
   (lefty           uint8)
   (equipped-weapon uint8))
  :size-assert 9)

(deftype mp-replication-player-vehicle (structure)
  ((state         mp-vehicle-state :inline)
   (vehicle-id    uint32)
   (turret-roty   float)
   (turret-rotx   float)
   (seat-index    uint8)
   (turret-active uint8))
  :size-assert 94)

(deftype mp-replication-player (structure)
  ((presentation-position   vector :inline)
   (presentation-quaternion quaternion :inline)
   (presentation-velocity   vector :inline)
   (identity                mp-replication-player-identity :inline)
   (vehicle                 mp-replication-player-vehicle :inline)
   (transform               mp-replication-player-transform :inline)
   (action                  mp-replication-player-action :inline)
   (input                   mp-replication-player-input :inline)
   (generation              uint32)
   (lifecycle-generation    uint32)
   (activity                mp-player-activity)
   (valid?                  uint8)
   (mission-flags           uint8))
  :size-assert 535)

(deftype mp-replication-bootstrap-state (structure)
  ((host-spawn-position    vector :inline)
   (synchronized-aids      uint32 MP_MAX_BOOTSTRAP_AIDS)
   (host-continue          uint8 32)
   (phase                  uint32)
   (sequence               uint32)
   (host-task              uint32)
   (host-spawn-angle       float)
   (host-camera-angle-y    float)
   (synchronized-aid-count uint16))
  :size-assert 16454)

(deftype mp-replication-enemy-state (structure)
  ((position              vector :inline)
   (quaternion            quaternion :inline)
   (presentation-velocity vector :inline)
   (actor-id              uint32)
   (hp                    int32)
   (state                 uint32)
   (focus-player-id       uint8)
   (attack-flag           uint8)
   (owner-player-id       uint8)
   (is-aggro              uint8))
  :size-assert 64)

(deftype mp-replication-pedestrian-state (structure)
  ((position         vector :inline)
   (quaternion       quaternion :inline)
   (net-id           uint32)
   (hp               int32)
   (vehicle-net-id   uint32)
   (transport-id     uint32)
   (appearance-mask  uint32)
   (level-id         uint16)
   (object-type      uint8)
   (state-id         uint8)
   (flags            mp-pedestrian-flags)
   (target-player-id uint8)
   (transport-side   uint8)
   (travel-speed     uint8))
  :size-assert 60)

(deftype mp-replication-palace-squid-state (structure)
  ((active            uint32)
   (state-id          uint32)
   (stage             int32)
   (hit-points        int32)
   (shield-hit-points float)
   (target-player-id  uint8)
   (draw-force-fade   uint8)
   (action-seq        uint32)
   (x                 float)
   (y                 float)
   (z                 float)
   (quat-x            float)
   (quat-y            float)
   (quat-z            float)
   (quat-w            float)
   (root-x            float)
   (root-y            float)
   (root-z            float)
   (root-quat-x       float)
   (root-quat-y       float)
   (root-quat-z       float)
   (root-quat-w       float)
   (traj-src-x        float)
   (traj-src-y        float)
   (traj-src-z        float)
   (traj-dest-x       float)
   (traj-dest-y       float)
   (traj-dest-z       float)
   (traj-duration     float)
   (traj-age          int32))
  :size-assert 116)

(deftype mp-replication-widow-state (structure)
  ((active   uint32)
   (state-id uint32)
   (x        float)
   (y        float)
   (z        float)
   (quat-x   float)
   (quat-y   float)
   (quat-z   float)
   (quat-w   float))
  :size-assert 36)

(deftype mp-replication-airlock-state (structure)
  ((airlock-aid      uint32)
   (sequence         uint32)
   (level-id         uint16)
   (state-id         uint8)
   (source-player-id uint8))
  :size-assert 12)

(deftype mp-replication-enemy-set (structure)
  ((generation uint32)
   (valid?     uint8)
   (count      uint16)
   (enemies    mp-replication-enemy-state MP_MAX_REMOTE_ENEMIES :inline))
  :size-assert 57360)

(deftype mp-replication-traffic-set (structure)
  ((generation       uint32)
   (valid?           uint8)
   (pedestrian-count uint8)
   (vehicle-count    uint8)
   (pedestrians      mp-replication-pedestrian-state MP_MAX_SYNC_PEDESTRIANS :inline)
   (vehicles         mp-vehicle-state MP_MAX_SYNC_VEHICLES :inline))
  :size-assert 13328)

(deftype mp-replication-boss-set (structure)
  ((generation   uint32)
   (squid-valid? uint8)
   (widow-valid? uint8)
   (squid        mp-replication-palace-squid-state :inline)
   (widow        mp-replication-widow-state :inline))
  :size-assert 180)

(deftype mp-replication-airlock-set (structure)
  ((generation uint32)
   (sequence   uint32)
   (valid?     uint8)
   (count      uint8)
   (states     mp-replication-airlock-state MP_AIRLOCK_STATE_COUNT :inline))
  :size-assert 528)

(deftype mp-replication-authority (structure)
  ((generation  uint32)
   (revision    uint32)
   (valid?      uint8)
   (selected    uint8)
   (assignments uint8 MP_MAX_PLAYERS))
  :size-assert 18)

(deftype gungame-target-record (structure)
  ((spawn-time int32)
   (state      uint8))
  :pack-me
  :size-assert 5)

(deftype gungame-target-record-array (inline-array-class)
  ((data gungame-target-record :inline :dynamic)))

(set! (-> gungame-target-record-array heap-base)
      (the-as uint (align-n (size-of gungame-target-record) (size-of int32))))

(deftype gungame-state (structure)
  ((sequence          uint32)
   (run-id            uint32)
   (score             int32)
   (elapsed-time      int32)
   (targets           (inline-array gungame-target-record))
   (count             uint16)
   (capacity          uint16)
   (course-id         uint8)
   (phase             uint8)
   (red-intro-step    uint8)
   (yellow-intro-step uint8)
   (end-door          uint8)
   (open-end?         uint8))
  :size-assert 30)

(deftype mp-replication-frame (structure)
  ((generation               uint32)
   (players                  mp-replication-player MP_MAX_PLAYERS :inline)
   (world                    mp-world-sync-state :inline)
   (bootstrap                mp-replication-bootstrap-state :inline)
   (enemies                  mp-replication-enemy-set :inline)
   (traffic                  mp-replication-traffic-set :inline)
   (bosses                   mp-replication-boss-set :inline)
   (airlocks                 mp-replication-airlock-set :inline)
   (gungame                  gungame-state :inline)
   (authority                mp-replication-authority :inline)
   (world-generation         uint32)
   (bootstrap-generation     uint32)
   (world-valid?             uint8)
   (bootstrap-valid?         uint8)
   (identity-generation      uint32)
   (enemy-clear-generation   uint32)
   (traffic-clear-generation uint32)
   (boss-clear-generation    uint32))
  :size-assert 92512)

(defconstant MP_REPLICATION_STATE_SIZE 195312)

(deftype mp-replication-state (structure)
  ((abi-size             uint32)
   (local-player-id      uint8)
   (host-player-id       uint8)
   (local                mp-replication-frame :inline)
   (remote               mp-replication-frame :inline)
   (outbound-event-count uint8)
   (outbound-events      mp-event 64 :inline)
   (inbound-event-count  uint8)
   (inbound-events       mp-event 64 :inline))
  :size-assert MP_REPLICATION_STATE_SIZE)

(define-perm *mp-replication-state* mp-replication-state (new 'static 'mp-replication-state))

(define-extern pc-multi-exchange-state (function uint int))
