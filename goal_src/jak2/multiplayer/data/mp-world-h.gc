;;-*-Lisp-*-
(in-package goal)

(defconstant MP_MAX_BOOTSTRAP_AIDS 4096)

(deftype mp-world-sync-state (structure)
  ((money                 float)
   (gems                  float)
   (skill                 float)
   (sequence              uint32)
   (clock                 time-frame)
   (time-of-day-frame     time-frame)
   (time-of-day-ratio     float)
   (weather-cloud         float)
   (weather-fog           float)
   (weather-rain          float)
   (respawn-delay-seconds uint16)
   (player-collision      uint8)
   (friendly-fire         uint8)
   (task-mask             uint8 64)
   (active-task-mask      uint8 64))
  :size-assert 180)

(deftype mp-bootstrap-sync-state (structure)
  ((phase                  uint32)
   (sequence               uint32)
   (host-task              uint32)
   (reserved               uint32)
   (host-continue          uint8 32)
   (host-spawn-position    vector :inline)
   (host-spawn-angle       float)
   (host-camera-angle-y    float)
   (synchronized-aid-count uint32)
   (synchronized-aids      uint32 MP_MAX_BOOTSTRAP_AIDS))
  :size-assert 16460)

(define-perm *mp-world-state* mp-world-sync-state (new 'static 'mp-world-sync-state :respawn-delay-seconds 20))
(define-perm *mp-bootstrap-state* mp-bootstrap-sync-state (new 'static 'mp-bootstrap-sync-state))

(define-extern mp-bootstrap-in-progress? (function symbol))
