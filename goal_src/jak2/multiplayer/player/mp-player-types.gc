(in-package goal)

(defconstant MP_PLAYER_SKIN_SLOT_COUNT 32)
(defconstant MP_PLAYER_LEVEL_SLOT_COUNT 6)
(defconstant MP_PLAYER_LEVEL_MODE_MASK #x03)
(defconstant MP_PLAYER_LEVEL_FORCE_VIS #x04)
(defconstant MP_PLAYER_LEVEL_FORCE_INSIDE #x08)
(defconstant MP_PLAYER_LEVEL_BORROW_OWNER_MASK #x70)
(defconstant MP_PLAYER_LEVEL_BORROW_OWNER_SHIFT 4)
(defconstant MP_PLAYER_LEVEL_BORROW_SLOT #x80)

(defenum mp-player-skin-group
  (primary 0)
  (jak-jacket 1)
  (jak-armor 2)
  (jak-leggings 3)
  (jak-pants 4)
  (jak-boots 5)
  (jak-scarf 6)
  (jak-pouch 7)
  (jak-straps 8)
  (jak-gloves 9)
  (daxter-hat 16)
  (daxter-fur 17))

(deftype mp-player-skin (structure)
  ((colors    uint32 MP_PLAYER_SKIN_SLOT_COUNT)
   (strengths float MP_PLAYER_SKIN_SLOT_COUNT))
  :size-assert 256)

