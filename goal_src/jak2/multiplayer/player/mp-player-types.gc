(defenum mp-equipped-weapon
  (uint8)
  (none 0)
  (yellow 1)
  (red 2)
  (blue 3)
  (dark 4))

(define-extern mp-enemy-sync-idle (state enemy))
(define-extern mp-target-get-state-from-id (function uint symbol))
(define-extern mp-target-get-id-from-state (function symbol symbol uint))
(define-extern player-replica-valid? (function target symbol))
(define-extern player-replica-apply-record-correction! (function target none))
(define-extern get-player-replica (function target))
(define-extern mp-prepare-remote-spectate-target! (function process-focusable))
(define-extern mp-pickup-type->equipped-weapon (function uint mp-equipped-weapon))
(define-extern mp-equipped-weapon->pickup-type (function uint uint))
(define-extern mp-target-death-state? (function symbol symbol))
(define-extern mp-trigger-death-taunt! (function target none))
(define-extern mp-clear-local-vehicle-occupancy! (function target none))
(define-extern mp-respawn-local-target! (function target none))
(define-extern player-replica? (function process symbol))
(define-extern not-player-replica? (function process symbol))
(define-extern mp-remote-teleport-ready-or-request! (function symbol))
