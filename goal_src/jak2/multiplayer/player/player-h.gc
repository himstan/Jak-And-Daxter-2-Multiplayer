;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-session-player-limit* uint (the uint 2))

(define-extern *mp-block-remote-respawn-on-me?* symbol)
(define-extern *mp-block-local-respawn-on-remote?* symbol)

(defun mp-set-session-player-limit! ((player-limit uint))
  (set! *mp-session-player-limit*
        (cond
          ((< player-limit (the uint 2)) (the uint 2))
          ((> player-limit (the uint MP_MAX_PLAYERS)) (the uint MP_MAX_PLAYERS))
          (else player-limit)))
  *mp-session-player-limit*)

(defconstant MP_INVALID_PLAYER_ID (the uint8 #xff))
(defconstant MP_INVALID_PAD_INDEX (the uint8 #xff))
(defconstant MP_REMOTE_PLAYER_MARKER_KEY_BASE (the int #x4d505240))
(defconstant MP_PLAYER_NAME_SIZE 16)

(defenum mp-player-runtime-flags
  :type uint32
  :bitfield #t
  (dying 0)
  (dead 1)
  (interp-initialized 2)
  (was-far 3)
  (warping 4)
  (recovering 5)
  (force-presentation 6)
  (pending-gun-shot 7)
  (join-announced 8))

(defenum mp-player-mission-flags
  :type uint32
  :bitfield #t
  (stadium-board1-tutorial-done 0)
  (stadium-board1-tutorial-announced 1))

(defenum mp-culling-override-flags
  :type uint32
  :bitfield #t
  (race 0))

(defenum player-replica-lifecycle
  :type uint8
  (none 0)
  (spawning 1)
  (active 2)
  (culled 3))

(defenum mp-player-character
  :type uint32
  (unknown 0)
  (jak 1)
  (daxter 2))

(defenum mp-player-visual-secrets
  :type uint32
  :bitfield #t
  (big-head 0)
  (little-head 1)
  (goatee-visible 2))

(defconstant MP_PLAYER_VISUAL_SECRETS_MASK (mp-player-visual-secrets big-head little-head goatee-visible))

(defun mp-player-character-valid? ((character mp-player-character))
  (or (= character (mp-player-character jak)) (= character (mp-player-character daxter))))

(defun mp-sync-preferences-to-session-host-config! ()
  (when (and (nonnull? *multiplayer-preferences*) (= (pc-multi-get-preferences *multiplayer-preferences*) 1))
    (mp-set-session-player-limit! (the uint (-> *multiplayer-preferences* session-player-limit))))
  (none))

(defun mp-setup-host-bridge! ((internet-host? object))
  (if internet-host? (pc-multi-setup-internet-host *mp-session-player-limit*) (pc-multi-setup-host *mp-session-player-limit*))
  (none))

(deftype mp-player-identity (structure)
  ((player-id       uint8)
   (character       mp-player-character)
   (identity-ready? uint8)
   (state-ready?    uint8)
   (joined?         uint8)
   (spectator-only? uint8)
   (name            uint8 MP_PLAYER_NAME_SIZE)
   (lobby-ready?    uint8)
   (skin            mp-player-skin :inline))
  :size-assert 288)

(defenum mp-player-activity
  :type uint8
  (unavailable 0)
  (lobby 1)
  (game-starting 2)
  (in-game 3))

(deftype mp-player-connection-state (structure)
  ((latest-state-sequence  uint32)
   (latest-turret-sequence uint32)
   (lifecycle-generation   uint32)
   (activity               mp-player-activity)
   (connected?             uint8)
   (state-cached?          uint8)
   (activity-changed?      uint8))
  :size-assert 16)

(deftype mp-player-level-slot (structure)
  ((level-id uint8)
   (flags    uint8))
  :pack-me
  :size-assert 2)

(deftype mp-player-transform-state (structure)
  ((position vector :inline)
   (velocity vector :inline)
   (angle    float)
   (levels   mp-player-level-slot MP_PLAYER_LEVEL_SLOT_COUNT :inline))
  :size-assert 48)

(deftype mp-player-action-state (structure)
  ((target-state-id        uint32)
   (darkjak-stage          uint32)
   (authoritative-sequence uint32)
   (action-state-id        uint32)
   (scene-state            uint8)
   (respawn-flags          uint8)
   (death-state            uint8)
   (scene-latched?         uint8)
   (last-replayed-sequence uint32)
   (riding-along-player-id uint8)
   (visual-secrets         mp-player-visual-secrets))
  :size-assert 32)

(deftype mp-player-input-state (structure)
  ((buttons         uint16)
   (leftx           uint8)
   (lefty           uint8)
   (equipped-weapon uint8)
   (camera-angle-y  float))
  :size-assert 12)

(deftype mp-player-vehicle-state (structure)
  ((vehicle-id     uint32)
   (seat-index     uint8)
   (turret-active? uint8)
   (turret-roty    float)
   (turret-rotx    float)
   (state          mp-vehicle-state :inline))
  :size-assert 96)

(deftype target-record (structure)
  ((trans           vector :inline)
   (quat            quaternion :inline)
   (velocity        vector :inline)
   (state-id        uint32)
   (equipped-weapon uint8)
   (buttons         uint16)
   (leftx           uint8)
   (lefty           uint8)
   (cam-angle-y     float)
   (health          float)
   (last-update     time-frame)
   (active?         symbol))
  :size-assert 84)

(deftype mp-player-runtime-state (structure)
  ((target-handle                  handle)
   (vehicle-handle                 handle)
   (record                         target-record :inline)
   (presentation-position          vector :inline)
   (presentation-quaternion        quaternion :inline)
   (last-fresh-input-time          time-frame)
   (action-warmup-start            time-frame)
   (last-state-packet-id           uint32)
   (last-action-sequence           uint32)
   (state-mismatch-count           int32)
   (death-state                    uint32)
   (pending-gun-shot-sequence      uint32)
   (last-gun-shot-sequence         uint32)
   (last-gun-replay-debug-sequence uint32)
   (interpolation-angle            float)
   (pending-gun-shot-camera-angle  float)
   (last-gun-log-active            int32)
   (last-gun-log-requested         int32)
   (pad-index                      uint8)
   (replica-lifecycle              player-replica-lifecycle)
   (pending-gun-shot-weapon        uint8)
   (flags                          mp-player-runtime-flags)
   (mission-flags                  mp-player-mission-flags)
   (pending-gun-shot-time          time-frame))
  :size-assert 224)

(deftype mp-player-record (structure)
  ((identity   mp-player-identity :inline)
   (connection mp-player-connection-state :inline)
   (transform  mp-player-transform-state :inline)
   (action     mp-player-action-state :inline)
   (input      mp-player-input-state :inline)
   (vehicle    mp-player-vehicle-state :inline)
   (runtime    mp-player-runtime-state :inline))
  :size-assert 720)

(defconstant MP_PLAYER_CONTROLLER_SIZE (+ (* 720 MP_MAX_PLAYERS) 2))

(deftype mp-player-controller (structure)
  ((records         mp-player-record MP_MAX_PLAYERS :inline)
   (local-player-id uint8)
   (host-player-id  uint8))
  :size-assert MP_PLAYER_CONTROLLER_SIZE)

(define-perm *mp-player-controller* mp-player-controller (new 'static 'mp-player-controller))

(define-extern mp-player-primary-level-id (function mp-player-record uint))
(define-extern mp-enemy-player-eligible? (function mp-player-record uint symbol))
(define-extern mp-pack-local-level-state! (function mp-player-record none))
(define-extern player-replica-apply-weapon-state! (function target target-record none))
(define-extern player-replica-flush-pending-gun-shot! (function target target-record none))
(define-extern player-replica-clear-stale! (function mp-player-record none))
(define-extern player-replica-spawn (function mp-player-record target))
(define-extern player-replica-deactivate! (function mp-player-record symbol none))
(define-extern mp-trigger-death-taunt! (function target none))
(define-extern mp-player-blocks-respawn? (function mp-player-record symbol))
(define-extern mp-apply-player-render-skin! (function target none))
(define-extern mp-refresh-player-render-skins! (function none))
(define-extern mp-player-record-by-id (function uint mp-player-record))
(define-extern mp-player-runtime-flag? (function mp-player-record mp-player-runtime-flags symbol))
(define-extern mp-player-runtime-set-flag! (function mp-player-record mp-player-runtime-flags mp-player-runtime-flags))
(define-extern mp-player-runtime-clear-flag!
  (function mp-player-record mp-player-runtime-flags mp-player-runtime-flags))
(define-extern mp-player-mission-flag? (function mp-player-record mp-player-mission-flags symbol))
(define-extern mp-player-mission-set-flag! (function mp-player-record mp-player-mission-flags none))
(define-extern mp-player-mission-clear-flag! (function mp-player-record mp-player-mission-flags none))
(define-extern is-record-remote-player? (function mp-player-record symbol))
(define-extern mp-broadcast-process-tree (function process-tree symbol uint uint none))
(define-extern mp-broadcast-event-to-active-processes (function symbol uint uint object))
(define-extern mp-broadcast-player-join! (function mp-player-record none))
(define-extern mp-broadcast-player-leave! (function mp-player-record none))
(define-extern player-target-alive? (function target symbol))
(define-extern get-player-attacker (function process target))
(define-extern player-using-turret? (function target symbol))
(define-extern player-projectile-contact! (function projectile none))
(define-extern player-friendly-attack-blocked? (function process symbol))
(define-extern player-position-clear? (function target vector symbol))
(define-extern player-set-ride-contact! (function target symbol none))
(define-extern mp-session-host? (function symbol))
(define-extern mp-session-client? (function symbol))
(define-extern *mp-culling-override-mask* uint)
(define-extern mp-culling-set-override! (function mp-culling-override-flags symbol uint))
(define-extern mp-culling-clear-override! (function mp-culling-override-flags uint))
(define-extern mp-culling-override-active? (function symbol))
(define-extern mp-culling-suppressed-for-player? (function mp-player-record symbol))
(define-extern mp-teleport-bootstrap-to-record! (function target mp-player-record symbol))
(define-extern reassign-player-owned-enemies (function uint none))
