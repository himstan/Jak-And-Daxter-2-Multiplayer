;;-*-Lisp-*-
(in-package goal)

(defun player-collision-enabled? ()
  (if (and (mp-session-in-game?) (nonnull? *mp-world-state*) (nonzero? (-> *mp-world-state* player-collision))) #t #f))

(defun player-friendly-attack-blocked? ((attacker process))
  (if (and (mp-session-in-game?)
           (nonnull? *mp-world-state* attacker)
           (zero? (-> *mp-world-state* friendly-fire))
           (let ((player (get-player-attacker attacker))) (and (nonnull? player) (mp-is-remote-attacker? player))))
    #t
    #f))

(defun player-target-alive? ((player target))
  (if (and (nonnull? player)
           (not (focus-test? player dead inactive))
           (let ((record (mp-player-process-record player)))
             (or (not (nonnull? record)) (not (mp-player-record-dead-or-dying? record)))))
    #t
    #f))

(defun player-body-collision-ready? ((player target))
  (and (nonnull? player (-> player control) (-> player control root-prim))
       (nonnull? (-> player control collision-spheres 0)
                 (-> player control collision-spheres 1)
                 (-> player control collision-spheres 2))
       (player-target-alive? player)
       (not (focus-test? player pilot grabbed))
       (not (mp-target-ride-along? player))
       (not (or (movie?) *scene-player*))))

(defun get-player-attacker ((attacker process))
  (when (mp-session-in-game?)
    (when (and (nonnull? attacker) (type? attacker projectile))
      (let ((owner (handle->process-safe (-> (the-as projectile attacker) owner-handle))))
        (when (nonnull? owner)
          (set! attacker owner))))
    (when (mp-is-local-attacker? attacker)
      (return *target*))
    (let ((record (mp-remote-attacker-record attacker)))
      (when (nonnull? record)
        (return (mp-player-record-target record)))))
  (the-as target #f))

(defun player-using-turret? ((player target))
  (when (nonnull? player)
    (dotimes (index 2)
      (let ((state (if (zero? index) (-> player state) (-> player next-state))))
        (when (nonnull? state)
          (case (-> state name)
            (('target-turret-get-on 'target-turret-stance 'target-turret-get-off) (return #t)))))))
  #f)

(defun player-projectile-contact! ((shot projectile))
  (when (and (mp-session-in-game?) (nonnull? shot (-> shot root)))
    (let* ((owner (handle->process-safe (-> shot owner-handle)))
           (player (get-player-attacker (if (nonnull? owner) owner shot)))
           (prim (-> shot root root-prim)))
      (when (nonnull? player)
        (set! (-> shot owner-handle) (process->handle player))
        (when (not (focus-test? player pilot grabbed))
          (set! (-> shot ignore-handle) (process->handle player)))
        (when (nonnull? prim)
          (dotimes (index (-> shot root total-prims))
            (logior! (-> prim collide-with) (collide-spec jak))
            (&+! prim (size-of collide-shape-prim)))))))
  (none))

(defun player-set-attack-contact! ((player target))
  (when (nonnull? player
                  (-> player control)
                  (-> player control root-prim)
                  (-> player control collision-spheres 6)
                  (-> player control collision-spheres 7)
                  (-> player control collision-spheres 8)
                  (-> player control collision-spheres 9))
    (let ((control (-> player control)))
      (logclear! (-> control default-collide-with-fgnd) (collide-spec jak replica))
      (logclear! (-> control root-prim collide-with) (collide-spec jak))
      (dotimes (index 4)
        (logclear! (-> control collision-spheres (+ index 6) collide-with) (collide-spec jak replica)))
      (when (and (mp-session-in-game?)
                 (player-target-alive? player)
                 (nonnull? *mp-world-state*)
                 (nonzero? (-> *mp-world-state* friendly-fire)))
        (logior! (-> control default-collide-with-fgnd) (collide-spec jak))
        (logior! (-> control root-prim collide-with) (collide-spec jak))
        (when (-> control danger-mode)
          (dotimes (index 4)
            (logior! (-> control collision-spheres (+ index 6) collide-with) (collide-spec jak)))))))
  (none))

(defun player-set-body-contact! ((player target) (enabled symbol))
  (when (nonnull? player
                  (-> player control)
                  (-> player control root-prim)
                  (-> player control collision-spheres 0)
                  (-> player control collision-spheres 1)
                  (-> player control collision-spheres 2))
    (let ((control (-> player control))
          (collidable (and enabled (player-body-collision-ready? player))))
      (logclear! (-> control default-collide-with-all) (collide-spec jak replica))
      (logclear! (-> control root-prim collide-with) (collide-spec replica))
      (logclear! (-> control root-prim collide-as) (collide-spec replica))
      (when collidable
        (logior! (-> control default-collide-with-all) (collide-spec replica))
        (logior! (-> control root-prim collide-with) (collide-spec replica))
        (logior! (-> control root-prim collide-as) (collide-spec replica)))
      (dotimes (index 3)
        (let ((body (-> control collision-spheres index)))
          (logclear! (-> body collide-with) (collide-spec jak replica))
          (logclear! (-> body collide-as) (collide-spec replica))
          (when collidable
            (logior! (-> body collide-with) (collide-spec replica))
            (logior! (-> body collide-as) (collide-spec replica)))))))
  (none))

(defun player-body-horizontal-clearance ((player target) (other target) (position vector))
  (let ((clearance 0.0))
    (when (and (player-body-collision-ready? player) (player-body-collision-ready? other) (nonnull? position))
      (dotimes (a 3)
        (dotimes (b 3)
          (let* ((sphere-a (-> player control collision-spheres a local-sphere))
                 (sphere-b (-> other control collision-spheres b local-sphere))
                 (radius (+ (-> sphere-a w) (-> sphere-b w)))
                 (dy (- (+ (-> position y) (-> sphere-a y)) (+ (-> other control trans y) (-> sphere-b y)))))
            (when (< (abs dy) radius)
              (set! clearance (fmax clearance (sqrtf (- (* radius radius) (* dy dy))))))))))
    clearance))

(defun player-position-clear? ((player target) (position vector))
  (when (and (player-collision-enabled?) (nonnull? player position))
    (mp-for-each-player-target (player-id record other)
      (when (!= player other)
        (let ((radius (player-body-horizontal-clearance player other position)))
          (when (and (> radius 0.0)
                     (< (sqrtf (vector-vector-xz-distance-squared position (-> other control trans)))
                        (+ radius (meters 0.05))))
            (return #f))))))
  #t)

(defun player-separation-fraction ((player target) (movement vector))
  (let ((fraction 0.0))
    (when (and (player-body-collision-ready? player) (nonnull? movement *collide-cache*))
      (set! fraction 1.0)
      (dotimes (index 3)
        (let ((query (new 'stack 'collide-query))
              (body (-> player control collision-spheres index local-sphere)))
          (vector+! (-> query start-pos) (-> player control trans) body)
          (vector-copy! (-> query move-dist) movement)
          (set! (-> query radius) (-> body w))
          (set! (-> query collide-with) (collide-spec backgnd obstacle obstacle-for-jak vehicle-mesh vehicle-sphere))
          (set! (-> query ignore-process0) player)
          (set! (-> query ignore-process1) #f)
          (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
          (set! (-> query action-mask) (collide-action solid))
          (let ((hit (fill-and-probe-using-line-sphere *collide-cache* query)))
            (when (>= hit 0.0)
              (set! fraction (fmin fraction (fmax 0.0 (- hit 0.01)))))))))
    fraction))

(defun player-separate-by-vector! ((player target) (movement vector))
  (when (and (player-body-collision-ready? player) (nonnull? movement))
    (let ((fraction (player-separation-fraction player movement)))
      (when (> fraction 0.001)
        (vector-float*! movement movement fraction)
        (move-by-vector! (-> player control) movement)
        (return #t))))
  #f)

(defun player-resolve-overlap! ((player target) (other target) (other-id uint))
  (unless (and (player-body-collision-ready? player) (player-body-collision-ready? other))
    (return (the-as none 0)))
  (let ((radius (player-body-horizontal-clearance player other (-> player control trans))))
    (when (> radius 0.0)
      (let* ((movement (new 'stack 'vector))
             (distance (sqrtf (vector-vector-xz-distance-squared (-> player control trans) (-> other control trans)))))
        (when (< distance radius)
          (vector-! movement (-> player control trans) (-> other control trans))
          (set! (-> movement y) 0.0)
          (when (< distance (meters 0.001))
            (let ((direction (if (< (mp-local-player-id) other-id) -1.0 1.0)))
              (set-vector! movement direction 0.0 direction 0.0)))
          (vector-xz-normalize! movement (+ (- radius distance) (meters 0.01)))
          (unless (player-separate-by-vector! player movement)
            (vector-xz-normalize! movement (+ (sqrtf (- (* radius radius) (* distance distance))) (meters 0.01)))
            (vector-rotate-y! movement movement (degrees 90))
            (unless (player-separate-by-vector! player movement)
              (vector-rotate-y! movement movement (degrees 180))
              (unless (player-separate-by-vector! player movement)
                (when (< distance (meters 0.001))
                  (vector-rotate-y! movement movement (degrees -90))
                  (player-separate-by-vector! player movement)))))))))
  (none))

(defun player-interaction-tick! ()
  (let ((enabled (player-collision-enabled?)))
    (mp-for-each-player-target (player-id record player)
      (player-set-attack-contact! player)
      (player-set-body-contact! player enabled))
    (when (and enabled (player-body-collision-ready? *target*))
      (dotimes (pass 3)
        (mp-for-each-player-target (player-id record other)
          (when (!= other *target*)
            (player-resolve-overlap! *target* other (the uint player-id)))))))
  (none))
