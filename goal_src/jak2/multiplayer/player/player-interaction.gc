;;-*-Lisp-*-
(in-package goal)

(defun player-collision-enabled? ()
  (if (and (mp-session-in-game?) (nonnull? *mp-world-state*) (nonzero? (-> *mp-world-state* player-collision))) #t #f))

(defun player-friendly-attack-blocked? ((attacker process))
  (if (and (mp-session-in-game?)
           (nonnull? *mp-world-state* attacker)
           (zero? (-> *mp-world-state* friendly-fire))
           (let ((player (get-player-attacker attacker))) (and (nonnull? player) (mp-is-remote-attacker? player))))
    #t
    #f))

(defun player-target-alive? ((player target))
  (if (and (nonnull? player)
           (not (focus-test? player dead inactive))
           (let ((record (mp-player-process-record player)))
             (or (not (nonnull? record)) (not (mp-player-record-dead-or-dying? record)))))
    #t
    #f))

(defun player-ride-contact-disabled? ((player target))
  (when (and (nonnull? player) (mp-target-daxter? player))
    (dotimes (index 2)
      (let ((state (if (zero? index) (-> player state) (-> player next-state))))
        (when (nonnull? state)
          (case (-> state name)
            (('target-indax-jump-on 'target-ride-along) (return #t)))))))
  #f)

(defun get-player-attacker ((attacker process))
  (when (mp-session-in-game?)
    (when (and (nonnull? attacker) (type? attacker projectile))
      (let ((owner (handle->process-safe (-> (the-as projectile attacker) owner-handle))))
        (when (nonnull? owner)
          (set! attacker owner))))
    (when (mp-is-local-attacker? attacker)
      (return *target*))
    (let ((record (mp-remote-attacker-record attacker)))
      (when (nonnull? record)
        (return (mp-player-record-target record)))))
  (the-as target #f))

(defun player-using-turret? ((player target))
  (when (nonnull? player)
    (dotimes (index 2)
      (let ((state (if (zero? index) (-> player state) (-> player next-state))))
        (when (nonnull? state)
          (case (-> state name)
            (('target-turret-get-on 'target-turret-stance 'target-turret-get-off) (return #t)))))))
  #f)

(defun player-projectile-contact! ((shot projectile))
  (when (and (mp-session-in-game?) (nonnull? shot (-> shot root)))
    (let* ((owner (handle->process-safe (-> shot owner-handle)))
           (player (get-player-attacker (if (nonnull? owner) owner shot)))
           (prim (-> shot root root-prim)))
      (when (nonnull? player)
        (set! (-> shot owner-handle) (process->handle player))
        (when (not (focus-test? player pilot grabbed))
          (set! (-> shot ignore-handle) (process->handle player)))
        (when (nonnull? prim *mp-world-state*)
          (dotimes (index (-> shot root total-prims))
            (logclear! (-> prim collide-with) (collide-spec jak replica))
            (if (nonzero? (-> *mp-world-state* friendly-fire))
              (logior! (-> prim collide-with) (collide-spec jak))
              (logclear! (-> prim collide-with) (collide-spec player-list)))
            (&+! prim (size-of collide-shape-prim)))))))
  (none))

(defun player-set-attack-contact! ((player target))
  (when (nonnull? player
                  (-> player control)
                  (-> player control root-prim)
                  (-> player control collision-spheres 6)
                  (-> player control collision-spheres 7)
                  (-> player control collision-spheres 8)
                  (-> player control collision-spheres 9))
    (let ((control (-> player control)))
      (logclear! (-> control default-collide-with-fgnd) (collide-spec jak replica))
      (logclear! (-> control root-prim collide-with) (collide-spec jak))
      (dotimes (index 4)
        (logclear! (-> control collision-spheres (+ index 6) collide-with) (collide-spec jak replica)))
      (when (and (mp-session-in-game?)
                 (player-target-alive? player)
                 (nonnull? *mp-world-state*)
                 (nonzero? (-> *mp-world-state* friendly-fire)))
        (logior! (-> control default-collide-with-fgnd) (collide-spec jak))
        (logior! (-> control root-prim collide-with) (collide-spec jak))
        (when (-> control danger-mode)
          (dotimes (index 4)
            (logior! (-> control collision-spheres (+ index 6) collide-with) (collide-spec jak)))))))
  (none))

(defun player-set-ride-contact! ((player target) (enabled symbol))
  (when (player-body-shape-ready? player)
    (let ((control (-> player control)))
      (if enabled
        (begin
          (set! (-> control root-prim collide-as) (-> control default-collide-as-all))
          (set! (-> control root-prim collide-with) (-> control default-collide-with-all))
          (dotimes (index 3)
            (set! (-> control collision-spheres index collide-as) (-> control default-collide-as-all))
            (set! (-> control collision-spheres index collide-with) (-> control default-collide-with-all)))
          (when (nonnull? (-> control collision-spheres 4))
            (set! (-> control collision-spheres 4 collide-as) (-> control default-collide-as-fgnd))
            (set! (-> control collision-spheres 4 collide-with) (-> control default-collide-with-fgnd)))
          (player-set-attack-contact! player)
          (player-set-body-contact! player (player-collision-enabled?)))
        (begin
          (set-collide-as! control (collide-spec))
          (set-collide-with! control (collide-spec))))))
  (none))

(defun player-update-departure-contact! ((player target))
  (when (and (player-body-shape-ready? player)
             (nonnull? (-> player indax))
             (!= (-> player indax departing-player-id) MP_INVALID_PLAYER_ID))
    (let ((other (mp-player-target-by-id (-> player indax departing-player-id))))
      (when (or (not (player-target-alive? player))
                (not (player-body-shape-ready? other))
                (not (player-target-alive? other))
                (>= (player-pair-clearance player other (-> player control trans)) (meters 0.05)))
        (set! (-> player indax departing-player-id) MP_INVALID_PLAYER_ID))))
  (none))

(defun player-body-shape-ready? ((player target))
  (the symbol
       (and (nonnull? player (-> player control) (-> player control root-prim))
            (nonnull? (-> player control collision-spheres 0)
                      (-> player control collision-spheres 1)
                      (-> player control collision-spheres 2)))))

(defun player-body-collision-ready? ((player target))
  (the symbol
       (and (player-body-shape-ready? player)
            (player-target-alive? player)
            (let ((record (mp-player-process-record player)))
              (or (= player *target*)
                  (not (nonnull? record))
                  (and (zero? (-> record action scene-state)) (zero? (-> record action scene-latched?)))))
            (not (focus-test? player pilot grabbed teleporting))
            (not (player-ride-contact-disabled? player))
            (or (not (mp-target-daxter? player))
                (not (nonnull? (-> player indax)))
                (= (-> player indax departing-player-id) MP_INVALID_PLAYER_ID))
            (not (or (movie?) *scene-player*)))))

(defun player-scene-placement-active? ((player target))
  (when (nonnull? player)
    (when (or *scene-player* (movie?) (focus-test? player teleporting))
      (return #t))
    (dotimes (index 2)
      (let ((state (if (zero? index) (-> player state) (-> player next-state))))
        (when (and (nonnull? state) (= (-> state name) 'target-continue))
          (return #t)))))
  #f)

(defun player-scene-placements-ready? ()
  (when (or *scene-player* (movie?))
    (return #f))
  (mp-for-each-player-target (player-id record player)
    (when (and (nonnull? record)
               (player-target-alive? player)
               (or (nonzero? (-> record action scene-state)) (nonzero? (-> record action scene-latched?))))
      (return #f)))
  #t)

(defun player-body-sphere! ((out vector) (player target) (index int) (position vector))
  (when (and (nonnull? out position) (player-body-shape-ready? player) (>= index 0) (< index 3))
    (let ((body (-> player control collision-spheres index)))
      (if (= (-> body transform-index) -2)
        (vector+! out position (-> body local-sphere))
        (begin
          (vector-! out (-> body world-sphere) (-> player control trans))
          (vector+! out out position)))
      (set! (-> out w) (-> body local-sphere w))))
  (none))

(defun player-pair-clearance ((player target) (other target) (position vector))
  (let ((clearance (meters 1000000.0)))
    (when (and (player-body-shape-ready? player) (player-body-shape-ready? other) (nonnull? position))
      (let ((body (new 'stack 'vector))
            (other-body (new 'stack 'vector)))
        (dotimes (index 3)
          (player-body-sphere! body player index position)
          (dotimes (other-index 3)
            (player-body-sphere! other-body other other-index (-> other control trans))
            (set! clearance
                  (fmin clearance (- (vector-vector-distance body other-body) (+ (-> body w) (-> other-body w)))))))))
    clearance))

(defun player-position-clear? ((player target) (position vector))
  (unless (and (player-body-shape-ready? player) (nonnull? position))
    (return #f))
  (when (player-collision-enabled?)
    (mp-for-each-player-target (player-id record other)
      (when (and (!= player other)
                 (player-body-shape-ready? other)
                 (player-target-alive? other)
                 (not (focus-test? other pilot))
                 (not (player-ride-contact-disabled? other)))
        (when (< (player-pair-clearance player other position) (meters 0.05))
          (return #f))
        (when (nonnull? *player-contacts*)
          (let ((state (-> *player-contacts* players player-id)))
            (when (nonzero? (-> state planned?))
              (let ((relative (new 'stack 'vector)))
                (vector-! relative position (-> state planned-position))
                (vector+! relative relative (-> other control trans))
                (when (< (player-pair-clearance player other relative) (meters 0.05))
                  (return #f)))))))))
  #t)

(defun reset-player-contact! ((player-id int) (target-handle handle))
  (when (and (nonnull? *player-contacts*) (>= player-id 0) (< player-id MP_MAX_PLAYERS))
    (let ((state (-> *player-contacts* players player-id)))
      (mem-set32! (the-as pointer state) (/ (size-of player-contact-state) 4) 0)
      (set! (-> state target-handle) target-handle)
      (dotimes (other-id MP_MAX_PLAYERS)
        (set! (-> *player-contacts* players other-id nonblocking player-id) (the uint8 0)))))
  (none))

(defun get-player-contact-state ((player target))
  (when (and (nonnull? player *player-contacts*)
             (< (-> player player-id) MP_MAX_PLAYERS)
             (= player (mp-player-target-by-id (the uint (-> player player-id)))))
    (let* ((player-id (the int (-> player player-id)))
           (state (-> *player-contacts* players player-id))
           (target-handle (process->handle player))
           (ready? (player-body-collision-ready? player)))
      (when (!= (-> state target-handle) target-handle)
        (reset-player-contact! player-id target-handle)
        (set! (-> state placement-pending?) (the uint8 1)))
      (when (or (!= (-> state teleport-time) (-> player teleport-time)) (and ready? (zero? (-> state ready?))))
        (set! (-> state placement-pending?) (the uint8 1)))
      (set! (-> state teleport-time) (-> player teleport-time))
      (set! (-> state ready?) (if ready? (the uint8 1) (the uint8 0)))
      (return state)))
  (the-as player-contact-state #f))

(defun player-note-placement! ((player target))
  (when (player-collision-enabled?)
    (let ((state (get-player-contact-state player)))
      (when (nonnull? state)
        (set! (-> state placement-pending?) (the uint8 1)))))
  (none))

(defun player-pair-nonblocking? ((player target) (other target) (release? symbol))
  (unless (and (player-collision-enabled?) (nonnull? player other) (!= player other))
    (return #f))
  (let ((state (get-player-contact-state player))
        (other-state (get-player-contact-state other)))
    (when (nonnull? state other-state)
      (unless (and (player-body-shape-ready? player) (player-body-shape-ready? other))
        (return #t))
      (let ((clearance (player-pair-clearance player other (-> player control trans)))
            (player-id (-> player player-id))
            (other-id (-> other player-id)))
        (cond
          ((and release? (nonzero? (-> state ready?)) (nonzero? (-> other-state ready?)) (>= clearance (meters 0.05)))
           (set! (-> state nonblocking other-id) (the uint8 0))
           (set! (-> other-state nonblocking player-id) (the uint8 0)))
          ((and (<= clearance 0.0)
                (or (nonzero? (-> state placement-pending?)) (nonzero? (-> other-state placement-pending?))))
           (set! (-> state nonblocking other-id) (the uint8 1))
           (set! (-> other-state nonblocking player-id) (the uint8 1))))
        (return (or (zero? (-> state ready?))
                    (zero? (-> other-state ready?))
                    (nonzero? (-> state nonblocking other-id)))))))
  #f)

(defun player-body-primitive? ((body collide-shape-prim))
  (when (and (nonnull? body (-> body cshape) (-> body cshape process)) (type? (-> body cshape process) target))
    (let ((player (the-as target (-> body cshape process))))
      (when (player-body-shape-ready? player)
        (let ((control (-> player control)))
          (return (or (= body (-> control root-prim))
                      (= body (-> control collision-spheres 0))
                      (= body (-> control collision-spheres 1))
                      (= body (-> control collision-spheres 2))))))))
  #f)

(defun player-body-primitives-ignore? ((body collide-shape-prim) (other-body collide-shape-prim))
  (the symbol
       (and (player-body-primitive? body)
            (player-body-primitive? other-body)
            (player-pair-nonblocking? (the-as target (-> body cshape process))
                                      (the-as target (-> other-body cshape process))
                                      #f))))

(defun filter-player-body-cache! ((cache collide-cache) (start int) (player process) (other process))
  (when (and (nonnull? cache player other)
             (logtest? (-> cache collide-with) (collide-spec replica))
             (type? player target)
             (type? other target)
             (player-pair-nonblocking? (the-as target player) (the-as target other) #f))
    (dotimes (index (- (-> cache num-prims) start))
      (logclear! (-> cache prims (+ start index) collide-as) (collide-spec replica))))
  (none))

(defun player-set-body-contact! ((player target) (enabled symbol))
  (when (player-body-shape-ready? player)
    (let ((control (-> player control))
          (collidable (and enabled (player-body-collision-ready? player))))
      (logclear! (-> control default-collide-with-all) (collide-spec jak replica))
      (logclear! (-> control root-prim collide-with) (collide-spec replica))
      (logclear! (-> control root-prim collide-as) (collide-spec replica))
      (when collidable
        (logior! (-> control default-collide-with-all) (collide-spec replica))
        (logior! (-> control root-prim collide-with) (collide-spec replica))
        (logior! (-> control root-prim collide-as) (collide-spec replica)))
      (dotimes (index 3)
        (let ((body (-> control collision-spheres index)))
          (logclear! (-> body collide-with) (collide-spec jak replica))
          (logclear! (-> body collide-as) (collide-spec replica))
          (when collidable
            (logior! (-> body collide-with) (collide-spec replica))
            (logior! (-> body collide-as) (collide-spec replica)))))))
  (none))

(defun player-world-path-clear? ((player target) (position vector) (movement vector))
  (unless (and (player-body-shape-ready? player) (nonnull? position movement *collide-cache*))
    (return #f))
  (dotimes (index 3)
    (let ((query (new 'stack 'collide-query))
          (body (new 'stack 'vector)))
      (player-body-sphere! body player index position)
      (vector-copy! (-> query start-pos) body)
      (vector-copy! (-> query move-dist) movement)
      (set! (-> query radius) (fmax (meters 0.01) (- (-> body w) (meters 0.005))))
      (set! (-> query collide-with) (collide-spec backgnd obstacle obstacle-for-jak vehicle-mesh vehicle-sphere))
      (set! (-> query ignore-process0) player)
      (set! (-> query ignore-process1) #f)
      (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
      (set! (-> query action-mask) (collide-action solid))
      (let ((fraction (fill-and-probe-using-line-sphere *collide-cache* query)))
        (when (and (>= fraction 0.0) (< fraction 1.0))
          (return #f)))))
  #t)

(defun player-ground-placement! ((player target) (position vector) (popup float) (drop float))
  (when (and (player-body-shape-ready? player) (nonnull? position *collide-cache*))
    (let ((query (new 'stack 'collide-query))
          (movement (new 'stack 'vector)))
      (set-vector! movement 0.0 (meters 0.01) 0.0 0.0)
      (when (and (above-ground? (-> player control) query position (collide-spec backgnd) popup drop (meters 0.1))
                 (>= (-> query best-other-tri normal y) 0.7))
        (set! (-> position y) (+ (-> query best-other-tri intersect y) (meters 0.02)))
        (return (player-world-path-clear? player position movement)))))
  #f)

(defun player-placement-spacing ((player target))
  (let ((radius 0.0))
    (mp-for-each-player-target (player-id record other)
      (when (or (= other player) (player-target-alive? other))
        (when (player-body-shape-ready? other)
          (dotimes (index 3)
            (set! radius (fmax radius (-> other control collision-spheres index local-sphere w)))))))
    (+ (* 2.0 radius) (meters 0.1))))

(defun find-player-placement! ((player target)
                               (origin vector)
                               (position vector)
                               (popup float)
                               (drop float)
                               (sweep? symbol))
  (unless (and (player-body-shape-ready? player) (nonnull? origin position))
    (return #f))
  (let ((spacing (player-placement-spacing player))
        (movement (new 'stack 'vector))
        (fallback (new 'stack 'vector))
        (fallback? #f))
    (dotimes (candidate 17)
      (vector-copy! position origin)
      (when (> candidate 0)
        (let ((radius (* spacing (if (<= candidate 8) 1.0 2.0)))
              (angle (+ (* (the float (-> player player-id)) (/ (degrees 360) (the float MP_MAX_PLAYERS)))
                        (* (the float (- candidate 1)) (degrees 45)))))
          (set-vector! movement radius 0.0 0.0 0.0)
          (vector-rotate-y! movement movement angle)
          (vector+! position position movement)))
      (when (and (<= (vector-vector-xz-distance-squared position origin) (square (meters 4)))
                 (player-ground-placement! player position popup drop))
        (vector-! movement position origin)
        (when (or (not sweep?) (player-world-path-clear? player origin movement))
          (when (player-position-clear? player position)
            (return #t))
          (unless fallback?
            (vector-copy! fallback position)
            (set! fallback? #t)))))
    (when fallback?
      (vector-copy! position fallback)
      (return #t)))
  #f)

(defun plan-player-placement! ((player target) (state player-contact-state))
  (when (and (nonnull? state) (player-body-collision-ready? player) (nonzero? (-> state placement-pending?)))
    (if (player-position-clear? player (-> player control trans))
      (begin
        (vector-copy! (-> state planned-position) (-> player control trans))
        (set! (-> state planned?) (the uint8 1)))
      (when (find-player-placement! player
                                    (-> player control trans)
                                    (-> state planned-position)
                                    (meters 0.5)
                                    (meters 1)
                                    #t)
        (set! (-> state planned?) (the uint8 1)))))
  (none))

(defun apply-local-player-placement! ()
  (when (and (nonnull? *target* (-> *target* control)) (player-body-collision-ready? *target*))
    (let ((state (get-player-contact-state *target*)))
      (when (and (nonnull? state)
                 (nonzero? (-> state planned?))
                 (> (vector-vector-distance-squared (-> *target* control trans) (-> state planned-position)) 0.0))
        (move-to-point! (-> *target* control) (-> state planned-position))
        (reset-teleport-history! *target*)
        (set! (-> state teleport-time) (-> *target* teleport-time))
        (mp-for-each-player-target (player-id record other)
          (player-pair-nonblocking? *target* other #f)))))
  (none))

(defun player-contact-tick! ()
  (when (nonnull? *player-contacts*)
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((player (mp-player-target-by-id (the uint player-id))))
        (if (and (player-collision-enabled?) (nonnull? player))
          (get-player-contact-state player)
          (reset-player-contact! player-id (the-as handle #f)))))
    (let ((placements-ready? (player-scene-placements-ready?)))
      (mp-for-each-player-target (player-id record player)
        (mp-for-each-player-target (other-id other-record other)
          (when (> other-id player-id)
            (player-pair-nonblocking? player other placements-ready?))))
      (when (and (player-collision-enabled?) placements-ready?)
        (mp-for-each-player-target (player-id record player)
          (plan-player-placement! player (-> *player-contacts* players player-id)))
        (apply-local-player-placement!))
      (dotimes (player-id MP_MAX_PLAYERS)
        (let ((state (-> *player-contacts* players player-id)))
          (when (and placements-ready? (nonzero? (-> state ready?)))
            (set! (-> state placement-pending?) (the uint8 0)))
          (set! (-> state planned?) (the uint8 0))))))
  (none))

(defun player-interaction-tick! ()
  (let ((enabled (player-collision-enabled?)))
    (mp-for-each-player-target (player-id record player)
      (player-update-departure-contact! player)
      (player-set-attack-contact! player)
      (player-set-body-contact! player enabled)
      (when (player-ride-contact-disabled? player)
        (player-set-ride-contact! player #f)))
    (player-contact-tick!))
  (none))
