;;-*-Lisp-*-
(in-package goal)

(defun mp-cutscene-actor-character ((actor scene-actor))
  (when (nonnull? actor)
    (let ((art-group (-> actor art-group)))
      (when (nonnull? art-group)
        (cond
          ((or (string= art-group "skel-jak-highres")
               (string= art-group "skel-jak-highres-prison")
               (string= art-group "skel-darkjak-highres"))
           (return (mp-player-character jak)))
          ((string= art-group "skel-sidekick-highres") (return (mp-player-character daxter)))))))
  (mp-player-character unknown))

(defun mp-cutscene-appearance-record-eligible? ((record mp-player-record) (character mp-player-character))
  (and (nonnull? record)
       (mp-player-character-valid? character)
       (nonzero? (-> record identity identity-ready?))
       (nonzero? (-> record identity joined?))
       (= (-> record identity spectator-only?) 0)
       (nonzero? (-> record connection connected?))
       (= (-> record identity character) character)))

(defun mp-cutscene-appearance-owner ((character mp-player-character))
  (when (and (nonnull? *mp-player-controller*) (mp-player-character-valid? character))
    (let ((local-record (mp-local-player-record)))
      (when (mp-cutscene-appearance-record-eligible? local-record character)
        (return local-record)))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (mp-cutscene-appearance-record-eligible? record character)
          (return record)))))
  (the-as mp-player-record #f))

(defun cutscene-apply-visual-secrets! ((actor-process manipy)
                                       (character mp-player-character)
                                       (visual-secrets mp-player-visual-secrets))
  (when (nonnull? actor-process)
    (when (and (= character (mp-player-character jak))
               (not (logtest? (mp-player-visual-secrets goatee-visible) visual-secrets)))
      (send-event actor-process 'segment 0 16))
    (let ((head (-> actor-process joint 0)))
      (when (nonnull? head)
        (when (and (= character (mp-player-character daxter))
                   (nonnull? (-> actor-process node-list) (-> actor-process node-list data)))
          (set! (-> head joint) (-> actor-process node-list data 9))
          (set! (-> head base-joint) (the-as uint 9)))
        (let ((head-scale (new-stack-vector0)))
          (set-vector! head-scale 1.0 1.0 1.0 1.0)
          (cond
            ((logtest? (mp-player-visual-secrets little-head) visual-secrets) (set-vector! head-scale 0.4 0.4 0.4 1.0))
            ((logtest? (mp-player-visual-secrets big-head) visual-secrets) (set-vector! head-scale 2.0 2.0 2.0 1.0)))
          (when (nonnull? (-> head joint))
            (mode-set! head (joint-mod-mode joint-set*))
            (trs-set! head (the-as vector #f) (the-as quaternion #f) head-scale))))))
  (none))

(defun mp-apply-cutscene-actor-appearance! ((actor scene-actor) (actor-process process))
  (when (nonnull? actor actor-process)
    (let ((character (mp-cutscene-actor-character actor))
          (drawable (the-as process-drawable actor-process)))
      (when (and (mp-player-character-valid? character) (nonnull? drawable (-> drawable draw)))
        (let ((draw-control (-> drawable draw))
              (owner (mp-cutscene-appearance-owner character))
              (visual-secrets (if (= character (mp-player-character jak)) (mp-local-player-visual-secrets) (the-as mp-player-visual-secrets 0))))
          (if (nonnull? owner)
            (begin
              (mp-apply-render-appearance! draw-control (-> owner identity appearance))
              (set! visual-secrets
                    (if (= (-> owner identity player-id) (mp-local-player-id)) (mp-local-player-visual-secrets) (-> owner action visual-secrets))))
            (mp-clear-render-appearance! draw-control))
          (when (type? actor-process manipy)
            (cutscene-apply-visual-secrets! (the-as manipy actor-process) character visual-secrets))))))
  (none))
