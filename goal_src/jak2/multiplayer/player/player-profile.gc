;;-*-Lisp-*-
(in-package goal)

(defun character-change-state? ((name symbol))
  (or (= name 'player-character-change) (= name 'player-character-reappear)))

(defun player-changing-character? ((player target))
  (if (and (nonnull? player)
           (or (and (nonnull? (-> player state)) (character-change-state? (-> player state name)))
               (and (nonnull? (-> player next-state)) (character-change-state? (-> player next-state name)))))
    #t
    #f))

(defun can-change-player-character? ()
  (let ((record (mp-local-player-record)))
    (when (and (mp-session-active?) (not (mp-session-in-game?)))
      (unless (and (nonnull? record)
                   (zero? (-> record identity lobby-ready?))
                   (= (pc-multi-get-session-status) (mp-connection-status lobby)))
        (return #f)))
    (when (mp-session-in-game?)
      (unless (nonnull? *target* (-> *target* control) (-> *target* fact))
        (return #f))
      (when (or (player-changing-character? *target*)
                (movie?)
                (real-movie?)
                (and (nonnull? record) (nonzero? (-> record action scene-state)))
                (focus-test? *target* dead pilot pilot-riding board)
                (<= (-> *target* fact health) 0.0)
                (player-using-turret? *target*)
                (mp-target-ride-along? *target*))
        (return #f))))
  #t)

(defbehavior animate-player-character-size! target ()
  (when (nonnull? self (-> self control))
    (set-time! (-> self state-time))
    (until (time-elapsed? (-> self state-time) (seconds 0.5))
      (ja :group! (if (focus-test? self indax) daxter-indax-stance-ja jakb-stance-loop-ja) :num! (loop!))
      (suspend)))
  (none))

(defbehavior post-player-character-change target ()
  (when (nonnull? self (-> self control) (-> self state))
    (target-no-move-post)
    (let* ((elapsed (the float (- (current-time) (-> self state-time))))
           (progress (smooth-step (/ elapsed (fsec 0.5))))
           (scale (if (= (-> self state name) 'player-character-reappear) (lerp 0.025 1.0 progress) (lerp 1.0 0.025 progress))))
      (vector-float*! (-> self control scale) (-> self control scale) scale)
      (set! (-> self control scale w) 1.0)))
  (none))

(defbehavior exit-player-character-change target ()
  (when (nonnull? self (-> self control))
    (if (and (nonnull? (-> self next-state)) (= (-> self next-state name) 'player-character-reappear))
      (set-vector! (-> self control scale) 0.025 0.025 0.025 1.0)
      (vector-identity! (-> self control scale)))
    (when (focus-test? self indax)
      (target-indax-exit)))
  (none))

(define-extern player-character-reappear (state float target))

(defstate player-character-change (target)
  :event target-standard-event-handler
  :exit exit-player-character-change
  :code
    (behavior ((character mp-player-character))
      (when (nonnull? self (-> self control) (-> self fact))
        (animate-player-character-size!)
        (let ((record (mp-player-controller-target-record *mp-player-controller* self)))
          (when (nonnull? record)
            (set! (-> record identity character) character)))
        (go player-character-reappear (-> self fact health))))
  :post post-player-character-change)

(defstate player-character-reappear (target)
  :event target-standard-event-handler
  :exit exit-player-character-change
  :code
    (behavior ((health float))
      (when (nonnull? self (-> self control) (-> self fact))
        (when (mp-target-daxter? self)
          (target-indax-init #f #f))
        (set! (-> self fact health) health)
        (animate-player-character-size!)
        (if (mp-target-daxter? self) (go target-indax-stance) (go target-stance))))
  :post post-player-character-change)

(defun apply-player-character-change! ((record mp-player-record) (character mp-player-character))
  (when (and (nonnull? record) (!= (-> record identity character) character))
    (let ((player (mp-player-record-target record)))
      (cond
        ((or (not (mp-session-in-game?))
             (not (mp-player-character-valid? (-> record identity character)))
             (not (mp-player-character-valid? character))
             (not (nonnull? player (-> player control) (-> player fact)))
             (focus-test? player dead)
             (<= (-> player fact health) 0.0))
         (set! (-> record identity character) character))
        ((not (player-changing-character? player))
         (set! (-> record runtime action-warmup-start) (current-time))
         (set! (-> record runtime state-mismatch-count) 0)
         (go-process player player-character-change character)))))
  (none))
