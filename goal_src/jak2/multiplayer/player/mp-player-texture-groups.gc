;;-*-Lisp-*-
(in-package goal)

(defun mp-player-skin-copy! ((destination mp-player-skin) (source mp-player-skin))
  (when (and destination (nonzero? destination) source (nonzero? source))
    (dotimes (slot MP_PLAYER_SKIN_SLOT_COUNT)
      (set! (-> destination colors slot) (-> source colors slot))
      (set! (-> destination strengths slot) (-> source strengths slot))))
  (none))

(defun mp-player-skin-group-text-id ((group mp-player-skin-group))
  (cond
    ((= group (mp-player-skin-group jak-jacket)) (text-id progress-lobby-color-group-jacket))
    ((= group (mp-player-skin-group jak-armor)) (text-id progress-lobby-color-group-armor))
    ((= group (mp-player-skin-group jak-pants)) (text-id progress-lobby-color-group-pants))
    ((= group (mp-player-skin-group jak-boots)) (text-id progress-lobby-color-group-boots))
    ((= group (mp-player-skin-group jak-leggings)) (text-id progress-lobby-color-group-leggings))
    ((= group (mp-player-skin-group jak-scarf)) (text-id progress-lobby-color-group-scarf))
    ((= group (mp-player-skin-group jak-pouch)) (text-id progress-lobby-color-group-pouch))
    ((= group (mp-player-skin-group jak-straps)) (text-id progress-lobby-color-group-straps))
    ((= group (mp-player-skin-group jak-gloves)) (text-id progress-lobby-color-group-gloves))
    ((= group (mp-player-skin-group daxter-hat)) (text-id progress-lobby-color-group-hat))
    ((= group (mp-player-skin-group daxter-fur)) (text-id progress-lobby-color-group-fur))
    (else (text-id progress-lobby-color-group-primary))))

(defun mp-player-skin-group-name ((group mp-player-skin-group))
  (lookup-text! *common-text* (mp-player-skin-group-text-id group) #f))

(defun mp-player-skin-group-for-character? ((group mp-player-skin-group) (character mp-player-character))
  (or (= group (mp-player-skin-group primary))
      (and (= character (mp-player-character jak))
           (>= group (mp-player-skin-group jak-jacket))
           (<= group (mp-player-skin-group jak-gloves)))
      (and (= character (mp-player-character daxter))
           (>= group (mp-player-skin-group daxter-hat))
           (<= group (mp-player-skin-group daxter-fur)))))

(defun mp-player-skin-group-registered? ((group mp-player-skin-group))
  (or (mp-player-skin-group-for-character? group (mp-player-character jak))
      (mp-player-skin-group-for-character? group (mp-player-character daxter))))

(defun mp-player-skin-normalize-reserved-slots! ((skin mp-player-skin))
  (when (and skin (nonzero? skin))
    (let ((primary-color (-> skin colors MP_PLAYER_PRIMARY_SKIN_SLOT)))
      (dotimes (slot MP_PLAYER_SKIN_SLOT_COUNT)
        (unless (mp-player-skin-group-registered? (the-as mp-player-skin-group slot))
          (set! (-> skin colors slot) primary-color)
          (set! (-> skin strengths slot) 0.0)))
      (set! (-> skin strengths MP_PLAYER_PRIMARY_SKIN_SLOT) 0.0)))
  (none))

(defun mp-player-skin-next-group ((group mp-player-skin-group) (character mp-player-character) (step int))
  (let ((candidate (the-as int group)))
    (dotimes (_ MP_PLAYER_SKIN_SLOT_COUNT)
      (set! candidate (mod (+ candidate (if (< step 0) (- MP_PLAYER_SKIN_SLOT_COUNT 1) 1)) MP_PLAYER_SKIN_SLOT_COUNT))
      (let ((candidate-group (the-as mp-player-skin-group candidate)))
        (when (mp-player-skin-group-for-character? candidate-group character)
          (return candidate-group)))))
  (mp-player-skin-group primary))

(defun mp-apply-render-skin! ((draw-control draw-control) (skin mp-player-skin))
  (when (and draw-control (nonzero? draw-control) skin (nonzero? skin))
    (dotimes (slot MP_PLAYER_SKIN_SLOT_COUNT)
      (set! (-> draw-control pc-player-tint-colors slot) (-> skin colors slot))
      (set! (-> draw-control pc-player-tint-strengths slot) (-> skin strengths slot))))
  (none))

(defun mp-clear-render-skin! ((draw-control draw-control))
  (when (and draw-control (nonzero? draw-control))
    (dotimes (slot MP_PLAYER_SKIN_SLOT_COUNT)
      (set! (-> draw-control pc-player-tint-colors slot) (the uint 0))
      (set! (-> draw-control pc-player-tint-strengths slot) 0.0)))
  (none))

(defun mp-apply-player-render-skin! ((proc target))
  (when (and proc (nonzero? proc))
    (let ((draw-control (-> proc draw)))
      (when (and draw-control (nonzero? draw-control))
        (let ((record (mp-player-color-record-by-id (the-as int (-> proc player-id)))))
          (if (and record (nonzero? record))
            (mp-apply-render-skin! draw-control (-> record identity skin))
            (mp-clear-render-skin! draw-control))))))
  (none))

(defun mp-refresh-player-render-skin! ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((player-target (mp-player-record-target record)))
      (when (and player-target (nonzero? player-target))
        (let ((draw-control (-> player-target draw)))
          (when (and draw-control (nonzero? draw-control))
            (let ((skin (-> record identity skin))
                  (needs-refresh? #f))
              (dotimes (slot MP_PLAYER_SKIN_SLOT_COUNT)
                (when (or (!= (-> draw-control pc-player-tint-colors slot) (-> skin colors slot))
                          (!= (-> draw-control pc-player-tint-strengths slot) (-> skin strengths slot)))
                  (set! needs-refresh? #t)))
              (when needs-refresh?
                (mp-apply-render-skin! draw-control skin))))))))
  (none))

(defun mp-refresh-player-render-skins! ()
  (when (and *mp-player-controller* (nonzero? *mp-player-controller*))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record (nonzero? record))
          (mp-refresh-player-render-skin! record)))))
  (none))
