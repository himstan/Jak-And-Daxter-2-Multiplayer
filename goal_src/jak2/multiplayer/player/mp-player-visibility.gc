;;-*-Lisp-*-
(in-package goal)

(defun mp-jak-has-riding-daxter? ((jak-target target))
  "Return true when a live Daxter record contextually resolves to this Jak."
  (when (and jak-target (nonzero? jak-target))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (mp-player-daxter? record))
          (let ((daxter-target (mp-player-record-target record)))
            (when (and daxter-target
                       (nonzero? daxter-target)
                       (mp-target-ride-along? daxter-target)
                       (= (mp-jak-target-for daxter-target) jak-target))
              (return #t)))))))
  #f)

(defun mp-update-player-target-visibility!
       ((player-target target) (in-movie? symbol))
  (when (and player-target
             (nonzero? player-target)
             (-> player-target draw)
             (nonzero? (-> player-target draw)))
    (if in-movie?
        (logior! (-> player-target draw status) (draw-control-status no-draw))
        (logclear!
          (-> player-target draw status)
          (if (mp-target-jak? player-target)
              (draw-control-status no-draw no-draw-bounds2)
              (draw-control-status no-draw no-draw-bounds)))))
  (none))

(defun mp-update-player-sidekick-visibility!
       ((player-target target) (in-movie? symbol))
  (when (and player-target
             (nonzero? player-target)
             (-> player-target sidekick)
             (nonzero? (-> player-target sidekick)))
    (let ((sidekick-proc
            (the-as sidekick (ppointer->process (-> player-target sidekick)))))
      (when (and sidekick-proc
                 (nonzero? sidekick-proc)
                 (-> sidekick-proc draw)
                 (nonzero? (-> sidekick-proc draw)))
        (if (or in-movie?
                (and (mp-target-jak? player-target)
                     (not (mp-jak-has-riding-daxter? player-target)))
                (and (mp-target-daxter? player-target)
                     (mp-target-ride-along? player-target)))
            (logior! (-> sidekick-proc draw status) (draw-control-status no-draw))
            (logclear! (-> sidekick-proc draw status) (draw-control-status no-draw))))))
  (none))

(defun mp-update-player-visibility ()
  "Update every bound player target and its contextual sidekick presentation."
  (let ((in-movie? (if (or (movie?) *scene-player*) #t #f)))
    (when (not in-movie?)
      (mp-sync-enemies-update))

    ;; Preserve vanilla local visibility overrides, then handle every remote record.
    (when (and *target*
               (nonzero? *target*)
               (or in-movie? (not *visibility-overriden?*)))
      (mp-update-player-target-visibility! *target* in-movie?))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-record-by-id (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (mp-player-record-remote? *mp-player-controller* record))
          (let ((player-target (mp-player-record-target record)))
            (when (and player-target (nonzero? player-target))
              (mp-update-player-target-visibility! player-target in-movie?))))))

    (when (mp-connection-status-active? (pc-multi-get-status))
      (dotimes (player-id MP_MAX_PLAYERS)
        (let ((record (mp-player-record-by-id (the-as uint player-id))))
          (when (and record (nonzero? record))
            (let ((player-target (mp-player-record-target record)))
              (when (and player-target (nonzero? player-target))
                (mp-update-player-sidekick-visibility!
                  player-target in-movie?)))))))
    )
  (none))
