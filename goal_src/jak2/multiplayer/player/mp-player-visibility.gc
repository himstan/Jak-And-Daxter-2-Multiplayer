;;-*-Lisp-*-
(in-package goal)

(defun get-jak-rider ((jak-target target))
  (when (nonnull? jak-target)
    (let* ((record (mp-player-record-by-id (-> jak-target riding-along-player-id)))
           (rider (mp-player-record-target record)))
      (when (and (nonnull? record rider)
                 (mp-player-daxter? record)
                 (not (focus-test? rider dead inactive))
                 (= (-> rider riding-along-player-id) (-> jak-target player-id)))
        (let ((state (-> rider state))
              (next-state (-> rider next-state)))
          (when (or (mp-target-ride-along? rider)
                    (and (nonnull? state) (= (-> state name) 'target-indax-jump-on))
                    (and (nonnull? next-state) (= (-> next-state name) 'target-indax-jump-on)))
            (return rider))))
      (set! (-> jak-target riding-along-player-id) MP_INVALID_PLAYER_ID)))
  (the-as target #f))

(defun mp-update-player-target-visibility! ((player-target target) (in-movie? symbol))
  (when (and player-target (nonzero? player-target) (-> player-target draw) (nonzero? (-> player-target draw)))
    (if (or in-movie? (mp-target-ride-along? player-target))
      (logior! (-> player-target draw status) (draw-control-status no-draw))
      (logclear! (-> player-target draw status)
                 (if (mp-target-jak? player-target)
                   (draw-control-status no-draw no-draw-bounds2)
                   (draw-control-status no-draw no-draw-bounds)))))
  (none))

(defun mp-update-player-sidekick-visibility! ((player-target target) (sidekick-proc sidekick) (in-movie? symbol))
  (when (and player-target
             (nonzero? player-target)
             sidekick-proc
             (nonzero? sidekick-proc)
             (-> sidekick-proc draw)
             (nonzero? (-> sidekick-proc draw)))
    (if (or in-movie?
            (and (mp-target-jak? player-target)
                 (let ((rider (get-jak-rider player-target))) (not (and (nonnull? rider) (mp-target-ride-along? rider)))))
            (and (mp-target-daxter? player-target) (mp-target-ride-along? player-target)))
      (logior! (-> sidekick-proc draw status) (draw-control-status no-draw))
      (logclear! (-> sidekick-proc draw status) (draw-control-status no-draw))))
  (none))

(defun mp-update-player-visibility! ((sidekick-proc sidekick))
  (when (and (mp-session-in-game?)
             sidekick-proc
             (nonzero? sidekick-proc)
             (-> sidekick-proc parent)
             (nonzero? (-> sidekick-proc parent))
             *mp-player-controller*
             (nonzero? *mp-player-controller*))
    (let ((player-target (the-as target (ppointer->process (-> sidekick-proc parent)))))
      (when (and player-target (nonzero? player-target))
        (let ((record (mp-player-controller-target-record *mp-player-controller* player-target))
              (in-movie? (if (and *scene-player* (movie?)) #t #f)))
          (when (and record (nonzero? record))
            (when (is-record-remote-player? record)
              (mp-update-player-target-visibility! player-target in-movie?))
            (mp-update-player-sidekick-visibility! player-target sidekick-proc in-movie?))
          (when (and (= player-target *target*) (or in-movie? (not *visibility-overriden?*)))
            (mp-update-player-target-visibility! player-target in-movie?))))))
  (none))
