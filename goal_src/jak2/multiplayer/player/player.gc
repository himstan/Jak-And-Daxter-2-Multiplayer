;;-*-Lisp-*-
(in-package goal)

(defun mp-player-slot-valid? ((player-slot uint))
  (< player-slot (the uint MP_MAX_PLAYERS)))

(defun mp-player-controller-slot ((controller mp-player-controller) (player-slot uint))
  (if (and controller (nonzero? controller) (mp-player-slot-valid? player-slot))
    (-> controller records player-slot)
    (the-as mp-player-record #f)))

(defun mp-player-pad-reset! ((pad-index uint))
  (when (and (> pad-index (the uint 0))
             (< pad-index (the uint MP_MAX_PLAYERS))
             *cpad-list*
             (nonzero? *cpad-list*)
             *cpad-history-list*
             (nonzero? *cpad-history-list*))
    (let ((pad (-> *cpad-list* cpads pad-index))
          (history (-> *cpad-history-list* cpads pad-index)))
      (when (and pad (nonzero? pad))
        (cpad-invalid! pad)
        (set! (-> pad number) (the-as int pad-index)))
      (when (and history (nonzero? history))
        (dotimes (history-index 15)
          (set! (-> history button0-abs history-index) (pad-buttons))
          (set! (-> history button0-rel history-index) (pad-buttons)))))))

(defun mp-player-controller-pad-in-use? ((controller mp-player-controller) (pad-index uint) (excluded-player-slot uint))
  (let ((in-use? #f))
    (when (and controller (nonzero? controller))
      (dotimes (player-slot MP_MAX_PLAYERS)
        (let ((record (mp-player-controller-slot controller (the-as uint player-slot))))
          (when (and record
                     (nonzero? record)
                     (!= (-> record identity player-slot) excluded-player-slot)
                     (= (the-as uint (-> record runtime pad-index)) pad-index))
            (set! in-use? #t)))))
    in-use?))

(defun mp-player-controller-lease-pad! ((controller mp-player-controller) (record mp-player-record))
  (when (and controller (nonzero? controller) record (nonzero? record))
    (let ((player-slot (the-as uint (-> record identity player-slot)))
          (current-pad (the-as uint (-> record runtime pad-index))))
      (when (= player-slot (-> controller local-player-slot))
        (set! (-> record runtime pad-index) (the uint8 0))
        (return (the uint 0)))
      (when (and (> current-pad (the uint 0)) (< current-pad (the uint MP_MAX_PLAYERS)))
        (return current-pad))
      (dotimes (pad-offset (- MP_MAX_PLAYERS 1))
        (let ((candidate-pad (the-as uint (+ pad-offset 1))))
          (when (not (mp-player-controller-pad-in-use? controller candidate-pad player-slot))
            (mp-player-pad-reset! candidate-pad)
            (set! (-> record runtime pad-index) (the-as uint8 candidate-pad))
            (return candidate-pad))))))
  (the-as uint MP_INVALID_PAD_INDEX))

(defun mp-player-controller-release-pad! ((controller mp-player-controller) (record mp-player-record))
  (when (and controller (nonzero? controller) record (nonzero? record))
    (let ((pad-index (the-as uint (-> record runtime pad-index))))
      (when (and (> pad-index (the uint 0)) (< pad-index (the uint MP_MAX_PLAYERS)))
        (mp-player-pad-reset! pad-index))
      (set! (-> record runtime pad-index) MP_INVALID_PAD_INDEX))))

(defun mp-player-target-clear-player-slot! ((player-target target))
  (when (nonnull? player-target)
    (set! (-> player-target player-slot) MP_INVALID_PLAYER_SLOT)
    (when (nonnull? (-> player-target draw))
      (set! (-> player-target draw pc-eye-instance-id) MP_INVALID_PLAYER_SLOT))
    (let ((sk-ptr (-> player-target sidekick)))
      (when (nonnull? sk-ptr)
        (let ((sk (the-as sidekick (ppointer->process sk-ptr))))
          (when (nonnull? sk (-> sk draw))
            (set! (-> sk draw pc-eye-instance-id) MP_INVALID_PLAYER_SLOT))))))
  (none))

(defun mp-player-record-reset! ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((old-target (the-as target (handle->process-safe (-> record runtime target-handle)))))
      (mp-player-target-clear-player-slot! old-target))
    (let ((lifecycle (-> record connection lifecycle-generation)))
      (mem-set32! (the-as pointer record) (/ (size-of mp-player-record) 4) 0)
      (set! (-> record connection lifecycle-generation) lifecycle))
    (set! (-> record identity player-slot) MP_INVALID_PLAYER_SLOT)
    (set! (-> record identity character) (mp-player-character unknown))
    (set! (-> record action riding-along-player-slot) MP_INVALID_PLAYER_SLOT)
    (set! (-> record runtime pad-index) MP_INVALID_PAD_INDEX)
    (set! (-> record runtime last-gun-log-active) -1)
    (set! (-> record runtime last-gun-log-requested) -1)))

(defun mp-broadcast-process-tree ((tree process-tree) (msg symbol) (param0 uint) (param1 uint))
  (when (and tree (nonzero? tree))
    (when (and (not (logtest? (-> tree mask) (process-mask process-tree)))
               (valid? tree process (the-as string #f) #f 0)
               (nonzero? (-> (the-as process tree) pid))
               (!= (-> (the-as process tree) status) 'dead))
      (send-event (the-as process tree) msg param0 param1))
    (let ((child-node (-> tree child)))
      (while (and child-node (nonzero? child-node))
        (let ((next-brother (-> child-node 0 brother)))
          (mp-broadcast-process-tree (-> child-node 0) msg param0 param1)
          (set! child-node next-brother)))))
  (none))

(defun mp-broadcast-event-to-active-processes ((msg symbol) (param0 uint) (param1 uint))
  (when (and *active-pool* (nonzero? *active-pool*))
    (mp-broadcast-process-tree *active-pool* msg param0 param1))
  (none))

(defun mp-broadcast-player-join! ((record mp-player-record))
  (when (and record (nonzero? record) (nonzero? (-> record identity joined?)) (is-record-remote-player? record))
    (let ((player-slot (-> record identity player-slot)))
      (mp-broadcast-event-to-active-processes 'player-joined (the-as uint record) (the-as uint player-slot))))
  (none))

(defun mp-broadcast-player-leave! ((record mp-player-record))
  (when (and record (nonzero? record) (is-record-remote-player? record))
    (let ((player-slot (-> record identity player-slot)))
      (mp-broadcast-event-to-active-processes 'player-left (the-as uint record) (the-as uint player-slot))))
  (none))

(defun mp-player-controller-release-slot! ((controller mp-player-controller) (player-slot uint))
  (when (and controller (nonzero? controller) (mp-player-slot-valid? player-slot))
    (let ((record (mp-player-controller-slot controller player-slot)))
      (when (and record (nonzero? record))
        (when (mp-player-runtime-flag? record (mp-player-runtime-flags join-announced))
          (mp-broadcast-player-leave! record)
          (mp-player-runtime-clear-flag! record (mp-player-runtime-flags join-announced)))
        (when (and (!= player-slot (-> controller local-player-slot)) (nonzero? (-> record runtime target-handle)))
          (player-replica-deactivate! record 'slot-release))
        (set! (-> record runtime vehicle-handle) (the-as handle #f))
        (mp-player-controller-release-pad! controller record)
        (mp-player-record-reset! record))))
  (none))

(defun mp-player-controller-register! ((controller mp-player-controller)
                                       (player-slot uint)
                                       (character mp-player-character))
  (let ((record (mp-player-controller-slot controller player-slot)))
    (when (and record (nonzero? record) (mp-player-character-valid? character))
      (mp-player-controller-release-slot! controller player-slot)
      (set! (-> record identity player-slot) (the-as uint32 player-slot))
      (set! (-> record identity character) character)
      (set! (-> record identity identity-ready?) (the uint8 1))
      (set! (-> record identity joined?) (the uint8 1))
      (set! (-> record connection connected?) (the uint8 1))
      (mp-player-runtime-set-flag! record (mp-player-runtime-flags join-announced))
      (mp-broadcast-player-join! record))
    record))

(defun mp-player-controller-reset! ((controller mp-player-controller))
  (when (and controller (nonzero? controller))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (mp-player-controller-release-slot! controller (the-as uint player-slot)))
    (set! (-> controller local-player-slot) MP_INVALID_PLAYER_SLOT)
    (set! (-> controller host-player-slot) MP_INVALID_PLAYER_SLOT)))

(defun mp-player-controller-record ((controller mp-player-controller) (player-slot uint))
  (let ((record (mp-player-controller-slot controller player-slot)))
    (if (and record (nonzero? record) (nonzero? (-> record identity joined?))) record (the-as mp-player-record #f))))

(defun mp-player-controller-record-id ((controller mp-player-controller) (record mp-player-record))
  (when (and controller (nonzero? controller) record (nonzero? record))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (when (= record (mp-player-controller-slot controller (the-as uint player-slot)))
        (return (the-as uint player-slot)))))
  MP_INVALID_PLAYER_SLOT)

(defun mp-player-controller-local-record ((controller mp-player-controller))
  (if (and controller (nonzero? controller))
    (mp-player-controller-record controller (-> controller local-player-slot))
    (the-as mp-player-record #f)))

(defun mp-player-controller-host-record ((controller mp-player-controller))
  (if (and controller (nonzero? controller))
    (mp-player-controller-record controller (-> controller host-player-slot))
    (the-as mp-player-record #f)))

(defun mp-player-controller-target-record ((controller mp-player-controller) (player-target target))
  (if (and player-target (nonzero? player-target))
    (mp-player-controller-record controller (-> player-target player-slot))
    (the-as mp-player-record #f)))

(defun mp-player-process-record ((player-process process))
  (if (and player-process (nonzero? player-process) (type? player-process target))
    (mp-player-controller-target-record *mp-player-controller* (the-as target player-process))
    (the-as mp-player-record #f)))

(defun mp-player-slot-from-process ((player-process process))
  (let ((record (mp-player-process-record player-process)))
    (if (and record (nonzero? record)) (the-as uint (-> record identity player-slot)) MP_INVALID_PLAYER_SLOT)))

(defun mp-player-controller-target-pad-index ((controller mp-player-controller)
                                              (player-slot uint)
                                              (leased-pad-index uint))
  (if (and controller
           (nonzero? controller)
           (= player-slot (-> controller local-player-slot))
           (or (= *master-mode* 'menu) (= *master-mode* 'progress) (= *master-mode* 'pause) (= *master-mode* 'freeze)))
    (the uint CPAD_TARGET_INPUT_SINK_INDEX)
    leased-pad-index))

(defun mp-player-controller-bind-target! ((controller mp-player-controller) (player-slot uint) (player-target target))
  (when (and controller (nonzero? controller) player-target (nonzero? player-target))
    (let ((record (mp-player-controller-record controller player-slot)))
      (when (and record (nonzero? record))
        (let* ((bound-target (the-as target (handle->process-safe (-> record runtime target-handle))))
               (control (-> player-target control))
               (target-already-bound? (and bound-target (nonzero? bound-target) (= bound-target player-target))))
          (when (and bound-target (nonzero? bound-target) (not target-already-bound?))
            (mp-player-target-clear-player-slot! bound-target))
          (set! (-> player-target player-slot) (the-as uint32 player-slot))
          (when (and (-> player-target draw) (nonzero? (-> player-target draw)))
            (set! (-> player-target draw pc-eye-instance-id) player-slot))
          (mp-apply-player-render-skin! player-target)
          (set! (-> record runtime target-handle) (process->handle player-target))
          (let* ((leased-pad-index (mp-player-controller-lease-pad! controller record))
                 (target-pad-index (mp-player-controller-target-pad-index controller player-slot leased-pad-index)))
            (when (and (<= target-pad-index (the uint CPAD_TARGET_INPUT_SINK_INDEX))
                       control
                       (nonzero? control)
                       *cpad-list*
                       (nonzero? *cpad-list*)
                       (or (not target-already-bound?) (not (and (-> control cpad) (nonzero? (-> control cpad))))))
              (set! (-> control cpad) (-> *cpad-list* cpads target-pad-index)))))))))

(defun mp-player-controller-reassign-local! ((controller mp-player-controller) (new-player-slot uint))
  (when (and controller (nonzero? controller) (mp-player-slot-valid? new-player-slot))
    (let ((old-player-slot (the-as uint (-> controller local-player-slot))))
      (when (and (mp-player-slot-valid? old-player-slot) (!= old-player-slot new-player-slot))
        (let ((old-record (mp-player-controller-record controller old-player-slot))
              (new-record (mp-player-controller-slot controller new-player-slot)))
          (when (and old-record (nonzero? old-record) new-record (nonzero? new-record))
            (let ((local-target (the-as target (handle->process-safe (-> old-record runtime target-handle)))))
              (mp-player-controller-release-slot! controller new-player-slot)
              (mem-copy! (the-as pointer new-record) (the-as pointer old-record) (size-of mp-player-record))
              (mp-player-record-reset! old-record)
              (set! (-> new-record identity player-slot) (the-as uint32 new-player-slot))
              (set! (-> new-record runtime pad-index) (the uint8 0))
              (set! (-> controller local-player-slot) (the-as uint32 new-player-slot))
              (when (and local-target (nonzero? local-target))
                (set! (-> local-target player-slot) (the-as uint32 new-player-slot))
                (set! (-> new-record runtime target-handle) (process->handle local-target))
                (mp-player-controller-bind-target! controller new-player-slot local-target))))))))
  (mp-player-controller-local-record controller))

(defun player-unbind-target! ((record mp-player-record))
  (when (nonnull? record)
    (let ((player-target (the-as target (handle->process-safe (-> record runtime target-handle)))))
      (unless (and (nonnull? player-target *target*) (= player-target *target*))
        (mp-player-target-clear-player-slot! player-target)))
    (set! (-> record runtime target-handle) (the-as handle #f)))
  (none))

(defun is-record-remote-player? ((record mp-player-record))
  (the-as symbol
          (and (nonnull? *mp-player-controller* record)
               (!= (-> record identity player-slot) (-> *mp-player-controller* local-player-slot)))))

(defun mp-player-controller-for-each-remote! ((controller mp-player-controller)
                                              (callback (function mp-player-record none)))
  (when (and controller (nonzero? controller) callback (nonzero? callback))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (let ((record (mp-player-controller-record controller (the-as uint player-slot))))
        (when (and record (nonzero? record) (is-record-remote-player? record))
          (callback record))))))

(defun mp-player-controller-for-each-stale-remote! ((controller mp-player-controller)
                                                    (callback (function mp-player-record none)))
  (when (and controller (nonzero? controller) callback (nonzero? callback))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (let ((record (mp-player-controller-slot controller (the-as uint player-slot))))
        (when (and record
                   (nonzero? record)
                   (zero? (-> record identity joined?))
                   (!= (the-as uint player-slot) (-> controller local-player-slot))
                   (or (nonzero? (-> record runtime target-handle))
                       (nonzero? (-> record runtime vehicle-handle))
                       (< (the-as uint (-> record runtime pad-index)) (the uint MP_MAX_PLAYERS))))
          (callback record))))))

(defun mp-local-player-record ()
  (mp-player-controller-local-record *mp-player-controller*))

(defun mp-host-player-record ()
  (mp-player-controller-host-record *mp-player-controller*))

(defun mp-player-record-by-slot ((player-slot uint))
  (mp-player-controller-record *mp-player-controller* player-slot))

(defun mp-player-record-by-marker-key ((marker-key object))
  (let ((player-slot (- (the-as int marker-key) MP_REMOTE_PLAYER_MARKER_KEY_BASE)))
    (if (and (>= player-slot 0) (< player-slot MP_MAX_PLAYERS))
      (mp-player-record-by-slot (the-as uint player-slot))
      (the-as mp-player-record #f))))

(defun mp-local-player-slot ()
  (if (mp-player-slot-valid? (-> *mp-player-controller* local-player-slot))
    (the-as uint (-> *mp-player-controller* local-player-slot))
    MP_INVALID_PLAYER_SLOT))

(defun mp-host-player-slot ()
  (if (mp-player-slot-valid? (-> *mp-player-controller* host-player-slot))
    (the-as uint (-> *mp-player-controller* host-player-slot))
    MP_INVALID_PLAYER_SLOT))

(defun mp-player-record-target ((record mp-player-record))
  (if (and record (nonzero? record))
    (the-as target (handle->process-safe (-> record runtime target-handle)))
    (the-as target #f)))

(defun get-player-target-record ((record mp-player-record))
  (if (and record (nonzero? record)) (-> record runtime record) (the-as target-record #f)))

(defun player-update-target-record! ((record mp-player-record))
  (when (nonnull? record)
    (let ((target-record (get-player-target-record record)))
      (when (nonnull? target-record)
        (vector-copy! (-> target-record trans) (-> record runtime presentation-position))
        (quaternion-copy! (-> target-record quat) (-> record runtime presentation-quaternion))
        (vector-copy! (-> target-record velocity) (-> record transform velocity))
        (set! (-> target-record state-id) (-> record action target-state-id))
        (set! (-> target-record equipped-weapon) (-> record input equipped-weapon))
        (set! (-> target-record buttons) (-> record input buttons))
        (set! (-> target-record leftx) (-> record input leftx))
        (set! (-> target-record lefty) (-> record input lefty))
        (set! (-> target-record cam-angle-y) (-> record input camera-angle-y))
        (when (nonnull? *display*)
          (set! (-> target-record last-update) (-> *display* game-clock frame-counter)))
        (set! (-> target-record active?) #t))))
  (none))

(defun mp-player-record-presentation-position ((record mp-player-record))
  (if (and record (nonzero? record)) (-> record runtime presentation-position) (the-as vector #f)))

(defun mp-player-record-presentation-quaternion ((record mp-player-record))
  (if (and record (nonzero? record)) (-> record runtime presentation-quaternion) (the-as quaternion #f)))

(defun mp-player-target-by-slot ((player-slot uint))
  (mp-player-record-target (mp-player-record-by-slot player-slot)))

(define-perm *mp-player-name-scratch* string (new 'global 'string 64 (the-as string #f)))

(defun mp-player-name-equal? ((name-a (pointer uint8)) (name-b (pointer uint8)))
  (when (and name-a (nonzero? name-a) name-b (nonzero? name-b))
    (dotimes (i MP_PLAYER_NAME_SIZE)
      (let ((char-a (-> name-a i))
            (char-b (-> name-b i)))
        (when (!= char-a char-b)
          (return #f))
        (when (zero? char-a)
          (return #t))))
    (return #t))
  #f)

(defun mp-player-name-duplicate? ((player-slot uint))
  (let ((record (mp-player-record-by-slot player-slot)))
    (when (and record (nonzero? record) (nonzero? (-> record identity joined?)) (nonzero? (-> record identity name 0)))
      (let ((our-name (-> record identity name)))
        (dotimes (other-id MP_MAX_PLAYERS)
          (when (!= other-id player-slot)
            (let ((other-rec (mp-player-record-by-slot (the-as uint other-id))))
              (when (and other-rec
                         (nonzero? other-rec)
                         (nonzero? (-> other-rec identity joined?))
                         (nonzero? (-> other-rec identity name 0))
                         (mp-player-name-equal? our-name (-> other-rec identity name)))
                (return #t))))))))
  #f)

(defun mp-player-copy-name! ((dst string) (player-slot uint))
  (when (and dst (nonzero? dst))
    (clear dst)
    (let ((record (mp-player-record-by-slot player-slot)))
      (cond
        ((and record (nonzero? record) (nonzero? (-> record identity name 0)))
         (let ((src (-> record identity name))
               (dst-data (-> dst data))
               (copy-len 0))
           (while (and (< copy-len (- MP_PLAYER_NAME_SIZE 1)) (nonzero? (-> src copy-len)))
             (set! (-> dst-data copy-len) (-> src copy-len))
             (+! copy-len 1))
           (set! (-> dst-data copy-len) (the uint8 0)))
         (when (mp-player-name-duplicate? player-slot)
           (format dst " (~D)" (+ player-slot 1))))
        (else (format dst "PLAYER ~D" (+ player-slot 1))))))
  dst)

(defmacro mp-for-each-player-record (bindings &rest body)
  (let ((player-slot (first bindings))
        (record (second bindings)))
    `(dotimes (,player-slot MP_MAX_PLAYERS)
      (let ((,record (mp-player-record-by-slot (the-as uint ,player-slot)))) (when (and ,record (nonzero? ,record)) ,@body)))))

(defmacro mp-for-each-player-target (bindings &rest body)
  (let ((player-slot (first bindings))
        (record (second bindings))
        (player-target (third bindings)))
    `(mp-for-each-player-record (,player-slot ,record)
      (let ((,player-target (mp-player-record-target ,record))) (when (and ,player-target (nonzero? ,player-target)) ,@body)))))

(defun mp-player-driver-record-by-vehicle-id ((vehicle-id uint))
  (let ((owner (the-as mp-player-record #f)))
    (when (nonzero? vehicle-id)
      (mp-for-each-player-record (player-slot record)
        (when (and (nonnull? record) (zero? (-> record vehicle seat-index)))
          (when (= (-> record vehicle vehicle-id) vehicle-id)
            (return record))
          (when (= (-> record vehicle state net-id) vehicle-id)
            (set! owner record)))))
    owner))

(defun mp-player-record-by-vehicle-id ((vehicle-id uint))
  (when (nonzero? vehicle-id)
    (mp-for-each-player-record (player-slot record)
      (when (or (= (-> record vehicle vehicle-id) vehicle-id) (= (-> record vehicle state net-id) vehicle-id))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-player-runtime-flag? ((record mp-player-record) (flag mp-player-runtime-flags))
  (if (and record (nonzero? record) (logtest? (-> record runtime flags) flag)) #t #f))

(defun mp-player-runtime-set-flag! ((record mp-player-record) (flag mp-player-runtime-flags))
  (when (and record (nonzero? record))
    (logior! (-> record runtime flags) flag)))

(defun mp-player-runtime-clear-flag! ((record mp-player-record) (flag mp-player-runtime-flags))
  (when (and record (nonzero? record))
    (logclear! (-> record runtime flags) flag)))

(defun mp-player-mission-flag? ((record mp-player-record) (flag mp-player-mission-flags))
  (if (and record (nonzero? record) (logtest? (-> record runtime mission-flags) flag)) #t #f))

(defun mp-player-mission-set-flag! ((record mp-player-record) (flag mp-player-mission-flags))
  (when (and record (nonzero? record))
    (logior! (-> record runtime mission-flags) flag))
  (none))

(defun mp-player-mission-clear-flag! ((record mp-player-record) (flag mp-player-mission-flags))
  (when (and record (nonzero? record))
    (logclear! (-> record runtime mission-flags) flag))
  (none))

(defun mp-player-record-dead-or-dying? ((record mp-player-record))
  (and record
       (nonzero? record)
       (or (mp-player-runtime-flag? record (mp-player-runtime-flags dying))
           (mp-player-runtime-flag? record (mp-player-runtime-flags dead)))))

(defun mp-remote-gameplay-player-connected? ((record mp-player-record))
  (and record
       (nonzero? record)
       (is-record-remote-player? record)
       (>= (-> record connection activity) (mp-player-activity lobby))
       (= (-> record identity spectator-only?) 0)))

(defun mp-any-remote-gameplay-player-connected? ()
  (mp-for-each-player-record (player-slot record)
    (when (mp-remote-gameplay-player-connected? record)
      (return #t)))
  #f)

(defun mp-any-live-remote-player? ()
  (mp-for-each-player-record (player-slot record)
    (when (and (mp-remote-gameplay-player-connected? record) (not (mp-player-record-dead-or-dying? record)))
      (return #t)))
  #f)

(defun mp-all-remote-players-dead? ()
  (mp-for-each-player-record (player-slot record)
    (when (and (mp-remote-gameplay-player-connected? record)
               (not (mp-player-runtime-flag? record (mp-player-runtime-flags dead))))
      (return #f)))
  #t)

(defun mp-any-remote-player-connected? ()
  (mp-for-each-player-record (player-slot record)
    (when (and (is-record-remote-player? record) (>= (-> record connection activity) (mp-player-activity lobby)))
      (return #t)))
  #f)

(defun mp-any-remote-player-scene-active? ()
  (mp-for-each-player-record (player-slot record)
    (when (and (is-record-remote-player? record)
               (>= (-> record connection activity) (mp-player-activity lobby))
               (or (nonzero? (-> record action scene-state)) (nonzero? (-> record action scene-latched?))))
      (return #t)))
  #f)

(defun mp-player-record-position ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((player-target (mp-player-record-target record)))
      (when (and player-target (nonzero? player-target) (-> player-target root) (nonzero? (-> player-target root)))
        (return (-> player-target root trans))))
    (when (mp-player-runtime-flag? record (mp-player-runtime-flags interp-initialized))
      (return (-> record runtime presentation-position)))
    (return (-> record transform position)))
  (the-as vector #f))

(defun mp-nearest-remote-player-record-to-position ((origin-pos vector) (require-live-target? symbol))
  (let ((best-record (the-as mp-player-record #f))
        (best-distance (meters 1000000.0)))
    (when (or (not origin-pos) (zero? origin-pos))
      (return best-record))
    (mp-for-each-player-record (player-slot record)
      (when (and (is-record-remote-player? record)
                 (or (not require-live-target?)
                     (let ((player-target (mp-player-record-target record)))
                       (and (not (mp-player-record-dead-or-dying? record))
                            player-target
                            (nonzero? player-target)
                            (!= (-> player-target status) 'dead)))))
        (let ((record-pos (mp-player-record-position record)))
          (when (and record-pos (nonzero? record-pos))
            (let ((distance (vector-vector-distance origin-pos record-pos)))
              (when (or (not best-record)
                        (zero? best-record)
                        (< distance best-distance)
                        (and (= distance best-distance)
                             (< (-> record identity player-slot) (-> best-record identity player-slot))))
                (set! best-record record)
                (set! best-distance distance)))))))
    best-record))

(defun mp-nearest-remote-player-record ((origin target) (require-live-target? symbol))
  (if (and origin (nonzero? origin) (-> origin root) (nonzero? (-> origin root)))
    (mp-nearest-remote-player-record-to-position (-> origin root trans) require-live-target?)
    (the-as mp-player-record #f)))

(defun mp-nearest-player-character-record-to-position ((origin-pos vector)
                                                       (character mp-player-character)
                                                       (excluded-player-slot uint))
  (let ((best-record (the-as mp-player-record #f))
        (best-distance (meters 1000000.0)))
    (when (or (not origin-pos) (zero? origin-pos))
      (return best-record))
    (mp-for-each-player-record (player-slot record)
      (when (and (!= (-> record identity player-slot) excluded-player-slot)
                 (= (-> record identity character) character))
        (let ((record-pos (mp-player-record-position record)))
          (when (and record-pos (nonzero? record-pos))
            (let ((distance (vector-vector-distance origin-pos record-pos)))
              (when (or (not best-record)
                        (zero? best-record)
                        (< distance best-distance)
                        (and (= distance best-distance)
                             (< (-> record identity player-slot) (-> best-record identity player-slot))))
                (set! best-record record)
                (set! best-distance distance)))))))
    best-record))

(defun mp-nearest-player-character-record ((origin target) (character mp-player-character) (excluded-player-slot uint))
  (if (and origin (nonzero? origin) (-> origin root) (nonzero? (-> origin root)))
    (mp-nearest-player-character-record-to-position (-> origin root trans) character excluded-player-slot)
    (the-as mp-player-record #f)))

(defun mp-jak-record-for ((player-target target))
  (let ((excluded-player-slot (if (and player-target (nonzero? player-target)) (the-as uint (-> player-target player-slot)) MP_INVALID_PLAYER_SLOT)))
    (mp-nearest-player-character-record player-target (mp-player-character jak) excluded-player-slot)))

(defun mp-jak-target-for ((player-target target))
  (mp-player-record-target (mp-jak-record-for player-target)))

(defun mp-player-jak? ((record mp-player-record))
  (and record (nonzero? record) (= (-> record identity character) (mp-player-character jak))))

(defun mp-player-daxter? ((record mp-player-record))
  (and record (nonzero? record) (= (-> record identity character) (mp-player-character daxter))))

(defun mp-local-player-visual-secrets ()
  (let ((visual-secrets (the-as uint32 0)))
    (when (and *game-info* (nonzero? *game-info*))
      (let ((secrets (-> *game-info* secrets)))
        (when (logtest? (game-secrets big-head) secrets)
          (logior! visual-secrets (mp-player-visual-secrets big-head)))
        (when (logtest? (game-secrets little-head) secrets)
          (logior! visual-secrets (mp-player-visual-secrets little-head)))))
    (when (and *setting-control* (nonzero? *setting-control*) (-> *setting-control* user-current beard))
      (logior! visual-secrets (mp-player-visual-secrets goatee-visible)))
    (the-as mp-player-visual-secrets visual-secrets)))

(defun mp-target-visual-secrets ((player-target process-focusable))
  (let ((record (if (and player-target (nonzero? player-target) (type? player-target target))
                  (mp-player-controller-target-record *mp-player-controller* (the-as target player-target))
                  (the-as mp-player-record #f))))
    (if (and record (nonzero? record))
      (if (= (-> record identity player-slot) (mp-local-player-slot))
        (mp-local-player-visual-secrets)
        (the-as mp-player-visual-secrets (-> record action visual-secrets)))
      (if (mp-session-in-game?) (the-as mp-player-visual-secrets 0) (mp-local-player-visual-secrets)))))

(defun mp-target-jak? ((player-target process-focusable))
  (let ((record (if (and player-target (nonzero? player-target) (type? player-target target))
                  (mp-player-controller-target-record *mp-player-controller* (the-as target player-target))
                  (the-as mp-player-record #f))))
    (if (and record (nonzero? record)) (mp-player-jak? record) #t)))

(defun mp-target-daxter? ((player-target process-focusable))
  (let ((record (if (and player-target (nonzero? player-target) (type? player-target target))
                  (mp-player-controller-target-record *mp-player-controller* (the-as target player-target))
                  (the-as mp-player-record #f))))
    (and record (nonzero? record) (mp-player-daxter? record))))

(defun mp-local-player-jak? ()
  (mp-player-jak? (mp-local-player-record)))

(defun mp-local-player-daxter? ()
  (mp-player-daxter? (mp-local-player-record)))

(defun mp-session-host? ()
  (let ((local-player-slot (mp-local-player-slot))
        (host-player-slot (mp-host-player-slot)))
    (and (mp-player-slot-valid? local-player-slot)
         (mp-player-slot-valid? host-player-slot)
         (= local-player-slot host-player-slot))))

(defun mp-session-client? ()
  (let ((local-player-slot (mp-local-player-slot))
        (host-player-slot (mp-host-player-slot)))
    (and (mp-player-slot-valid? local-player-slot)
         (mp-player-slot-valid? host-player-slot)
         (!= local-player-slot host-player-slot))))

(defun mp-generate-battle-enemy-aid ()
  (+! *mp-battle-spawn-counter* 1)
  (when (>= *mp-battle-spawn-counter* MP_BATTLE_SPAWN_COUNTER_LIMIT)
    (set! *mp-battle-spawn-counter* (the uint 1)))
  (let ((local-record (mp-local-player-record)))
    (when (or (not local-record) (zero? local-record))
      (return (the uint 0)))
    (let ((player-slot (-> local-record identity player-slot)))
      (when (>= player-slot (the uint MP_MAX_PLAYERS))
        (return (the uint 0)))
      (let ((player-bits (ash player-slot MP_BATTLE_SPAWN_COUNTER_BITS)))
        (the-as uint (logior #x60000000 player-bits *mp-battle-spawn-counter*))))))

(mp-player-controller-reset! *mp-player-controller*)
