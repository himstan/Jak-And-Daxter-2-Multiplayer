;;-*-Lisp-*-
(in-package goal)

(defun mp-player-id-valid? ((player-id uint))
  (< player-id (the uint MP_MAX_PLAYERS)))

(defun mp-player-controller-slot ((controller mp-player-controller) (player-id uint))
  (if (and controller
           (nonzero? controller)
           (mp-player-id-valid? player-id))
      (-> controller records player-id)
      (the-as mp-player-record #f)))

(defun mp-player-pad-reset! ((pad-index uint))
  (when (and (> pad-index (the uint 0))
             (< pad-index (the uint MP_MAX_PLAYERS))
             *cpad-list*
             (nonzero? *cpad-list*)
             *cpad-history-list*
             (nonzero? *cpad-history-list*))
    (let ((pad (-> *cpad-list* cpads pad-index))
          (history (-> *cpad-history-list* cpads pad-index)))
      (when (and pad (nonzero? pad))
        (cpad-invalid! pad)
        (set! (-> pad number) (the-as int pad-index)))
      (when (and history (nonzero? history))
        (dotimes (history-index 15)
          (set! (-> history button0-abs history-index) (pad-buttons))
          (set! (-> history button0-rel history-index) (pad-buttons)))))))

(defun mp-player-controller-pad-in-use?
       ((controller mp-player-controller) (pad-index uint) (excluded-player-id uint))
  (let ((in-use? #f))
    (when (and controller (nonzero? controller))
      (dotimes (player-id MP_MAX_PLAYERS)
        (let ((record (mp-player-controller-slot controller (the-as uint player-id))))
          (when (and record
                     (nonzero? record)
                     (!= (-> record identity player-id) excluded-player-id)
                     (= (the-as uint (-> record runtime pad-index)) pad-index))
            (set! in-use? #t)))))
    in-use?))

(defun mp-player-controller-lease-pad!
       ((controller mp-player-controller) (record mp-player-record))
  (when (and controller (nonzero? controller) record (nonzero? record))
    (let ((player-id (the-as uint (-> record identity player-id)))
          (current-pad (the-as uint (-> record runtime pad-index))))
      (when (= player-id (-> controller local-player-id))
        (set! (-> record runtime pad-index) (the uint8 0))
        (return (the uint 0)))
      (when (and (> current-pad (the uint 0))
                 (< current-pad (the uint MP_MAX_PLAYERS)))
        (return current-pad))
      (dotimes (pad-offset (- MP_MAX_PLAYERS 1))
        (let ((candidate-pad (the-as uint (+ pad-offset 1))))
          (when (not (mp-player-controller-pad-in-use?
                       controller candidate-pad player-id))
            (mp-player-pad-reset! candidate-pad)
            (set! (-> record runtime pad-index) (the-as uint8 candidate-pad))
            (return candidate-pad))))))
  (the-as uint MP_INVALID_PAD_INDEX))

(defun mp-player-controller-release-pad!
       ((controller mp-player-controller) (record mp-player-record))
  (when (and controller (nonzero? controller) record (nonzero? record))
    (let ((pad-index (the-as uint (-> record runtime pad-index))))
      (when (and (> pad-index (the uint 0))
                 (< pad-index (the uint MP_MAX_PLAYERS)))
        (mp-player-pad-reset! pad-index))
      (set! (-> record runtime pad-index) MP_INVALID_PAD_INDEX))))

(defun mp-player-record-reset! ((record mp-player-record))
  "Clear record data after its owned presentation resources have been released."
  (when (and record (nonzero? record))
    (let ((old-target (the-as target (handle->process-safe (-> record runtime target-handle)))))
      (when (and old-target (nonzero? old-target))
        (set! (-> old-target player-id) MP_INVALID_PLAYER_ID)))
    (mem-set32!
      (the-as pointer record)
      (/ (size-of mp-player-record) 4)
      0)
    (set! (-> record identity player-id) MP_INVALID_PLAYER_ID)
    (set! (-> record identity character) (mp-player-character unknown))
    (set! (-> record action riding-along-player-id) MP_INVALID_PLAYER_ID)
    (set! (-> record runtime pad-index) MP_INVALID_PAD_INDEX)
    (set! (-> record runtime last-gun-log-active) -1)
    (set! (-> record runtime last-gun-log-requested) -1)))

(defun mp-broadcast-process-tree ((tree process-tree) (msg symbol) (param0 uint) (param1 uint))
  "Recursively traverse the process tree and dispatch an event to all live processes."
  (when (and tree (nonzero? tree))
    (when (and (not (logtest? (-> tree mask) (process-mask process-tree)))
               (valid? tree process (the-as string #f) #f 0)
               (nonzero? (-> (the-as process tree) pid))
               (!= (-> (the-as process tree) status) 'dead))
      (send-event (the-as process tree) msg param0 param1))
    (let ((child-node (-> tree child)))
      (while (and child-node (nonzero? child-node))
        (let ((next-brother (-> child-node 0 brother)))
          (mp-broadcast-process-tree (-> child-node 0) msg param0 param1)
          (set! child-node next-brother)))))
  (none))

(defun mp-broadcast-event-to-active-processes ((msg symbol) (param0 uint) (param1 uint))
  "Dispatch an event message to every active process in *active-pool*."
  (when (and *active-pool* (nonzero? *active-pool*))
    (mp-broadcast-process-tree *active-pool* msg param0 param1))
  (none))

(defun mp-broadcast-player-join! ((record mp-player-record))
  "Notify all active processes that a remote player joined the session."
  (when (and record
             (nonzero? record)
             (nonzero? (-> record identity joined?))
             (mp-player-record-remote? *mp-player-controller* record))
    (let ((player-id (-> record identity player-id)))
      (mp-broadcast-event-to-active-processes
        'player-joined
        (the-as uint record)
        (the-as uint player-id))))
  (none))

(defun mp-broadcast-player-leave! ((record mp-player-record))
  "Notify all active processes that a remote player left the session."
  (when (and record
             (nonzero? record)
             (mp-player-record-remote? *mp-player-controller* record))
    (let ((player-id (-> record identity player-id)))
      (mp-broadcast-event-to-active-processes
        'player-left
        (the-as uint record)
        (the-as uint player-id))))
  (none))

(defun mp-player-controller-release-slot!
       ((controller mp-player-controller) (player-id uint))
  "Release presentation ownership before clearing one controller slot."
  (when (and controller
             (nonzero? controller)
             (mp-player-id-valid? player-id))
    (let ((record (mp-player-controller-slot controller player-id)))
      (when (and record (nonzero? record))
        (when (mp-player-runtime-flag? record (mp-player-runtime-flags join-announced))
          (mp-broadcast-player-leave! record)
          (mp-player-runtime-clear-flag! record (mp-player-runtime-flags join-announced)))
        (when (and (!= player-id (-> controller local-player-id))
                   (nonzero? (-> record runtime target-handle)))
          (mp-puppet-deactivate! record))
        (set! (-> record runtime vehicle-handle) (the-as handle #f))
        (mp-player-controller-release-pad! controller record)
        (mp-player-record-reset! record))))
  (none))

(defun mp-player-controller-reset! ((controller mp-player-controller))
  (when (and controller (nonzero? controller))
    (dotimes (player-id MP_MAX_PLAYERS)
      (mp-player-controller-release-slot! controller (the-as uint player-id)))
    (set! (-> controller local-player-id) MP_INVALID_PLAYER_ID)
    (set! (-> controller host-player-id) MP_INVALID_PLAYER_ID)
    (set! (-> controller reserved 0) (the uint 0))
    (set! (-> controller reserved 1) (the uint 0))))

(defun mp-player-controller-register!
       ((controller mp-player-controller) (player-id uint) (character mp-player-character))
  (let ((record (mp-player-controller-slot controller player-id)))
    (when (and record (nonzero? record))
      (mp-player-controller-release-slot! controller player-id)
      (set! (-> record identity player-id) (the-as uint32 player-id))
      (set! (-> record identity character) character)
      (set! (-> record identity identity-ready?) (the uint8 1))
      (set! (-> record identity joined?) (the uint8 1))
      (set! (-> record connection connected?) (the uint8 1))
      (mp-player-runtime-set-flag! record (mp-player-runtime-flags join-announced))
      (mp-broadcast-player-join! record))
    record))

(defun mp-player-controller-unregister!
       ((controller mp-player-controller) (player-id uint))
  (let ((record (mp-player-controller-slot controller player-id)))
    (when (and record (nonzero? record))
      (mp-player-controller-release-slot! controller player-id))
    (when (and controller (nonzero? controller))
      (when (= (-> controller local-player-id) player-id)
        (set! (-> controller local-player-id) MP_INVALID_PLAYER_ID))
      (when (= (-> controller host-player-id) player-id)
        (set! (-> controller host-player-id) MP_INVALID_PLAYER_ID))
      )))

(defun mp-player-controller-record
       ((controller mp-player-controller) (player-id uint))
  (let ((record (mp-player-controller-slot controller player-id)))
    (if (and record
             (nonzero? record)
             (nonzero? (-> record identity joined?)))
        record
        (the-as mp-player-record #f))))

(defun mp-player-controller-record-id
       ((controller mp-player-controller) (record mp-player-record))
  "Resolve a record's array slot even while its vacant identity uses the invalid sentinel."
  (when (and controller (nonzero? controller) record (nonzero? record))
    (dotimes (player-id MP_MAX_PLAYERS)
      (when (= record (mp-player-controller-slot controller (the-as uint player-id)))
        (return (the-as uint player-id)))))
  MP_INVALID_PLAYER_ID)

(defun mp-player-controller-local-record ((controller mp-player-controller))
  (if (and controller (nonzero? controller))
      (mp-player-controller-record controller (-> controller local-player-id))
      (the-as mp-player-record #f)))

(defun mp-player-controller-host-record ((controller mp-player-controller))
  (if (and controller (nonzero? controller))
      (mp-player-controller-record controller (-> controller host-player-id))
      (the-as mp-player-record #f)))

(defun mp-player-controller-target-record
       ((controller mp-player-controller) (player-target target))
  (if (and player-target (nonzero? player-target))
      (mp-player-controller-record controller (-> player-target player-id))
      (the-as mp-player-record #f)))

(defun mp-player-process-record ((player-process process))
  (if (and player-process
           (nonzero? player-process)
           (type? player-process target))
      (mp-player-controller-target-record
        *mp-player-controller*
        (the-as target player-process))
      (the-as mp-player-record #f)))

(defun mp-player-id-from-process ((player-process process))
  (let ((record (mp-player-process-record player-process)))
    (if (and record (nonzero? record))
        (the-as uint (-> record identity player-id))
        MP_INVALID_PLAYER_ID)))

(defun mp-player-controller-target-pad-index
       ((controller mp-player-controller) (player-id uint) (leased-pad-index uint))
  "Use the neutral sink when a menu owns the local physical pad."
  (if (and controller
           (nonzero? controller)
           (= player-id (-> controller local-player-id))
           (or (= *master-mode* 'menu)
               (= *master-mode* 'progress)
               (= *master-mode* 'pause)
               (= *master-mode* 'freeze)))
      (the uint CPAD_TARGET_INPUT_SINK_INDEX)
      leased-pad-index))

(defun mp-player-controller-bind-target!
       ((controller mp-player-controller) (player-id uint) (player-target target))
  (when (and controller
             (nonzero? controller)
             player-target
             (nonzero? player-target))
    (let ((record (mp-player-controller-record controller player-id)))
      (when (and record (nonzero? record))
        (let* ((bound-target
                 (the-as target
                   (handle->process-safe (-> record runtime target-handle))))
               (control (-> player-target control))
               (target-already-bound?
                 (and bound-target
                      (nonzero? bound-target)
                      (= bound-target player-target))))
          (set! (-> player-target player-id) (the-as uint32 player-id))
          (mp-apply-player-render-tint! player-target)
          (set! (-> record runtime target-handle) (process->handle player-target))
          (let* ((leased-pad-index
                   (mp-player-controller-lease-pad! controller record))
                 (target-pad-index
                   (mp-player-controller-target-pad-index
                     controller player-id leased-pad-index)))
            (when (and (<= target-pad-index
                            (the uint CPAD_TARGET_INPUT_SINK_INDEX))
                       control
                       (nonzero? control)
                       *cpad-list*
                       (nonzero? *cpad-list*)
                       (or (not target-already-bound?)
                           (not (and (-> control cpad)
                                     (nonzero? (-> control cpad))))))
              (set! (-> control cpad)
                    (-> *cpad-list* cpads target-pad-index)))))))))

(defun mp-player-controller-reassign-local!
       ((controller mp-player-controller) (new-player-id uint))
  "Move the local record to a newly assigned reusable session slot."
  (when (and controller
             (nonzero? controller)
             (mp-player-id-valid? new-player-id))
    (let ((old-player-id (the-as uint (-> controller local-player-id))))
      (when (and (mp-player-id-valid? old-player-id)
                 (!= old-player-id new-player-id))
        (let ((old-record (mp-player-controller-record controller old-player-id))
              (new-record (mp-player-controller-slot controller new-player-id)))
          (when (and old-record
                     (nonzero? old-record)
                     new-record
                     (nonzero? new-record))
            (let ((local-target
                    (the-as target
                      (handle->process-safe (-> old-record runtime target-handle)))))
              (mp-player-controller-release-slot! controller new-player-id)
              (mem-copy!
                (the-as pointer new-record)
                (the-as pointer old-record)
                (size-of mp-player-record))
              (mp-player-record-reset! old-record)
              (set! (-> new-record identity player-id) (the-as uint32 new-player-id))
              (set! (-> new-record runtime pad-index) (the uint8 0))
              (set! (-> controller local-player-id) (the-as uint32 new-player-id))
              (when (and local-target (nonzero? local-target))
                (set! (-> local-target player-id) (the-as uint32 new-player-id))
                (set! (-> new-record runtime target-handle)
                      (process->handle local-target))
                (mp-player-controller-bind-target!
                  controller new-player-id local-target))))))))
  (mp-player-controller-local-record controller))

(defun mp-player-controller-unbind-target!
       ((controller mp-player-controller) (player-id uint))
  (let ((record (mp-player-controller-record controller player-id)))
    (when (and record (nonzero? record))
      (let ((player-target
              (the-as target (handle->process-safe (-> record runtime target-handle)))))
        (when (and player-target (nonzero? player-target))
          (set! (-> player-target player-id) MP_INVALID_PLAYER_ID)))
      (set! (-> record runtime target-handle) (the-as handle #f)))))

(defun mp-player-controller-unbind-record-target!
       ((controller mp-player-controller) (record mp-player-record))
  "Clear a target binding even after networking has marked its slot vacant."
  (when (and controller (nonzero? controller) record (nonzero? record))
    (let ((player-target
            (the-as target (handle->process-safe (-> record runtime target-handle)))))
      (when (and player-target (nonzero? player-target))
        (set! (-> player-target player-id) MP_INVALID_PLAYER_ID)))
    (set! (-> record runtime target-handle) (the-as handle #f))))

(defun mp-player-controller-for-each-active!
       ((controller mp-player-controller) (callback (function mp-player-record none)))
  (when (and controller (nonzero? controller) callback (nonzero? callback))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-controller-record controller (the-as uint player-id))))
        (when (and record (nonzero? record))
          (callback record))))))

(defun mp-player-record-remote? ((controller mp-player-controller) (record mp-player-record))
  (if (and controller
           (nonzero? controller)
           record
           (nonzero? record)
           (!= (-> record identity player-id) (-> controller local-player-id)))
      #t
      #f))

(defun mp-player-controller-for-each-remote!
       ((controller mp-player-controller) (callback (function mp-player-record none)))
  (when (and controller (nonzero? controller) callback (nonzero? callback))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-controller-record controller (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (mp-player-record-remote? controller record))
          (callback record))))))

(defun mp-player-controller-for-each-stale-remote!
       ((controller mp-player-controller) (callback (function mp-player-record none)))
  "Visit vacant slots that still own GOAL presentation resources."
  (when (and controller (nonzero? controller) callback (nonzero? callback))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (mp-player-controller-slot controller (the-as uint player-id))))
        (when (and record
                   (nonzero? record)
                   (zero? (-> record identity joined?))
                   (!= (the-as uint player-id) (-> controller local-player-id))
                   (or (nonzero? (-> record runtime target-handle))
                       (nonzero? (-> record runtime vehicle-handle))
                       (< (the-as uint (-> record runtime pad-index))
                          (the uint MP_MAX_PLAYERS))))
          (callback record))))))

(defun mp-local-player-record ()
  (mp-player-controller-local-record *mp-player-controller*))

(defun mp-host-player-record ()
  (mp-player-controller-host-record *mp-player-controller*))

(defun mp-player-record-by-id ((player-id uint))
  (mp-player-controller-record *mp-player-controller* player-id))

(defun mp-player-record-by-marker-key ((marker-key object))
  "Resolve a per-player minimap key without depending on the marker's process handle."
  (let ((player-id
          (- (the-as int marker-key) MP_REMOTE_PLAYER_MARKER_KEY_BASE)))
    (if (and (>= player-id 0) (< player-id MP_MAX_PLAYERS))
        (mp-player-record-by-id (the-as uint player-id))
        (the-as mp-player-record #f))))

(defun mp-local-player-id ()
  (if (mp-player-id-valid? (-> *mp-player-controller* local-player-id))
      (the-as uint (-> *mp-player-controller* local-player-id))
      MP_INVALID_PLAYER_ID))

(defun mp-host-player-id ()
  (if (mp-player-id-valid? (-> *mp-player-controller* host-player-id))
      (the-as uint (-> *mp-player-controller* host-player-id))
      MP_INVALID_PLAYER_ID))

(defun mp-player-record-target ((record mp-player-record))
  (if (and record (nonzero? record))
      (the-as target (handle->process-safe (-> record runtime target-handle)))
      (the-as target #f)))

(defun mp-player-record-ghost ((record mp-player-record))
  (if (and record (nonzero? record))
      (-> record runtime ghost)
      (the-as mp-target-ghost-record #f)))

(defun mp-player-record-presentation-position ((record mp-player-record))
  (if (and record (nonzero? record))
      (-> record runtime presentation-position)
      (the-as vector #f)))

(defun mp-player-record-presentation-quaternion ((record mp-player-record))
  (if (and record (nonzero? record))
      (-> record runtime presentation-quaternion)
      (the-as quaternion #f)))

(defun mp-player-target-by-id ((player-id uint))
  (mp-player-record-target (mp-player-record-by-id player-id)))

(define-perm *mp-player-name-scratch* string (new 'global 'string 64 (the-as string #f)))

(defun mp-player-name-equal? ((name-a (pointer uint8)) (name-b (pointer uint8)))
  "Check if two 24-byte player name buffers are equal."
  (when (and name-a (nonzero? name-a) name-b (nonzero? name-b))
    (dotimes (i 24)
      (let ((char-a (-> name-a i))
            (char-b (-> name-b i)))
        (when (!= char-a char-b)
          (return #f))
        (when (zero? char-a)
          (return #t))))
    (return #t))
  #f)

(defun mp-player-name-duplicate? ((player-id uint))
  "Check if another joined player shares the same non-empty name."
  (let ((record (mp-player-record-by-id player-id)))
    (when (and record
               (nonzero? record)
               (nonzero? (-> record identity joined?))
               (nonzero? (-> record identity name 0)))
      (let ((our-name (-> record identity name)))
        (dotimes (other-id MP_MAX_PLAYERS)
          (when (!= other-id player-id)
            (let ((other-rec (mp-player-record-by-id (the-as uint other-id))))
              (when (and other-rec
                         (nonzero? other-rec)
                         (nonzero? (-> other-rec identity joined?))
                         (nonzero? (-> other-rec identity name 0))
                         (mp-player-name-equal? our-name (-> other-rec identity name)))
                (return #t))))))))
  #f)

(defun mp-player-copy-name! ((dst string) (player-id uint))
  "Populate dst with player name. If empty, falls back to 'PLAYER <id+1>'.
   If the name collides with another active player, appends ' (<id+1>)'."
  (when (and dst (nonzero? dst))
    (clear dst)
    (let ((record (mp-player-record-by-id player-id)))
      (cond
        ((and record
              (nonzero? record)
              (nonzero? (-> record identity name 0)))
         (let ((src (-> record identity name))
               (dst-data (-> dst data))
               (copy-len 0))
           (while (and (< copy-len 23)
                       (nonzero? (-> src copy-len)))
             (set! (-> dst-data copy-len) (-> src copy-len))
             (+! copy-len 1))
           (set! (-> dst-data copy-len) (the uint8 0)))
         (when (mp-player-name-duplicate? player-id)
           (format dst " (~D)" (+ player-id 1))))
        (else
         (format dst "PLAYER ~D" (+ player-id 1))))))
  dst)

(defmacro mp-for-each-player-record (bindings &rest body)
  "Execute body for every active player record.
   Bindings are (player-id record)."
  (let ((player-id (first bindings))
        (record (second bindings)))
    `(dotimes (,player-id MP_MAX_PLAYERS)
       (let ((,record (mp-player-record-by-id (the-as uint ,player-id))))
         (when (and ,record (nonzero? ,record))
           ,@body)))))

(defmacro mp-for-each-player-target (bindings &rest body)
  "Execute body for every active player record with a bound target.
   Bindings are (player-id record player-target)."
  (let ((player-id (first bindings))
        (record (second bindings))
        (player-target (third bindings)))
    `(mp-for-each-player-record (,player-id ,record)
       (let ((,player-target (mp-player-record-target ,record)))
         (when (and ,player-target (nonzero? ,player-target))
           ,@body)))))

(defun mp-player-driver-record-by-vehicle-id ((vehicle-id uint))
  "Resolve explicit vehicle driver authority to the lowest player ID."
  (when (nonzero? vehicle-id)
    (mp-for-each-player-record (player-id record)
      (when (= (-> record vehicle state net-id) vehicle-id)
        (return record))))
  (the-as mp-player-record #f))

(defun mp-player-record-by-vehicle-id ((vehicle-id uint))
  "Resolve canonical vehicle ownership or occupancy to the lowest player ID."
  (when (nonzero? vehicle-id)
    (mp-for-each-player-record (player-id record)
      (when (or (= (-> record vehicle vehicle-id) vehicle-id)
                (= (-> record vehicle state net-id) vehicle-id))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-remote-player-record-by-vehicle-id ((vehicle-id uint))
  "Resolve a vehicle to a non-local owner or occupant record."
  (when (nonzero? vehicle-id)
    (mp-for-each-player-record (player-id record)
      (when (and (mp-player-record-remote? *mp-player-controller* record)
                 (or (= (-> record vehicle vehicle-id) vehicle-id)
                     (= (-> record vehicle state net-id) vehicle-id)))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-player-runtime-flag? ((record mp-player-record) (flag mp-player-runtime-flags))
  (if (and record
           (nonzero? record)
           (logtest? (-> record runtime flags) flag))
      #t
      #f))

(defun mp-player-runtime-set-flag! ((record mp-player-record) (flag mp-player-runtime-flags))
  (when (and record (nonzero? record))
    (logior! (-> record runtime flags) flag)))

(defun mp-player-runtime-clear-flag! ((record mp-player-record) (flag mp-player-runtime-flags))
  (when (and record (nonzero? record))
    (logclear! (-> record runtime flags) flag)))

(defun mp-player-mission-flag? ((record mp-player-record) (flag mp-player-mission-flags))
  (if (and record
           (nonzero? record)
           (logtest? (-> record runtime mission-flags) flag))
      #t
      #f))

(defun mp-player-mission-set-flag! ((record mp-player-record) (flag mp-player-mission-flags))
  (when (and record (nonzero? record))
    (logior! (-> record runtime mission-flags) flag))
  (none)
  )

(defun mp-player-mission-clear-flag! ((record mp-player-record) (flag mp-player-mission-flags))
  (when (and record (nonzero? record))
    (logclear! (-> record runtime mission-flags) flag))
  (none)
  )

(defun mp-player-record-dead-or-dying? ((record mp-player-record))
  (and record
       (nonzero? record)
       (or (mp-player-runtime-flag? record (mp-player-runtime-flags dying))
           (mp-player-runtime-flag? record (mp-player-runtime-flags dead)))))

(defun mp-any-live-remote-player? ()
  (mp-for-each-player-record (player-id record)
    (when (and (mp-player-record-remote? *mp-player-controller* record)
               (>= (-> record connection status) 4)
               (= (-> record identity spectator-only?) 0)
               (not (mp-player-record-dead-or-dying? record)))
      (return #t)))
  #f)

(defun mp-all-remote-players-dead? ()
  (let ((found-remote? #f))
    (mp-for-each-player-record (player-id record)
      (when (and (mp-player-record-remote? *mp-player-controller* record)
                 (>= (-> record connection status) 4)
                 (= (-> record identity spectator-only?) 0))
        (set! found-remote? #t)
        (when (not (mp-player-runtime-flag? record (mp-player-runtime-flags dead)))
          (return #f))))
    found-remote?))

(defun mp-any-remote-player-connected? ()
  (mp-for-each-player-record (player-id record)
    (when (and (mp-player-record-remote? *mp-player-controller* record)
               (>= (-> record connection status) 4))
      (return #t)))
  #f)

(defun mp-any-remote-player-scene-active? ()
  (mp-for-each-player-record (player-id record)
    (when (and (mp-player-record-remote? *mp-player-controller* record)
               (>= (-> record connection status) 4)
               (or (nonzero? (-> record action scene-state))
                   (nonzero? (-> record action scene-latched?))))
      (return #t)))
  #f)

(defun mp-local-player-respawning? ()
  (mp-player-runtime-flag?
    (mp-local-player-record) (mp-player-runtime-flags respawning)))

(defun mp-set-local-player-respawning! ((respawning? symbol))
  (let ((record (mp-local-player-record)))
    (when (and record (nonzero? record))
      (if respawning?
          (mp-player-runtime-set-flag! record (mp-player-runtime-flags respawning))
          (mp-player-runtime-clear-flag! record (mp-player-runtime-flags respawning)))))
  (none))

(defun mp-player-record-position ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((player-target (mp-player-record-target record)))
      (when (and player-target
                 (nonzero? player-target)
                 (-> player-target root)
                 (nonzero? (-> player-target root)))
        (return (-> player-target root trans))))
    (when (mp-player-runtime-flag? record (mp-player-runtime-flags interp-initialized))
      (return (-> record runtime presentation-position)))
    (return (-> record transform position)))
  (the-as vector #f))

(defun mp-nearest-remote-player-record-to-position
       ((origin-pos vector) (require-live-target? symbol))
  "Return the nearest non-local record to an explicit world position."
  (let ((best-record (the-as mp-player-record #f))
        (best-distance (meters 1000000.0)))
    (when (or (not origin-pos) (zero? origin-pos))
      (return best-record))
    (mp-for-each-player-record (player-id record)
      (when (and (mp-player-record-remote? *mp-player-controller* record)
                   (or (not require-live-target?)
                       (let ((player-target (mp-player-record-target record)))
                         (and (not (mp-player-record-dead-or-dying? record))
                              player-target
                              (nonzero? player-target)
                              (!= (-> player-target status) 'dead)))))
          (let ((record-pos (mp-player-record-position record)))
            (when (and record-pos (nonzero? record-pos))
              (let ((distance (vector-vector-distance origin-pos record-pos)))
                (when (or (not best-record)
                          (zero? best-record)
                          (< distance best-distance)
                          (and (= distance best-distance)
                               (< (-> record identity player-id)
                                  (-> best-record identity player-id))))
                  (set! best-record record)
                  (set! best-distance distance)))))))
    best-record))

(defun mp-nearest-remote-player-record
       ((origin target) (require-live-target? symbol))
  "Return the nearest non-local record to an explicit target context."
  (if (and origin
           (nonzero? origin)
           (-> origin root)
           (nonzero? (-> origin root)))
      (mp-nearest-remote-player-record-to-position
        (-> origin root trans) require-live-target?)
      (the-as mp-player-record #f)))

(defun mp-nearest-remote-player-target ((origin target))
  (mp-player-record-target (mp-nearest-remote-player-record origin #t)))

(defun mp-nearest-player-character-record-to-position
       ((origin-pos vector)
        (character mp-player-character)
        (excluded-player-id uint))
  "Return the nearest active matching character to a position; ties use player ID."
  (let ((best-record (the-as mp-player-record #f))
        (best-distance (meters 1000000.0)))
    (when (or (not origin-pos) (zero? origin-pos))
      (return best-record))
    (mp-for-each-player-record (player-id record)
      (when (and (!= (-> record identity player-id) excluded-player-id)
                   (= (-> record identity character) character))
          (let ((record-pos (mp-player-record-position record)))
            (when (and record-pos (nonzero? record-pos))
              (let ((distance (vector-vector-distance origin-pos record-pos)))
                (when (or (not best-record)
                          (zero? best-record)
                          (< distance best-distance)
                          (and (= distance best-distance)
                               (< (-> record identity player-id)
                                  (-> best-record identity player-id))))
                  (set! best-record record)
                  (set! best-distance distance)))))))
    best-record))

(defun mp-nearest-player-character-record
       ((origin target) (character mp-player-character) (excluded-player-id uint))
  "Return the nearest active matching character to a target context."
  (if (and origin
           (nonzero? origin)
           (-> origin root)
           (nonzero? (-> origin root)))
      (mp-nearest-player-character-record-to-position
        (-> origin root trans) character excluded-player-id)
      (the-as mp-player-record #f)))

(defun mp-jak-record-for ((player-target target))
  (let ((excluded-player-id
          (if (and player-target (nonzero? player-target))
              (the-as uint (-> player-target player-id))
              MP_INVALID_PLAYER_ID)))
    (mp-nearest-player-character-record
      player-target
      (mp-player-character jak)
      excluded-player-id)))

(defun mp-jak-target-for ((player-target target))
  "Find an active Jak target other than player-target."
  (mp-player-record-target (mp-jak-record-for player-target)))

(defun mp-player-jak? ((record mp-player-record))
  (and record
       (nonzero? record)
       (= (-> record identity character) (mp-player-character jak))))

(defun mp-player-daxter? ((record mp-player-record))
  (and record
       (nonzero? record)
       (= (-> record identity character) (mp-player-character daxter))))

(defun mp-target-jak? ((player-target process-focusable))
  (let ((record
          (if (and player-target (nonzero? player-target) (type? player-target target))
              (mp-player-controller-target-record
                *mp-player-controller*
                (the-as target player-target))
              (the-as mp-player-record #f))))
    (if (and record (nonzero? record))
        (mp-player-jak? record)
        #t)))

(defun mp-target-daxter? ((player-target process-focusable))
  (let ((record
          (if (and player-target (nonzero? player-target) (type? player-target target))
              (mp-player-controller-target-record
                *mp-player-controller*
                (the-as target player-target))
              (the-as mp-player-record #f))))
    (and record (nonzero? record) (mp-player-daxter? record))))

(defun mp-local-player-jak? ()
  (mp-player-jak? (mp-local-player-record)))

(defun mp-local-player-daxter? ()
  (mp-player-daxter? (mp-local-player-record)))

(defun mp-session-host? ()
  (= *mp-session-role* (mp-session-role host)))

(defun mp-session-client? ()
  (= *mp-session-role* (mp-session-role client)))

(defun mp-generate-battle-enemy-aid ()
  (+! *mp-battle-spawn-counter* 1)
  (when (>= *mp-battle-spawn-counter* MP_BATTLE_SPAWN_COUNTER_LIMIT)
    (set! *mp-battle-spawn-counter* (the uint 1)))
  (let ((local-record (mp-local-player-record)))
    (when (or (not local-record) (zero? local-record))
      (return (the uint 0)))
    (let ((player-id (-> local-record identity player-id)))
      (when (>= player-id (the uint MP_MAX_PLAYERS))
        (return (the uint 0)))
      (let ((player-bits (ash player-id MP_BATTLE_SPAWN_COUNTER_BITS)))
      (the-as uint
          (logior #x60000000 player-bits *mp-battle-spawn-counter*))))))

(defun mp-player-marker-color-by-id ((player-id int) (fallback-color rgba))
  "Resolve a player marker RGBA color from its zero-based player slot."
  (cond
    ((= player-id 0) (static-rgba 0 229 255 128))
    ((= player-id 1) (static-rgba 255 140 0 128))
    ((= player-id 2) (static-rgba 118 255 3 128))
    ((= player-id 3) (static-rgba 255 46 209 128))
    ((= player-id 4) (static-rgba 54 92 255 128))
    ((= player-id 5) (static-rgba 255 230 0 128))
    ((= player-id 6) (static-rgba 155 77 255 128))
    ((= player-id 7) (static-rgba 255 92 138 128))
    (else fallback-color)))

(defun mp-player-font-color-by-id ((player-id int))
  "Resolve the font color corresponding to the player's marker color."
  (case player-id
    ((0) (font-color cyan))
    ((1) (font-color orange))
    ((2) (font-color green))
    ((3) (font-color pink))
    ((4) (font-color blue))
    ((5) (font-color yellow))
    ((6) (font-color pink))
    ((7) (font-color red))
    (else (font-color default))))

(defun mp-player-render-tint-color-by-id ((player-id int))
  "Resolve the packed RGB color used for the player's clothing tint."
  (case player-id
    ((0) #x000000)
    ((1) #xff8c00)
    ((2) #x76ff03)
    ((3) #xff2ed1)
    ((4) #x365cff)
    ((5) #xffe600)
    ((6) #x9b4dff)
    ((7) #xff5c8a)
    (else #x000000)
    )
  )

(defun mp-player-render-tint-strength-by-id ((player-id int))
  "Player 0 keeps vanilla colors. Other player slots use the color tints."
  (if (= player-id 0)
      0.0
      1.0
      )
  )

(defun mp-apply-player-render-tint! ((proc target))
  "Apply the multiplayer player-slot color to this target's Merc draw-control."
  (when (and proc
             (nonzero? proc)
             (-> proc draw)
             (nonzero? (-> proc draw)))
    (let ((player-id (the-as int (-> proc player-id))))
      (set! (-> proc draw pc-player-tint-color)
            (mp-player-render-tint-color-by-id player-id))

      (set! (-> proc draw pc-player-tint-strength)
            (mp-player-render-tint-strength-by-id player-id))
      )
    )
  (none)
  )

(defun mp-player-marker-color ((marker-key object) (fallback-color rgba))
  (mp-player-marker-color-by-id
    (- (the-as int marker-key) MP_REMOTE_PLAYER_MARKER_KEY_BASE)
    fallback-color))

(defun mp-local-player-marker-color ()
  (mp-player-marker-color-by-id
    (the-as int (mp-local-player-id))
    (static-rgba 0 229 255 128)))

(mp-player-controller-reset! *mp-player-controller*)
