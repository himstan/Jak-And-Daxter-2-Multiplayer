;;-*-Lisp-*-
(in-package goal)

(define-extern *mp-spectator-countdown-active?* symbol)
(define-extern *mp-spectating?* symbol)

(defconstant MP_RESPAWN_FLAG_BLOCK_REMOTE_ON_ME #x1)

(define-perm *mp-block-remote-respawn-on-me?* symbol #f)
(define-perm *mp-block-local-respawn-on-remote?* symbol #f)

(defun mp-local-respawn-policy-flags ()
  (the uint8
       (if *mp-block-remote-respawn-on-me?*
           MP_RESPAWN_FLAG_BLOCK_REMOTE_ON_ME
           0))
  )

(defun mp-pack-local-respawn-policy! ()
  (when (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (set! (-> (mp-local-player-record) action respawn-flags)
          (mp-local-respawn-policy-flags))
    )
  (none)
  )

(defun mp-set-block-remote-respawn-on-me! ((blocked? symbol))
  (set! *mp-block-remote-respawn-on-me?* blocked?)
  (mp-pack-local-respawn-policy!)
  (none)
  )

(defun mp-set-block-local-respawn-on-remote! ((blocked? symbol))
  (set! *mp-block-local-respawn-on-remote?* blocked?)
  (none)
  )

(defun mp-set-respawn-blocks! ((block-remote-on-me? symbol) (block-local-on-remote? symbol))
  (set! *mp-block-remote-respawn-on-me?* block-remote-on-me?)
  (set! *mp-block-local-respawn-on-remote?* block-local-on-remote?)
  (mp-pack-local-respawn-policy!)
  (none)
  )

(defun mp-reset-respawn-policy! ()
  (set! *mp-block-remote-respawn-on-me?* #f)
  (set! *mp-block-local-respawn-on-remote?* #f)
  (let ((local (mp-local-player-record)))
    (when (and local (nonzero? local))
      (set! (-> local action respawn-flags) (the uint8 0))
      )
    )
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((record (mp-player-record-by-id (the-as uint player-id))))
      (when (and record
                 (nonzero? record)
                 (mp-player-record-remote? *mp-player-controller* record))
        (set! (-> record action respawn-flags) (the uint8 0)))))
  (none)
  )

(defun mp-clear-remote-respawn-policy! ()
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((record (mp-player-record-by-id (the-as uint player-id))))
      (when (and record
                 (nonzero? record)
                 (mp-player-record-remote? *mp-player-controller* record))
        (set! (-> record action respawn-flags) (the uint8 0)))))
  (none)
  )

(defun mp-player-blocks-respawn? ((record mp-player-record))
  (the symbol
       (and record
            (nonzero? record)
            (>= (-> record connection status) 4)
            (logtest? (-> record action respawn-flags)
                      MP_RESPAWN_FLAG_BLOCK_REMOTE_ON_ME))))

(defun mp-any-remote-blocks-respawn? ()
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((record (mp-player-record-by-id (the-as uint player-id))))
      (when (and record
                 (nonzero? record)
                 (mp-player-record-remote? *mp-player-controller* record)
                 (mp-player-blocks-respawn? record))
        (return #t))))
  #f)

(defun mp-respawn-policy-blocks-remote-placement? ()
  "True when either player has forbidden remote placement."
  (the symbol
       (or *mp-block-local-respawn-on-remote?*
           (mp-any-remote-blocks-respawn?)))
  )

(defun mp-should-use-local-respawn? ()
  (the symbol
       (and *multi-sync-enabled?*
            (= (pc-multi-get-status) (mp-connection-status in-game))
            (mp-respawn-policy-blocks-remote-placement?)))
  )

(defun mp-prepare-local-respawn! ((player target))
  (set! *mp-spectator-countdown-active?* #f)
  (set! *mp-spectating?* #f)
  (let ((local-record (mp-local-player-record)))
    (when (and local-record (nonzero? local-record))
      (mp-player-runtime-clear-flag!
        local-record (mp-player-runtime-flags respawning))))
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((record (mp-player-record-by-id (the-as uint player-id))))
      (when (and record (nonzero? record))
        (mp-player-runtime-clear-flag!
          record (mp-player-runtime-flags force-presentation)))))
  (when (and player (nonzero? player))
    (mp-clear-local-vehicle-occupancy! player)
    (let ((control (-> player control)))
      (when (and control (nonzero? control))
        (vector-copy! (-> control camera-pos) (-> control trans))
        )
      )
    (when (and *camera* (nonzero? *camera*))
      (send-event *camera* 'change-target player)
      (send-event *camera* 'teleport)
      )
    )
  (debug-log *mp-debug-log?* "[MP-Respawn-Policy] Using the vanilla local respawn path.~%")
  (none)
  )

(defun mp-begin-local-death-respawn-policy! ((player target))
  "Latch the policy once when a local death reaches its respawn decision."
  (when (and player
             (nonzero? player)
             *target*
             (nonzero? *target*)
             (not-puppet? player)
             (mp-should-use-local-respawn?))
    (mp-prepare-local-respawn! player)
    (return #t)
    )
  #f
  )
