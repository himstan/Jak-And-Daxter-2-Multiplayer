;;-*-Lisp-*-
(in-package goal)

(defun mp-reset-player-sync-state! ()
  (set! *has-ridden-before?* #t)
  (mp-player-controller-reset! *mp-player-controller*)
  (set! *mp-session-role* (mp-session-role none))
  (none))

(defun mp-pickup-type->equipped-weapon ((gun-type uint))
  "Map a gameplay gun type to the compact network weapon enum."
  (case (the-as pickup-type gun-type)
    (((pickup-type eco-yellow)) (mp-equipped-weapon yellow))
    (((pickup-type eco-red))    (mp-equipped-weapon red))
    (((pickup-type eco-blue))   (mp-equipped-weapon blue))
    (((pickup-type eco-dark))   (mp-equipped-weapon dark))
    (else                       (mp-equipped-weapon none))
    )
  )

(defun mp-equipped-weapon->pickup-type ((weapon uint))
  "Map the compact network weapon enum back to a gameplay gun type."
  (the uint
       (case (the-as mp-equipped-weapon (the int weapon))
         (((mp-equipped-weapon yellow)) (the uint (pickup-type eco-yellow)))
         (((mp-equipped-weapon red))    (the uint (pickup-type eco-red)))
         (((mp-equipped-weapon blue))   (the uint (pickup-type eco-blue)))
         (((mp-equipped-weapon dark))   (the uint (pickup-type eco-dark)))
         (else                          (the uint (pickup-type none)))
         ))
  )

(defun mp-current-camera-angle-y ()
  "Read the current camera yaw for weapon-shot replication."
  (if (and *target*
           (nonzero? *target*)
           (-> *target* control)
           (nonzero? (-> *target* control))
           *math-camera*
           (nonzero? *math-camera*))
      (let ((cam-mat (-> *math-camera* inv-camera-rot)))
        (atan (-> cam-mat vector 2 x) (-> cam-mat vector 2 z))
        )
      0.0
      )
  )

(defun mp-player-queue-gun-shot! ((gun-type uint))
  "Queue a reliable gun-shot replay event through the common event API."
  (if (or (not *multi-sync-enabled?*)
          (!= (pc-multi-get-status) (mp-connection-status in-game))
          *mp-processing-remote-event*)
      (return #f))
  (let ((weapon (mp-pickup-type->equipped-weapon gun-type)))
    (when (not (zero? weapon))
      (+! *mp-local-gun-shot-seq* 1)
      (mp-event-enqueue-player-gun-shot!
        (the-as uint weapon)
        *mp-local-gun-shot-seq*
        (mp-current-camera-angle-y))
      )
    )
  (none)
  )

(defun mp-clear-local-vehicle-occupancy! ((player target))
  "Detach the local player from a vehicle seat without touching ride-along state."
  (when (and player
             (nonzero? player)
             (-> player pilot)
             (nonzero? (-> player pilot))
             (nonzero? (-> player pilot vehicle)))
    (let* ((pilot-info (-> player pilot))
           (seat-index (-> pilot-info seat-index))
           (vehicle-proc (the-as vehicle (handle->process-safe (-> pilot-info vehicle)))))
      (when (and vehicle-proc (nonzero? vehicle-proc))
        (remove-rider vehicle-proc player)
        (when (and (>= seat-index 0) (< seat-index 4))
          (set! (-> vehicle-proc rider-array seat-index) (the-as handle #f))
          )
        (when (zero? seat-index)
          (send-event vehicle-proc 'player-get-off)
          )
        )
      (set! (-> pilot-info vehicle) (the-as handle #f))
      (set! (-> pilot-info seat-index) 0)
      )
    )
  (when (and (mp-local-player-record) (nonzero? (mp-local-player-record)))
    (set! (-> (mp-local-player-record) vehicle vehicle-id) (the uint 0))
    (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 0))
    )
  (when (and player
             (nonzero? player)
             (-> player pilot)
             (nonzero? (-> player pilot)))
    (set! (-> player pilot vehicle) (the-as handle #f))
    (set! (-> player pilot seat-index) 0)
    )
  (when (and player (nonzero? player))
    (set! (-> player mode-cache) #f)
    (set! (-> player mode-param1) (the-as handle #f))
    (set! (-> player mode-param2) (the-as uint64 0))
    (set! (-> player mode-param3) (the-as uint64 0))
    (logclear! (-> player focus-status) (focus-status pilot pilot-riding))
    )
  (none)
  )

(defun mp-respawn-local-target! ((player target))
  "Respawn the local player in the correct role-specific base state."
  (mp-clear-local-vehicle-occupancy! player)
  (if (mp-local-player-daxter?)
      (go-process player target-indax-start (the handle #f))
      (go-process player target-stance)
      )
  (none)
  )

(defun mp-extract-local-stats ()
  "Update local info with current game stats"
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *game-info*
             (nonzero? *game-info*))
    (set! (-> *mp-world-state* money) (-> *game-info* money))
    (set! (-> *mp-world-state* gems) (-> *game-info* gem))
    (set! (-> *mp-world-state* skill) (-> *game-info* skill))
    )
  (none))

(defun mp-pack-local-task-masks! ()
  "Pack host task closed/open state into local sync masks."
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *game-info*
             (nonzero? *game-info*))
    (let ((mask (-> *mp-world-state* task-mask))
          (active-mask (-> *mp-world-state* active-task-mask))
          (nodes (-> *game-info* sub-task-list)))
      (when nodes
        (dotimes (i (min 512 (-> nodes length)))
          (let ((byte-idx (/ i 8))
                (bit-idx (logand i 7))
                (node (-> nodes data i)))
            (if (or (= i (the-as uint (game-task-node city-vehicle-training-map)))
                    (= i (the-as uint (game-task-node city-vehicle-training-hover-zone-1)))
                    (= i (the-as uint (game-task-node city-vehicle-training-hover-zone-2)))
                    (= i (the-as uint (game-task-node city-vehicle-training-resolution)))
                    (not (and node (nonzero? node))))
                (begin
                  (logand! (-> mask byte-idx) (lognot (ash 1 bit-idx)))
                  (logand! (-> active-mask byte-idx) (lognot (ash 1 bit-idx)))
                  )
                (let ((flags (-> node flags)))
                  (if (logtest? flags (game-task-node-flag closed))
                      (logior! (-> mask byte-idx) (ash 1 bit-idx))
                      (logand! (-> mask byte-idx) (lognot (ash 1 bit-idx)))
                      )
                  (if (task-node-open? (the-as game-task-node i))
                      (logior! (-> active-mask byte-idx) (ash 1 bit-idx))
                      (logand! (-> active-mask byte-idx) (lognot (ash 1 bit-idx)))
                      )
                  )
              )
            )
          )
        )
      )
    )
  (none))

(defun mp-pack-local-continue-name! ()
  "Pack the current continue name bytes for client bootstrap alignment."
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *game-info*
             (nonzero? *game-info*))
    (let ((dst (-> *mp-bootstrap-state* host-continue)))
      (dotimes (i 32)
        (set! (-> dst i) (the-as uint 0))
        )
      (let ((cont (-> *game-info* current-continue)))
        (when (and cont (nonzero? cont))
          (let ((cont-name (-> cont name)))
            (when (and cont-name (nonzero? cont-name))
              (let ((src (-> cont-name data))
                    (len (min 31 (length cont-name))))
                (dotimes (i len)
                  (set! (-> dst i) (-> src i))
                  )
                )
              )
            )
          )
        )
      )
    )
  (none))

(defun mp-pack-local-player-name! ()
  "Pack the committed multiplayer player name into the shared local player snapshot."
  (when (and (mp-local-player-record)
             (nonzero? (the-as uint (mp-local-player-record))))
    (let ((dst (-> (mp-local-player-record) identity name))
          (name (pc-multi-get-player-name)))
      (dotimes (i MP_PLAYER_NAME_SIZE)
        (set! (-> dst i) (the-as uint8 0))
        )
      (when (and name (nonzero? (the-as uint name)))
        (let ((src (-> name data))
              (len (min (- MP_PLAYER_NAME_SIZE 1) (length name))))
          (when (and src (nonzero? (the-as uint src)))
            (dotimes (i len)
              (set! (-> dst i) (-> src i))
              )
            )
          )
        )
      )
    )
  (none))

(defun mp-local-sync-aid-packed? ((aid uint) (count int))
  (let ((packed? #f))
    (dotimes (i count)
      (when (= (-> *mp-bootstrap-state* synchronized-aids i) (the-as uint aid))
        (set! packed? #t)
        )
      )
    packed?
    )
  )

(defun mp-pack-local-sync-aid! ((aid uint) (count int))
  "Append a unique dead/synced AID to local-info and return the new count."
  (if (or (>= count 120)
          (mp-local-sync-aid-packed? aid count))
      count
      (begin
        (set! (-> *mp-bootstrap-state* synchronized-aids count) (the-as uint aid))
        (+ count 1)
        )
      )
  )

(defun mp-pack-local-dead-perm-aids! ((count int))
  (when (not (and *game-info* (nonzero? *game-info*)))
    (return count)
    )
  (let ((perm-array (-> *game-info* perm-list)))
    (when (and perm-array (nonzero? perm-array))
      (dotimes (i (-> perm-array length))
        (when (< count 120)
          (let ((perm (-> perm-array data i)))
            (when (logtest? (-> perm status) (entity-perm-status dead))
              (set! count (mp-pack-local-sync-aid! (the-as uint (-> perm aid)) count))
              )
            )
          )
        )
      )
    )
  count
  )

(defun mp-pack-local-loaded-dead-aids! ((count int))
  (when (not (and *level* (nonzero? *level*)))
    (return count)
    )
  (dotimes (level-idx 6)
    (when (< count 120)
      (let ((lev (-> *level* level level-idx)))
        (when (and lev (nonzero? lev) (= (-> lev status) 'active))
          (let ((entities (-> lev entity)))
            (when (and entities (nonzero? entities))
              (dotimes (ent-idx (-> entities length))
                (when (< count 120)
                  (let ((ent (-> entities data ent-idx)))
                    (when (and ent (nonzero? ent))
                      (let ((perm (-> ent perm))
                            (proc (-> ent process)))
                        (when (or (and perm
                                       (nonzero? perm)
                                       (logtest? (-> perm status) (entity-perm-status dead)))
                                  (and proc
                                       (nonzero? proc)
                                       (type? proc enemy)
                                       (logtest? (-> (the-as enemy proc) enemy-flags) (enemy-flag mp-synced-death))))
                          (set! count (mp-pack-local-sync-aid! (the-as uint (-> ent aid)) count))
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
          )
        )
      )
    )
  count
  )

(defun mp-pack-local-world-snapshot! ()
  "Pack the host-authoritative bootstrap world snapshot."
  (when (and (mp-session-host?)
             (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (mp-pack-local-task-masks!)
    (mp-pack-local-continue-name!)
    (let ((count 0))
      (set! count (mp-pack-local-dead-perm-aids! count))
      (set! count (mp-pack-local-loaded-dead-aids! count))
      (set! (-> *mp-bootstrap-state* synchronized-aid-count) (the-as uint count))
      )
    )
  (none))

(defun mp-pack-local-player-transform! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control)))
    (let ((control (-> *target* control)))
      (set! (-> (mp-local-player-record) transform position x) (-> control trans x))
      (set! (-> (mp-local-player-record) transform position y) (-> control trans y))
      (set! (-> (mp-local-player-record) transform position z) (-> control trans z))
      (set! (-> (mp-local-player-record) transform angle) (quaternion-y-angle (-> control quat)))
      (set-vector! (-> (mp-local-player-record) transform velocity)
                   (-> control transv x)
                   (-> control transv y)
                   (-> control transv z)
                   0.0)
      )
    (set! (-> (mp-local-player-record) action scene-state) (if *scene-player* (the uint8 1) (the uint8 0)))
    )
  (none))

(defun mp-pack-local-turret-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record))
             *target*
             (nonzero? *target*)
             (-> *target* state)
             (nonzero? (-> *target* state))
             (or (= (-> *target* state name) 'target-turret-get-on)
                 (= (-> *target* state name) 'target-turret-stance))
             (nonzero? (-> *target* turret))
             (nonzero? (-> (the-as mp-turret-info-dummy (-> *target* turret)) handle)))
    (let* ((turret-proc (the-as mp-base-turret-dummy (handle->process-safe (-> (the-as mp-turret-info-dummy (-> *target* turret)) handle))))
           (turret-ent (if (and turret-proc (nonzero? turret-proc)) (-> turret-proc entity) #f)))
      (when (and turret-ent (nonzero? turret-ent))
        (set! (-> (mp-local-player-record) vehicle vehicle-id) (the uint (-> (the-as entity-actor turret-ent) aid)))
        (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 0))
        (set! (-> (mp-local-player-record) vehicle turret-active?) (the uint8 1))
        (set! (-> (mp-local-player-record) vehicle turret-roty) (-> turret-proc roty))
        (set! (-> (mp-local-player-record) vehicle turret-rotx) (-> turret-proc rotx))
        )
      )
    )
  (none))

(defun mp-pack-local-player-mode-snapshot! ()
  "Pack local vehicle and turret occupancy into the local player record."
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (when (not (mp-vehicle-pack-local-crash-snapshot?))
      (set! (-> (mp-local-player-record) vehicle state net-id) (the-as uint 0))
      )
    (set! (-> (mp-local-player-record) vehicle vehicle-id) (the uint 0))
    (set! (-> (mp-local-player-record) vehicle seat-index) (the uint8 0))
    (set! (-> (mp-local-player-record) vehicle turret-active?) (the uint8 0))
    (set! (-> (mp-local-player-record) vehicle turret-roty) 0.0)
    (set! (-> (mp-local-player-record) vehicle turret-rotx) 0.0)
    (mp-vehicle-pack-local-player-snapshot!)
    (mp-pack-local-turret-snapshot!)
    )
  (none))

(defun mp-pack-local-level-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (set! (-> (mp-local-player-record) transform level) (the-as uint 0))
    (set! (-> (mp-local-player-record) transform level) (mp-current-level-packed-id))
    )
  (none))

(defun mp-pack-local-state-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (let ((local-state 0))
      (set! (-> (mp-local-player-record) action visual-secrets)
            (mp-local-player-visual-secrets))
      (set! (-> (mp-local-player-record) action darkjak-stage) (the uint 0))
      (set! (-> (mp-local-player-record) action riding-along-player-id)
            MP_INVALID_PLAYER_ID)
      (if (and *target*
               (nonzero? *target*)
               (-> *target* state)
               (nonzero? (-> *target* state)))
          (set! local-state (the int (mp-target-get-id-from-state (-> *target* state name))))
          )
      (when (and *target* (nonzero? *target*))
        (set! (-> (mp-local-player-record) action riding-along-player-id)
              (-> *target* riding-along-player-id)))
      (when (and *target*
                 (nonzero? *target*)
                 (focus-test? *target* dark)
                 (-> *target* darkjak)
                 (nonzero? (-> *target* darkjak)))
        (set! (-> (mp-local-player-record) action darkjak-stage)
              (mp-darkjak-persistent-stage (the uint (-> *target* darkjak stage))))
        )
      (when (and (mp-local-player-jak?) (!= (the uint local-state) *mp-last-local-state-id*))
        (cond
          ((= local-state (the uint (mp-target-state-id darkjak-get-on)))
           (debug-log *mp-debug-log?* "[MP-Player-Snapshot] Local Jak entering Dark Jak! Broadcasting event...~%")
           (mp-event-enqueue-aid! MP_EVENT_CHANGE_MODE_DARKJAK (the uint 0))
           )
          ((= local-state (the uint (mp-target-state-id darkjak-get-off)))
           (debug-log *mp-debug-log?* "[MP-Player-Snapshot] Local Jak exiting Dark Jak! Broadcasting event...~%")
           (mp-event-enqueue-aid! MP_EVENT_END_MODE_DARKJAK (the uint 0))
           )
          )
        )
      (when (and (!= (the uint local-state) *mp-last-local-state-id*)
                 (mp-target-authoritative-action-state? (mp-target-get-state-from-id (the uint local-state))))
        (+! (-> (mp-local-player-record) action authoritative-sequence) (the uint 1))
        (set! (-> (mp-local-player-record) action action-state-id) (the uint local-state))
        )
      (set! *mp-last-local-state-id* (the uint local-state))
      (set! (-> (mp-local-player-record) action target-state-id) (the uint local-state))
      (+! (-> (mp-local-player-record) connection latest-state-sequence) 1)
      )
    )
  (none))

(defun mp-pack-local-neutral-input! ()
  (set! (-> (mp-local-player-record) input buttons) (the-as uint 0))
  (set! (-> (mp-local-player-record) input leftx) (the-as uint 128))
  (set! (-> (mp-local-player-record) input lefty) (the-as uint 128))
  (set! (-> (mp-local-player-record) input rightx) (the-as uint 128))
  (set! (-> (mp-local-player-record) input righty) (the-as uint 128))
  (none))

(defun mp-pack-local-active-input! ((pad cpad-info))
  (let ((buttons (-> pad button0)))
    (when (and *target* (nonzero? *target*))
      (let ((ctrl (-> *target* control)))
        (when (and ctrl (nonzero? ctrl))
          (let ((surf (-> ctrl current-surface)))
            (when (and surf (nonzero? surf))
              (when (or (logtest? (-> surf flags) (surface-flag no-jump))
                        (logtest? (-> *target* state-flags) (state-flags prevent-jump)))
                (logclear! buttons (pad-buttons x))
                )
              (when (or (logtest? (-> surf flags) (surface-flag no-attack no-hands no-feet))
                        (logtest? (-> *target* state-flags) (state-flags prevent-attack disable-attacks)))
                (logclear! buttons (pad-buttons circle square))
                )
              )
            )
          )
        )
      (when (logtest? (-> *target* state-flags) (state-flags prevent-duck))
        (if (and (mp-local-player-daxter?)
                 (mp-target-ride-along? *target*))
            (logclear! buttons (pad-buttons l1))
            (logclear! buttons (pad-buttons l1 r1))
            )
        )
      (when (logtest? (-> *target* state-flags) (state-flags prevent-board))
        (logclear! buttons (pad-buttons r2))
        )
      (when (logtest? (-> *target* state-flags) (state-flags prevent-gun))
        (logclear! buttons (pad-buttons l2))
        )
      )
    (set! (-> (mp-local-player-record) input buttons) (the-as uint buttons))
    )
  (set! (-> (mp-local-player-record) input leftx) (-> pad leftx))
  (set! (-> (mp-local-player-record) input lefty) (-> pad lefty))
  (set! (-> (mp-local-player-record) input rightx) (-> pad rightx))
  (set! (-> (mp-local-player-record) input righty) (-> pad righty))
  (none))

(defun mp-pack-local-input-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (if (or (= *master-mode* 'menu) (= *master-mode* 'progress) (= *master-mode* 'pause) (= *master-mode* 'freeze))
        (mp-pack-local-neutral-input!)
        (if (and *cpad-list* (nonzero? *cpad-list*))
            (mp-pack-local-active-input! (-> *cpad-list* cpads 0))
            (mp-pack-local-neutral-input!)
            )
        )
    )
  (none))

(defun mp-pack-local-camera-weapon-snapshot! ()
  (when (and (mp-local-player-record)
             (nonzero? (mp-local-player-record)))
    (set! (-> (mp-local-player-record) input camera-angle-y) (mp-current-camera-angle-y))
    (set! (-> (mp-local-player-record) input equipped-weapon) (the uint8 0))
    (when (and *target*
               (nonzero? *target*)
               (-> *target* gun)
               (nonzero? (-> *target* gun))
               (using-gun? *target*))
      (set! (-> (mp-local-player-record) input equipped-weapon)
            (the-as uint (mp-pickup-type->equipped-weapon (the-as uint (-> *target* gun gun-type)))))
      )
    )
  (none))

(defun mp-extract-local-data ()
  "Extract position, animation, and world state for sending"
  (with-pp
    (when (and (mp-local-player-record)
               (nonzero? (mp-local-player-record))
               *target*
               (nonzero? *target*)
               (-> *target* control)
               (nonzero? (-> *target* control)))
      (mp-pack-local-world-snapshot!)
      (mp-pack-local-player-transform!)
      (mp-pack-local-player-mode-snapshot!)
      (mp-pack-local-level-snapshot!)
      (mp-pack-local-state-snapshot!)
      (mp-pack-local-input-snapshot!)
      (mp-pack-local-camera-weapon-snapshot!)
      (mp-pack-local-respawn-policy!)
      )
    )
  (none))
