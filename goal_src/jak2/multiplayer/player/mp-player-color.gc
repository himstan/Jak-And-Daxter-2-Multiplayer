;;-*-Lisp-*-
(in-package goal)

(defconstant MP_DEFAULT_PLAYER_COLOR_RGB (the uint #x00e5ff))
(defconstant MP_PLAYER_MARKER_ALPHA (the uint #x80))
(defconstant MP_PLAYER_PRIMARY_SKIN_SLOT (the int 0))

(define *mp-player-controller-led-synced?* #f)

(defun mp-player-controller-led-sync! ((color-rgb uint))
  (pc-controller-led-set-base-rgb! (the int (logand (ash color-rgb -16) #xff))
                                   (the int (logand (ash color-rgb -8) #xff))
                                   (the int (logand color-rgb #xff)))
  (true! *mp-player-controller-led-synced?*)
  (none))

(defun mp-player-controller-led-sync-saved! ()
  (when (and (not *mp-player-controller-led-synced?*)
             (nonnull? *multiplayer-preferences*)
             (= (pc-multi-get-preferences *multiplayer-preferences*) 1))
    (mp-player-controller-led-sync! (the uint (-> *multiplayer-preferences* skin colors MP_PLAYER_PRIMARY_SKIN_SLOT))))
  (none))

(defun mp-player-color-record-by-slot ((player-slot int))
  (when (and (>= player-slot 0) (< player-slot MP_MAX_PLAYERS))
    (let ((record (mp-player-record-by-slot (the-as uint player-slot))))
      (when (and record (nonzero? record) (nonzero? (-> record identity identity-ready?)))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-player-rgb->rgba ((color-rgb uint) (alpha uint))
  (the-as rgba
          (logior (logand (ash color-rgb -16) #xff)
                  (ash (logand (ash color-rgb -8) #xff) 8)
                  (ash (logand color-rgb #xff) 16)
                  (ash (logand alpha #xff) 24))))

(defun font-color-from-rgb ((color-rgb uint))
  (the-as font-color (logior FONT_COLOR_RGB_TAG (logand color-rgb #x00ffffff))))

(defun mp-player-marker-color-by-slot ((player-slot int) (fallback-color rgba))
  (let ((record (mp-player-color-record-by-slot player-slot)))
    (if (and record (nonzero? record))
      (mp-player-rgb->rgba (-> record identity skin colors MP_PLAYER_PRIMARY_SKIN_SLOT) MP_PLAYER_MARKER_ALPHA)
      fallback-color)))

(defun mp-player-font-color-by-slot ((player-slot int))
  (let ((record (mp-player-color-record-by-slot player-slot)))
    (if (and record (nonzero? record))
      (font-color-from-rgb (-> record identity skin colors MP_PLAYER_PRIMARY_SKIN_SLOT))
      (font-color default))))

(defun mp-player-marker-color ((marker-key object) (fallback-color rgba))
  (mp-player-marker-color-by-slot (- (the-as int marker-key) MP_REMOTE_PLAYER_MARKER_KEY_BASE) fallback-color))

(defun mp-local-player-marker-color ()
  (mp-player-marker-color-by-slot (the-as int (mp-local-player-slot))
                                  (mp-player-rgb->rgba MP_DEFAULT_PLAYER_COLOR_RGB MP_PLAYER_MARKER_ALPHA)))
