;;-*-Lisp-*-
(in-package goal)

(defun mp-death-spectate-now ()
  (if (and *display*
           (nonzero? *display*)
           (-> *display* game-clock)
           (nonzero? (-> *display* game-clock)))
      (-> *display* game-clock frame-counter)
      (current-time)))

(defun mp-death-spectate-configure! ()
  (let ((options (new 'stack 'mp-spectate-options)))
    (if (and options (nonzero? options))
        (begin
          (mp-spectate-default-options! options)
          (logclear! (-> options flags)
                     (mp-spectate-flags
                       end-on-scene inert-local-anchor roster-only-presence))
          (mp-spectate-start! 'death options))
        #f)))

(defun mp-death-spectate-update-countdown! ((remaining int))
  (if (and (>= remaining 0) (mp-any-live-remote-player?))
      (mp-spectate-set-custom-text!
        'death
        (text-id mp-spectate-respawn-countdown)
        (mp-spectate-text-param-kind integer)
        remaining)
      (mp-spectate-clear-custom-text! 'death))
  (none))

(defun mp-death-spectate-ready-record ((elapsed time-frame))
  (when (and (or (>= elapsed (seconds 20)) *scene-player*)
             (mp-any-live-remote-player?))
    (let ((record (mp-spectate-selected-player-record))
          (remote (mp-prepare-remote-spectate-target!)))
      (when (and record
                 (nonzero? record)
                 remote
                 (nonzero? remote)
                 (mp-player-spectate-level-ready? record))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-death-spectate-respawn!
       ((player target) (record mp-player-record))
  (when (and player
             (nonzero? player)
             record
             (nonzero? record))
    (mp-event-enqueue-aid! MP_EVENT_PLAYER_RESPAWNED (the-as uint 0))
    (set! (-> player fact health) (/ (-> player fact health-max) 2.0))
    (mp-set-local-player-respawning! #t)
    (remove-setting! 'mode-name)
    (when (not (mp-spectate-stop! 'death 'respawned))
      (mp-spectate-reset!))
    ;; This may go-process the target and must remain the final operation.
    (mp-respawn-local-target-at-player! player record))
  (none))

(defun mp-death-spectate-reset-needed? ()
  (or (not *multi-sync-enabled?*)
      (not (mp-any-live-remote-player?))))

(defun mp-run-local-death-spectate! ((player target))
  "Run the shared death countdown and return true only when a full reset is required."
  (when (or (not player)
            (zero? player)
            (not (mp-death-spectate-configure!)))
    (return #t))
  (mp-clear-local-vehicle-occupancy! player)
  (remove-setting! 'process-mask)
  (remove-setting! 'mode-name)
  (set-setting! 'mode-name 'cam-string 0.0 0)
  (apply-settings *setting-control*)
  (let ((start-time (mp-death-spectate-now)))
    (loop
      (let* ((elapsed (- (mp-death-spectate-now) start-time))
             (remaining (/ (- (seconds 20) elapsed) (seconds 1))))
        (mp-death-spectate-update-countdown! remaining)
        (when (< remaining 3)
          (mp-spectate-clear-flags! (mp-spectate-flags allow-switch))
          )
        (let ((respawn-record (mp-death-spectate-ready-record elapsed)))
          (when (and respawn-record (nonzero? respawn-record))
            (mp-death-spectate-respawn! player respawn-record)
            (loop (suspend))))
        (when (mp-death-spectate-reset-needed?)
          (if (mp-is-fail-mission-pending?)
              (suspend)
              (begin
                (remove-setting! 'mode-name)
                (mp-spectate-stop! 'death 'no-live-player)
                (return #t)))))
      (suspend)))
  #f)
