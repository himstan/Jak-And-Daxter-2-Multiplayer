;;-*-Lisp-*-
(in-package goal)

(defun mp-local-player-dead-or-spectating? ()
  (the symbol
       (or *mp-death-respawn-event-pending?*
           (mp-spectate-active?)
           (mp-spectate-requested?)
           (and *target* (nonzero? *target*) (focus-test? *target* dead)))))

(defun mp-death-refresh-chase-camera! ()
  (let ((tank (process-by-name "fort-robotank-2" *active-pool*)))
    (when (nonnull? tank)
      (send-event tank 'mp-camera-refresh)))
  (none))

(defun mp-death-party-wipe-receive! ()
  (when (mp-local-player-dead-or-spectating?)
    (set! *mp-death-party-wipe-pending?* #t))
  (none))

(defun mp-death-respawn-event-on-spawn! ()
  (when *mp-death-respawn-event-pending?*
    (set! *mp-death-respawn-event-pending?* #f)
    (mp-event-enqueue-aid! MP_EVENT_PLAYER_RESPAWNED (the-as uint 0)))
  (set! *mp-death-party-wipe-pending?* #f)
  (none))

(defun mp-death-spectate-now ()
  (if (and *display* (nonzero? *display*) (-> *display* game-clock) (nonzero? (-> *display* game-clock)))
    (-> *display* game-clock frame-counter)
    (current-time)))

(defun mp-death-spectate-configure! ()
  (let ((options (new 'stack 'mp-spectate-options)))
    (if (and options (nonzero? options))
      (begin
        (mp-spectate-default-options! options)
        (logclear! (-> options flags) (mp-spectate-flags end-on-scene inert-local-anchor roster-only-presence))
        (mp-spectate-start! 'death options))
      #f)))

(defun mp-death-spectate-update-countdown! ((remaining int))
  (if (and (>= remaining 0) (mp-any-live-remote-player?))
    (mp-spectate-set-custom-text! 'death
                                  (text-id mp-spectate-respawn-countdown)
                                  (mp-spectate-text-param-kind integer)
                                  remaining)
    (mp-spectate-clear-custom-text! 'death))
  (none))

(defun mp-death-spectate-ready-record ((elapsed time-frame) (delay time-frame))
  (when (and (or *scene-player* (and (> delay 0) (>= elapsed delay))) (mp-any-live-remote-player?))
    (let ((record (mp-spectate-selected-player-record))
          (remote (mp-prepare-remote-spectate-target!)))
      (when (and (nonnull? record remote) (mp-player-spectate-level-ready? record))
        (return record))))
  (the-as mp-player-record #f))

(defun mp-death-spectate-respawn! ((player target) (record mp-player-record))
  (when (and (nonnull? player record (-> player fact) (-> player water))
             (mp-teleport-target-ready-for-record? player record))
    (let* ((veh (place-respawn-target-at-player! player record))
           (seat (mp-teleport-find-last-empty-seat veh #t)))
      (reset-teleport-history! player)
      (logclear! (-> player water flags)
                 (water-flags active
                              over-water
                              touch-water
                              under-water
                              head-under-water
                              bouncing
                              wading
                              swimming
                              jump-out
                              break-surface))
      (logclear! (-> player focus-status) (focus-status touch-water))
      (mp-event-enqueue-aid! MP_EVENT_PLAYER_RESPAWNED (the-as uint 0))
      (set! (-> player fact health) (/ (-> player fact health-max) 2.0))
      (mp-set-local-player-respawning! #t)
      (remove-setting! 'mode-name)
      (when (not (mp-spectate-stop! 'death 'respawned))
        (mp-spectate-reset!))
      (mp-death-refresh-chase-camera!)
      (when (nonnull? *TARGET-bank*)
        (target-timed-invulnerable (the-as time-frame (-> *TARGET-bank* hit-invulnerable-timeout)) player 1))
      (if (and (nonnull? veh) (!= seat -1)) (mp-teleport-board-vehicle-seat! player veh seat) (mp-respawn-local-target! player))))
  (none))

(defun mp-death-spectate-abort! ()
  (remove-setting! 'mode-name)
  (apply-settings *setting-control*)
  (set! *mp-death-respawn-event-pending?* #f)
  (set! *mp-death-party-wipe-pending?* #f)
  (mp-set-local-player-respawning! #f)
  (when (not (mp-spectate-stop! 'death 'abort))
    (mp-spectate-reset!))
  (none))

(defun local-mission-failure-active? ()
  (and (nonnull? *fail-mission-control*) (nonnull? (get-proc *fail-mission-control*))))

(defun end-death-spectate-if-needed! ((manager mp-spectate-manager))
  (when (and (nonnull? manager)
             (= (-> manager owner) 'death)
             (or (local-mission-failure-active?)
                 (and (nonnull? *target* (-> *target* control)) (not (focus-test? *target* dead)))))
    (mp-death-spectate-abort!)
    (return #t))
  #f)

(defun mp-death-spectate-reset-needed? ()
  (cond
    (*mp-death-party-wipe-pending?* #t)
    ((not (mp-session-in-game?)) #t)
    ((not (mp-any-remote-gameplay-player-connected?)) #t)
    ((mp-all-remote-players-dead?)
     (set! *mp-death-party-wipe-pending?* #t)
     (mp-event-enqueue-aid! MP_EVENT_PARTY_WIPE (the-as uint 0))
     #t)
    (else #f)))

(defun mp-run-local-death-spectate! ((player target))
  (when (or (not player) (zero? player) (not (mp-death-spectate-configure!)))
    (return #t))
  (mp-clear-local-vehicle-occupancy! player)
  (mp-death-refresh-chase-camera!)
  (remove-setting! 'process-mask)
  (remove-setting! 'mode-name)
  (set-setting! 'mode-name 'cam-string 0.0 0)
  (apply-settings *setting-control*)
  (let ((start-time (mp-death-spectate-now)))
    (loop
      (while (or (mp-session-reconnecting?) (mp-session-terminal?) (local-mission-failure-active?))
        (suspend))
      (when (not (mp-spectate-requested?))
        (remove-setting! 'mode-name)
        (return #t))
      (when (mp-death-spectate-reset-needed?)
        (while (and (mp-is-fail-mission-pending?) (mp-session-host?))
          (suspend))
        (remove-setting! 'mode-name)
        (mp-spectate-stop! 'death 'no-live-player)
        (return #t))
      (let* ((delay (the-as time-frame (* (get-respawn-delay-seconds) (seconds 1))))
             (elapsed (- (mp-death-spectate-now) start-time))
             (remaining (if (> delay 0) (/ (- delay elapsed) (seconds 1)) -1)))
        (mp-death-spectate-update-countdown! remaining)
        (if (and (> delay 0) (< remaining 3))
          (mp-spectate-clear-flags! (mp-spectate-flags allow-switch))
          (mp-spectate-set-flags! (mp-spectate-flags allow-switch)))
        (let ((respawn-record (mp-death-spectate-ready-record elapsed delay)))
          (when (and respawn-record (nonzero? respawn-record))
            (mp-death-spectate-respawn! player respawn-record)
            (loop
              (suspend)))))
      (suspend)))
  #f)
