;;-*-Lisp-*-
(in-package goal)

(defconstant SEWER_WATER_ID_BASE (the uint #x74000000))

(defun sewer-water-height ((stage int))
  (+ -216498.17
     (case stage
       ((1) -49152.0)
       ((2) -98304.0)
       ((3) -151552.0)
       (else 0.0))))

(defun sewer-valve-aid ((stage int))
  (the uint (case stage ((1) 9256) ((2) 9257) ((3) 9232) (else 0))))

(defun sewer-water-finished? ()
  (the symbol (and (nonnull? *game-info* (-> *game-info* sub-task-list))
                   (task-node-closed? (game-task-node sewer-board-resolution)))))

(defun sewer-water-stage ()
  (when (and (nonnull? *game-info* (-> *game-info* sub-task-list))
             (task-node-closed? (game-task-node sewer-board-drain)))
    (return 3))
  (countdown (index 3)
    (when (mp-aid-dead-in-perm-list? (+ SEWER_WATER_ID_BASE index 1))
      (return (+ index 1))))
  0)

(defun sewer-water-apply! ((height float))
  (when (and (or (mp-level-active? 'sewerb) (mp-level-active? 'sewescb))
             (nonnull? *ocean-map-sewer*))
    (let ((delta (- height (get-base-height *ocean-map-sewer*))))
      (set-height! *ocean-map-sewer* height)
      (when (and (= *ocean-map* *ocean-map-sewer*)
                 (nonnull? *target* (-> *target* control))
                 (focus-test? *target* board) (focus-test? *target* touch-water))
        (+! (-> *target* control trans y) delta))))
  (none))

(defun sewer-water-send! ((controller sewer-water-controller))
  (let ((event (new 'stack-no-clear 'sewer-water-state-event)))
    (when (and (nonnull? controller event) (mp-event-prepare! event MP_EVENT_SEWER_WATER_STATE))
      (set! (-> event payload water-height) (-> controller water-height))
      (set! (-> event payload spin-rate) (-> controller spin-rate))
      (set! (-> event payload stage) (-> controller stage))
      (mp-event-enqueue! event)))
  (none))

(defun sewer-water-next-height ((height float) (destination float) (spin-rate float))
  (+ destination
     (seek-ease (- height destination) 0.0
                (* (lerp 21299.2 8192.0 (/ spin-rate (meters 48))) (seconds-per-frame))
                12288.0 2.0)))

(defun sewer-water-advance! ((controller sewer-water-controller))
  (when (nonnull? controller)
    (seek! (-> controller spin-rate) 0.0 (* 81920.0 (seconds-per-frame)))
    (set! (-> controller water-height)
          (sewer-water-next-height (-> controller water-height)
                                   (sewer-water-height (the int (-> controller stage)))
                                   (-> controller spin-rate))))
  (none))

(defstate drain (sewer-water-controller)
  :virtual #t
  :code (behavior ()
    (until (or (not (mp-session-connected?)) (not (nonnull? self)) (sewer-water-finished?))
      (when (mp-session-in-game?)
        (when (mp-session-host?)
          (let ((stage (sewer-water-stage)))
            (when (!= stage (-> self stage))
              (when (< stage (-> self stage))
                (set! (-> self water-height) (sewer-water-height stage)))
              (set! (-> self stage) (the uint8 stage))
              (set! (-> self spin-rate) 196608.0)
              (set! (-> self last-send) 0))))
        (sewer-water-advance! self)
        (sewer-water-apply! (-> self water-height))
        (when (and (mp-session-host?) (time-elapsed? (-> self last-send) (seconds 0.25)))
          (sewer-water-send! self)
          (set! (-> self last-send) (current-time))))
      (suspend))
    (when (sewer-water-finished?)
      (sewer-water-apply! (sewer-water-height 3)))
    (deactivate self)))

(defbehavior sewer-water-controller-init sewer-water-controller ()
  (when (nonnull? self (-> self main-thread) *display* (-> *display* shared-clock))
    (stack-size-set! (-> self main-thread) 1024)
    (set! (-> self clock) (-> *display* shared-clock))
    (set! (-> self mask) (process-mask pause menu))
    (set! (-> self water-height) (sewer-water-height 0))
    (set! (-> self spin-rate) 0.0)
    (set! (-> self stage) (the uint8 0))
    (set! (-> self last-send) 0)
    (go-virtual drain))
  (none))

(defun ensure-sewer-water-controller! ()
  (when (sewer-water-finished?)
    (sewer-water-apply! (sewer-water-height 3))
    (return (the-as sewer-water-controller #f)))
  (when (not (nonnull? (process-by-type-exact 'sewer-water-controller *active-pool*)))
    (process-spawn sewer-water-controller :init sewer-water-controller-init :to *mid-pool*))
  (the-as sewer-water-controller (process-by-type-exact 'sewer-water-controller *active-pool*)))

(defun receive-sewer-water-state! ((event sewer-water-state-event))
  (when (and (mp-session-client?) (nonnull? event)
             (= (-> event source-player-slot) (mp-host-player-slot))
             (<= (-> event payload stage) 3)
             (<= (sewer-water-height (the int (-> event payload stage))) (-> event payload water-height))
             (<= (-> event payload water-height) (sewer-water-height 0))
             (<= 0.0 (-> event payload spin-rate))
             (<= (-> event payload spin-rate) 196608.0))
    (let ((controller (ensure-sewer-water-controller!)))
      (when (nonnull? controller)
        (set! (-> controller water-height) (-> event payload water-height))
        (set! (-> controller spin-rate) (-> event payload spin-rate))
        (set! (-> controller stage) (-> event payload stage)))))
  (none))

(defun sync-sewer-water! ((aid uint) (message symbol))
  (when (and (> aid SEWER_WATER_ID_BASE) (<= aid (+ SEWER_WATER_ID_BASE 3)))
    (when (= message 'synchronized?)
      (return (mp-aid-dead-in-perm-list? aid)))
    (let* ((stage (the int (- aid SEWER_WATER_ID_BASE)))
           (changed? (not (mp-aid-dead-in-perm-list? aid)))
           (controller (ensure-sewer-water-controller!)))
      (mp-record-aid-dead-in-perm-list! aid)
      (when (and (nonnull? controller) (> stage (-> controller stage)))
        (set! (-> controller stage) (the uint8 stage))
        (set! (-> controller spin-rate) 196608.0)
        (set! (-> controller last-send) 0)
        (when (= message 'restore-broken)
          (set! (-> controller water-height) (sewer-water-height stage))))
      (when (and (mp-session-host?) (= stage 3)
                 (nonnull? *game-info* (-> *game-info* sub-task-list))
                 (not (task-node-closed? (game-task-node sewer-board-drain))))
        (task-node-close! (game-task-node sewer-board-drain)))
      (when (and changed? (= message 'break) (nonnull? *level*))
        (let ((entity (entity-by-aid (sewer-valve-aid stage))))
          (when (nonnull? entity (-> entity extra) (-> entity extra process))
            (send-event (-> entity extra process) 'break)))))
    (return #t))
  #f)

(defun sewer-valve-activate! ((aid uint))
  (when (mp-session-in-game?)
    (dotimes (index 3)
      (when (= aid (sewer-valve-aid (+ index 1)))
        (let ((sync-aid (+ SEWER_WATER_ID_BASE index 1)))
          (when (not (mp-aid-dead-in-perm-list? sync-aid))
            (sync-sewer-water! sync-aid 'activate)
            (mp-event-enqueue-aid! MP_EVENT_BREAK sync-aid))))))
  (none))

(set! *actor-sync-handlers* (cons sync-sewer-water! *actor-sync-handlers*))
