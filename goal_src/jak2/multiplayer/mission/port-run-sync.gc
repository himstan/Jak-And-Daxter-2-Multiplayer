;;-*-Lisp-*-
(in-package goal)

(defconstant PORT_RUN_CARGO_ID_BASE (the uint #x72000000))
(defconstant PORT_RUN_CARGO_COUNT 16)

(defun port-run-cargo-remaining ()
  (let ((remaining PORT_RUN_CARGO_COUNT))
    (dotimes (index PORT_RUN_CARGO_COUNT)
      (when (mp-aid-dead-in-perm-list? (+ PORT_RUN_CARGO_ID_BASE index))
        (-! remaining 1)))
    remaining))

(defun port-run-complete! ()
  (when (and (mp-session-host?) (nonnull? *game-info* (-> *game-info* sub-task-list))
             (zero? (port-run-cargo-remaining))
             (not (task-node-closed? (game-task-node city-port-run-resolution))))
    (let ((node (-> *game-info* sub-task-list (game-task-node city-port-run-resolution))))
      (task-node-close! (game-task-node city-port-run-resolution))
      (when (or (not (nonnull? node (-> node info)))
                (not (nonnull? (handle->process-safe (-> node info manager)))))
        (task-node-close! (game-task-node city-port-run-post-win)))))
  (none))

(defun sync-port-run-cargo! ((aid uint) (message symbol))
  (when (and (>= aid PORT_RUN_CARGO_ID_BASE) (< aid (+ PORT_RUN_CARGO_ID_BASE PORT_RUN_CARGO_COUNT)))
    (when (= message 'synchronized?)
      (return (mp-aid-dead-in-perm-list? aid)))
    (mp-record-aid-dead-in-perm-list! aid)
    (port-run-complete!)
    (return #t))
  #f)

(defbehavior port-run-report-cargo-destroyed! process ()
  (when (or (not (mp-session-in-game?)) *mp-processing-remote-event* (not (nonnull? self)))
    (return (the-as none 0)))
  (let ((parent (ppointer->process (-> self parent))))
    (when (or (not (nonnull? parent)) (not (type? parent task-manager)))
      (return (the-as none 0)))
    (let ((task (the-as task-manager parent)))
      (when (or (not (nonnull? task (-> task node-info))) (!= (-> task node-info task) (game-task city-port-run)))
        (return (the-as none 0)))
      (dotimes (index PORT_RUN_CARGO_COUNT)
        (let ((aid (+ PORT_RUN_CARGO_ID_BASE index)))
          (when (and (= self (handle->process-safe (-> task slave index))) (not (mp-aid-dead-in-perm-list? aid)))
            (sync-port-run-cargo! aid 'break)
            (mp-event-enqueue-aid! MP_EVENT_BREAK aid))))))
  (none))

(defbehavior port-run-reconcile-cargo! task-manager ()
  (when (and (mp-session-in-game?) (nonnull? self))
    (dotimes (index PORT_RUN_CARGO_COUNT)
      (let ((destroyed? (mp-aid-dead-in-perm-list? (+ PORT_RUN_CARGO_ID_BASE index))))
        (set! (-> self data-int32 index) (if destroyed? 1 0))
        (when destroyed?
          (let ((proc (handle->process-safe (-> self slave index))))
            (when (nonnull? proc)
              (send-event proc 'attack)))
          (set! (-> self slave index) (the-as handle #f)))))
    (set! (-> self count) (port-run-cargo-remaining)))
  (none))

(set! *actor-sync-handlers* (cons sync-port-run-cargo! *actor-sync-handlers*))
