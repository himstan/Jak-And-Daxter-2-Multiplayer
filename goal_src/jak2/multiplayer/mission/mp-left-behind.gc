;;-*-Lisp-*-
(in-package goal)

(defconstant LEFT_BEHIND_DISTANCE (meters 150.0))

(define-perm *left-behind-start-time* time-frame 0)

(defun left-behind-draw-countdown! ((elapsed time-frame))
  (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 32 320 0.0 (font-color default) (font-flags shadow kerning))))
    (set-width! font-ctx 350)
    (set-height! font-ctx 80)
    (set-scale! font-ctx 0.5)
    (set! (-> font-ctx flags) (font-flags shadow kerning large))
    (clear *temp-string*)
    (format *temp-string* (lookup-text! *common-text* (text-id left-behind-teleport-countdown) #f) (- 3 (/ (the int elapsed) 300)))
    (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress)))
  (none))

(defun vehicle-carries-local-bot? ((veh vehicle))
  (dotimes (seat (-> veh info seat-count))
    (let ((rider (get-rider-in-seat veh seat)))
      (if (and (nonnull? rider) (type? rider bot) (mp-enemy-authoritative? (the-as enemy rider)))
          (return #t))))
  #f)

(defun left-behind-bot-driver ()
  (let ((driver (the-as mp-player-record #f))
        (best-distance (meters 1000000.0)))
    (mp-for-each-player-record (player-slot record)
      (let ((veh (record-driven-vehicle record)))
        (when (and (is-record-remote-player? record)
                   (nonnull? veh (-> veh info) (-> veh root))
                   (vehicle-carries-local-bot? veh))
          (let ((distance (vector-vector-distance (target-pos 0) (-> veh root trans))))
            (when (< distance best-distance)
              (set! driver record)
              (set! best-distance distance))))))
    (if (< LEFT_BEHIND_DISTANCE best-distance)
        driver
        (the-as mp-player-record #f))))

(defun left-behind-teleport-tick! ()
  (let ((driver (left-behind-bot-driver)))
    (cond
      ((and (nonnull? driver *target* (-> *target* control))
            (mp-session-in-game?)
            (not (focus-test? *target* dead teleporting)))
       (if (zero? *left-behind-start-time*)
           (set! *left-behind-start-time* (current-time)))
       (let ((elapsed (- (current-time) *left-behind-start-time*)))
         (cond
           ((>= elapsed (seconds 3))
            (set! *left-behind-start-time* (the-as time-frame 0))
            (mp-teleport-local-target-to-player! driver #f))
           (else
            (left-behind-draw-countdown! elapsed)))))
      (else
       (set! *left-behind-start-time* (the-as time-frame 0)))))
  (none))
