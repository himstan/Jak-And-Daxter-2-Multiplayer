;;-*-Lisp-*-
(in-package goal)

(define *drill-ship-sent-mask* (the-as uint 0))
(define *drill-ship-sent-signature* (the-as uint 0))
(define *drill-ship-sent-released* (the-as uint 0))
(define *drill-ship-sent-time* (the-as time-frame 0))
(define *drill-ship-applied-shot* (the-as uint #xffff))
(define *drill-ship-applied-serial* (the-as uint 0))
(define *drill-ship-outgoing* (new 'static 'drill-ship-state-data))
(define *drill-ship-anchor* (new 'static 'vector))

(defun drill-ship-authority? ()
  (not (mp-session-client?)))

(defun drill-ship-pass-list ((pass int))
  (if (= pass 1) *ship-turrets-first-pass* *ship-turrets-second-pass*))

(defun drill-ship-turret-index ((info barons-ship-turret-info))
  (dotimes (index (-> *barons-ship-turrets* length))
    (if (= (-> *barons-ship-turrets* index) info)
        (return index)))
  -1)

(defun drill-ship-turret-process ((ship drill-barons-ship) (info barons-ship-turret-info))
  (let ((child (-> ship child)))
    (while child
      (let ((proc (ppointer->process child)))
        (when (and (type? proc drill-barons-ship-turret) (= (-> (the-as drill-barons-ship-turret proc) info) info))
          (return (the-as process proc)))
        (set! child (-> proc brother)))))
  (the-as process #f))

(defun drill-ship-alive-mask ()
  (let ((mask (the-as uint 0)))
    (dotimes (index (-> *barons-ship-turrets* length))
      (if (-> *barons-ship-turrets* index alive)
          (logior! mask (ash 1 index))))
    mask))

(defun drill-ship-anchor ((ship drill-barons-ship))
  (cond
    ((and (mp-session-in-game?) (drill-rail-anchor (if (<= (-> ship pass) 1) 1 2) *drill-ship-anchor*))
     *drill-ship-anchor*)
    (*target*
     (-> *target* control trans))
    (else
     (the-as vector #f))))

(defun drill-ship-complete! ()
  (if (drill-ship-authority?)
      (task-node-close! (game-task-node drill-ship-resolution)))
  (set-continue! *game-info* "drillmid-ship-warp" #f)
  (talker-spawn-func (-> *talker-speech* 102) *entity-pool* (target-pos 0) (the-as region #f))
  (none))

(defbehavior drill-ship-send-state! drill-barons-ship ()
  (let ((state *drill-ship-outgoing*)
        (info (-> *barons-ship-turrets* (-> (drill-ship-pass-list (-> self pass)) (-> self next-to-shoot-idx)))))
    (set! (-> state alive-mask) (drill-ship-alive-mask))
    (set! (-> state pass) (the uint8 (-> self pass)))
    (set! (-> state shot-index) (the uint8 (-> self next-to-shoot-idx)))
    (set! (-> state flags) (the uint8 (logior (if (= (-> self next-state name) 'hidden) DRILL_SHIP_FLAG_HIDDEN 0)
                                              (if (-> info next-to-shoot) DRILL_SHIP_FLAG_SHOOTING 0))))
    (dotimes (rail 3)
      (set! (-> state rail-front rail) (the uint (* 65535.0 (-> *drill-rail-front* rail)))))
    (set! (-> state battle-remaining) (the uint8 (drill-battle-remaining)))
    (dotimes (rail 3)
      (set! (-> state rail-released rail) (the uint8 (drill-rail-released-count rail))))
    (let ((released (logior (-> state rail-released 0) (ash (-> state rail-released 1) 8) (ash (-> state rail-released 2) 16)))
          (signature (logior (-> state flags)
                             (ash (-> state pass) 8)
                             (ash (-> state shot-index) 16)
                             (ash (-> state battle-remaining) 24))))
      (when (or (!= (-> state alive-mask) *drill-ship-sent-mask*)
                (!= signature *drill-ship-sent-signature*)
                (!= released *drill-ship-sent-released*)
                (time-elapsed? *drill-ship-sent-time* (seconds 2)))
        (set! *drill-ship-sent-mask* (-> state alive-mask))
        (set! *drill-ship-sent-signature* signature)
        (set! *drill-ship-sent-released* released)
        (set! *drill-ship-sent-time* (current-time))
        (let ((event (new 'stack-no-clear 'drill-ship-state-event)))
          (when (mp-event-prepare! event MP_EVENT_DRILL_SHIP_STATE)
            (mem-copy! (the-as pointer (-> event payload)) (the-as pointer state) (size-of drill-ship-state-data))
            (mp-event-enqueue! event))))))
  (none))

(defun drill-rail-apply-host-state! ((state drill-ship-state-data))
  (dotimes (rail 3)
    (set! (-> *drill-rail-front* rail)
          (fmax (-> *drill-rail-front* rail) (/ (the float (-> state rail-front rail)) 65535.0))))
  (when (!= (-> state battle-remaining) #xff)
    (send-event (drill-battle-manager) 'mp-battle-state (-> state battle-remaining)))
  (none))

(defbehavior drill-ship-apply-host-state! drill-barons-ship ((state drill-ship-state-data))
  (let ((mask (-> state alive-mask))
        (pass (the int (-> state pass)))
        (shot-index (the int (-> state shot-index)))
        (flags (-> state flags)))
    (dotimes (index (-> *barons-ship-turrets* length))
      (let ((info (-> *barons-ship-turrets* index))
            (alive? (logtest? mask (ash 1 index))))
        (when (and (-> info alive) (not alive?))
          (send-event (drill-ship-turret-process self info) 'mp-kill))
        (set! (-> info alive) alive?)))
    (set! (-> self next-to-shoot-idx) shot-index)
    (let ((shot (the-as uint (logior shot-index (ash (logand flags DRILL_SHIP_FLAG_SHOOTING) 8)))))
      (when (!= shot *drill-ship-applied-shot*)
        (set! *drill-ship-applied-shot* shot)
        (let ((info (-> *barons-ship-turrets* (-> (drill-ship-pass-list pass) shot-index))))
          (set! (-> info next-to-shoot) (the-as basic (and (-> info alive) (logtest? flags DRILL_SHIP_FLAG_SHOOTING)))))))
    (let ((hidden? (logtest? flags DRILL_SHIP_FLAG_HIDDEN))
          (now-hidden? (= (-> self next-state name) 'hidden)))
      (cond
        ((and hidden? (not now-hidden?))
         (set! (-> self pass) pass)
         (go-virtual hidden))
        ((and (not hidden?) now-hidden?)
         (set! (-> self pass) (+ pass -1))
         (go-virtual idle))
        (else
         (set! (-> self pass) pass)))))
  (none))

(defbehavior drill-ship-sync! drill-barons-ship ()
  (cond
    ((not (mp-session-in-game?)))
    ((mp-session-host?)
     (drill-ship-send-state!))
    ((!= *drill-host-state-serial* *drill-ship-applied-serial*)
     (set! *drill-ship-applied-serial* *drill-host-state-serial*)
     (drill-rail-apply-host-state! *drill-host-state*)
     (drill-ship-apply-host-state! *drill-host-state*)))
  (none))

(defbehavior drill-ship-follow-host! drill-barons-ship ()
  (let* ((info (-> *barons-ship-turrets* (-> (drill-ship-pass-list (-> self pass)) (-> self next-to-shoot-idx))))
         (dest (+ (if (= (-> self pass) 1) 0.0 40960.0) (-> info ship-y-offset))))
    (set! (-> self current-y-position)
          (lerp (-> self current-y-position) dest (fmin 1.0 (* 4.0 (seconds-per-frame))))))
  (none))

(defbehavior drill-ship-turret-explode! drill-barons-ship-turret ()
  (set! (-> self info alive) #f)
  (set! (-> self info next-to-shoot) #f)
  (let ((pos (new 'stack-no-clear 'vector)))
    (set! (-> pos quad) (-> self root trans quad))
    (+! (-> pos z) 81920.0)
    (part-tracker-spawn :to *entity-pool* :group group-drill-barons-ship-explosion :mat-joint pos))
  (sound-play "shp-turret-xplo")
  (setup-masks (-> self draw) 0 1)
  (cond
    ((= (-> self info mesh) 1)
     (process-spawn part-tracker :init part-tracker-init group-turret-smoke-trail-side 0 #f #f self 3 :to self))
    ((= (-> self info mesh) 2)
     (process-spawn part-tracker :init part-tracker-init group-turret-smoke-trail-down 0 #f #f self 3 :to self))
    (else
     (process-spawn part-tracker :init part-tracker-init group-turret-smoke-trail 0 #f #f self 3 :to self)))
  (sound-play "ship-veer")
  (set! (-> (the-as drill-barons-ship (-> self parent 0)) rock-angle) 180.0)
  (none))

(defbehavior drill-ship-turret-hit! drill-barons-ship-turret ()
  (+! (-> self hit-count) 1)
  (cond
    ((!= (-> self hit-count) 20)
     (sound-play "ship-gun-hit"))
    (else
     (drill-ship-turret-explode!)
     (go-virtual dead)))
  (none))

(defbehavior drill-ship-turret-shot! drill-barons-ship-turret ((attacker process))
  (cond
    ((not (mp-session-in-game?))
     (drill-ship-turret-hit!))
    ((not (mp-is-local-attacker? attacker)))
    ((mp-session-client?)
     (sound-play "ship-gun-hit")
     (send-drill-ship-hit! (drill-ship-turret-index (-> self info))))
    (else
     (drill-ship-turret-hit!)))
  (none))

(defbehavior drill-ship-turret-sync-event drill-barons-ship-turret ((proc process) (argc int) (message symbol) (block event-message-block))
  (case message
    (('mp-hit)
     (if (-> self info alive)
         (drill-ship-turret-hit!)))
    (('mp-kill)
     (drill-ship-turret-explode!)
     (go-virtual dead))))

(defbehavior drill-ship-sync-event drill-barons-ship ((message symbol) (block event-message-block))
  (case message
    (('mp-hit)
     (let ((index (the-as int (-> block param 0))))
       (when (< index (-> *barons-ship-turrets* length))
         (send-event (drill-ship-turret-process self (-> *barons-ship-turrets* index)) 'mp-hit))))))
