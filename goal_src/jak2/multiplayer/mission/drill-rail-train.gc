;;-*-Lisp-*-
(in-package goal)

(defconstant DRILL_RAIL_SLOTS 8)
(defconstant DRILL_RAIL_CLONE_AID_BASE 60010)
(defconstant DRILL_RAIL_STOP_GAP (meters 10))
(defconstant DRILL_RAIL_SPAWN_GAP (meters 14))

(define *drill-rail-source-aids* (new 'static 'boxed-array :type uint32 19283 19284 19285))
(define *drill-rail-front* (new 'static 'array float 3))
(define *drill-rail-segments* (new 'static 'array float 3))
(define *drill-rail-released* (new 'static 'array uint8 3))
(define *drill-rail-manager-pid* 0)

(defun drill-rail-index ((this turret))
  (let ((extra-id (res-lump-value (-> this entity) 'extra-id int :default (the-as uint128 -1) :time -1000000000.0)))
    (if (and (>= extra-id 3) (<= extra-id 5)) (+ extra-id -3) -1)))

(defun drill-rail-slot ((this turret))
  (let ((aid (-> this entity aid)))
    (if (>= aid DRILL_RAIL_CLONE_AID_BASE) (the int (mod (- aid DRILL_RAIL_CLONE_AID_BASE) 10)) 0)))

(defun drill-rail-turret ((rail int) (slot int))
  (let ((ent (entity-by-aid (if (zero? slot)
                                (-> *drill-rail-source-aids* rail)
                                (the uint (+ DRILL_RAIL_CLONE_AID_BASE (* rail 10) slot))))))
    (if (nonnull? ent (-> ent extra))
        (the-as turret (-> ent extra process))
        (the-as turret #f))))

(defun drill-rail-state? ((this turret) (name symbol))
  (and (nonnull? (-> this state)) (= (-> this state name) name)))

(defun drill-rail-riding? ((this turret))
  (and (handle->process-safe (-> this rider)) (or (drill-rail-state? this 'setup) (drill-rail-state? this 'active))))

(defun drill-rail-blocking? ((this turret))
  (or (drill-rail-state? this 'setup) (drill-rail-state? this 'active) (drill-rail-state? this 'shutdown)))

(defun drill-rail-distance ((this turret))
  (/ (* (-> this path-u) 16384.0) (-> this path-speed)))

(defun drill-rail-player-count ()
  (let ((count (if (and (nonnull? (mp-local-player-record))
                        (zero? (-> (mp-local-player-record) identity spectator-only?)))
                   1
                   0)))
    (mp-for-each-player-record (player-slot record)
      (when (mp-remote-gameplay-player-connected? record)
        (+! count 1)))
    (min count DRILL_RAIL_SLOTS)))

(defun drill-rail-open-slot ((rail int))
  (let ((riders 0)
        (nearest (meters 10000))
        (open -1))
    (dotimes (slot DRILL_RAIL_SLOTS)
      (let ((other (drill-rail-turret rail slot)))
        (when (nonnull? other)
          (cond
            ((drill-rail-riding? other)
             (+! riders 1)
             (set! nearest (fmin nearest (drill-rail-distance other))))
            ((and (< open 0) (drill-rail-state? other 'idle) (= (-> other path-u) 0.0))
             (set! open slot))))))
    (if (and (< riders (drill-rail-player-count)) (>= nearest DRILL_RAIL_SPAWN_GAP)) open -1)))

(defun drill-rail-seek-visible! ((this turret) (visible? symbol))
  (if (< (-> this rail-scale) 0.0)
      (set! (-> this rail-scale) (if (and visible? (not (mp-session-in-game?))) 1.0 0.0)))
  (seek! (-> this rail-scale) (if visible? 1.0 0.0) (* 2.0 (seconds-per-frame)))
  (let ((scale (lerp 0.025 1.0 (smooth-step (-> this rail-scale))))
        (prim (-> this root root-prim)))
    (set-vector! (-> this root scale) scale scale scale 1.0)
    (if (> (-> this rail-scale) 0.0)
        (logclear! (-> this draw status) (draw-control-status no-draw))
        (logior! (-> this draw status) (draw-control-status no-draw)))
    (set! (-> prim prim-core collide-as) (if visible? (-> this root backup-collide-as) (collide-spec)))
    (set! (-> prim prim-core collide-with) (if visible? (-> this root backup-collide-with) (collide-spec))))
  (set! (-> this available-for-pickup) (and visible? (= (-> this rail-scale) 1.0)))
  (none))

(defbehavior drill-rail-update-idle! turret ((rail int))
  (cond
    ((not (mp-session-in-game?))
     (drill-rail-seek-visible! self (zero? (drill-rail-slot self))))
    ((and (handle->process-safe (-> self rider)) (not (base-turret-local-rider? (handle->process-safe (-> self rider)))))
     (go-virtual active))
    ((> (-> self path-u) 0.0)
     (go-virtual die))
    (else
     (drill-rail-seek-visible! self (and (drill-ship-host-present?) (= (drill-rail-slot self) (drill-rail-open-slot rail))))))
  (none))

(defun drill-rail-rider-seated? ((this turret))
  (let ((rider (handle->process-safe (-> this rider))))
    (the symbol (and (nonnull? rider)
                     (type? rider target)
                     (player-using-turret? (the-as target rider))
                     (= (handle->process-safe (-> (the-as target rider) turret handle)) this)))))

(defbehavior drill-rail-update-dormant! turret ()
  (when (and (mp-session-in-game?) (>= (drill-rail-index self) 0) (not (drill-rail-rider-seated? self)))
    (drill-rail-seek-visible! self #f)
    (transform-post)
    (if (and (= (-> self rail-scale) 0.0) (not (-> self child)))
        (deactivate self)))
  (none))

(defun drill-rail-path-limit ((this turret) (rail int))
  (let ((limit 1.0)
        (gap (/ (* DRILL_RAIL_STOP_GAP (-> this path-speed)) 16384.0))
        (slot (drill-rail-slot this)))
    (dotimes (index DRILL_RAIL_SLOTS)
      (let ((other (drill-rail-turret rail index)))
        (when (and (nonnull? other)
                   (!= other this)
                   (drill-rail-blocking? other)
                   (or (> (-> other path-u) (-> this path-u-prev))
                       (and (= (-> other path-u) (-> this path-u-prev)) (< index slot))))
          (set! limit (fmin limit (- (-> other path-u) gap))))))
    (fmax (-> this path-u-prev) limit)))

(defun drill-rail-shutdown-gate! ((script pair))
  (when (and (= (car script) 'send-event) (type? (car (cdr script)) string))
    (let ((ent (entity-by-name (the-as string (car (cdr script))))))
      (when (and (nonnull? ent (-> ent extra) (-> ent extra perm)) (= (-> (the-as entity-actor ent) etype) drill-elec-gate))
        (logior! (-> ent extra perm status) (entity-perm-status subtask-complete)))))
  (none))

(defun drill-rail-sync-front! ()
  (when (nonnull? *game-info* (-> *game-info* sub-task-list))
    (let ((node (-> *game-info* sub-task-list (game-task-node drill-ship-resolution))))
      (when (nonnull? node (-> node info))
        (let ((manager (handle->process-safe (-> node info manager))))
          (when (and (nonnull? manager) (!= (-> manager pid) *drill-rail-manager-pid*))
            (when (nonzero? *drill-rail-manager-pid*)
              (dotimes (rail 3)
                (set! (-> *drill-rail-front* rail) 0.0)
                (set! (-> *drill-rail-released* rail) (the uint8 0))
                (set! (-> *drill-host-state* rail-front rail) (the uint 0))
                (set! (-> *drill-host-state* rail-released rail) (the uint8 0)))
              (set! (-> *drill-host-state* battle-remaining) (the uint8 #xff)))
            (set! *drill-rail-manager-pid* (-> manager pid)))))))
  (none))

(defun drill-rail-fire-world-event! ((this turret) (rail int) (event turret-path-event))
  (case (-> event event-type)
    (('trigger-battle)
     (dotimes (slot DRILL_RAIL_SLOTS)
       (let ((other (drill-rail-turret rail slot)))
         (when (nonnull? other)
           (set! (-> other hud-cgh-event) 'force-show))))
     (when (not (mp-session-client?))
       (send-event (handle->process (-> this hover-battle)) 'trigger)))
    (('script)
     (script-eval (the-as pair (-> event param)))
     (drill-rail-shutdown-gate! (the-as pair (-> event param))))
    (('cue-chase)
     (when (not (mp-session-client?))
       ((method-of-type base-turret base-turret-method-39) this event)))
    (else
     ((method-of-type base-turret base-turret-method-39) this event)))
  (none))

(defun drill-rail-world-event? ((event turret-path-event))
  (case (-> event event-type)
    (('script 'cue-chase 'trigger-battle) #t)
    (else #f)))

(defun drill-rail-pause-event? ((event turret-path-event))
  (case (-> event event-type)
    (('pause-until 'pause-while) #t)
    (else #f)))

(defun drill-rail-pause-count ((rail int) (pos float))
  (let ((table (drill-turret-path-table (+ rail 3)))
        (count 0))
    (when (nonnull? table)
      (dotimes (index (-> table event-count))
        (let ((event (-> table event-tbl index)))
          (when (and (nonnull? event) (drill-rail-pause-event? event) (<= (-> event pos) pos))
            (+! count 1)))))
    count))

(defun drill-rail-client-released? ((this base-turret))
  (when (nonnull? this (-> this path))
    (let* ((rail (drill-rail-index (the-as turret this)))
           (required (drill-rail-pause-count rail (* (get-num-segments (-> this path)) (-> this path-u)))))
      (when (>= (-> *drill-host-state* rail-released rail) required)
        (return #t))))
  #f)

(defun drill-battle-manager ()
  (the-as hover-enemy-manager (hover-manager-by-aid (-> *drill-rail-source-aids* 0))))

(defun drill-rail-battle-done? ()
  (if (mp-session-client?)
      (return (>= (-> *drill-host-state* rail-released 0) 2)))
  (the symbol (or (>= (-> *drill-rail-released* 0) 2)
                  (let ((manager (drill-battle-manager)))
                    (and (nonnull? manager)
                         (> (-> manager total-to-spawn) 0)
                         (>= (-> manager num-spawned) (-> manager total-to-spawn))
                         (zero? (-> manager alive-count)))))))

(defun drill-battle-remaining ()
  (if (mp-session-client?)
      (return (the int (-> *drill-host-state* battle-remaining))))
  (let ((manager (drill-battle-manager)))
    (cond
      ((drill-rail-battle-done?)
       0)
      ((nonnull? manager)
       (max 0 (+ (- (-> manager total-to-spawn) (-> manager num-spawned)) (-> manager alive-count))))
      (else
       #xff))))

(defun drill-rail-pause-cleared? ((rail int) (event turret-path-event))
  (the symbol
       (if (= (-> event event-type) 'pause-while)
           (drill-rail-battle-done?)
           (and (or (nonzero? rail) (nonnull? (entity-by-name "crimson-guard-hover-1")))
                ((the-as (function base-turret symbol) (-> event param)) (the-as base-turret (drill-rail-turret rail 0)))))))

(defun drill-rail-released-count ((rail int))
  (let ((table (drill-turret-path-table (+ rail 3)))
        (front (* (-> *drill-rail-segments* rail) (-> *drill-rail-front* rail)))
        (count 0))
    (dotimes (index (-> table event-count))
      (let ((event (-> table event-tbl index)))
        (when (drill-rail-pause-event? event)
          (+! count 1)
          (when (> count (-> *drill-rail-released* rail))
            (if (and (>= front (-> event pos)) (drill-rail-pause-cleared? rail event))
                (set! (-> *drill-rail-released* rail) (the uint8 count))
                (return (the int (-> *drill-rail-released* rail))))))))
    (the int (-> *drill-rail-released* rail))))

(defun drill-rail-wait-for-host! ((this turret) (rail int) (event turret-path-event))
  (when (nonnull? this event)
    (let ((required (drill-rail-pause-count rail (-> event pos))))
      (when (< (-> *drill-host-state* rail-released rail) required)
        (set! (-> this path-mode) (the-as uint 3))
        (set! (-> this pause-proc) drill-rail-client-released?)
        (set! (-> this path-speed-mult-final) 0.0))))
  (none))

(defun drill-rail-process-events! ((this turret) (rail int))
  (drill-rail-sync-front!)
  (let* ((table (-> this path-event))
         (segments (get-num-segments (-> this path)))
         (current (* segments (-> this path-u)))
         (previous (* segments (-> this path-u-prev)))
         (front-previous (* segments (-> *drill-rail-front* rail)))
         (front (fmax front-previous current))
         (local? (base-turret-local-rider? (handle->process-safe (-> this rider)))))
    (set! (-> *drill-rail-segments* rail) segments)
    (set! (-> *drill-rail-front* rail) (/ front segments))
    (dotimes (index (-> table event-count))
      (let ((event (-> table event-tbl index)))
        (cond
          ((drill-rail-world-event? event)
           (when (and (>= front (-> event pos)) (< front-previous (-> event pos)))
             (drill-rail-fire-world-event! this rail event)))
          ((not (and local? (>= current (-> event pos)) (< previous (-> event pos)))))
          ((and (drill-rail-pause-event? event) (mp-session-client?))
           (drill-rail-wait-for-host! this rail event))
          (else
           (base-turret-method-39 this event))))))
  (none))

(defun drill-rail-apply-event! ((rail int) (event turret-path-event))
  (dotimes (slot DRILL_RAIL_SLOTS)
    (let ((other (drill-rail-turret rail slot)))
      (when (nonnull? other)
        (base-turret-method-39 other event))))
  (none))

(defun drill-rail-anchor ((rail int) (anchor vector))
  (let ((riders 0))
    (vector-reset! anchor)
    (dotimes (slot DRILL_RAIL_SLOTS)
      (let ((other (drill-rail-turret rail slot)))
        (when (and (nonnull? other) (drill-rail-riding? other))
          (vector+! anchor anchor (-> other root trans))
          (+! riders 1))))
    (when (> riders 0)
      (vector-float*! anchor anchor (/ 1.0 (the float riders)))
      (return #t)))
  #f)
