;;-*-Lisp-*-
(in-package goal)

(define *onin-game-scores* (new 'static 'array int32 MP_MAX_PLAYERS))

(defun onin-game-reset-scores! ()
  (dotimes (player-slot MP_MAX_PLAYERS)
    (set! (-> *onin-game-scores* player-slot) -1))
  (none))

(onin-game-reset-scores!)

(defun onin-game-remote-score ((player-slot uint))
  (if (= player-slot (mp-local-player-slot))
    -1
    (the int (-> *onin-game-scores* player-slot))))

(defun onin-game-send-score! ((score int))
  (let ((player-slot (mp-local-player-slot))
        (event (new 'stack-no-clear 'onin-game-score-event)))
    (when (and (mp-session-in-game?)
               (mp-player-slot-valid? player-slot)
               (!= score (-> *onin-game-scores* player-slot))
               (mp-event-prepare! event MP_EVENT_ONIN_GAME_SCORE))
      (set! (-> *onin-game-scores* player-slot) score)
      (set! (-> event payload) (the uint16 (min score #xffff)))
      (mp-event-enqueue! event)))
  (none))

(defun onin-game-mission-open? ()
  (and (mp-session-in-game?)
       (not (task-node-closed? (game-task-node city-play-onin-game-resolution)))))

(defun onin-game-penalize ((score float))
  (if (onin-game-mission-open?)
    (fmax 0.0 (- score 25.0))
    score))

(defun onin-game-remote-won? ((point-win float))
  (when (onin-game-mission-open?)
    (dotimes (player-slot MP_MAX_PLAYERS)
      (when (>= (the float (onin-game-remote-score (the uint player-slot))) point-win)
        (return #t))))
  #f)

(defun receive-onin-game-score! ((event onin-game-score-event))
  (when (and (nonnull? event) (mp-player-slot-valid? (-> event source-player-slot)))
    (set! (-> *onin-game-scores* (-> event source-player-slot)) (the int (-> event payload))))
  (none))

(defun onin-game-leader ()
  (let ((leader (the uint MP_INVALID_PLAYER_SLOT))
        (best-score -1))
    (dotimes (player-slot MP_MAX_PLAYERS)
      (when (> (-> *onin-game-scores* player-slot) best-score)
        (set! best-score (the int (-> *onin-game-scores* player-slot)))
        (set! leader (the uint player-slot))))
    leader))

(defun onin-game-after-scene-end! ((scene-name string))
  (when (and (nonnull? scene-name) (string= scene-name "city-play-onin-game-res"))
    (let ((leader (onin-game-leader)))
      (when (mp-player-slot-valid? leader)
        (notify-player! leader (text-id stadium-player-won))))
    (onin-game-reset-scores!))
  (none))
