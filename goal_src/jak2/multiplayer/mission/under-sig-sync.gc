(in-package goal)

(define *under-sig-puzzle-aids*
  (new 'static 'boxed-array :type uint32 26035 26037 26038))

(defun send-under-block! ((aid uint) (spawner int) (col int) (row int) (dir-x int) (dir-z int))
  (let ((event (new 'stack-no-clear 'under-block-event)))
    (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_UNDER_BLOCK))
      (set! (-> event payload aid) aid)
      (set! (-> event payload spawner) spawner)
      (set! (-> event payload col) col)
      (set! (-> event payload row) row)
      (set! (-> event payload dir-x) dir-x)
      (set! (-> event payload dir-z) dir-z)
      (mp-event-enqueue! event)))
  (none))

(defun under-block-remote-message ((data under-block-event-data))
  (if (and (zero? (-> data dir-x)) (zero? (-> data dir-z)))
      'mp-explode
      'mp-move))

(defun receive-under-block! ((event under-block-event))
  (when (nonnull? event *level*)
    (let* ((data (-> event payload))
           (ent (entity-by-aid (-> data aid))))
      (when (nonnull? ent (-> ent extra) (-> ent extra process))
        (cond
          ((mp-session-host?)
           (send-event (-> ent extra process) 'mp-block data 'mp-move-request))
          ((= (-> event source-player-slot) (mp-host-player-slot))
           (send-event (-> ent extra process) 'mp-block data (under-block-remote-message data)))))))
  (none))

(defun send-under-sig-task! ((bit int))
  (let ((event (new 'stack-no-clear 'under-sig-task-event)))
    (when (and (nonnull? event) (!= bit 2) (mp-event-prepare! event MP_EVENT_UNDER_SIG_TASK))
      (set! (-> event payload) (the uint8 bit))
      (mp-event-enqueue! event)))
  (none))

(defun receive-under-sig-task! ((event under-sig-task-event))
  (when (and (nonnull? event)
             (or (mp-session-host?) (= (-> event source-player-slot) (mp-host-player-slot))))
    (let ((sig (process-by-ename "sig-under-1")))
      (when (nonnull? sig)
        (send-event sig 'set-task (* 8 (the int (-> event payload))))))
    (when (mp-session-host?)
      (send-under-sig-task! (the int (-> event payload)))))
  (none))

(defun under-sig-players-placed? ()
  (when (not (player-scene-placements-ready?))
    (return #f))
  (mp-for-each-player-target (player-slot record player)
    (when (and (player-target-alive? player) (player-scene-placement-active? player))
      (return #f)))
  #t)

(defun sync-under-sig-puzzle! ((aid uint) (message symbol))
  (unless (aid-listed? aid *under-sig-puzzle-aids*)
    (return #f))
  (let* ((perm (aid-perm aid #t))
         (solved? (and (nonnull? perm) (logtest? (-> perm status) (entity-perm-status subtask-complete)))))
    (when (= message 'synchronized?)
      (return (the symbol solved?)))
    (when (and (nonnull? perm) (not solved?))
      (set! (-> perm task) (game-task under-sig))
      (logior! (-> perm status) (entity-perm-status subtask-complete))
      (let ((ent (if (nonnull? *level*) (entity-by-aid aid) (the-as entity #f))))
        (when (nonnull? ent (-> ent extra) (-> ent extra process))
          (send-event (-> ent extra process) 'mp-solved)))))
  #t)

(set! *actor-sync-handlers* (cons sync-under-sig-puzzle! *actor-sync-handlers*))
