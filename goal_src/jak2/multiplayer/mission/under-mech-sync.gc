(in-package goal)

(defun deep-swim? ()
  (the symbol (and (mp-session-in-game?)
                   (task-node-open? (game-task-node under-mech-resolution))
                   (nonnull? *level*)
                   (= (level-status *level* 'underb) 'active))))

(defun in-under-depths? ((player target))
  (and (nonnull? player (-> player control)) (< (-> player control trans y) (meters -30))))

(defun under-lift-process ()
  (let ((ent (if (nonnull? *level*) (entity-by-aid (the uint 30873)) (the-as entity #f))))
    (if (nonnull? ent (-> ent extra) (-> ent extra process) (-> ent extra process next-state))
        (-> ent extra process)
        (the-as process #f))))

(defun under-lift-carrying? ((player target))
  (let ((lift (the-as elevator (under-lift-process))))
    (and (nonnull? lift)
         (= (-> lift next-state name) 'running)
         (is-standing-on-elevator? lift player))))

(defun under-lift-contains? ((lift process-drawable) (point vector))
  (let ((offset (vector-! (new 'stack-no-clear 'vector) point (-> lift root trans))))
    (vector-inv-orient-by-quat! offset offset (-> lift root quat))
    (and (< (fabs (-> offset x)) 20480.0) (< 0.0 (-> offset z)) (< (-> offset z) 40960.0))))

(defun under-lift-player-pending? ((record mp-player-record) (lift process-drawable))
  (let ((target-record (get-player-target-record record)))
    (the symbol
      (and (mp-remote-gameplay-player-connected? record)
           (= (-> record connection activity) (mp-player-activity in-game))
           (not (mp-player-record-dead-or-dying? record))
           (nonnull? target-record)
           (-> target-record active?)
           (> (-> target-record trans y) (- (-> lift root trans y) (meters 2)))
           (not (under-lift-contains? lift (-> target-record trans)))))))

(defun under-lift-awaiting-players? ((lift elevator))
  (when (and (mp-session-in-game?)
             (= (the-as process lift) (under-lift-process))
             (= (-> lift move-pos 1) (-> lift bottom-top 1))
             (task-node-open? (game-task-node under-mech-resolution))
             (not (nonnull? (mech-pilot))))
    (mp-for-each-player-record (player-slot record)
      (when (under-lift-player-pending? record lift)
        (return #t))))
  #f)

(defun draw-under-lift-waiting-text! ((lift process-drawable))
  (when (nonnull? *temp-string*)
    (let ((font-ctx (new 'stack 'font-context *font-default-matrix* 32 320 0.0 (font-color default) (font-flags shadow kerning))))
      (set-width! font-ctx 420)
      (set-height! font-ctx 80)
      (set-scale! font-ctx 0.5)
      (set! (-> font-ctx flags) (font-flags shadow kerning large))
      (format-waiting-players-text! *temp-string*
                                    (the-as (function mp-player-record object symbol) under-lift-player-pending?)
                                    lift)
      (print-game-text *temp-string* font-ctx #f 44 (bucket-id progress))))
  (none))

(defun under-replica-may-swim? ((player target))
  (or (not (player-replica? player))
      (let ((record (mp-player-controller-target-record *mp-player-controller* player)))
        (and (nonnull? record)
             (player-replica-swim-state? (mp-target-get-state-from-id (-> record action target-state-id)))))))

(defun under-swimmer? ((proc process))
  (the symbol
    (and (deep-swim?) (nonnull? proc) (type? proc target)
         (in-under-depths? (the-as target proc))
         (not (player-scene-placement-active? (the-as target proc)))
         (not (focus-test? (the-as target proc) mech))
         (not (mp-target-ride-along? (the-as target proc)))
         (not (under-lift-carrying? (the-as target proc)))
         (under-replica-may-swim? (the-as target proc)))))

(defun free-swimming? ((proc process))
  (the symbol
    (and (nonnull? proc) (under-swimmer? proc)
         (let ((water (-> (the-as target proc) water)))
           (and (nonnull? water)
                (logtest? (-> water flags) (water-flags active))
                (logtest? (-> water flags) (water-flags head-under-water)))))))

(defun limit-under-swim-height! ((player target))
  (when (and (free-swimming? player) (not-player-replica? player)
             (nonnull? player (-> player control)))
    (let ((control (-> player control))
          (ceiling (- (meters -33) (meters 2))))
      (when (> (-> control trans y) ceiling)
        (set! (-> control trans y) ceiling)
        (set! (-> control transv y) (fmin 0.0 (-> control transv y))))))
  (none))

(defun under-breath-target ()
  (if (and (mp-session-in-game?) (nonnull? *target*) (mp-target-ride-along? *target*))
      (get-attached-jak-proc *target*)
      *target*))

(defun under-player-submerged? ()
  (let ((player (under-breath-target)))
    (the symbol (and (nonnull? player (-> player water))
                     (or (not (mp-session-in-game?))
                         (and (deep-swim?) (in-under-depths? player) (not (player-scene-placement-active? player))))
                     (logtest? (-> player water flags) (water-flags under-water))))))

(define *under-mech-aids*
  (new 'static 'boxed-array :type uint32 32216 32217 32218 32219 32909 32912 32915 32918))

(defun under-mech-actor? ((aid uint))
  (aid-listed? aid *under-mech-aids*))

(defun reset-under-mech-actors! ()
  (when (and (mp-session-in-game?) (task-node-open? (game-task-node under-mech-resolution)))
    (dotimes (index (-> *under-mech-aids* length))
      (let ((perm (aid-perm (-> *under-mech-aids* index) #f)))
        (when (nonnull? perm)
          (set! (-> perm task) (game-task none))
          (logclear! (-> perm status) (entity-perm-status subtask-complete))))))
  (none))

(defun under-actor-released? ((aid uint))
  (let ((perm (aid-perm aid #f)))
    (the symbol (and (nonnull? perm) (logtest? (-> perm status) (entity-perm-status subtask-complete))))))

(defun report-under-actor-released! ((actor process-drawable))
  (when (and (mp-session-in-game?) (nonnull? actor (-> actor entity)))
    (let ((aid (-> actor entity aid)))
      (when (and (under-mech-actor? aid) (not (under-actor-released? aid)))
        (mark-aid-complete! aid (entity-perm-status subtask-complete))
        (mp-event-enqueue-aid! MP_EVENT_BREAK aid))))
  (none))

(defun sync-under-mech-actor! ((aid uint) (message symbol))
  (unless (under-mech-actor? aid)
    (return #f))
  (when (= message 'synchronized?)
    (return (under-actor-released? aid)))
  (unless (under-actor-released? aid)
    (mark-aid-complete! aid (entity-perm-status subtask-complete))
    (let ((ent (if (nonnull? *level*) (entity-by-aid aid) (the-as entity #f))))
      (when (nonnull? ent (-> ent extra) (-> ent extra process))
        (send-event (-> ent extra process) 'trigger))))
  #t)

(set! *actor-sync-handlers* (cons sync-under-mech-actor! *actor-sync-handlers*))
