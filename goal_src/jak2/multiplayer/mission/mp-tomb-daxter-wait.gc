;;-*-Lisp-*-
(in-package goal)

(defconstant MP_TOMB_DAXTER_WAIT_NPC_NAME "daxter-npc-2")
(defconstant MP_TOMB_DAXTER_WAIT_MOVE_THRESHOLD (meters 0.01))

(define *mp-tomb-daxter-wait-zone*
  (new 'static 'bounding-box
    :min (static-vectorm 176.0 -72.0 1392.0)
    :max (static-vectorm 207.0 -72.0 1400.0)
    )
  )

(define-perm *mp-tomb-daxter-wait-state* symbol 'inactive)
(define-perm *mp-tomb-daxter-wait-position* vector (new 'global 'vector))
(define-perm *mp-tomb-daxter-wait-position-valid?* symbol #f)
(define-perm *mp-tomb-daxter-wait-player-id* uint MP_INVALID_PLAYER_ID)

(defun mp-tomb-daxter-wait-npc ()
  (let ((proc (process-by-ename MP_TOMB_DAXTER_WAIT_NPC_NAME)))
    (if (and proc (nonzero? proc))
        (the-as process-taskable proc)
        (the-as process-taskable #f)
        )
    )
  )

(defun daxter-npc-set-draw! ((proc process-taskable) (hidden? symbol))
  (when (and proc (nonzero? proc) (-> proc draw) (nonzero? (-> proc draw)))
    (send-event proc (if hidden? 'hide 'show))
    )
  (none)
  )

(defun mp-tomb-daxter-wait-set-draw! ((proc process-drawable) (hidden? symbol))
  (when (and proc (nonzero? proc) (-> proc draw) (nonzero? (-> proc draw)))
    (if hidden?
        (logior! (-> proc draw status) (draw-control-status no-draw no-draw-bounds))
        (logclear! (-> proc draw status) (draw-control-status no-draw no-draw-bounds))
        )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-place! ((npc process-taskable) (position vector))
  (when (and npc
             (nonzero? npc)
             (-> npc root)
             (nonzero? (-> npc root))
             position
             (nonzero? position))
    (vector-copy! (-> npc root trans) position)
    (set! (-> npc root transv quad) (the-as uint128 0))
    (when (type? (-> npc root) collide-shape)
      (update-transforms (the-as collide-shape (-> npc root)))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-disable-collision! ((npc process-taskable))
  (when (and npc
             (nonzero? npc)
             (-> npc root)
             (nonzero? (-> npc root))
             (type? (-> npc root) collide-shape))
    (let ((root (the-as collide-shape (-> npc root))))
      (set-collide-as! root (collide-spec))
      (set-collide-with! root (collide-spec))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-local-ready? ()
  (and *multi-sync-enabled?*
       (mp-local-player-daxter?)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (movie?))
       *level*
       (nonzero? *level*)
       (not (load-in-progress? *level*))
       (not (logtest? (focus-status dead teleporting) (-> *target* focus-status)))
       )
  )

(defun mp-tomb-daxter-wait-inside-zone? ()
  (and (mp-tomb-daxter-wait-local-ready?)
       (logtest? (-> *target* control status) (collide-status on-ground))
       *mp-tomb-daxter-wait-zone*
       (nonzero? *mp-tomb-daxter-wait-zone*)
       (inside-xz? *mp-tomb-daxter-wait-zone* (-> *target* control trans))
       )
  )

(defun mp-tomb-daxter-wait-moved-since-start? ()
  (and *mp-tomb-daxter-wait-position-valid?*
       *mp-tomb-daxter-wait-position*
       (nonzero? *mp-tomb-daxter-wait-position*)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (or (> (vector-vector-distance (-> *target* control trans)
                                      *mp-tomb-daxter-wait-position*)
              MP_TOMB_DAXTER_WAIT_MOVE_THRESHOLD)
           (and (-> *target* root)
                (nonzero? (-> *target* root))
                (> (vector-vector-distance (-> *target* root trans)
                                           *mp-tomb-daxter-wait-position*)
                   MP_TOMB_DAXTER_WAIT_MOVE_THRESHOLD)))
       )
  )

(defun mp-tomb-daxter-wait-prompt! ()
  (when (can-display-query? *target* (the-as string #f) -99.0)
    (let ((font (new 'stack 'font-context *font-default-matrix* 32 280 0.0
                     (font-color default) (font-flags shadow kerning))))
      (set! (-> font width) 340.0)
      (set! (-> font height) 80.0)
      (set! (-> font scale) 0.9)
      (set! (-> font flags) (font-flags shadow kerning middle-vert large))
      (print-game-text
        (lookup-text! *common-text* (text-id press-triangle-to-wait-for-jak) #f)
        font
        #f
        44
        (bucket-id progress))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-apply-local! ((npc process-taskable))
  (when *mp-tomb-daxter-wait-position-valid?*
    (mp-tomb-daxter-wait-place! npc *mp-tomb-daxter-wait-position*)
    (daxter-npc-set-draw! npc #f)
    )
  (when (and *target* (nonzero? *target*))
    (mp-tomb-daxter-wait-set-draw! (the-as process-drawable *target*) #t)
    )
  (none)
  )

(defun mp-tomb-daxter-wait-apply-remote! ((npc process-taskable))
  (let ((remote-target (mp-player-target-by-id *mp-tomb-daxter-wait-player-id*)))
    (when (and (not *mp-tomb-daxter-wait-position-valid?*)
               remote-target
               (nonzero? remote-target)
               (-> remote-target root)
               (nonzero? (-> remote-target root)))
      (vector-copy! *mp-tomb-daxter-wait-position* (-> remote-target root trans))
      (set! *mp-tomb-daxter-wait-position-valid?* #t))
    (when *mp-tomb-daxter-wait-position-valid?*
      (mp-tomb-daxter-wait-place! npc *mp-tomb-daxter-wait-position*)
      (daxter-npc-set-draw! npc #f))
    (when (and remote-target (nonzero? remote-target))
      (mp-tomb-daxter-wait-set-draw! (the-as process-drawable remote-target) #t)))
  (none)
  )

(defun mp-tomb-daxter-wait-start-local! ((npc process-taskable))
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control)))
    (vector-copy! *mp-tomb-daxter-wait-position* (-> *target* control trans))
    (set! *mp-tomb-daxter-wait-position-valid?* #t)
    )
  (set! *mp-tomb-daxter-wait-state* 'local-waiting)
  (set! *mp-tomb-daxter-wait-player-id* (mp-local-player-id))
  (mp-tomb-daxter-wait-apply-local! npc)
  (when (and *multi-sync-enabled?* (not *mp-processing-remote-event*))
    (mp-event-enqueue-actor-name!
      MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START MP_TOMB_DAXTER_WAIT_NPC_NAME)
    )
  (none)
  )

(defun mp-tomb-daxter-wait-end-local! ((npc process-taskable))
  (set! *mp-tomb-daxter-wait-state* 'inactive)
  (set! *mp-tomb-daxter-wait-position-valid?* #f)
  (daxter-npc-set-draw! npc #t)
  (when (and *target* (nonzero? *target*))
    (mp-tomb-daxter-wait-set-draw! (the-as process-drawable *target*) #f)
    )
  (when (and *multi-sync-enabled?* (not *mp-processing-remote-event*))
      (mp-event-enqueue-actor-name!
        MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END MP_TOMB_DAXTER_WAIT_NPC_NAME)
    )
  (none)
  )

(defun mp-tomb-daxter-wait-receive-start! ((source-player-id uint))
  (set! *mp-tomb-daxter-wait-position-valid?* #f)
  (set! *mp-tomb-daxter-wait-state* 'remote-waiting)
  (set! *mp-tomb-daxter-wait-player-id* source-player-id)
  (let ((npc (mp-tomb-daxter-wait-npc)))
    (when npc
      (mp-tomb-daxter-wait-apply-remote! npc)
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-receive-end! ()
  (set! *mp-tomb-daxter-wait-state* 'inactive)
  (set! *mp-tomb-daxter-wait-position-valid?* #f)
  (let ((npc (mp-tomb-daxter-wait-npc)))
    (daxter-npc-set-draw! npc #t)
    )
  (let ((remote-target (mp-player-target-by-id *mp-tomb-daxter-wait-player-id*)))
    (when (and remote-target (nonzero? remote-target))
      (mp-tomb-daxter-wait-set-draw! (the-as process-drawable remote-target) #f)))
  (set! *mp-tomb-daxter-wait-player-id* MP_INVALID_PLAYER_ID)
  (none)
  )

(defun mp-tomb-daxter-wait-reset! ()
  (set! *mp-tomb-daxter-wait-state* 'inactive)
  (set! *mp-tomb-daxter-wait-position-valid?* #f)
  (set! *mp-tomb-daxter-wait-player-id* MP_INVALID_PLAYER_ID)
  (let ((npc (mp-tomb-daxter-wait-npc)))
    (daxter-npc-set-draw! npc #t)
    (mp-tomb-daxter-wait-disable-collision! npc)
    )
  (if (mp-local-player-jak?)
      (mp-for-each-player-target (player-id record remote-target)
        (when (mp-target-daxter? remote-target)
          (mp-tomb-daxter-wait-set-draw!
            (the-as process-drawable remote-target) #f)))
      (when (and *target* (nonzero? *target*))
        (mp-tomb-daxter-wait-set-draw! (the-as process-drawable *target*) #f)
        )
      )
  (none)
  )

(defun mp-tomb-daxter-wait-update! ()
  (if (not *multi-sync-enabled?*)
      (mp-tomb-daxter-wait-reset!)
      (let ((npc (mp-tomb-daxter-wait-npc)))
        (when npc
          (case *mp-tomb-daxter-wait-state*
            (('local-waiting)
             (if (or (not (mp-tomb-daxter-wait-local-ready?))
                     (mp-tomb-daxter-wait-moved-since-start?))
                 (mp-tomb-daxter-wait-end-local! npc)
                 (mp-tomb-daxter-wait-apply-local! npc)
                 )
             )
            (('remote-waiting)
             (if (mp-local-player-jak?)
                 (mp-tomb-daxter-wait-apply-remote! npc)
                 (mp-tomb-daxter-wait-receive-end!)
                 )
             )
            (else
             (daxter-npc-set-draw! npc #t)
             (when (mp-tomb-daxter-wait-local-ready?)
               (when (mp-tomb-daxter-wait-inside-zone?)
                 (mp-tomb-daxter-wait-prompt!)
                 (when (and (can-display-query? *target* (the-as string #f) -99.0)
                            (cpad-pressed? 0 triangle))
                   (cpad-clear! 0 triangle)
                   (mp-tomb-daxter-wait-start-local! npc)
                   )
                 )
               )
             )
            )
          (mp-tomb-daxter-wait-disable-collision! npc)
          )
        )
      )
  (none)
  )
