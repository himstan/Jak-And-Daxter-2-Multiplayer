;;-*-Lisp-*-
(in-package goal)

(defconstant MP_TOMB_DAXTER_WAIT_MOVE_THRESHOLD (meters 0.01))

(define *mp-tomb-daxter-wait-zone*
  (new 'static 'bounding-box
    :min (static-vectorm 176.0 -72.0 1392.0)
    :max (static-vectorm 207.0 -72.0 1400.0)
    )
  )

(deftype custom-daxter-npc (process-drawable)
  ((player-id     uint32)
   (board-handle  handle)
   )
  (:state-methods
    idle
    hide
    )
  )

(deftype custom-daxter-board (process-drawable)
  ()
  (:state-methods
    idle
    )
  )

(defun mp-tomb-daxter-player-target ((player-id uint))
  (if (= player-id (mp-local-player-id))
      *target*
      (mp-player-target-by-id player-id)
      )
  )

(defun custom-daxter-board-art-ready? ()
  (and *level*
       (nonzero? *level*)
       (art-group-get-by-name *level* "skel-board" (the-as (pointer uint32) #f))
       )
  )

(defun mp-tomb-daxter-player-has-board? ((player-id uint))
  (let ((tgt (mp-tomb-daxter-player-target player-id)))
    (if (and tgt (nonzero? tgt))
        (logtest? (-> tgt game features) (game-feature board))
        (logtest? (-> *game-info* features) (game-feature board))
        )
    )
  )

(defstate idle (custom-daxter-board)
  :virtual #t
  :code sleep-code
  :post (behavior ()
    (let ((parent-proc (the-as custom-daxter-npc (if (and (-> self parent) (nonzero? (-> self parent)))
                                                    (ppointer->process (-> self parent))
                                                    #f))))
      (when (and parent-proc (nonzero? parent-proc) (-> parent-proc draw) (nonzero? (-> parent-proc draw)))
        (if (logtest? (-> parent-proc draw status) (draw-control-status no-draw no-draw-bounds))
            (logior! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
            (logclear! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
            )
        (let ((bone-transform (-> parent-proc node-list data 6 bone transform)))
          (matrix->transformq (the-as transformq (-> self root trans)) bone-transform)
          (set-vector! (-> self root scale) 0.5 0.5 0.5 1.0)
          (let ((local-offset (new 'stack-no-clear 'vector)))
            (set-vector! local-offset 0.0 200.0 500.0 1.0)
            (vector-matrix*! (-> self root trans) local-offset bone-transform)
            )
          (let ((rot-euler (new 'stack-no-clear 'vector))
                (rot-quat (new 'stack-no-clear 'quaternion)))
            (set-vector! rot-euler (degrees 30.0) (degrees -45.0) (degrees 180.0) 1.0)
            (quaternion-zxy! rot-quat rot-euler)
            (quaternion*! (the-as quaternion (-> self root quat)) (the-as quaternion (-> self root quat)) rot-quat)
            )
          )
        )
      )
    (ja-post)
    )
  )

(defbehavior custom-daxter-board-init custom-daxter-board ()
  (set! (-> self root) (new 'process 'trsqv))
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-board" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (set! (-> self draw light-index) (the-as uint 30))
  (logior! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
  (go-virtual idle)
  )

(defun custom-daxter-npc-ensure-board! ((npc custom-daxter-npc))
  (when (and npc (nonzero? npc))
    (let ((has-board? (mp-tomb-daxter-player-has-board? (-> npc player-id)))
          (board-proc (handle->process (-> npc board-handle))))
      (cond
        (has-board?
         (unless (and board-proc (nonzero? board-proc))
           (when (custom-daxter-board-art-ready?)
             (let ((spawned (process-spawn custom-daxter-board :init custom-daxter-board-init :to npc)))
               (when spawned
                 (set! (-> npc board-handle) (ppointer->handle spawned))
                 )
               )
             )
           )
         )
        (else
         (when (and board-proc (nonzero? board-proc))
           (deactivate board-proc)
           (set! (-> npc board-handle) (the-as handle #f))
           )
         )
        )
      )
    )
  (none)
  )

(defun custom-daxter-npc-destroy-board! ((npc custom-daxter-npc))
  (when (and npc (nonzero? npc))
    (let ((board-proc (handle->process (-> npc board-handle))))
      (when (and board-proc (nonzero? board-proc))
        (deactivate board-proc)
        )
      )
    (set! (-> npc board-handle) (the-as handle #f))
    )
  (none)
  )

(defun mp-tomb-daxter-wait-apply-appearance! ((npc custom-daxter-npc))
  (when (and npc (nonzero? npc) (-> npc draw) (nonzero? (-> npc draw)))
    (let ((record (mp-player-color-record-by-id (the-as int (-> npc player-id)))))
      (if (and record (nonzero? record))
          (mp-apply-render-appearance! (-> npc draw) (-> record identity appearance))
          (mp-clear-render-appearance! (-> npc draw))
          )
      )
    )
  (none)
  )

(defstate idle (custom-daxter-npc)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('hide)
       (go-virtual hide)
       )
      )
    )
  :enter (behavior ()
    (logclear! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
    (ja-channel-push! 1 (seconds 0.2))
    (ja :group! (-> self draw art-group data 3) :num! min)
    (mp-tomb-daxter-wait-apply-appearance! self)
    (custom-daxter-npc-ensure-board! self)
    )
  :trans (behavior ()
    (mp-tomb-daxter-wait-apply-appearance! self)
    (custom-daxter-npc-ensure-board! self)
    )
  :code (behavior ()
    (until #f
      (ja-no-eval :group! (-> self draw art-group data 3) :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    )
  :post ja-post
  )

(defstate hide (custom-daxter-npc)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('show)
       (go-virtual idle)
       )
      )
    )
  :enter (behavior ()
    (logior! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
    )
  :code sleep-code
  )

(defbehavior custom-daxter-npc-init-by-other custom-daxter-npc ((player-id uint))
  (set! (-> self player-id) (the-as uint32 player-id))
  (set! (-> self board-handle) (the-as handle #f))
  (set! (-> self root) (new 'process 'trsqv))
  (vector-copy! (-> self root trans) (new 'static 'vector :x (meters 200.0) :y (meters -72.0) :z (meters 1395.0) :w 1.0))
  (quaternion-axis-angle! (-> self root quat) 0.0 1.0 0.0 (degrees 180.0))
  (initialize-skeleton
    self
    (the-as skeleton-group (art-group-get-by-name *level* "skel-sidekick-highres" (the-as (pointer uint32) #f)))
    (the-as pair 0)
    )
  (logior! (-> self skel status) (joint-control-status blend-shape eye-anim))
  (set! (-> self draw light-index) (the-as uint 30))
  (mp-tomb-daxter-wait-apply-appearance! self)
  (custom-daxter-npc-ensure-board! self)
  (logior! (-> self draw status) (draw-control-status no-draw no-draw-bounds))
  (go-virtual hide)
  )

(deftype mp-tomb-daxter-wait-slot (structure)
  ((state      symbol)
   (position   vector :inline)
   (pos-valid? symbol)
   (npc-handle handle)
   )
  )

(define *mp-tomb-daxter-wait-slots*
  (new 'global 'boxed-array mp-tomb-daxter-wait-slot MP_MAX_PLAYERS)
  )

(dotimes (slot-init-idx MP_MAX_PLAYERS)
  (set! (-> *mp-tomb-daxter-wait-slots* slot-init-idx) (new 'global 'mp-tomb-daxter-wait-slot))
  (set! (-> *mp-tomb-daxter-wait-slots* slot-init-idx state) 'inactive)
  (set! (-> *mp-tomb-daxter-wait-slots* slot-init-idx pos-valid?) #f)
  (set! (-> *mp-tomb-daxter-wait-slots* slot-init-idx npc-handle) (the-as handle #f))
  )

(defun custom-daxter-npc-art-ready? ()
  (and *level*
       (nonzero? *level*)
       (art-group-get-by-name *level* "skel-sidekick-highres" (the-as (pointer uint32) #f))
       )
  )

(defun mp-tomb-daxter-player-active-daxter? ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (if (= player-id (mp-local-player-id))
        (mp-local-player-daxter?)
        (let ((record (mp-player-record-by-id player-id)))
          (and record
               (nonzero? record)
               (mp-player-record-remote? *mp-player-controller* record)
               (mp-player-daxter? record))
          )
        )
    )
  )

(defun mp-tomb-daxter-wait-npc ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id)))
      (when (and slot (nonzero? slot))
        (let ((proc (handle->process (-> slot npc-handle))))
          (if (and proc (nonzero? proc))
              (the-as custom-daxter-npc proc)
              (the-as custom-daxter-npc #f)
              )
          )
        )
      )
    )
  )

(defun mp-tomb-daxter-wait-ensure-npc! ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id)))
      (when (and slot (nonzero? slot))
        (let ((proc (handle->process (-> slot npc-handle))))
          (if (and proc (nonzero? proc))
              (the-as custom-daxter-npc proc)
              (when (custom-daxter-npc-art-ready?)
                (let ((spawned (process-spawn custom-daxter-npc player-id :init custom-daxter-npc-init-by-other :to *entity-pool*)))
                  (when spawned
                    (set! (-> slot npc-handle) (ppointer->handle spawned))
                    (the-as custom-daxter-npc (ppointer->process spawned))
                    )
                  )
                )
              )
          )
        )
      )
    )
  )

(defun mp-tomb-daxter-wait-destroy-npc! ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id)))
      (when (and slot (nonzero? slot))
        (let ((proc (handle->process (-> slot npc-handle))))
          (when (and proc (nonzero? proc))
            (custom-daxter-npc-destroy-board! (the-as custom-daxter-npc proc))
            (deactivate proc)
            )
          )
        (set! (-> slot npc-handle) (the-as handle #f))
        )
      )
    )
  (none)
  )

(defun daxter-npc-set-draw! ((proc process-drawable) (hidden? symbol))
  (when (and proc (nonzero? proc) (-> proc draw) (nonzero? (-> proc draw)))
    (send-event proc (if hidden? 'hide 'show))
    )
  (none)
  )

(defun mp-tomb-daxter-wait-set-draw! ((proc process-drawable) (hidden? symbol))
  (when (and proc (nonzero? proc) (-> proc draw) (nonzero? (-> proc draw)))
    (if hidden?
        (logior! (-> proc draw status) (draw-control-status no-draw no-draw-bounds))
        (logclear! (-> proc draw status) (draw-control-status no-draw no-draw-bounds))
        )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-place! ((npc process-drawable) (position vector))
  (when (and npc
             (nonzero? npc)
             (-> npc root)
             (nonzero? (-> npc root))
             position
             (nonzero? position))
    (vector-copy! (-> npc root trans) position)
    (quaternion-axis-angle! (-> npc root quat) 0.0 1.0 0.0 (degrees 180.0))
    (set! (-> npc root transv quad) (the-as uint128 0))
    (when (type? (-> npc root) collide-shape)
      (update-transforms (the-as collide-shape (-> npc root)))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-disable-collision! ((npc process-drawable))
  (when (and npc
             (nonzero? npc)
             (-> npc root)
             (nonzero? (-> npc root))
             (type? (-> npc root) collide-shape))
    (let ((root (the-as collide-shape (-> npc root))))
      (set-collide-as! root (collide-spec))
      (set-collide-with! root (collide-spec))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-local-ready? ()
  (and *multi-sync-enabled?*
       (mp-local-player-daxter?)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (movie?))
       *level*
       (nonzero? *level*)
       (not (load-in-progress? *level*))
       (not (logtest? (focus-status dead teleporting) (-> *target* focus-status)))
       )
  )

(defun mp-tomb-daxter-wait-inside-zone? ()
  (and (mp-tomb-daxter-wait-local-ready?)
       (logtest? (-> *target* control status) (collide-status on-ground))
       *mp-tomb-daxter-wait-zone*
       (nonzero? *mp-tomb-daxter-wait-zone*)
       (inside-xz? *mp-tomb-daxter-wait-zone* (-> *target* control trans))
       )
  )

(defun mp-tomb-daxter-wait-moved-since-start? ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id)))
      (and slot
           (nonzero? slot)
           (-> slot pos-valid?)
           *target*
           (nonzero? *target*)
           (-> *target* control)
           (nonzero? (-> *target* control))
           (> (vector-vector-distance (-> *target* control trans) (-> slot position))
              MP_TOMB_DAXTER_WAIT_MOVE_THRESHOLD))
      )
    )
  )

(defun mp-tomb-daxter-wait-prompt! ()
  (when (can-display-query? *target* (the-as string #f) -99.0)
    (let ((font (new 'stack 'font-context *font-default-matrix* 32 280 0.0
                     (font-color default) (font-flags shadow kerning middle-vert large))))
      (set! (-> font width) 340.0)
      (set! (-> font height) 80.0)
      (set! (-> font scale) 0.9)
      (print-game-text
        (lookup-text! *common-text* (text-id press-triangle-to-wait-for-jak) #f)
        font
        #f
        44
        (bucket-id progress))
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-apply! ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id))
          (tgt (mp-tomb-daxter-player-target player-id)))
      (when (and slot (nonzero? slot))
        (when (and (not (-> slot pos-valid?)) tgt (nonzero? tgt) (-> tgt root) (nonzero? (-> tgt root)))
          (vector-copy! (-> slot position) (-> tgt root trans))
          (set! (-> slot pos-valid?) #t)
          )
        (when (-> slot pos-valid?)
          (let ((npc (mp-tomb-daxter-wait-ensure-npc! player-id)))
            (when (and npc (nonzero? npc))
              (mp-tomb-daxter-wait-place! npc (-> slot position))
              (mp-tomb-daxter-wait-apply-appearance! npc)
              (custom-daxter-npc-ensure-board! npc)
              (daxter-npc-set-draw! npc #f)
              (mp-tomb-daxter-wait-disable-collision! npc)
              )
            )
          )
        (when (and tgt (nonzero? tgt))
          (mp-tomb-daxter-wait-set-draw! (the-as process-drawable tgt) #t)
          )
        )
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-slot-clear! ((player-id uint))
  (when (< player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* player-id))
          (npc (mp-tomb-daxter-wait-npc player-id))
          (tgt (mp-tomb-daxter-player-target player-id)))
      (when (and slot (nonzero? slot))
        (set! (-> slot state) 'inactive)
        (set! (-> slot pos-valid?) #f)
        )
      (when (and npc (nonzero? npc))
        (daxter-npc-set-draw! npc #t)
        )
      (when (and tgt (nonzero? tgt))
        (mp-tomb-daxter-wait-set-draw! (the-as process-drawable tgt) #f)
        )
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-start-local! ()
  (let ((local-id (mp-local-player-id)))
    (when (< local-id (the uint MP_MAX_PLAYERS))
      (let ((slot (-> *mp-tomb-daxter-wait-slots* local-id)))
        (when (and slot (nonzero? slot))
          (set! (-> slot pos-valid?) #f)
          (set! (-> slot state) 'local-waiting)
          (mp-tomb-daxter-wait-apply! local-id)
          (when (and *multi-sync-enabled?* (not *mp-processing-remote-event*))
            (mp-event-enqueue-actor-name!
              MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START "custom-daxter-npc")
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-end-local! ()
  (let ((local-id (mp-local-player-id)))
    (mp-tomb-daxter-wait-slot-clear! local-id)
    (when (and *multi-sync-enabled?* (not *mp-processing-remote-event*))
      (mp-event-enqueue-actor-name!
        MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END "custom-daxter-npc")
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-receive-start! ((source-player-id uint))
  (when (< source-player-id (the uint MP_MAX_PLAYERS))
    (let ((slot (-> *mp-tomb-daxter-wait-slots* source-player-id)))
      (when (and slot (nonzero? slot))
        (set! (-> slot pos-valid?) #f)
        (set! (-> slot state) 'remote-waiting)
        (mp-tomb-daxter-wait-apply! source-player-id)
        )
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-receive-end! ((source-player-id uint))
  (mp-tomb-daxter-wait-slot-clear! source-player-id)
  (none)
  )

(defun mp-tomb-daxter-wait-suppress-og-npc! ()
  "Keep original level entity daxter-npc-2 hidden and non-collidable."
  (let ((og-npc (the-as process-taskable (process-by-ename "daxter-npc-2"))))
    (when (and og-npc (nonzero? og-npc))
      (set! (-> og-npc state-locked?) #t)
      (let ((draw-ctrl (-> og-npc draw)))
        (when (and draw-ctrl (nonzero? draw-ctrl))
          (logior! (-> draw-ctrl status) (draw-control-status no-draw no-draw-bounds))
          )
        )
      (when (and (-> og-npc root)
                 (nonzero? (-> og-npc root))
                 (type? (-> og-npc root) collide-shape))
        (let ((root (the-as collide-shape (-> og-npc root))))
          (set-collide-as! root (collide-spec))
          (set-collide-with! root (collide-spec))
          )
        )
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-reset! ()
  (mp-tomb-daxter-wait-suppress-og-npc!)
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((u-pid (the-as uint player-id)))
      (mp-tomb-daxter-wait-slot-clear! u-pid)
      (mp-tomb-daxter-wait-destroy-npc! u-pid)
      )
    )
  (none)
  )

(defun mp-tomb-daxter-wait-update! ()
  (mp-tomb-daxter-wait-suppress-og-npc!)
  (if (not *multi-sync-enabled?*)
      (mp-tomb-daxter-wait-reset!)
      (let ((local-id (mp-local-player-id)))
        (dotimes (player-id MP_MAX_PLAYERS)
          (let* ((u-pid (the-as uint player-id))
                 (slot (-> *mp-tomb-daxter-wait-slots* u-pid))
                 (is-daxter? (mp-tomb-daxter-player-active-daxter? u-pid)))
            (when (and slot (nonzero? slot))
              (cond
                (is-daxter?
                 (case (-> slot state)
                   (('local-waiting)
                    (if (or (not (mp-tomb-daxter-wait-local-ready?))
                            (mp-tomb-daxter-wait-moved-since-start? u-pid))
                        (mp-tomb-daxter-wait-end-local!)
                        (mp-tomb-daxter-wait-apply! u-pid)
                        )
                    )
                   (('remote-waiting)
                    (mp-tomb-daxter-wait-apply! u-pid)
                    )
                   (else
                    (let ((npc (mp-tomb-daxter-wait-npc u-pid)))
                      (when (and npc (nonzero? npc))
                        (daxter-npc-set-draw! npc #t)
                        )
                      )
                    )
                   )
                 )
                (else
                 (when (!= (-> slot state) 'inactive)
                   (mp-tomb-daxter-wait-slot-clear! u-pid)
                   )
                 (mp-tomb-daxter-wait-destroy-npc! u-pid)
                 )
                )
              )
            )
          )
        ;; Prompt handling for local Daxter
        (when (and (mp-tomb-daxter-wait-local-ready?)
                   (= (-> *mp-tomb-daxter-wait-slots* local-id state) 'inactive)
                   (mp-tomb-daxter-wait-inside-zone?))
          (mp-tomb-daxter-wait-prompt!)
          (when (and (can-display-query? *target* (the-as string #f) -99.0)
                     (cpad-pressed? 0 triangle))
            (cpad-clear! 0 triangle)
            (mp-tomb-daxter-wait-start-local!)
            )
          )
        )
      )
  (none)
  )
