;;-*-Lisp-*-
(in-package goal)

(defconstant STRIP_GRENADE_POINT_ID_BASE (the uint #x73000000))
(defconstant STRIP_GRENADE_POINT_COUNT 6)
(defconstant STRIP_GRENADE_START (the uint 0))
(defconstant STRIP_GRENADE_RESET (the uint 1))
(defconstant STRIP_GRENADE_FAIL (the uint 2))
(define *strip-grenade-point-names*
  (new 'static 'boxed-array :type string
    "grenade-point-1" "grenade-point-2" "grenade-point-3"
    "grenade-point-4" "grenade-point-5" "grenade-point-6"))

(defun strip-grenade-point-id ((ent entity))
  (if (nonnull? ent)
      (+ STRIP_GRENADE_POINT_ID_BASE (res-lump-value ent 'extra-id uint :default (the-as uint128 0)))
      STRIP_GRENADE_POINT_ID_BASE))

(defun strip-grenade-point-done? ((ent entity))
  (the symbol (and (mp-session-in-game?) (nonnull? ent)
                   (mp-aid-dead-in-perm-list? (strip-grenade-point-id ent)))))

(defun strip-grenade-apply-point! ((index int) (message symbol))
  (when (nonnull? *level* *strip-grenade-point-names*)
    (let ((ent (entity-by-name (-> *strip-grenade-point-names* index))))
      (when (nonnull? ent (-> ent extra) (-> ent extra perm))
        (let ((perm (-> ent extra perm))
              (proc (-> ent extra process)))
          (cond
            ((= message 'reset)
             (logclear! (-> perm status) (entity-perm-status subtask-complete))
             (when (nonnull? proc)
               (deactivate proc)))
            ((not (logtest? (-> perm status) (entity-perm-status subtask-complete)))
             (logior! (-> perm status) (entity-perm-status subtask-complete))
             (when (nonnull? proc)
               (send-event proc message))))))))
  (none))

(defun strip-grenade-reset-points! ()
  (when (nonnull? *game-info*)
    (dotimes (index STRIP_GRENADE_POINT_COUNT)
      (let ((perm (actor-perm *game-info* (the-as actor-id (+ STRIP_GRENADE_POINT_ID_BASE index 1)))))
        (when (nonnull? perm)
          (logclear! (-> perm status) (entity-perm-status dead))))
      (strip-grenade-apply-point! index 'reset)))
  (none))

(defun strip-grenade-timed-out? ((controller strip-grenade-controller))
  (the symbol (and (nonnull? controller *game-info* (-> *game-info* sub-task-list))
                   (not (task-node-closed? (game-task-node strip-grenade-explode)))
                   (zero? (task-timer-remaining controller))
                   (!= (-> controller completed-points) (- (ash 1 STRIP_GRENADE_POINT_COUNT) 1)))))

(defun send-strip-grenade-control! ((action uint))
  (let ((event (new 'stack-no-clear 'strip-grenade-control-event)))
    (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_STRIP_GRENADE_CONTROL))
      (set! (-> event payload) (the uint8 action))
      (mp-event-enqueue! event)))
  (none))

(defun strip-grenade-reset-local-task! ()
  (strip-grenade-reset-points!)
  (when (nonnull? *game-info* (-> *game-info* sub-task-list) *level*)
    (let ((node (-> *game-info* sub-task-list (game-task-node strip-grenade-explode))))
      (when (nonnull? node (-> node info))
        (let ((manager (handle->process-safe (-> node info manager))))
          (when (nonnull? manager)
            (deactivate manager)))
        (when (and (= (level-status *level* 'strip) 'active)
                   (task-node-open? (game-task-node strip-grenade-explode)))
          (script-eval '(task-manager) :key node)))))
  (none))

(defun strip-grenade-restart-host! ()
  (when (and (mp-session-in-game?) (mp-session-host?))
    (let ((controller (process-by-type-exact 'strip-grenade-controller *active-pool*)))
      (when (nonnull? controller)
        (deactivate controller)
        (strip-grenade-reset-points!)
        (send-strip-grenade-control! STRIP_GRENADE_RESET))))
  (none))

(defun strip-grenade-fail-local! ()
  (strip-grenade-reset-points!)
  (when (nonnull? *target* (-> *target* control))
    (set! *mp-death-party-wipe-pending?* #t)
    (unless (focus-test? *target* dead)
      (send-event *target* 'attack-invinc #f (static-attack-info ((id (new-attack-id)) (mode 'big-explosion))))))
  (none))

(defun strip-grenade-fail-host! ()
  (when (and (mp-session-in-game?) (mp-session-host?))
    (let ((controller (the-as strip-grenade-controller (process-by-type-exact 'strip-grenade-controller *active-pool*))))
      (when (strip-grenade-timed-out? controller)
        (send-strip-grenade-control! STRIP_GRENADE_FAIL)
        (strip-grenade-fail-local!)
        (deactivate controller))))
  (none))

(defstate track-grenades (strip-grenade-controller)
  :virtual #t
  :code (behavior ()
    (until (or (not (mp-session-in-game?)) (not (mp-session-host?))
               (not (nonnull? self *game-info* (-> *game-info* sub-task-list)))
               (task-node-closed? (game-task-node strip-grenade-explode))
               (strip-grenade-timed-out? self))
      (ensure-task-timer-sync! self (the uint (game-task-node strip-grenade-explode)))
      (dotimes (index STRIP_GRENADE_POINT_COUNT)
        (when (logtest? (-> self completed-points) (ash 1 index))
          (let ((aid (+ STRIP_GRENADE_POINT_ID_BASE index 1)))
            (when (not (mp-aid-dead-in-perm-list? aid))
              (mp-record-aid-dead-in-perm-list! aid)
              (strip-grenade-apply-point! index 'restore-broken)))))
      (set! (-> *game-info* timer) (task-timer-remaining self))
      (suspend))
    (if (and (mp-session-in-game?) (mp-session-host?) (strip-grenade-timed-out? self))
        (strip-grenade-fail-host!)
        (deactivate self))))

(defbehavior strip-grenade-controller-init strip-grenade-controller ()
  (when (nonnull? self (-> self main-thread) *game-info* (-> *game-info* sub-task-list) *display* (-> *display* shared-clock))
    (stack-size-set! (-> self main-thread) 1024)
    (set! (-> self node-info) (-> *game-info* sub-task-list (game-task-node strip-grenade-explode)))
    (initialize! self)
    (set! (-> self clock) (-> *display* shared-clock))
    (set! (-> self mask) (process-mask pause menu))
    (set! (-> self completed-points) (the uint8 0))
    (set! (-> self time-limit) (seconds 120))
    (set! (-> self start-time) (max 1 (current-time)))
    (go-virtual track-grenades))
  (none))

(defun strip-grenade-start-host! ()
  (when (and (mp-session-host?) (nonnull? *game-info* (-> *game-info* sub-task-list))
             (task-node-open? (game-task-node strip-grenade-explode)))
    (let ((controller (the-as strip-grenade-controller (process-by-type-exact 'strip-grenade-controller *active-pool*))))
      (cond
        ((nonnull? controller)
         (dotimes (index STRIP_GRENADE_POINT_COUNT)
           (when (logtest? (-> controller completed-points) (ash 1 index))
             (mp-event-enqueue-aid! MP_EVENT_BREAK (+ STRIP_GRENADE_POINT_ID_BASE index 1)))))
        (else
          (strip-grenade-reset-points!)
          (send-strip-grenade-control! STRIP_GRENADE_RESET)
          (process-spawn strip-grenade-controller :init strip-grenade-controller-init :to *mid-pool*)))))
  (none))

(defun receive-strip-grenade-control! ((event strip-grenade-control-event))
  (when (and (mp-session-in-game?) (nonnull? event))
    (case (-> event payload)
      ((STRIP_GRENADE_START)
       (strip-grenade-start-host!))
      ((STRIP_GRENADE_RESET)
       (when (= (-> event source-player-slot) (mp-host-player-slot))
         (strip-grenade-reset-local-task!)))
      ((STRIP_GRENADE_FAIL)
       (if (= (-> event source-player-slot) (mp-host-player-slot))
           (strip-grenade-fail-local!)
           (strip-grenade-fail-host!)))))
  (none))

(defun sync-strip-grenade! ((aid uint) (message symbol))
  (when (and (> aid STRIP_GRENADE_POINT_ID_BASE) (<= aid (+ STRIP_GRENADE_POINT_ID_BASE STRIP_GRENADE_POINT_COUNT)))
    (when (= message 'synchronized?)
      (return (mp-aid-dead-in-perm-list? aid)))
    (when (mp-session-host?)
      (let ((controller (the-as strip-grenade-controller (process-by-type-exact 'strip-grenade-controller *active-pool*))))
        (when (nonnull? controller)
          (logior! (-> controller completed-points) (ash 1 (- aid STRIP_GRENADE_POINT_ID_BASE 1))))))
    (mp-record-aid-dead-in-perm-list! aid)
    (strip-grenade-apply-point! (the int (- aid STRIP_GRENADE_POINT_ID_BASE 1))
                               (if (= message 'restore-broken) 'restore-broken 'die))
    (return #t))
  #f)

(defbehavior strip-grenade-point-complete! process-drawable ()
  (when (nonnull? self (-> self entity) (-> self entity extra) (-> self entity extra perm))
    (let* ((ent (-> self entity))
           (aid (strip-grenade-point-id ent)))
      (logior! (-> ent extra perm status) (entity-perm-status subtask-complete))
      (when (and (> aid STRIP_GRENADE_POINT_ID_BASE) (<= aid (+ STRIP_GRENADE_POINT_ID_BASE STRIP_GRENADE_POINT_COUNT))
                 (not (mp-aid-dead-in-perm-list? aid)))
        (sync-strip-grenade! aid 'break)
        (mp-event-enqueue-aid! MP_EVENT_BREAK aid))))
  (none))

(defbehavior strip-grenade-sync-timer! task-manager ()
  (when (and (mp-session-in-game?) (nonnull? self *game-info* (-> self clock)))
    (when (mp-session-host?)
      (let ((controller (the-as strip-grenade-controller (process-by-type-exact 'strip-grenade-controller *active-pool*))))
        (when (nonnull? controller)
          (set! (-> self start-time) (- (-> self clock frame-counter) (- (-> self time-limit) (task-timer-remaining controller))))
          (set! (-> self hud-timer) (-> controller hud-timer)))))
    (when (nonzero? (-> self start-time))
      (let ((remaining (task-timer-remaining self)))
        (set! (-> *game-info* timer) remaining)
        (set! (-> *game-info* timer-flash) (< remaining (seconds 10)))))
    (when (mp-session-client?)
      (ensure-task-timer-sync! self (the uint (game-task-node strip-grenade-explode)))))
  (none))

(set! *actor-sync-handlers* (cons sync-strip-grenade! *actor-sync-handlers*))
