;;-*-Lisp-*-
(in-package goal)

(define *drill-panel-aids*
  (new 'static 'boxed-array :type uint32 29617 29620 29623 29624 29625 29626 29631 29632 29633 29634))

(define *drill-obstacle-aids* (new 'static 'boxed-array :type uint32 19448 19449 19472 19471 29648 29649))

(defun aid-listed? ((aid uint) (aids (array uint32)))
  (dotimes (index (-> aids length))
    (when (= aid (-> aids index))
      (return #t)))
  #f)

(defun drill-mech-actor? ((aid uint))
  (or (aid-listed? aid *drill-panel-aids*) (aid-listed? aid *drill-obstacle-aids*)))

(defun drill-switch-step-aid ((switch-aid uint))
  (case switch-aid
    ((29648) (the uint 19450))
    ((29649) (the uint 19451))
    (else (the uint 0))))

(defun drill-actor-broken? ((aid uint))
  (let ((perm (aid-perm aid #f)))
    (the symbol (and (nonnull? perm) (logtest? (-> perm status) (entity-perm-status bit-12))))))

(defun drill-panels-remaining ()
  (let ((remaining 0))
    (dotimes (index (-> *drill-panel-aids* length))
      (unless (drill-actor-broken? (-> *drill-panel-aids* index))
        (+! remaining 1)))
    remaining))

(defun mark-drill-actor-broken! ((aid uint))
  (let ((perm (if (nonzero? aid) (aid-perm aid #t) (the-as entity-perm #f))))
    (when (nonnull? perm)
      (set! (-> perm task) (game-task complete))
      (logior! (-> perm status) (entity-perm-status subtask-complete bit-12))))
  (none))

(defun report-drill-actor-broken! ((proc process-drawable))
  (when (and (mp-session-in-game?) (nonnull? proc (-> proc entity)) (drill-mech-actor? (-> proc entity aid)))
    (mark-drill-actor-broken! (-> proc entity aid))
    (mp-event-enqueue-aid! MP_EVENT_BREAK (-> proc entity aid)))
  (none))

(defun sync-drill-mech-actor! ((aid uint) (message symbol))
  (when (not (drill-mech-actor? aid))
    (return #f))
  (when (= message 'synchronized?)
    (return (drill-actor-broken? aid)))
  (unless (drill-actor-broken? aid)
    (mark-drill-actor-broken! aid)
    (mark-drill-actor-broken! (drill-switch-step-aid aid))
    (let ((ent (if (nonnull? *level*) (entity-by-aid aid) (the-as entity #f))))
      (when (nonnull? ent (-> ent extra) (-> ent extra process))
        (send-event (-> ent extra process) 'remote-break))))
  #t)

(set! *actor-sync-handlers* (cons sync-drill-mech-actor! *actor-sync-handlers*))
