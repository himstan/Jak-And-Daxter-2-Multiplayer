;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-darkjak-last-giant-step-feedback-time* time-frame 0)

(define *oracle-training-nodes*
  (new 'static 'boxed-array :type uint16
    (game-task-node city-oracle-level0-training)
    (game-task-node city-oracle-level1-training)
    (game-task-node city-oracle-level2-training)
    (game-task-node city-oracle-level3-training)))

(defun mp-oracle-darkjak-training-allowed? ()
  (or (not (mp-session-in-game?)) (mp-local-player-jak?)))

(defun oracle-training-skip? ()
  (unless (and (mp-session-in-game?) (mp-local-player-daxter?))
    (return #f))
  (mp-for-each-player-record (player-slot record)
    (when (and (mp-remote-gameplay-player-connected? record) (mp-player-jak? record))
      (return #f)))
  #t)

(defun receive-oracle-training-complete! ((event oracle-training-complete-event) (source-record mp-player-record))
  (when (and (mp-session-host?)
             (nonnull? event *game-info* (-> *game-info* sub-task-list))
             (mp-remote-gameplay-player-connected? source-record)
             (or (mp-player-jak? source-record) (oracle-training-skip?)))
    (let ((step (-> event payload)))
      (when (< step (-> *oracle-training-nodes* length))
        (let ((node (the-as game-task-node (-> *oracle-training-nodes* step))))
          (when (task-node-open? node)
            (task-node-close! node))))))
  (none))

(defun send-oracle-training-complete! ((node game-task-node))
  (dotimes (step (-> *oracle-training-nodes* length))
    (when (= node (the-as game-task-node (-> *oracle-training-nodes* step)))
      (let ((event (new 'stack-no-clear 'oracle-training-complete-event)))
        (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_ORACLE_TRAINING_COMPLETE))
          (set! (-> event payload) (the uint8 step))
          (mp-event-enqueue! event)))))
  (none))

(defbehavior oracle-training-start-darkjak! task-manager ()
  (set! (-> self data-int32 0) (if (mp-oracle-darkjak-training-allowed?) 1 0))
  (set! (-> self data-int32 1) 0)
  (set! (-> self data-int8 0) 0)
  (set! (-> self beep-time) (the-as time-frame 0))
  (set! (-> self sound-id 0) (the-as sound-id 0))
  (when (nonzero? (-> self data-int32 0))
    (set! (-> self sound-id 0)
          (add-process *gui-control* self (gui-channel message) (gui-action play) (-> self name) 81920.0 0)))
  (when (and (nonzero? (-> self data-int32 0)) (nonnull? *target*))
    (set! (-> self data-float 0) (the-as float (send-event *target* 'test-pickup (pickup-type eco-pill-dark))))
    (send-event *target* 'change-mode 'darkjak #f (darkjak-stage force-on no-anim))
    (send-event *target* 'get-notify self))
  (none))

(defbehavior oracle-training-complete! task-manager ()
  (if (and (mp-session-in-game?) (mp-session-client?))
      (when (nonnull? self)
        (set! (-> self data-int8 0) 1))
      (go-virtual complete))
  (none))

(defbehavior oracle-training-hold-darkjak! task-manager ((complete-on-exit? symbol))
  (when (nonnull? self)
    (cond
      ((nonzero? (-> self data-int8 0))
       (when (and (nonnull? (-> self info))
                  (or (zero? (-> self beep-time)) (time-elapsed? (-> self beep-time) (seconds 1))))
         (set-time! (-> self beep-time))
         (send-oracle-training-complete! (-> self info final-node))))
      ((zero? (-> self data-int32 0))
       (when (oracle-training-skip?) (oracle-training-complete!)))
      ((nonnull? *target*)
       (cond
         ((focus-test? *target* dark) (set! (-> self data-int32 1) 1))
         ((and complete-on-exit? (nonzero? (-> self data-int32 1))) (oracle-training-complete!))
         (else (send-event *target* 'change-mode 'darkjak #f (darkjak-stage force-on no-anim)))))))
  (none))

(defbehavior oracle-training-stop-darkjak! task-manager ()
  (when (and (nonzero? (-> self data-int32 0)) (nonnull? *target*))
    (send-event *target* 'get-pickup (pickup-type eco-pill-dark) (-> self data-float 0))
    (if (focus-test? *target* dark)
      (send-event *target* 'change-mode 'darkjak #f (darkjak-stage disable-force-on)))
    (send-event *target* 'get-notify #f))
  (none))

(defun mp-darkjak-persistent-stage ((stage uint))
  (the uint (logand stage (darkjak-stage active bomb0 bomb1 invinc giant))))

(defun mp-darkjak-feedback-factor ((source target) (observer target) (outer-dist float))
  (if (and source
           (nonzero? source)
           observer
           (nonzero? observer)
           (-> source control)
           (nonzero? (-> source control))
           (-> observer control)
           (nonzero? (-> observer control)))
    (let ((dist (vector-vector-distance (-> source control trans) (-> observer control trans)))
          (inner-dist (meters 10.0)))
      (cond
        ((<= dist inner-dist) 1.0)
        ((>= dist outer-dist) 0.0)
        (else (/ (- outer-dist dist) (- outer-dist inner-dist)))))
    0.0))

(defun mp-darkjak-emit-spatial-feedback! ((source target) (observer target) (outer-dist float) (strength float))
  (when (and source (nonzero? source) (mp-target-jak? source) observer (nonzero? observer) (mp-target-daxter? observer))
    (let ((feedback (* strength (mp-darkjak-feedback-factor source observer outer-dist))))
      (when (> feedback 0.0)
        (when (and *camera-smush-control* (nonzero? *camera-smush-control*) *display* (nonzero? *display*))
          (activate! *camera-smush-control* (* 1638.4 feedback) 15 75 1.0 0.9 (-> *display* camera-clock)))
        (when (and *cpad-list* (nonzero? *cpad-list*))
          (cpad-set-buzz! (-> *cpad-list* cpads 0) 1 (the int (* 255.0 feedback)) (seconds 0.25))))))
  (none))

(defun darkjak-emit-replica-attack-feedback! ((replica target) (observer target))
  (when (and replica (nonzero? replica) (-> replica darkjak) (nonzero? (-> replica darkjak)))
    (mp-darkjak-emit-spatial-feedback! replica
                                       observer
                                       (if (logtest? (-> replica darkjak stage) (darkjak-stage giant)) (meters 150.0) (meters 80.0))
                                       1.0))
  (none))

(defun darkjak-emit-replica-transform-feedback! ((replica target) (observer target))
  (mp-darkjak-emit-spatial-feedback! replica observer (meters 35.0) 0.75)
  (none))

(defun darkjak-update-replica-giant-feedback! ((replica target) (observer target) (raw-stage uint))
  (if (and (logtest? raw-stage (darkjak-stage active)) (logtest? raw-stage (darkjak-stage giant)))
    (when (and replica
               (nonzero? replica)
               (mp-target-jak? replica)
               observer
               (nonzero? observer)
               (focus-test? replica dark)
               (-> replica control)
               (nonzero? (-> replica control)))
      (let ((control (-> replica control)))
        (when (logtest? (-> control status) (collide-status on-surface))
          (let ((velocity (-> control transv)))
            (when (and velocity
                       (nonzero? velocity)
                       (> (+ (square (-> velocity x)) (square (-> velocity z))) (square (meters 2.0)))
                       (time-elapsed? *mp-darkjak-last-giant-step-feedback-time* (seconds 0.35)))
              (set-time! *mp-darkjak-last-giant-step-feedback-time*)
              (mp-darkjak-emit-spatial-feedback! replica observer (meters 35.0) 0.35))))))
    (set! *mp-darkjak-last-giant-step-feedback-time* (the-as time-frame 0)))
  (none))

(defun mp-darkjak-apply-remote-stage! ((replica target) (raw-stage uint))
  (when (and replica (nonzero? replica) (mp-target-jak? replica))
    (let ((stage (mp-darkjak-persistent-stage raw-stage))
          (state-name (if (and (-> replica state) (nonzero? (-> replica state))) (-> replica state name) #f)))
      (cond
        ((logtest? stage (darkjak-stage active))
         (if (and (focus-test? replica dark) (-> replica darkjak) (nonzero? (-> replica darkjak)))
           (begin
             (set! (-> replica darkjak stage) (the-as darkjak-stage stage))
             (set! (-> replica darkjak want-stage) (the-as darkjak-stage stage))
             (set! (-> replica darkjak-interp) 1.0)
             (set! (-> replica darkjak-giant-interp) (if (logtest? stage (darkjak-stage giant)) 2.0 1.0))
             (if (logtest? stage (darkjak-stage invinc))
               (logior! (-> replica state-flags) (state-flags sf4))
               (logclear! (-> replica state-flags) (state-flags sf4))))
           (when (!= state-name 'target-darkjak-get-on)
             (send-event replica
                         'change-mode
                         'darkjak
                         #f
                         (the-as darkjak-stage (logior stage (darkjak-stage no-anim force-on)))))))
        ((or (focus-test? replica dark) (= state-name 'target-darkjak-get-on))
         (when (!= state-name 'target-darkjak-get-off)
           (send-event replica 'change-mode 'normal #t))))))
  (none))

(defun darkjak-replica-action-compatible? ((replica target) (action-state symbol))
  (when (and replica (nonzero? replica) (focus-test? replica dark) (-> replica darkjak) (nonzero? (-> replica darkjak)))
    (let ((stage (-> replica darkjak stage)))
      (case action-state
        (('target-darkjak-running-attack) (return (logtest? stage (darkjak-stage active))))
        (('target-darkjak-bomb0) (return (logtest? stage (darkjak-stage bomb0))))
        (('target-darkjak-bomb1) (return (logtest? stage (darkjak-stage bomb1))))
        (('target-darkjak-giant)
         (return (or (logtest? stage (darkjak-stage giant))
                     (and (-> replica game)
                          (nonzero? (-> replica game))
                          (logtest? (-> replica game features) (game-feature darkjak-giant))))))
        (else (return #t)))))
  (case action-state
    (('target-darkjak-running-attack 'target-darkjak-bomb0 'target-darkjak-bomb1 'target-darkjak-giant) #f)
    (else #t)))
