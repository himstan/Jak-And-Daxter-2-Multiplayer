;;-*-Lisp-*-
(in-package goal)

(define-perm *mp-darkjak-last-giant-step-feedback-time* time-frame 0)

(defun mp-darkjak-session-active? ()
  (and *multi-sync-enabled?*
       (= (pc-multi-get-status) 6)
       )
  )

(defun mp-oracle-darkjak-training-participant? ()
  "Single-player and Jak perform Oracle training; Daxter observes host progress."
  (or (not (mp-darkjak-session-active?))
      (mp-is-jak?)
      )
  )

(defun mp-darkjak-persistent-stage ((stage uint))
  (the uint
       (logand stage
               (darkjak-stage active bomb0 bomb1 invinc giant)))
  )

(defun mp-darkjak-feedback-factor ((source target) (observer target) (outer-dist float))
  (if (and source
           (nonzero? source)
           observer
           (nonzero? observer)
           (-> source control)
           (nonzero? (-> source control))
           (-> observer control)
           (nonzero? (-> observer control)))
      (let ((dist (vector-vector-distance (-> source control trans) (-> observer control trans)))
            (inner-dist (meters 10.0)))
        (cond
          ((<= dist inner-dist) 1.0)
          ((>= dist outer-dist) 0.0)
          (else
            (/ (- outer-dist dist) (- outer-dist inner-dist))
            )
          )
        )
      0.0
      )
  )

(defun mp-darkjak-emit-spatial-feedback! ((source target) (observer target) (outer-dist float) (strength float))
  (when (and (mp-darkjak-session-active?)
             (mp-is-daxter?)
             source
             (nonzero? source)
             (= source *mp-puppet*)
             observer
             (nonzero? observer))
    (let ((feedback (* strength (mp-darkjak-feedback-factor source observer outer-dist))))
      (when (> feedback 0.0)
        (when (and *camera-smush-control*
                   (nonzero? *camera-smush-control*)
                   *display*
                   (nonzero? *display*))
          (activate!
            *camera-smush-control*
            (* 1638.4 feedback)
            15
            75
            1.0
            0.9
            (-> *display* camera-clock)
            )
          )
        (when (and *cpad-list*
                   (nonzero? *cpad-list*))
          (cpad-set-buzz!
            (-> *cpad-list* cpads 0)
            1
            (the int (* 255.0 feedback))
            (seconds 0.25)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-darkjak-emit-puppet-attack-feedback! ((puppet target) (observer target))
  (when (and puppet
             (nonzero? puppet)
             (-> puppet darkjak)
             (nonzero? (-> puppet darkjak)))
    (mp-darkjak-emit-spatial-feedback!
      puppet
      observer
      (if (logtest? (-> puppet darkjak stage) (darkjak-stage giant))
          (meters 150.0)
          (meters 80.0))
      1.0
      )
    )
  (none)
  )

(defun mp-darkjak-emit-puppet-transform-feedback! ((puppet target) (observer target))
  (mp-darkjak-emit-spatial-feedback! puppet observer (meters 35.0) 0.75)
  (none)
  )

(defun mp-darkjak-update-puppet-giant-feedback! ((puppet target) (observer target) (raw-stage uint))
  (if (and (logtest? raw-stage (darkjak-stage active))
           (logtest? raw-stage (darkjak-stage giant)))
      (when (and (mp-darkjak-session-active?)
                 (mp-is-daxter?)
                 puppet
                 (nonzero? puppet)
                 (= puppet *mp-puppet*)
                 observer
                 (nonzero? observer)
                 (focus-test? puppet dark)
                 (-> puppet control)
                 (nonzero? (-> puppet control)))
        (let ((control (-> puppet control)))
          (when (logtest? (-> control status) (collide-status on-surface))
            (let ((velocity (-> control transv)))
              (when (and velocity
                         (nonzero? velocity)
                         (> (+ (square (-> velocity x)) (square (-> velocity z)))
                            (square (meters 2.0)))
                         (time-elapsed? *mp-darkjak-last-giant-step-feedback-time* (seconds 0.35)))
                (set-time! *mp-darkjak-last-giant-step-feedback-time*)
                (mp-darkjak-emit-spatial-feedback! puppet observer (meters 35.0) 0.35)
                )
              )
            )
          )
        )
      (set! *mp-darkjak-last-giant-step-feedback-time* (the-as time-frame 0))
    )
  (none)
  )

(defun mp-darkjak-apply-remote-stage! ((puppet target) (raw-stage uint))
  "Converge the Jak puppet after dropped transform events, reconnects, or late spawns."
  (when (and (mp-darkjak-session-active?)
             (mp-is-daxter?)
             puppet
             (nonzero? puppet)
             (= puppet *mp-puppet*))
    (let ((stage (mp-darkjak-persistent-stage raw-stage))
          (state-name (if (and (-> puppet state)
                               (nonzero? (-> puppet state)))
                          (-> puppet state name)
                          #f)))
      (cond
        ((logtest? stage (darkjak-stage active))
         (if (and (focus-test? puppet dark)
                  (-> puppet darkjak)
                  (nonzero? (-> puppet darkjak)))
             (begin
               (set! (-> puppet darkjak stage) (the-as darkjak-stage stage))
               (set! (-> puppet darkjak want-stage) (the-as darkjak-stage stage))
               (set! (-> puppet darkjak-interp) 1.0)
               (set! (-> puppet darkjak-giant-interp)
                     (if (logtest? stage (darkjak-stage giant)) 2.0 1.0))
               (if (logtest? stage (darkjak-stage invinc))
                   (logior! (-> puppet state-flags) (state-flags sf4))
                   (logclear! (-> puppet state-flags) (state-flags sf4)))
               )
             (when (!= state-name 'target-darkjak-get-on)
               (send-event
                 puppet
                 'change-mode
                 'darkjak
                 #f
                 (the-as darkjak-stage (logior stage (darkjak-stage no-anim force-on)))
                 )
               )
             )
         )
        ((or (focus-test? puppet dark)
             (= state-name 'target-darkjak-get-on))
         (when (!= state-name 'target-darkjak-get-off)
           (send-event puppet 'change-mode 'normal #t)
           )
         )
        )
      )
    )
  (none)
  )

(defun mp-darkjak-puppet-action-compatible? ((puppet target) (action-state symbol))
  (when (and puppet
             (nonzero? puppet)
             (focus-test? puppet dark)
             (-> puppet darkjak)
             (nonzero? (-> puppet darkjak)))
    (let ((stage (-> puppet darkjak stage)))
      (case action-state
        (('target-darkjak-running-attack)
         (return (logtest? stage (darkjak-stage active)))
         )
        (('target-darkjak-bomb0)
         (return (logtest? stage (darkjak-stage bomb0)))
         )
        (('target-darkjak-bomb1)
         (return (logtest? stage (darkjak-stage bomb1)))
         )
        (('target-darkjak-giant)
         (return (or (logtest? stage (darkjak-stage giant))
                     (and (-> puppet game)
                          (nonzero? (-> puppet game))
                          (logtest? (-> puppet game features) (game-feature darkjak-giant)))))
         )
        (else
          (return #t)
          )
        )
      )
    )
  (case action-state
    (('target-darkjak-running-attack
      'target-darkjak-bomb0
      'target-darkjak-bomb1
      'target-darkjak-giant)
     #f
     )
    (else #t)
    )
  )
