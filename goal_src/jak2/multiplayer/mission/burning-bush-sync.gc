;;-*-Lisp-*-
(in-package goal)

(defconstant BUSH_COLLECT_ID_BASE (the uint #x78000000))
(defconstant BUSH_COLLECT_STRIDE 64)
(defconstant BUSH_COLLECT_ID_END (the uint #x78000100))
(defconstant BUSH_TALK_ID_BASE (the uint #x78100000))
(defconstant BUSH_TALK_ID_END (the uint #x78100400))
(defconstant BUSH_GOAL_ID_BASE (the uint #x78200000))
(defconstant BUSH_GOAL_ID_END (the uint #x78200400))
(defconstant BUSH_RING_FAIL_ID_BASE (the uint #x78300000))
(defconstant BUSH_RING_FAIL_ID_END (the uint #x78302000))
(defconstant BUSH_REWARD_ID_BASE (the uint #x78400000))
(defconstant BUSH_RACE_MENU_COUNT 7)
(defconstant BUSH_RING_FAILED 1)
(defconstant BUSH_RING_FINISHED 2)
(defconstant BUSH_TALK_RANGE (meters 30))

(defun bush-collect-aid ((collection int) (index int))
  (+ BUSH_COLLECT_ID_BASE (* collection BUSH_COLLECT_STRIDE) index))

(defun sync-bush-collectible! ((aid uint) (item process))
  (cond
    ((not (mp-session-in-game?)) (nonnull? item))
    ((mp-aid-dead-in-perm-list? aid)
     (when (nonnull? item)
       (deactivate item))
     #f)
    ((nonnull? item) #t)
    (else
     (mp-record-aid-dead-in-perm-list! aid)
     (mp-event-enqueue-aid! MP_EVENT_BREAK aid)
     #f)))

(defun bush-talk-scene ((node uint))
  (let ((nodes (-> *game-info* sub-task-list)))
    (when (< node (the uint (-> nodes length)))
      (let ((events (-> nodes node when-open)))
        (when (nonnull? events)
          (dotimes (index (-> events length))
            (let ((scene (-> events index scene)))
              (when (and (nonnull? scene) (type? scene string))
                (return (the-as string scene)))))))))
  (the-as string #f))

(defun broadcast-bush-talk! ((node game-task-node))
  (when (and (mp-session-in-game?) (mp-session-host?))
    (mp-event-enqueue-aid! MP_EVENT_BREAK (+ BUSH_TALK_ID_BASE (the uint node))))
  (none))

(defun receive-bush-talk! ((node uint))
  (let ((host (mp-host-player-record)))
    (when (and (mp-session-client?) (nonnull? *target* (-> *target* control) host))
      (if (< (vector-vector-distance (-> *target* control trans) (-> host transform position)) BUSH_TALK_RANGE)
        (let ((scene (bush-talk-scene node)))
          (when (nonnull? scene)
            (add-process *gui-control* *target* (gui-channel bbush) (gui-action play) scene -99.0 0)))
        (mp-teleport-local-target-to-player! host #f))))
  (none))

(defun report-bush-goal! ((node game-task-node))
  (mp-event-enqueue-aid! MP_EVENT_BREAK (+ BUSH_GOAL_ID_BASE (the uint node)))
  (none))

(defun bush-node-manager ((node uint))
  (when (and (mp-session-host?) (< node (the uint (-> *game-info* sub-task-list length))))
    (let ((manager (task-node-manager (-> *game-info* sub-task-list node))))
      (when (and (nonnull? manager (-> manager next-state)) (= (-> manager next-state name) 'active))
        (return manager))))
  (the-as task-manager #f))

(defun receive-bush-goal! ((node uint))
  (send-event (bush-node-manager node) 'bush-goal)
  (none))

(defun share-bush-orbs! ()
  (when (and (mp-session-in-game?) (mp-session-host?))
    (collectable-enqueue-pickup! MP_EVENT_ORB
                                 (+ BUSH_REWARD_ID_BASE (the uint (-> *game-info* skill-total)))
                                 (-> *game-info* skill)
                                 (-> *game-info* skill-total)))
  (none))

(defun award-bush-orbs! ()
  (when (not (mp-session-client?))
    (send-event *target* 'get-pickup (pickup-type skill) (-> *FACT-bank* super-skill-inc))
    (share-bush-orbs!))
  (none))

(defun play-remote-bush-win! ((node game-task-node))
  (let ((node-info (-> *game-info* sub-task-list node)))
    (when (and (mp-session-client?)
               (nonnull? node-info (-> node-info info) (-> node-info info on-complete))
               (string-prefix= "city-burning-bush-" (-> node-info name))
               (nonnull? (task-node-manager node-info)))
      (script-eval (-> node-info info on-complete))))
  (none))

(define *bush-race-menu-choice* 0)

(defun bush-race-menu-intro ((index int))
  (-> *game-info* sub-task-list (+ (the int (game-task-node stadium-burning-bush-race-board-introduction)) (* 2 index))))

(defun bush-race-menu-count ()
  (let ((count 0))
    (dotimes (index BUSH_RACE_MENU_COUNT)
      (let ((intro (bush-race-menu-intro index)))
        (when (or (open? intro) (logtest? (-> intro flags) (game-task-node-flag closed)))
          (+! count 1))))
    count))

(defun bush-race-menu-selected ()
  (let ((selected -1))
    (dotimes (index (bush-race-menu-count))
      (when (logtest? (-> (bush-race-menu-intro index) flags) (game-task-node-flag closed))
        (set! selected index)))
    selected))

(defun bush-race-menu-first-row ()
  (if (>= (bush-race-menu-selected) 0) -1 0))

(defun bush-race-menu-text ((choice int))
  (case choice
    ((-1) (text-id burning-bush-cancel-race))
    ((0) (text-id board-name))
    ((1) (text-id race-class3))
    ((2) (text-id race-class2))
    ((3) (text-id race-class1))
    ((4) (text-id reverse-race-class3))
    ((5) (text-id reverse-race-class2))
    (else (text-id reverse-race-class1))))

(defun open-bush-race-menu! ()
  (set! *bush-race-menu-choice* (max 0 (bush-race-menu-selected)))
  (none))

(defun move-bush-race-menu-choice! ((step int))
  (let ((choice (max (bush-race-menu-first-row) (min (+ *bush-race-menu-choice* step) (+ (bush-race-menu-count) -1)))))
    (when (!= choice *bush-race-menu-choice*)
      (set! *bush-race-menu-choice* choice)
      (sound-play "menu-up-down")))
  (none))

(defun commit-bush-race-choice! ()
  (let ((selected (bush-race-menu-selected)))
    (cond
      ((< *bush-race-menu-choice* 0)
       (when (>= selected 0)
         (open! (bush-race-menu-intro selected) 'event)))
      ((!= *bush-race-menu-choice* selected)
       (task-node-open! (the game-task-node (+ (the int (game-task-node stadium-burning-bush-race-board-resolution))
                                              (* 2 *bush-race-menu-choice*)))))))
  (none))

(defbehavior bush-ring-timed-out? task-manager ()
  (and (mp-session-in-game?)
       (nonzero? (-> self start-time))
       (< (-> self time-limit) (- (current-time) (-> self start-time)))))

(defbehavior bush-ring-fail-local! task-manager ()
  (set! (-> self data-int32 0) BUSH_RING_FAILED)
  (set! (-> self start-time) 0)
  (let ((ring (handle->process-safe (-> self slave 0))))
    (when (nonnull? ring)
      (deactivate ring)))
  (send-event (handle->process-safe (-> self hud-timer)) 'hide-and-die)
  (when (mp-session-client?)
    (mp-event-enqueue-aid! MP_EVENT_BREAK
                           (+ BUSH_RING_FAIL_ID_BASE (* (the uint (-> self info final-node)) 8) (mp-local-player-slot))))
  (none))

(defbehavior bush-ring-report-finish! task-manager ()
  (set! (-> self data-int32 0) BUSH_RING_FINISHED)
  (report-bush-goal! (-> self info final-node))
  (none))

(defbehavior bush-ring-all-failed? task-manager ()
  (when (not (and (mp-session-host?) (= (-> self data-int32 0) BUSH_RING_FAILED)))
    (return #f))
  (mp-for-each-player-record (player-slot record)
    (when (and (mp-remote-gameplay-player-connected? record) (not (logtest? (-> self data-int32 1) (ash 1 player-slot))))
      (return #f)))
  #t)

(defun receive-bush-ring-fail! ((id uint))
  (send-event (bush-node-manager (/ id 8)) 'bush-ring-fail (logand id 7))
  (none))

(defun sync-burning-bush! ((aid uint) (message symbol))
  (when (and (>= aid BUSH_COLLECT_ID_BASE) (< aid BUSH_COLLECT_ID_END))
    (when (= message 'synchronized?)
      (return (mp-aid-dead-in-perm-list? aid)))
    (mp-record-aid-dead-in-perm-list! aid)
    (return #t))
  (when (and (>= aid BUSH_TALK_ID_BASE) (< aid BUSH_TALK_ID_END))
    (when (= message 'synchronized?)
      (return #f))
    (receive-bush-talk! (- aid BUSH_TALK_ID_BASE))
    (return #t))
  (when (and (>= aid BUSH_GOAL_ID_BASE) (< aid BUSH_GOAL_ID_END))
    (when (= message 'synchronized?)
      (return #f))
    (receive-bush-goal! (- aid BUSH_GOAL_ID_BASE))
    (return #t))
  (when (and (>= aid BUSH_RING_FAIL_ID_BASE) (< aid BUSH_RING_FAIL_ID_END))
    (when (= message 'synchronized?)
      (return #f))
    (receive-bush-ring-fail! (- aid BUSH_RING_FAIL_ID_BASE))
    (return #t))
  #f)

(set! *actor-sync-handlers* (cons sync-burning-bush! *actor-sync-handlers*))
