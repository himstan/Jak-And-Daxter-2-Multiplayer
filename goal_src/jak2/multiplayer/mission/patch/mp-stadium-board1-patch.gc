;;-*-Lisp-*-
(in-package goal)


(deftype stadium-hud-multi-score (hud)
  ()
  )

(deftype skate-manager (process)
  ((scores                int32 MP_MAX_PLAYERS)
   (participants          uint8 MP_MAX_PLAYERS)
   (finished              uint8 MP_MAX_PLAYERS)
   (round-active?                symbol)
   (local-active?         symbol)
   (pending-remote-start? symbol)
   (pending-start-source-player-id uint32)
   (result-until          time-frame)
   (judge-handle                 handle)
   )
  (:state-methods
    active
    )
  )

(define *skate-manager* (the-as (pointer skate-manager) #f))

(defun mp-skate-manager-get ()
  (if (and *skate-manager* (nonzero? *skate-manager*))
      (the-as skate-manager (ppointer->process *skate-manager*))
      (the-as skate-manager #f))
  )

(defun mp-stadium-board1-player-participant? ((record mp-player-record))
  (and record
       (nonzero? record)
       (nonzero? (-> record identity joined?))
       (zero? (-> record identity spectator-only?)))
  )

(defun mp-skate-manager-valid-player-index? ((player-index int))
  (and (>= player-index 0)
       (< player-index MP_MAX_PLAYERS))
  )

(defun mp-stadium-board1-record-by-id ((player-id uint))
  (let ((player-index (the-as int player-id)))
    (if (mp-skate-manager-valid-player-index? player-index)
        (mp-player-record-by-id player-id)
        (the-as mp-player-record #f)))
  )

(defun mp-skate-manager-reset-round! ((manager skate-manager))
  (when (and manager (nonzero? manager))
    (dotimes (player-index MP_MAX_PLAYERS)
      (set! (-> manager scores player-index) 0)
      (set! (-> manager participants player-index) 0)
      (set! (-> manager finished player-index) 0)
      )
    (set! (-> manager round-active?) #f)
    (set! (-> manager local-active?) #f)
    (set! (-> manager pending-remote-start?) #f)
    (set! (-> manager pending-start-source-player-id) (the-as uint #f))
    (set! (-> manager result-until) (the-as time-frame 0)))
  (none)
  )

(defun mp-skate-manager-add-participant! ((manager skate-manager) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (when (and manager
               (nonzero? manager)
               (mp-skate-manager-valid-player-index? player-index))
      (let ((record (mp-stadium-board1-record-by-id player-id)))
        (when (mp-stadium-board1-player-participant? record)
          (set! (-> manager participants player-index) 1)))))
  (none)
  )

(defun mp-skate-manager-snapshot-round! ((manager skate-manager))
  (when (and manager (nonzero? manager))
    (mp-skate-manager-reset-round! manager)
    (set! (-> manager round-active?) #t)
    (mp-for-each-player-record (player-id record)
      (when (mp-stadium-board1-player-participant? record)
        (let ((player-index (the-as int player-id)))
          (when (mp-skate-manager-valid-player-index? player-index)
            (set! (-> manager participants player-index) 1))))))
  (none)
  )

(defun mp-skate-manager-round-participant? ((manager skate-manager) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (and manager
         (nonzero? manager)
         (mp-skate-manager-valid-player-index? player-index)
         (nonzero? (-> manager participants player-index))))
  )

(defun mp-skate-manager-event-player? ((manager skate-manager) (player-id uint))
  "Accept a current player or somebody already snapshotted into this round."
  (or (mp-skate-manager-round-participant? manager player-id)
      (mp-stadium-board1-player-participant?
        (mp-stadium-board1-record-by-id player-id)))
  )

(defun mp-stadium-board1-local-flag? ((flag mp-player-mission-flags))
  (mp-player-mission-flag? (mp-local-player-record) flag)
  )

(defun mp-stadium-board1-reset-player! ((record mp-player-record))
  (when (and record (nonzero? record))
    (mp-player-mission-clear-flag! record (mp-player-mission-flags stadium-board1-tutorial-done))
    (mp-player-mission-clear-flag! record (mp-player-mission-flags stadium-board1-tutorial-announced)))
  (none)
  )

(defun mp-stadium-board1-queue-event ((evt-id uint) (score int))
  (when (and *multi-sync-enabled?*
             (= (pc-multi-get-status) (mp-connection-status in-game))
             (not *mp-processing-remote-event*))
    (let ((local-player-record (mp-local-player-record)))
      (when (and local-player-record (nonzero? local-player-record))
        (mp-event-enqueue-stadium-board! evt-id (-> local-player-record identity player-id) score)))
    )
  (none)
  )

(defun mp-stadium-board1-reset ()
  (mp-for-each-player-record (player-id record)
    (mp-stadium-board1-reset-player! record))
  (let ((manager (mp-skate-manager-get)))
    (when (and manager (nonzero? manager))
      (mp-skate-manager-reset-round! manager)))
  (none)
  )

(defun mp-stadium-board1-mission-active? ()
  (and *multi-sync-enabled?*
       (= (pc-multi-get-status) (mp-connection-status in-game))
       (not (task-node-closed? (game-task-node stadium-board1-resolution))))
  )

(defun mp-stadium-board1-broadcast-tutorial-done! ()
  (let ((local-record (mp-local-player-record)))
    (when (and (mp-stadium-board1-mission-active?)
               local-record
               (nonzero? local-record)
               (mp-player-mission-flag? local-record (mp-player-mission-flags stadium-board1-tutorial-done))
               (not (mp-player-mission-flag? local-record (mp-player-mission-flags stadium-board1-tutorial-announced))))
      (mp-player-mission-set-flag! local-record (mp-player-mission-flags stadium-board1-tutorial-announced))
      (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Local player completed the tutorial. Broadcasting to all peers...~%")
      (mp-stadium-board1-queue-event MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE 0)))
  (none)
  )

(defun mp-stadium-board1-all-tutorials-done? ()
  (let ((found-player? #f))
    (mp-for-each-player-record (player-id record)
      (when (mp-stadium-board1-player-participant? record)
        (set! found-player? #t)
        (when (not (mp-player-mission-flag? record (mp-player-mission-flags stadium-board1-tutorial-done)))
          (return #f))))
    found-player?)
  )

(defun mp-stadium-board1-tutorials-ready? ()
  (if *multi-sync-enabled?*
      (mp-stadium-board1-all-tutorials-done?)
      (not (task-node-open? (game-task-node stadium-board1-training))))
  )

(defun mp-stadium-board1-should-wait-for-peer? ()
  (and (mp-stadium-board1-mission-active?)
       (mp-stadium-board1-local-flag? (mp-player-mission-flags stadium-board1-tutorial-done))
       (not (mp-stadium-board1-all-tutorials-done?)))
  )

(defun mp-stadium-board1-mark-tutorial-done! ()
  (let ((local-record (mp-local-player-record)))
    (when (and local-record (nonzero? local-record))
      (mp-player-mission-set-flag! local-record (mp-player-mission-flags stadium-board1-tutorial-done))
      (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Local player completed the tutorial.~%")
      (mp-stadium-board1-broadcast-tutorial-done!)))
  (none)
  )

(defun mp-stadium-board1-mark-player-tutorial-done! ((player-id uint))
  (let ((record (mp-stadium-board1-record-by-id player-id)))
    (when (and record (nonzero? record))
      (mp-player-mission-set-flag! record (mp-player-mission-flags stadium-board1-tutorial-done))
      (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Player ~D completed the tutorial.~%" player-id)))
  (none)
  )

(defun mp-stadium-board1-current-local-score ()
  (if (and *game-info* (nonzero? *game-info*))
      (the int (-> *game-info* score))
      0)
  )

(defun mp-stadium-board1-challenge-active? ()
  (let ((manager (mp-skate-manager-get)))
    (return (the-as symbol (and manager
         (nonzero? manager)
         (-> manager local-active?)))))
  #f
  )

(defun mp-stadium-board1-local-finished? ()
  (let ((manager (mp-skate-manager-get))
        (player-index (the-as int (mp-local-player-id))))
    (the-as symbol (and manager
         (nonzero? manager)
         (mp-skate-manager-valid-player-index? player-index)
         (nonzero? (-> manager participants player-index))
         (nonzero? (-> manager finished player-index)))))
  #f
  )

(defun mp-stadium-board1-start-challenge! ((send-event? symbol))
  (let ((manager (mp-skate-manager-get))
        (local-record (mp-local-player-record)))
    (debug-log *mp-debug-log?*
      "[MP-StadiumBoard1] Starting local challenge. Mission active?: ~A, Manager: ~A, Local active?: ~A, Send event: ~A~%"
      (mp-stadium-board1-mission-active?)
      manager
      (mp-stadium-board1-challenge-active?)
      send-event?)
    (when (and manager
               (nonzero? manager)
               local-record
               (nonzero? local-record)
               (mp-stadium-board1-mission-active?))
      (let ((was-local-active? (-> manager local-active?)))
        (when (not (-> manager round-active?))
          (mp-skate-manager-snapshot-round! manager))
        (mp-skate-manager-add-participant! manager (-> local-record identity player-id))
        (let ((player-index (the-as int (-> local-record identity player-id))))
          (when (mp-skate-manager-valid-player-index? player-index)
            (set! (-> manager finished player-index) 0)))
        (set! (-> manager local-active?) #t)
        (set! (-> manager pending-remote-start?) #f)
        (set! (-> manager pending-start-source-player-id) (the-as uint #f))
        (when (and send-event? (not was-local-active?))
          (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Broadcasting challenge start to all peers...~%")
          (mp-stadium-board1-queue-event MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START 0)))))
  (none)
  )

(defun mp-stadium-board1-local-judge-activated! ((send-event? symbol))
  (mp-stadium-board1-start-challenge! send-event?)
  (none)
  )

(defun mp-stadium-board1-set-judge! ((judge-handle handle))
  (let ((manager (mp-skate-manager-get)))
    (when (and manager (nonzero? manager))
      (set! (-> manager judge-handle) judge-handle)))
  (none)
  )

(defun mp-stadium-board1-try-remote-start-judge! ((source-record mp-player-record))
  (let ((manager (mp-skate-manager-get))
        (source-target (mp-player-record-target source-record)))
    (when (and manager
               (nonzero? manager)
               (-> manager pending-remote-start?)
               (not (-> manager local-active?)))
      (let ((judge-proc (handle->process-safe (-> manager judge-handle))))
        (when (and judge-proc
                   (nonzero? judge-proc)
                   source-target
                   (nonzero? source-target))
          (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Delivering pending challenge start to judge ~A.~%" (-> manager judge-handle))
          (set! (-> manager pending-remote-start?) #f)
          (set! (-> manager pending-start-source-player-id) (the-as uint #f))
          (send-event judge-proc 'mp-start :from source-target)))))
  (none)
  )

(defun mp-stadium-board1-remote-start! ((player-id uint))
  (let ((manager (mp-skate-manager-get))
        (source-record (mp-stadium-board1-record-by-id player-id)))
    (when (and manager
               (nonzero? manager)
               (mp-stadium-board1-player-participant? source-record))
      (when (not (-> manager round-active?))
        (mp-skate-manager-snapshot-round! manager))
      (mp-skate-manager-add-participant! manager player-id)
      (when (not (-> manager local-active?))
        (set! (-> manager pending-remote-start?) #t)
        (set! (-> manager pending-start-source-player-id) player-id)
        (mp-stadium-board1-try-remote-start-judge! source-record))))
  (none)
  )

(defun mp-stadium-board1-player-score ((player-id uint))
  (let ((manager (mp-skate-manager-get))
        (player-index (the-as int player-id)))
    (if (and manager (nonzero? manager) (mp-skate-manager-valid-player-index? player-index))
      (the int (-> manager scores player-index))
      0
      )
    )
  )

(defun mp-stadium-board1-effective-score ()
  (let ((best-score (mp-stadium-board1-current-local-score))
        (manager (mp-skate-manager-get)))
    (when (and *multi-sync-enabled?* manager (nonzero? manager))
      (dotimes (player-index MP_MAX_PLAYERS)
        (when (nonzero? (-> manager participants player-index))
          (let ((score (mp-stadium-board1-player-score (the-as uint player-index))))
            (when (> score best-score)
              (set! best-score score))))))
    best-score)
  )

(defun mp-stadium-board1-broadcast-score! ((score int) (force? symbol))
  (let ((manager (mp-skate-manager-get))
        (local-record (mp-local-player-record)))
    (when (and manager
               (nonzero? manager)
               local-record
               (nonzero? local-record)
               (-> manager local-active?))
      (let* ((player-id (-> local-record identity player-id))
             (player-index (the-as int player-id)))
        (when (mp-skate-manager-valid-player-index? player-index)
          (let ((previous-score (the int (-> manager scores player-index))))
            (when (and *multi-sync-enabled?*
                       (= (pc-multi-get-status) (mp-connection-status in-game))
                       (or force? (!= score previous-score)))
              (debug-log *mp-debug-log?*
                "[MP-StadiumBoard1] Broadcasting score update. Player: ~D, Score: ~D, Previous: ~D, Force: ~A~%"
                player-id score previous-score force?)
              (set! (-> manager scores player-index) score)
              (mp-stadium-board1-queue-event MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE score)))))))
  (none)
  )

(defun mp-stadium-board1-update-player-score! ((player-id uint) (score int))
  (let ((manager (mp-skate-manager-get))
        (player-index (the-as int player-id)))
    (when (and manager
               (nonzero? manager)
               (mp-skate-manager-valid-player-index? player-index)
               (mp-skate-manager-event-player? manager player-id)
               (zero? (-> manager result-until)))
      (when (not (-> manager round-active?))
        (mp-skate-manager-snapshot-round! manager))
      (mp-skate-manager-add-participant! manager player-id)
      (when (zero? (-> manager finished player-index))
        (set! (-> manager scores player-index) score))))
  (none)
  )

(defun mp-stadium-board1-all-players-finished? ()
  (let ((manager (mp-skate-manager-get))
        (found-player? #f))
    (when (and manager (nonzero? manager))
      (dotimes (player-index MP_MAX_PLAYERS)
        (when (nonzero? (-> manager participants player-index))
          (set! found-player? #t)
          (when (zero? (-> manager finished player-index))
            (let ((record (mp-stadium-board1-record-by-id (the-as uint player-index))))
              (when (mp-stadium-board1-player-participant? record)
                (return #f)))))))
    found-player?)
  )

(defun mp-stadium-board1-set-result! ()
  (let ((manager (mp-skate-manager-get)))
    (when (and manager
               (nonzero? manager)
               (zero? (-> manager result-until))
               (mp-stadium-board1-all-players-finished?))
      (set! (-> manager result-until) (+ (current-time) (seconds 10)))
      (set! (-> manager round-active?) #f)
      (set! (-> manager pending-remote-start?) #f)
      (set! (-> manager pending-start-source-player-id) (the-as uint #f))))
  (none)
  )

(defun mp-stadium-board1-finish-player! ((player-id uint) (score int))
  "Apply one player's final score without ending anybody else's local challenge."
  (let ((manager (mp-skate-manager-get))
        (player-index (the-as int player-id)))
    (when (and manager
               (nonzero? manager)
               (mp-skate-manager-valid-player-index? player-index)
               (mp-skate-manager-event-player? manager player-id)
               (zero? (-> manager result-until)))
      (when (not (-> manager round-active?))
        (mp-skate-manager-snapshot-round! manager))
      (mp-skate-manager-add-participant! manager player-id)
      (set! (-> manager scores player-index) score)
      (set! (-> manager finished player-index) 1)
      (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Player ~D finished with score ~D.~%" player-id score)
      (mp-stadium-board1-set-result!)))
  (none)
  )

(defun mp-stadium-board1-finish-local-challenge! ((send-event? symbol))
  (let ((manager (mp-skate-manager-get))
        (local-record (mp-local-player-record))
        (score (mp-stadium-board1-current-local-score)))
    (when (and manager
               (nonzero? manager)
               local-record
               (nonzero? local-record))
      (let* ((player-id (-> local-record identity player-id))
             (player-index (the-as int player-id)))
        (when (mp-skate-manager-valid-player-index? player-index)
          (when (not (-> manager round-active?))
            (mp-skate-manager-snapshot-round! manager))
          (mp-skate-manager-add-participant! manager player-id)
          (when (-> manager local-active?)
            (mp-stadium-board1-broadcast-score! score #t))
          (set! (-> manager scores player-index) score)
          (set! (-> manager finished player-index) 1)
          (set! (-> manager local-active?) #f)
          (when send-event?
            (mp-stadium-board1-queue-event MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END score))))))
  (none)
  )

(defun mp-stadium-board1-post-challenge-finished! ((send-event? symbol))
  (when (not (mp-stadium-board1-local-finished?))
    (mp-stadium-board1-finish-local-challenge! send-event?))
  (let ((manager (mp-skate-manager-get)))
    (when (and manager (nonzero? manager))
      (set! (-> manager pending-remote-start?) #f)
      (set! (-> manager pending-start-source-player-id) (the-as uint #f))))
  (mp-stadium-board1-set-result!)
  (none)
  )

(defun mp-stadium-board1-render-waiting-text ()
  (when (mp-stadium-board1-should-wait-for-peer?)
    (let ((ctx (new 'stack 'font-context *font-default-matrix* 32 280 0.0 (font-color default) (font-flags shadow kerning large))))
      (set-width! ctx 520)
      (set-height! ctx 80)
      (set-scale! ctx 0.5)
      (print-game-text (lookup-text! *common-text* (text-id stadium-waiting-for-other-player) #f) ctx #f 44 (bucket-id progress))
      )
    )
  (none)
  )

(defun mp-stadium-board1-winner-player ()
  "Returns the player with the highest score from the skate-manager"
  (let ((best-player (the-as mp-player-record #f))
        (best-score -1)
        (manager (mp-skate-manager-get)))
    (when (and manager (nonzero? manager))
      (mp-for-each-player-record (player-id record)
        (when (nonzero? (-> manager participants player-id))
          (let ((score (the int (-> manager scores player-id))))
            (when (> score best-score)
              (set! best-score score)
              (set! best-player record)
              )
            )
          )
        )
      )
    best-player
    )
  )

(defun mp-stadium-board1-render-result-text ()
  (when (mp-stadium-board1-local-finished?)
    (mp-stadium-board1-set-result!)
    )
  (let ((manager (mp-skate-manager-get)))
    (when (and manager
               (nonzero? manager)
               (nonzero? (-> manager result-until))
               (< (current-time) (-> manager result-until)))
      (let ((winner (mp-stadium-board1-winner-player))
            (popup-text (new 'global 'string 64 (the-as string #f)))
            (player-name (new 'global 'string 64 (the-as string #f)))
            (ctx (new 'stack 'font-context *font-default-matrix* 32 240 0.0 (font-color default) (font-flags shadow kerning large))))
        (when (and winner (nonzero? winner))
          (set-width! ctx 520)
          (set-height! ctx 80)
          (set-scale! ctx 0.75)
          (format (clear popup-text) (lookup-text! *common-text* (text-id stadium-player-won) #f) (mp-player-copy-name! player-name (-> winner identity player-id)))
          (print-game-text popup-text ctx #f 44 (bucket-id progress))
          )
        )
      )
    )
  (none)
  )

(defun mp-skate-manager-update! ((manager skate-manager))
  "Per-frame stadium synchronization owned by the manager process."
  (when (and manager (nonzero? manager))
    (when (-> manager pending-remote-start?)
      (let ((source-record (mp-player-record-by-id (-> manager pending-start-source-player-id))))
        (when source-record
          (mp-stadium-board1-try-remote-start-judge! source-record)
          )
        )
    )
    (when (and (mp-stadium-board1-mission-active?)
               (-> manager local-active?))
      (mp-stadium-board1-broadcast-score! (mp-stadium-board1-current-local-score) #f))
    (when (-> manager round-active?)
      (mp-stadium-board1-set-result!)))
  (none)
  )

(defstate active (skate-manager)
  :virtual #t
  :code sleep-code
  :post (behavior ()
    (mp-skate-manager-update! self))
  )

(defmethod deactivate ((this skate-manager))
  "Clear the singleton pointer when the mission-local manager leaves its parent tree."
  (set! *skate-manager* (the-as (pointer skate-manager) #f))
  (call-parent-method this)
  (none)
  )

(defbehavior skate-manager-init-by-other skate-manager ((unused symbol))
  (mp-skate-manager-reset-round! self)
  (set! (-> self judge-handle) (the-as handle #f))
  (set! *skate-manager* (the-as (pointer skate-manager) (process->ppointer self)))
  (go-virtual active)
  (none)
  )

(defun mp-skate-manager-start! ((parent process))
  "Spawn one lightweight stadium manager below the hoverboard training manager."
  (when (not (mp-skate-manager-get))
    (let ((spawn-result
            (process-spawn skate-manager #f :to (the-as process-tree parent))))
      (when (not spawn-result)
        (debug-log *mp-debug-log?* "[MP-StadiumBoard1] Failed to spawn skate-manager.~%"))))
  (none)
  )

(defun init-hud-for-players ((hud stadium-hud-multi-score))
  (mp-for-each-player-record (player-id record)
    (set! (-> hud sprites player-id tex) (get-texture hud-scoreboard-01 level-default-minimap))
    (set! (-> hud sprites player-id scale-x) 1.5)
    (set! (-> hud sprites player-id flags) (the-as uint 4))
    (alloc-string-if-needed hud player-id)                        
    (set! (-> hud strings player-id scale) 0.5)
    (set! (-> hud strings player-id flags) (font-flags kerning right large))
    (set! (-> hud strings player-id color) (mp-player-font-color-by-id player-id))
    )
  )

(define *local-score-hud-x* 115)
(define *local-score-hud-y* 90)

(defun draw-hud-for-players ((hud stadium-hud-multi-score))
  (let ((remote-hud-y 140))
    (mp-for-each-player-record (player-id record)
      (if (= player-id (mp-local-player-id))
        (set-hud-piece-position!
          (-> hud sprites player-id)
          *local-score-hud-x*
          *local-score-hud-y*
          )
        (begin
          (set-hud-piece-position!
            (-> hud sprites player-id)
            480
            remote-hud-y
            )
          (+! remote-hud-y 30)
          )
        )
      (format (clear (-> hud strings player-id text)) "~D" (-> hud values player-id current))
      (set-as-offset-from! (the-as hud-sprite (-> hud strings player-id pos)) (the-as vector4w (-> hud sprites player-id)) -12 8)
      )
    )
  )

(defmethod draw ((this stadium-hud-multi-score))
  (draw-hud-for-players this)
  ((method-of-type hud draw) this)
  0
  (none)
  )

(defmethod update-values ((this stadium-hud-multi-score))
  (mp-for-each-player-record (player-id record)
    (set! (-> this values player-id target) (mp-stadium-board1-player-score (the-as uint player-id)))
    )
  ((method-of-type hud update-values) this)
  0
  (none)
  )

(defmethod init-callback ((this stadium-hud-multi-score))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-center-right) (gui-action hidden) (-> this name) 81920.0 0)
        )
  (logior! (-> this flags) (hud-flags show))
  (init-hud-for-players this)
  (none)
  )
