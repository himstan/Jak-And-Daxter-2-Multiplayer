;;-*-Lisp-*-
(in-package goal)

(defconstant DEFEND_STADIUM_STAGE_MOVE 1)
(defconstant DEFEND_STADIUM_STAGE_LAND 2)
(defconstant DEFEND_STADIUM_STAGE_DONE 3)
(defconstant DEFEND_STADIUM_STAGE_DIE 4)

(define *defend-stadium-host* (new 'static 'defend-stadium-state-data))
(define *defend-stadium-sent* (new 'static 'defend-stadium-state-data))
(define *defend-stadium-sent-time* (the-as time-frame 0))
(define *defend-stadium-samos-trans* (new 'static 'inline-array vector 2))

(defun defend-stadium-pack-offset ((offset float))
  (max -32767 (min 32767 (the int (/ offset 128.0)))))

(defun defend-stadium-health-byte ((index int))
  (let ((ratio (-> *game-info* bot-health index)))
    (if (<= ratio 0.0)
        0
        (max 1 (min 255 (the int (+ 0.5 (* 255.0 ratio))))))))

(defun defend-stadium-state-changed? ((stage int) (health0 int) (health1 int))
  (let ((sent *defend-stadium-sent*))
    (or (!= stage (-> sent stage))
        (!= health0 (-> sent health 0))
        (!= health1 (-> sent health 1))
        (time-elapsed? *defend-stadium-sent-time* (seconds 0.1)))))

(defun send-defend-stadium-state! ((stage int) (trans vector) (quat quaternion))
  (when (mp-session-host?)
    (let ((health0 (defend-stadium-health-byte 0))
          (health1 (defend-stadium-health-byte 1))
          (sent *defend-stadium-sent*))
      (when (defend-stadium-state-changed? stage health0 health1)
        (set! (-> sent stage) stage)
        (set! (-> sent health 0) health0)
        (set! (-> sent health 1) health1)
        (dotimes (index 3)
          (set! (-> sent trans index) (-> trans data index)))
        (dotimes (index 4)
          (set! (-> sent quat index) (the int (* 32767.0 (-> quat data index)))))
        (dotimes (index 6)
          (let ((axis (mod index 3)))
            (set! (-> sent samos index)
                  (defend-stadium-pack-offset (- (-> *defend-stadium-samos-trans* (/ index 3) data axis) (-> trans data axis))))))
        (set! *defend-stadium-sent-time* (current-time))
        (let ((event (new 'stack-no-clear 'defend-stadium-state-event)))
          (when (mp-event-prepare! event MP_EVENT_DEFEND_STADIUM_STATE)
            (mem-copy! (the-as pointer (-> event payload)) (the-as pointer sent) (size-of defend-stadium-state-data))
            (mp-event-enqueue! event))))))
  (none))

(defun receive-defend-stadium-state! ((event defend-stadium-state-event))
  (when (and (mp-session-client?) (nonnull? event) (= (-> event source-player-slot) (mp-host-player-slot)))
    (mem-copy! (the-as pointer *defend-stadium-host*) (the-as pointer (-> event payload)) (size-of defend-stadium-state-data))
    (let ((rider (entity-by-name "rift-rider-5")))
      (when (nonnull? rider)
        (dotimes (index 2)
          (let ((escort (entity-actor-lookup rider 'alt-actor index)))
            (when (nonnull? escort)
              (send-event (-> escort extra process) 'mp-health))))
        (send-event (-> rider extra process) 'mp-host-state))))
  (none))

(defun defend-stadium-host-transform! ((trans vector) (quat quaternion))
  (let ((host *defend-stadium-host*))
    (set-vector! trans (-> host trans 0) (-> host trans 1) (-> host trans 2) 1.0)
    (dotimes (index 4)
      (set! (-> quat data index) (/ (the float (-> host quat index)) 32767.0)))
    (quaternion-normalize! quat))
  (none))

(defun defend-stadium-host-samos-trans! ((index int) (out vector))
  (let ((host *defend-stadium-host*))
    (dotimes (axis 3)
      (set! (-> out data axis) (+ (-> host trans axis) (* 128.0 (the float (-> host samos (+ (* index 3) axis))))))))
  (set! (-> out w) 1.0)
  out)

(defun defend-stadium-host-health ((index int))
  (/ (the float (-> *defend-stadium-host* health index)) 255.0))

(defun distance-behind ((origin vector) (pos vector) (forward vector))
  (fmax 0.0 (- (vector-dot (vector-! (new 'stack-no-clear 'vector) pos origin) forward))))

(defun defend-stadium-trailing-distance ((origin vector) (forward vector))
  (when (not (mp-session-in-game?))
    (return (distance-behind origin (target-pos 0) forward)))
  (let ((level-id (mp-player-primary-level-id (mp-local-player-record)))
        (best (meters 1000000.0)))
    (mp-for-each-player-record (player-slot record)
      (when (mp-enemy-player-eligible? record level-id)
        (let ((pos (mp-player-record-position record)))
          (when (nonnull? pos)
            (set! best (fmin best (distance-behind origin pos forward)))))))
    best))
