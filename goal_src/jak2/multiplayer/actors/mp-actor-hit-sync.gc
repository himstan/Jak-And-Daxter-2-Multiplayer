;;-*-Lisp-*-
(in-package goal)

(define *mp-actor-remote-attack-event* (the-as mp-actor-attack-event #f))
(define *mp-current-remote-hit-sound-id* (the-as uint32 0))

(defun mp-hit-sound-id-from-attack-mode ((mode symbol))
  (cond
    ((or (= mode 'spin) (= mode 'spin-air)) (the-as uint (mp-hit-sound-id spin)))
    ((or (= mode 'punch) (= mode 'flip) (= mode 'flut-attack)) (the-as uint (mp-hit-sound-id punch)))
    ((= mode 'uppercut) (the-as uint (mp-hit-sound-id uppercut)))
    ((or (= mode 'flop) (= mode 'flop-down)) (the-as uint (mp-hit-sound-id flop)))
    ((= mode 'board-spin) (the-as uint (mp-hit-sound-id board-spin)))
    ((= mode 'mech-punch) (the-as uint (mp-hit-sound-id mech-punch)))
    (else (the-as uint (mp-hit-sound-id none)))))

(defun mp-hit-sound-id-from-attack-info ((info attack-info))
  (if (and info (nonzero? info)) (mp-hit-sound-id-from-attack-mode (-> info mode)) (the-as uint (mp-hit-sound-id none))))

(defun mp-play-remote-hit-sound! ((e-proc enemy) (hit-sound-id uint))
  (when (and e-proc (nonzero? e-proc) (-> e-proc root) (nonzero? (-> e-proc root)))
    (case hit-sound-id
      (((the-as uint (mp-hit-sound-id spin)))
       (sound-play-by-spec (static-sound-spec "spin-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))
      (((the-as uint (mp-hit-sound-id punch)))
       (sound-play-by-spec (static-sound-spec "punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))
      (((the-as uint (mp-hit-sound-id uppercut)))
       (sound-play-by-spec (static-sound-spec "uppercut-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))
      (((the-as uint (mp-hit-sound-id flop)))
       (sound-play-by-spec (static-sound-spec "flop-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))
      (((the-as uint (mp-hit-sound-id board-spin)))
       (sound-play-by-spec (static-sound-spec "board-impact" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))
      (((the-as uint (mp-hit-sound-id mech-punch)))
       (sound-play-by-spec (static-sound-spec "mech-punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans))
                           (new-sound-id)
                           (-> e-proc root trans)))))
  (none))

(defun mp-is-local-attacker? ((proc process))
  (if (or (not proc) (zero? proc)) (return #f))
  (let ((curr proc))
    (while (and curr (nonzero? curr))
      (if (= curr *target*) (return #t))
      (set! curr
            (if (and (-> curr parent) (nonzero? (-> curr parent)))
              (the-as process (ppointer->process (-> curr parent)))
              (the-as process #f)))))
  #f)

(defun mp-remote-attacker-record ((proc process))
  (when (and proc (nonzero? proc))
    (let ((curr proc))
      (while (and curr (nonzero? curr))
        (let ((record (mp-player-process-record curr)))
          (when (and record (nonzero? record) (is-record-remote-player? record))
            (return record)))
        (set! curr
              (if (and (-> curr parent) (nonzero? (-> curr parent)))
                (the-as process (ppointer->process (-> curr parent)))
                (the-as process #f))))))
  (the-as mp-player-record #f))

(defun mp-is-remote-attacker? ((proc process))
  (let ((record (mp-remote-attacker-record proc))) (if (and record (nonzero? record)) #t #f)))

(defun mp-actor-event-attack-info ((msg event-message-block))
  (if (and msg (nonzero? msg) (nonzero? (-> msg param 1))) (the-as attack-info (-> msg param 1)) (the-as attack-info #f)))

(defun mp-actor-attack-info-mode? ((info attack-info) (mode symbol))
  (and info (nonzero? info) (= (-> info mode) mode)))

(defun mp-actor-attack-id-usable? ((info attack-info))
  (and info (nonzero? info) (nonzero? (-> info id))))

(defun mp-actor-remote-attacker-blocked? ((attacker process) (remote-replay? symbol))
  (and (not remote-replay?) (mp-is-remote-attacker? attacker)))

(defun mp-actor-remote-attack-info? ((info attack-info))
  (mp-actor-attack-info-mode? info 'mp-hit-remote))

(defun mp-actor-local-attack-blocked? ((last-local-attack-id uint)
                                       (last-local-attack-time time-frame)
                                       (info attack-info))
  (if (mp-actor-attack-id-usable? info)
    (return (and (= (-> info id) last-local-attack-id) (not (time-elapsed? last-local-attack-time (seconds 0.75))))))
  (not (time-elapsed? last-local-attack-time (seconds 0.2))))

(defun mp-actor-local-hit-fatal? ((e-proc enemy) (attacker process) (arg3 event-message-block))
  (and (nonnull? e-proc attacker arg3) (<= (-> e-proc hit-points) (damage-amount-from-attack e-proc attacker arg3))))

(defun mp-actor-fill-attack-info-from-event! ((atk attack-info) (evt mp-actor-attack-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (set! (-> atk mask)
        (attack-mask id mode damage shove-back shove-up knock vector intersection attacker-velocity penetrate-using))
  (set! (-> atk id) (if (nonzero? (-> evt payload attack-id)) (-> evt payload attack-id) (new-attack-id)))
  (set! (-> atk mode) 'mp-hit-remote)
  (set! (-> atk damage) 0.0)
  (set! (-> atk shove-back) (-> evt payload shove-back))
  (set! (-> atk shove-up) (-> evt payload shove-up))
  (set! (-> atk knock) (the-as knocked-type (-> evt payload knocked-type)))
  (set! (-> atk penetrate-using) (the-as penetrate (-> evt payload penetrate)))
  (set! (-> atk intersection quad) (-> evt payload source-pos quad))
  (set! (-> atk vector quad) (-> evt payload attack-dir quad))
  (set! (-> atk attacker-velocity quad) (-> evt payload attack-dir quad))
  (none))

(defun mp-actor-restore-context! ((e-proc enemy)
                                  (flags uint)
                                  (knocked-type uint)
                                  (source-pos vector)
                                  (attack-dir vector))
  (when (and e-proc (nonzero? e-proc))
    (set! (-> e-proc incoming knocked-type) (the-as knocked-type knocked-type))
    (when (logtest? flags MP_ACTOR_ATTACK_HAS_SOURCE_POS)
      (set! (-> e-proc incoming attacker-pos quad) (-> source-pos quad)))
    (when (logtest? flags MP_ACTOR_ATTACK_HAS_DIRECTION)
      (set! (-> e-proc incoming attack-direction quad) (-> attack-dir quad))))
  (none))

(defun remote-darkjak-melee-hit? ((attacker process) (evt mp-actor-attack-event))
  (and (nonnull? attacker evt)
       (type? attacker target)
       (logtest? (-> evt payload penetrate) (penetrate dark-skin dark-punch))
       (logtest? (-> evt payload penetrate) (penetrate punch spin flop uppercut roll bonk lunge))))

(defun mp-actor-apply-authoritative-remote-damage! ((e-proc enemy)
                                                    (attacker process)
                                                    (evt mp-actor-attack-event)
                                                    (label symbol))
  (when (not (nonnull? evt))
    (return #f))
  (when (or (not e-proc) (not (nonzero? e-proc)))
    (log 'debug
         "[MP-ActorHit] Remote ~A hit blocked: missing proc nid=~D attack-id=~D~%"
         label
         (-> evt payload net-id)
         (-> evt payload attack-id))
    (return #f))
  (when (or (not attacker) (not (nonzero? attacker)) (not (type? attacker process-drawable)))
    (log 'debug
         "[MP-ActorHit] Remote ~A hit blocked: missing attacker nid=~D attack-id=~D~%"
         label
         (-> evt payload net-id)
         (-> evt payload attack-id))
    (return #f))
  (when (<= (-> e-proc hit-points) 0)
    (log 'debug
         "[MP-ActorHit] Remote ~A hit blocked: already dead nid=~D attack-id=~D~%"
         label
         (-> evt payload net-id)
         (-> evt payload attack-id))
    (return #f))
  (when (logtest? (-> e-proc focus-status) (focus-status grabbed))
    (log 'debug
         "[MP-ActorHit] Remote ~A hit blocked: grabbed nid=~D attack-id=~D~%"
         label
         (-> evt payload net-id)
         (-> evt payload attack-id))
    (return #f))
  (let ((atk (new 'stack-no-clear 'attack-info))
        (old-hp (-> e-proc hit-points))
        (darkjak-hit? (remote-darkjak-melee-hit? attacker evt))
        (old-remote-context *mp-processing-remote-event*)
        (old-attack-event *mp-actor-remote-attack-event*))
    (mp-actor-fill-attack-info-from-event! atk evt)
    (set! (-> atk damage) (the float (max 0 (- old-hp (-> evt payload new-hp)))))
    (set! *mp-actor-remote-attack-event* evt)
    (mp-actor-restore-context! e-proc
                               (-> evt payload flags)
                               (-> evt payload knocked-type)
                               (-> evt payload source-pos)
                               (-> evt payload attack-dir))
    (set! *mp-processing-remote-event* #t)
    (send-event e-proc 'attack attacker atk)
    (when darkjak-hit?
      (start-darkjak-hit-effect! (the-as target attacker) e-proc))
    (let ((authoritative-hp (max 0 (-> evt payload new-hp))))
      (when (!= (-> e-proc hit-points) authoritative-hp)
        (set! (-> e-proc hit-points) authoritative-hp))
      (when (and (= label 'enemy) (zero? authoritative-hp))
        (mp-battle-note-enemy-death! e-proc)
        (let ((aid (mp-get-enemy-aid e-proc)))
          (logior! (-> e-proc enemy-flags) (enemy-flag stop-syncing))
          (when (nonzero? aid)
            (mp-mark-aid-dead-perm! aid)
            (log 'debug
                 "[MP-ActorHit] Fatal remote enemy hit finalized nid=~D aid=~D new-hp=0~%"
                 (-> evt payload net-id)
                 aid)))))
    (let ((damage-taken (max 0 (- old-hp (-> evt payload new-hp)))))
      (when (> damage-taken 0)
        (mp-play-remote-hit-sound! e-proc (-> evt payload hit-sound-id)))
      (log 'debug
           "[MP-ActorHit] Remote ~A hit applied nid=~D attack-id=~D damage=~D hp=~D->~D~%"
           label
           (-> evt payload net-id)
           (-> evt payload attack-id)
           damage-taken
           old-hp
           (-> e-proc hit-points)))
    (set! *mp-processing-remote-event* old-remote-context)
    (set! *mp-actor-remote-attack-event* old-attack-event))
  #t)

(defun mp-actor-capture-source-pos! ((details mp-ped-attack-event-data)
                                     (e-proc enemy)
                                     (attacker process)
                                     (info attack-info))
  (set! (-> details flags) (the-as uint8 0))
  (cond
    ((and info (nonzero? info) (logtest? (attack-mask intersection) (-> info mask)))
     (set! (-> details source-pos quad) (-> info intersection quad))
     (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS))
    ((and attacker
          (nonzero? attacker)
          (type? attacker process-drawable)
          (-> (the-as process-drawable attacker) root)
          (nonzero? (-> (the-as process-drawable attacker) root)))
     (set! (-> details source-pos quad) (-> (the-as process-drawable attacker) root trans quad))
     (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS))
    ((and e-proc (nonzero? e-proc) (-> e-proc root) (nonzero? (-> e-proc root)))
     (set! (-> details source-pos quad) (-> e-proc root trans quad)))
    (else (set-vector! (-> details source-pos) 0.0 0.0 0.0 1.0)))
  (none))

(defun mp-actor-capture-attack-dir! ((details mp-ped-attack-event-data) (e-proc enemy) (info attack-info))
  (cond
    ((and info (nonzero? info) (logtest? (attack-mask vector) (-> info mask)))
     (set! (-> details attack-dir quad) (-> info vector quad))
     (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_DIRECTION))
    ((and info (nonzero? info) (logtest? (attack-mask attacker-velocity) (-> info mask)))
     (set! (-> details attack-dir quad) (-> info attacker-velocity quad))
     (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_DIRECTION))
    ((and (logtest? (-> details flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
          e-proc
          (nonzero? e-proc)
          (-> e-proc root)
          (nonzero? (-> e-proc root)))
     (vector-! (-> details attack-dir) (-> e-proc root trans) (-> details source-pos))
     (set! (-> details attack-dir y) 0.0)
     (vector-xz-normalize! (-> details attack-dir) 1.0)
     (logior! (-> details flags) MP_ACTOR_ATTACK_HAS_DIRECTION))
    (else (set-vector! (-> details attack-dir) 0.0 0.0 1.0 0.0)))
  (none))

(defun mp-actor-resolve-event-penetrate ((e-proc enemy)
                                         (attacker process)
                                         (event-block event-message-block)
                                         (info attack-info))
  (when (and e-proc (nonzero? e-proc) info (nonzero? info) (= (-> e-proc incoming attack-id) (-> info id)))
    (return (-> e-proc incoming penetrate-using)))
  (when (and attacker (nonzero? attacker) event-block (nonzero? event-block))
    (return (get-penetrate-using-from-attack-event (the-as process-drawable attacker) event-block)))
  (if (and info (nonzero? info)) (-> info penetrate-using) (the-as penetrate 0)))

(defun mp-actor-resolve-event-knocked-type ((e-proc enemy) (info attack-info) (resolved-penetrate penetrate))
  (when (and e-proc (nonzero? e-proc) (mp-actor-attack-id-usable? info) (= (-> e-proc incoming attack-id) (-> info id)))
    (return (-> e-proc incoming knocked-type)))
  (when (and info (nonzero? info) (logtest? (attack-mask knock) (-> info mask)))
    (return (-> info knock)))
  (if (and e-proc (nonzero? e-proc)) (penetrate-using->knocked e-proc resolved-penetrate) (knocked-type knocked-type-0)))

(defun mp-actor-send-attack-event! ((e-proc enemy)
                                    (attacker process)
                                    (info attack-info)
                                    (event-block event-message-block)
                                    (event-type uint)
                                    (net-id uint)
                                    (new-hp int))
  (if (not (mp-session-in-game?)) (return #f))
  (if (zero? net-id) (return #f))
  (let* ((damage (damage-amount-from-attack e-proc attacker event-block))
         (penetrate (mp-actor-resolve-event-penetrate e-proc attacker event-block info))
         (knocked-type (mp-actor-resolve-event-knocked-type e-proc info penetrate))
         (attack-id (if (and info (nonzero? info)) (-> info id) 0))
         (shove-back (if (and info (nonzero? info) (logtest? (attack-mask shove-back) (-> info mask))) (-> info shove-back) (meters 2)))
         (shove-up (if (and info (nonzero? info) (logtest? (attack-mask shove-up) (-> info mask))) (-> info shove-up) (meters 0.5)))
         (hit-sound-id (the-as uint8
                               (if (nonzero? *mp-current-remote-hit-sound-id*)
                                 (the-as uint *mp-current-remote-hit-sound-id*)
                                 (mp-hit-sound-id-from-attack-info info))))
         (details (new 'stack-no-clear 'mp-ped-attack-event-data)))
    (set! (-> details net-id) net-id)
    (set! (-> details attack-id) attack-id)
    (set! (-> details flags) 0)
    (set! (-> details knocked-type) (the-as uint8 knocked-type))
    (set! (-> details new-hp) new-hp)
    (set! (-> details shove-back) shove-back)
    (set! (-> details shove-up) shove-up)
    (set! (-> details hit-sound-id) hit-sound-id)
    (set! (-> details penetrate) (the-as uint64 penetrate))
    (set! (-> details traffic-authority-player-id)
          (the-as uint8 (if (= event-type MP_EVENT_ATTACK_PED) *mp-traffic-selected-authority-id* #xff)))
    (mp-actor-capture-source-pos! details e-proc attacker info)
    (mp-actor-capture-attack-dir! details e-proc info)
    (log 'debug
         "[MP-ActorHit] Queue event=~D nid=~D attack-id=~D damage=~D new-hp=~D penetrate=~D "
         event-type
         net-id
         (-> details attack-id)
         damage
         new-hp
         (-> details penetrate))
    (log 'debug "knock=~D~%" (-> details knocked-type))
    (mp-event-enqueue-actor-attack! event-type details))
  #t)

(defun mp-actor-local-hit-duplicate? ((e-proc enemy) (info attack-info))
  (when (not (nonnull? e-proc))
    (return #f))
  (let ((net-id (-> e-proc net-id)))
    (when (zero? net-id)
      (return #f))
    (if (type? e-proc citizen)
      (let ((rec (get-traffic-record net-id)))
        (when (nonnull? rec)
          (return (mp-actor-local-attack-blocked? (-> rec last-local-attack-id) (-> rec last-local-attack-time) info))))
      (let ((rec (mp-get-enemy-auth net-id)))
        (when (nonnull? rec)
          (return (mp-actor-local-attack-blocked? (-> rec last-local-attack-id) (-> rec last-local-attack-time) info))))))
  #f)

(defun mp-actor-hit-authoritative? ((e-proc enemy))
  (and (nonnull? e-proc) (if (type? e-proc citizen) *mp-traffic-local-authoritative?* (mp-enemy-authoritative? e-proc))))

(defun mp-actor-in-hit-reaction? ((e-proc enemy))
  (when (nonnull? e-proc (-> e-proc state))
    (let ((state-name (-> e-proc state name)))
      (return (or (= state-name 'hit)
                  (= state-name 'knocked)
                  (if (type? e-proc citizen) (= state-name 'knocked-off-vehicle) (= state-name 'knocked-vicinity))))))
  #f)

(defun mp-actor-pedestrian-attack-blocked? ((e-proc enemy)
                                            (info attack-info)
                                            (remote-replay? symbol)
                                            (local-attacker? symbol))
  (and (nonnull? e-proc)
       (type? e-proc citizen)
       (or (and *mp-traffic-suppressed* (zero? (-> e-proc net-id)))
           (logtest? (-> e-proc focus-status) (focus-status dead))
           (and (not remote-replay?) (nonnull? info) (= (-> info id) (-> e-proc incoming attack-id)))
           (and (not remote-replay?) (not local-attacker?) (not *mp-traffic-local-authoritative?*)))))

(defun mp-actor-send-local-hit-request! ((e-proc enemy) (attacker process) (arg3 event-message-block))
  (when (nonnull? e-proc attacker arg3)
    (let ((info (mp-actor-event-attack-info arg3))
          (net-id (-> e-proc net-id))
          (event-type MP_EVENT_ATTACK_ENEMY)
          (new-hp (max 0 (- (-> e-proc hit-points) (damage-amount-from-attack e-proc attacker arg3)))))
      (when (zero? net-id)
        (return #f))
      (if (type? e-proc citizen)
        (let ((rec (get-traffic-record net-id)))
          (when (not (nonnull? rec))
            (return #f))
          (when (nonnull? info)
            (set! (-> rec last-local-attack-id) (-> info id)))
          (set! (-> rec last-local-attack-time) (current-time))
          (set! event-type MP_EVENT_ATTACK_PED))
        (let ((rec (mp-get-enemy-auth net-id)))
          (when (not (nonnull? rec))
            (return #f))
          (when (nonnull? info)
            (set! (-> rec last-local-attack-id) (-> info id)))
          (set! (-> rec last-local-attack-time) (current-time))))
      (mp-actor-send-attack-event! e-proc attacker info arg3 event-type net-id new-hp)
      (return #t)))
  #f)

(defun mp-actor-handle-attack-hijack ((e-proc enemy) (attacker process) (arg3 event-message-block))
  (when (not (nonnull? e-proc))
    (return 'block))
  (let* ((info (mp-actor-event-attack-info arg3))
         (remote-replay? (the-as symbol (or *mp-processing-remote-event* (mp-actor-remote-attack-info? info))))
         (local-attacker? (the-as symbol (mp-is-local-attacker? attacker))))
    (when (mp-actor-remote-attacker-blocked? attacker remote-replay?)
      (return 'block))
    (when (mp-actor-pedestrian-attack-blocked? e-proc info remote-replay? local-attacker?)
      (return 'block))
    (when (and (not remote-replay?) local-attacker?)
      (when (mp-actor-local-hit-duplicate? e-proc info)
        (return 'block))
      (when (and (not (mp-actor-hit-authoritative? e-proc))
                 (mp-actor-in-hit-reaction? e-proc)
                 (not (mp-actor-local-hit-fatal? e-proc attacker arg3)))
        (mp-actor-send-local-hit-request! e-proc attacker arg3)
        (return 'block))))
  'allow)

(defun mp-actor-broadcast-attack ((e-proc enemy) (attacker process) (arg3 event-message-block))
  (let ((info (mp-actor-event-attack-info arg3)))
    (when (not (or *mp-processing-remote-event* (mp-actor-remote-attack-info? info) (mp-is-remote-attacker? attacker)))
      (if (type? e-proc citizen)
        (let ((net-id (-> e-proc net-id)))
          (when (nonzero? net-id)
            (let ((rec (get-traffic-record net-id)))
              (when rec
                (if info (set! (-> rec last-local-attack-id) (-> info id)))
                (set! (-> rec last-local-attack-time) (current-time))
                (mp-actor-send-attack-event! e-proc
                                             attacker
                                             info
                                             arg3
                                             MP_EVENT_ATTACK_PED
                                             net-id
                                             (-> e-proc hit-points)))
              (when (not rec)
                (log 'debug "[MP-ActorHit] Ped broadcast blocked: missing traffic record nid=~D~%" net-id)))))
        (let ((net-id (-> e-proc net-id)))
          (when (and (nonzero? net-id) (not (type? e-proc bot)))
            (let ((rec (mp-get-enemy-auth net-id)))
              (when rec
                (if info (set! (-> rec last-local-attack-id) (-> info id)))
                (set! (-> rec last-local-attack-time) (current-time))
                (mp-actor-send-attack-event! e-proc
                                             attacker
                                             info
                                             arg3
                                             MP_EVENT_ATTACK_ENEMY
                                             net-id
                                             (-> e-proc hit-points)))))))))
  #f)
