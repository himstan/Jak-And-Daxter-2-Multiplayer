;;-*-Lisp-*-
(in-package goal)

;; Shared hit-sync helpers used by enemy and traffic pedestrians. Keep the
;; entity-specific authority and event-send policy in the caller modules.

(define *mp-actor-remote-attack-event* (the-as mp-actor-attack-event #f))
(define *mp-current-remote-hit-sound-id* (the-as uint32 0))

(defun mp-hit-sound-id-from-attack-mode ((mode symbol))
  "Map a target attack mode to the connect sound played by target-send-attack."
  (cond
    ((or (= mode 'spin) (= mode 'spin-air))
     (the-as uint (mp-hit-sound-id spin))
     )
    ((or (= mode 'punch) (= mode 'flip) (= mode 'flut-attack))
     (the-as uint (mp-hit-sound-id punch))
     )
    ((= mode 'uppercut)
     (the-as uint (mp-hit-sound-id uppercut))
     )
    ((or (= mode 'flop) (= mode 'flop-down))
     (the-as uint (mp-hit-sound-id flop))
     )
    ((= mode 'board-spin)
     (the-as uint (mp-hit-sound-id board-spin))
     )
    ((= mode 'mech-punch)
     (the-as uint (mp-hit-sound-id mech-punch))
     )
    (else
     (the-as uint (mp-hit-sound-id spin))
     )
    )
  )

(defun mp-hit-sound-id-from-attack-info ((info attack-info))
  (if (and info (nonzero? info))
      (mp-hit-sound-id-from-attack-mode (-> info mode))
      (the-as uint (mp-hit-sound-id spin))
      )
  )

(defun mp-play-remote-hit-sound! ((e-proc enemy) (hit-sound-id uint))
  "Play the initiator-side hit connect sound for an accepted remote-player hit."
  (when (and e-proc
             (nonzero? e-proc)
             (-> e-proc root)
             (nonzero? (-> e-proc root)))
    (case hit-sound-id
      (((the-as uint (mp-hit-sound-id punch)))
       (sound-play-by-spec (static-sound-spec "punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id uppercut)))
       (sound-play-by-spec (static-sound-spec "uppercut-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id flop)))
       (sound-play-by-spec (static-sound-spec "flop-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id board-spin)))
       (sound-play-by-spec (static-sound-spec "board-impact" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (((the-as uint (mp-hit-sound-id mech-punch)))
       (sound-play-by-spec (static-sound-spec "mech-punch-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      (else
       (sound-play-by-spec (static-sound-spec "spin-hit" :fo-min 10 :fo-max 80 :fo-curve 2 :mask (trans)) (new-sound-id) (-> e-proc root trans))
       )
      )
    )
  (none)
  )

(defun mp-is-local-attacker? ((proc process))
  "Is the process either the local target or in its parentage (e.g., projectile)?"
  (if (or (not proc) (zero? proc)) (return #f))
  (let ((curr proc))
    (while (and curr (nonzero? curr))
      (if (= curr *target*) (return #t))
      (set! curr (if (and (-> curr parent) (nonzero? (-> curr parent))) (the-as process (ppointer->process (-> curr parent))) (the-as process #f)))
      )
    )
  #f
  )

(defun mp-is-remote-attacker? ((proc process))
  "Is the process either the remote puppet or in its parentage (e.g., projectile)?"
  (if (or (not proc) (zero? proc)) (return #f))
  (let ((puppet *mp-puppet*))
    (if (not puppet) (return #f))
    (let ((curr proc))
      (while (and curr (nonzero? curr))
        (if (= curr puppet) (return #t))
        (set! curr (if (and (-> curr parent) (nonzero? (-> curr parent))) (the-as process (ppointer->process (-> curr parent))) (the-as process #f)))
        )
      )
    )
  #f
  )

(defun mp-actor-event-attack-info ((msg event-message-block))
  "Return the attack-info payload from an event-message-block, or #f."
  (if (and msg
           (nonzero? msg)
           (nonzero? (-> msg param 1)))
      (the-as attack-info (-> msg param 1))
      (the-as attack-info #f)
      )
  )

(defun mp-actor-attack-id ((info attack-info))
  (if (and info
           (nonzero? info))
      (-> info id)
      (the uint 0)
      )
  )

(defun mp-actor-attack-info-mode? ((info attack-info) (mode symbol))
  (and info
       (nonzero? info)
       (= (-> info mode) mode))
  )

(defun mp-actor-attack-id-usable? ((info attack-info))
  (and info
       (nonzero? info)
       (nonzero? (-> info id)))
  )

(defun mp-actor-remote-attacker-blocked? ((attacker process) (remote-replay? symbol))
  (and (not remote-replay?)
       (mp-is-remote-attacker? attacker))
  )

(defun mp-actor-remote-attack-info? ((info attack-info))
  "Does this attack-info represent a reconstructed remote actor hit?"
  (mp-actor-attack-info-mode? info 'mp-hit-remote)
  )

(defun mp-actor-local-attack-blocked? ((last-local-attack-id uint)
                                       (last-local-attack-time time-frame)
                                       (info attack-info))
  "Has this local hitbox already produced a request during its anti-spam window?"
  (if (mp-actor-attack-id-usable? info)
      (return (and (= (-> info id) last-local-attack-id)
                   (not (time-elapsed? last-local-attack-time (seconds 0.75)))))
      )
  (not (time-elapsed? last-local-attack-time (seconds 0.2)))
  )

(defun mp-actor-fill-attack-info-from-event! ((atk attack-info) (evt mp-actor-attack-event))
  "Fill caller-owned attack-info used for an authoritative remote actor hit."
  (set! (-> atk mask) (attack-mask id mode damage shove-back shove-up knock vector intersection attacker-velocity penetrate-using))
  (set! (-> atk id) (if (nonzero? (-> evt attack-id)) (-> evt attack-id) (new-attack-id)))
  (set! (-> atk mode) 'mp-hit-remote)
  (set! (-> atk damage) 0.0)
  (set! (-> atk shove-back) (-> evt shove-back))
  (set! (-> atk shove-up) (-> evt shove-up))
  (set! (-> atk knock) (the-as knocked-type (-> evt knocked-type)))
  (set! (-> atk penetrate-using) (the-as penetrate (-> evt penetrate)))
  (set! (-> atk intersection quad) (-> evt source-pos quad))
  (set! (-> atk vector quad) (-> evt attack-dir quad))
  (set! (-> atk attacker-velocity quad) (-> evt attack-dir quad))
  (none)
  )

(defun mp-actor-restore-context! ((e-proc enemy)
                                  (flags uint)
                                  (knocked-type uint)
                                  (source-pos vector)
                                  (attack-dir vector))
  "Restore replicated incoming attack context after vanilla code has resolved damage."
  (when (and e-proc
             (nonzero? e-proc))
    (set! (-> e-proc incoming knocked-type) (the-as knocked-type knocked-type))
    (when (logtest? flags MP_ACTOR_ATTACK_HAS_SOURCE_POS)
      (set! (-> e-proc incoming attacker-pos quad) (-> source-pos quad))
      )
    (when (logtest? flags MP_ACTOR_ATTACK_HAS_DIRECTION)
      (set! (-> e-proc incoming attack-direction quad) (-> attack-dir quad))
      )
    )
  (none)
  )

(defun mp-actor-apply-authoritative-remote-damage! ((e-proc enemy)
                                                    (attacker process)
                                                    (evt mp-actor-attack-event)
                                                    (label symbol))
  "Apply an authoritative actor hit without duplicating pedestrian/enemy hit logic."
  (when (or (not e-proc) (not (nonzero? e-proc)))
    (format 0 "[MP-ActorHit] Remote ~A hit blocked: missing proc nid=~D attack-id=~D~%"
            label
            (-> evt net-id)
            (-> evt attack-id))
    (return #f)
    )
  (when (or (not attacker) (not (nonzero? attacker)) (not (type? attacker process-drawable)))
    (format 0 "[MP-ActorHit] Remote ~A hit blocked: missing attacker nid=~D attack-id=~D~%"
            label
            (-> evt net-id)
            (-> evt attack-id))
    (return #f)
    )
  (when (<= (-> e-proc hit-points) 0)
    (format 0 "[MP-ActorHit] Remote ~A hit blocked: already dead nid=~D attack-id=~D~%"
            label
            (-> evt net-id)
            (-> evt attack-id))
    (return #f)
    )
  (when (logtest? (-> e-proc focus-status) (focus-status grabbed))
    (format 0 "[MP-ActorHit] Remote ~A hit blocked: grabbed nid=~D attack-id=~D~%"
            label
            (-> evt net-id)
            (-> evt attack-id))
    (return #f)
    )
  (let ((atk (new 'stack-no-clear 'attack-info))
        (old-hp (-> e-proc hit-points)))
    (mp-actor-fill-attack-info-from-event! atk evt)
    (set! (-> atk damage) (the float (max 0 (- old-hp (-> evt new-hp)))))
    (set! *mp-actor-remote-attack-event* evt)
    (mp-actor-restore-context! e-proc (-> evt flags) (-> evt knocked-type) (-> evt source-pos) (-> evt attack-dir))
    (set! *mp-processing-remote-event* #t)
    (send-event e-proc 'attack attacker atk)
    (let ((authoritative-hp (max 0 (-> evt new-hp))))
      (when (!= (-> e-proc hit-points) authoritative-hp)
        (set! (-> e-proc hit-points) authoritative-hp)
        )
      (when (and (= label 'enemy)
                 (zero? authoritative-hp))
        (let ((aid (mp-get-enemy-aid e-proc)))
          (logior! (-> e-proc enemy-flags) (enemy-flag stop-syncing))
          (when (nonzero? aid)
            (mp-mark-aid-dead-perm! aid)
            (format 0 "[MP-ActorHit] Fatal remote enemy hit finalized nid=~D aid=~D new-hp=0~%"
                    (-> evt net-id)
                    aid)
            )
          )
        )
      )
    (let ((damage-taken (max 0 (- old-hp (-> evt new-hp)))))
      (when (> damage-taken 0)
        (mp-play-remote-hit-sound! e-proc (-> evt hit-sound-id))
        )
      (format 0 "[MP-ActorHit] Remote ~A hit applied nid=~D attack-id=~D damage=~D hp=~D->~D~%"
              label
              (-> evt net-id)
              (-> evt attack-id)
              damage-taken
              old-hp
              (-> e-proc hit-points))
      )
    (set! *mp-processing-remote-event* #f)
    (set! *mp-actor-remote-attack-event* (the-as mp-actor-attack-event #f))
    )
  #t
  )

(defun mp-actor-capture-source-pos! ((evt mp-actor-attack-event)
                                     (e-proc enemy)
                                     (attacker process)
                                     (info attack-info))
  "Capture the client-side hit source position."
  (set! (-> evt flags) (the-as uint32 0))
  (cond
    ((and info
          (nonzero? info)
          (logtest? (attack-mask intersection) (-> info mask)))
     (set! (-> evt source-pos quad) (-> info intersection quad))
     (logior! (-> evt flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
     )
    ((and attacker
          (nonzero? attacker)
          (type? attacker process-drawable)
          (-> (the-as process-drawable attacker) root)
          (nonzero? (-> (the-as process-drawable attacker) root)))
     (set! (-> evt source-pos quad) (-> (the-as process-drawable attacker) root trans quad))
     (logior! (-> evt flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
     )
    ((and e-proc
          (nonzero? e-proc)
          (-> e-proc root)
          (nonzero? (-> e-proc root)))
     (set! (-> evt source-pos quad) (-> e-proc root trans quad))
     )
    (else
     (set-vector! (-> evt source-pos) 0.0 0.0 0.0 1.0)
     )
    )
  (none)
  )

(defun mp-actor-capture-attack-dir! ((evt mp-actor-attack-event) (e-proc enemy) (info attack-info))
  "Capture the client-side knock direction."
  (cond
    ((and info
          (nonzero? info)
          (logtest? (attack-mask vector) (-> info mask)))
     (set! (-> evt attack-dir quad) (-> info vector quad))
     (logior! (-> evt flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
     )
    ((and info
          (nonzero? info)
          (logtest? (attack-mask attacker-velocity) (-> info mask)))
     (set! (-> evt attack-dir quad) (-> info attacker-velocity quad))
     (logior! (-> evt flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
     )
    ((and (logtest? (-> evt flags) MP_ACTOR_ATTACK_HAS_SOURCE_POS)
          e-proc
          (nonzero? e-proc)
          (-> e-proc root)
          (nonzero? (-> e-proc root)))
     (vector-! (-> evt attack-dir) (-> e-proc root trans) (-> evt source-pos))
     (set! (-> evt attack-dir y) 0.0)
     (vector-xz-normalize! (-> evt attack-dir) 1.0)
     (logior! (-> evt flags) MP_ACTOR_ATTACK_HAS_DIRECTION)
     )
    (else
     (set-vector! (-> evt attack-dir) 0.0 0.0 1.0 0.0)
     )
    )
  (none)
  )

(defun mp-actor-send-attack-event! ((e-proc enemy)
                                    (attacker process)
                                    (info attack-info)
                                    (event-block event-message-block)
                                    (event-type uint)
                                    (net-id uint))
  "Queue a generic actor hit request with attack context for reconstruction."
  (if (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) 6))
      (return #f))
  (if (zero? net-id)
      (return #f))

  (let ((q-idx *mp-event-queue-write-ptr*))
    (let ((evt (the-as mp-actor-attack-event (-> *mp-event-queue* q-idx)))
          (damage (damage-amount-from-attack e-proc attacker event-block))
          (new-hp (-> e-proc hit-points)))
      (set! (-> evt etype) event-type)
      (set! (-> evt net-id) (the-as uint32 net-id))
      (set! (-> evt attack-id) (the-as uint32 (if info (-> info id) (the uint 0))))
      (set! (-> evt new-hp) (the-as uint32 new-hp))
      (set! (-> evt shove-back) (if (and info (logtest? (attack-mask shove-back) (-> info mask))) (-> info shove-back) (meters 2)))
      (set! (-> evt shove-up) (if (and info (logtest? (attack-mask shove-up) (-> info mask))) (-> info shove-up) (meters 0.5)))
      (set! (-> evt knocked-type) (the-as uint32 (if (and info (logtest? (attack-mask knock) (-> info mask))) (-> info knock) (knocked-type knocked-type-0))))
      (set! (-> evt hit-sound-id) (the-as uint32 (if (nonzero? *mp-current-remote-hit-sound-id*)
                                                     (the-as uint *mp-current-remote-hit-sound-id*)
                                                     (mp-hit-sound-id-from-attack-info info))))
      (set! (-> evt penetrate) (the-as uint8 (-> info penetrate-using)))
      (mp-actor-capture-source-pos! evt e-proc attacker info)
      (mp-actor-capture-attack-dir! evt e-proc info)
      (format 0 "[MP-ActorHit] Queue event=~D nid=~D attack-id=~D damage=~D new-hp=~D penetrate=~D~%"
              event-type
              net-id
              (-> evt attack-id)
              damage
              new-hp
              (-> evt penetrate))
      )
    (set! *mp-event-queue-write-ptr* (logand (+ q-idx 1) 31))
    )
  #t
  )

(defun mp-actor-send-local-hit-request! ((actor-kind symbol)
                                         (e-proc enemy)
                                         (attacker process)
                                         (arg3 event-message-block))
  "Send a local hit request for a non-authoritative actor already in a hit reaction."
  (let ((info (mp-actor-event-attack-info arg3)))
    (cond
      ((= actor-kind 'pedestrian)
       (let ((net-id (-> e-proc net-id)))
         (when (zero? net-id)
           (return #f)
           )
         (let ((rec (mp-get-traffic-ghost net-id)))
           (when rec
             (if info (set! (-> rec last-local-attack-id) (-> info id)))
             (set! (-> rec last-local-attack-time) (current-time))
             (mp-actor-send-attack-event! e-proc attacker info arg3 MP_EVENT_ATTACK_PED net-id)
             (return #t)
             )
           )
         )
       )
      ((= actor-kind 'enemy)
       (let ((net-id (-> e-proc net-id)))
         (when (zero? net-id)
           (return #f)
           )
         (let ((rec (mp-get-enemy-auth net-id)))
           (when rec
             (if info (set! (-> rec last-local-attack-id) (-> info id)))
             (set! (-> rec last-local-attack-time) (current-time))
             (mp-actor-send-attack-event! e-proc attacker info arg3 MP_EVENT_ATTACK_ENEMY net-id)
             (return #t)
             )
           )
         )
       )
      )
    )
  #f
  )

(defun mp-actor-handle-attack-hijack ((actor-kind symbol)
                                      (e-proc enemy)
                                      (attacker process)
                                      (arg3 event-message-block))
  "Shared pre-vanilla attack filtering for citizen and enemy method hijacks."
  (let ((info (mp-actor-event-attack-info arg3)))
    (let ((remote-replay? (the-as symbol (or *mp-processing-remote-event*
                                             (mp-actor-remote-attack-info? info))))
          (local-attacker? (the-as symbol (mp-is-local-attacker? attacker))))
      (when (mp-actor-remote-attacker-blocked? attacker remote-replay?)
        (return 'block)
        )
      (let ((puppet *mp-puppet*))
        (when (and (not remote-replay?)
                   puppet
                   (nonzero? puppet)
                   (= attacker puppet))
          (return 'block)
          )
        )
      (cond
        ((= actor-kind 'pedestrian)
         (when (or (and *mp-traffic-suppressed* (= (-> e-proc net-id) 0))
                   (logtest? (-> e-proc focus-status) (focus-status dead))
                   (and (not remote-replay?) info (= (-> info id) (-> e-proc incoming attack-id)))
                   (and (not remote-replay?) (not local-attacker?) (not (mp-is-traffic-authoritative?))))
           (return 'block)
           )
         (let ((net-id (-> e-proc net-id)))
           (when (nonzero? net-id)
             (let ((rec (mp-get-traffic-ghost net-id)))
               (when (and rec
                          (not remote-replay?)
                          local-attacker?
                          (mp-actor-local-attack-blocked? (-> rec last-local-attack-id)
                                                          (-> rec last-local-attack-time)
                                                          info))
                 (return 'block)
                 )
               )
             )
           )
         (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f)))
           (when (and (not remote-replay?)
                      (not (mp-is-jak?))
                      local-attacker?
                      (or (= cur-state 'hit)
                          (= cur-state 'knocked)
                          (= cur-state 'knocked-off-vehicle)))
             (if (mp-actor-send-local-hit-request! actor-kind e-proc attacker arg3)
                 (return 'allow)
                 (return 'block))
             )
           )
         )
        ((= actor-kind 'enemy)
         (let ((net-id (-> e-proc net-id)))
           (when (nonzero? net-id)
             (let ((rec (mp-get-enemy-auth net-id)))
               (when (and rec
                          (not remote-replay?)
                          local-attacker?
                          (mp-actor-local-attack-blocked? (-> rec last-local-attack-id)
                                                          (-> rec last-local-attack-time)
                                                          info))
                 (return 'block)
                 )
               )
             )
           )
         (let ((cur-state (if (-> e-proc state) (-> e-proc state name) #f)))
           (when (and (not remote-replay?)
                      (not (mp-enemy-authoritative? e-proc))
                      local-attacker?
                      (or (= cur-state 'hit)
                          (= cur-state 'knocked)
                          (= cur-state 'knocked-vicinity)))
             (if (mp-actor-send-local-hit-request! actor-kind e-proc attacker arg3)
                 (return 'allow)
                 (return 'block))
             )
           )
         )
        )
      )
    )
  'allow
  )

(defun mp-actor-broadcast-attack ((e-proc enemy) (attacker process) (arg3 event-message-block))
  "Post-damage vanilla hook that queues actor hit sync for pedestrians and enemies."
  (let ((info (mp-actor-event-attack-info arg3)))
    (when (not (or *mp-processing-remote-event*
                   (mp-actor-remote-attack-info? info)
                   (mp-is-remote-attacker? attacker)))
      (if (type? e-proc citizen)
          (let ((net-id (-> e-proc net-id)))
            (when (nonzero? net-id)
              (let ((rec (mp-get-traffic-ghost net-id)))
                (when rec
                  (if info (set! (-> rec last-local-attack-id) (-> info id)))
                  (set! (-> rec last-local-attack-time) (current-time))
                  (mp-actor-send-attack-event! e-proc attacker info arg3 MP_EVENT_ATTACK_PED net-id)
                  )
                )
              )
            )
          (let ((net-id (-> e-proc net-id)))
            (when (and (nonzero? net-id)
                       (not (type? e-proc bot)))
              (let ((rec (mp-get-enemy-auth net-id)))
                (when rec
                  (if info (set! (-> rec last-local-attack-id) (-> info id)))
                  (set! (-> rec last-local-attack-time) (current-time))
                  (mp-actor-send-attack-event! e-proc attacker info arg3 MP_EVENT_ATTACK_ENEMY net-id)
                  )
                )
              )
            )
          )
      )
    )
  #f
  )
