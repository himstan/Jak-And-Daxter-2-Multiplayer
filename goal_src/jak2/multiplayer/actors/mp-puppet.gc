;;-*-Lisp-*-
(in-package goal)

(define *mp-puppet-input-stale-time* (seconds 0.2))
(define *mp-puppet-action-warmup-time* (seconds 0.3))

(defun mp-puppet-process-live? ((puppet target))
  "True when a target process has not already returned to its dead pool."
  (and puppet
       (nonzero? puppet)
       (!= (-> puppet status) 'dead)
       (!= (-> puppet parent) *target-dead-pool*)))

(defun mp-puppet-unbind-record-safe! ((record mp-player-record))
  "Drop one binding without ever modifying the engine-owned local target."
  (when (and record (nonzero? record))
    (let ((puppet (mp-player-record-target record)))
      (if (and puppet
               (nonzero? puppet)
               *target*
               (nonzero? *target*)
               (= puppet *target*))
          (set! (-> record runtime target-handle) (the-as handle #f))
          (mp-player-controller-unbind-record-target!
            *mp-player-controller* record))))
  (none))

(defun mp-reset-player-puppet-state! ((record mp-player-record))
  (when (and record (nonzero? record))
    (when (nonzero? (-> record runtime target-handle))
      (mp-puppet-deactivate! record))
    (mp-puppet-unbind-record-safe! record)
    (let ((ghost (mp-player-record-ghost record)))
      (when (and ghost (nonzero? ghost))
        (mem-set32! (the-as pointer ghost) (/ (size-of mp-target-ghost-record) 4) 0)))
    (set! (-> record runtime vehicle-handle) (the-as handle #f))
    (set! (-> record runtime last-state-packet-id) (the uint 0))
    (set! (-> record runtime last-fresh-input-time) (the-as time-frame 0))
    (set! (-> record runtime last-action-sequence) (the uint 0))
    (set! (-> record runtime action-warmup-start) (the-as time-frame 0))
    (set! (-> record runtime state-mismatch-count) 0)
    (set! (-> record runtime pending-gun-shot-sequence) (the uint 0))
    (set! (-> record runtime last-gun-shot-sequence) (the uint 0))
    (set! (-> record runtime last-gun-replay-debug-sequence) (the uint 0))
    (set! (-> record runtime pending-gun-shot-camera-angle) 0.0)
    (set! (-> record runtime pending-gun-shot-weapon) (the uint8 0))
    (set! (-> record runtime last-gun-log-active) -1)
    (set! (-> record runtime last-gun-log-requested) -1)
    (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle none))
    (set! (-> record runtime flags) (the-as mp-player-runtime-flags 0)))
  (none))

(defun mp-reset-puppet-state! ()
  (when (and *mp-player-controller* (nonzero? *mp-player-controller*))
    (dotimes (player-id MP_MAX_PLAYERS)
      (let ((record (-> *mp-player-controller* records player-id)))
        (when (and record
                   (nonzero? record)
                   (!= (the-as uint player-id)
                       (-> *mp-player-controller* local-player-id))
                   (or (nonzero? (-> record runtime target-handle))
                       (nonzero? (-> record runtime vehicle-handle))
                       (< (the-as uint (-> record runtime pad-index))
                          (the uint MP_MAX_PLAYERS))))
          (mp-reset-player-puppet-state! record)))))
  (when (and *target-pool* (nonzero? *target-pool*))
    (kill-by-name "mp-puppet" *target-pool*))
  (when (and *target*
             (nonzero? *target*)
             (-> *target* sidekick)
             (nonzero? (-> *target* sidekick)))
    (let ((sk (the-as sidekick (ppointer->process (-> *target* sidekick)))))
      (when (and sk
                 (nonzero? sk)
                 (-> sk draw)
                 (nonzero? (-> sk draw)))
        (logclear! (-> sk draw status) (draw-control-status no-draw))
        )
      )
    )
  (none))

(defun mp-puppet-valid? ((proc target))
  "True when a puppet pointer still names a live target process."
  (if (and (mp-puppet-process-live? proc)
           (-> proc control)
           (nonzero? (-> proc control))
           (-> proc state)
           (nonzero? (-> proc state)))
      #t
      #f
      )
  )

(defun mp-puppet-clear-stale! ((record mp-player-record))
  "Release a live-but-invalid puppet before clearing its stale binding."
  (when (and record (nonzero? record))
    (let ((puppet (mp-player-record-target record)))
      (if (mp-puppet-process-live? puppet)
          (mp-puppet-deactivate! record)
          (mp-puppet-unbind-record-safe! record)))
    (mp-player-runtime-clear-flag! record (mp-player-runtime-flags pending-gun-shot))
    (set! (-> record runtime pending-gun-shot-weapon) (the uint8 0))
    (set! (-> record runtime pending-gun-shot-sequence) (the uint 0))
    (set! (-> record runtime pending-gun-shot-camera-angle) 0.0)
    (set! (-> record runtime action-warmup-start) (the-as time-frame 0))
    (set! (-> record runtime state-mismatch-count) 0)
    (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle none)))
  (none)
  )

(defun mp-puppet-snap-to-ghost-on-spawn! ((proc target))
  "Seed a fresh puppet with the current ghost transform before native simulation runs."
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
    (when (and record (nonzero? record))
      (let ((ghost (mp-player-record-ghost record)))
        (when (and proc
                   (nonzero? proc)
                   ghost
                   (nonzero? ghost)
                   (-> ghost active?)
                   (-> proc control)
                   (nonzero? (-> proc control)))
          (let ((control (-> proc control)))
            (vector-copy! (-> control trans) (-> ghost trans))
            (vector-copy! (-> control trans-old) (-> ghost trans))
            (vector-copy! (-> control trans-old-old) (-> ghost trans))
            (vector-copy! (-> control trans-old-old-old) (-> ghost trans))
            (vector-copy! (-> control transv) (-> ghost velocity))
            (vector-copy! (-> control transv-ctrl) (-> ghost velocity))
            (quaternion-copy! (-> control quat) (-> ghost quat))
            (quaternion-copy! (-> control quat-for-control) (-> ghost quat))
            (quaternion-copy! (-> control dir-targ) (-> ghost quat))
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-puppet-update-ghost! ((ghost mp-target-ghost-record) (info mp-player-record))
  "Update the ghost record from incoming remote player info."
  (when (and ghost (nonzero? ghost) info (nonzero? info))
    (vector-copy! (-> ghost trans) (-> info transform position))
    (quaternion-axis-angle! (-> ghost quat) 0.0 1.0 0.0 (-> info transform angle))
    (vector-copy! (-> ghost velocity) (-> info transform velocity))
    (set! (-> ghost state-id) (-> info action target-state-id))
    (set! (-> ghost equipped-weapon) (-> info input equipped-weapon))
    (set! (-> ghost buttons) (-> info input buttons))
    (set! (-> ghost leftx) (-> info input leftx))
    (set! (-> ghost lefty) (-> info input lefty))
    (set! (-> ghost rightx) (-> info input rightx))
    (set! (-> ghost righty) (-> info input righty))
    (set! (-> ghost cam-angle-y) (-> info input camera-angle-y))
    (set! (-> ghost last-update) (-> *display* game-clock frame-counter))
    (set! (-> ghost active?) #t))
  (none)
  )

(defun mp-puppet-update-pad ((pad cpad-info) (buttons uint) (lx uint) (ly uint) (rx uint) (ry uint))
  "Manually update a cpad-info structure with raw input data, shifting history and calculating derived fields."
  (set! (-> pad old-leftx 1) (-> pad old-leftx 0))
  (set! (-> pad old-leftx 0) (-> pad leftx))
  (set! (-> pad old-lefty 1) (-> pad old-lefty 0))
  (set! (-> pad old-lefty 0) (-> pad lefty))
  (set! (-> pad old-rightx 1) (-> pad old-rightx 0))
  (set! (-> pad old-rightx 0) (-> pad rightx))
  (set! (-> pad old-righty 1) (-> pad old-righty 0))
  (set! (-> pad old-righty 0) (-> pad righty))
  (set! (-> pad button0-abs 2) (-> pad button0-abs 1))
  (set! (-> pad button0-abs 1) (-> pad button0-shadow-abs 0))
  (set! (-> pad button0-rel 2) (-> pad button0-rel 1))
  (set! (-> pad button0-rel 1) (-> pad button0-rel 0))

  (let ((history (-> *cpad-history-list* cpads (-> pad number))))
    (dotimes (i 14)
      (set! (-> history button0-abs (- 14 i)) (-> history button0-abs (- 13 i)))
      (set! (-> history button0-rel (- 14 i)) (-> history button0-rel (- 13 i)))
      )
    (set! (-> history button0-abs 1) (-> pad button0-shadow-abs 0))
    (set! (-> history button0-rel 1) (-> pad button0-rel 0))
    )

  (set! (-> pad valid) (the-as uint 0))
  (set! (-> pad status) (the-as uint #x73))
  (set! (-> pad button0) buttons)
  (set! (-> pad leftx) lx)
  (set! (-> pad lefty) ly)
  (set! (-> pad rightx) rx)
  (set! (-> pad righty) ry)

  (if (logtest? (the-as pad-buttons buttons) (pad-buttons x))
      (set! (-> pad abutton (abutton-idx x)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx x)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons square))
      (set! (-> pad abutton (abutton-idx square)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx square)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons triangle))
      (set! (-> pad abutton (abutton-idx triangle)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx triangle)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons circle))
      (set! (-> pad abutton (abutton-idx circle)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx circle)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons l1))
      (set! (-> pad abutton (abutton-idx l1)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx l1)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons r1))
      (set! (-> pad abutton (abutton-idx r1)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx r1)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons l2))
      (set! (-> pad abutton (abutton-idx l2)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx l2)) (the uint8 0)))
  (if (logtest? (the-as pad-buttons buttons) (pad-buttons r2))
      (set! (-> pad abutton (abutton-idx r2)) (the uint8 255))
      (set! (-> pad abutton (abutton-idx r2)) (the uint8 0)))

  (let ((buttons-pushed (the-as pad-buttons buttons)))
     (if (< lx (the-as uint 30)) (set! buttons-pushed (logior (pad-buttons l-analog-left) buttons-pushed)))
     (if (> lx (the-as uint 225)) (set! buttons-pushed (logior (pad-buttons l-analog-right) buttons-pushed)))
     (if (< ly (the-as uint 30)) (set! buttons-pushed (logior (pad-buttons l-analog-up) buttons-pushed)))
     (if (> ly (the-as uint 225)) (set! buttons-pushed (logior (pad-buttons l-analog-down) buttons-pushed)))

     (if (< rx (the-as uint 30)) (set! buttons-pushed (logior (pad-buttons r-analog-left) buttons-pushed)))
     (if (> rx (the-as uint 225)) (set! buttons-pushed (logior (pad-buttons r-analog-right) buttons-pushed)))
     (if (< ry (the-as uint 30)) (set! buttons-pushed (logior (pad-buttons r-analog-up) buttons-pushed)))
     (if (> ry (the-as uint 225)) (set! buttons-pushed (logior (pad-buttons r-analog-down) buttons-pushed)))

     (set! (-> pad button0-shadow-abs 0) buttons-pushed)
     (set! (-> pad button0-abs 0) buttons-pushed)
     )
  (set! (-> pad button0-rel 0) (logclear (-> pad button0-abs 0) (-> pad button0-abs 1)))

  (let ((history (-> *cpad-history-list* cpads (-> pad number))))
    (set! (-> history button0-abs 0) (-> pad button0-abs 0))
    (set! (-> history button0-rel 0) (-> pad button0-rel 0))
    )

  (let ((f30-0 (* 0.0078125 (the float (+ (the int lx) -128))))
        (f28-0 (* 0.0078125 (the float (- 127 (the int ly))))))
    (set! (-> pad stick0-dir) (atan (- f30-0) f28-0))
    (set! (-> pad stick0-speed) (fmin 1.0 (sqrtf (+ (* f30-0 f30-0) (* f28-0 f28-0)))))
    )
  (if (< (-> pad stick0-speed) 0.3)
      (set! (-> pad stick0-speed) 0.0)
      )
  (none)
  )

(defun mp-puppet-note-remote-packet! ((info mp-player-record))
  "Track the last fresh remote player packet so input cannot replay forever."
  (when (and info (nonzero? info))
    (let ((packet-id (-> info connection latest-state-sequence)))
      (when (!= packet-id (-> info runtime last-state-packet-id))
        (set! (-> info runtime last-state-packet-id) packet-id)
        (set! (-> info runtime last-fresh-input-time) (current-time)))))
  (none)
  )

(defun mp-puppet-apply-weapon-state! ((proc target) (ghost mp-target-ghost-record))
  "Bring the puppet's gun state in line with the remote player's equipped weapon."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             ghost
             (nonzero? ghost)
             (-> ghost active?))
    (let ((record (mp-player-controller-target-record *mp-player-controller* proc))
          (weapon (the-as uint (-> ghost equipped-weapon)))
          (gun-info (-> proc gun)))
      (when (and record (nonzero? record) gun-info (nonzero? gun-info))
        (let ((active-type (the-as uint (-> gun-info gun-type)))
              (requested-type (the-as uint (-> gun-info using-gun-type))))
          (when (or (!= (the-as int active-type) (-> record runtime last-gun-log-active))
                    (!= (the-as int requested-type) (-> record runtime last-gun-log-requested)))
            (debug-log *mp-debug-log?*
                       "[MP-Puppet][Gun] remote=~D active=~D requested=~D state=~S using-gun?=~A~%"
                       weapon
                       active-type
                       requested-type
                       (if (and (-> proc state) (nonzero? (-> proc state)))
                           (-> proc state name)
                           'none)
                       (using-gun? proc))
            (set! (-> record runtime last-gun-log-active) (the-as int active-type))
            (set! (-> record runtime last-gun-log-requested) (the-as int requested-type))
            )
          (cond
            ((zero? weapon)
             (when (or (using-gun? proc) (nonzero? requested-type))
               (set! (-> gun-info using-gun-type) (pickup-type none))
               (when (using-gun? proc)
                 (send-event proc 'mp-put-gun-away)
                 )
               )
             )
            ((and (!= weapon active-type)
                  (!= (mp-equipped-weapon->pickup-type weapon) requested-type))
             (handle-gun-equip-marking-menu
               proc
               (mp-equipped-weapon->pickup-type weapon))
             )
          )
        )
      )
  )
  )
  (none)
)

(defun mp-puppet-gun-replay-ready? ((proc target) (weapon pickup-type))
  "Check that the puppet has a live gun process suitable for projectile replay."
  (and proc
       (nonzero? proc)
       (-> proc control)
       (nonzero? (-> proc control))
       (-> proc gun)
       (nonzero? (-> proc gun))
       (-> proc gun gun)
       (nonzero? (-> proc gun gun))
       (using-gun? proc)
       (= (-> proc gun gun-type) weapon)
       )
  )

(defun mp-puppet-force-gun-replay-equip! ((proc target) (weapon pickup-type))
  "Start the normal gun activation transition when replay finds an idle puppet."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             (-> proc gun)
             (nonzero? (-> proc gun))
             (not (using-gun? proc))
             (nonzero? (the-as uint weapon)))
    (debug-log *mp-debug-log?*
               "[MP-Puppet][GunReplay] Forcing gun equip: weapon=~D state=~S~%"
               (the-as uint weapon)
               (if (and (-> proc state) (nonzero? (-> proc state)))
                   (-> proc state name)
                   'none
                   )
               )
    (send-event proc 'change-mode 'gun #f weapon)
    )
  (none)
  )

(defun mp-puppet-repair-gun-replay-state! ((proc target) (ghost mp-target-ghost-record) (weapon pickup-type))
  "Reset a stale puppet gun before retrying a queued remote shot."
  (when (and proc
             (nonzero? proc)
             (-> proc gun)
             (nonzero? (-> proc gun))
             (using-gun? proc)
             (not (and (-> proc gun gun)
                       (nonzero? (-> proc gun gun))))
             )
    (debug-log *mp-debug-log?*
            "[MP-Puppet][GunReplay] Repairing stale gun: weapon=~D state=~S~%"
            (the-as uint weapon)
            (if (and (-> proc state) (nonzero? (-> proc state)))
                (-> proc state name)
                'none
                )
            )
    (send-event proc 'mp-put-gun-away)
    (when (and ghost (nonzero? ghost) (-> ghost active?))
      (when (and (-> proc gun) (nonzero? (-> proc gun)))
        (set! (-> proc gun using-gun-type) (pickup-type none))
        )
      (handle-gun-equip-marking-menu proc (the-as uint weapon))
      )
    )
  (none)
  )

(defun mp-puppet-gun-duck-state? ((cur-state symbol))
  "True while the puppet is in an on-foot duck state that should keep a held gun visible."
  (or (= cur-state 'target-duck-stance)
      (= cur-state 'target-duck-walk)
      )
  )

(defun mp-puppet-gun-stance-anim ((proc target) (gun-type pickup-type))
  "Return the existing gun stance top animation for the equipped weapon."
  (if (and proc
           (nonzero? proc)
           (-> proc draw)
           (nonzero? (-> proc draw))
           (-> proc draw art-group)
           (nonzero? (-> proc draw art-group)))
      (the-as art-joint-anim
              (-> proc draw art-group data
                  (case gun-type
                    (((pickup-type eco-yellow))
                     254
                     )
                    (((pickup-type eco-blue))
                     255
                     )
                    (((pickup-type eco-dark))
                     253
                     )
                    (else
                      244
                      )
                    )
                  )
              )
      (the-as art-joint-anim #f)
      )
  )

(defun mp-puppet-refresh-duck-gun-visibility! ((proc target) (cur-state symbol))
  "Keep a puppet-held gun renderable while vanilla gun stance has yielded to duck states."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             (-> proc gun)
             (nonzero? (-> proc gun))
             (using-gun? proc)
             (mp-puppet-gun-duck-state? cur-state))
    (let ((gun-info (-> proc gun)))
      (set! (-> gun-info active?) #t)
      (set! (-> gun-info laser-active?) #t)
      (set-time! (-> gun-info active-time))
      (when (< (current-time) (-> gun-info surpress-time))
        (set! (-> gun-info surpress-time) (current-time))
        )
      (when (and (= cur-state 'target-duck-stance)
                 (-> proc skel)
                 (nonzero? (-> proc skel))
                 (not (-> proc skel top-anim frame-group)))
        (let ((gun-anim (mp-puppet-gun-stance-anim proc (-> gun-info gun-type))))
          (when (and gun-anim (nonzero? gun-anim))
            (push-anim-to-targ
              (-> proc skel top-anim)
              gun-anim
              0.0
              0
              0
              1.0
              0.0
              #f
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-puppet-flush-pending-gun-shot! ((proc target) (ghost mp-target-ghost-record))
  "Replay a queued remote gun shot once the puppet has finished equipping."
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
  (when (and record
             (nonzero? record)
             (mp-player-runtime-flag? record (mp-player-runtime-flags pending-gun-shot))
             proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             ghost
             (nonzero? ghost)
             (-> ghost active?))
    (mp-puppet-apply-weapon-state! proc ghost)
    (let ((weapon (the-as pickup-type
                          (mp-equipped-weapon->pickup-type
                            (-> record runtime pending-gun-shot-weapon)))))
      (mp-puppet-force-gun-replay-equip! proc weapon)
      (mp-puppet-repair-gun-replay-state! proc ghost weapon)
      (if (mp-puppet-gun-replay-ready? proc weapon)
          (begin
            (set! *mp-processing-remote-event* #t)
            (send-event proc 'gun weapon)
            (set! *mp-processing-remote-event* #f)
            (mp-player-runtime-clear-flag! record (mp-player-runtime-flags pending-gun-shot))
            (set! (-> record runtime pending-gun-shot-weapon) (the uint8 0))
            (set! (-> record runtime pending-gun-shot-sequence) (the uint 0))
            (set! (-> record runtime pending-gun-shot-camera-angle) 0.0)
            )
          (when (!= (-> record runtime pending-gun-shot-sequence)
                    (-> record runtime last-gun-replay-debug-sequence))
            (set! (-> record runtime last-gun-replay-debug-sequence)
                  (-> record runtime pending-gun-shot-sequence))
            (debug-log *mp-debug-log?*
                    "[MP-Puppet][GunReplay] Waiting: state=~S using=~A gun=~A live=~A current=~D expected=~D~%"
                    (if (and proc (nonzero? proc) (-> proc state) (nonzero? (-> proc state)))
                        (-> proc state name)
                        'none
                        )
                    (if (and proc (nonzero? proc)) (if (using-gun? proc) "YES" "NO") "NO")
                    (if (and proc (nonzero? proc) (-> proc gun) (nonzero? (-> proc gun))) "YES" "NO")
                    (if (and proc
                             (nonzero? proc)
                             (-> proc gun)
                             (nonzero? (-> proc gun))
                             (-> proc gun gun)
                             (nonzero? (-> proc gun gun)))
                        "YES"
                        "NO"
                        )
                    (if (and proc (nonzero? proc) (-> proc gun) (nonzero? (-> proc gun)))
                        (the-as uint (-> proc gun gun-type))
                        (the-as uint 0)
                        )
                    (the-as uint weapon)
                    )
            )
          )
      )
    )
  )
  (none)
  )

(defun mp-puppet-receive-gun-shot!
       ((player-id uint) (evt mp-player-gun-shot-event))
  "Store a remote gun shot and try to replay it immediately."
  (let ((record (mp-player-record-by-id player-id)))
  (when (and record
             (nonzero? record)
             (> (-> evt shot-seq) (-> record runtime last-gun-shot-sequence)))
    (set! (-> record runtime last-gun-shot-sequence) (-> evt shot-seq))
    (mp-player-runtime-set-flag! record (mp-player-runtime-flags pending-gun-shot))
    (set! (-> record runtime pending-gun-shot-weapon) (-> evt weapon-type))
    (set! (-> record runtime pending-gun-shot-sequence) (-> evt shot-seq))
    (set! (-> record runtime pending-gun-shot-camera-angle) (-> evt cam-angle-y))
    (set! (-> record input equipped-weapon) (-> evt weapon-type))
    (set! (-> record input camera-angle-y) (-> evt cam-angle-y))
    (let ((ghost (mp-player-record-ghost record)))
      (when (and ghost (nonzero? ghost) (-> ghost active?))
        (set! (-> ghost equipped-weapon) (the-as uint8 (-> evt weapon-type)))
        (set! (-> ghost cam-angle-y) (-> evt cam-angle-y)))
      (let ((proc (mp-player-record-target record)))
        (when (and proc (nonzero? proc) ghost (nonzero? ghost))
          (mp-puppet-apply-weapon-state! proc ghost)
          (mp-puppet-flush-pending-gun-shot! proc ghost))))
    ))
  (none)
  )

(defun mp-puppet-remote-input-stale? ((record mp-player-record))
  "Has remote input gone stale long enough that replaying it is unsafe?"
  (or (not record)
      (zero? record)
      (zero? (-> record runtime last-fresh-input-time))
      (> (- (current-time) (-> record runtime last-fresh-input-time))
         *mp-puppet-input-stale-time*)
      )
  )

(defun mp-puppet-neutralize-pad! ((pad cpad-info))
  "Clear remote movement intent while preserving normal pad history bookkeeping."
  (mp-puppet-update-pad pad (the-as uint16 0) (the uint8 128) (the uint8 128) (the uint8 128) (the uint8 128))
  )

(defun mp-puppet-apply-input! ((proc target) (ghost mp-target-ghost-record))
  "Inject fresh remote input, or neutral input if packets have stopped arriving."
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
  (when (and record
             (nonzero? record)
             (-> proc control)
             (nonzero? (-> proc control))
             (-> proc control cpad)
             (nonzero? (-> proc control cpad)))
    (let ((buttons (the-as uint16 (-> ghost buttons))))
      (when (nonzero? (the-as uint (-> ghost equipped-weapon)))
        (set! buttons (logclear buttons (pad-buttons r1)))
        )
      (if (mp-puppet-remote-input-stale? record)
          (mp-puppet-neutralize-pad! (-> proc control cpad))
          (mp-puppet-update-pad (-> proc control cpad)
                                buttons
                                (-> ghost leftx)
                                (-> ghost lefty)
                                (-> ghost rightx)
                                (-> ghost righty))
          )
      )
    ))
  (none)
  )

(defun mp-target-state-attacking? ((state symbol))
  "Check if a target state is an attacking state where rotation tracking should be disabled."
  (case state
    (('target-attack
      'target-running-attack
      'target-attack-air
      'target-attack-uppercut
      'target-attack-uppercut-jump
      'target-darkjak-running-attack
      'target-indax-attack
      'target-indax-attack-air
      'target-indax-running-attack
      'target-indax-attack-uppercut
      'target-indax-attack-uppercut-jump
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-target-authoritative-action-state? ((state symbol))
  "True for short player action states that should be bumped from network edges."
  (case state
    (('target-jump
      'target-double-jump
      'target-high-jump
      'target-duck-high-jump
      'target-duck-high-jump-jump
      'target-roll
      'target-roll-flip
      'target-flop
      'target-attack
      'target-running-attack
      'target-attack-air
      'target-attack-uppercut
      'target-attack-uppercut-jump
      'target-darkjak-running-attack
      'target-darkjak-bomb0
      'target-darkjak-bomb1
      'target-darkjak-giant
      'target-indax-jump
      'target-indax-double-jump
      'target-indax-high-jump
      'target-indax-high-jump-jump
      'target-indax-roll
      'target-indax-roll-flip
      'target-indax-flop
      'target-indax-attack
      'target-indax-attack-air
      'target-indax-running-attack
      'target-indax-attack-uppercut
      'target-indax-attack-uppercut-jump
      'target-board-jump
      'target-board-jump-kick
      'target-mech-jump
      'target-mech-punch
      'target-carry-jump
      'target-carry-pickup
      'target-carry-drop
      'target-carry-throw
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-target-upward-action-state? ((state symbol))
  "True when authoritative action sync should trust the remote vertical pose."
  (case state
    (('target-jump
      'target-double-jump
      'target-high-jump
      'target-duck-high-jump
      'target-duck-high-jump-jump
      'target-attack-uppercut-jump
      'target-indax-jump
      'target-indax-double-jump
      'target-indax-high-jump
      'target-indax-high-jump-jump
      'target-indax-attack-uppercut-jump
      'target-board-jump
      'target-board-jump-kick
      'target-mech-jump
      'target-carry-jump
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-target-authoritative-board-action-state? ((state symbol))
  "True for board actions that should only be forced while already boarding."
  (case state
    (('target-board-jump
      'target-board-jump-kick
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-puppet-authoritative-action-compatible? ((proc target) (cur-state symbol) (action-state symbol))
  "Avoid forcing action states across mode boundaries already handled elsewhere."
  (and proc
       (nonzero? proc)
       (not (focus-test? proc pilot tube flut pole))
       (not (mp-target-death-state? cur-state))
       (mp-darkjak-puppet-action-compatible? proc action-state)
       (or (not (mp-target-authoritative-board-action-state? action-state))
           (focus-test? proc board)
           (mp-target-authoritative-board-action-state? cur-state))
       )
  )

(defun mp-puppet-dark-blast-prelude-active? ((proc target) (cur-state symbol) (action-state symbol))
  "True when native uppercut code is already preparing the synchronized Dark Blast."
  (and (= action-state 'target-darkjak-bomb1)
       (= cur-state 'target-attack-uppercut)
       proc
       (nonzero? proc)
       (focus-test? proc dark)
       (-> proc darkjak)
       (nonzero? (-> proc darkjak))
       (logtest? (-> proc darkjak stage) (darkjak-stage bomb1))
       )
  )

(defun mp-puppet-authoritative-action-observed? ((proc target) (cur-state symbol) (action-state symbol))
  "Acknowledge actions already entered through synchronized raw input."
  (or (= cur-state action-state)
      (mp-puppet-dark-blast-prelude-active? proc cur-state action-state)
      )
  )

(defun mp-puppet-ack-authoritative-action!
       ((record mp-player-record) (action-seq uint))
  (when (and record (nonzero? record))
    (set! (-> record runtime last-action-sequence) action-seq)
    (set! (-> record runtime state-mismatch-count) 0))
  (none)
  )

(defun mp-puppet-snap-for-authoritative-action! ((proc target) (ghost mp-target-ghost-record) (action-state symbol))
  "Prime pose/velocity so the next target state starts from the remote player's truth."
  (when (and proc
             (nonzero? proc)
             ghost
             (nonzero? ghost)
             (-> proc control)
             (nonzero? (-> proc control)))
    (let ((control (-> proc control)))
      (set! (-> control trans x) (-> ghost trans x))
      (set! (-> control trans z) (-> ghost trans z))
      (when (mp-target-upward-action-state? action-state)
        (set! (-> control trans y) (-> ghost trans y))
        )
      (vector-copy! (-> control transv) (-> ghost velocity))
      (quaternion-copy! (-> control quat) (-> ghost quat))
      (quaternion-copy! (-> control quat-for-control) (-> ghost quat))
      (quaternion-copy! (-> control dir-targ) (-> ghost quat))
      )
    )
  (none)
  )

(defun mp-puppet-go-authoritative-action! ((proc target) (action-state symbol))
  "Enter a whitelisted action state with native default arguments."
  (case action-state
    (('target-jump)
     (go-process proc target-jump (-> *TARGET-bank* jump-height-min) (-> *TARGET-bank* jump-height-max) (the-as surface #f))
     )
    (('target-double-jump)
     (go-process proc target-double-jump (-> *TARGET-bank* double-jump-height-min) (-> *TARGET-bank* double-jump-height-max))
     )
    (('target-high-jump)
     (go-process proc target-high-jump (-> *TARGET-bank* flip-jump-height-min) (-> *TARGET-bank* flip-jump-height-max) 'flip)
     )
    (('target-duck-high-jump)
     (go-process proc target-duck-high-jump (-> *TARGET-bank* duck-jump-height-min) (-> *TARGET-bank* duck-jump-height-max) 'duck)
     )
    (('target-duck-high-jump-jump)
     (go-process proc target-duck-high-jump-jump (-> *TARGET-bank* duck-jump-height-min) (-> *TARGET-bank* duck-jump-height-max) 'duck)
     )
    (('target-roll)
     (go-process proc target-roll)
     )
    (('target-roll-flip)
     (go-process proc target-roll-flip (-> *TARGET-bank* roll-flip-height) (-> *TARGET-bank* roll-flip-dist))
     )
    (('target-flop)
     (go-process proc target-flop 0.0 0.0 0.0)
     )
    (('target-attack)
     (go-process proc target-attack)
     )
    (('target-running-attack)
     (go-process proc target-running-attack)
     )
    (('target-attack-air)
     (go-process proc target-attack-air #f)
     )
    (('target-attack-uppercut)
     (go-process proc target-attack-uppercut (-> *TARGET-bank* attack-jump-height-min) (-> *TARGET-bank* attack-jump-height-max))
     )
    (('target-attack-uppercut-jump)
     (go-process proc target-attack-uppercut-jump (-> *TARGET-bank* attack-jump-height-min) (-> *TARGET-bank* attack-jump-height-max))
     )
    (('target-darkjak-running-attack)
     (go-process proc target-darkjak-running-attack)
     )
    (('target-darkjak-bomb0)
     (mp-darkjak-emit-puppet-attack-feedback! proc *target*)
     (go-process proc target-darkjak-bomb0)
     )
    (('target-darkjak-bomb1)
     (mp-darkjak-emit-puppet-attack-feedback! proc *target*)
     (go-process proc target-attack-uppercut (-> *TARGET-bank* attack-jump-height-min) (-> *TARGET-bank* attack-jump-height-max))
     )
    (('target-darkjak-giant)
     (mp-darkjak-emit-puppet-transform-feedback! proc *target*)
     (go-process proc target-darkjak-giant)
     )
    (('target-indax-jump)
     (go-process proc target-indax-jump (-> *TARGET-bank* indax-jump-height-min) (-> *TARGET-bank* indax-jump-height-max) (the-as surface #f))
     )
    (('target-indax-double-jump)
     (go-process proc target-indax-double-jump (-> *TARGET-bank* indax-double-jump-height-min) (-> *TARGET-bank* indax-double-jump-height-max))
     )
    (('target-indax-high-jump)
     (go-process proc target-indax-high-jump (-> *TARGET-bank* duck-jump-height-min) (-> *TARGET-bank* duck-jump-height-max) 'duck)
     )
    (('target-indax-high-jump-jump)
     (go-process proc target-indax-high-jump-jump (-> *TARGET-bank* duck-jump-height-min) (-> *TARGET-bank* duck-jump-height-max) 'duck)
     )
    (('target-indax-roll)
     (go-process proc target-indax-roll)
     )
    (('target-indax-roll-flip)
     (go-process proc target-indax-roll-flip (-> *TARGET-bank* roll-flip-height) (-> *TARGET-bank* roll-flip-dist))
     )
    (('target-indax-flop)
     (go-process proc target-indax-flop 0.0 0.0 0.0)
     )
    (('target-indax-attack)
     (go-process proc target-indax-attack)
     )
    (('target-indax-attack-air)
     (go-process proc target-indax-attack-air #f)
     )
    (('target-indax-running-attack)
     (go-process proc target-indax-running-attack)
     )
    (('target-indax-attack-uppercut)
     (go-process proc target-indax-attack-uppercut (-> *TARGET-bank* attack-jump-height-min) (-> *TARGET-bank* attack-jump-height-max))
     )
    (('target-indax-attack-uppercut-jump)
     (go-process proc target-indax-attack-uppercut-jump (-> *TARGET-bank* attack-jump-height-min) (-> *TARGET-bank* attack-jump-height-max))
     )
    (('target-board-jump)
     (go-process proc target-board-jump (-> *TARGET_BOARD-bank* jump-height-min) (-> *TARGET_BOARD-bank* jump-height-max) #f)
     )
    (('target-board-jump-kick)
     (go-process proc target-board-jump-kick)
     )
    (('target-mech-jump)
     (go-process proc target-mech-jump (-> *TARGET-bank* mech-jump-height-min) (-> *TARGET-bank* mech-jump-height-max) (the-as surface #f))
     )
    (('target-mech-punch)
     (go-process proc target-mech-punch)
     )
    (('target-carry-jump)
     (go-process proc target-carry-jump (-> *TARGET-bank* carry-jump-height-min) (-> *TARGET-bank* carry-jump-height-max) #f)
     )
    (('target-carry-pickup)
     (go-process proc target-carry-pickup)
     )
    (('target-carry-drop)
     (go-process proc target-carry-drop)
     )
    (('target-carry-throw)
     (go-process proc target-carry-throw)
     )
    (else #f)
    )
  (none)
  )

(defun mp-puppet-apply-authoritative-action! ((proc target) (ghost mp-target-ghost-record) (cur-state symbol))
  "Apply one-shot remote action transitions that raw input can miss after correction."
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
  (when (and record
             (nonzero? record)
             proc
             (nonzero? proc)
             ghost
             (nonzero? ghost)
             (-> proc control)
             (nonzero? (-> proc control))
             (time-elapsed? (-> record runtime action-warmup-start)
                            *mp-puppet-action-warmup-time*)
             cur-state
             (!= cur-state 'target-indax-start)
             (!= cur-state 'dead-state))
    (let ((action-seq (-> record action authoritative-sequence))
          (action-state (mp-target-get-state-from-id (-> record action action-state-id))))
      (when (and (nonzero? action-seq)
                 (!= action-seq (-> record runtime last-action-sequence))
                 action-state
                 (mp-target-authoritative-action-state? action-state))
        (cond
          ((mp-puppet-authoritative-action-observed? proc cur-state action-state)
           (mp-puppet-ack-authoritative-action! record action-seq)
           )
          ((mp-puppet-authoritative-action-compatible? proc cur-state action-state)
           (mp-puppet-snap-for-authoritative-action! proc ghost action-state)
           (mp-puppet-go-authoritative-action! proc action-state)
           (mp-puppet-ack-authoritative-action! record action-seq)
           )
          )
        )
      )
    ))
  (none)
  )

(defun mp-puppet-preserve-platform-y? ((proc target) (cur-state symbol))
  "True when platform rider motion should own the puppet's vertical position."
  (and proc
       (nonzero? proc)
       (-> proc control)
       (nonzero? (-> proc control))
       (not (focus-test? proc pilot tube flut mech pole grabbed))
       (not (mp-target-death-state? cur-state))
       (not (= cur-state 'target-ride-along))
       )
  )

(defun mp-target-edge-grab-state? ((state symbol))
  "True for all replicated edge-grab states, including transitions and pilot grabs."
  (or (= state 'target-edge-grab)
      (= state 'target-edge-grab-jump)
      (= state 'target-edge-grab-off)
      (= state 'target-indax-edge-grab)
      (= state 'target-indax-edge-grab-jump)
      (= state 'target-indax-edge-grab-off)
      (= state 'target-pilot-edge-grab)
      (= state 'target-indax-pilot-edge-grab)
      )
  )

(defun mp-target-pilot-edge-grab-state? ((state symbol))
  "True for the replicated pilot edge-grab states."
  (or (= state 'target-pilot-edge-grab)
      (= state 'target-indax-pilot-edge-grab)
      )
  )

(defun mp-puppet-in-edge-grab-state? ((proc target) (cur-state symbol))
  "True when a puppet is in or transitioning through any edge-grab state."
  (and proc
       (nonzero? proc)
       (or (focus-test? proc edge-grab)
           (mp-target-edge-grab-state? cur-state))
       )
  )

(defun mp-puppet-standard-edge-grab-active? ((proc target) (cur-state symbol))
  "True when authoritative player snapshots should drive a standard puppet grab."
  (when (and proc
             (nonzero? proc)
             (mp-puppet-in-edge-grab-state? proc cur-state))
    (let ((edge-state (-> proc edge-grab-state)))
      (when (and edge-state (nonzero? edge-state))
        (let ((edge-info (-> edge-state info)))
          (when (and edge-info
                     (nonzero? edge-info)
                     (not (-> edge-info pilot-edge-grab?)))
            (return #t))))))
  #f
  )

(defun mp-puppet-ensure-can-ride! ((proc target) (cur-state symbol))
  "Keep ordinary on-foot puppets eligible for vanilla platform rider detection."
  (when (mp-puppet-preserve-platform-y? proc cur-state)
    (let ((control (-> proc control)))
      (when (and control
                 (nonzero? control)
                 (-> control root-prim)
                 (nonzero? (-> control root-prim)))
        (logior! (-> control root-prim prim-core action) (collide-action can-ride))
        )
      )
    )
  (none)
  )

(defun mp-puppet-platform-rider-active? ((proc target))
  "True shortly after vanilla platform rider code has carried the puppet."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             (!= (-> proc control rider-time) (the-as time-frame 0)))
    (not (time-elapsed? (-> proc control rider-time) (seconds 0.2)))
    )
  )

(defun mp-puppet-should-correct-platform-y? ((cur-pos vector) (ghost-pos vector))
  "Allow Y recovery only when platform carry and ghost position have diverged badly."
  (> (fabs (- (-> ghost-pos y) (-> cur-pos y))) (meters 10.0))
  )

(defun mp-puppet-apply-transform-correction! ((proc target) (ghost mp-target-ghost-record) (cur-state symbol))
  "Correct puppet drift without pulling vertical position through local collision."
  (when (and proc
             (nonzero? proc)
             ghost
             (nonzero? ghost)
             (-> proc control)
             (nonzero? (-> proc control))
             (not (focus-test? proc pilot tube flut mech pole)))
    (mp-puppet-ensure-can-ride! proc cur-state)
    (let* ((control (-> proc control))
           (standard-edge-grab? (mp-puppet-standard-edge-grab-active? proc cur-state))
           (platform-y? (and (not standard-edge-grab?)
                             (mp-puppet-preserve-platform-y? proc cur-state)
                             (mp-puppet-platform-rider-active? proc)))
           (dist (vector-vector-distance (-> control trans) (-> ghost trans))))
      (cond
        ((> dist (meters 15.0))
         (vector-copy! (-> control trans) (-> ghost trans))
         (vector-copy! (-> control transv) (-> ghost velocity))
         )
        (standard-edge-grab?
         (let ((cur-pos (-> control trans))
               (ghost-pos (-> ghost trans))
               (position-factor 0.2))
           (set! (-> cur-pos x) (+ (-> cur-pos x) (* (- (-> ghost-pos x) (-> cur-pos x)) position-factor)))
           (set! (-> cur-pos y) (+ (-> cur-pos y) (* (- (-> ghost-pos y) (-> cur-pos y)) position-factor)))
           (set! (-> cur-pos z) (+ (-> cur-pos z) (* (- (-> ghost-pos z) (-> cur-pos z)) position-factor)))
           )
         )
        (else
         (let ((cur-pos (-> control trans))
               (ghost-pos (-> ghost trans))
               (xz-factor 0.2)
               (up-factor 0.15)
               (down-factor 0.05))
           (when (not (focus-test? proc grabbed))
             (set! (-> cur-pos x) (+ (-> cur-pos x) (* (- (-> ghost-pos x) (-> cur-pos x)) xz-factor)))
             (set! (-> cur-pos z) (+ (-> cur-pos z) (* (- (-> ghost-pos z) (-> cur-pos z)) xz-factor)))
             (when (or (not platform-y?) (mp-puppet-should-correct-platform-y? cur-pos ghost-pos))
               (if (> (-> ghost-pos y) (-> cur-pos y))
                   (set! (-> cur-pos y) (+ (-> cur-pos y) (* (- (-> ghost-pos y) (-> cur-pos y)) up-factor)))
                   (when (not (or (= cur-state 'target-falling)
                                  (= cur-state 'target-indax-falling)
                                  (= cur-state 'target-board-falling)
                                  (= cur-state 'target-mech-falling)
                                  (= cur-state 'target-carry-falling)))
                     (set! (-> cur-pos y) (+ (-> cur-pos y) (* (- (-> ghost-pos y) (-> cur-pos y)) down-factor)))
                     )
                   )
                 )
             )
           )
         )
        )
      (when (not (mp-puppet-remote-input-stale?
                   (mp-player-controller-target-record *mp-player-controller* proc)))
        (let ((cur-vel (-> control transv))
              (ghost-vel (-> ghost velocity))
              (vel-factor 0.35))
          (set! (-> cur-vel x) (+ (-> cur-vel x) (* (- (-> ghost-vel x) (-> cur-vel x)) vel-factor)))
          (when (not platform-y?)
            (set! (-> cur-vel y) (+ (-> cur-vel y) (* (- (-> ghost-vel y) (-> cur-vel y)) vel-factor)))
            )
          (set! (-> cur-vel z) (+ (-> cur-vel z) (* (- (-> ghost-vel z) (-> cur-vel z)) vel-factor)))
          )
        )

      (when (not (mp-target-state-attacking? cur-state))
        (let ((slerp-factor 0.25))
          (quaternion-slerp! (-> control quat) (-> control quat) (-> ghost quat) slerp-factor)
          (quaternion-slerp! (-> control quat-for-control) (-> control quat-for-control) (-> ghost quat) slerp-factor)
          (quaternion-slerp! (-> control dir-targ) (-> control dir-targ) (-> ghost quat) slerp-factor)
          )
        )
      )
    )
  (none)
  )

(defun mp-target-board-state? ((state symbol))
  "Check if a target state is any jetboard state."
  (case state
    (('target-board-start
      'target-board-stance
      'target-board-walk
      'target-board-duck-stance
      'target-board-jump
      'target-board-falling
      'target-board-jump-kick
      'target-board-halfpipe
      'target-board-get-on
      'target-board-get-off
      'target-board-hit
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-puppet-in-board-state? ((proc target) (cur-state symbol))
  "Check if the local puppet already has board focus or is transitioning through board setup."
  (or (focus-test? proc board)
      (mp-target-board-state? cur-state)
      )
  )

(defun mp-target-pole-state? ((state symbol))
  "Check if a target state is any swingpole state."
  (case state
    (('target-pole-cycle
      'target-pole-flip-up
      'target-pole-flip-up-jump
      'target-pole-flip-forward
      'target-pole-flip-forward-jump
      'target-indax-pole-cycle
      'target-indax-pole-flip-up
      'target-indax-pole-flip-up-jump
      'target-indax-pole-flip-forward
      'target-indax-pole-flip-forward-jump
      )
     #t
     )
    (else #f)
    )
  )

(defun mp-puppet-in-pole-state? ((proc target) (cur-state symbol))
  "Check if the local puppet is attached to or transitioning through a swingpole."
  (or (focus-test? proc pole)
      (mp-target-pole-state? cur-state)
      )
  )

(defun mp-puppet-pilot-entry-mode ((proc target))
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
  (if (mp-player-daxter? record)
      'pilot-daxter
      'pilot
      ))
  )

(defun mp-puppet-synced-to-vehicle-seat? ((proc target) (v-proc vehicle) (seat-index int))
  (and proc
       (nonzero? proc)
       v-proc
       (nonzero? v-proc)
       (focus-test? proc pilot)
       (nonzero? (-> proc pilot))
       (nonzero? (-> proc pilot vehicle))
       (= (handle->process-safe (-> proc pilot vehicle)) v-proc)
       (= (-> proc pilot seat-index) seat-index)
       )
  )

(deftype mp-base-turret-dummy (process-focusable)
  ((hud                    handle)
   (condition              int32)
   (shadow-backup          symbol)
   (rider                  handle)
   (actor-group            (pointer actor-group))
   (actor-group-count      int32)
   (alt-actor              symbol)
   (smush-control          smush-control        :inline)
   (sound-id               sound-id             3)
   (sound-playing          symbol               3)
   (cam-string-vector      vector               :inline)
   (path-event             structure)
   (path-u                 float)
   (path-u-prev            float)
   (path-mode              uint16)
   (path-speed             float)
   (path-speed-mult        float)
   (path-speed-mult-final  float)
   (path-old-pos           vector               :inline)
   (path-direction         symbol)
   (pause-proc             (function process symbol))
   (gun-recoil-jmod        joint-mod            4)
   (gun-index              int32)
   (shot-timeout           time-frame)
   (fire-time              time-frame)
   (fire-time-interval     time-frame)
   (enable-controls        symbol)
   (available-for-pickup   symbol)
   (roty                   degrees)
   (rotyv                  degrees)
   (rotyvv                 degrees)
   (roty-min               degrees)
   (roty-max               degrees)
   (rotx                   degrees)
   (rotxv                  degrees)
   (rotxvv                 degrees)
   (rotx-min               degrees)
   (rotx-max               degrees)
   )
  )

(deftype mp-turret-info-dummy (basic)
  ((process   (pointer process))
   (handle    handle)
   (turret    pointer)
   (grabbed?  symbol)
   (quat      quaternion  :inline)
   (trans     vector      :inline)
   )
  )

(defun mp-puppet-synced-to-turret? ((proc target) (t-proc mp-base-turret-dummy))
  (and proc
       (nonzero? proc)
       t-proc
       (nonzero? t-proc)
       (nonzero? (-> proc turret))
       (= (handle->process-safe (-> (the-as mp-turret-info-dummy (-> proc turret)) handle)) t-proc)
       (nonzero? (-> proc state))
       (or (= (-> proc state name) 'target-turret-stance)
           (= (-> proc state name) 'target-turret-get-on))
       )
  )

(defun mp-puppet-apply-turret-aim! ((turret-proc mp-base-turret-dummy) (info mp-player-record))
  (when (and turret-proc
             (nonzero? turret-proc)
             info
             (nonzero? info)
             (nonzero? (-> info vehicle turret-active?)))
    (set! (-> turret-proc enable-controls) #f)
    (set! (-> turret-proc roty) (-> info vehicle turret-roty))
    (set! (-> turret-proc rotyv) 0.0)
    (set! (-> turret-proc rotyvv) 0.0)
    (set! (-> turret-proc rotx) (-> info vehicle turret-rotx))
    (set! (-> turret-proc rotxv) 0.0)
    (set! (-> turret-proc rotxvv) 0.0)
    )
  (none)
  )

(defun mp-puppet-start-vehicle-entry! ((proc target) (v-proc vehicle) (seat-index int))
  "Start native pilot get-on for the puppet without pre-snapping into the seat."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             v-proc
             (nonzero? v-proc)
             (>= seat-index 0)
             (< seat-index 4))
    (vehicle-eject-civilian-riders! v-proc)
    (mp-vehicle-clear-seat-occupant! v-proc seat-index proc)
    (remove-rider v-proc proc)
    (send-event proc 'change-mode (mp-puppet-pilot-entry-mode proc) v-proc seat-index #f)
    )
  (none)
  )

(defun mp-puppet-repair-vehicle-seat-claim! ((proc target) (v-proc vehicle) (seat-index int))
  "Restore the winning puppet after a late local conflict disturbed the native rider array."
  (when (and proc
             (nonzero? proc)
             v-proc
             (nonzero? v-proc)
             (-> v-proc info)
             (nonzero? (-> v-proc info))
             (>= seat-index 0)
             (< seat-index (-> v-proc info seat-count))
             (focus-test? proc pilot-riding)
             (mp-puppet-synced-to-vehicle-seat? proc v-proc seat-index))
    (mp-vehicle-clear-seat-occupant! v-proc seat-index proc)
    (let ((seat-rider (get-rider-in-seat v-proc seat-index)))
      (when (or (not seat-rider) (= seat-rider proc))
        (put-rider-in-seat v-proc seat-index proc)
        )
      )
    )
  (none)
  )

(define *mp-jak-death-vo* (new 'static 'boxed-array :type string "jak065" "jak034" "jak076" "jak077" "jak042" "jak078"))
(define *mp-daxter-death-vo* (new 'static 'boxed-array :type string "ds199" "ds285" "ds490" "ds489" "dsek008" "dsek007"))

(defun mp-play-random-vo ((speaker process) (channel gui-channel) (vo-keys (array string)))
  "Play a random voice line from an array of vo-keys using the specified speaker and channel."
  (when (and speaker (nonzero? speaker) vo-keys (nonzero? vo-keys) (> (-> vo-keys length) 0))
    (let* ((idx (rand-vu-int-range 0 (+ (-> vo-keys length) -1)))
           (vo-key (-> vo-keys idx))
           )
      (when (and *gui-control* (nonzero? *gui-control*))
        (add-process *gui-control* speaker channel (gui-action play) vo-key -99.0 0)
        )
      )
    )
  (none)
  )

(defun mp-puppet-start-hit-flash! ((proc target))
  "Start the vanilla timed-invulnerability blink and hit vocal once per remote hit."
  (when (and proc
             (nonzero? proc)
             (-> proc control)
             (nonzero? (-> proc control))
             (-> proc clock)
             (nonzero? (-> proc clock))
             *TARGET-bank*
             (nonzero? *TARGET-bank*)
             (not (logtest? (-> proc state-flags) (state-flags tinvul1))))
    (target-timed-invulnerable
      (the-as time-frame (-> *TARGET-bank* hit-invulnerable-timeout))
      proc
      1)
    )
  (none)
  )

(defun mp-play-remote-death-vo ((record mp-player-record))
  "Play a funny voice line when the remote player dies."
  (when (and *target*
             (nonzero? *target*)
             (-> *target* state)
             (nonzero? (-> *target* state))
             (not (mp-target-death-state? (-> *target* state name))))
    (if (mp-player-daxter? record)
        (mp-play-random-vo *target* (gui-channel jak) *mp-jak-death-vo*)
        (mp-play-random-vo *target* (gui-channel daxter) *mp-daxter-death-vo*)
        )
    )
  (none)
  )

(defun mp-play-local-death-vo ()
  "Play a funny voice line from the remote player when the local player dies."
  (let ((record (mp-nearest-remote-player-record *target* #t)))
    (when (and record
               (nonzero? record)
               (not (mp-player-runtime-flag? record (mp-player-runtime-flags dead)))
               (not (mp-player-runtime-flag? record (mp-player-runtime-flags dying))))
      (let ((player-target (mp-player-record-target record)))
        (when (and player-target (nonzero? player-target))
          (if (mp-player-daxter? record)
              (mp-play-random-vo player-target (gui-channel daxter) *mp-daxter-death-vo*)
              (mp-play-random-vo player-target (gui-channel jak) *mp-jak-death-vo*)
              )
          )
        )
      )
    )
  (none)
  )

(defun mp-puppet-apply-ghost-correction! ((proc target))
  "Smoothly nudge the puppet target's root towards the ghost position and inject inputs."
  (let ((record (mp-player-controller-target-record *mp-player-controller* proc)))
    (when (and record (nonzero? record))
      (let ((ghost (mp-player-record-ghost record)))
    (when (and proc
               (nonzero? proc)
               ghost
               (nonzero? ghost)
               (-> ghost active?)
               (-> proc control)
               (nonzero? (-> proc control)))
      (logclear! (-> proc mask) (process-mask pause sleep actor-pause))

      (mp-darkjak-apply-remote-stage! proc (-> record action darkjak-stage))
      (mp-puppet-apply-input! proc ghost)
      (let ((cur-state (if (-> proc state) (-> proc state name) #f)))
        (mp-puppet-apply-transform-correction! proc ghost cur-state)
        (mp-puppet-apply-authoritative-action! proc ghost cur-state)
        (mp-darkjak-update-puppet-giant-feedback!
          proc *target* (-> record action darkjak-stage))
        (set! cur-state (if (-> proc state) (-> proc state name) cur-state))

        (let ((ghost-state (mp-target-get-state-from-id (-> ghost state-id))))
          (when (and ghost-state (!= cur-state ghost-state))
            (+! (-> record runtime state-mismatch-count) 1)
            (cond
              ((and (mp-target-death-state? ghost-state)
                    (not (mp-target-death-state? cur-state))
                    (not (mp-player-blocks-respawn? record)))
               (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Death! Bumping ~A -> ~A~%" cur-state ghost-state)
               (mp-player-runtime-set-flag! record (mp-player-runtime-flags dying))
               (send-event proc 'mp-die)
               (mp-play-remote-death-vo record)
               (set! (-> record runtime state-mismatch-count) 0)
               )
              ((and (mp-target-death-state? ghost-state)
                    (mp-target-death-state? cur-state))
               (set! (-> record runtime state-mismatch-count) 0)
               )
              ((or (= ghost-state 'target-hit) (= ghost-state 'target-indax-hit))
               (when (not (logtest? (-> proc state-flags) (state-flags tinvul1)))
                 (mp-puppet-start-hit-flash! proc)
                 (send-event proc 'mp-hit)
                 )
               (set! (-> record runtime state-mismatch-count) 0)
               )
              ((and (= ghost-state 'target-ride-along) (!= 'target-indax-jump-on cur-state))
               (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Ride Along! Bumping ~A -> ~A~%" cur-state ghost-state)
               (let ((player-proc (mp-player-record-by-id (-> proc player-id))))
                 (when (and player-proc (!= MP_INVALID_PLAYER_ID (-> player-proc action riding-along-player-id)))
                   (go-process proc target-indax-jump-on (-> player-proc action riding-along-player-id))
                   (set! (-> record runtime state-mismatch-count) 0)
                   )
                 )
               )
              ((and (mp-target-board-state? ghost-state)
                    (not (mp-puppet-in-board-state? proc cur-state)))
               (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Board! Bumping ~A -> ~A~%" cur-state ghost-state)
               (send-event proc 'change-mode 'board #f)
               (set! (-> record runtime state-mismatch-count) 0)
               )
              ((and (not (mp-target-board-state? ghost-state))
                    (mp-puppet-in-board-state? proc cur-state))
               (when (>= (-> record runtime state-mismatch-count) 10)
                 (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Non-Board! Bumping ~A -> ~A~%" cur-state ghost-state)
                 (send-event proc 'change-mode 'normal)
                 (set! (-> record runtime state-mismatch-count) 0)
                 )
               )
              ((and (not (mp-target-pole-state? ghost-state))
                    (mp-puppet-in-pole-state? proc cur-state))
               (when (>= (-> record runtime state-mismatch-count) 10)
                 (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Non-Pole! Bumping ~A -> ~A~%" cur-state ghost-state)
                 (send-event proc 'end-mode 'pole)
                 (set! (-> record runtime state-mismatch-count) 0)
                 )
               )
              ((= cur-state 'process-drawable-art-error)
                (when (>= (-> record runtime state-mismatch-count) 10)
                  (debug-log *mp-debug-log?* "[MP-Puppet] Stuck in drawable art error! Forcing exit...~%")
                  (mp-clear-target-edge-grab-pending! proc)
                  (deactivate proc)
                  (mp-player-controller-unbind-target!
                    *mp-player-controller*
                    (-> record identity player-id))
                  (set! (-> record runtime state-mismatch-count) 0)
                  )
              )
              ((= cur-state 'target-ride-along)
               (when (!= ghost-state 'target-ride-along)
                 (when (>= (-> record runtime state-mismatch-count) 2)
                   (debug-log *mp-debug-log?* "[MP-Puppet] Stuck in ride-along! Forcing exit to ~A~%" ghost-state)
                   (send-event proc 'change-mode 'normal #f)
                   (set! (-> record runtime state-mismatch-count) 0)
                   )
                 )
               )
              ((and (mp-target-edge-grab-state? ghost-state)
                    (not (mp-puppet-in-edge-grab-state? proc cur-state)))
               (when (>= (-> record runtime state-mismatch-count) 10)
                 (debug-log *mp-debug-log?* "[MP-Puppet] Authoritative Edge Grab! Bumping ~A -> ~A~%" cur-state ghost-state)
                 (mp-dispatch-edge-grab-to-target!
                   proc
                   (mp-target-pilot-edge-grab-state? ghost-state))
                 (set! (-> record runtime state-mismatch-count) 0)
                 )
               )
              ((mp-puppet-in-edge-grab-state? proc cur-state)
               (when (>= (-> record runtime state-mismatch-count) 10)
                 (debug-log *mp-debug-log?* "[MP-Puppet] Stuck in hang! Forcing exit via 'end-mode...~%")
                 (send-event proc 'end-mode 'edge-grab)
                 (set! (-> record runtime state-mismatch-count) 0)
                 )
               )
              )
            )
          (when (= cur-state ghost-state)
            (set! (-> record runtime state-mismatch-count) 0)
            )
          )

        (let ((info record)
              (ghost-state (mp-target-get-state-from-id (-> ghost state-id))))
          (let ((riding-veh-id
                  (if (and info (nonzero? info))
                      (-> info vehicle vehicle-id)
                      (the uint32 0)))
                (riding-seat-index
                  (if (and info (nonzero? info))
                      (-> info vehicle seat-index)
                      (the uint8 #xff))))
            (cond
              ((and (mp-target-death-state? ghost-state)
                    (focus-test? proc pilot)
                    (nonzero? (-> proc pilot))
                    (nonzero? (-> proc pilot vehicle)))
               (let ((v-proc (the-as vehicle (handle->process-safe (-> proc pilot vehicle))))
                     (seat-index (-> proc pilot seat-index)))
                  (when (and v-proc (nonzero? v-proc))
                    (remove-rider v-proc proc)
                    (when (and (>= seat-index 0) (< seat-index 4))
                      (set! (-> v-proc rider-array seat-index) (the-as handle #f))
                      )
                    )
                  (set! (-> proc pilot vehicle) (the-as handle #f))
                  (set! (-> proc pilot seat-index) 0)
                  (logclear! (-> proc focus-status) (focus-status pilot pilot-riding))
                  )
                )
              ((and (nonzero? riding-veh-id)
                    (or (= ghost-state 'target-turret-stance)
                        (= ghost-state 'target-turret-get-on)))
               (let* ((turret-ent (entity-by-aid riding-veh-id))
                      (turret-proc (the-as mp-base-turret-dummy (if (and turret-ent (nonzero? turret-ent)) (-> turret-ent extra process) #f))))
                 (when (and turret-proc (nonzero? turret-proc))
                   (mp-puppet-apply-turret-aim! turret-proc info)
                   (when (not (mp-puppet-synced-to-turret? proc turret-proc))
                     (debug-log *mp-debug-log?* "[MP-Puppet] Synced to turret (aid=~D)! Starting turret entry.~%" riding-veh-id)

                     (when (and (focus-test? proc pilot)
                                (nonzero? (-> proc pilot))
                                (nonzero? (-> proc pilot vehicle)))
                       (let ((v-proc (the-as vehicle (handle->process-safe (-> proc pilot vehicle))))
                             (seat-index (-> proc pilot seat-index)))
                         (when (and v-proc (nonzero? v-proc))
                           (remove-rider v-proc proc)
                           (if (and (>= seat-index 0) (< seat-index 4))
                               (set! (-> v-proc rider-array seat-index) (the-as handle #f))
                               )
                           )
                         )
                       )

                     (set! (-> turret-proc rider) (process->handle proc))
                     (set! (-> turret-proc available-for-pickup) #f)

                     (send-event proc 'change-state target-turret-get-on (process->handle turret-proc))
                     )
                   )
                 )
               )
              ((nonzero? riding-veh-id)
               (let ((v-proc (mp-vehicle-find-by-net-id riding-veh-id)))
                 (when (and v-proc (nonzero? v-proc))
                   (let ((seat-index (the int riding-seat-index)))
                     (when (mp-vehicle-seat-reserved-by-remote? v-proc seat-index)
                       (if (mp-puppet-synced-to-vehicle-seat? proc v-proc seat-index)
                           (mp-puppet-repair-vehicle-seat-claim! proc v-proc seat-index)
                           (begin
                             (mp-puppet-start-vehicle-entry! proc v-proc seat-index)
                             )
                           )
                       )
                     )
                   )
                 )
               )
              ((and (or (= cur-state 'target-turret-stance)
                        (= cur-state 'target-turret-get-on))
                    (not (or (= ghost-state 'target-turret-stance)
                             (= ghost-state 'target-turret-get-on))))
               (debug-log *mp-debug-log?* "[MP-Puppet] Puppet is in turret but ghost is not! Forcing exit.~%")
               (send-event proc 'change-state
                           (if (mp-player-daxter? record) target-indax-start target-stance)
                           (the handle #f))
               (when (and (nonzero? (-> proc turret)) (nonzero? (-> (the-as mp-turret-info-dummy (-> proc turret)) handle)))
                 (let ((turret-proc (the-as mp-base-turret-dummy (handle->process (-> (the-as mp-turret-info-dummy (-> proc turret)) handle)))))
                   (when (and turret-proc (nonzero? turret-proc))
                     (set! (-> turret-proc rider) (the-as handle #f))
                     (set! (-> turret-proc available-for-pickup) #t)
                     (set! (-> turret-proc enable-controls) #t)
                     (send-event turret-proc 'exit)
                     )
                   )
                 )
               )
              ((and (focus-test? proc pilot)
                    (nonzero? (-> proc pilot))
                    (nonzero? (-> proc pilot vehicle)))
               (send-event proc 'change-mode
                           (if (mp-player-daxter? record) 'indax 'normal)
                           #f)
               (let ((v-proc (the-as vehicle (handle->process (-> proc pilot vehicle)))))
                 (if (and v-proc (nonzero? v-proc))
                     (set! (-> v-proc rider-array (-> proc pilot seat-index)) (the-as handle #f))
                     )
                 )
               )
              )
            )
          )

        (mp-puppet-apply-weapon-state! proc ghost)
        (mp-puppet-flush-pending-gun-shot! proc ghost)
        (mp-puppet-refresh-duck-gun-visibility! proc cur-state)
      )

      (matrix-rotate-y! (-> proc control cam-R-w) (-> ghost cam-angle-y))
      (set! (-> proc control update-cam-R-w-start-time) (the-as int64 #x7fffffffffffffff))

      (if (mp-player-daxter? record)
          (logior! (-> proc draw status) (draw-control-status no-draw-bounds2))
          )
      )
      )))
  (none)
)

(defbehavior mp-puppet-init target ((arg0 continue-point) (player-id uint))
  "Initialize a target process as a remote player puppet. Bypasses continue/title states."
  (init-target self arg0 #t)
  (mp-player-controller-bind-target! *mp-player-controller* player-id self)
  (remove-setting! 'allow-pause)
  (remove-setting! 'allow-progress)

  (if (mp-target-daxter? self)
      (go target-indax-start (the handle #f))
      (go target-stance)
      )
  (none)
  )

(defun mp-puppet-deactivate! ((record mp-player-record))
  "Deactivate one record's puppet while retaining its network and pad state."
  (when (and record (nonzero? record))
    (let ((puppet (mp-player-record-target record)))
      (when (and (mp-puppet-process-live? puppet)
                 (or (not *target*)
                     (zero? *target*)
                     (!= puppet *target*)))
        (let ((id (if (and *mp-player-controller* (nonzero? *mp-player-controller*))
                      (mp-player-controller-record-id *mp-player-controller* record)
                      (the-as uint (-> record identity player-id)))))
          (debug-log *mp-debug-log?* "[MP-Puppet] Deactivating target puppet for player ~D...~%" id))
        (target-timed-invulnerable-off puppet 0)
        (mp-clear-target-edge-grab-pending! puppet)
        (deactivate puppet)))
    (mp-puppet-unbind-record-safe! record)
    (mp-player-runtime-clear-flag! record (mp-player-runtime-flags pending-gun-shot))
    (set! (-> record runtime pending-gun-shot-weapon) (the uint8 0))
    (set! (-> record runtime pending-gun-shot-sequence) (the uint 0))
    (set! (-> record runtime pending-gun-shot-camera-angle) 0.0)
    (set! (-> record runtime action-warmup-start) (the-as time-frame 0))
    (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle culled)))
  (none)
  )

(defun mp-target-pool-slot-available? ()
  "Keep target allocation inside the capacity-sized target dead pool."
  (if (and *target-dead-pool* (nonzero? *target-dead-pool*))
      (let ((free-slot (-> *target-dead-pool* child)))
        (and free-slot (nonzero? free-slot)))
      #f))

(defun mp-puppet-spawn ((record mp-player-record))
  "Spawn a new puppet target using native engine initialization."
  (when (and record
             (nonzero? record)
             (not (mp-player-record-target record))
             *target*
             (nonzero? *target*)
             *game-info*
             (nonzero? *game-info*)
             (-> *game-info* current-continue)
             (not (or (and (-> *target* next-state) (or (= (-> *target* next-state name) 'target-title)
                                                        (= (-> *target* next-state name) 'target-demo)))
                      (and (-> *target* state) (or (= (-> *target* state name) 'target-title)
                                                   (= (-> *target* state name) 'target-demo))))))
    (let ((id (the-as uint (-> record identity player-id))))
    (when (not (mp-target-pool-slot-available?))
      (when (!= (-> record runtime puppet-lifecycle)
                (mp-puppet-lifecycle spawning))
        (format 0
          "[MP-Puppet] Target pool exhausted; deferring player ~D spawn.~%"
          id))
      (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle spawning))
      (return (the-as target #f)))
    (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle spawning))
    (debug-log *mp-debug-log?* "[MP-Puppet] Spawning new target puppet with ID ~D...~%" id)
    (let ((p (process-spawn target :init mp-puppet-init (-> *game-info* current-continue) id :from *target-dead-pool* :to *target-pool* :stack *kernel-dram-stack*)))
      (when p
        (let ((puppet (the-as target (-> p 0))))
          (when (and puppet (nonzero? puppet))
            (mp-player-controller-bind-target! *mp-player-controller* id puppet)
            (set! (-> puppet name) "mp-puppet")))
        (set! (-> record runtime state-mismatch-count) 0)
        (mp-player-runtime-clear-flag! record (mp-player-runtime-flags dying))
        (mp-player-runtime-clear-flag! record (mp-player-runtime-flags dead))
        (set! (-> record runtime action-warmup-start) (current-time))
        (set! (-> record runtime last-action-sequence)
              (-> record action authoritative-sequence))

        (let ((puppet (mp-player-record-target record)))
          (when (and puppet (nonzero? puppet))
            (target-timed-invulnerable-off puppet 0)
            (mp-puppet-snap-to-ghost-on-spawn! puppet)))

        (if (mp-player-daxter? record)
          (begin
            (when (mp-player-runtime-flag? record (mp-player-runtime-flags recovering))
              (mp-player-runtime-clear-flag! record (mp-player-runtime-flags recovering))
              (let ((puppet (mp-player-record-target record)))
                (when (and puppet (nonzero? puppet))
                  (go-process puppet target-indax-spawn-reset)))
            )
          )
        )
        (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle active))
      )
      (when (not p)
        (set! (-> record runtime puppet-lifecycle) (mp-puppet-lifecycle none)))
    ))
  )
  (mp-player-record-target record)
)
