;;-*-Lisp-*-
(in-package goal)

(defun pack-local-mech-snapshot! ()
  (let ((record (mp-local-player-record)))
    (when (and (nonnull? record *target* (-> *target* mech)) (focus-test? *target* mech))
      (let ((entity (the-as entity-actor (-> *target* mech entity))))
        (when (nonnull? entity)
          (set! (-> record vehicle vehicle-id) (the uint (-> entity aid)))))))
  (none))

(defun any-player-in-mech? ()
  (when (and (nonnull? *target*) (focus-test? *target* mech) (not (focus-test? *target* dead)))
    (return #t))
  (mp-for-each-player-record (player-id record)
    (when (and (nonnull? record)
               (is-record-remote-player? record)
               (= (-> record connection activity) (mp-player-activity in-game)))
      (let ((state (mp-target-get-state-from-id (-> record action target-state-id))))
        (when (and (player-mech-state? state) (not (mp-target-death-state? state)))
          (return #t)))))
  #f)

(defun mech-reserved-by-remote? ((suit process-drawable))
  (when (nonnull? suit (-> suit entity))
    (let ((aid (-> (the-as entity-actor (-> suit entity)) aid)))
      (mp-for-each-player-record (player-id record)
        (when (and (nonnull? record)
                   (is-record-remote-player? record)
                   (mp-player-seat-reservation-levels-match? record)
                   (= (-> record vehicle vehicle-id) aid)
                   (!= (-> record action target-state-id) (the uint (mp-target-state-id mech-death)))
                   (player-mech-state? (mp-target-get-state-from-id (-> record action target-state-id))))
          (return #t)))))
  #f)

(defun reconcile-player-mech! ((replica target) (record mp-player-record) (cur-state symbol))
  (when (and (nonnull? replica record)
             (player-replica? replica)
             (mp-player-seat-reservation-levels-match? record))
    (let ((state (mp-target-get-state-from-id (-> record action target-state-id))))
      (cond
        ((or (= cur-state 'target-mech-get-on) (= cur-state 'target-mech-get-off))
         (return #t))
        ((and (player-mech-state? state)
              (!= state 'target-mech-get-off)
              (!= state 'target-mech-death)
              (not (focus-test? replica mech))
              (nonzero? (-> record vehicle vehicle-id)))
         (let ((entity (entity-by-aid (-> record vehicle vehicle-id))))
           (when (nonnull? entity (-> entity extra) (-> entity extra process))
             (send-event (-> entity extra process) 'replica-board :from replica)
             (return #t))))
        ((and (focus-test? replica mech)
              (or (= state 'target-mech-get-off)
                  (and (nonnull? state)
                       (not (player-mech-state? state))
                       (not (mp-target-death-state? state)))))
         (send-event replica 'end-mode)
         (return #t)))))
  #f)
