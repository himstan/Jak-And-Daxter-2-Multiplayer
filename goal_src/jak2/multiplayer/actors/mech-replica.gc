;;-*-Lisp-*-
(in-package goal)

(defun pack-local-mech-snapshot! ()
  (let ((record (mp-local-player-record)))
    (when (and (nonnull? record *target* (-> *target* mech)) (focus-test? *target* mech))
      (let ((entity (the-as entity-actor (-> *target* mech entity))))
        (when (nonnull? entity)
          (set! (-> record vehicle vehicle-id) (the uint (-> entity aid)))))))
  (none))

(defun any-player-in-mech? ()
  (when (and (nonnull? *target*) (focus-test? *target* mech) (not (focus-test? *target* dead)))
    (return #t))
  (mp-for-each-player-record (player-slot record)
    (when (and (nonnull? record)
               (is-record-remote-player? record)
               (= (-> record connection activity) (mp-player-activity in-game)))
      (let ((state (mp-target-get-state-from-id (-> record action target-state-id))))
        (when (and (player-mech-state? state) (not (mp-target-death-state? state)))
          (return #t)))))
  #f)

(defun mech-pilot ()
  (when (and (nonnull? *target*) (focus-test? *target* mech) (not (focus-test? *target* dead)))
    (return *target*))
  (mp-for-each-player-target (player-slot record pilot)
    (when (and (focus-test? pilot mech) (not (focus-test? pilot dead)))
      (return pilot)))
  (the-as target #f))

(defun mech-reserved-by-remote? ((suit process-drawable))
  (when (nonnull? suit (-> suit entity))
    (let ((aid (-> (the-as entity-actor (-> suit entity)) aid)))
      (mp-for-each-player-record (player-slot record)
        (when (and (nonnull? record)
                   (is-record-remote-player? record)
                   (= (-> record connection activity) (mp-player-activity in-game))
                   (= (-> record vehicle vehicle-id) aid)
                   (!= (-> record action target-state-id) (the uint (mp-target-state-id mech-death)))
                   (player-mech-state? (mp-target-get-state-from-id (-> record action target-state-id))))
          (return #t)))))
  #f)

(defun get-replica-mech ((aid uint))
  (when (nonnull? *level*)
    (let ((entity (entity-by-aid aid)))
      (when (and (nonnull? entity (-> entity extra) (-> entity extra level) (-> entity extra perm))
                 (type? entity entity-actor)
                 (= (-> entity extra level status) 'active))
        (let ((actor (the-as entity-actor entity)))
          (when (and (valid? (-> actor etype) type (the-as string #f) #f 0)
                     (= (-> actor etype symbol) 'mech))
            (unless (or (nonnull? (-> actor extra process))
                        (logtest? (-> actor extra perm status) (entity-perm-status bit-0 dead)))
              (birth! actor))
            (when (nonnull? (-> actor extra process))
              (logior! (-> actor extra process mask) (process-mask no-kill)))
            (return (-> actor extra process)))))))
  (the-as process #f))

(defun reconcile-player-mech! ((replica target) (record mp-player-record) (cur-state symbol))
  (when (and (nonnull? replica record) (player-replica? replica))
    (let ((state (mp-target-get-state-from-id (-> record action target-state-id))))
      (cond
        ((or (= cur-state 'target-mech-get-on) (= cur-state 'target-mech-get-off)) (return #t))
        ((and (player-mech-state? state)
              (!= state 'target-mech-get-off)
              (!= state 'target-mech-death)
              (not (focus-test? replica mech))
              (nonzero? (-> record vehicle vehicle-id)))
         (let ((suit (get-replica-mech (-> record vehicle vehicle-id))))
           (when (and (nonnull? suit (-> suit state) (-> suit next-state))
                      (or (= (-> suit next-state name) 'idle) (= (-> suit next-state name) 'wait-for-start)))
             (send-event suit 'replica-board :from replica (not (or (= state 'target-mech-start) (= state 'target-mech-get-on))))
             (return #t))))
        ((and (focus-test? replica mech)
              (or (= state 'target-mech-get-off)
                  (and (nonnull? state) (not (player-mech-state? state)) (not (mp-target-death-state? state)))))
         (send-event replica 'end-mode)
         (return #t)))))
  #f)
