    (((mp-target-state-id pole-cycle))    'target-pole-cycle)
    (((mp-target-state-id pole-flip-up))  'target-pole-flip-up)
    (((mp-target-state-id pole-flip-up-jump)) 'target-pole-flip-up-jump)
    (((mp-target-state-id pole-flip-forward)) 'target-pole-flip-forward)
