    (((mp-target-state-id indax-pilot-get-on)) 'target-indax-pilot-get-on)
    (((mp-target-state-id indax-pilot-get-off)) 'target-indax-pilot-get-off)
    (((mp-target-state-id indax-pilot-start)) 'target-indax-pilot-start)
    (((mp-target-state-id indax-pilot-impact)) 'target-indax-pilot-impact)
    (((mp-target-state-id indax-pilot-grab)) 'target-indax-pilot-grab)
    (((mp-target-state-id indax-pilot-clone-anim)) 'target-indax-pilot-clone-anim)
    (((mp-target-state-id indax-pilot-edge-grab)) 'target-indax-pilot-edge-grab)
    (((mp-target-state-id indax-pilot-hit)) 'target-indax-pilot-hit)
    (((mp-target-state-id indax-pilot-death)) 'target-indax-pilot-death)
    (((mp-target-state-id indax-start))   'target-indax-start)
    (((mp-target-state-id indax-pole-cycle)) 'target-indax-pole-cycle)
    (((mp-target-state-id indax-pole-flip-up)) 'target-indax-pole-flip-up)
    (((mp-target-state-id indax-pole-flip-up-jump)) 'target-indax-pole-flip-up-jump)
    (((mp-target-state-id indax-pole-flip-forward)) 'target-indax-pole-flip-forward)
    (((mp-target-state-id indax-pole-flip-forward-jump)) 'target-indax-pole-flip-forward-jump)
    (((mp-target-state-id board-start))   'target-board-start)
    (((mp-target-state-id board-duck-stance)) 'target-board-duck-stance)
    (((mp-target-state-id board-jump))    'target-board-jump)
    (((mp-target-state-id board-falling)) 'target-board-falling)
    (((mp-target-state-id board-jump-kick)) 'target-board-jump-kick)
    (((mp-target-state-id board-halfpipe)) 'target-board-halfpipe)
    (((mp-target-state-id board-get-on))  'target-board-get-on)
    (((mp-target-state-id board-get-off)) 'target-board-get-off)
    (((mp-target-state-id board-hit))     'target-board-hit)
    (((mp-target-state-id mech-start))    'target-mech-start)
    (((mp-target-state-id mech-stance))   'target-mech-stance)
    (((mp-target-state-id mech-walk))     'target-mech-walk)
    (((mp-target-state-id mech-jump))     'target-mech-jump)
    (((mp-target-state-id mech-falling))  'target-mech-falling)
    (((mp-target-state-id mech-punch))    'target-mech-punch)
    (((mp-target-state-id mech-get-on))   'target-mech-get-on)
    (((mp-target-state-id mech-get-off))  'target-mech-get-off)
    (((mp-target-state-id mech-hit))      'target-mech-hit)
    (((mp-target-state-id mech-death))    'target-mech-death)
    (((mp-target-state-id darkjak-get-on)) 'target-darkjak-get-on)
    (((mp-target-state-id darkjak-get-off)) 'target-darkjak-get-off)
    (((mp-target-state-id darkjak-running-attack)) 'target-darkjak-running-attack)
    (((mp-target-state-id darkjak-bomb0)) 'target-darkjak-bomb0)
    (((mp-target-state-id darkjak-bomb1)) 'target-darkjak-bomb1)
    (((mp-target-state-id darkjak-giant)) 'target-darkjak-giant)
    (((mp-target-state-id tube-start))    'target-tube-start)
    (((mp-target-state-id tube))          'target-tube)
    (((mp-target-state-id tube-jump))     'target-tube-jump)
    (((mp-target-state-id tube-hit))      'target-tube-hit)
    (((mp-target-state-id tube-death))    'target-tube-death)
    (((mp-target-state-id carry-stance))  'target-carry-stance)
    (((mp-target-state-id carry-walk))    'target-carry-walk)
    (((mp-target-state-id carry-jump))    'target-carry-jump)
    (((mp-target-state-id carry-falling)) 'target-carry-falling)
    (((mp-target-state-id carry-pickup))  'target-carry-pickup)
    (((mp-target-state-id carry-drop))    'target-carry-drop)
    (((mp-target-state-id carry-throw))   'target-carry-throw)
    (((mp-target-state-id wade-stance))   'target-wade-stance)
    (((mp-target-state-id wade-walk))     'target-wade-walk)
    (((mp-target-state-id swim-down))     'target-swim-down)
    (((mp-target-state-id swim-up))       'target-swim-up)
    (((mp-target-state-id swim-jump))     'target-swim-jump)
    (((mp-target-state-id turret-stance)) 'target-turret-stance)
