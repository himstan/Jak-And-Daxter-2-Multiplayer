;;-*-Lisp-*-
(in-package goal)

;; Shared helpers for non-authoritative actor ghost correction. Keep entity-specific
;; authority, state mapping, and target/focus rules in the enemy/pedestrian modules.

(defun mp-actor-state-retry-ready? ((last-bump time-frame))
  (time-elapsed? last-bump (seconds 0.35))
  )

(defun mp-actor-presentation-frame-blend ((rate float))
  (fmin 1.0 (fmax 0.0 (* rate (seconds-per-frame))))
  )

(defun mp-actor-update-presentation! ((presentation-trans vector)
                                      (presentation-quat quaternion)
                                      (target-trans vector)
                                      (target-quat quaternion)
                                      (initialized? symbol)
                                      (force-snap? symbol))
  "Advance an independent replica transform using only authoritative samples."
  (when (and presentation-trans
             (nonzero? presentation-trans)
             presentation-quat
             (nonzero? presentation-quat)
             target-trans
             (nonzero? target-trans)
             target-quat
             (nonzero? target-quat))
    (if (or (not initialized?)
            force-snap?
            (> (vector-vector-distance presentation-trans target-trans) (meters 5)))
        (begin
          (vector-copy! presentation-trans target-trans)
          (quaternion-copy! presentation-quat target-quat)
          )
        (begin
          (vector-lerp! presentation-trans
                        presentation-trans
                        target-trans
                        (mp-actor-presentation-frame-blend 15.0))
          (quaternion-slerp! presentation-quat
                             presentation-quat
                             target-quat
                             (mp-actor-presentation-frame-blend 24.0))
          )
        )
    )
  (none)
  )

(defun mp-actor-apply-presentation! ((root collide-shape)
                                     (presentation-trans vector)
                                     (presentation-quat quaternion)
                                     (authoritative-linvel vector))
  "Overwrite locally generated motion with the host-derived presentation transform."
  (when (and root
             (nonzero? root)
             presentation-trans
             (nonzero? presentation-trans)
             presentation-quat
             (nonzero? presentation-quat)
             authoritative-linvel
             (nonzero? authoritative-linvel))
    (vector-copy! (-> root trans) presentation-trans)
    (quaternion-copy! (-> root quat) presentation-quat)
    (vector-copy! (-> root transv) authoritative-linvel)
    )
  (none)
  )

(defun mp-actor-note-traffic-ghost-sample! ((rec mp-traffic-ghost-record)
                                            (new-x float)
                                            (new-y float)
                                            (new-z float))
  (when (and rec
             (nonzero? rec))
    (let ((now (pc-multi-get-ticks))
          (last-time (-> rec last-correction-time)))
      (if (and (nonzero? last-time)
               (> now last-time)
               (< (- now last-time) (the uint64 500)))
          (let ((dt-seconds (* 0.001 (the float (- now last-time)))))
            (when (> dt-seconds 0.0)
              (vector-copy! (-> rec ghost-angvel) (-> rec ghost-trans))
              (set-vector! (-> rec ghost-linvel)
                           (/ (- new-x (-> rec ghost-trans x)) dt-seconds)
                           (/ (- new-y (-> rec ghost-trans y)) dt-seconds)
                           (/ (- new-z (-> rec ghost-trans z)) dt-seconds)
                           0.0)
              )
            )
          (begin
            (set-vector! (-> rec ghost-linvel) 0.0 0.0 0.0 0.0)
            (set-vector! (-> rec ghost-angvel) new-x new-y new-z 1.0)
            )
          )
      (set! (-> rec last-correction-time) now)
      )
    )
  (none)
  )

(defun mp-actor-traffic-predicted-trans! ((rec mp-traffic-ghost-record) (out vector))
  (when (and rec
             (nonzero? rec)
             out
             (nonzero? out))
    (vector-copy! out (-> rec ghost-trans))
    (when (nonzero? (-> rec last-correction-time))
      (let ((now (pc-multi-get-ticks)))
        (when (>= now (-> rec last-correction-time))
          (let ((age-ms (the float (- now (-> rec last-correction-time))))
                (ping-ms (the float (pc-multi-get-ping)))
                (max-ahead-ms (if (= (-> rec entity-kind) (the uint8 1)) 100.0 150.0)))
            (let ((ahead-seconds (* 0.001 (fmin max-ahead-ms (fmax 0.0 (+ age-ms (* ping-ms 0.5)))))))
              (when (> ahead-seconds 0.0)
                (vector+float*! out (-> rec ghost-trans) (-> rec ghost-linvel) ahead-seconds)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )
