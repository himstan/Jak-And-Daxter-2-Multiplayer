;;-*-Lisp-*-
(in-package goal)

(defun mp-remote-player-marker-key ((record mp-player-record))
  (+ MP_REMOTE_PLAYER_MARKER_KEY_BASE (the-as int (mp-player-controller-record-id *mp-player-controller* record))))

(defun mp-reset-remote-marker-state! ()
  (when (and *minimap* (nonzero? *minimap*) (-> *minimap* engine) (nonzero? (-> *minimap* engine)))
    (dotimes (player-id MP_MAX_PLAYERS)
      (kill-by-key (-> *minimap* engine) (+ MP_REMOTE_PLAYER_MARKER_KEY_BASE player-id))))
  (none))

(defun mp-update-player-transform! ((record mp-player-record))
  (when (nonnull? record)
    (set! (-> record runtime interpolation-angle) (-> record transform angle))
    (mp-player-runtime-set-flag! record (mp-player-runtime-flags interp-initialized)))
  (none))

(defun mp-remote-player-marker-kill! ((record mp-player-record))
  (when (and record
             (nonzero? record)
             *minimap*
             (nonzero? *minimap*)
             (-> *minimap* engine)
             (nonzero? (-> *minimap* engine)))
    (kill-by-key (-> *minimap* engine) (mp-remote-player-marker-key record)))
  (none))

(defun mp-remote-player-marker-update! ((record mp-player-record))
  (when (nonnull? record (-> record connection state-cached?) *minimap* *target*)
    (let ((replica (mp-player-record-target record)))
      (if (player-replica-valid? replica)
        (add-icon! *minimap*
                   replica
                   (the-as uint (minimap-class remote-player))
                   (mp-remote-player-marker-key record)
                   (the-as vector #t)
                   0)
        (let ((presentation-position (mp-player-record-presentation-position record)))
          (when (and presentation-position (nonzero? presentation-position))
            (add-icon! *minimap*
                       *target*
                       (the-as uint (minimap-class remote-player))
                       (mp-remote-player-marker-key record)
                       presentation-position
                       0))))))
  (none))

(defun get-player-replica-distance-from-focus ((record mp-player-record))
  (let ((presentation-position (mp-player-record-presentation-position record)))
    (when (and (nonnull? record presentation-position *target* (-> *target* control))
               (nonzero? (-> record connection state-cached?)))
      (let ((focus-position (mp-region-target-pos)))
        (when (nonnull? focus-position)
          (return (vector-vector-distance focus-position presentation-position))))))
  (meters 1000000.0))

(defun player-replica-cull-vehicle! ((record mp-player-record))
  (when (and record (nonzero? record))
    (let ((vehicle-net-id (-> record vehicle state net-id)))
      (when (nonzero? vehicle-net-id)
        (let ((vehicle-process (mp-vehicle-find-by-net-id vehicle-net-id)))
          (when (and vehicle-process (nonzero? vehicle-process))
            (mp-vehicle-force-cull-local! vehicle-process)))))
    (set! (-> record runtime vehicle-handle) (the-as handle #f)))
  (none))

(defun player-replica-preserve-vehicle! ((record mp-player-record))
  (let ((vehicle-net-id (-> record vehicle state net-id)))
    (when (nonzero? vehicle-net-id)
      (let ((vehicle-process (mp-vehicle-find-by-net-id vehicle-net-id)))
        (when (and vehicle-process (nonzero? vehicle-process))
          (set! (-> record runtime vehicle-handle) (process->handle vehicle-process))
          (logior! (-> vehicle-process flags) (rigid-body-object-flag persistent))
          (logclear! (-> vehicle-process mask) (process-mask pause sleep actor-pause))))))
  (none))

(defun player-replica-presentation-allowed? ((record mp-player-record))
  (when (or (not (nonnull? record)) (zero? (-> record connection state-cached?)))
    (when (and (nonnull? record) (player-replica-valid? (mp-player-record-target record)))
      (player-replica-deactivate! record))
    (return #f))
  (let ((primary-id (mp-player-primary-level-id record)))
    (when (> primary-id 0)
      (let ((level-symbol (mp-level-id->symbol primary-id)))
        (when (and level-symbol (not (mp-level-active? level-symbol)))
          (when (player-replica-valid? (mp-player-record-target record))
            (player-replica-deactivate! record))
          (return #f)))))
  (let ((distance (get-player-replica-distance-from-focus record))
        (cull-suppressed? (mp-culling-suppressed-for-player? record)))
    (cond
      ((and (not cull-suppressed?) (> distance (meters 250.0)))
       (when (player-replica-valid? (mp-player-record-target record))
         (player-replica-deactivate! record))
       (player-replica-cull-vehicle! record)
       (mp-player-runtime-set-flag! record (mp-player-runtime-flags was-far))
       #f)
      ((and (<= distance (meters 250.0))
            (mp-player-runtime-flag? record (mp-player-runtime-flags was-far))
            (not (mp-player-runtime-flag? record (mp-player-runtime-flags warping))))
       (player-replica-preserve-vehicle! record)
       (player-replica-deactivate! record)
       (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far))
       #t)
      (else (when cull-suppressed? (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far))) #t))))

(defun manage-player-replica! ((record mp-player-record))
  (when (and (nonnull? record) (is-record-remote-player? record))
    (when (not (mp-player-runtime-flag? record (mp-player-runtime-flags join-announced)))
      (mp-player-runtime-set-flag! record (mp-player-runtime-flags join-announced))
      (mp-broadcast-player-join! record))
    (when (nonzero? (-> record identity spectator-only?))
      (mp-remote-player-marker-kill! record)
      (when (nonzero? (-> record runtime target-handle))
        (player-replica-deactivate! record))
      (player-replica-cull-vehicle! record)
      (set! (-> record runtime last-fresh-input-time) (the-as time-frame 0))
      (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far force-presentation))
      (return #f))
    (let ((remote-status (-> record connection activity)))
      (if (and (>= remote-status (mp-player-activity lobby)) (nonzero? (-> record connection state-cached?)))
        (begin
          (mp-update-player-transform! record)
          (player-replica-note-remote-packet! record)
          (player-update-target-record! record)
          (mp-vehicle-apply-player-piggyback record)
          (let ((replica (mp-player-record-target record)))
            (when (and replica (nonzero? replica) (not (player-replica-valid? replica)))
              (player-replica-clear-stale! record)))
          (when (and (player-replica-presentation-allowed? record)
                     (not (mp-player-runtime-flag? record (mp-player-runtime-flags warping))))
            (let ((replica (mp-player-record-target record)))
              (when (not (player-replica-valid? replica))
                (player-replica-spawn record))
              (set! replica (mp-player-record-target record))
              (when (player-replica-valid? replica)
                (set! (-> record runtime replica-lifecycle) (player-replica-lifecycle active))
                (player-replica-apply-record-correction! replica))))
          (mp-remote-player-marker-update! record))
        (begin
          (mp-remote-player-marker-kill! record)
          (when (mp-player-record-target record)
            (player-replica-deactivate! record))
          (player-replica-cull-vehicle! record)
          (set! (-> record runtime last-fresh-input-time) (the-as time-frame 0))
          (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far))))))
  (none))

(defun mp-cleanup-stale-player-presentation! ((record mp-player-record))
  (when (and record (nonzero? record))
    (when (mp-player-runtime-flag? record (mp-player-runtime-flags join-announced))
      (mp-broadcast-player-leave! record)
      (mp-player-runtime-clear-flag! record (mp-player-runtime-flags join-announced)))
    (mp-remote-player-marker-kill! record)
    (when (nonzero? (-> record runtime target-handle))
      (player-replica-deactivate! record))
    (player-replica-cull-vehicle! record)
    (set! (-> record runtime vehicle-handle) (the-as handle #f))
    (mp-player-controller-release-pad! *mp-player-controller* record)
    (mp-player-record-reset! record))
  (none))

(defun manage-remote-replicas! ()
  (mp-for-each-player-record (player-id record)
    (when (is-record-remote-player? record)
      (manage-player-replica! record)))
  (mp-player-controller-for-each-stale-remote! *mp-player-controller* mp-cleanup-stale-player-presentation!)
  (none))
