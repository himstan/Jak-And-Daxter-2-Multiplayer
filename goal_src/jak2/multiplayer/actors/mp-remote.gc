;;-*-Lisp-*-
(in-package goal)

(defun mp-remote-player-marker-key ((record mp-player-record))
  (+ MP_REMOTE_PLAYER_MARKER_KEY_BASE
     (the-as int
       (mp-player-controller-record-id *mp-player-controller* record))))

(defun mp-reset-remote-marker-state! ()
  (when (and *minimap*
             (nonzero? *minimap*)
             (-> *minimap* engine)
             (nonzero? (-> *minimap* engine)))
    (dotimes (player-id MP_MAX_PLAYERS)
      (kill-by-key
        (-> *minimap* engine)
        (+ MP_REMOTE_PLAYER_MARKER_KEY_BASE player-id))))
  (none))

(defun mp-update-player-transform! ((record mp-player-record))
  "Update one record's presentation transform from its latest network transform."
  (when (and record (nonzero? record))
    (let ((network-position (-> record transform position))
          (presentation-position (mp-player-record-presentation-position record))
          (presentation-quaternion (mp-player-record-presentation-quaternion record)))
      (when (and presentation-position
                 (nonzero? presentation-position)
                 presentation-quaternion
                 (nonzero? presentation-quaternion))
        (when (or (not (mp-player-runtime-flag?
                         record (mp-player-runtime-flags interp-initialized)))
                  (> (vector-vector-distance presentation-position network-position)
                     (meters 20.0)))
          (vector-copy! presentation-position network-position)
          (set! (-> record runtime interpolation-angle) (-> record transform angle))
          (mp-player-runtime-set-flag!
            record (mp-player-runtime-flags interp-initialized)))
        (vector-lerp!
          presentation-position
          presentation-position
          network-position
          (* 15.0 (seconds-per-frame)))
        (set! (-> record runtime interpolation-angle)
              (deg-seek
                (-> record runtime interpolation-angle)
                (-> record transform angle)
                (* (degrees 1080) (seconds-per-frame))))
        (quaternion-identity! presentation-quaternion)
        (quaternion-rotate-y!
          presentation-quaternion
          presentation-quaternion
          (-> record runtime interpolation-angle)))))
  (none))

(defun mp-remote-player-marker-kill! ((record mp-player-record))
  (when (and record
             (nonzero? record)
             *minimap*
             (nonzero? *minimap*)
             (-> *minimap* engine)
             (nonzero? (-> *minimap* engine)))
    (kill-by-key (-> *minimap* engine) (mp-remote-player-marker-key record)))
  (none))

(defun mp-remote-player-marker-update! ((record mp-player-record))
  "Keep a stable marker for one remote player, including while its puppet is culled."
  (when (and record
             (nonzero? record)
             *minimap*
             (nonzero? *minimap*)
             *target*
             (nonzero? *target*))
    (let ((puppet (mp-player-record-target record)))
      (if (mp-puppet-valid? puppet)
          (add-icon!
            *minimap*
            puppet
            (the-as uint (minimap-class remote-player))
            (mp-remote-player-marker-key record)
            (the-as vector #t)
            0)
          (let ((presentation-position
                  (mp-player-record-presentation-position record)))
            (when (and presentation-position (nonzero? presentation-position))
              (add-icon!
                *minimap*
                *target*
                (the-as uint (minimap-class remote-player))
                (mp-remote-player-marker-key record)
                presentation-position
                0))))))
  (none))

(defun mp-player-puppet-update-ghost! ((record mp-player-record))
  (let ((ghost (mp-player-record-ghost record)))
    (when (and ghost (nonzero? ghost))
      (mp-puppet-update-ghost! ghost record)))
  (none))

(defun mp-player-puppet-distance-from-local ((record mp-player-record))
  (let ((presentation-position (mp-player-record-presentation-position record)))
    (if (and presentation-position
             (nonzero? presentation-position)
             *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control)))
        (vector-vector-distance
          (-> *target* control trans)
          presentation-position)
        (meters 0.0))))

(defun mp-player-puppet-preserve-vehicle! ((record mp-player-record))
  (let ((vehicle-net-id (-> record vehicle state net-id)))
    (when (nonzero? vehicle-net-id)
      (let ((vehicle-process (mp-vehicle-find-by-net-id vehicle-net-id)))
        (when (and vehicle-process (nonzero? vehicle-process))
          (set! (-> record runtime vehicle-handle)
                (process->handle vehicle-process))
          (logior! (-> vehicle-process flags) (rigid-body-object-flag persistent))
          (logclear!
            (-> vehicle-process mask)
            (process-mask pause sleep actor-pause))))))
  (none))

(defun mp-player-puppet-presentation-allowed? ((record mp-player-record))
  "Apply independent culling and return whether this record should own a live puppet."
  (let ((distance (mp-player-puppet-distance-from-local record))
        (force-presentation?
          (mp-player-runtime-flag? record (mp-player-runtime-flags force-presentation))))
    (cond
      ((and (> distance (meters 250.0))
            (not force-presentation?))
       (when (mp-puppet-valid? (mp-player-record-target record))
         (mp-puppet-deactivate! record))
       (mp-player-runtime-set-flag! record (mp-player-runtime-flags was-far))
       #f)
      ((and (> distance (meters 250.0))
            force-presentation?
            (not (mp-player-level-ready? record)))
       (when (mp-puppet-valid? (mp-player-record-target record))
         (mp-puppet-deactivate! record))
       #f)
      ((and (<= distance (meters 250.0))
            (mp-player-runtime-flag? record (mp-player-runtime-flags was-far))
            (not (mp-player-runtime-flag? record (mp-player-runtime-flags warping))))
       (mp-player-puppet-preserve-vehicle! record)
       (mp-puppet-deactivate! record)
       (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far))
       #t)
      (else
       (when (and force-presentation? (mp-player-level-ready? record))
         (mp-player-runtime-clear-flag! record (mp-player-runtime-flags was-far)))
       #t))))

(defun mp-manage-player-puppet! ((record mp-player-record))
  "Advance one non-local record's presentation and target process."
  (when (and record
             (nonzero? record)
             (mp-player-record-remote? *mp-player-controller* record))
    (let ((remote-status (-> record connection status)))
      (if (>= remote-status 4)
          (begin
            (mp-update-player-transform! record)
            (mp-puppet-note-remote-packet! record)
            (mp-player-puppet-update-ghost! record)
            (let ((puppet (mp-player-record-target record)))
              (when (and puppet
                         (nonzero? puppet)
                         (not (mp-puppet-valid? puppet)))
                (mp-puppet-clear-stale! record)))
            (when (and (mp-player-puppet-presentation-allowed? record)
                       (not (mp-player-runtime-flag?
                              record (mp-player-runtime-flags warping))))
              (let ((puppet (mp-player-record-target record)))
                (when (not (mp-puppet-valid? puppet))
                  (mp-puppet-spawn record))
                (set! puppet (mp-player-record-target record))
                (when (mp-puppet-valid? puppet)
                  (set! (-> record runtime puppet-lifecycle)
                        (mp-puppet-lifecycle active))
                  (mp-puppet-apply-ghost-correction! puppet))))
            (mp-remote-player-marker-update! record))
          (begin
            (mp-remote-player-marker-kill! record)
            (when (mp-player-record-target record)
              (mp-puppet-deactivate! record))
            (set! (-> record runtime last-fresh-input-time)
                  (the-as time-frame 0))
            (mp-player-runtime-clear-flag!
              record (mp-player-runtime-flags was-far))))))
  (none))

(defun mp-cleanup-stale-player-presentation! ((record mp-player-record))
  "Release presentation resources retained across C++ slot invalidation."
  (when (and record (nonzero? record))
    (mp-remote-player-marker-kill! record)
    (when (nonzero? (-> record runtime target-handle))
      (mp-puppet-deactivate! record))
    (set! (-> record runtime vehicle-handle) (the-as handle #f))
    (mp-player-controller-release-pad! *mp-player-controller* record)
    (mp-player-record-reset! record))
  (none))

(defun mp-manage-remote-puppets! ()
  "Advance every joined non-local player without selecting a privileged remote."
  (mp-for-each-player-record (player-id record)
    (when (mp-player-record-remote? *mp-player-controller* record)
      (mp-manage-player-puppet! record)))
  (mp-player-controller-for-each-stale-remote!
    *mp-player-controller*
    mp-cleanup-stale-player-presentation!)
  (none))
