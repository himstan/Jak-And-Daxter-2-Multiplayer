;;-*-Lisp-*-
(in-package goal)

;; Typed outbound event factories. Builders only allocate and populate an event.
;; The caller owns readiness checks and passes the result to mp-event-enqueue!.

(defun mp-event-build-aid ((event-type uint) (aid uint))
  (let ((event (new 'stack-no-clear 'mp-aid-event)))
    (when (mp-event-prepare! event event-type)
      (set! (-> event aid) (the-as uint32 aid))
      (set! (-> event payload-size) (the uint 4))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

(defun mp-event-build-enemy-gem ((source-id uint) (gem-index uint))
  (let ((event (new 'stack-no-clear 'mp-enemy-gem-event)))
    (when (mp-event-prepare! event MP_EVENT_ENEMY_GEM)
      (set! (-> event source-id) (the-as uint32 source-id))
      (set! (-> event gem-index) (the-as uint32 gem-index))
      (set! (-> event payload-size) (the uint 8))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

(defun mp-event-build-actor-name ((event-type uint) (proc-name string))
  (let ((event (new 'stack-no-clear 'mp-actor-name-event)))
    (when (mp-event-prepare! event event-type)
      (dotimes (index 32)
        (set! (-> event target-name index) (the uint 0))
        )
      (when (and proc-name (nonzero? proc-name))
        (let ((copy-length (min 31 (length proc-name))))
          (dotimes (index copy-length)
            (set! (-> event target-name index) (-> proc-name data index))
            )
          )
        )
      (set! (-> event payload-size) (the uint 32))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

(defun mp-event-build-robotank-trigger ((proc-name string)
                                         (trigger-id int)
                                         (source-pos vector))
  (let ((event (new 'stack-no-clear 'mp-robotank-trigger-event)))
    (when (mp-event-prepare! event MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER)
      (dotimes (index 32)
        (set! (-> event target-name index) (the uint 0))
        )
      (when (and proc-name (nonzero? proc-name))
        (let ((copy-length (min 31 (length proc-name))))
          (dotimes (index copy-length)
            (set! (-> event target-name index) (-> proc-name data index))
            )
          )
        )
      (set! (-> event trigger-id) (the-as uint32 trigger-id))
      (if (and source-pos (nonzero? source-pos))
          (vector-copy! (-> event source-pos) source-pos)
          (vector-reset! (-> event source-pos)))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

(defun mp-event-build-gungame ((event-type uint)
                               (course-id uint)
                               (step uint)
                               (score int)
                               (elapsed-time uint)
                               (broken-mask uint)
                               (open-end? uint)
                               (end-door uint))
  (let ((event (new 'stack-no-clear 'mp-gungame-event)))
    (when (mp-event-prepare! event event-type)
      (set! (-> event course-id) course-id)
      (set! (-> event step) step)
      (set! (-> event score) score)
      (set! (-> event elapsed-time) elapsed-time)
      (set! (-> event broken-mask) broken-mask)
      (set! (-> event open-end?) open-end?)
      (set! (-> event end-door) end-door)
      (set! (-> event target-num) step)
      (set! (-> event payload-size) (the uint 32))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

