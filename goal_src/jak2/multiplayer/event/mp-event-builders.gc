  (the-as mp-widow-bomb-event #f))

(defun mp-event-build-widow-bomb-kick! ((event
                                          mp-widow-bomb-kick-event)
                                        (slot int)
                                        (kick-from vector)
                                        (kick-dest vector)
                                        (kick-height float))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_WIDOW_BOMB_KICK))
    (set! (-> event payload launch-slot) (the-as int8 slot))
    (if (nonnull? kick-from)
      (set! (-> event payload kick-from quad) (-> kick-from quad))
      (set-vector! (-> event payload kick-from) 0.0 0.0 0.0 1.0))
    (if (nonnull? kick-dest)
      (set! (-> event payload kick-dest quad) (-> kick-dest quad))
      (set-vector! (-> event payload kick-dest) 0.0 0.0 0.0 1.0))
    (set! (-> event payload kick-height) kick-height)
    (return event))
  (the-as mp-widow-bomb-kick-event #f))

