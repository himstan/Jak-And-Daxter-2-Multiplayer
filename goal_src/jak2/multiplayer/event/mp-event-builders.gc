(defun mp-event-build-continue! ((event mp-continue-event) (name string))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_CONTINUE_POINT))
      (dotimes (index 32)
        (set! (-> event continue-name index) (the uint 0))
        )
      (when (and name (nonzero? name))
        (let ((copy-length (min 31 (length name))))
          (dotimes (index copy-length)
            (set! (-> event continue-name index) (-> name data index))
            )
          )
        )
      (set! (-> event payload-size) (the uint 32))
      (return event)
      )
  (the-as mp-continue-event #f)
  )

(defun mp-event-build-edge-grab! ((event mp-event)
                                  (event-type uint)
                                  (packed edge-grab-state-event-data))
  (when (and event
             (nonzero? (the-as uint event))
             packed
             (nonzero? (the-as uint packed))
             (mp-event-prepare! event event-type))
      (mem-copy! (the-as pointer (-> event data))
                 (the-as pointer packed)
                 MP_EDGE_GRAB_EVENT_PAYLOAD_SIZE)
      (set! (-> event payload-size) (the-as uint MP_EDGE_GRAB_EVENT_PAYLOAD_SIZE))
      (return event)
      )
  (the-as mp-event #f)
  )

(defun mp-event-build-scene! ((event mp-scene-event)
                              (event-type uint)
                              (name string)
                              (load-continue string))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event event-type))
      (dotimes (index 64)
        (set! (-> event scene-name index) (the uint 0))
        (set! (-> event load-continue index) (the uint 0))
        )
      (when (and name (nonzero? name))
        (let ((copy-length (min 63 (length name))))
          (dotimes (index copy-length)
            (set! (-> event scene-name index) (-> name data index))
            )
          )
        )
      (when (and load-continue (nonzero? load-continue))
        (let ((copy-length (min 63 (length load-continue))))
          (dotimes (index copy-length)
            (set! (-> event load-continue index) (-> load-continue data index))
            )
          )
        )
      (set! (-> event event-id) event-type)
      (set! (-> event payload-size) (the uint 132))
      (return event)
      )
  (the-as mp-scene-event #f)
  )

(defun mp-event-build-waypoint! ((event mp-waypoint-event)
                                 (event-type uint)
                                 (course-id uint)
                                 (waypoint-id int)
                                 (skipped? symbol)
                                 (waypoint-request int)
                                 (host-in-scene? symbol)
                                 (process-name string))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event event-type))
      (set! (-> event course-id) (the-as uint32 course-id))
      (set! (-> event waypoint-id) (the-as int32 waypoint-id))
      (set! (-> event skipped) (if skipped? 1 0))
      (set! (-> event waypoint-request) (the-as int32 waypoint-request))
      (set! (-> event host-in-scene) (if host-in-scene? 1 0))
      (dotimes (index 32)
        (set! (-> event process-name index) (the uint 0))
        )
      (when (and process-name (nonzero? process-name))
        (let ((copy-length (min 31 (length process-name))))
          (dotimes (index copy-length)
            (set! (-> event process-name index) (-> process-name data index))
            )
          )
        )
      (set! (-> event payload-size) (the uint 52))
      (return event)
      )
  (the-as mp-waypoint-event #f)
  )

(defun mp-event-build-warp-gate! ((event mp-warp-gate-event)
                                  (gate-aid uint)
                                  (phase uint)
                                  (flags uint)
                                  (continue-name string)
                                  (start-pos vector)
                                  (end-pos vector))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_WARP_GATE))
      (set! (-> event gate-aid) (the-as uint32 gate-aid))
      (set! (-> event phase) (the-as uint32 phase))
      (set! (-> event flags) (the-as uint32 flags))
      (dotimes (index 32)
        (set! (-> event continue-name index) (the uint 0))
        )
      (when (and continue-name (nonzero? continue-name))
        (let ((copy-length (min 31 (length continue-name))))
          (dotimes (index copy-length)
            (set! (-> event continue-name index) (-> continue-name data index))
            )
          )
        )
      (if (and start-pos (nonzero? start-pos))
          (begin
            (set! (-> event start-x) (-> start-pos x))
            (set! (-> event start-y) (-> start-pos y))
            (set! (-> event start-z) (-> start-pos z)))
          (begin
            (set! (-> event start-x) 0.0)
            (set! (-> event start-y) 0.0)
            (set! (-> event start-z) 0.0)))
      (if (and end-pos (nonzero? end-pos))
          (begin
            (set! (-> event end-x) (-> end-pos x))
            (set! (-> event end-y) (-> end-pos y))
            (set! (-> event end-z) (-> end-pos z)))
          (begin
            (set! (-> event end-x) 0.0)
            (set! (-> event end-y) 0.0)
            (set! (-> event end-z) 0.0)))
      (set! (-> event payload-size) (the uint 68))
      (return event)
      )
  (the-as mp-warp-gate-event #f)
  )

