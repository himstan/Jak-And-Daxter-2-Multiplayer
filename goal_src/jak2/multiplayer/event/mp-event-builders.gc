;;-*-Lisp-*-
(in-package goal)

(defun mp-event-build-race! ((event mp-race-event) (details mp-race-event-data))
  (when (and (nonnull? event details) (mp-event-prepare! event MP_EVENT_RACE))
    (set! (-> event payload action) (-> details action))
    (set! (-> event payload generation) (-> details generation))
    (set! (-> event payload race-id) (-> details race-id))
    (set! (-> event payload racer-index) (-> details racer-index))
    (set! (-> event payload player-id) (-> details player-id))
    (set! (-> event payload player-mask) (-> details player-mask))
    (set! (-> event payload open-racer-mask) (-> details open-racer-mask))
    (set! (-> event payload value0) (-> details value0))
    (set! (-> event payload value1) (-> details value1))
    (set! (-> event payload sequence) (-> details sequence))
    (set! (-> event payload event-time) (-> details event-time))
    (return event))
  (the-as mp-race-event #f))

(defun mp-event-build-aid! ((event mp-aid-event) (event-type uint) (aid uint))
  (when (and (nonnull? event) (mp-event-prepare! event event-type))
    (set! (-> event payload aid) (the-as uint32 aid))
    (return event))
  (the-as mp-aid-event #f))

(defun mp-event-build-enemy-death! ((event mp-enemy-death-event) (aid uint))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_ENEMY_DEATH))
    (set! (-> event payload aid) (the-as uint32 aid))
    (return event))
  (the-as mp-enemy-death-event #f))

(defun mp-event-build-enemy-gem! ((event
                                    mp-enemy-gem-event)
                                  (source-id uint)
                                  (gem-index uint)
                                  (count float)
                                  (total float))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_ENEMY_GEM))
    (set! (-> event payload source-id) (the-as uint32 source-id))
    (set! (-> event payload count) count)
    (set! (-> event payload total) total)
    (set! (-> event payload gem-index) (the-as uint8 gem-index))
    (return event))
  (the-as mp-enemy-gem-event #f))

(defun mp-event-build-hover-enemy-spawn! ((event
                                            mp-hover-enemy-spawn-event)
                                          (manager-aid uint)
                                          (source-aid uint)
                                          (enemy-aid uint))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_HOVER_ENEMY_SPAWN))
    (set! (-> event payload manager-aid) (the-as uint32 manager-aid))
    (set! (-> event payload source-aid) (the-as uint32 source-aid))
    (set! (-> event payload enemy-aid) (the-as uint32 enemy-aid))
    (return event))
  (the-as mp-hover-enemy-spawn-event #f))

(defun mp-event-build-actor-name! ((event mp-actor-name-event) (event-type uint) (proc-name string))
  (when (and (nonnull? event) (mp-event-prepare! event event-type))
    (dotimes (index 32)
      (set! (-> event payload name index) (the uint 0)))
    (when (nonnull? proc-name)
      (let ((copy-length (min 31 (length proc-name))))
        (dotimes (index copy-length)
          (set! (-> event payload name index) (-> proc-name data index)))))
    (return event))
  (the-as mp-actor-name-event #f))

(defun mp-event-build-robotank-trigger! ((event
                                           mp-robotank-trigger-event)
                                         (proc-name string)
                                         (trigger-id int)
                                         (source-pos vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER))
    (dotimes (index 32)
      (set! (-> event payload target-name index) (the uint 0)))
    (when (nonnull? proc-name)
      (let ((copy-length (min 31 (length proc-name))))
        (dotimes (index copy-length)
          (set! (-> event payload target-name index) (-> proc-name data index)))))
    (set! (-> event payload trigger-id) (the-as int32 trigger-id))
    (if (nonnull? source-pos)
      (vector-copy! (-> event payload source-pos) source-pos)
      (vector-reset! (-> event payload source-pos)))
    (return event))
  (the-as mp-robotank-trigger-event #f))

(defun mp-event-build-krew-pickup! ((event mp-krew-collection-event) (bag-index int))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_MISSION_KREW_COLLECTION_PICKUP))
    (set! (-> event payload) (the-as uint8 bag-index))
    (return event))
  (the-as mp-krew-collection-event #f))

(defun mp-event-build-shuttle! ((event
                                  mp-shuttle-event)
                                (task-node uint)
                                (sub-state uint)
                                (started? uint)
                                (time-limit time-frame)
                                (remaining-time time-frame)
                                (counter int)
                                (sequence uint))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_MISSION_CITY_SHUTTLE_STATE))
    (set! (-> event payload task-node) (the-as uint16 task-node))
    (set! (-> event payload sub-state) (the-as uint8 sub-state))
    (set! (-> event payload started?) (the-as uint8 started?))
    (set! (-> event payload time-limit) time-limit)
    (set! (-> event payload remaining-time) remaining-time)
    (set! (-> event payload counter) counter)
    (set! (-> event payload sequence) sequence)
    (return event))
  (the-as mp-shuttle-event #f))

(defun mp-event-build-city-power! ((event mp-city-power-event) (turret-id uint) (state uint) (source-pos vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_MISSION_CITY_POWER_TURRET_STATE))
    (set! (-> event payload turret-id) (the-as uint8 turret-id))
    (set! (-> event payload state) (the-as uint8 state))
    (if (nonnull? source-pos)
      (vector-copy! (-> event payload source-pos) source-pos)
      (vector-reset! (-> event payload source-pos)))
    (return event))
  (the-as mp-city-power-event #f))

(defun mp-event-build-battle! ((event mp-battle-event) (details mp-battle-build-data))
  (when (and (nonnull? event details) (mp-event-prepare! event MP_EVENT_BATTLE_EVENT))
    (set! (-> event payload battle-evt) (-> details battle-action))
    (dotimes (index 32)
      (set! (-> event payload battle-name index) (-> details battle-name index)))
    (set! (-> event payload spawner-index) (-> details spawner-index))
    (set! (-> event payload breed-index) (-> details breed-index))
    (set! (-> event payload initial?) (the-as uint8 (if (-> details initial?) 1 0)))
    (set! (-> event payload enemy-aid) (the-as uint32 (-> details enemy-aid)))
    (set! (-> event payload owner-player-id) (-> details owner-player-id))
    (set! (-> event payload epoch) (the-as uint32 (-> details epoch)))
    (set! (-> event payload roster-generation) (the-as uint32 (-> details roster-generation)))
    (return event))
  (the-as mp-battle-event #f))

(defun mp-event-build-player-gun-shot! ((event
                                          mp-player-gun-shot-event)
                                        (weapon-type uint)
                                        (shot-seq uint)
                                        (cam-angle-y float))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_PLAYER_GUN_SHOT))
    (set! (-> event payload weapon-type) (the-as uint8 weapon-type))
    (set! (-> event payload shot-seq) (the-as uint32 shot-seq))
    (set! (-> event payload cam-angle-y) cam-angle-y)
    (return event))
  (the-as mp-player-gun-shot-event #f))

(defun mp-event-build-edge-grab! ((event mp-event) (event-type uint) (packed edge-grab-state-event-data))
  (when (and (nonnull? event packed) (mp-event-prepare! event event-type))
    (mem-copy! (the-as pointer (-> event data)) (the-as pointer packed) (the-as int (mp-event-payload-size event-type)))
    (return event))
  (the-as mp-event #f))

(defun mp-event-build-scene! ((event mp-scene-event) (event-type uint) (name string) (load-continue string))
  (when (and (nonnull? event) (mp-event-prepare! event event-type))
    (dotimes (index 32)
      (set! (-> event payload scene-name index) (the uint 0))
      (set! (-> event payload load-continue index) (the uint 0)))
    (when (nonnull? name)
      (let ((copy-length (min 31 (length name))))
        (dotimes (index copy-length)
          (set! (-> event payload scene-name index) (-> name data index)))))
    (when (nonnull? load-continue)
      (let ((copy-length (min 31 (length load-continue))))
        (dotimes (index copy-length)
          (set! (-> event payload load-continue index) (-> load-continue data index)))))
    (return event))
  (the-as mp-scene-event #f))

(defun mp-event-build-waypoint! ((event
                                   mp-waypoint-event)
                                 (event-type uint)
                                 (course-id uint)
                                 (waypoint-id int)
                                 (skipped? symbol)
                                 (waypoint-request int)
                                 (host-in-scene? symbol)
                                 (process-name string))
  (when (and (nonnull? event) (mp-event-prepare! event event-type))
    (set! (-> event payload course-id) (the-as uint8 course-id))
    (set! (-> event payload waypoint-id) (the-as int16 waypoint-id))
    (set! (-> event payload skipped) (the-as uint8 (if skipped? 1 0)))
    (set! (-> event payload waypoint-request) (the-as int16 waypoint-request))
    (set! (-> event payload host-in-scene) (the-as uint8 (if host-in-scene? 1 0)))
    (dotimes (index 32)
      (set! (-> event payload process-name index) (the uint 0)))
    (when (nonnull? process-name)
      (let ((copy-length (min 31 (length process-name))))
        (dotimes (index copy-length)
          (set! (-> event payload process-name index) (-> process-name data index)))))
    (return event))
  (the-as mp-waypoint-event #f))

(defun mp-event-build-warp-gate! ((event
                                    mp-warp-gate-event)
                                  (gate-aid uint)
                                  (phase uint)
                                  (flags uint)
                                  (continue-name string)
                                  (start-pos vector)
                                  (end-pos vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_WARP_GATE))
    (set! (-> event payload gate-aid) (the-as uint32 gate-aid))
    (set! (-> event payload phase) (the-as uint8 phase))
    (set! (-> event payload flags) (the-as uint8 flags))
    (dotimes (index 32)
      (set! (-> event payload continue-name index) (the uint 0)))
    (when (nonnull? continue-name)
      (let ((copy-length (min 31 (length continue-name))))
        (dotimes (index copy-length)
          (set! (-> event payload continue-name index) (-> continue-name data index)))))
    (if (nonnull? start-pos)
      (begin
        (set! (-> event payload start-x) (-> start-pos x))
        (set! (-> event payload start-y) (-> start-pos y))
        (set! (-> event payload start-z) (-> start-pos z)))
      (begin
        (set! (-> event payload start-x) 0.0)
        (set! (-> event payload start-y) 0.0)
        (set! (-> event payload start-z) 0.0)))
    (if (nonnull? end-pos)
      (begin
        (set! (-> event payload end-x) (-> end-pos x))
        (set! (-> event payload end-y) (-> end-pos y))
        (set! (-> event payload end-z) (-> end-pos z)))
      (begin
        (set! (-> event payload end-x) 0.0)
        (set! (-> event payload end-y) 0.0)
        (set! (-> event payload end-z) 0.0)))
    (return event))
  (the-as mp-warp-gate-event #f))

