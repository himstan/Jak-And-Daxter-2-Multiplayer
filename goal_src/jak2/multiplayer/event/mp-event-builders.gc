(defun mp-event-build-palace-squid ((evt-kind uint)
                                    (sequence uint)
                                    (param0 int)
                                    (param1 int)
                                    (param2 int)
                                    (charge float)
                                    (target-pos vector)
                                    (source-pos vector))
  (let ((event (new 'stack-no-clear 'mp-palace-squid-event)))
    (when (mp-event-prepare! event MP_EVENT_PALACE_SQUID)
      (set! (-> event squid-evt) evt-kind)
      (set! (-> event sequence) sequence)
      (set! (-> event param0) param0)
      (set! (-> event param1) param1)
      (set! (-> event param2) param2)
      (set! (-> event charge) charge)
      (if (and target-pos (nonzero? target-pos))
          (vector-copy! (-> event target-position) target-pos)
          (vector-reset! (-> event target-position)))
      (if (and source-pos (nonzero? source-pos))
          (vector-copy! (-> event source-position) source-pos)
          (vector-reset! (-> event source-position)))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

(defun mp-event-build-widow-spydroid ((spydroid-aid uint)
                                      (launch-slot int)
                                      (spawn-trans vector)
                                      (spawn-quat quaternion)
                                      (launch-dest vector))
  (let ((event (new 'stack-no-clear 'mp-widow-spydroid-event)))
    (when (mp-event-prepare! event MP_EVENT_WIDOW_SPYDROID)
      (set! (-> event spydroid-aid) (the-as uint32 spydroid-aid))
      (set! (-> event launch-slot) (the-as int32 launch-slot))
      (if (and spawn-trans (nonzero? spawn-trans))
          (set! (-> event spawn-trans quad) (-> spawn-trans quad))
          (set-vector! (-> event spawn-trans) 0.0 0.0 0.0 1.0))
      (if (and spawn-quat (nonzero? spawn-quat))
          (set! (-> event spawn-quat quad) (-> spawn-quat quad))
          (set-vector! (-> event spawn-quat) 0.0 0.0 0.0 1.0))
      (if (and launch-dest (nonzero? launch-dest))
          (set! (-> event launch-dest quad) (-> launch-dest quad))
          (set-vector! (-> event launch-dest) 0.0 0.0 0.0 1.0))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
    )
  (the-as mp-event #f)
  )

