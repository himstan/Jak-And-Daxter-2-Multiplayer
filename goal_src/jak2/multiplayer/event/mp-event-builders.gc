(defun mp-event-build-battle! ((event mp-battle-event)
                               (details mp-battle-build-data))
  (when (and event
             (nonzero? (the-as uint event))
             details
             (nonzero? details)
             (mp-event-prepare! event MP_EVENT_BATTLE_EVENT))
      (set! (-> event battle-evt) (-> details battle-action))
      (dotimes (index 32)
        (set! (-> event battle-name index) (the uint 0))
        )
      (set! (-> event spawner-index) (the-as uint32 (-> details spawner-index)))
      (set! (-> event breed-index) (the-as uint32 (-> details breed-index)))
      (set! (-> event initial?) (if (-> details initial?) 1 0))
      (set! (-> event enemy-aid) (the-as uint32 (-> details enemy-aid)))
      (set! (-> event owner-player-id) (the-as int32 (-> details owner-player-id)))
      (set! (-> event epoch) (the-as uint32 (-> details epoch)))
      (set! (-> event roster-generation) (the-as uint32 (-> details roster-generation)))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
  (the-as mp-battle-event #f)
  )

