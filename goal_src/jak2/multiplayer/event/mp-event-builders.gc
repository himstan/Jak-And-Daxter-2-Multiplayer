      (set! (-> event course-id) (-> details course-id))
      (set! (-> event step) (-> details step))
      (set! (-> event score) (-> details score))
      (set! (-> event elapsed-time) (-> details elapsed-time))
      (set! (-> event broken-mask) (-> details broken-mask))
      (set! (-> event open-end?) (-> details open-end?))
      (set! (-> event end-door) (-> details end-door))
      (set! (-> event target-num) (-> details step))
      (set! (-> event payload-size) (the uint 32))
      (return event)
      )
  (the-as mp-gungame-event #f)
  )

