;;-*-Lisp-*-
(in-package goal)

(defun mp-event-build-race! ((event mp-race-event)
                             (details mp-race-event-data))
  (when (and event
             (nonzero? (the-as uint event))
             details
             (nonzero? (the-as uint details))
             (mp-event-prepare! event MP_EVENT_RACE))
    (set! (-> event action) (-> details action))
    (set! (-> event generation) (-> details generation))
    (set! (-> event race-id) (-> details race-id))
    (set! (-> event racer-index) (-> details racer-index))
    (set! (-> event player-id) (-> details player-id))
    (set! (-> event participant-mask) (-> details participant-mask))
    (set! (-> event open-racer-mask) (-> details open-racer-mask))
    (set! (-> event value0) (-> details value0))
    (set! (-> event value1) (-> details value1))
    (set! (-> event sequence) (-> details sequence))
    (set! (-> event event-time) (-> details event-time))
    (set! (-> event payload-size) (the uint 48))
    (return event))
  (the-as mp-race-event #f))

(defun mp-event-enqueue-race! ((details mp-race-event-data))
  (when (and details (nonzero? (the-as uint details)))
    (let ((event (new 'stack-no-clear 'mp-race-event)))
      (mp-event-enqueue! (mp-event-build-race! event details))))
  (none))

;; Typed outbound event builders. Callers own the event storage and pass the
;; populated result to mp-event-enqueue!.

(defun mp-event-build-aid! ((event mp-aid-event) (event-type uint) (aid uint))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event event-type))
      (set! (-> event aid) (the-as uint32 aid))
      (set! (-> event payload-size) (the uint 4))
      (return event)
      )
  (the-as mp-aid-event #f)
  )

(defun mp-event-build-enemy-death! ((event mp-enemy-death-event) (aid uint))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_ENEMY_DEATH))
    (set! (-> event aid) (the-as uint32 aid))
    (set! (-> event payload-size) (the uint 4))
    (return event)
    )
  (the-as mp-enemy-death-event #f)
  )

(defun mp-event-build-enemy-gem! ((event mp-enemy-gem-event)
                                  (source-id uint)
                                  (gem-index uint))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_ENEMY_GEM))
      (set! (-> event source-id) (the-as uint32 source-id))
      (set! (-> event gem-index) (the-as uint32 gem-index))
      (set! (-> event payload-size) (the uint 8))
      (return event)
      )
  (the-as mp-enemy-gem-event #f)
  )

(defun mp-event-build-actor-name! ((event mp-actor-name-event)
                                   (event-type uint)
                                   (proc-name string))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event event-type))
      (dotimes (index 32)
        (set! (-> event target-name index) (the uint 0))
        )
      (when (and proc-name (nonzero? proc-name))
        (let ((copy-length (min 31 (length proc-name))))
          (dotimes (index copy-length)
            (set! (-> event target-name index) (-> proc-name data index))
            )
          )
        )
      (set! (-> event payload-size) (the uint 32))
      (return event)
      )
  (the-as mp-actor-name-event #f)
  )

(defun mp-event-build-robotank-trigger! ((event mp-robotank-trigger-event)
                                          (proc-name string)
                                          (trigger-id int)
                                          (source-pos vector))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER))
      (dotimes (index 32)
        (set! (-> event target-name index) (the uint 0))
        )
      (when (and proc-name (nonzero? proc-name))
        (let ((copy-length (min 31 (length proc-name))))
          (dotimes (index copy-length)
            (set! (-> event target-name index) (-> proc-name data index))
            )
          )
        )
      (set! (-> event trigger-id) (the-as uint32 trigger-id))
      (if (and source-pos (nonzero? source-pos))
          (vector-copy! (-> event source-pos) source-pos)
          (vector-reset! (-> event source-pos)))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
  (the-as mp-robotank-trigger-event #f)
  )

