(defun mp-event-build-actor-attack! ((event mp-actor-attack-event) (event-type uint) (details mp-ped-attack-event-data))
  (when (and (nonnull? event details) (mp-event-prepare! event event-type))
    (mem-copy! (the-as pointer (-> event payload)) (the-as pointer details) (size-of mp-ped-attack-event-data))
    (return event))
  (the-as mp-actor-attack-event #f))

(defun mp-event-build-mountain-resolution! ((event mp-mountain-resolution-event) (resolution uint))
  (when (and (nonnull? event)
             (or (= resolution MP_MOUNTAIN_RESOLUTION_LENS)
                 (= resolution MP_MOUNTAIN_RESOLUTION_GEAR)
                 (= resolution MP_MOUNTAIN_RESOLUTION_SHARD)
                 (= resolution MP_MOUNTAIN_RESOLUTION_BURIED_ROCKS)
                 (= resolution MP_MOUNTAIN_RESOLUTION_BUTTON_1)
                 (= resolution MP_MOUNTAIN_RESOLUTION_BUTTON_2)
                 (= resolution MP_MOUNTAIN_RESOLUTION_BUTTON_6))
             (mp-event-prepare! event MP_EVENT_MISSION_MOUNTAIN_RESOLUTION))
    (set! (-> event payload) (the-as uint8 resolution))
    (return event))
  (the-as mp-mountain-resolution-event #f))
