    (return event))
  (the-as mp-mtn-plat-shoot-event #f))

(defun mp-event-build-mtn-dice! ((event mp-mtn-dice-event) (aid uint) (prim-id int) (rot-axis vector) (rot-org vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_MTN_DICE))
    (set! (-> event payload aid) (the-as uint32 aid))
    (set! (-> event payload prim-id) (the-as uint8 prim-id))
    (if (nonnull? rot-axis) (vector-copy! (-> event payload rot-axis) rot-axis) (vector-reset! (-> event payload rot-axis)))
    (if (nonnull? rot-org) (vector-copy! (-> event payload rot-org) rot-org) (vector-reset! (-> event payload rot-org)))
    (return event))
  (the-as mp-mtn-dice-event #f))

