(defun mp-event-build-actor-attack ((event-type uint)
                                    (details mp-actor-attack-build-data))
  (let ((event (new 'stack-no-clear 'mp-actor-attack-event)))
    (when (and details
               (nonzero? details)
               (mp-event-prepare! event event-type))
      (set! (-> event net-id) (the-as uint32 (-> details net-id)))
      (set! (-> event attack-id) (the-as uint32 (-> details attack-id)))
      (set! (-> event flags) (the-as uint32 (-> details flags)))
      (set! (-> event knocked-type) (the-as uint32 (-> details knocked-type)))
      (set! (-> event new-hp) (the-as uint32 (-> details new-hp)))
      (set! (-> event shove-back) (-> details shove-back))
      (set! (-> event shove-up) (-> details shove-up))
      (set! (-> event hit-sound-id) (the-as uint32 (-> details hit-sound-id)))
      (set-vector! (-> event source-pos) 0.0 0.0 0.0 1.0)
      (set-vector! (-> event attack-dir) 0.0 0.0 1.0 0.0)
      (set! (-> event penetrate) (the-as uint (-> details penetrate)))
      (set! (-> event payload-size) (the uint 72))
      (return event)
      )
    )
  (the-as mp-actor-attack-event #f)
  )
