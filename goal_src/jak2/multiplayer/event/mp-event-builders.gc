(defun mp-event-build-stadium-board! ((event mp-stadium-board1-event) (event-type uint) (score int))
  (when (and (nonnull? event) (mp-event-prepare! event event-type))
    (set! (-> event payload score) (the-as int32 score))
    (return event))
  (the-as mp-stadium-board1-event #f))

(defun mp-event-build-palace-squid! ((event mp-palace-squid-event) (details mp-palace-squid-build-data))
  (when (and (nonnull? event details) (mp-event-prepare! event MP_EVENT_PALACE_SQUID))
    (set! (-> event payload squid-evt) (-> details evt-kind))
    (set! (-> event payload sequence) (-> details sequence))
    (set! (-> event payload param0) (-> details param0))
    (set! (-> event payload param1) (-> details param1))
    (set! (-> event payload charge) (-> details charge))
    (if (nonnull? (-> details target-pos))
      (vector-copy! (-> event payload target-position) (-> details target-pos))
      (vector-reset! (-> event payload target-position)))
    (if (nonnull? (-> details source-pos))
      (vector-copy! (-> event payload source-position) (-> details source-pos))
      (vector-reset! (-> event payload source-position)))
    (return event))
  (the-as mp-palace-squid-event #f))

(defun mp-event-build-widow-spydroid! ((event
                                         mp-widow-spydroid-event)
                                       (spydroid-aid uint)
                                       (launch-slot int)
                                       (spawn-trans vector)
                                       (spawn-quat quaternion)
                                       (launch-dest vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_WIDOW_SPYDROID))
    (set! (-> event payload spydroid-aid) (the-as uint32 spydroid-aid))
    (set! (-> event payload launch-slot) (the-as int8 launch-slot))
    (if (nonnull? spawn-trans)
      (set! (-> event payload spawn-trans quad) (-> spawn-trans quad))
      (set-vector! (-> event payload spawn-trans) 0.0 0.0 0.0 1.0))
    (if (nonnull? spawn-quat)
      (set! (-> event payload spawn-quat quad) (-> spawn-quat quad))
      (set-vector! (-> event payload spawn-quat) 0.0 0.0 0.0 1.0))
    (if (nonnull? launch-dest)
      (set! (-> event payload launch-dest quad) (-> launch-dest quad))
      (set-vector! (-> event payload launch-dest) 0.0 0.0 0.0 1.0))
    (return event))
  (the-as mp-widow-spydroid-event #f))

(defun mp-event-build-widow-bomb! ((event mp-widow-bomb-event) (launch-slot int) (launch-dest vector))
  (when (and (nonnull? event) (mp-event-prepare! event MP_EVENT_WIDOW_BOMB))
