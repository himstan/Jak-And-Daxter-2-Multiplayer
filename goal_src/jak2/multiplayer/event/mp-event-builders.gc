(defun mp-event-build-shuttle! ((event mp-shuttle-event)
                                (task-node uint)
                                (sub-state uint)
                                (started? uint)
                                (time-limit time-frame)
                                (remaining-time time-frame)
                                (counter int)
                                (sequence uint))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_MISSION_CITY_SHUTTLE_STATE))
      (set! (-> event task-node) task-node)
      (set! (-> event sub-state) sub-state)
      (set! (-> event started?) started?)
      (set! (-> event reserved) 0)
      (set! (-> event time-limit) time-limit)
      (set! (-> event remaining-time) remaining-time)
      (set! (-> event counter) counter)
      (set! (-> event sequence) sequence)
      (set! (-> event payload-size) (the uint 40))
      (return event)
      )
  (the-as mp-shuttle-event #f)
  )

