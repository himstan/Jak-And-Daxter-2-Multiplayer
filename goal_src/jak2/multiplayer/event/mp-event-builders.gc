(defun mp-event-build-palace-squid! ((event mp-palace-squid-event)
                                     (details mp-palace-squid-build-data))
  (when (and event
             (nonzero? (the-as uint event))
             details
             (nonzero? details)
             (mp-event-prepare! event MP_EVENT_PALACE_SQUID))
      (set! (-> event squid-evt) (-> details evt-kind))
      (set! (-> event sequence) (-> details sequence))
      (set! (-> event param0) (-> details param0))
      (set! (-> event param1) (-> details param1))
      (set! (-> event param2) (-> details param2))
      (set! (-> event charge) (-> details charge))
      (if (and (-> details target-pos) (nonzero? (-> details target-pos)))
          (vector-copy! (-> event target-position) (-> details target-pos))
          (vector-reset! (-> event target-position)))
      (if (and (-> details source-pos) (nonzero? (-> details source-pos)))
          (vector-copy! (-> event source-position) (-> details source-pos))
          (vector-reset! (-> event source-position)))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
  (the-as mp-palace-squid-event #f)
  )

(defun mp-event-build-widow-spydroid! ((event mp-widow-spydroid-event)
                                       (spydroid-aid uint)
                                       (launch-slot int)
                                       (spawn-trans vector)
                                       (spawn-quat quaternion)
                                       (launch-dest vector))
  (when (and event
             (nonzero? (the-as uint event))
             (mp-event-prepare! event MP_EVENT_WIDOW_SPYDROID))
      (set! (-> event spydroid-aid) (the-as uint32 spydroid-aid))
      (set! (-> event launch-slot) (the-as int32 launch-slot))
      (if (and spawn-trans (nonzero? spawn-trans))
          (set! (-> event spawn-trans quad) (-> spawn-trans quad))
          (set-vector! (-> event spawn-trans) 0.0 0.0 0.0 1.0))
      (if (and spawn-quat (nonzero? spawn-quat))
          (set! (-> event spawn-quat quad) (-> spawn-quat quad))
          (set-vector! (-> event spawn-quat) 0.0 0.0 0.0 1.0))
      (if (and launch-dest (nonzero? launch-dest))
          (set! (-> event launch-dest quad) (-> launch-dest quad))
          (set-vector! (-> event launch-dest) 0.0 0.0 0.0 1.0))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
  (the-as mp-widow-spydroid-event #f)
  )

