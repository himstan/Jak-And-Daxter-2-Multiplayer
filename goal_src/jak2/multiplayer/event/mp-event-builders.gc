(defun mp-event-build-battle ((battle-action uint)
                              (spawner-index int)
                              (breed-index int)
                              (initial? symbol)
                              (enemy-aid uint)
                              (owner-role int)
                              (epoch uint)
                              (roster-generation uint))
  (let ((event (new 'stack-no-clear 'mp-battle-event)))
    (when (mp-event-prepare! event MP_EVENT_BATTLE_EVENT)
      (set! (-> event battle-evt) battle-action)
      (dotimes (index 32)
        (set! (-> event battle-name index) (the uint 0))
        )
      (set! (-> event spawner-index) (the-as uint32 spawner-index))
      (set! (-> event breed-index) (the-as uint32 breed-index))
      (set! (-> event initial?) (if initial? 1 0))
      (set! (-> event enemy-aid) (the-as uint32 enemy-aid))
      (set! (-> event owner-role) (the-as int32 owner-role))
      (set! (-> event epoch) (the-as uint32 epoch))
      (set! (-> event roster-generation) (the-as uint32 roster-generation))
      (set! (-> event payload-size) (the uint 64))
      (return event)
      )
    )
  (the-as mp-battle-event #f)
  )

