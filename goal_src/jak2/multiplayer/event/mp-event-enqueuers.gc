;;-*-Lisp-*-
(in-package goal)

(defun mp-event-enqueue-aid! ((event-type uint) (aid uint))
  "Build and enqueue a short-lived aid event without growing caller frames."
  (let ((event (new 'stack-no-clear 'mp-aid-event)))
    (mp-event-enqueue!
      (mp-event-build-aid! event event-type aid)))
  (none)
  )

