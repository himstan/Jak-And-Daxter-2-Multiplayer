;;-*-Lisp-*-
(in-package goal)

(defmacro define-mp-events (&rest events)
  (let ((constants '())
        (sizes '())
        (routes '()))
    (dolist (remaining events)
      (let* ((event (car remaining))
             (name (first event))
             (id (second event))
             (payload-type (third event))
             (handler (cadddr event))
             (payload-size (if (eq? payload-type 'none) 0 `(size-of ,payload-type))))
        (set! constants (cons `(defconstant ,name (the uint ,id)) constants))
        (set! sizes (cons `((,name) (the uint8 ,payload-size)) sizes))
        (set! routes (cons `((,name) ,handler) routes))))
    `(begin
      ,@(reverse constants)
      (defun mp-event-payload-size ((event-id uint))
        (case event-id
          ,@(reverse sizes)
          (else (the uint8 #xff))))
      (defun mp-event-known? ((event-id uint))
        (!= (mp-event-payload-size event-id) (the uint8 #xff)))
      (defmacro mp-event-route! (event record)
        (list 'let
              (list (list 'evt event) (list 'source-record record))
              '(case (-> evt etype)
                ,@(reverse routes)
                (else (log 'debug "[MP-Event] No handler for event ID ~D.~%" (-> evt etype)))))))))

(define-mp-events (MP_EVENT_ORB 1 collectable-pickup-event-data (mp-event-handler-orb (the-as collectable-pickup-event evt)))
                  (MP_EVENT_GEM 2 collectable-pickup-event-data (mp-event-handler-gem (the-as collectable-pickup-event evt)))
