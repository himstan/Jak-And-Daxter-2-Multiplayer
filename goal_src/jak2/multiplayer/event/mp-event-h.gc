(define-extern mp-palace-squid-apply-grenade-event! (function mp-palace-squid-event none))
(define-extern mp-palace-squid-apply-whirlwind-event! (function mp-palace-squid-event none))
(define-extern mp-palace-squid-apply-resolution-event! (function uint none))
