(define-extern *mp-palace-squid-last-action-seq* uint)
(define-extern *mp-palace-squid-pending-resolution-seq* uint)

;; Typed outbound event factories. Factories only populate records; callers
;; pass their result to mp-event-enqueue! for readiness and FIFO handling.
(deftype mp-actor-attack-build-data (structure)
  ((net-id uint)
   (attack-id uint)
   (flags uint)
   (knocked-type uint)
   (new-hp int)
   (shove-back float)
   (shove-up float)
   (hit-sound-id uint)
   (penetrate uint)
   )
  )

(define-extern mp-event-build-aid (function uint uint mp-event))
(define-extern mp-event-build-enemy-gem (function uint uint mp-event))
(define-extern mp-event-build-actor-name (function uint string mp-event))
(define-extern mp-event-build-robotank-trigger (function string int vector mp-event))
