;;-*-Lisp-*-
(in-package goal)

;; Event IDs are generated from tools/multiplayer_schema/manifest.json.
;; Event declarations and payload-level constants live in this module.

;; Payload-level action values remain nested for subsystem-specific events.
(defconstant MP_PALACE_SQUID_EVT_HIT_REQUEST (the-as uint 1))
(defconstant MP_PALACE_SQUID_EVT_GRENADE (the-as uint 2))
(defconstant MP_PALACE_SQUID_EVT_WHIRLWIND (the-as uint 3))
(defconstant MP_PALACE_SQUID_EVT_RESOLUTION (the-as uint 4))

(defconstant MP_WARP_GATE_PHASE_BEGIN (the-as uint 1))
(defconstant MP_WARP_GATE_PHASE_ARRIVE (the-as uint 2))
(defconstant MP_WARP_GATE_FLAG_INDAX (the-as uint 1))

(defconstant MP_BATTLE_EVT_START (the-as uint 1))
(defconstant MP_BATTLE_EVT_END (the-as uint 2))
(defconstant MP_BATTLE_EVT_SPAWN (the-as uint 3))
(defconstant MP_BATTLE_EVT_CLAIM (the-as uint 4))
(defconstant MP_BATTLE_EVT_DESPAWN (the-as uint 5))
(defconstant MP_BATTLE_EVT_ROSTER_REQUEST (the-as uint 6))
(defconstant MP_BATTLE_EVT_ROSTER_BEGIN (the-as uint 7))
(defconstant MP_BATTLE_EVT_ROSTER_END (the-as uint 8))
(defconstant MP_BATTLE_EVT_RELEASE (the-as uint 9))

(defconstant MP_GUNGAME_COURSE_RED (the-as uint32 1))
(defconstant MP_GUNGAME_COURSE_YELLOW (the-as uint32 2))
(defconstant MP_GUNGAME_COURSE_BLUE (the-as uint32 3))
(defconstant MP_GUNGAME_COURSE_PEACE (the-as uint32 4))
(defconstant MP_GUNGAME_SPAWN_DUMMY_A (the-as int 1))
(defconstant MP_GUNGAME_SPAWN_DUMMY_B (the-as int 2))
(defconstant MP_GUNGAME_SPAWN_DUMMY_C (the-as int 3))
(defconstant MP_GUNGAME_SPAWN_DUMMY_GOLD (the-as int 4))
(defconstant MP_GUNGAME_SPAWN_DUMMY_BIG (the-as int 5))
(defconstant MP_GUNGAME_SPAWN_DUMMY_PEACE (the-as int 6))
(defconstant MP_GUNGAME_SPAWN_CIT_A (the-as int 10))
(defconstant MP_GUNGAME_SPAWN_CIT_B (the-as int 11))
(defconstant MP_GUNGAME_SPAWN_CIT_C (the-as int 12))
(defconstant MP_GUNGAME_SPAWN_CIT_D (the-as int 13))

(defconstant MP_ACTOR_ATTACK_HAS_SOURCE_POS (the-as uint32 1))
(defconstant MP_ACTOR_ATTACK_HAS_DIRECTION (the-as uint32 2))

(declare-type remote process-drawable)
(declare-type judge remote)
(define-perm *stadium-board1-judge* (pointer judge) (the-as (pointer judge) #f))

(defenum mp-hit-sound-id (uint32)
  (none 0)
  (spin 1)
  (punch 2)
  (uppercut 3)
  (flop 4)
  (board-spin 5)
  (mech-punch 6)
  )

(defenum mp-scene-state (uint32)
  (none 0)
  (started 1)
  (request-skip 2)
  (skipped 3)
  )

(deftype mp-event (structure)
  ((etype uint32)
   (payload-size uint32)
   (pad uint8 8)
   (data uint8 480)
   )
  :size-assert 496)

(deftype mp-edge-grab-event-data (structure)
  ((world-vertex vector 8 :inline)
   (local-vertex vector 8 :inline)
   (status uint64)
   (actor-cshape-prim-offset int32)
   (actor-id uint32)
   (actor-kind uint32)
   (hanging-matrix matrix :inline)
   (left-hand-hold vector :inline)
   (right-hand-hold vector :inline)
   (center-hold-old vector :inline)
   (edge-tri-pat uint32)
   (found-edge-bool uint32)
   (pilot-edge-grab-bool uint32)
   (pilot-local-pos vector :inline)
   (pilot-local-dir vector :inline)
   (pilot-actor-id uint32)
   (pilot-actor-kind uint32)
   (pilot-start-grab-pos vector :inline)
   (pilot-grab-interp float)
   )
  )

(deftype mp-aid-event (mp-event)
  ((aid uint32 :overlay-at (-> data 0))))

(deftype mp-fort-missile-target-event (mp-event)
  ((target-index uint32 :overlay-at (-> data 0))))

(deftype mp-widow-spydroid-event (mp-event)
  ((spydroid-aid uint32 :overlay-at (-> data 0))
   (launch-slot int32 :overlay-at (-> data 4))
   (spawn-trans vector :inline :overlay-at (-> data 16))
   (spawn-quat quaternion :inline :overlay-at (-> data 32))
   (launch-dest vector :inline :overlay-at (-> data 48))))

(deftype mp-widow-bomb-event (mp-event)
  ((launch-slot int32 :overlay-at (-> data 0))
   (launch-dest vector :inline :overlay-at (-> data 16))))

(deftype mp-widow-bomb-kick-event (mp-event)
  ((launch-slot int32 :overlay-at (-> data 0))
   (kick-from vector :inline :overlay-at (-> data 16))
   (kick-dest vector :inline :overlay-at (-> data 32))
   (kick-height float :overlay-at (-> data 48))))

(deftype mp-widow-bomb-fizzle-event (mp-event)
  ((launch-slot int32 :overlay-at (-> data 0))
   (fizzle-deadline time-frame :overlay-at (-> data 8))))

(deftype mp-widow-bomb-hit-event (mp-event)
  ((amount int32 :overlay-at (-> data 0))
   (hit-position vector :inline :overlay-at (-> data 16))))

(deftype mp-widow-catwalk-hit-event (mp-event)
  ((catwalk-index int32 :overlay-at (-> data 0))))

(defenum mp-enemy-death-hint (uint32)
  (die 0)
  (die-falling 1)
  (die-fast 2)
  )

(deftype mp-enemy-death-event (mp-event)
  ((aid uint32 :overlay-at (-> data 0))
   (death-hint uint32 :overlay-at (-> data 4))
   (state uint32 :overlay-at (-> data 8))
   (knocked-type uint32 :overlay-at (-> data 12))
   (hit-face uint32 :overlay-at (-> data 16))))

(deftype mp-enemy-gem-event (mp-event)
  ((source-id uint32 :overlay-at (-> data 0))
   (gem-index uint32 :overlay-at (-> data 4))))

(deftype mp-mtn-plat-shoot-event (mp-event)
  ((aid uint32 :overlay-at (-> data 0))
   (axe-flip vector :inline :overlay-at (-> data 16))))

(deftype mp-mtn-dice-event (mp-event)
  ((aid uint32 :overlay-at (-> data 0))
   (prim-id uint32 :overlay-at (-> data 4))
   (rot-axis vector :inline :overlay-at (-> data 16))
   (rot-org vector :inline :overlay-at (-> data 32))))

(deftype mp-palace-squid-event (mp-event)
  ((squid-evt uint32 :overlay-at (-> data 0))
   (sequence uint32 :overlay-at (-> data 4))
   (param0 int32 :overlay-at (-> data 8))
   (param1 int32 :overlay-at (-> data 12))
   (param2 int32 :overlay-at (-> data 16))
   (charge float :overlay-at (-> data 20))
   (target-position vector :inline :overlay-at (-> data 32))
   (source-position vector :inline :overlay-at (-> data 48))))

(deftype mp-actor-attack-event (mp-event)
  ((net-id uint32 :overlay-at (-> data 0))
   (attack-id uint32 :overlay-at (-> data 4))
   (flags uint32 :overlay-at (-> data 8))
   (knocked-type uint32 :overlay-at (-> data 12))
   (new-hp uint32 :overlay-at (-> data 16))
   (shove-back float :overlay-at (-> data 20))
   (shove-up float :overlay-at (-> data 24))
   (hit-sound-id uint32 :overlay-at (-> data 28))
   (source-pos vector :inline :overlay-at (-> data 32))
   (attack-dir vector :inline :overlay-at (-> data 48))
   (penetrate uint64 :overlay-at (-> data 64))))

(deftype mp-ped-death-event (mp-event)
  ((net-id uint32 :overlay-at (-> data 0))
   (death-hint uint32 :overlay-at (-> data 4))
   (state uint32 :overlay-at (-> data 8))
   (knocked-type uint32 :overlay-at (-> data 12))
   (flags uint32 :overlay-at (-> data 16))
   (source-pos vector :inline :overlay-at (-> data 32))
   (attack-dir vector :inline :overlay-at (-> data 48))))

;; Scene state is encoded by etype. The payload only carries scene data.
(deftype mp-scene-event (mp-event)
  ((scene-name uint8 64 :overlay-at (-> data 0))
   (event-id uint32 :overlay-at (-> data 64))
   (load-continue uint8 64 :overlay-at (-> data 68))))

;; Mission IDs are encoded by etype. These layouts contain payload only.
(deftype mp-actor-name-event (mp-event)
  ((target-name uint8 32 :overlay-at (-> data 0))))

(deftype mp-krew-collection-event (mp-event)
  ((bag-index uint32 :overlay-at (-> data 0))))

(deftype mp-shuttle-event (mp-event)
  ((task-node uint32 :overlay-at (-> data 0))
   (sub-state uint32 :overlay-at (-> data 4))
   (started? uint32 :overlay-at (-> data 8))
   (reserved uint32 :overlay-at (-> data 12))
   (time-limit time-frame :overlay-at (-> data 16))
   (remaining-time time-frame :overlay-at (-> data 24))
   (counter int32 :overlay-at (-> data 32))
   (sequence uint32 :overlay-at (-> data 36))))

(deftype mp-city-power-event (mp-event)
  ((turret-id uint32 :overlay-at (-> data 0))
   (state uint32 :overlay-at (-> data 4))
   (reserved uint32 :overlay-at (-> data 8))
   (source-pos vector :inline :overlay-at (-> data 16))))

(deftype mp-robotank-trigger-event (mp-event)
  ((target-name uint8 32 :overlay-at (-> data 0))
   (trigger-id uint32 :overlay-at (-> data 32))
   (source-pos vector :inline :overlay-at (-> data 48))))

(deftype mp-gungame-event (mp-event)
  ((course-id uint32 :overlay-at (-> data 0))
   (step uint32 :overlay-at (-> data 4))
   (score int32 :overlay-at (-> data 8))
   (elapsed-time uint32 :overlay-at (-> data 12))
   (broken-mask uint32 :overlay-at (-> data 16))
   (open-end? uint32 :overlay-at (-> data 20))
   (end-door uint32 :overlay-at (-> data 24))
   (target-num uint32 :overlay-at (-> data 28))))

(deftype mp-battle-event (mp-event)
  ((battle-evt uint32 :overlay-at (-> data 0))
   (battle-name uint8 32 :overlay-at (-> data 4))
   (spawner-index uint32 :overlay-at (-> data 36))
   (breed-index uint32 :overlay-at (-> data 40))
   (initial? uint32 :overlay-at (-> data 44))
   (enemy-aid uint32 :overlay-at (-> data 48))
   (owner-role int32 :overlay-at (-> data 52))
   (epoch uint32 :overlay-at (-> data 56))
   (roster-generation uint32 :overlay-at (-> data 60))))

(deftype mp-player-gun-shot-event (mp-event)
  ((weapon-type uint32 :overlay-at (-> data 0))
   (shot-seq uint32 :overlay-at (-> data 4))
   (cam-angle-y float :overlay-at (-> data 8))))

(deftype mp-continue-event (mp-event)
  ((continue-name uint8 32 :overlay-at (-> data 0))))

(deftype mp-warp-gate-event (mp-event)
  ((gate-aid uint32 :overlay-at (-> data 0))
   (phase uint32 :overlay-at (-> data 4))
   (flags uint32 :overlay-at (-> data 8))
   (continue-name uint8 32 :overlay-at (-> data 12))
   (start-x float :overlay-at (-> data 44))
   (start-y float :overlay-at (-> data 48))
   (start-z float :overlay-at (-> data 52))
   (end-x float :overlay-at (-> data 56))
   (end-y float :overlay-at (-> data 60))
   (end-z float :overlay-at (-> data 64))))

(deftype mp-waypoint-event (mp-event)
  ((course-id uint32 :overlay-at (-> data 0))
   (waypoint-id int32 :overlay-at (-> data 4))
   (skipped uint32 :overlay-at (-> data 8))
   (waypoint-request int32 :overlay-at (-> data 12))
   (process-name uint8 32 :overlay-at (-> data 16))
   (host-in-scene uint32 :overlay-at (-> data 48))))

(deftype mp-stadium-board1-event (mp-event)
  ((score int32 :overlay-at (-> data 0))
   (unused uint32 :overlay-at (-> data 4))))

(deftype mp-event-buffer (structure)
  ((out-count uint32)
   (pad1 uint8 12)
   (out-events mp-event 16 :inline)
   (in-count uint32)
   (pad2 uint8 12)
   (in-events mp-event 16 :inline))
  :size-assert 15904)

(define-perm *mp-event-buffer* mp-event-buffer (new 'static 'mp-event-buffer))

;; The queue owns all pointer/count manipulation. Producers only call these APIs.
(define-extern mp-event-prepare! (function mp-event uint symbol))
(define-extern mp-event-enqueue! (function mp-event symbol))
(define-extern mp-event-queue-reset! (function none))
(define-extern mp-event-dispatch! (function mp-event none))
(define-extern mp-push-local-events (function none))
(define-extern mp-process-inbound-events (function none))
(define-extern pc-multi-send-events (function uint none))
(define-extern pc-multi-receive-events (function uint none))

