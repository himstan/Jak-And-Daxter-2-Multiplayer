(defenum mp-hit-sound-id
  (uint8)
  (none 0)
  (spin 1)
  (punch 2)
  (uppercut 3)
  (flop 4)
  (board-spin 5)
  (mech-punch 6))

(defenum mp-scene-state
  (uint8)
  (none 0)
  (started 1)
  (request-skip 2)
  (skipped 3))

(deftype mp-event (structure)
  ((etype            uint8)
   (source-player-id uint8)
   (payload-size     uint8)
   (data             uint8 64 :offset 16))
  :size-assert 80)

(deftype mp-event-buffer (structure)
  ((out-count  uint8)
   (out-events mp-event 64 :inline)
   (in-count   uint8)
   (in-events  mp-event 64 :inline))
  :size-assert 10272)

(define-perm *mp-event-buffer* mp-event-buffer (new 'static 'mp-event-buffer))

(deftype mp-race-event-data (structure)
  ((event-time      time-frame)
   (generation      uint32)
   (value0          int32)
   (value1          int32)
   (sequence        uint32)
   (open-racer-mask uint16)
   (action          uint8)
   (race-id         int8)
   (racer-index     uint8)
   (player-id       uint8)
   (player-mask     uint8))
  :size-assert 31)

(deftype mp-race-event (mp-event)
  ((payload mp-race-event-data :inline :overlay-at (-> data 0)))
  :size-assert 80)

(deftype edge-grab-state-event-data (structure)
  ((center-hold          vector :inline :offset 0)
   (edge-dir             vector :inline :offset 16)
   (pilot-local-pos      vector :inline :offset 0)
   (pilot-local-dir      vector :inline :offset 16)
   (pilot-start-grab-pos vector :inline :offset 32)
   (pilot-actor-id       uint32 :offset 48)
   (edge-tri-pat         uint32 :offset 52)
   (pilot-grab-interp    float :offset 56)
   (pilot-actor-kind     uint8 :offset 60)
   (pilot-edge-grab-bool uint8 :offset 61))
  :size-assert 62)

(deftype mp-aid-event-data (structure)
  ((aid uint32)))

(deftype mp-aid-event (mp-event)
