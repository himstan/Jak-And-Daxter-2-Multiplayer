;;-*-Lisp-*-
(in-package goal)

(defconstant MP_PALACE_SQUID_EVT_HIT_REQUEST (the-as uint8 1))
(defconstant MP_PALACE_SQUID_EVT_GRENADE (the-as uint8 2))
(defconstant MP_PALACE_SQUID_EVT_WHIRLWIND (the-as uint8 3))
(defconstant MP_PALACE_SQUID_EVT_RESOLUTION (the-as uint8 4))
(defconstant MP_WARP_GATE_PHASE_BEGIN (the-as uint8 1))
(defconstant MP_WARP_GATE_PHASE_ARRIVE (the-as uint8 2))
(defconstant MP_WARP_GATE_FLAG_INDAX (the-as uint8 1))
(defconstant MP_BATTLE_EVT_START (the-as uint8 1))
(defconstant MP_BATTLE_EVT_END (the-as uint8 2))
(defconstant MP_BATTLE_EVT_SPAWN (the-as uint8 3))
(defconstant MP_BATTLE_EVT_CLAIM (the-as uint8 4))
(defconstant MP_BATTLE_EVT_DESPAWN (the-as uint8 5))
(defconstant MP_BATTLE_EVT_ROSTER_REQUEST (the-as uint8 6))
(defconstant MP_BATTLE_EVT_ROSTER_BEGIN (the-as uint8 7))
(defconstant MP_BATTLE_EVT_ROSTER_END (the-as uint8 8))
(defconstant MP_BATTLE_EVT_RELEASE (the-as uint8 9))
(defconstant MP_RACE_ACTION_CONFIG (the-as uint8 1))
(defconstant MP_RACE_ACTION_BIND_COMMIT (the-as uint8 2))
(defconstant MP_RACE_ACTION_START (the-as uint8 3))
(defconstant MP_RACE_ACTION_PROGRESS_REQUEST (the-as uint8 4))
(defconstant MP_RACE_ACTION_PROGRESS_COMMIT (the-as uint8 5))
(defconstant MP_RACE_ACTION_DNF (the-as uint8 6))
(defconstant MP_RACE_ACTION_RESULTS (the-as uint8 7))
(defconstant MP_RACE_ACTION_DECISION (the-as uint8 8))
(defconstant MP_RACE_ACTION_CONFIG_REQUEST (the-as uint8 9))
(defconstant MP_RACE_STATUS_ACTIVE (the-as uint8 0))
(defconstant MP_RACE_STATUS_FINISHED (the-as uint8 1))
(defconstant MP_RACE_STATUS_DNF (the-as uint8 2))
(defconstant MP_RACE_DECISION_NONE (the-as uint8 0))
(defconstant MP_RACE_DECISION_RETRY (the-as uint8 1))
(defconstant MP_RACE_DECISION_COMPLETE (the-as uint8 2))
(defconstant MP_RACE_DECISION_FAIL (the-as uint8 3))
(defconstant MP_GUNGAME_COURSE_RED (the-as uint8 1))
(defconstant MP_GUNGAME_COURSE_YELLOW (the-as uint8 2))
(defconstant MP_GUNGAME_COURSE_BLUE (the-as uint8 3))
(defconstant MP_GUNGAME_COURSE_PEACE (the-as uint8 4))
(defconstant MP_GUNGAME_SPAWN_DUMMY_A (the-as int 1))
(defconstant MP_GUNGAME_SPAWN_DUMMY_B (the-as int 2))
(defconstant MP_GUNGAME_SPAWN_DUMMY_C (the-as int 3))
(defconstant MP_GUNGAME_SPAWN_DUMMY_GOLD (the-as int 4))
(defconstant MP_GUNGAME_SPAWN_DUMMY_BIG (the-as int 5))
(defconstant MP_GUNGAME_SPAWN_DUMMY_PEACE (the-as int 6))
(defconstant MP_GUNGAME_SPAWN_CIT_A (the-as int 10))
(defconstant MP_GUNGAME_SPAWN_CIT_B (the-as int 11))
(defconstant MP_GUNGAME_SPAWN_CIT_C (the-as int 12))
(defconstant MP_GUNGAME_SPAWN_CIT_D (the-as int 13))
(defconstant MP_ACTOR_ATTACK_HAS_SOURCE_POS (the-as uint8 1))
(defconstant MP_ACTOR_ATTACK_HAS_DIRECTION (the-as uint8 2))
(defconstant MP_MOUNTAIN_RESOLUTION_LENS (the-as uint8 1))
(defconstant MP_MOUNTAIN_RESOLUTION_GEAR (the-as uint8 2))
(defconstant MP_MOUNTAIN_RESOLUTION_SHARD (the-as uint8 3))
(defconstant MP_MOUNTAIN_RESOLUTION_BURIED_ROCKS (the-as uint8 4))
