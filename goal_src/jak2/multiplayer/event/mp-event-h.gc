(define-extern mp-receive-widow-bomb-hit-event (function mp-widow-bomb-hit-event none))
(define-extern mp-receive-widow-catwalk-hit-event (function mp-widow-catwalk-hit-event none))
(define-extern mp-waypoint-apply-remote-event! (function mp-waypoint-event symbol none))
(define-extern mp-warp-gate-apply-remote-event! (function mp-warp-gate-event none))
(define-extern mp-widow-bomb-apply-kick-event! (function mp-widow-bomb-kick-event none))
(define-extern mp-widow-bomb-apply-fizzle-event! (function mp-widow-bomb-fizzle-event none))
