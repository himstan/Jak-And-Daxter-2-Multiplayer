;;-*-Lisp-*-
(in-package goal)

;; Engine integration that produces events but is not itself a payload factory.

(declare-type squid-grenade projectile)
(declare-type metalhead-shot projectile)
(declare-type parking-spot process-drawable)
(declare-type camera-start process-hidden)
(declare-type security-wall process-drawable)
(declare-type centurion nav-enemy)

(defun mp-should-block-break-sync? ((proc process))
  "BREAK events are for simple destructibles, not traffic, enemies, or actors."
  (and proc
       (nonzero? proc)
       (not (type? proc crate))
       (or (type? proc citizen)
           (type? proc vehicle)
           (type? proc enemy)
           (type? proc bot)
           (type? proc process-focusable)
           (type? proc com-airlock)
           (type? proc squid)
           (type? proc squid-grenade)
           (type? proc guard-shot)
           (type? proc battle)
           (type? proc part-spawner)
           (type? proc parking-spot)
           (type? proc scene-stage)
           (type? proc camera-start)
           (type? proc security-wall)
           (type? proc guard-lazer-shot)
           (type? proc metalhead-shot)
           (type? proc centurion)
           (type-type? (-> proc type) part-spawner)
           (type-type? (-> proc type) parking-spot)
           (type-type? (-> proc type) scene-stage)
           (type-type? (-> proc type) camera-start)
           (type-type? (-> proc type) security-wall)
           )
       )
  )

(defun mp-handle-process-entity-status! ((arg0 process)
                                         (arg1 entity-perm-status)
                                         (arg2 symbol))
  (when (and arg2
             (logtest? (the-as int arg1)
                       (the-as int (logior (entity-perm-status dead)
                                           (entity-perm-status subtask-complete))))
             (not *mp-processing-remote-event*)
             (mp-is-jak?)
             arg0
             (nonzero? arg0)
             (-> arg0 entity)
             (nonzero? (-> arg0 entity))
             (not (movie?))
             (not (mp-should-block-break-sync? arg0)))
    (debug-log *mp-debug-log?*
               "[MP-Events] Sending BREAK for process ~A aid=~D~%"
               arg0
               (-> arg0 entity aid))
    (mp-event-enqueue-aid! MP_EVENT_BREAK (-> arg0 entity aid))
    )
  (none)
  )

(defun mp-handle-engine-event! ((proc process-tree) (msg event-message-block))
  "Observe selected local engine messages without replacing engine dispatch."
  (when (and proc (nonzero? proc) msg (nonzero? msg))
    (let ((event-message (-> msg message)))
      (when (and (or (= event-message 'leave) (= event-message 'play-scene))
                 *multi-sync-enabled?*
                 (mp-is-jak?)
                 (not *mp-processing-remote-event*)
                 (valid? proc process (the-as string #f) #f 0))
        (let ((name-pointer (-> proc name)))
          (when (nonzero? name-pointer)
            (let ((raw-name (the-as basic name-pointer))
                  (process-name (the-as string #f)))
              (cond
                ((type? raw-name string)
                 (set! process-name (the-as string raw-name)))
                ((type? raw-name symbol)
                 (set! process-name
                       (symbol->string (the-as symbol raw-name))))
                )
              (when (and process-name (!= process-name ""))
                (mp-event-enqueue-actor-name!
                  (if (= event-message 'leave)
                      MP_EVENT_MISSION_LEAVE
                      MP_EVENT_MISSION_PLAY_SCENE)
                  process-name)
                )
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-pack-edge-grab-process-ref!
       ((dst mp-edge-grab-event-data) (proc process) (pilot? symbol))
  (when (and dst (nonzero? dst))
    (if pilot?
        (begin
          (set! (-> dst pilot-actor-id) (the uint 0))
          (set! (-> dst pilot-actor-kind) (the uint 0)))
        (begin
          (set! (-> dst actor-id) (the uint 0))
          (set! (-> dst actor-kind) (the uint 0))))
    (when (and proc (nonzero? proc))
      (let ((actor-id (the uint 0))
            (actor-kind (the uint 0)))
        (cond
          ((type-type? (-> proc type) vehicle)
           (set! actor-id (-> (the-as vehicle proc) net-id))
           (set! actor-kind (the uint 2)))
          ((and (not pilot?)
                (type-type? (-> proc type) citizen))
           (set! actor-id (-> (the-as citizen proc) net-id))
           (set! actor-kind (the uint 3)))
          ((type? proc process-drawable)
           (let ((ent (-> (the-as process-drawable proc) entity)))
             (when (and ent (nonzero? ent))
               (set! actor-id (-> ent aid))
               (set! actor-kind (the uint 1)))))
          )
        (if pilot?
            (begin
              (set! (-> dst pilot-actor-id) actor-id)
              (set! (-> dst pilot-actor-kind) actor-kind))
            (begin
              (set! (-> dst actor-id) actor-id)
              (set! (-> dst actor-kind) actor-kind)))
        )
      )
    )
  (none)
  )

(defun mp-pack-edge-grab-info ((dst mp-edge-grab-event-data) (src edge-grab-info))
  (when (and dst (nonzero? dst) src (nonzero? src))
    (dotimes (index 8)
      (vector-copy! (-> dst world-vertex index) (-> src world-vertex index))
      (vector-copy! (-> dst local-vertex index) (-> src local-vertex index))
      )
    (set! (-> dst status) (-> src status))
    (set! (-> dst actor-cshape-prim-offset) (-> src actor-cshape-prim-offset))
    (mp-pack-edge-grab-process-ref!
      dst
      (handle->process-safe (-> src actor-handle))
      #f)
    (mem-copy! (the-as pointer (-> dst hanging-matrix))
               (the-as pointer (-> src hanging-matrix))
               64)
    (vector-copy! (-> dst left-hand-hold) (-> src left-hand-hold))
    (vector-copy! (-> dst right-hand-hold) (-> src right-hand-hold))
    (vector-copy! (-> dst center-hold-old) (-> src center-hold-old))
    (set! (-> dst edge-tri-pat) (-> src edge-tri-pat))
    (set! (-> dst found-edge-bool) (if (-> src found-edge?) 1 0))
    (set! (-> dst pilot-edge-grab-bool)
          (cond
            ((= (-> src pilot-edge-grab?) 'target-jump) 1)
            ((= (-> src pilot-edge-grab?) 'target-double-jump) 2)
            ((= (-> src pilot-edge-grab?) #t) 3)
            (else 0)))
    (when (-> src pilot-edge-grab?)
      (vector-copy! (-> dst pilot-local-pos) (-> src pilot-edge-grab local-pos))
      (vector-copy! (-> dst pilot-local-dir) (-> src pilot-edge-grab local-dir))
      (mp-pack-edge-grab-process-ref!
        dst
        (handle->process-safe (-> src pilot-edge-grab handle))
        #t))
    (vector-copy! (-> dst pilot-start-grab-pos) (-> src pilot-start-grab-pos))
    (set! (-> dst pilot-grab-interp) (-> src pilot-grab-interp))
    )
  (none)
  )

(defun mp-event-hook-pole-grab! ((pole-handle handle))
  "Record the local swingpole AID through the shared event queue."
  (if (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) (mp-connection-status in-game)))
      (return #f))
  (when (or (not *mp-pole-grab-latched?*)
            (!= *mp-last-pole-grab-handle* pole-handle))
    (let ((pole-proc (handle->process pole-handle)))
      (when (and pole-proc
                 (nonzero? pole-proc)
                 (-> pole-proc entity)
                 (nonzero? (-> pole-proc entity)))
        (mp-event-enqueue-aid! MP_EVENT_POLE_GRAB (-> pole-proc entity aid))
        (set! *mp-last-pole-grab-handle* pole-handle)
        (set! *mp-pole-grab-latched?* #t)
        )
      )
    )
  (none)
  )

(defun mp-clear-pole-grab-event-latch ((pole-handle handle))
  (when (= *mp-last-pole-grab-handle* pole-handle)
    (set! *mp-pole-grab-latched?* #f)
    (set! *mp-last-pole-grab-handle* (the-as handle #f))
    )
  (none)
  )

(defun mp-event-hook-edge-grab! ((pilot? symbol))
  "Pack local edge-grab state and enqueue one typed event."
  (if (or (not *multi-sync-enabled?*) (!= (pc-multi-get-status) (mp-connection-status in-game)))
      (return #f))
  (debug-log *mp-debug-log?*
             "[MP-Events] Authoritative Edge Grab broadcast! (Pilot: ~A)~%"
             pilot?)
  (let ((packed (new 'stack-no-clear 'mp-edge-grab-event-data)))
    (mp-pack-edge-grab-info packed *edge-grab-info*)
    (mp-event-enqueue-edge-grab!
      (if pilot? MP_EVENT_PILOT_EDGE_GRAB MP_EVENT_EDGE_GRAB)
      packed)
    )
  (none)
  )

(defun mp-event-hook-scene! ((state mp-scene-state) (name string))
  (when (and *multi-sync-enabled?*
             (= (pc-multi-get-status) (mp-connection-status in-game))
             (not (mp-tomb-scene-transport-suppressed? name)))
    (let ((event-type
            (cond
              ((= (the-as uint state) (the-as uint (mp-scene-state started)))
               MP_EVENT_SCENE_START)
              ((= (the-as uint state) (the-as uint (mp-scene-state request-skip)))
               MP_EVENT_SCENE_REQUEST_SKIP)
              ((= (the-as uint state) (the-as uint (mp-scene-state skipped)))
               MP_EVENT_SCENE_SKIPPED)
              (else (the uint 0)))))
      (when (not (= event-type (the uint 0)))
        (let ((load-continue (the-as string #f)))
          (when (and (= event-type MP_EVENT_SCENE_START)
                     name
                     (nonzero? name))
            (let ((scene-obj (scene-lookup name)))
              (when (and scene-obj
                         (nonzero? scene-obj)
                         (-> scene-obj load-point-obj)
                         (nonzero? (-> scene-obj load-point-obj)))
                (set! load-continue
                      (the-as string (-> scene-obj load-point-obj)))
                )
              )
            )
          (mp-event-enqueue-scene! event-type name load-continue)
          )
        (when (= event-type MP_EVENT_SCENE_START)
          (mp-note-connected-scene-broadcast! name))
        )
      )
    )
  (none)
  )
