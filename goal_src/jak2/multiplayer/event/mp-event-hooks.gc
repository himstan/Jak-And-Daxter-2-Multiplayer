;;-*-Lisp-*-
(in-package goal)

(define-extern mp-scene-coordinator-note-start-broadcast! (function string none))
(declare-type squid-grenade projectile)
(declare-type metalhead-shot projectile)
(declare-type parking-spot process-drawable)
(declare-type camera-start process-hidden)
(declare-type security-wall process-drawable)
(declare-type centurion nav-enemy)
(declare-type drill-metalhead-eggs process-drawable)
(declare-type mtn-plat-buried-rocks process-drawable)
(declare-type hoverboard-training-manager process)

(defun mp-should-block-break-sync? ((proc process))
  (and proc
       (nonzero? proc)
       (not (type? proc crate))
       (or (type? proc citizen)
           (type? proc vehicle)
           (type? proc enemy)
           (type? proc bot)
           (type? proc process-focusable)
           (type? proc com-airlock)
           (type? proc squid)
           (type? proc squid-grenade)
           (type? proc guard-shot)
           (type? proc battle)
           (type? proc part-spawner)
           (type? proc parking-spot)
           (type? proc scene-stage)
           (type? proc camera-start)
           (type? proc security-wall)
           (type? proc guard-lazer-shot)
           (type? proc metalhead-shot)
           (type? proc centurion)
           (type? proc drill-metalhead-eggs)
           (type? proc mtn-plat-buried-rocks)
           (type? proc hoverboard-training-manager)
           (type-type? (-> proc type) part-spawner)
           (type-type? (-> proc type) parking-spot)
           (type-type? (-> proc type) scene-stage)
           (type-type? (-> proc type) camera-start)
           (type-type? (-> proc type) security-wall))))

(defun mp-handle-process-entity-status! ((arg0 process) (arg1 entity-perm-status) (arg2 symbol))
  (when (and arg2
             (logtest? (the-as int arg1)
                       (the-as int (logior (entity-perm-status dead) (entity-perm-status subtask-complete))))
             (not *mp-processing-remote-event*)
             (mp-session-host?)
             arg0
             (nonzero? arg0)
             (-> arg0 entity)
             (nonzero? (-> arg0 entity))
             (not (movie?))
             (not (mp-should-block-break-sync? arg0)))
    (log 'debug "[MP-Events] Sending BREAK for process ~A aid=~D~%" arg0 (-> arg0 entity aid))
    (mp-event-enqueue-aid! MP_EVENT_BREAK (-> arg0 entity aid)))
  (none))

(defun mp-handle-engine-event! ((proc process-tree) (msg event-message-block))
  (when (and proc (nonzero? proc) msg (nonzero? msg))
    (let ((event-message (-> msg message)))
      (when (and (or (= event-message 'leave) (= event-message 'play-scene))
                 (mp-session-host?)
                 (not *mp-processing-remote-event*)
                 (valid? proc process (the-as string #f) #f 0))
        (let ((name-pointer (-> proc name)))
          (when (nonzero? name-pointer)
            (let ((raw-name (the-as basic name-pointer))
                  (process-name (the-as string #f)))
              (cond
                ((type? raw-name string) (set! process-name (the-as string raw-name)))
                ((type? raw-name symbol) (set! process-name (symbol->string (the-as symbol raw-name)))))
              (when (and process-name (!= process-name ""))
                (mp-event-enqueue-actor-name! (if (= event-message 'leave) MP_EVENT_MISSION_LEAVE MP_EVENT_MISSION_PLAY_SCENE)
                                              process-name))))))))
  (none))

(defun mp-pack-edge-grab-process-ref! ((dst edge-grab-state-event-data) (proc process))
  (when (nonnull? dst)
    (set! (-> dst pilot-actor-id) (the uint 0))
    (set! (-> dst pilot-actor-kind) (the uint 0))
    (when (nonnull? proc)
      (cond
        ((type-type? (-> proc type) vehicle)
         (set! (-> dst pilot-actor-id) (-> (the-as vehicle proc) net-id))
         (set! (-> dst pilot-actor-kind) (the uint 2)))
        ((type? proc process-drawable)
         (let ((ent (-> (the-as process-drawable proc) entity)))
           (when (and ent (nonzero? ent))
             (set! (-> dst pilot-actor-id) (-> ent aid))
             (set! (-> dst pilot-actor-kind) (the uint 1))))))))
  (none))

(defun mp-pack-edge-grab-info ((dst edge-grab-state-event-data) (src edge-grab-info))
  (when (and (nonnull? dst src))
    (cond
      ((-> src pilot-edge-grab?)
       (set! (-> dst pilot-edge-grab-bool)
             (cond
               ((= (-> src pilot-edge-grab?) 'target-jump) 1)
               ((= (-> src pilot-edge-grab?) 'target-double-jump) 2)
               (else 3)))
       (vector-copy! (-> dst pilot-local-pos) (-> src pilot-edge-grab local-pos))
       (vector-copy! (-> dst pilot-local-dir) (-> src pilot-edge-grab local-dir))
       (mp-pack-edge-grab-process-ref! dst (handle->process-safe (-> src pilot-edge-grab handle)))
       (vector-copy! (-> dst pilot-start-grab-pos) (-> src pilot-start-grab-pos))
       (set! (-> dst pilot-grab-interp) (-> src pilot-grab-interp)))
      (else
       (set! (-> dst pilot-edge-grab-bool) 0)
       (vector-copy! (-> dst center-hold) (-> src center-hold))
       (let ((edge-vec (vector-! (new 'stack-no-clear 'vector) (-> src world-vertex 0) (-> src world-vertex 1))))
         (vector-normalize! edge-vec 1.0)
         (vector-copy! (-> dst edge-dir) edge-vec))
       (set! (-> dst edge-tri-pat) (-> src edge-tri-pat)))))
  (none))

(defun mp-event-hook-pole-grab! ((pole-handle handle))
  (if (not (mp-session-in-game?)) (return #f))
  (when (or (not *mp-pole-grab-latched?*) (!= *mp-last-pole-grab-handle* pole-handle))
    (let ((pole-proc (handle->process pole-handle)))
      (when (and pole-proc (nonzero? pole-proc) (-> pole-proc entity) (nonzero? (-> pole-proc entity)))
        (mp-event-enqueue-aid! MP_EVENT_POLE_GRAB (-> pole-proc entity aid))
        (set! *mp-last-pole-grab-handle* pole-handle)
        (set! *mp-pole-grab-latched?* #t))))
  (none))

(defun mp-clear-pole-grab-event-latch ((pole-handle handle))
  (when (= *mp-last-pole-grab-handle* pole-handle)
    (set! *mp-pole-grab-latched?* #f)
    (set! *mp-last-pole-grab-handle* (the-as handle #f)))
  (none))

(defun mp-event-hook-edge-grab! ((source target) (pilot? symbol))
  (if (not (mp-session-in-game?)) (return #f))
  (when (and source (nonzero? source))
    (log 'debug "[MP-Events] Authoritative Edge Grab broadcast! (Pilot: ~A)~%" pilot?)
    (let ((packed (new 'stack-no-clear 'edge-grab-state-event-data)))
      (mem-set32! (the-as pointer packed) (/ (+ (size-of edge-grab-state-event-data) 3) 4) 0)
      (mp-pack-edge-grab-info packed (-> source edge-grab-state info))
      (mp-event-enqueue-edge-grab! (if pilot? MP_EVENT_PILOT_EDGE_GRAB MP_EVENT_EDGE_GRAB) packed)))
  (none))

(defun mp-event-hook-scene! ((state mp-scene-state) (name string))
  (when (and (mp-session-in-game?) (not (mp-tomb-scene-transport-suppressed? name)))
    (let ((event-type (cond
                        ((= (the-as uint state) (the-as uint (mp-scene-state started))) MP_EVENT_SCENE_START)
                        ((= (the-as uint state) (the-as uint (mp-scene-state request-skip))) MP_EVENT_SCENE_REQUEST_SKIP)
                        ((= (the-as uint state) (the-as uint (mp-scene-state skipped))) MP_EVENT_SCENE_SKIPPED)
                        (else (the uint 0)))))
      (when (not (= event-type (the uint 0)))
        (let ((load-continue (the-as string #f)))
          (when (and (= event-type MP_EVENT_SCENE_START) name (nonzero? name))
            (let ((scene-obj (scene-lookup name)))
              (when (and scene-obj
                         (nonzero? scene-obj)
                         (-> scene-obj load-point-obj)
                         (nonzero? (-> scene-obj load-point-obj)))
                (set! load-continue (the-as string (-> scene-obj load-point-obj))))))
          (mp-event-enqueue-scene! event-type name load-continue))
        (when (and (= event-type MP_EVENT_SCENE_START) (not (mp-mountain-resolution-scene? name)))
          (mp-scene-coordinator-note-start-broadcast! name)))))
  (none))
