;;-*-Lisp-*-
(in-package goal)

(define-extern mp-tomb-scene-transport-suppressed? (function string symbol))

(defun mp-clear-connected-scene-broadcast! ()
  (when (and *mp-connected-scene-broadcast-name*
             (nonzero? *mp-connected-scene-broadcast-name*))
    (set! (-> *mp-connected-scene-broadcast-name* data 0) (the uint 0))
    (set! (-> *mp-connected-scene-broadcast-name* data -4) (the-as uint 0))
    )
  (none)
  )

(defun mp-reset-scene-sync-state! ()
  (set! *multi-remote-spawn-time* (the-as time-frame 0))
  (set! *mp-last-scene-player* #f)
  (set! *mp-was-riding-before-scene* #f)
  (mp-clear-connected-scene-broadcast!)
  (dotimes (player-id MP_MAX_PLAYERS)
    (let ((record (mp-player-record-by-id (the-as uint player-id))))
      (when (and record (nonzero? record))
        (set! (-> record action scene-latched?) (the uint8 0))
        (set! (-> record action last-replayed-sequence) (the uint 0)))))
  (set! *mp-pending-scene-sync?* #f)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (set! *mp-scene-sync-target-hold?* #f)
  (set! *mp-scene-sync-target-hold-until* (the-as time-frame 0))
  (set! *mp-aborted-scene-catchup-logged?* #f)
  (mp-clear-active-local-scene-name!)
  (when (and *mp-pending-scene-sync-name*
             (nonzero? (the-as uint *mp-pending-scene-sync-name*)))
    (set! (-> *mp-pending-scene-sync-name* data 0) (the uint 0))
    )
  (when (and *mp-pending-scene-sync-continue-name*
             (nonzero? (the-as uint *mp-pending-scene-sync-continue-name*)))
    (set! (-> *mp-pending-scene-sync-continue-name* data 0) (the uint 0))
    )
  (set! *mp-intro-skip-bootstrap-pending?* #f)
  (set! *mp-intro-skip-blackout-pending?* #f)
  (when (and *mp-last-scene-name*
             (nonzero? (the-as uint *mp-last-scene-name*)))

    (set! (-> *mp-last-scene-name* data 0) (the uint 0))
    )
  (when (and *mp-last-local-continue-name*
             (nonzero? (the-as uint *mp-last-local-continue-name*)))
    (set! (-> *mp-last-local-continue-name* data 0) (the uint 0))
    )
  (none))

;; --- Event Handlers ---
(defun mp-event-remote-player-respawned ((source-record mp-player-record))
  (when (and source-record (nonzero? source-record))
    (mp-player-runtime-clear-flag! source-record MP_PLAYER_RUNTIME_DYING)
    (mp-player-runtime-clear-flag! source-record MP_PLAYER_RUNTIME_DEAD))
  (none))

(defun mp-event-remote-player-died ((source-record mp-player-record))
  (when (and source-record (nonzero? source-record))
    (mp-player-runtime-clear-flag! source-record MP_PLAYER_RUNTIME_DYING)
    (mp-player-runtime-set-flag! source-record MP_PLAYER_RUNTIME_DEAD))
  (none))

(defun mp-event-handler-enemy-death ((evt mp-enemy-death-event))
  (when (and evt
             (nonzero? (the-as uint evt))
             (>= (-> evt payload-size) (the uint 4)))
    (let ((aid (the-as uint (-> evt aid))))
      (when (nonzero? aid)
        (if (mp-mark-aid-dead-perm! aid)
            (debug-log *mp-debug-log?* "[MP-Event-Handlers] Recorded enemy death tombstone aid=~D.~%" aid)
            (debug-log *mp-debug-log?* "[MP-Event-Handlers] Could not record enemy death tombstone aid=~D.~%" aid))
        )
      )
    )
  (none)
  )

(defun mp-event-handler-orb ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (let ((perm (-> ent extra perm)))
        (when (not (logtest? (-> perm status) (entity-perm-status dead)))
          (mp-mark-aid-dead-perm! aid)
          (logior! (-> perm status) (entity-perm-status dead))
          (if (and *target* (nonzero? *target*))
              (send-event *target* 'get-pickup (pickup-type skill) 1.0))
          (let ((proc (-> ent extra process)))
            (if (and proc (nonzero? proc))
                (send-event proc 'pickup)))))))
  (none))

(defun mp-event-handler-gem ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (let ((perm (-> ent extra perm)))
        (when (not (logtest? (-> perm status) (entity-perm-status dead)))
          (mp-mark-aid-dead-perm! aid)
          (logior! (-> perm status) (entity-perm-status dead))
          (if (and *target* (nonzero? *target*))

              (send-event *target* 'get-pickup (pickup-type gem) 1.0))
          (let ((proc (-> ent extra process)))
            (if (and proc (nonzero? proc))
                (send-event proc 'pickup)))))))
  (none))

(define *mp-search-enemy-gem-source-id* (the-as uint 0))
(define *mp-search-enemy-gem-index* (the-as uint 0))
(define *mp-search-enemy-gem-res* (the-as gem #f))

(defun mp-enemy-gem-available? ((gem-proc gem))
  (and gem-proc
       (nonzero? gem-proc)
       (!= (-> gem-proc status) 'dead)
       (not (and (-> gem-proc next-state) (= (-> gem-proc next-state name) 'pickup)))
       )
  )

(defun mp-find-enemy-gem-callback ((p process-tree))
  (let ((proc (the-as process p)))
    (when (and proc (type? proc gem))
      (let ((gem-proc (the-as gem proc)))
        (when (and (mp-enemy-gem-available? gem-proc)
                   (= (-> gem-proc enemy-gem-source-id) (the-as uint32 *mp-search-enemy-gem-source-id*))
                   (= (-> gem-proc enemy-gem-index) (the-as uint32 *mp-search-enemy-gem-index*)))
          (set! *mp-search-enemy-gem-res* gem-proc)
          (return #f)
          )
        )
      )
    )
  #t)

(defun mp-find-enemy-gem ((source-id uint) (gem-index uint))
  (set! *mp-search-enemy-gem-source-id* source-id)
  (set! *mp-search-enemy-gem-index* gem-index)
  (set! *mp-search-enemy-gem-res* (the-as gem #f))
  (iterate-process-tree *entity-pool* mp-find-enemy-gem-callback *kernel-context*)
  (if (not *mp-search-enemy-gem-res*)
      (iterate-process-tree *active-pool* mp-find-enemy-gem-callback *kernel-context*)

      )
  *mp-search-enemy-gem-res*)

(defun mp-event-handler-enemy-gem ((evt mp-enemy-gem-event))
  (let ((gem-proc (mp-find-enemy-gem (-> evt source-id) (-> evt gem-index))))
    (when (mp-enemy-gem-available? gem-proc)
      (if (and *target* (nonzero? *target*))
          (send-event *target* 'get-pickup (pickup-type gem) 1.0))
      (send-event gem-proc 'die)
      )
    )
  (none))

(defun mp-event-handler-break ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received MP_EVENT_BREAK for aid=~D Entity: ~A~%" aid ent)
      (let ((perm (-> ent extra perm)))
        (when (not (logtest? (-> perm status) (entity-perm-status dead subtask-complete)))
          (let ((proc (-> ent extra process)))
            (if (and proc (nonzero? proc))
               (begin
                 ;; CRITICAL SAFETY: Never 'break' an NPC or anything that shouldn't just die from a crate-break
                 ;; This prevents accidental mission failure if a client triggers an entity status change.
                 (if (mp-should-block-break-sync? proc)
                      (debug-log *mp-debug-log?* "[MP-Event-Handlers] Ignoring BREAK for important process ~A aid=~D~%" proc aid)
                      (begin
                        (mp-mark-aid-dead-perm! aid)
                        (logior! (-> perm status) (entity-perm-status dead subtask-complete))
                        (send-event proc 'attack #f (static-attack-info ((id (new-attack-id))
                                                                         (mode 'mp-break)
                                                                         (penetrate-using (penetrate generic-attack lunge flop punch spin roll uppercut bonk explode))))))
                      )
                  )
                )
            )
          )
        )
      )
    )

  (none))

(defun mp-event-handler-attack-enemy ((evt mp-actor-attack-event))
  (let ((net-id (-> evt net-id)))
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received MP_EVENT_ATTACK_ENEMY for nid=~D attack-id=~D~%" net-id (-> evt attack-id))
    (let ((proc (find-enemy-by-aid net-id)))
      (if (and proc (nonzero? proc))
          (let ((attacker (mp-player-target-by-id (-> evt source-player-id)))
                (e-proc (the-as enemy proc))
                (rec (mp-get-enemy-auth net-id)))
            (when (and attacker (nonzero? attacker))
              (debug-log *mp-debug-log?* "[MP-Event-Handlers] Applying Authoritative hit to ~A from remote attacker ~A nid=~D~%" proc attacker net-id)
              (mp-actor-apply-authoritative-remote-damage! e-proc attacker evt 'enemy)
              (if (and attacker
                       (nonzero? attacker)
                       (-> e-proc focus)
                       (nonzero? (-> e-proc focus)))
                  (set! (-> e-proc focus handle) (process->handle attacker))
                  ))
            )
          (begin
            (when (and (>= net-id #x60000000) (< net-id #x70000000))
              (mp-battle-request-rosters!)
              )
            (debug-log *mp-debug-log?* "[MP-Event-Handlers] ERROR: Could not find enemy process for nid=~D; requested battle roster.~%" net-id)))
      )
    )
  (none))

(defun mp-event-handler-attack-ped ((evt mp-actor-attack-event))
  "Host receives hit request from Client for a pedestrian."
  (let ((net-id (-> evt net-id)))
    (let ((proc (mp-pedestrian-find-by-net-id net-id)))
      (if (and proc (nonzero? proc))
        (begin
          (debug-log *mp-debug-log?* "[MP-Event-Handlers] Applying authoritative pedestrian hit from client context nid=~D attack-id=~D~%" net-id (-> evt attack-id))
          (mp-pedestrian-apply-remote-attack! evt)
        )
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] ERROR: Could not find pedestrian for hit! nid=~D~%" net-id)
      )
    )
  )
  (none)
)

(defun mp-handle-remote-scene-hacks ((scene-name string))
  (case (string->symbol scene-name)

    (('city-get-yellow-gun)
      (when (and *target* (not (logtest? (-> *game-info* features) (game-feature gun-yellow))))
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received Gun Yellow sync! Giving to player.~%")
         (pickup-collectable! (-> *target* fact) (pickup-type gun-yellow) 1.0 (the-as handle #f))
         (task-close! "sewer-enemy-resolution")
    ))
    (('city-keira-hover-challenge-intro)
      (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received Keira Delivery Scene. Forcing task close.~%")
      (task-close! "city-keira-delivery-delivery")
    )
  )
)

(defun mp-intro-samos-hut-scene? ((scene-name string))
  (and scene-name
       (nonzero? scene-name)
       (string= scene-name "intro-samos-hut"))
  )

(defun mp-intro-chain-scene? ((scene-name string))
  (and scene-name
       (nonzero? scene-name)
       (or (string= scene-name "intro-samos-hut")
           (string= scene-name "intro-vortex")
           (string= scene-name "intro-city-square")
           (string= scene-name "intro-prison")))
  )

(defun mp-ignore-intro-start-after-skip? ((scene-name string))
  "Ignore teardown-generated intro starts while the client awaits prison bootstrap."
  (and (mp-session-client?)
       *mp-intro-skip-blackout-pending?*
       (mp-intro-chain-scene? scene-name))
  )

(defun mp-arm-intro-skip-bootstrap! ((scene-name string))
  "Handle the first intro skip race with host bootstrap and client blackout."
  (when (mp-intro-samos-hut-scene? scene-name)
    (cond
      ((mp-session-host?)

       (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote skipped intro-samos-hut. Host bootstrap pending.~%")
       (set! *mp-intro-skip-bootstrap-pending?* #t)
       )
      ((mp-session-client?)
       (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote skipped intro-samos-hut. Client blackout pending.~%")
       (set! *mp-intro-skip-blackout-pending?* #t)
       )
      )
    )
  (none)
  )

(defun mp-intro-skip-host-ready-for-bootstrap? ()
  "True once the host has landed at the prison continue after the skipped intro."
  (and (mp-session-host?)
       (= (pc-multi-get-status) (mp-connection-status in-game))
       (not *scene-player*)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       (not (and (-> *target* state) (= (-> *target* state name) 'target-load-wait)))
       (not (and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait)))
       *level*
       (nonzero? *level*)
       (= (-> *level* loading-level) (-> *level* default-level))
       *game-info*
       (nonzero? *game-info*)
       (-> *game-info* current-continue)
       (nonzero? (-> *game-info* current-continue))
       (= (-> *game-info* current-continue level) 'prison))
  )

(defun mp-request-intro-skip-bootstrap-when-ready! ()
  "Consume the pending first-intro skip sync once the host is safely in prison."
  (when (and *mp-intro-skip-bootstrap-pending?*
             (mp-intro-skip-host-ready-for-bootstrap?))
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Host stable in prison. Requesting bootstrap for client.~%")
    (set! *mp-intro-skip-bootstrap-pending?* #f)

    (pc-multi-request-bootstrap)
    )
  (none)
  )

(defun mp-hold-intro-skip-blackout! ()
  "Keep the client hidden between intro scene teardown and the host's authoritative bootstrap."
  (when (and *mp-intro-skip-blackout-pending?*
             (mp-session-client?)
             (= (pc-multi-get-status) (mp-connection-status in-game))
             (not *scene-player*))
    (set-blackout-frames (seconds 0.05))
    )
  (none)
  )

(defun mp-copy-scene-sync-name! ((dst string) (src string))
  (when (and dst (nonzero? dst))
    (dotimes (idx 64)
      (set! (-> dst data idx) (the uint 0))
      )
    (when (and src (nonzero? src))
      (let ((len (min 63 (length src))))
        (dotimes (idx len)
          (set! (-> dst data idx) (-> src data idx))
          )
        (set! (-> dst data len) (the uint 0))
        (set! (-> dst data -4) (the-as uint len))
        )
      )
    )
  (none)
  )

(defun mp-copy-scene-sync-event-continue! ((dst string) (evt mp-scene-event))
  (when (and dst (nonzero? dst) evt (nonzero? evt))
    (let ((len 0))
      (dotimes (idx 64)
        (let ((val (-> evt load-continue idx)))
          (set! (-> dst data idx) val)

          (if (nonzero? val)
              (set! len (+ idx 1)))
          )
        )
      (set! (-> dst data 63) (the uint 0))
      (set! (-> dst data -4) (the-as uint (min len 63)))
      )
    )
  (none)
  )

(defun mp-log-pending-scene-sync-wait! ((reason string))
  (when (>= (current-time) *mp-pending-scene-sync-next-log-time*)
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Waiting to start remote scene ~S (continue: ~S): ~A.~%"
            *mp-pending-scene-sync-name*
            *mp-pending-scene-sync-continue-name*
            reason)
    (set! *mp-pending-scene-sync-next-log-time* (+ (current-time) (seconds 1)))
    )
  (none)
  )

(defun mp-arm-pending-scene-sync! ((scene-name string) (evt mp-scene-event))
  (mp-copy-scene-sync-name! *mp-pending-scene-sync-name* scene-name)
  (mp-copy-scene-sync-event-continue! *mp-pending-scene-sync-continue-name* evt)
  (set! *mp-pending-scene-sync?* #t)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (debug-log *mp-debug-log?* "[MP-Event-Handlers] Armed remote scene sync for ~S (continue: ~S).~%"
          *mp-pending-scene-sync-name*
          *mp-pending-scene-sync-continue-name*)
  (none)
  )

(defun mp-scene-sync-continue-wants-aligned? ((cont continue-point))
  "True when the local load-state already wants the scene continue levels."
  (when (and cont
             (nonzero? cont)
             *load-state*
             (nonzero? *load-state*))
    (let ((vis-info (lookup-level-info (-> cont vis-nick))))

      (when (and vis-info
                 (nonzero? vis-info)
                 (!= (-> *load-state* vis-nick) (-> vis-info name)))
        (return #f)
        )
      )
    (dotimes (idx 6)
      (when (or (!= (-> *load-state* want idx name) (-> cont want idx name))
                (!= (-> *load-state* want idx display?) (-> cont want idx display?)))
        (return #f)
        )
      )
    (return #t)
    )
  #f
  )

(defun mp-scene-sync-request-continue-levels! ((continue-name string))
  "Apply the vanilla continue want-list so the DGO containing the scene can load."
  (when (and continue-name
             (nonzero? (length continue-name))
             *load-state*
             (nonzero? *load-state*))
    (let ((cont (scene-decode-continue continue-name)))
      (when (and cont
                 (nonzero? cont)
                 (not (mp-scene-sync-continue-wants-aligned? cont)))
        (let ((vis-info (lookup-level-info (-> cont vis-nick))))
          (set! (-> *load-state* vis-nick) (if vis-info (-> vis-info name)))
          )
        (dotimes (idx 6)
          (set! (-> *load-state* want idx name) (-> cont want idx name))
          (set! (-> *load-state* want idx display?) (-> cont want idx display?))
          (set! (-> *load-state* want idx force-vis?) #f)
          (set! (-> *load-state* want idx force-inside?) #f)
          )
        (dotimes (idx 3)
          (set! (-> *load-state* want-sound idx) (-> cont want-sound idx))
          )
        (add-borrow-levels *load-state*)

        )
      )
    )
  (none)
  )

(defun mp-scene-sync-level-paging-idle? ()
  (and *level*
       (nonzero? *level*)
       (-> *level* loading-level)
       (nonzero? (-> *level* loading-level))
       (-> *level* default-level)
       (nonzero? (-> *level* default-level))
       (= (-> *level* loading-level) (-> *level* default-level))
       )
  )

(defun mp-scene-sync-wanted-level-ready? ((level-name symbol) (display-mode symbol))
  "Scene teleports need terrain/display fully activated, not merely loaded."
  (if (and level-name
           display-mode
           *level*
           (nonzero? *level*))
      (let ((lev (level-get *level* level-name)))
        (and lev
             (nonzero? lev)
             (= (-> lev status) 'active)
             (= (-> lev display?) display-mode)
             (-> lev bsp)
             (nonzero? (-> lev bsp))
             )
        )
      #t
      )
  )

(defun mp-scene-sync-continue-levels-ready? ((continue-name string))
  (if (and continue-name (nonzero? (length continue-name)))
      (let ((cont (scene-decode-continue continue-name)))
        (if (and cont (nonzero? cont))

            (begin
              (dotimes (idx 6)
                (let ((level-name (-> cont want idx name))
                      (display-mode (-> cont want idx display?)))
                  (when (and level-name
                             display-mode
                             (not (mp-scene-sync-wanted-level-ready? level-name display-mode)))
                    (return #f)
                    )
                  )
                )
              (mp-scene-sync-level-paging-idle?)
              )
            #t
            )
        )
      #t
      )
  )

(defun mp-scene-sync-levels-ready-or-request! ()
  (if (and *mp-pending-scene-sync-continue-name*
           (nonzero? (length *mp-pending-scene-sync-continue-name*)))
      (if (mp-scene-sync-continue-levels-ready? *mp-pending-scene-sync-continue-name*)
          #t
          (begin
            (mp-scene-sync-request-continue-levels! *mp-pending-scene-sync-continue-name*)
            (mp-scene-sync-continue-levels-ready? *mp-pending-scene-sync-continue-name*)
            )
        )
      (mp-remote-teleport-ready-or-request!)
      )
  )

(defun mp-pending-scene-sync-scene-ready? ()
  (and *mp-pending-scene-sync-name*
       (nonzero? (length *mp-pending-scene-sync-name*))
       (let ((scene-obj (scene-lookup *mp-pending-scene-sync-name*)))
         (and scene-obj (nonzero? scene-obj))
         )

       )
  )

(defun mp-scene-sync-scene-player-playing? ()
  (if (and *scene-player* (nonzero? *scene-player*))
      (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
        (and scene-proc
             (nonzero? scene-proc)
             (-> scene-proc state)
             (nonzero? (-> scene-proc state))
             (= (-> scene-proc state name) 'play-anim)
             )
        )
      #f
      )
  )

(defun mp-scene-sync-scene-player-has-target? ()
  (and *scene-player*
       (nonzero? *scene-player*)
       *target*
       (nonzero? *target*)
       (focus-test? *target* grabbed)
       )
  )

(defun mp-scene-sync-pin-target-at-hold-pos! ()
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *mp-scene-sync-target-hold-pos*
             (nonzero? *mp-scene-sync-target-hold-pos*))
    (let ((control (-> *target* control)))
      (vector-copy! (-> control trans) *mp-scene-sync-target-hold-pos*)
      (set! (-> control transv quad) (the-as uint128 0))
      (vector-copy! (-> control camera-pos) (-> control trans))
      (set-blackout-frames (seconds 0.1))
      )
    )

  (none)
  )

(defun mp-scene-sync-start-target-hold! ()
  "Keep the target from falling while scene-player finishes its wait/preload handoff."
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *mp-scene-sync-target-hold-pos*
             (nonzero? *mp-scene-sync-target-hold-pos*))
    (vector-copy! *mp-scene-sync-target-hold-pos* (-> *target* control trans))
    (set! *mp-scene-sync-target-hold?* #t)
    (set! *mp-scene-sync-target-hold-until* (+ (current-time) (seconds 15)))
    (mp-scene-sync-pin-target-at-hold-pos!)
    )
  (none)
  )

(defun mp-process-scene-sync-target-hold! ()
  (when *mp-scene-sync-target-hold?*
    (cond
      ((mp-scene-sync-scene-player-has-target?)
       (set! *mp-scene-sync-target-hold?* #f)
       )
      ((mp-scene-sync-scene-player-playing?)
       (set! *mp-scene-sync-target-hold?* #f)
       )
      ((>= (current-time) *mp-scene-sync-target-hold-until*)
       (debug-log *mp-debug-log?* "[MP-Event-Handlers] Releasing scene target hold after timeout.~%")
       (set! *mp-scene-sync-target-hold?* #f)
       )
      (else
       (mp-scene-sync-pin-target-at-hold-pos!)
       )
      )
    )
  (none)
  )

(defun mp-scene-sync-use-entity-trigger? ((scene-name string))
  (and scene-name
       (nonzero? (length scene-name))
       (or 
         (string= scene-name "mtn-plat-buried-rocks-a")
         (string= scene-name "mtn-plat-buried-rocks-2")))
  )

(defun mp-scene-sync-force-npc-step! ((scene-obj scene) (scene-name string))
  (when (and scene-obj (nonzero? scene-obj))
    (let ((entity-name (-> scene-obj entity)))
      (when (and entity-name (nonzero? entity-name))
        (let ((npc (process-by-ename entity-name)))
          (if (and npc (nonzero? npc))
              (let ((npc-proc (the-as process-drawable npc)))
                (if (mp-scene-sync-use-entity-trigger? scene-name)
                    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Found scene object ~S. Snapping and sending trigger.~%" entity-name)
                    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Found NPC ~S. Snapping and signaling force-step.~%" entity-name)
                    )
                (when (and npc-proc
                           (nonzero? npc-proc)
                           (-> npc-proc root)
                           (nonzero? (-> npc-proc root))
                           *target*
                           (nonzero? *target*)
                           (-> *target* control)
                           (nonzero? (-> *target* control)))
                  (vector-copy! (-> npc-proc root trans) (-> *target* control trans))
                  )
                (if (mp-scene-sync-use-entity-trigger? scene-name)
                    (let ((old-remote-context *mp-processing-remote-event*))
                      (set! *mp-processing-remote-event* #t)
                      (send-event npc 'trigger)
                      (set! *mp-processing-remote-event* old-remote-context)
                      )
                    (send-event npc 'mp-force-scene-step scene-name)
                    )
                )
              (debug-log *mp-debug-log?* "[MP-Event-Handlers] NPC ~S not birthed yet. It should link via its own logic when it does.~%" entity-name)
              )

          )
        )
      )
    )
  (none)
  )

(defun blocked-scene? ((scene-name string))
  (if (or 
      (string= scene-name "mtn-plat-buried-rocks-a")
      (string= scene-name "mtn-plat-buried-rocks-2")
    )
    #t
    #f)
  )

(defun mp-finish-pending-scene-sync! ()
  (let ((scene-name *mp-pending-scene-sync-name*))
    (when (and scene-name (nonzero? (length scene-name)))
      (mp-handle-remote-scene-hacks scene-name)
      (mp-scene-sync-teleport-to-remote!)
      ;; For now we just block these from force starting, messes up the camera in the mountain level, TODO to look into that sometime
      (when (not (mp-scene-sync-use-entity-trigger? scene-name))
        (mp-scene-sync-start-target-hold!)
              (let ((scene-obj (scene-lookup scene-name)))
                (when (and (not (mp-scene-sync-use-entity-trigger? scene-name))
                           (not *scene-player*)
                           scene-obj
                           (nonzero? scene-obj))
                  (let ((load-pt (if (and *mp-pending-scene-sync-continue-name*
                                          (nonzero? (length *mp-pending-scene-sync-continue-name*)))
                                     *mp-pending-scene-sync-continue-name*
                                     (the-as string (-> scene-obj load-point-obj))
                                     )))
                    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Spawning authoritative scene-player for ~S (continue: ~S)~%"
                            scene-name
                            load-pt)
                    (let ((old-remote-context *mp-processing-remote-event*))
                      (set! *mp-processing-remote-event* #t)
                      (process-spawn scene-player :init scene-player-init scene-name #t load-pt)

                      (set! *mp-processing-remote-event* old-remote-context)
                      )
                    )
                  )
                (mp-scene-sync-force-npc-step! scene-obj scene-name)
                ))
      )
    )
  (set! *mp-pending-scene-sync?* #f)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (none)
  )

(defun mp-local-scene-name-matches? ((scene-name string))
  (when (and scene-name
             (nonzero? scene-name)
             (nonzero? (length scene-name))
             *scene-player*
             (nonzero? *scene-player*))
    (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
      (when (and scene-proc
                 (nonzero? scene-proc)
                 (-> scene-proc scene)
                 (nonzero? (-> scene-proc scene))
                 (-> scene-proc scene name)
                 (nonzero? (-> scene-proc scene name)))
        (return (string= scene-name (-> scene-proc scene name)))
        )
      )
    )
  #f
  )

(defun mp-process-pending-scene-sync! ()
  (when *mp-pending-scene-sync?*
    (cond
      ((mp-local-scene-name-matches? *mp-pending-scene-sync-name*)
       (debug-log *mp-debug-log?* "[MP-Event-Handlers] Pending remote scene ~S is already active locally; consuming it.~%"
               *mp-pending-scene-sync-name*)
       (set! *mp-pending-scene-sync?* #f)

       (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
       )
      ((and *scene-player* (nonzero? *scene-player*))
       (mp-log-pending-scene-sync-wait! "another local scene is active")
       )
      ((not (mp-scene-sync-levels-ready-or-request!))
       (mp-log-pending-scene-sync-wait! "scene continue levels are not loaded")
       )
      ((not (mp-pending-scene-sync-scene-ready?))
       (mp-log-pending-scene-sync-wait! "scene definition is not loaded")
       )
      ((not (mp-all-connected-remote-players-scene-ready?))
       (mp-log-pending-scene-sync-wait! "waiting for all connected players")
       )
      ((not (mp-local-scene-teleport-ready?))
       (mp-log-pending-scene-sync-wait! "local target is not ready")
       )
      (else
       (mp-finish-pending-scene-sync!)
       )
      )
    )
  (none)
  )

(defun mp-pending-scene-name-matches? ((scene-name string))
  (and scene-name
       (nonzero? scene-name)
       *mp-pending-scene-sync?*
       *mp-pending-scene-sync-name*
       (nonzero? *mp-pending-scene-sync-name*)
       (string= scene-name *mp-pending-scene-sync-name*))
  )

(defun mp-duplicate-scene-start? ((scene-name string))
  (or (mp-local-scene-name-matches? scene-name)
      (mp-pending-scene-name-matches? scene-name))
  )

(defun mp-event-handler-scene-start ((ev mp-scene-event))
  (let ((s* *mp-scene-name-scratch*))
    (when (and s* (nonzero? s*) (nonzero? (length s*)))
      (cond

        ((mp-tomb-scene-transport-suppressed? s*)
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Ignoring locally-owned tomb scene: ~S~%" s*)
         )
        ((mp-tomb-boulder-ignore-remote-scene? s*)
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Ignoring role-incompatible tomb scene: ~S~%" s*)
         )
        ((mp-ignore-intro-start-after-skip? s*)
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Ignoring post-skip intro scene start: ~S.~%" s*)
         )
        ((mp-duplicate-scene-start? s*)
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Suppressing duplicate remote scene start: ~S~%" s*)
         )
        (else
         (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote started scene: ~S. Waiting for level-ready NPC-sync.~%" s*)
         (let ((source-record (mp-player-record-by-id (-> ev source-player-id))))
           (when (and source-record (nonzero? source-record))
             (set! (-> source-record action scene-latched?) (the uint8 1))
             (set! (-> source-record action last-replayed-sequence)
                   (-> source-record connection latest-state-sequence))))
         (mp-arm-pending-scene-sync! s* ev)
         )
        )
      )
    )
  (none))

(defun mp-event-handler-scene-request-skip ((aid uint))
  (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote player requested to skip scene.~%")
  (set! *mp-remote-wants-skip* #t)
  (mp-arm-intro-skip-bootstrap! *mp-scene-name-scratch*)
  (none))

(defun mp-event-handler-scene-skipped ((ev mp-scene-event))
  (let ((source-record (mp-player-record-by-id (-> ev source-player-id))))
    (when (and source-record (nonzero? source-record))
      (set! (-> source-record action scene-latched?) (the uint8 0))))
  (when *scene-player*
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] All players skipped. Aborting locally.~%")
    (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
      (when (and scene-proc (nonzero? scene-proc))
        (mp-tomb-boulder-before-scene-abort! scene-proc)

        (send-event scene-proc 'abort)
        )
      )
    ;; Force blackout off immediately to prevent getting stuck
    (mp-clear-client-presentation-blackout!)
    )
  (mp-arm-intro-skip-bootstrap! *mp-scene-name-scratch*)
  (none))

(defun mp-event-handler-authority-request ((aid uint) (source-player-id uint))
  "Remote side wants authority over an enemy."
  (let ((rec (mp-get-enemy-auth aid))
        (proc (find-enemy-by-aid aid))
        (remote-player-id (the-as uint8 source-player-id)))
    (when rec
      (debug-log *mp-debug-log?* "[MP-Event-Handlers] Player ~D requested authority over aid=~D.~%" remote-player-id aid)
      (when (or (mp-aid-dead-perm? aid)
                (and proc
                     (nonzero? proc)
                     (mp-enemy-terminal-sync? (the-as enemy proc) aid)))
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Blocking authority request for terminal enemy aid=~D nid=~D~%"
                aid
                (if (and proc (nonzero? proc)) (-> (the-as enemy proc) net-id) (the uint 0)))
        (return #f)
        )
      (when (and proc
                 (nonzero? proc)
                 (mp-enemy-host-only? (the-as enemy proc)))
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Blocking authority request for host-only enemy aid=~D~%" aid)
        (return #f)
        )
      ;; Decision Logic:
      ;; If we are Host (0), we evaluate.
      ;; If we are Client (1), we always yield to Host.
      (let ((should-yield? #f))
        (if (mp-session-host?)
            ;; Host logic: Yield if we aren't currently aggroed.
            (if (not (-> rec is-aggro))
                (set! should-yield? #t))

            ;; Client logic: Always yield to Host.
            (set! should-yield? #t))
        
        (when should-yield?
          (debug-log *mp-debug-log?* "[MP-Event-Handlers] Yielding authority of aid=~D to remote.~%" aid)
          (set! (-> rec owner-player-id) remote-player-id)
          (set! (-> rec last-transfer-time) (current-time)) ;; Prevent re-acquisition during handover
          (set! (-> rec last-remote-seen) (current-time))
          (when (and proc (nonzero? proc))
            (let ((e-proc (the-as enemy proc)))
              (let ((current-state (-> e-proc state)))
                (when (and current-state (nonzero? current-state))
                  (set! (-> e-proc trans-hook) #f)
                  (logior! (-> e-proc mask) (process-mask sleep-code))
                  )
                )
              )
            )
          (mp-event-enqueue-aid! MP_EVENT_ENEMY_AUTHORITY_ACK aid)
          )
        )
      )
    )
  (none))

(defun mp-event-handler-authority-ack ((aid uint))
  "Remote side granted us authority over an enemy."
  (let ((rec (mp-get-enemy-auth aid))
        (proc (find-enemy-by-aid aid))
        (local-player-id (the-as uint8 (-> (mp-local-player-record) identity player-id))))
    (when rec
      (when (or (mp-aid-dead-perm? aid)
                (and proc
                     (nonzero? proc)
                     (mp-enemy-terminal-sync? (the-as enemy proc) aid)))
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Ignoring authority ack for terminal enemy aid=~D nid=~D~%"
                aid
                (if (and proc (nonzero? proc)) (-> (the-as enemy proc) net-id) (the uint 0)))
        (set! (-> rec just-taken-authority) #f)
        (return #f)
        )
      (when (and proc
                 (nonzero? proc)
                 (mp-enemy-host-only? (the-as enemy proc)))

        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Blocking authority ack for host-only enemy aid=~D~%" aid)
        (set! (-> rec just-taken-authority) #f)
        (return #f)
        )
      (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote granted authority over aid=~D. Taking ownership.~%" aid)
      (set! (-> rec owner-player-id) local-player-id)
      (set! (-> rec last-transfer-time) (current-time))
      (set! (-> rec just-taken-authority) #t)
      )
    )
  (none))

(defun mp-event-handler-change-mode-darkjak ((aid uint) (source-player-id uint))
  "Apply a remote Jak transform to the source player's bound target."
  (let ((source-record (mp-player-record-by-id source-player-id)))
    (when (and source-record (nonzero? source-record) (mp-player-jak? source-record))
      (let ((puppet (mp-player-record-target source-record)))
        (when (and puppet (nonzero? puppet))
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote player activated Dark Jak! Triggering engine change-mode...~%")
        (send-event puppet 'change-mode 'darkjak #f (darkjak-stage active))
        (mp-darkjak-emit-puppet-transform-feedback! puppet *target*)
        ))))
  (none))

(defun mp-event-handler-end-mode-darkjak ((aid uint) (source-player-id uint))
  "Apply a remote Jak reversion to the source player's bound target."
  (let ((source-record (mp-player-record-by-id source-player-id)))
    (when (and source-record (nonzero? source-record) (mp-player-jak? source-record))
      (let ((puppet (mp-player-record-target source-record)))
        (when (and puppet (nonzero? puppet))
        (debug-log *mp-debug-log?* "[MP-Event-Handlers] Remote player deactivated Dark Jak! Triggering engine change-mode...~%")
        (send-event puppet 'change-mode 'normal #t)
        ))))
  (none))

(defun mp-event-handler-mtn-plat-shoot ((evt mp-mtn-plat-shoot-event))
  (let ((aid (-> evt aid)))
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received MP_EVENT_MTN_PLAT_SHOOT for aid=~D.~%" aid)
    (let ((ent (entity-by-aid aid)))
      (when (and ent (nonzero? ent))
        (let ((proc (-> ent extra process)))
          (when (and proc (nonzero? proc))
            (set! *mp-processing-remote-event* #t)
            (send-event proc 'mp-flip (-> evt axe-flip))
            (set! *mp-processing-remote-event* #f)
            )
          )
        )
      )

    )
  (none)
  )

(defun mp-event-handler-mtn-dice ((evt mp-mtn-dice-event))
  (let ((aid (-> evt aid)))
    (debug-log *mp-debug-log?* "[MP-Event-Handlers] Received MP_EVENT_MTN_DICE for aid=~D.~%" aid)
    (let ((ent (entity-by-aid aid)))
      (when (and ent (nonzero? ent))
        (let ((proc (-> ent extra process)))
          (when (and proc (nonzero? proc))
            (set! *mp-processing-remote-event* #t)
            (send-event proc 'mp-attack (-> evt rot-axis) (-> evt rot-org) (the-as int (-> evt prim-id)))
            (set! *mp-processing-remote-event* #f)
            )
          )
        )
      )
    )
  (none)
  )

(defun mp-close-local-fail-mission! ()
  "Dismiss the local fail-mission process without running its retry/fail reset branch."
  (let ((fail-proc (get-proc *fail-mission-control*)))
    (when fail-proc
      (debug-log *mp-debug-log?* "[MP-Events] Closing local mission-failed prompt.~%")
      (when (= *master-mode* 'freeze)
        (set-master-mode 'game)
        )
      (when *target*
        (process-release? *target*)
        )
      (deactivate fail-proc)
      (set! (-> *fail-mission-control* process) (the-as handle #f))
      )
    )
  (none)
  )

(defun mp-receive-mission-failed-choice ((m-evt uint))
  "Apply the host's mission-failed prompt choice on the client."
  (when (mp-session-client?)
    (case m-evt
      ((MP_EVENT_MISSION_FAILED_RETRY_YES)
       (debug-log *mp-debug-log?* "[MP-Events] Host selected retry. Closing prompt and awaiting bootstrap.~%")
       (mp-close-local-fail-mission!)
       )
      ((MP_EVENT_MISSION_FAILED_RETRY_NO)
       (debug-log *mp-debug-log?* "[MP-Events] Host selected no retry. Closing prompt.~%")
       (mp-close-local-fail-mission!)
       )
      )
    )
  (none)
  )

(defun mp-receive-battle-event ((evt mp-battle-event))
  (set! *mp-processing-remote-event* #t)
  (let ((battle-evt (-> evt battle-evt))
        (name-str *mp-actor-name-event-name-scratch*))
    (dotimes (i 32)

      (set! (-> name-str data i) (-> evt battle-name i))
      )
    (let ((len 0))
      (while (and (< len 31) (nonzero? (-> name-str data len)))
        (1+! len))
      (set! (-> name-str data -4) (the-as uint len)))

    (debug-log *mp-debug-log?*
      "[MP-BattleEvent][~A][RECV] evt=~D battle=~S spawner=~D breed=~D initial=~D "
      (if (mp-session-host?) "HOST" "CLIENT")
      battle-evt
      name-str
      (-> evt spawner-index)
      (-> evt breed-index)
      (-> evt initial?)
      )
    (debug-log *mp-debug-log?*
      "aid=~D~%"
      (-> evt enemy-aid)
      )
    (debug-log *mp-debug-log?*
      "[MP-BattleEvent][~A][RECV] owner=~D epoch=~D local=~D aid=~D~%"
      (if (mp-session-host?) "HOST" "CLIENT")
      (-> evt owner-player-id)
      (-> evt epoch)
      (if (and (mp-local-player-record) (nonzero? (mp-local-player-record))) (-> (mp-local-player-record) identity player-id) -1)
      (-> evt enemy-aid)
      )

    (mp-battle-receive-event! evt name-str)
    )
  (set! *mp-processing-remote-event* #f)
  (none)
  )

(defun mp-receive-player-gun-shot-event ((evt mp-player-gun-shot-event))
  "Reapply a remote gun shot using the authoritative shot event."
  (set! *mp-processing-remote-event* #t)
  (mp-puppet-receive-gun-shot! (-> evt source-player-id) evt)
  (set! *mp-processing-remote-event* #f)

  (none)
  )

(defun mp-store-gungame-broken-mask! ((chunk uint) (mask uint))
  (case chunk
    ((0)
     (set! *mp-gungame-broken-mask-0* mask)
     )
    ((1)
     (set! *mp-gungame-broken-mask-1* mask)
     )
    ((2)
     (set! *mp-gungame-broken-mask-2* mask)
     )
    ((3)
     (set! *mp-gungame-broken-mask-3* mask)
     )
    )
  (none)
  )

(defun mp-store-gungame-spawned-mask! ((chunk uint) (mask uint))
  (case chunk
    ((0)
     (set! *mp-gungame-spawned-mask-0* mask)
     )
    ((1)
     (set! *mp-gungame-spawned-mask-1* mask)
     )
    ((2)
     (set! *mp-gungame-spawned-mask-2* mask)
     )
    ((3)
     (set! *mp-gungame-spawned-mask-3* mask)
     )
    )
  (none)
  )

(defun mp-store-gungame-event ((evt mp-gungame-event))

  "Store the latest host gungame state for the loaded level script to apply."
  (when (mp-session-client?)
    (set! *mp-gungame-pending?* #t)
    (set! *mp-gungame-event-kind* (-> evt etype))
    (set! *mp-gungame-course-id* (-> evt course-id))
    (set! *mp-gungame-elapsed-time* (-> evt elapsed-time))
    (set! *mp-gungame-open-end?* (-> evt open-end?))
    (set! *mp-gungame-end-door* (-> evt end-door))
    (case (-> evt etype)
      ((MP_EVENT_MISSION_GUNGAME_TUTORIAL_STEP)
       (case (-> evt course-id)
         ((MP_GUNGAME_COURSE_RED)
          (when (> (-> evt step) *mp-gungame-red-intro-step*)
            (set! *mp-gungame-red-intro-step* (-> evt step))
            )
          )
         ((MP_GUNGAME_COURSE_YELLOW)
          (when (> (-> evt step) *mp-gungame-yellow-intro-step*)
            (set! *mp-gungame-yellow-intro-step* (-> evt step))
            )
          )
         )
       )
      ((MP_EVENT_MISSION_GUNGAME_COURSE_SNAPSHOT)
       (case (-> evt course-id)
         ((MP_GUNGAME_COURSE_RED)
          (set! *mp-gungame-red-intro-step* (max *mp-gungame-red-intro-step* (the uint 4)))
          )
         ((MP_GUNGAME_COURSE_YELLOW)
          (set! *mp-gungame-yellow-intro-step* (max *mp-gungame-yellow-intro-step* (the uint 4)))
          )
         )
       (set! *mp-gungame-score* (-> evt score))
       (set! *mp-gungame-broken-mask* (-> evt broken-mask))
       (if (< (-> evt step) (the uint 16))
           (mp-store-gungame-broken-mask! (-> evt step) (-> evt broken-mask))
           (mp-store-gungame-spawned-mask! (- (-> evt step) (the uint 16)) (-> evt broken-mask))
           )
       )
      ((MP_EVENT_MISSION_GUNGAME_TARGET_BROKEN)

       (set! *mp-gungame-target-num* (-> evt target-num))
       )
      ((MP_EVENT_MISSION_GUNGAME_TARGET_SPAWNED)
       (set! *mp-gungame-target-num* (-> evt target-num))
       (set! *mp-gungame-spawn-kind* (-> evt score))
       )
      ((MP_EVENT_MISSION_GUNGAME_COURSE_END)
       (case (-> evt course-id)
         ((MP_GUNGAME_COURSE_RED)
          (set! *mp-gungame-red-intro-step* (max *mp-gungame-red-intro-step* (the uint 4)))
          )
         ((MP_GUNGAME_COURSE_YELLOW)
          (set! *mp-gungame-yellow-intro-step* (max *mp-gungame-yellow-intro-step* (the uint 4)))
          )
         )
       (set! *mp-gungame-score* (-> evt score))
       (set! *mp-gungame-broken-mask* (-> evt broken-mask))
       (set! *mp-gungame-course-ended?* #t)
       (if (< (-> evt step) (the uint 16))
           (mp-store-gungame-broken-mask! (-> evt step) (-> evt broken-mask))
           (mp-store-gungame-spawned-mask! (- (-> evt step) (the uint 16)) (-> evt broken-mask))
           )
       )
      )
    )
  (none)
  )

(defun mp-store-city-shuttle-event ((evt mp-shuttle-event))
  "Store the latest remote shuttle state for the shuttle task to consume when loaded."
  (when (> (-> evt sequence) *mp-shuttle-last-received-sequence*)
    (set! *mp-shuttle-pending?* #t)
    (set! *mp-shuttle-task-node* (-> evt task-node))
    (set! *mp-shuttle-sub-state* (-> evt sub-state))
    (set! *mp-shuttle-started?* (-> evt started?))
    (set! *mp-shuttle-time-limit* (-> evt time-limit))
    (set! *mp-shuttle-remaining-time* (-> evt remaining-time))
    (set! *mp-shuttle-counter* (-> evt counter))
    (set! *mp-shuttle-sequence* (-> evt sequence))
    (set! *mp-shuttle-last-received-sequence* (-> evt sequence))

    )
  (none)
  )

(defun mp-log-mission-failed-bootstrap-wait ((reason string))
  "Throttle host retry bootstrap readiness diagnostics."
  (when (time-elapsed? *mp-mission-failed-bootstrap-next-log-time* (seconds 2))
    (debug-log *mp-debug-log?* "[MP-Events] Waiting to request bootstrap: ~A.~%" reason)
    (set-time! *mp-mission-failed-bootstrap-next-log-time*)
    )
  (none)
  )

(defun mp-arm-mission-failed-bootstrap-after-spawn ()
  "Arm the retry bootstrap only after the host's retry reload has spawned Jak again."
  (when (and *mp-mission-failed-bootstrap-await-spawn?*
             (mp-session-host?)
             (= (pc-multi-get-status) (mp-connection-status in-game)))
    (debug-log *mp-debug-log?* "[MP-Events] Post-reload spawn observed. Bootstrap pending.~%")
    (set! *mp-mission-failed-bootstrap-await-spawn?* #f)
    (set! *mp-mission-failed-bootstrap-pending?* #t)
    (set-time! *mp-mission-failed-bootstrap-ready-time*)
    (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0))
    )
  (none)
  )

(defun mp-request-mission-failed-bootstrap-when-ready ()
  "After a host retry reload, request the bootstrap packet once the world is stable."
  (when *mp-mission-failed-bootstrap-pending?*
    (cond
      ((not (mp-session-host?))
       (set! *mp-mission-failed-bootstrap-pending?* #f)
       (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0))
       )
      ((and (= (pc-multi-get-status) (mp-connection-status in-game))
            (time-elapsed? *mp-mission-failed-bootstrap-ready-time* (seconds 1))
            *target*
            (-> *target* control)
            (not (focus-test? *target* teleporting))

            (not (and (-> *target* state) (= (-> *target* state name) 'target-load-wait)))
            (not (and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait)))
            *level*
            (nonzero? (the-as uint *level*))
            (= (-> *level* loading-level) (-> *level* default-level))
            (-> *game-info* current-continue))
       (debug-log *mp-debug-log?* "[MP-Events] Host retry reload stable. Requesting bootstrap.~%")
       (pc-multi-request-bootstrap)
       (set! *mp-mission-failed-bootstrap-pending?* #f)
       (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0))
       )
      (else
        (cond
          ((not (= (pc-multi-get-status) (mp-connection-status in-game)))
           (mp-log-mission-failed-bootstrap-wait "network status is not IN_GAME")
           )
          ((not (time-elapsed? *mp-mission-failed-bootstrap-ready-time* (seconds 1)))
           (mp-log-mission-failed-bootstrap-wait "post-spawn delay has not elapsed")
           )
          ((not *target*)
           (mp-log-mission-failed-bootstrap-wait "target is missing")
           )
          ((not (-> *target* control))
           (mp-log-mission-failed-bootstrap-wait "target control is missing")
           )
          ((focus-test? *target* teleporting)
           (mp-log-mission-failed-bootstrap-wait "target is teleporting")
           )
          ((and (-> *target* state) (= (-> *target* state name) 'target-load-wait))
           (mp-log-mission-failed-bootstrap-wait "target state is load-wait")
           )
          ((and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait))
           (mp-log-mission-failed-bootstrap-wait "target next-state is load-wait")
           )
          ((or (not *level*) (zero? (the-as uint *level*)))
           (mp-log-mission-failed-bootstrap-wait "level is missing")
           )
          ((!= (-> *level* loading-level) (-> *level* default-level))
           (mp-log-mission-failed-bootstrap-wait "level is loading")
           )

          ((not (-> *game-info* current-continue))
           (mp-log-mission-failed-bootstrap-wait "current continue is missing")
           )
          )
       )
      )
    )
  (none)
  )

(defun mp-receive-fortress-robotank-trigger-event ((evt mp-robotank-trigger-event) (proc-name string))
  "Snap the local player to the remote activator and replay the robotank trigger once."
  (debug-log *mp-debug-log?* "[MP-MissionEvent] Replaying fortress robotank trigger ~D for ~S~%"
          (the-as int (-> evt trigger-id))
          proc-name)
  (when (and *target* (nonzero? *target*))
    (let ((target-control (-> *target* control)))
      (when (and target-control (nonzero? target-control))
        (vector-copy! (-> target-control trans) (-> evt source-pos))
        )
      )
    )
  (let ((proc (process-by-name proc-name *active-pool*)))
    (when proc
      (send-event proc 'trigger (the-as int (-> evt trigger-id)))
      )
    )
  (none)
  )

(defun mp-actor-name-event-has-target-name? ((m-evt uint))
  (case m-evt
    ((MP_EVENT_MISSION_LEAVE) #t)
    ((MP_EVENT_MISSION_PLAY_SCENE) #t)
    ((MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER) #t)
    (else #f)
    )
  )

(defun mp-copy-mission-event-target-name! ((evt mp-actor-name-event) (name-str string))

  (dotimes (i 32)
    (set! (-> name-str data i) (-> evt target-name i)))
  (let ((len 0))
    (while (and (< len 31) (nonzero? (-> name-str data len)))
      (1+! len))
    (set! (-> name-str data -4) (the-as uint len)))
  (none)
  )

(defun mp-event-dispatch-actor-message! ((event mp-actor-name-event) (message symbol))
  (let ((name-string *mp-actor-name-event-name-scratch*))
    (mp-copy-mission-event-target-name! event name-string)
    (let ((proc (process-by-name name-string *active-pool*)))
      (when (and proc (nonzero? proc))
        (debug-log *mp-debug-log?* "[MP-Event] Dispatching ~S to ~S.~%" message name-string)
        (send-event proc message)
        )
      )
    )
  (none)
  )

(defun mp-event-handle-stadium-board1! ((evt mp-stadium-board1-event))
  "Apply stadium board events from the central event dispatcher."
  (debug-log *mp-debug-log?*
             "[MP-StadiumBoard1] Received event ~D. Score: ~D~%"
             (-> evt etype)
             (-> evt score))
  (case (-> evt etype)
    ((MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE)
     (set! *mp-stadium-board1-remote-tutorial-done?* #t))
    ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START)
     (set! *mp-stadium-board1-pending-remote-start?* #t)
     (mp-stadium-board1-try-remote-start-judge!))
    ((MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE)
     (set! *mp-stadium-board1-remote-score* (-> evt score)))
    ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END)
     (set! *mp-stadium-board1-remote-score* (-> evt score))
     (mp-stadium-board1-post-challenge-finished! #f))
    ((MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP)
     (let ((manager (process-by-type-exact 'hoverboard-training-manager *active-pool*)))
       (when (and manager (nonzero? manager))
         (send-event manager 'notify 'pickup))))
    )
  (none)
  )

(defun mp-event-handle-mission! ((evt mp-event))
  "Dispatch flattened mission events by their top-level event ID."
  (let ((event-type (-> evt etype)))
    (debug-log *mp-debug-log?* "[MP-Event] Received mission event ~D.~%" event-type)
    (case event-type
      ((MP_EVENT_MISSION_LEAVE)
       (mp-event-dispatch-actor-message! (the-as mp-actor-name-event evt) 'leave))
      ((MP_EVENT_MISSION_PLAY_SCENE)
       (mp-event-dispatch-actor-message! (the-as mp-actor-name-event evt) 'play-scene))
      ((MP_EVENT_MISSION_FAILED_RETRY_YES)
       (mp-receive-mission-failed-choice event-type))
      ((MP_EVENT_MISSION_FAILED_RETRY_NO)
       (mp-receive-mission-failed-choice event-type))
      ((MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER)
       (mp-copy-mission-event-target-name! (the-as mp-actor-name-event evt) *mp-actor-name-event-name-scratch*)
       (mp-receive-fortress-robotank-trigger-event (the-as mp-robotank-trigger-event evt) *mp-actor-name-event-name-scratch*))
      ((MP_EVENT_MISSION_GUNGAME_TUTORIAL_STEP)
       (mp-store-gungame-event (the-as mp-gungame-event evt)))
      ((MP_EVENT_MISSION_GUNGAME_COURSE_SNAPSHOT)
       (mp-store-gungame-event (the-as mp-gungame-event evt)))
      ((MP_EVENT_MISSION_GUNGAME_TARGET_BROKEN)
       (mp-store-gungame-event (the-as mp-gungame-event evt)))
      ((MP_EVENT_MISSION_GUNGAME_TARGET_SPAWNED)
       (mp-store-gungame-event (the-as mp-gungame-event evt)))
      ((MP_EVENT_MISSION_GUNGAME_COURSE_END)
       (mp-store-gungame-event (the-as mp-gungame-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_KREW_COLLECTION_PICKUP)
       (let ((bag-index (-> (the-as mp-krew-collection-event evt) bag-index)))
         (when (and (< bag-index (the uint32 32))
                    (not (logtest? *mp-krew-collection-consumed-mask* (the-as uint (ash 1 bag-index)))))
           (set! *mp-krew-collection-picked-mask*
                 (logior *mp-krew-collection-picked-mask* (the-as uint (ash 1 bag-index)))))))
      ((MP_EVENT_MISSION_CITY_SHUTTLE_STATE)
       (mp-store-city-shuttle-event (the-as mp-shuttle-event evt)))
      ((MP_EVENT_MISSION_CITY_POWER_TURRET_STATE)
       (let ((power-evt (the-as mp-city-power-event evt)))
         (when (and (< (-> power-evt turret-id) (the uint32 5))
                    (or (= (-> power-evt state) (the uint32 1))
                        (= (-> power-evt state) (the uint32 2))))
           (set! *mp-city-power-turret-id* (the-as uint (-> power-evt turret-id)))
           (set! *mp-city-power-state* (the-as uint (-> power-evt state)))
           (vector-copy! *mp-city-power-source-pos* (-> power-evt source-pos))
           (case (-> power-evt turret-id)
             ((0) (set! *mp-city-power-state-0* (the-as uint (-> power-evt state))) (logior! *mp-city-power-pending-mask* (the uint 1)))
             ((1) (set! *mp-city-power-state-1* (the-as uint (-> power-evt state))) (logior! *mp-city-power-pending-mask* (the uint 2)))
             ((2) (set! *mp-city-power-state-2* (the-as uint (-> power-evt state))) (logior! *mp-city-power-pending-mask* (the uint 4)))
             ((3) (set! *mp-city-power-state-3* (the-as uint (-> power-evt state))) (logior! *mp-city-power-pending-mask* (the uint 8)))
             ((4) (set! *mp-city-power-state-4* (the-as uint (-> power-evt state))) (logior! *mp-city-power-pending-mask* (the uint 16))))
           (set! *mp-city-power-pending?* #t))))
      ((MP_EVENT_MISSION_TOMB_BOULDER_COMPLETE)
       (mp-tomb-boulder-receive-completion!))
      ((MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START)
       (mp-tomb-daxter-wait-receive-start! (-> evt source-player-id)))
      ((MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END)
       (mp-tomb-daxter-wait-receive-end!))
      (else
       (debug-log *mp-debug-log?* "[MP-Event] Unknown mission event ~D.~%" event-type)))
    )
  (none)
  )

(defun mp-resolve-edge-grab-handle ((actor-id uint) (actor-kind uint))
  (case actor-kind
    ((1)
     (let ((ent (entity-by-aid actor-id)))
       (when (and ent
                  (nonzero? ent)
                  (-> ent extra)
                  (nonzero? (-> ent extra))
                  (-> ent extra process)
                  (nonzero? (-> ent extra process)))
         (return (process->handle (-> ent extra process))))))
    ((2)
     (let ((veh (mp-vehicle-find-by-net-id actor-id)))
       (when (and veh (nonzero? veh))
         (return (process->handle veh)))))
    ((3)
     (let ((ped (mp-pedestrian-find-by-net-id actor-id)))
       (when (and ped (nonzero? ped))
         (return (process->handle ped)))))
    )
  (the-as handle #f)
  )

(defun mp-unpack-edge-grab-info ((dst edge-grab-info) (src edge-grab-state-event-data))
  (when (and dst (nonzero? dst) src (nonzero? src))
    (dotimes (index 8)
      (vector-copy! (-> dst world-vertex index) (-> src world-vertex index))
      (vector-copy! (-> dst local-vertex index) (-> src local-vertex index))
      )
    (set! (-> dst status) (-> src status))
    (set! (-> dst actor-cshape-prim-offset) 0)
    (set! (-> dst actor-handle) (the-as handle #f))
    (mem-copy! (the-as pointer (-> dst hanging-matrix))
               (the-as pointer (-> src hanging-matrix))
               64)
    (vector-copy! (-> dst left-hand-hold) (-> src left-hand-hold))
    (vector-copy! (-> dst right-hand-hold) (-> src right-hand-hold))
    (vector-copy! (-> dst center-hold-old) (-> src center-hold-old))
    (set! (-> dst edge-tri-pat) (-> src edge-tri-pat))
    (set! (-> dst found-edge?) (> (-> src found-edge-bool) 0))
    (set! (-> dst pilot-edge-grab?)
          (case (-> src pilot-edge-grab-bool)
            ((1) 'target-jump)
            ((2) 'target-double-jump)
            ((3) #t)
            (else #f)))
    (vector-copy! (-> dst pilot-edge-grab local-pos) (-> src pilot-local-pos))
    (vector-copy! (-> dst pilot-edge-grab local-dir) (-> src pilot-local-dir))
    (set! (-> dst pilot-edge-grab handle)
          (if (-> dst pilot-edge-grab?)
              (mp-resolve-edge-grab-handle
                (-> src pilot-actor-id)
                (-> src pilot-actor-kind))
              (the-as handle #f)))
    (vector-copy! (-> dst pilot-start-grab-pos) (-> src pilot-start-grab-pos))
    (set! (-> dst pilot-grab-interp) (-> src pilot-grab-interp))
    )
  (none)
  )

(defun mp-pilot-edge-grab-ready? ((info edge-grab-info))
  (when (and info
             (nonzero? info)
             (-> info pilot-edge-grab?))
    (let ((pilot-proc
            (handle->process-safe (-> info pilot-edge-grab handle))))
      (when (and pilot-proc
                 (nonzero? pilot-proc)
                 (type? pilot-proc process-drawable))
        (return #t))))
  #f
  )

(defun mp-standard-edge-grab-ready? ((info edge-grab-info)
                                     (src edge-grab-state-event-data))
  (and info
       (nonzero? info)
       src
       (nonzero? src))
  )

(defun mp-edge-grab-ready? ((info edge-grab-info)
                            (src edge-grab-state-event-data)
                            (pilot? symbol))
  (if pilot?
      (mp-pilot-edge-grab-ready? info)
      (mp-standard-edge-grab-ready? info src))
  )

(defun mp-clear-target-edge-grab-pending! ((target target))
  (when (and target (nonzero? target))
    (let ((edge-state (-> target edge-grab-state)))
      (mem-set32!
        (the-as pointer (-> edge-state pending-data))
        (/ (size-of edge-grab-state-event-data) 4)
        0)
      (set! (-> edge-state pending?) #f)
      (set! (-> edge-state pending-pilot?) #f)
      (set! (-> edge-state pending-time) 0)))
  (none)
  )

(defun mp-store-pending-edge-grab! ((target target)
                                    (src edge-grab-state-event-data)
                                    (pilot? symbol))
  (when (and target
             (nonzero? target)
             src
             (nonzero? src))
    (let ((edge-state (-> target edge-grab-state)))
      (mem-copy! (the-as pointer (-> edge-state pending-data))
                 (the-as pointer src)
                 MP_EDGE_GRAB_EVENT_PAYLOAD_SIZE)
      (set! (-> edge-state pending?) #t)
      (set! (-> edge-state pending-pilot?) pilot?)
      (set! (-> edge-state pending-time) (current-time))))
  (none)
  )

(defun mp-dispatch-edge-grab-to-target! ((target target) (pilot? symbol))
  (when (and target (nonzero? target))
    (let ((control (-> target control)))
      (when (and control (nonzero? control))
        (set! (-> control last-successful-compute-edge-time) (current-time)))
      (send-event target (if pilot?
                            'mp-pilot-edge-grab-synced
                            'mp-edge-grab-synced))))
  (none)
  )

(defun mp-process-pending-edge-grab! ((target target))
  (when (and target (nonzero? target))
    (let ((edge-state (-> target edge-grab-state)))
      (when (-> edge-state pending?)
        (if (time-elapsed? (-> edge-state pending-time) (seconds 1.0))
            (begin
              (debug-log *mp-debug-log?*
                         "[MP-Events] Discarding unresolved edge grab after timeout. (Pilot: ~A)~%"
                         (-> edge-state pending-pilot?))
              (mp-clear-target-edge-grab-pending! target))
            (let ((edge-info (-> edge-state info))
                  (src (-> edge-state pending-data))
                  (pilot? (-> edge-state pending-pilot?)))
              (mp-unpack-edge-grab-info edge-info src)
              (when (mp-edge-grab-ready? edge-info src pilot?)
                (mp-clear-target-edge-grab-pending! target)
                (mp-dispatch-edge-grab-to-target! target pilot?)))))))
  (none)
  )

(defun mp-receive-edge-grab-event ((target target)
                                   (evt mp-event)
                                   (pilot? symbol))
  "Apply authoritative edge-grab data to one target and trigger immediate snapping."
  (when (and target
             (nonzero? target)
             evt
             (nonzero? evt))
    (debug-log *mp-debug-log?*
               "[MP-Events] Authoritative Edge Grab received! (Pilot: ~A)~%"
               pilot?)
    (let ((edge-state (-> target edge-grab-state))
          (src (the-as edge-grab-state-event-data (-> evt data))))
      (let ((edge-info (-> edge-state info)))
        (mp-unpack-edge-grab-info edge-info src)
        (if (mp-edge-grab-ready? edge-info src pilot?)
            (begin
              (mp-clear-target-edge-grab-pending! target)
              (mp-dispatch-edge-grab-to-target! target pilot?))
            (begin
              (debug-log *mp-debug-log?*
                         "[MP-Events] Edge grab queued until actor resolves. (Pilot: ~A)~%"
                         pilot?)
              (mp-store-pending-edge-grab! target src pilot?))))))
  (none)
  )

(defun mp-receive-pole-grab-event ((evt mp-aid-event))
  "Receiver: attach the puppet to the matching local swingpole process."
  (let ((puppet (mp-player-target-by-id (-> evt source-player-id)))
        (ent (entity-by-aid (-> evt aid))))
    (when (and puppet ent (nonzero? ent))
      (let ((pole-proc (-> ent extra process)))
        (when (and pole-proc (nonzero? pole-proc))
          (let ((pole-handle (process->handle pole-proc)))
            (when (not (and (focus-test? puppet pole)
                            (= (-> puppet control anim-handle) pole-handle)))
              (send-event pole-proc 'mp-pole-grab (process->handle puppet))
              (send-event puppet 'mp-pole-grab-synced pole-handle)
              )
            )
          )

        )
      )
    )
  (none)
  )

(defun mp-receive-continue-event ((evt mp-continue-event))
  "Apply a remote continue point change."
  (let ((s* *mp-scene-name-scratch*)) ;; Reuse the scratch string safely
    (dotimes (i 32) (set! (-> s* data i) (-> evt continue-name i)))
    (set! (-> s* data 31) (the uint 0))
    ;; Calculate length and update string metadata
    (let ((len 0))
      (while (and (< len 32) (nonzero? (-> s* data len)))
        (+! len 1))
      (set! (-> s* data -4) (the-as uint len))
      )
    (if (mp-tomb-boulder-ignore-remote-continue? s*)
        (debug-log *mp-debug-log?* "[MP-TombBoulder] Ignoring role-incompatible continue: ~S~%" s*)
        (begin
          (debug-log *mp-debug-log?* "[MP-WorldEvent] Remote hit continue point: ~S~%" s*)
          ;; Update local tracker so we don't bounce it back
          (let ((len (min 31 (length s*))))
            (dotimes (i len) (set! (-> *mp-last-local-continue-name* data i) (-> s* data i)))
            (set! (-> *mp-last-local-continue-name* data len) (the uint 0))
            (set! (-> *mp-last-local-continue-name* data -4) (the-as uint len))
            )
          (set-continue! *game-info* s* #t)
          )
        )
    )
  (none)
  )

(defun mp-event-handle-scene! ((evt mp-scene-event))
  "Apply scene events using the top-level event ID as the scene state."
  (let ((event-type (-> evt etype)) (len 0))
    (dotimes (i 64)
      (let ((val (-> evt scene-name i)))
        (set! (-> *mp-scene-name-scratch* data i) val)
        (when (nonzero? val) (set! len (+ i 1)))))
    (set! (-> *mp-scene-name-scratch* data 63) (the uint 0))
    (set! (-> *mp-scene-name-scratch* data -4) (the-as uint (min len 63)))
    (debug-log *mp-debug-log?* "[MP-Event] Scene event=~D name=~S.~%" event-type *mp-scene-name-scratch*)
    (case event-type
      ((MP_EVENT_SCENE_START) (mp-event-handler-scene-start evt))
      ((MP_EVENT_SCENE_REQUEST_SKIP) (mp-event-handler-scene-request-skip (the uint 0)))
      ((MP_EVENT_SCENE_SKIPPED) (mp-event-handler-scene-skipped evt))
      (else (debug-log *mp-debug-log?* "[MP-Event] Unknown scene event ~D.~%" event-type)))
    )
  (none)
  )

;; Subsystems expose state/application helpers, but event entrypoints stay here
;; so the dispatcher has one obvious ownership boundary.
(defun mp-receive-waypoint-event ((evt mp-waypoint-event) (snapshot? symbol))
  (mp-waypoint-apply-remote-event! evt snapshot?)
  (none)
  )

(defun mp-receive-warp-gate-event ((evt mp-warp-gate-event))
  (mp-warp-gate-apply-remote-event! evt)
  (none)
  )

(defun mp-receive-widow-bomb-kick-event ((evt mp-widow-bomb-kick-event))
  (mp-widow-bomb-apply-kick-event! evt)
  (none)
  )

(defun mp-receive-widow-bomb-fizzle-event ((evt mp-widow-bomb-fizzle-event))
  (mp-widow-bomb-apply-fizzle-event! evt)
  (none)
  )

(defun mp-receive-widow-spydroid-event ((evt mp-widow-spydroid-event))
  (mp-widow-apply-spydroid-event! evt)
  (none)
  )

(defun mp-receive-widow-bomb-event ((evt mp-widow-bomb-event))
  (mp-widow-apply-bomb-event! evt)
  (none)
  )

(defun mp-receive-widow-bomb-hit-event ((evt mp-widow-bomb-hit-event))
  (mp-widow-apply-bomb-hit-event! evt)
  (none)
  )

(defun mp-receive-widow-catwalk-hit-event ((evt mp-widow-catwalk-hit-event))
  (mp-widow-apply-catwalk-hit-event! evt)
  (none)
  )

(defun mp-receive-palace-squid-event ((evt mp-palace-squid-event))
  (case (-> evt squid-evt)
    ((MP_PALACE_SQUID_EVT_HIT_REQUEST)
     (mp-palace-squid-apply-hit-request! evt)
     )
    ((MP_PALACE_SQUID_EVT_GRENADE)
     (when (and (not (mp-session-host?)) (> (-> evt sequence) *mp-palace-squid-last-action-seq*))
       (set! *mp-palace-squid-last-action-seq* (-> evt sequence))
       (mp-palace-squid-apply-grenade-event! evt)
       )
     )
    ((MP_PALACE_SQUID_EVT_WHIRLWIND)
     (when (and (not (mp-session-host?)) (> (-> evt sequence) *mp-palace-squid-last-action-seq*))
       (set! *mp-palace-squid-last-action-seq* (-> evt sequence))
       (mp-palace-squid-apply-whirlwind-event! evt)
       )
     )
    ((MP_PALACE_SQUID_EVT_RESOLUTION)
     (when (and (not (mp-session-host?)) (> (-> evt sequence) *mp-palace-squid-last-action-seq*))
       (set! *mp-palace-squid-pending-resolution-seq* (-> evt sequence))
       )
     )
    )
  (none)
  )

(defun mp-event-dispatch! ((evt mp-event))
  "Validate and dispatch every inbound application event from one central entrypoint."
  (cond
    ((or (not evt) (zero? (the-as uint evt)))
     (debug-log *mp-debug-log?* "[MP-Event] Dropped null event.~%"))
    ((not (mp-schema-event-known? (-> evt etype)))
     (debug-log *mp-debug-log?* "[MP-Event] Dropped unknown event ID ~D.~%" (-> evt etype)))
    ((> (-> evt payload-size) (the uint 480))
     (debug-log *mp-debug-log?* "[MP-Event] Dropped oversized event ID ~D.~%" (-> evt etype)))
    ((not (mp-player-controller-record
            *mp-player-controller*
            (-> evt source-player-id)))
     (debug-log *mp-debug-log?*
       "[MP-Event] Dropped event ~D from vacant player ~D.~%"
       (-> evt etype)
       (-> evt source-player-id)))
    (else
     (set! *mp-processing-remote-event* #t)
     (set! *mp-current-event-source-player-id* (-> evt source-player-id))
     (let ((event-type (-> evt etype))
           (aid (-> (the-as mp-aid-event evt) aid))
           (source-record
             (mp-player-controller-record
               *mp-player-controller*
               (-> evt source-player-id))))
       (when (or (not source-record) (zero? source-record))
         (set! *mp-processing-remote-event* #f)
         (return #f))
       (cond
         ((or (= event-type MP_EVENT_SCENE_START)
              (= event-type MP_EVENT_SCENE_REQUEST_SKIP)
              (= event-type MP_EVENT_SCENE_SKIPPED))
          (mp-event-handle-scene! (the-as mp-scene-event evt)))
         ((and (>= event-type MP_EVENT_MISSION_LEAVE)
               (<= event-type MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END))
          (mp-event-handle-mission! evt))
         (else
          (case event-type
            ((MP_EVENT_ORB) (mp-event-handler-orb aid))
            ((MP_EVENT_GEM) (mp-event-handler-gem aid))
            ((MP_EVENT_BREAK) (mp-event-handler-break aid))
            ((MP_EVENT_ATTACK_ENEMY) (mp-event-handler-attack-enemy (the-as mp-actor-attack-event evt)))
            ((MP_EVENT_ENEMY_AUTHORITY_REQUEST)
             (mp-event-handler-authority-request aid (-> evt source-player-id)))
            ((MP_EVENT_ENEMY_AUTHORITY_ACK) (mp-event-handler-authority-ack aid))
            ((MP_EVENT_ATTACK_PED) (mp-event-handler-attack-ped (the-as mp-actor-attack-event evt)))
            ((MP_EVENT_CHANGE_MODE_DARKJAK) (mp-event-handler-change-mode-darkjak aid (-> evt source-player-id)))
            ((MP_EVENT_END_MODE_DARKJAK) (mp-event-handler-end-mode-darkjak aid (-> evt source-player-id)))
            ((MP_EVENT_EDGE_GRAB)
             (mp-receive-edge-grab-event (mp-player-record-target source-record) evt #f))
            ((MP_EVENT_PILOT_EDGE_GRAB)
             (mp-receive-edge-grab-event (mp-player-record-target source-record) evt #t))
            ((MP_EVENT_PLAYER_RESPAWNED) (mp-event-remote-player-respawned source-record))
            ((MP_EVENT_PLAYER_DIED) (mp-event-remote-player-died source-record))
            ((MP_EVENT_CONTINUE_POINT) (mp-receive-continue-event (the-as mp-continue-event evt)))
            ((MP_EVENT_WAYPOINT_BUMP) (mp-receive-waypoint-event (the-as mp-waypoint-event evt) #f))
            ((MP_EVENT_WAYPOINT_SNAPSHOT) (mp-receive-waypoint-event (the-as mp-waypoint-event evt) #t))
            ((MP_EVENT_WAYPOINT_REQUEST) (mp-receive-waypoint-event (the-as mp-waypoint-event evt) #f))
            ((MP_EVENT_POLE_GRAB) (mp-receive-pole-grab-event (the-as mp-aid-event evt)))
            ((MP_EVENT_BATTLE_EVENT) (mp-receive-battle-event (the-as mp-battle-event evt)))
            ((MP_EVENT_PLAYER_GUN_SHOT) (mp-receive-player-gun-shot-event (the-as mp-player-gun-shot-event evt)))
            ((MP_EVENT_WARP_GATE) (mp-receive-warp-gate-event (the-as mp-warp-gate-event evt)))
            ((MP_EVENT_ENEMY_DEATH) (mp-event-handler-enemy-death (the-as mp-enemy-death-event evt)))
            ((MP_EVENT_ENEMY_GEM) (mp-event-handler-enemy-gem (the-as mp-enemy-gem-event evt)))
            ((MP_EVENT_MTN_PLAT_SHOOT) (mp-event-handler-mtn-plat-shoot (the-as mp-mtn-plat-shoot-event evt)))
            ((MP_EVENT_MTN_DICE) (mp-event-handler-mtn-dice (the-as mp-mtn-dice-event evt)))
            ((MP_EVENT_PALACE_SQUID) (mp-receive-palace-squid-event (the-as mp-palace-squid-event evt)))
            ((MP_EVENT_FORT_MISSILE_TARGET) (mp-fort-missile-target-replay! (the-as uint (-> (the-as mp-fort-missile-target-event evt) target-index))))
            ((MP_EVENT_WIDOW_SPYDROID) (mp-receive-widow-spydroid-event (the-as mp-widow-spydroid-event evt)))
            ((MP_EVENT_WIDOW_BOMB) (mp-receive-widow-bomb-event (the-as mp-widow-bomb-event evt)))
            ((MP_EVENT_WIDOW_BOMB_KICK) (mp-receive-widow-bomb-kick-event (the-as mp-widow-bomb-kick-event evt)))
            ((MP_EVENT_WIDOW_BOMB_FIZZLE) (mp-receive-widow-bomb-fizzle-event (the-as mp-widow-bomb-fizzle-event evt)))
            ((MP_EVENT_WIDOW_BOMB_HIT) (mp-receive-widow-bomb-hit-event (the-as mp-widow-bomb-hit-event evt)))
            ((MP_EVENT_WIDOW_CATWALK_HIT) (mp-receive-widow-catwalk-hit-event (the-as mp-widow-catwalk-hit-event evt)))
            (else (debug-log *mp-debug-log?* "[MP-Event] No handler for event ID ~D.~%" event-type)))
          )
         )
       )
     (set! *mp-processing-remote-event* #f)
     (set! *mp-current-event-source-player-id* MP_INVALID_PLAYER_ID)
     )
    )
  (none)
  )
