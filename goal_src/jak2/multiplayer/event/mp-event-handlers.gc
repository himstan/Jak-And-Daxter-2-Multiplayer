;;-*-Lisp-*-
(in-package goal)

(define-extern mp-tomb-scene-transport-suppressed? (function string symbol))
(define-extern mp-fort-missile-target-replay! (function uint none))
(define-extern mp-hover-enemy-apply-spawn! (function mp-hover-enemy-spawn-event none))

(define-perm *mp-mission-failed-pending-choice* uint (the uint 0))

(defun mp-reset-scene-sync-state! ()
  (set! *mp-last-scene-player* #f)
  (mp-scene-coordinator-reset!)
  (set! *mp-pending-scene-sync?* #f)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (set! *mp-scene-sync-target-hold?* #f)
  (set! *mp-scene-sync-target-hold-until* (the-as time-frame 0))
  (mp-clear-active-local-scene-name!)
  (when (and *mp-pending-scene-sync-name* (nonzero? (the-as uint *mp-pending-scene-sync-name*)))
    (set! (-> *mp-pending-scene-sync-name* data 0) (the uint 0)))
  (when (and *mp-pending-scene-sync-continue-name* (nonzero? (the-as uint *mp-pending-scene-sync-continue-name*)))
    (set! (-> *mp-pending-scene-sync-continue-name* data 0) (the uint 0)))
  (set! *mp-intro-skip-bootstrap-pending?* #f)
  (set! *mp-intro-skip-blackout-pending?* #f)
  (when (and *mp-last-scene-name* (nonzero? (the-as uint *mp-last-scene-name*)))
    (set! (-> *mp-last-scene-name* data 0) (the uint 0)))
  (when (and *mp-last-local-continue-name* (nonzero? (the-as uint *mp-last-local-continue-name*)))
    (set! (-> *mp-last-local-continue-name* data 0) (the uint 0)))
  (none))

(defun mp-event-remote-player-respawned ((source-record mp-player-record))
  (when (and source-record (nonzero? source-record))
    (mp-player-runtime-clear-flag! source-record (mp-player-runtime-flags dying))
    (mp-player-runtime-clear-flag! source-record (mp-player-runtime-flags dead)))
  (none))

(defun mp-event-remote-player-died ((source-record mp-player-record))
  (when (and source-record (nonzero? source-record))
    (mp-player-runtime-clear-flag! source-record (mp-player-runtime-flags dying))
    (mp-player-runtime-set-flag! source-record (mp-player-runtime-flags dead)))
  (none))

(defun mp-event-handler-enemy-death ((evt mp-enemy-death-event))
  (when (and (nonnull? evt) (= (-> evt payload-size) (mp-event-payload-size (-> evt etype))))
    (let ((aid (the-as uint (-> evt payload aid))))
      (when (nonzero? aid)
        (if (mp-mark-aid-dead-perm! aid)
          (log 'debug "[MP-Event-Handlers] Recorded enemy death tombstone aid=~D.~%" aid)
          (log 'debug "[MP-Event-Handlers] Could not record enemy death tombstone aid=~D.~%" aid)))))
  (none))

(defun collectable-pickup-authority? ((evt collectable-pickup-event))
  (and (nonnull? evt *game-info* *mp-player-controller*)
       (nonzero? (-> evt payload source-id))
       (or (mp-session-host?) (= (-> evt source-player-id) (mp-host-player-id)))))

(defun collectable-sync-counts! ((evt collectable-pickup-event) (pickup pickup-type) (collected int))
  (when (and (nonnull? evt *game-info* *mp-player-controller*) (>= collected 0))
    (let* ((host? (mp-session-host?))
           (count (if host? (if (= pickup (pickup-type skill)) (-> *game-info* skill) (-> *game-info* gem)) (-> evt payload count)))
           (total (if host? (if (= pickup (pickup-type skill)) (-> *game-info* skill-total) (-> *game-info* gem-total)) (-> evt payload total))))
      (when host?
        (+! count (the float collected))
        (+! total (the float collected)))
      (when (and (> collected 0) (nonnull? *target*))
        (send-event *target* 'get-pickup pickup 1.0))
      (case pickup
        (((pickup-type skill)) (set! (-> *game-info* skill) count) (set! (-> *game-info* skill-total) total))
        (((pickup-type gem)) (set! (-> *game-info* gem) count) (set! (-> *game-info* gem-total) total)))
      (when host?
        (set! (-> evt payload count) count)
        (set! (-> evt payload total) total)
        (mp-event-enqueue! evt))))
  (none))

(defun orb-apply-collected-aid! ((aid uint))
  (when (or (zero? aid) (not (nonnull? *level* *game-info*)))
    (return -1))
  (let* ((ent (entity-by-aid aid))
         (perm (if (nonnull? ent (-> ent extra)) (-> ent extra perm) (the-as entity-perm #f)))
         (already-collected? (or (mp-orb-aid-collected? aid)
                                 (and (nonnull? perm) (logtest? (-> perm status) (entity-perm-status dead))))))
    (when (not (mp-orb-record-remote-collected-aid! aid))
      (return -1))
    (when (and (nonnull? perm) (not (logtest? (-> perm status) (entity-perm-status dead))))
      (logior! (-> perm status) (entity-perm-status dead))
      (when (nonnull? ent (-> ent extra) (-> ent extra process))
        (send-event (-> ent extra process) 'pickup)))
    (if already-collected? 0 1)))

(defun mp-event-handler-orb ((evt collectable-pickup-event))
  (when (and (nonnull? evt) (collectable-pickup-authority? evt))
    (collectable-sync-counts! evt (pickup-type skill) (orb-apply-collected-aid! (-> evt payload source-id))))
  (none))

(defun mp-event-handler-gem ((evt collectable-pickup-event))
  (when (and (nonnull? evt *level*) (collectable-pickup-authority? evt))
    (let* ((aid (the-as uint (-> evt payload source-id)))
           (ent (entity-by-aid aid))
           (newly-collected? (mp-gem-record-aid-collected! aid)))
      (when (nonnull? ent (-> ent extra) (-> ent extra perm))
        (logior! (-> ent extra perm status) (entity-perm-status dead)))
      (when (nonnull? ent (-> ent extra) (-> ent extra process))
        (send-event (-> ent extra process) 'pickup))
      (collectable-sync-counts! evt (pickup-type gem) (if newly-collected? 1 0))))
  (none))

(define *mp-search-enemy-gem-source-id* (the-as uint 0))
(define *mp-search-enemy-gem-index* (the-as uint 0))
(define *mp-search-enemy-gem-res* (the-as gem #f))

(defun mp-enemy-gem-available? ((gem-proc gem))
  (and (nonnull? gem-proc)
       (!= (-> gem-proc status) 'dead)
       (let ((next-state (-> gem-proc next-state))) (not (and (nonnull? next-state) (= (-> next-state name) 'pickup))))))

(defun mp-find-enemy-gem-callback ((p process-tree))
  (when (nonnull? p)
    (let ((proc (the-as process p)))
      (when (and (nonnull? proc) (type? proc gem))
        (let ((gem-proc (the-as gem proc)))
          (when (and (mp-enemy-gem-available? gem-proc)
                     (= (-> gem-proc enemy-gem-source-id) (the-as uint32 *mp-search-enemy-gem-source-id*))
                     (= (-> gem-proc enemy-gem-index) (the-as uint32 *mp-search-enemy-gem-index*)))
            (set! *mp-search-enemy-gem-res* gem-proc)
            (return #f))))))
  #t)

(defun mp-find-enemy-gem ((source-id uint) (gem-index uint))
  (set! *mp-search-enemy-gem-source-id* source-id)
  (set! *mp-search-enemy-gem-index* gem-index)
  (set! *mp-search-enemy-gem-res* (the-as gem #f))
  (when (nonnull? *entity-pool* *kernel-context*)
    (iterate-process-tree *entity-pool* mp-find-enemy-gem-callback *kernel-context*))
  (when (and (not (nonnull? *mp-search-enemy-gem-res*)) (nonnull? *active-pool* *kernel-context*))
    (iterate-process-tree *active-pool* mp-find-enemy-gem-callback *kernel-context*))
  *mp-search-enemy-gem-res*)

(defun mp-event-handler-enemy-gem ((evt mp-enemy-gem-event))
  (when (and (nonnull? evt) (collectable-pickup-authority? evt))
    (let ((source-aid (the-as uint (-> evt payload source-id)))
          (gem-index (the-as uint (-> evt payload gem-index))))
      (let ((newly-collected? (mp-enemy-gem-record-collected! source-aid gem-index))
            (gem-proc (mp-find-enemy-gem source-aid gem-index)))
        (when (mp-enemy-gem-available? gem-proc)
          (send-event gem-proc 'die))
        (collectable-sync-counts! evt (pickup-type gem) (if newly-collected? 1 0)))))
  (none))

(defun mp-event-handler-break ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (log 'debug "[MP-Event-Handlers] Received MP_EVENT_BREAK for aid=~D Entity: ~A~%" aid ent)
      (let ((perm (-> ent extra perm)))
        (when (not (logtest? (-> perm status) (entity-perm-status dead subtask-complete)))
          (let ((proc (-> ent extra process)))
            (if (and proc (nonzero? proc))
              (begin
                (if (mp-should-block-break-sync? proc)
                  (log 'debug "[MP-Event-Handlers] Ignoring BREAK for important process ~A aid=~D~%" proc aid)
                  (begin
                    (mp-mark-aid-dead-perm! aid)
                    (logior! (-> perm status) (entity-perm-status dead subtask-complete))
                    (send-event proc
                                'attack
                                #f
                                (static-attack-info ((id (new-attack-id))
                                                     (mode 'mp-break)
                                                     (penetrate-using (penetrate generic-attack
                                                                                 lunge
                                                                                 flop
                                                                                 punch
                                                                                 spin
                                                                                 roll
                                                                                 uppercut
                                                                                 bonk
                                                                                 explode))))))))))))))
  (none))

(defun mp-event-handler-attack-enemy ((evt mp-actor-attack-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((net-id (-> evt payload net-id)))
    (log 'debug
         "[MP-Event-Handlers] Received MP_EVENT_ATTACK_ENEMY for nid=~D attack-id=~D~%"
         net-id
         (-> evt payload attack-id))
    (let ((proc (find-enemy-by-aid net-id)))
      (if (and proc (nonzero? proc))
        (let ((attacker (mp-player-target-by-id (-> evt source-player-id)))
              (e-proc (the-as enemy proc))
              (rec (mp-get-enemy-auth net-id)))
          (when (and attacker (nonzero? attacker))
            (log 'debug
                 "[MP-Event-Handlers] Applying Authoritative hit to ~A from remote attacker ~A nid=~D~%"
                 proc
                 attacker
                 net-id)
            (mp-actor-apply-authoritative-remote-damage! e-proc attacker evt 'enemy)
            (if (and attacker (nonzero? attacker) (-> e-proc focus) (nonzero? (-> e-proc focus)))
              (set! (-> e-proc focus handle) (process->handle attacker)))))
        (begin
          (when (<= (-> evt payload new-hp) 0)
            (mp-mark-aid-dead-perm! net-id))
          (when (mp-battle-enemy-id? net-id)
            (mp-battle-request-rosters!))
          (log 'debug "[MP-Event-Handlers] Could not find enemy process for nid=~D.~%" net-id)))))
  (none))

(defun mp-event-handler-attack-ped ((evt mp-actor-attack-event))
  (when (nonnull? evt)
    (let ((target-authority (-> evt payload traffic-authority-player-id))
          (local-player-id (mp-local-player-id)))
      (when (< target-authority (the uint MP_MAX_PLAYERS))
        (cond
          ((or (and (= target-authority local-player-id) *mp-traffic-local-authoritative?*)
               (and (= target-authority local-player-id)
                    (let ((v (mp-vehicle-find-by-net-id (-> evt payload net-id))))
                      (and v (nonzero? v) (mp-vehicle-is-local-authoritative? v)))))
           (if (mp-pedestrian-find-by-net-id (-> evt payload net-id))
             (mp-pedestrian-apply-remote-attack! evt)
             (mp-vehicle-apply-remote-attack! evt)))
          ((and (= target-authority *mp-traffic-selected-authority-id*)
                (!= target-authority local-player-id)
                (!= (-> evt source-player-id) local-player-id)
                (not *mp-traffic-local-authoritative?*))
           (mp-pedestrian-replay-remote-attack! evt))))))
  (none))

(defun mp-handle-remote-scene-hacks ((scene-name string))
  (case (string->symbol scene-name)
    (('city-get-yellow-gun)
     (when (and *target* (not (logtest? (-> *game-info* features) (game-feature gun-yellow))))
       (log 'debug "[MP-Event-Handlers] Received Gun Yellow sync! Giving to player.~%")
       (pickup-collectable! (-> *target* fact) (pickup-type gun-yellow) 1.0 (the-as handle #f))
       (task-close! "sewer-enemy-resolution")))
    (('city-keira-hover-challenge-intro)
     (log 'debug "[MP-Event-Handlers] Received Keira Delivery Scene. Forcing task close.~%")
     (task-close! "city-keira-delivery-delivery"))))

(defun mp-ignore-intro-start-after-skip? ((scene-name string))
  (and (mp-session-client?) *mp-intro-skip-blackout-pending?* (mp-intro-chain-scene? scene-name)))

(defun mp-arm-intro-skip-bootstrap! ((scene-name string))
  (when (mp-intro-chain-scene? scene-name)
    (cond
      ((mp-session-host?)
       (log 'debug "[MP-Event-Handlers] Remote skipped intro. Host bootstrap pending.~%")
       (set! *mp-intro-skip-bootstrap-pending?* #t))
      ((mp-session-client?)
       (log 'debug "[MP-Event-Handlers] Remote skipped intro. Client blackout pending.~%")
       (set! *mp-intro-skip-blackout-pending?* #t))))
  (none))

(defun mp-intro-skip-host-ready-for-bootstrap? ()
  (and (mp-session-host?)
       (mp-session-in-game?)
       (not *scene-player*)
       *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       (not (and (-> *target* state) (= (-> *target* state name) 'target-load-wait)))
       (not (and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait)))
       *level*
       (nonzero? *level*)
       (= (-> *level* loading-level) (-> *level* default-level))
       *game-info*
       (nonzero? *game-info*)
       (-> *game-info* current-continue)
       (nonzero? (-> *game-info* current-continue))
       (= (-> *game-info* current-continue level) 'prison)))

(defun mp-request-intro-skip-bootstrap-when-ready! ()
  (when (and *mp-intro-skip-bootstrap-pending?* (mp-intro-skip-host-ready-for-bootstrap?))
    (log 'debug "[MP-Event-Handlers] Host stable in prison. Requesting bootstrap for client.~%")
    (set! *mp-intro-skip-bootstrap-pending?* #f)
    (pc-multi-request-bootstrap))
  (none))

(defun mp-hold-intro-skip-blackout! ()
  (when (and *mp-intro-skip-blackout-pending?* (mp-session-client?) (mp-session-in-game?) (not *scene-player*))
    (set-blackout-frames (seconds 0.05)))
  (none))

(defun mp-copy-scene-sync-name! ((dst string) (src string))
  (when (and dst (nonzero? dst))
    (dotimes (idx 64)
      (set! (-> dst data idx) (the uint 0)))
    (when (and src (nonzero? src))
      (let ((len (min 63 (length src))))
        (dotimes (idx len)
          (set! (-> dst data idx) (-> src data idx)))
        (set! (-> dst data len) (the uint 0))
        (set! (-> dst data -4) (the-as uint len)))))
  (none))

(defun mp-copy-scene-sync-event-continue! ((dst string) (evt mp-scene-event))
  (when (nonnull? dst evt)
    (let ((len 0))
      (dotimes (idx 32)
        (set! (-> dst data idx) (-> evt payload load-continue idx)))
      (set! (-> dst data 31) (the uint 0))
      (while (and (< len 31) (nonzero? (-> dst data len)))
        (+! len 1))
      (set! (-> dst data -4) (the-as uint len))))
  (none))

(defun mp-log-pending-scene-sync-wait! ((reason string))
  (when (>= (current-time) *mp-pending-scene-sync-next-log-time*)
    (log 'debug
         "[MP-Event-Handlers] Waiting to start remote scene ~S (continue: ~S): ~A.~%"
         *mp-pending-scene-sync-name*
         *mp-pending-scene-sync-continue-name*
         reason)
    (set! *mp-pending-scene-sync-next-log-time* (+ (current-time) (seconds 1))))
  (none))

(defun mp-arm-pending-scene-sync! ((scene-name string) (evt mp-scene-event))
  (mp-copy-scene-sync-name! *mp-pending-scene-sync-name* scene-name)
  (mp-copy-scene-sync-event-continue! *mp-pending-scene-sync-continue-name* evt)
  (set! *mp-pending-scene-sync?* #t)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (log 'debug
       "[MP-Event-Handlers] Armed remote scene sync for ~S (continue: ~S).~%"
       *mp-pending-scene-sync-name*
       *mp-pending-scene-sync-continue-name*)
  (none))

(defun mp-scene-sync-continue-wants-aligned? ((cont continue-point))
  (when (and cont (nonzero? cont) *load-state* (nonzero? *load-state*))
    (let ((vis-info (lookup-level-info (-> cont vis-nick))))
      (when (and vis-info (nonzero? vis-info) (!= (-> *load-state* vis-nick) (-> vis-info name)))
        (return #f)))
    (dotimes (idx 6)
      (when (or (!= (-> *load-state* want idx name) (-> cont want idx name))
                (!= (-> *load-state* want idx display?) (-> cont want idx display?)))
        (return #f)))
    (return #t))
  #f)

(defun mp-scene-sync-request-continue-levels! ((continue-name string))
  (when (and continue-name (nonzero? (length continue-name)) *load-state* (nonzero? *load-state*))
    (let ((cont (scene-decode-continue continue-name)))
      (when (and cont (nonzero? cont) (not (mp-scene-sync-continue-wants-aligned? cont)))
        (let ((vis-info (lookup-level-info (-> cont vis-nick))))
          (set! (-> *load-state* vis-nick) (if vis-info (-> vis-info name))))
        (dotimes (idx 6)
          (set! (-> *load-state* want idx name) (-> cont want idx name))
          (set! (-> *load-state* want idx display?) (-> cont want idx display?))
          (set! (-> *load-state* want idx force-vis?) #f)
          (set! (-> *load-state* want idx force-inside?) #f))
        (dotimes (idx 3)
          (set! (-> *load-state* want-sound idx) (-> cont want-sound idx)))
        (add-borrow-levels *load-state*))))
  (none))

(defun mp-scene-sync-level-paging-idle? ()
  (and *level*
       (nonzero? *level*)
       (-> *level* loading-level)
       (nonzero? (-> *level* loading-level))
       (-> *level* default-level)
       (nonzero? (-> *level* default-level))
       (= (-> *level* loading-level) (-> *level* default-level))))

(defun mp-scene-sync-wanted-level-ready? ((level-name symbol) (display-mode symbol))
  (if (and level-name display-mode *level* (nonzero? *level*))
    (let ((lev (level-get *level* level-name)))
      (and lev
           (nonzero? lev)
           (= (-> lev status) 'active)
           (= (-> lev display?) display-mode)
           (-> lev bsp)
           (nonzero? (-> lev bsp))))
    #t))

(defun mp-scene-sync-continue-levels-ready? ((continue-name string))
  (if (and continue-name (nonzero? (length continue-name)))
    (let ((cont (scene-decode-continue continue-name)))
      (if (and cont (nonzero? cont))
        (begin
          (dotimes (idx 6)
            (let ((level-name (-> cont want idx name))
                  (display-mode (-> cont want idx display?)))
              (when (and level-name display-mode (not (mp-scene-sync-wanted-level-ready? level-name display-mode)))
                (return #f))))
          (mp-scene-sync-level-paging-idle?))
        #t))
    #t))

(defun mp-scene-sync-levels-ready-or-request! ()
  (if (and *mp-pending-scene-sync-continue-name* (nonzero? (length *mp-pending-scene-sync-continue-name*)))
    (if (mp-scene-sync-continue-levels-ready? *mp-pending-scene-sync-continue-name*)
      #t
      (begin
        (mp-scene-sync-request-continue-levels! *mp-pending-scene-sync-continue-name*)
        (mp-scene-sync-continue-levels-ready? *mp-pending-scene-sync-continue-name*)))
    (mp-remote-teleport-ready-or-request!)))

(defun mp-pending-scene-sync-scene-ready? ()
  (and *mp-pending-scene-sync-name*
       (nonzero? (length *mp-pending-scene-sync-name*))
       (let ((scene-obj (scene-lookup *mp-pending-scene-sync-name*))) (and scene-obj (nonzero? scene-obj)))))

(defun mp-scene-sync-scene-player-playing? ()
  (if (and *scene-player* (nonzero? *scene-player*))
    (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
      (and scene-proc
           (nonzero? scene-proc)
           (-> scene-proc state)
           (nonzero? (-> scene-proc state))
           (= (-> scene-proc state name) 'play-anim)))
    #f))

(defun mp-scene-sync-scene-player-has-target? ()
  (and *scene-player* (nonzero? *scene-player*) *target* (nonzero? *target*) (focus-test? *target* grabbed)))

(defun mp-scene-sync-pin-target-at-hold-pos! ()
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *mp-scene-sync-target-hold-pos*
             (nonzero? *mp-scene-sync-target-hold-pos*))
    (let ((control (-> *target* control)))
      (vector-copy! (-> control trans) *mp-scene-sync-target-hold-pos*)
      (set! (-> control transv quad) (the-as uint128 0))
      (vector-copy! (-> control camera-pos) (-> control trans))
      (set-blackout-frames (seconds 0.1))))
  (none))

(defun mp-scene-sync-start-target-hold! ()
  (when (and *target*
             (nonzero? *target*)
             (-> *target* control)
             (nonzero? (-> *target* control))
             *mp-scene-sync-target-hold-pos*
             (nonzero? *mp-scene-sync-target-hold-pos*))
    (vector-copy! *mp-scene-sync-target-hold-pos* (-> *target* control trans))
    (set! *mp-scene-sync-target-hold?* #t)
    (set! *mp-scene-sync-target-hold-until* (+ (current-time) (seconds 15)))
    (mp-scene-sync-pin-target-at-hold-pos!))
  (none))

(defun mp-process-scene-sync-target-hold! ()
  (when *mp-scene-sync-target-hold?*
    (cond
      ((mp-scene-sync-scene-player-has-target?) (set! *mp-scene-sync-target-hold?* #f))
      ((mp-scene-sync-scene-player-playing?) (set! *mp-scene-sync-target-hold?* #f))
      ((>= (current-time) *mp-scene-sync-target-hold-until*)
       (log 'debug "[MP-Event-Handlers] Releasing scene target hold after timeout.~%")
       (set! *mp-scene-sync-target-hold?* #f))
      (else (mp-scene-sync-pin-target-at-hold-pos!))))
  (none))

(defun mp-scene-sync-use-entity-trigger? ((scene-name string))
  (and scene-name
       (nonzero? (length scene-name))
       (or (string= scene-name "mtn-plat-buried-rocks-a") (string= scene-name "mtn-plat-buried-rocks-2"))))

(defun mp-scene-sync-force-npc-step! ((scene-obj scene) (scene-name string))
  (when (and scene-obj (nonzero? scene-obj))
    (let ((entity-name (-> scene-obj entity)))
      (when (and entity-name (nonzero? entity-name))
        (let ((npc (process-by-ename entity-name)))
          (if (and npc (nonzero? npc))
            (let ((npc-proc (the-as process-drawable npc)))
              (if (mp-scene-sync-use-entity-trigger? scene-name)
                (log 'debug "[MP-Event-Handlers] Found scene object ~S. Snapping and sending trigger.~%" entity-name)
                (log 'debug "[MP-Event-Handlers] Found NPC ~S. Snapping and signaling force-step.~%" entity-name))
              (when (and npc-proc
                         (nonzero? npc-proc)
                         (-> npc-proc root)
                         (nonzero? (-> npc-proc root))
                         *target*
                         (nonzero? *target*)
                         (-> *target* control)
                         (nonzero? (-> *target* control)))
                (vector-copy! (-> npc-proc root trans) (-> *target* control trans)))
              (if (mp-scene-sync-use-entity-trigger? scene-name)
                (let ((old-remote-context *mp-processing-remote-event*))
                  (set! *mp-processing-remote-event* #t)
                  (send-event npc 'trigger)
                  (set! *mp-processing-remote-event* old-remote-context))
                (send-event npc 'mp-force-scene-step scene-name)))
            (log 'debug
                 "[MP-Event-Handlers] NPC ~S not birthed yet. It should link via its own logic when it does.~%"
                 entity-name))))))
  (none))

(defun mp-finish-pending-scene-sync! ((source-record mp-player-record))
  (let ((scene-name *mp-pending-scene-sync-name*))
    (when (and scene-name (nonzero? scene-name) (nonzero? (length scene-name)) source-record (nonzero? source-record))
      (mp-handle-remote-scene-hacks scene-name)
      (mp-scene-sync-teleport-to-player! source-record)
      (when (not (mp-scene-sync-use-entity-trigger? scene-name))
        (mp-scene-sync-start-target-hold!)
        (let ((scene-obj (scene-lookup scene-name)))
          (when (and (not (mp-scene-sync-use-entity-trigger? scene-name))
                     (not *scene-player*)
                     scene-obj
                     (nonzero? scene-obj))
            (let ((load-pt (if (and *mp-pending-scene-sync-continue-name*
                                    (nonzero? (length *mp-pending-scene-sync-continue-name*)))
                             *mp-pending-scene-sync-continue-name*
                             (the-as string (-> scene-obj load-point-obj)))))
              (log 'debug
                   "[MP-Event-Handlers] Spawning authoritative scene-player for ~S (continue: ~S)~%"
                   scene-name
                   load-pt)
              (let ((old-remote-context *mp-processing-remote-event*))
                (set! *mp-processing-remote-event* #t)
                (process-spawn scene-player :init scene-player-init scene-name #t load-pt)
                (set! *mp-processing-remote-event* old-remote-context))))
          (mp-scene-sync-force-npc-step! scene-obj scene-name)))))
  (set! *mp-pending-scene-sync?* #f)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (none))

(defun mp-cancel-pending-scene-sync! ((reason string))
  (when *mp-pending-scene-sync?*
    (log 'debug "[MP-Event-Handlers] Cancelling pending scene ~S: ~A.~%" *mp-pending-scene-sync-name* reason))
  (set! *mp-pending-scene-sync?* #f)
  (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0))
  (none))

(defun mp-local-scene-name-matches? ((scene-name string))
  (when (and scene-name (nonzero? scene-name) (nonzero? (length scene-name)) *scene-player* (nonzero? *scene-player*))
    (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
      (when (and scene-proc
                 (nonzero? scene-proc)
                 (-> scene-proc scene)
                 (nonzero? (-> scene-proc scene))
                 (-> scene-proc scene name)
                 (nonzero? (-> scene-proc scene name)))
        (return (string= scene-name (-> scene-proc scene name))))))
  #f)

(defun is-host-owned-scene ((scene-name string))
  (the-as symbol
          (and (mp-session-host?)
               (not (mp-local-scene-name-matches? scene-name))
               (or (string= scene-name "tomb-boss-res") (string= scene-name "palace-boss-res")))))

(defun mp-process-pending-scene-sync! ()
  (when *mp-pending-scene-sync?*
    (let ((source-record (mp-scene-coordinator-source-record)))
      (cond
        ((mp-local-scene-name-matches? *mp-pending-scene-sync-name*)
         (log 'debug
              "[MP-Event-Handlers] Pending remote scene ~S is already active locally; consuming it.~%"
              *mp-pending-scene-sync-name*)
         (set! *mp-pending-scene-sync?* #f)
         (set! *mp-pending-scene-sync-next-log-time* (the-as time-frame 0)))
        ((and *scene-player* (nonzero? *scene-player*))
         (mp-log-pending-scene-sync-wait! "another local scene is active"))
        ((not (mp-scene-coordinator-has-connected-entry?))
         (mp-cancel-pending-scene-sync! "no connected scene player remains"))
        ((or (not source-record) (zero? source-record))
         (mp-log-pending-scene-sync-wait! "scene source state is not ready"))
        ((not (mp-scene-sync-levels-ready-or-request!))
         (mp-log-pending-scene-sync-wait! "scene continue levels are not loaded"))
        ((not (mp-pending-scene-sync-scene-ready?)) (mp-log-pending-scene-sync-wait! "scene definition is not loaded"))
        ((not (mp-local-scene-teleport-ready-for-record? source-record))
         (mp-log-pending-scene-sync-wait! "local target is not ready"))
        (else (mp-finish-pending-scene-sync! source-record)))))
  (none))

(defun mp-pending-scene-name-matches? ((scene-name string))
  (and scene-name
       (nonzero? scene-name)
       *mp-pending-scene-sync?*
       *mp-pending-scene-sync-name*
       (nonzero? *mp-pending-scene-sync-name*)
       (string= scene-name *mp-pending-scene-sync-name*)))

(defun mp-duplicate-scene-start? ((scene-name string))
  (or (mp-local-scene-name-matches? scene-name) (mp-pending-scene-name-matches? scene-name)))

(defun mp-event-handler-scene-start ((ev mp-scene-event))
  (let ((s* *mp-scene-name-scratch*)
        (source-player-id (-> ev source-player-id)))
    (when (and s* (nonzero? s*) (nonzero? (length s*)))
      (cond
        ((mp-mountain-resolution-scene? s*) (mp-mountain-resolution-handle-scene-start! s* ev))
        ((mp-tomb-scene-transport-suppressed? s*)
         (log 'debug "[MP-Event-Handlers] Ignoring locally-owned tomb scene: ~S~%" s*))
        ((mp-ignore-intro-start-after-skip? s*)
         (log 'debug "[MP-Event-Handlers] Ignoring post-skip intro scene start: ~S.~%" s*))
        ((is-host-owned-scene s*)
         (log 'debug "[MP-Event-Handlers] Ignoring client initiation of host-owned scene ~S.~%" s*))
        ((mp-tomb-boulder-ignore-remote-scene? s*)
         (if (mp-local-scene-name-matches? s*)
           (if (mp-scene-coordinator-note-remote-start! source-player-id s*)
             (log 'debug
                  "[MP-Event-Handlers] Recorded player ~D entry for locally active role-owned scene ~S.~%"
                  source-player-id
                  s*)
             (log 'debug
                  "[MP-Event-Handlers] Could not record player ~D entry for role-owned scene ~S.~%"
                  source-player-id
                  s*))
           (log 'debug "[MP-Event-Handlers] Ignoring role-incompatible tomb scene: ~S~%" s*)))
        ((not (mp-scene-coordinator-note-remote-start! source-player-id s*))
         (log 'debug "[MP-Event-Handlers] Ignoring conflicting/finalized scene ~S from player ~D.~%" s* source-player-id))
        ((mp-duplicate-scene-start? s*)
         (log 'debug "[MP-Event-Handlers] Recorded player ~D entry for active scene ~S.~%" source-player-id s*))
        (else
         (log 'debug
              "[MP-Event-Handlers] Player ~D started scene ~S. Waiting for local readiness.~%"
              source-player-id
              s*)
         (mp-arm-pending-scene-sync! s* ev)))))
  (none))

(defun mp-event-handler-scene-request-skip ((ev mp-scene-event))
  (let ((source-player-id (-> ev source-player-id)))
    (when (mp-scene-coordinator-note-remote-vote! source-player-id *mp-scene-name-scratch*)
      (log 'debug
           "[MP-Event-Handlers] Player ~D voted to skip ~S (~D/~D).~%"
           source-player-id
           *mp-scene-name-scratch*
           (mp-scene-coordinator-vote-count)
           (mp-scene-coordinator-player-count))))
  (mp-complete-active-host-scene-skip-if-ready!)
  (none))

(defun mp-event-handler-scene-skipped ((ev mp-scene-event))
  (if (mp-scene-coordinator-accept-host-skip! (-> ev source-player-id) *mp-scene-name-scratch*)
    (begin
      (when (or (mp-pending-scene-name-matches? *mp-scene-name-scratch*)
                (and (mp-intro-chain-scene? *mp-scene-name-scratch*)
                     (mp-intro-chain-scene? *mp-pending-scene-sync-name*)))
        (mp-cancel-pending-scene-sync! "host finalized the skip"))
      (when (or (mp-local-scene-name-matches? *mp-scene-name-scratch*)
                (mp-scene-current-local-name-matches? *mp-scene-coordinator-name*)
                (and (mp-intro-chain-scene? *mp-scene-name-scratch*) *scene-player* (nonzero? *scene-player*)))
        (log 'debug "[MP-Event-Handlers] Host finalized scene skip. Aborting locally.~%")
        (let ((scene-proc (the-as scene-player (ppointer->process *scene-player*))))
          (when (and scene-proc (nonzero? scene-proc))
            (mp-abort-local-scene! scene-proc)))
        (mp-clear-client-presentation-blackout!))
      (mp-arm-intro-skip-bootstrap! *mp-scene-name-scratch*))
    (log 'debug
         "[MP-Event-Handlers] Ignoring invalid scene-finalize from player ~D for ~S.~%"
         (-> ev source-player-id)
         *mp-scene-name-scratch*))
  (none))

(defun mp-event-handler-change-mode-darkjak ((source-player-id uint))
  (let ((source-record (mp-player-record-by-id source-player-id)))
    (when (and source-record (nonzero? source-record) (mp-player-jak? source-record))
      (let ((replica (mp-player-record-target source-record)))
        (when (and replica (nonzero? replica))
          (log 'debug "[MP-Event-Handlers] Remote player activated Dark Jak! Triggering engine change-mode...~%")
          (send-event replica 'change-mode 'darkjak #f (darkjak-stage active))
          (darkjak-emit-replica-transform-feedback! replica *target*)))))
  (none))

(defun mp-event-handler-end-mode-darkjak ((source-player-id uint))
  (let ((source-record (mp-player-record-by-id source-player-id)))
    (when (and source-record (nonzero? source-record) (mp-player-jak? source-record))
      (let ((replica (mp-player-record-target source-record)))
        (when (and replica (nonzero? replica))
          (log 'debug "[MP-Event-Handlers] Remote player deactivated Dark Jak! Triggering engine change-mode...~%")
          (send-event replica 'change-mode 'normal #t)))))
  (none))

(defun mp-event-handler-mtn-plat-shoot ((evt mp-mtn-plat-shoot-event))
  (when (not (nonnull? evt))
    (return (the-as none 0)))
  (let ((aid (-> evt payload aid)))
    (log 'debug "[MP-Event-Handlers] Received MP_EVENT_MTN_PLAT_SHOOT for aid=~D.~%" aid)
    (let ((ent (entity-by-aid aid)))
      (when (nonnull? ent (-> ent extra))
        (let ((proc (-> ent extra process))) (when (nonnull? proc) (send-event proc 'mp-flip (-> evt payload axe-flip)))))))
  (none))

(defun mp-event-handler-mtn-dice ((evt mp-mtn-dice-event))
  (when (not (nonnull? evt))
    (return (the-as none 0)))
  (let ((aid (-> evt payload aid)))
    (log 'debug "[MP-Event-Handlers] Received MP_EVENT_MTN_DICE for aid=~D.~%" aid)
    (let ((ent (entity-by-aid aid)))
      (when (nonnull? ent (-> ent extra))
        (let ((proc (-> ent extra process)))
          (when (nonnull? proc)
            (send-event proc
                        'mp-attack
                        (-> evt payload rot-axis)
                        (-> evt payload rot-org)
                        (the-as int (-> evt payload prim-id))))))))
  (none))

(defun mp-event-handler-drill-egg ((aid uint))
  (let ((ent (entity-by-aid aid)))
    (when (and ent (nonzero? ent))
      (log 'debug "[MP-Event-Handlers] Received MP_EVENT_DRILL_EGG for aid=~D Entity: ~A~%" aid ent)
      (let ((perm (-> ent extra perm)))
        (when (and perm (nonzero? perm) (not (logtest? (-> perm status) (entity-perm-status dead subtask-complete))))
          (mp-mark-aid-dead-perm! aid)
          (logior! (-> perm status) (entity-perm-status dead subtask-complete))
          (let ((proc (-> ent extra process))) (when (and proc (nonzero? proc)) (send-event proc 'die)))))))
  (none))

(defun mp-close-local-fail-mission! ()
  (when (and *fail-mission-control* (nonzero? *fail-mission-control*))
    (let ((fail-proc (get-proc *fail-mission-control*)))
      (when (and fail-proc (nonzero? fail-proc))
        (log 'debug "[MP-Bootstrap] Closing local mission-failed prompt before load.~%")
        (when (= *master-mode* 'freeze)
          (set-master-mode 'game))
        (when (and *target* (nonzero? *target*))
          (process-release? *target*))
        (deactivate fail-proc)
        (set! (-> *fail-mission-control* process) (the-as handle #f)))))
  (none))

(defun mp-find-active-mission-task-manager ()
  (let ((found (the-as task-manager #f)))
    (when (and *task-manager-engine* (nonzero? *task-manager-engine*))
      (let ((task-link (the-as connection (-> *task-manager-engine* alive-list next0))))
        (while (and (not found) (!= task-link (-> *task-manager-engine* alive-list-end)))
          (let ((task-proc (the-as task-manager (-> task-link param1))))
            (when (and task-proc (nonzero? task-proc) (type? task-proc task-manager))
              (let ((info (-> task-proc info)))
                (when (and info (nonzero? info) (or (-> info retry-continue) (-> info fail-continue)))
                  (let ((next-st (-> task-proc next-state)))
                    (when (and next-st
                               (nonzero? next-st)
                               (let ((st-name (-> next-st name))) (or (= st-name 'active) (= st-name 'wait))))
                      (set! found task-proc)))))))
          (set! task-link (the-as connection (-> task-link next0))))))
    found))

(defun mp-apply-pending-mission-failed-choice! ()
  (when (not (mp-fail-mission-choice-event? *mp-mission-failed-pending-choice*))
    (return #f))
  (let ((choice *mp-mission-failed-pending-choice*)
        (fail-proc (get-proc *fail-mission-control*)))
    (when (or (mp-spectate-active?) (mp-spectate-requested?))
      (mp-death-spectate-abort!))
    (cond
      ((and fail-proc (nonzero? fail-proc))
       (when (mp-fail-mission-apply-choice! fail-proc choice)
         (log 'debug "[MP-Events] Applied host mission-failed choice to the native retry flow.~%")
         (set! *mp-mission-failed-pending-choice* (the uint 0))
         (return #t)))
      (else
       (let ((task-mgr (mp-find-active-mission-task-manager)))
         (when (and task-mgr (nonzero? task-mgr))
           (log 'debug "[MP-Events] Triggering local mission task-manager retry/fail: ~A~%" (-> task-mgr name))
           (let ((event-sym (if (= choice MP_EVENT_MISSION_FAILED_RETRY_YES) 'retry-immediately 'fail-immediately)))
             (send-event task-mgr event-sym)
             (set! *mp-mission-failed-pending-choice* (the uint 0))
             (return #t))))
       (log 'debug "[MP-Events] No fail-proc or task-manager found; falling back to initialize!~%")
       (initialize! *game-info*
                    (if (= choice MP_EVENT_MISSION_FAILED_RETRY_YES) 'try 'life)
                    (the-as game-save #f)
                    (the-as string #f))
       (set! *mp-mission-failed-pending-choice* (the uint 0))
       (return #t))))
  #f)

(defun mp-receive-mission-failed-choice ((evt mp-event))
  (when (and evt (nonzero? (the-as uint evt)))
    (let ((event-type (-> evt etype)))
      (cond
        ((not (mp-session-client?)) (none))
        ((!= (-> evt source-player-id) (mp-host-player-id))
         (log 'debug "[MP-Events] Rejected mission-failed choice from a non-host player.~%"))
        ((mp-fail-mission-choice-event? event-type)
         (set! *mp-mission-failed-pending-choice* event-type)
         (mp-apply-pending-mission-failed-choice!)))))
  (none))

(defun mp-receive-battle-event ((evt mp-battle-event))
  (when (not (nonnull? evt *mp-actor-name-event-name-scratch*))
    (return (the-as none 0)))
  (let ((battle-evt (-> evt payload battle-evt))
        (name-str *mp-actor-name-event-name-scratch*))
    (dotimes (i 32)
      (set! (-> name-str data i) (-> evt payload battle-name i)))
    (let ((len 0))
      (while (and (< len 31) (nonzero? (-> name-str data len)))
        (1+! len))
      (set! (-> name-str data -4) (the-as uint len)))
    (log 'debug
         "[MP-BattleEvent][~A][RECV] evt=~D battle=~S spawner=~D breed=~D initial=~D "
         (if (mp-session-host?) "HOST" "CLIENT")
         battle-evt
         name-str
         (-> evt payload spawner-index)
         (-> evt payload breed-index)
         (-> evt payload initial?))
    (log 'debug "aid=~D~%" (-> evt payload enemy-aid))
    (log 'debug
         "[MP-BattleEvent][~A][RECV] owner=~D epoch=~D local=~D aid=~D~%"
         (if (mp-session-host?) "HOST" "CLIENT")
         (-> evt payload owner-player-id)
         (-> evt payload epoch)
         (if (and (mp-local-player-record) (nonzero? (mp-local-player-record))) (-> (mp-local-player-record) identity player-id) -1)
         (-> evt payload enemy-aid))
    (mp-battle-receive-event! evt name-str))
  (none))

(defun mp-event-handler-hover-enemy-spawn ((evt mp-hover-enemy-spawn-event))
  (when (and (nonnull? evt)
             (mp-session-client?)
             (= (-> evt source-player-id) (mp-host-player-id))
             (nonzero? (-> evt payload manager-aid))
             (nonzero? (-> evt payload source-aid))
             (>= (-> evt payload enemy-aid) #x60000000)
             (< (-> evt payload enemy-aid) #x70000000))
    (mp-hover-enemy-apply-spawn! evt))
  (none))

(defun mp-receive-player-gun-shot-event ((evt mp-player-gun-shot-event))
  (when (not (nonnull? evt))
    (return (the-as none 0)))
  (player-replica-receive-gun-shot! (-> evt source-player-id) evt)
  (none))

(defun gungame-receive-target-broken! ((event gungame-target-broken-event))
  (when (and (nonnull? event *mp-player-controller*)
             (<= (-> event payload combo?) 1)
             (if (mp-session-host?)
               (!= (-> event source-player-id) (-> *mp-player-controller* host-player-id))
               (and (mp-session-client?) (= (-> event source-player-id) (-> *mp-player-controller* host-player-id)))))
    (let ((manager (process-by-type-exact 'training-manager *active-pool*)))
      (when (nonnull? manager)
        (send-event manager 'gungame-target-broken event))))
  (none))

(defun mp-store-city-shuttle-event ((evt mp-shuttle-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (when (> (-> evt payload sequence) *mp-shuttle-last-received-sequence*)
    (set! *mp-shuttle-pending?* #t)
    (set! *mp-shuttle-task-node* (-> evt payload task-node))
    (set! *mp-shuttle-sub-state* (-> evt payload sub-state))
    (set! *mp-shuttle-started?* (-> evt payload started?))
    (set! *mp-shuttle-time-limit* (-> evt payload time-limit))
    (set! *mp-shuttle-remaining-time* (-> evt payload remaining-time))
    (set! *mp-shuttle-counter* (-> evt payload counter))
    (set! *mp-shuttle-sequence* (-> evt payload sequence))
    (set! *mp-shuttle-last-received-sequence* (-> evt payload sequence)))
  (none))

(defun mp-log-mission-failed-bootstrap-wait ((reason string))
  (when (time-elapsed? *mp-mission-failed-bootstrap-next-log-time* (seconds 2))
    (log 'debug "[MP-Events] Waiting to request bootstrap: ~A.~%" reason)
    (set-time! *mp-mission-failed-bootstrap-next-log-time*))
  (none))

(defun mp-arm-mission-failed-bootstrap-after-spawn ()
  (when (and *mp-mission-failed-bootstrap-await-spawn?* (mp-session-host?) (mp-session-in-game?))
    (log 'debug "[MP-Events] Post-reload spawn observed. Bootstrap pending.~%")
    (set! *mp-mission-failed-bootstrap-await-spawn?* #f)
    (set! *mp-mission-failed-bootstrap-pending?* #t)
    (set-time! *mp-mission-failed-bootstrap-ready-time*)
    (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0)))
  (none))

(defun mp-request-mission-failed-bootstrap-when-ready ()
  (when *mp-mission-failed-bootstrap-pending?*
    (cond
      ((not (mp-session-host?))
       (set! *mp-mission-failed-bootstrap-pending?* #f)
       (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0)))
      ((and (mp-session-in-game?)
            (time-elapsed? *mp-mission-failed-bootstrap-ready-time* (seconds 1))
            *target*
            (-> *target* control)
            (not (focus-test? *target* teleporting))
            (not (and (-> *target* state) (= (-> *target* state name) 'target-load-wait)))
            (not (and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait)))
            *level*
            (nonzero? (the-as uint *level*))
            (= (-> *level* loading-level) (-> *level* default-level))
            (-> *game-info* current-continue))
       (log 'debug "[MP-Events] Host retry reload stable. Requesting bootstrap.~%")
       (pc-multi-request-bootstrap)
       (set! *mp-mission-failed-bootstrap-pending?* #f)
       (set! *mp-mission-failed-bootstrap-next-log-time* (the-as time-frame 0)))
      (else
       (cond
         ((not (mp-session-in-game?)) (mp-log-mission-failed-bootstrap-wait "network status is not IN_GAME"))
         ((not (time-elapsed? *mp-mission-failed-bootstrap-ready-time* (seconds 1)))
          (mp-log-mission-failed-bootstrap-wait "post-spawn delay has not elapsed"))
         ((not *target*) (mp-log-mission-failed-bootstrap-wait "target is missing"))
         ((not (-> *target* control)) (mp-log-mission-failed-bootstrap-wait "target control is missing"))
         ((focus-test? *target* teleporting) (mp-log-mission-failed-bootstrap-wait "target is teleporting"))
         ((and (-> *target* state) (= (-> *target* state name) 'target-load-wait))
          (mp-log-mission-failed-bootstrap-wait "target state is load-wait"))
         ((and (-> *target* next-state) (= (-> *target* next-state name) 'target-load-wait))
          (mp-log-mission-failed-bootstrap-wait "target next-state is load-wait"))
         ((or (not *level*) (zero? (the-as uint *level*))) (mp-log-mission-failed-bootstrap-wait "level is missing"))
         ((!= (-> *level* loading-level) (-> *level* default-level))
          (mp-log-mission-failed-bootstrap-wait "level is loading"))
         ((not (-> *game-info* current-continue)) (mp-log-mission-failed-bootstrap-wait "current continue is missing"))))))
  (none))

(defun mp-receive-fortress-robotank-trigger-event ((evt mp-robotank-trigger-event) (proc-name string))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (log 'debug
       "[MP-MissionEvent] Replaying fortress robotank trigger ~D for ~S~%"
       (the-as int (-> evt payload trigger-id))
       proc-name)
  (when (and *target* (nonzero? *target*))
    (let ((target-control (-> *target* control)))
      (when (and target-control (nonzero? target-control))
        (vector-copy! (-> target-control trans) (-> evt payload source-pos)))))
  (let ((proc (process-by-name proc-name *active-pool*)))
    (when proc
      (send-event proc 'trigger (the-as int (-> evt payload trigger-id)))))
  (none))

(defun mp-copy-mission-event-target-name! ((source-name (pointer uint8)) (name-str string))
  (when (nonnull? source-name name-str)
    (dotimes (i 31)
      (set! (-> name-str data i) (-> source-name i)))
    (set! (-> name-str data 31) (the uint 0))
    (let ((len 0))
      (while (and (< len 31) (nonzero? (-> name-str data len)))
        (1+! len))
      (set! (-> name-str data -4) (the-as uint len))))
  (none))

(defun mp-event-dispatch-actor-message! ((event mp-actor-name-event) (message symbol))
  (let ((name-string *mp-actor-name-event-name-scratch*))
    (when (nonnull? event name-string)
      (mp-copy-mission-event-target-name! (-> event payload name) name-string)
      (let ((proc (process-by-name name-string *active-pool*)))
        (when (nonnull? proc)
          (log 'debug "[MP-Event] Dispatching ~S to ~S.~%" message name-string)
          (send-event proc message)))))
  (none))

(defun mp-event-handle-stadium-board1! ((evt mp-stadium-board1-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((source-player-id (-> evt source-player-id))
        (manager (process-by-type-exact 'hoverboard-training-manager *active-pool*)))
    (log 'debug
         "[Event-Handler] Received event ~D from player ~D. Score: ~D~%"
         (-> evt etype)
         source-player-id
         (-> evt payload score))
    (when (and manager (nonzero? manager))
      (case (-> evt etype)
        ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START) (send-event manager 'challenge-start source-player-id))
        ((MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE)
         (send-event manager 'score-update source-player-id (the int (-> evt payload score))))
        ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END)
         (send-event manager 'challenge-end source-player-id (the int (-> evt payload score))))
        ((MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP) (send-event manager 'notify 'pickup)))))
  (none))

(defun mp-event-handle-mission! ((evt mp-event))
  (let ((event-type (-> evt etype)))
    (log 'debug "[MP-Event] Received mission event ~D.~%" event-type)
    (case event-type
      ((MP_EVENT_MISSION_LEAVE) (mp-event-dispatch-actor-message! (the-as mp-actor-name-event evt) 'leave))
      ((MP_EVENT_MISSION_PLAY_SCENE) (mp-event-dispatch-actor-message! (the-as mp-actor-name-event evt) 'play-scene))
      ((MP_EVENT_MISSION_FAILED_RETRY_YES) (mp-receive-mission-failed-choice evt))
      ((MP_EVENT_MISSION_FAILED_RETRY_NO) (mp-receive-mission-failed-choice evt))
      ((MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER)
       (let ((robotank-event (the-as mp-robotank-trigger-event evt))
             (name-string *mp-actor-name-event-name-scratch*))
         (when (nonnull? robotank-event name-string)
           (mp-copy-mission-event-target-name! (-> robotank-event payload target-name) name-string)
           (mp-receive-fortress-robotank-trigger-event robotank-event name-string))))
      ((MP_EVENT_MISSION_GUNGAME_TARGET_BROKEN)
       (gungame-receive-target-broken! (the-as gungame-target-broken-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP)
       (mp-event-handle-stadium-board1! (the-as mp-stadium-board1-event evt)))
      ((MP_EVENT_MISSION_KREW_COLLECTION_PICKUP)
       (let ((bag-index (-> (the-as mp-krew-collection-event evt) payload)))
         (when (and (< bag-index (the uint32 32))
                    (not (logtest? *mp-krew-collection-consumed-mask* (the-as uint (ash 1 bag-index)))))
           (set! *mp-krew-collection-picked-mask*
                 (logior *mp-krew-collection-picked-mask* (the-as uint (ash 1 bag-index)))))))
      ((MP_EVENT_MISSION_CITY_SHUTTLE_STATE) (mp-store-city-shuttle-event (the-as mp-shuttle-event evt)))
      ((MP_EVENT_MISSION_CITY_POWER_TURRET_STATE)
       (let ((power-evt (the-as mp-city-power-event evt)))
         (when (and (< (-> power-evt payload turret-id) (the uint32 5))
                    (or (= (-> power-evt payload state) (the uint32 1)) (= (-> power-evt payload state) (the uint32 2))))
           (set! *mp-city-power-turret-id* (the-as uint (-> power-evt payload turret-id)))
           (set! *mp-city-power-state* (the-as uint (-> power-evt payload state)))
           (vector-copy! *mp-city-power-source-pos* (-> power-evt payload source-pos))
           (case (-> power-evt payload turret-id)
             ((0)
              (set! *mp-city-power-state-0* (the-as uint (-> power-evt payload state)))
              (logior! *mp-city-power-pending-mask* (the uint 1)))
             ((1)
              (set! *mp-city-power-state-1* (the-as uint (-> power-evt payload state)))
              (logior! *mp-city-power-pending-mask* (the uint 2)))
             ((2)
              (set! *mp-city-power-state-2* (the-as uint (-> power-evt payload state)))
              (logior! *mp-city-power-pending-mask* (the uint 4)))
             ((3)
              (set! *mp-city-power-state-3* (the-as uint (-> power-evt payload state)))
              (logior! *mp-city-power-pending-mask* (the uint 8)))
             ((4)
              (set! *mp-city-power-state-4* (the-as uint (-> power-evt payload state)))
              (logior! *mp-city-power-pending-mask* (the uint 16))))
           (set! *mp-city-power-pending?* #t))))
      ((MP_EVENT_MISSION_TOMB_BOULDER_COMPLETE) (mp-tomb-boulder-receive-completion!))
      ((MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START) (mp-tomb-daxter-wait-receive-start! (-> evt source-player-id)))
      ((MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END) (mp-tomb-daxter-wait-receive-end! (-> evt source-player-id)))
      (else (log 'debug "[MP-Event] Unknown mission event ~D.~%" event-type))))
  (none))

(defun mp-resolve-edge-grab-handle ((actor-id uint) (actor-kind uint))
  (case actor-kind
    ((1)
     (let ((ent (entity-by-aid actor-id)))
       (when (and ent
                  (nonzero? ent)
                  (-> ent extra)
                  (nonzero? (-> ent extra))
                  (-> ent extra process)
                  (nonzero? (-> ent extra process)))
         (return (process->handle (-> ent extra process))))))
    ((2)
     (let ((veh (mp-vehicle-find-by-net-id actor-id))) (when (and veh (nonzero? veh)) (return (process->handle veh)))))
    ((3)
     (let ((ped (mp-pedestrian-find-by-net-id actor-id)))
       (when (and ped (nonzero? ped))
         (return (process->handle ped))))))
  (the-as handle #f))

(defun mp-unpack-edge-grab-info ((dst edge-grab-info) (src edge-grab-state-event-data))
  (when (nonnull? dst src)
    (set! (-> dst actor-cshape-prim-offset) 0)
    (set! (-> dst actor-handle) (the-as handle #f))
    (cond
      ((> (-> src pilot-edge-grab-bool) 0)
       (set! (-> dst pilot-edge-grab?)
             (case (-> src pilot-edge-grab-bool)
               ((1) 'target-jump)
               ((2) 'target-double-jump)
               (else #t)))
       (vector-copy! (-> dst pilot-edge-grab local-pos) (-> src pilot-local-pos))
       (vector-copy! (-> dst pilot-edge-grab local-dir) (-> src pilot-local-dir))
       (set! (-> dst pilot-edge-grab handle)
             (mp-resolve-edge-grab-handle (-> src pilot-actor-id) (-> src pilot-actor-kind)))
       (vector-copy! (-> dst pilot-start-grab-pos) (-> src pilot-start-grab-pos))
       (set! (-> dst pilot-grab-interp) (-> src pilot-grab-interp)))
      (else
       (set! (-> dst pilot-edge-grab?) #f)
       (vector-copy! (-> dst center-hold) (-> src center-hold))
       (vector+! (-> dst edge-vertex 0) (-> src center-hold) (-> src edge-dir))
       (vector-copy! (-> dst edge-vertex 1) (-> src center-hold))
       (set! (-> dst edge-tri-pat) (-> src edge-tri-pat)))))
  (none))

(defun mp-pilot-edge-grab-ready? ((info edge-grab-info))
  (when (and (nonnull? info) (-> info pilot-edge-grab?))
    (let ((pilot-proc (handle->process-safe (-> info pilot-edge-grab handle))))
      (when (and (nonnull? pilot-proc) (type? pilot-proc process-drawable))
        (return #t))))
  #f)

(defun mp-standard-edge-grab-ready? ((info edge-grab-info) (src edge-grab-state-event-data))
  (nonnull? info src))

(defun mp-edge-grab-ready? ((info edge-grab-info) (src edge-grab-state-event-data) (pilot? symbol))
  (if pilot? (mp-pilot-edge-grab-ready? info) (mp-standard-edge-grab-ready? info src)))

(defun mp-clear-target-edge-grab-pending! ((target target))
  (when (nonnull? target)
    (let ((edge-state (-> target edge-grab-state)))
      (mem-set32! (the-as pointer (-> edge-state pending-data)) (/ (+ (size-of edge-grab-state-event-data) 3) 4) 0)
      (set! (-> edge-state pending?) #f)
      (set! (-> edge-state pending-pilot?) #f)
      (set! (-> edge-state pending-time) 0)))
  (none))

(defun mp-store-pending-edge-grab! ((target target) (evt mp-event) (pilot? symbol))
  (when (nonnull? target evt)
    (let ((edge-state (-> target edge-grab-state))
          (src (the-as edge-grab-state-event-data (-> evt data))))
      (mem-copy! (the-as pointer (-> edge-state pending-data))
                 (the-as pointer src)
                 (the-as int (mp-event-payload-size (-> evt etype))))
      (set! (-> edge-state pending?) #t)
      (set! (-> edge-state pending-pilot?) pilot?)
      (set! (-> edge-state pending-time) (current-time))))
  (none))

(defun mp-dispatch-edge-grab-to-target! ((target target) (pilot? symbol))
  (when (and target (nonzero? target))
    (let ((control (-> target control)))
      (when (and control (nonzero? control))
        (set! (-> control last-successful-compute-edge-time) (current-time)))
      (send-event target (if pilot? 'mp-edge-grab-pilot 'mp-edge-grab))))
  (none))

(defun mp-process-pending-edge-grab! ((target target))
  (when (and target (nonzero? target))
    (let ((edge-state (-> target edge-grab-state)))
      (when (-> edge-state pending?)
        (if (time-elapsed? (-> edge-state pending-time) (seconds 1.0))
          (begin
            (log 'debug
                 "[MP-Events] Discarding unresolved edge grab after timeout. (Pilot: ~A)~%"
                 (-> edge-state pending-pilot?))
            (mp-clear-target-edge-grab-pending! target))
          (let ((edge-info (-> edge-state info))
                (src (-> edge-state pending-data))
                (pilot? (-> edge-state pending-pilot?)))
            (mp-unpack-edge-grab-info edge-info src)
            (when (mp-edge-grab-ready? edge-info src pilot?)
              (mp-clear-target-edge-grab-pending! target)
              (mp-dispatch-edge-grab-to-target! target pilot?)))))))
  (none))

(defun mp-receive-edge-grab-event ((target target) (evt mp-event) (pilot? symbol))
  (when (and target (nonzero? target) evt (nonzero? evt))
    (log 'debug "[MP-Events] Authoritative Edge Grab received! (Pilot: ~A)~%" pilot?)
    (let ((edge-state (-> target edge-grab-state))
          (src (the-as edge-grab-state-event-data (-> evt data))))
      (let ((edge-info (-> edge-state info)))
        (mp-unpack-edge-grab-info edge-info src)
        (if (mp-edge-grab-ready? edge-info src pilot?)
          (begin
            (mp-clear-target-edge-grab-pending! target)
            (mp-dispatch-edge-grab-to-target! target pilot?))
          (begin
            (log 'debug "[MP-Events] Edge grab queued until actor resolves. (Pilot: ~A)~%" pilot?)
            (mp-store-pending-edge-grab! target evt pilot?))))))
  (none))

(defun mp-receive-pole-grab-event ((evt mp-aid-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((replica (mp-player-target-by-id (-> evt source-player-id)))
        (ent (entity-by-aid (-> evt payload aid))))
    (when (and replica ent (nonzero? ent))
      (let ((pole-proc (-> ent extra process)))
        (when (and pole-proc (nonzero? pole-proc))
          (let ((pole-handle (process->handle pole-proc)))
            (when (not (and (focus-test? replica pole) (= (-> replica control anim-handle) pole-handle)))
              (send-event pole-proc 'mp-pole-grab (process->handle replica))
              (send-event replica 'mp-pole-grab pole-handle)))))))
  (none))

(defun mp-receive-continue-event ((evt mp-continue-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((s* *mp-scene-name-scratch*))
    (dotimes (i 32)
      (set! (-> s* data i) (-> evt payload name i)))
    (set! (-> s* data 31) (the uint 0))
    (let ((len 0))
      (while (and (< len 32) (nonzero? (-> s* data len)))
        (+! len 1))
      (set! (-> s* data -4) (the-as uint len)))
    (if (mp-tomb-boulder-ignore-remote-continue? s*)
      (log 'debug "[MP-TombBoulder] Ignoring role-incompatible continue: ~S~%" s*)
      (begin
        (log 'debug "[MP-WorldEvent] Remote hit continue point: ~S~%" s*)
        (let ((len (min 31 (length s*))))
          (dotimes (i len)
            (set! (-> *mp-last-local-continue-name* data i) (-> s* data i)))
          (set! (-> *mp-last-local-continue-name* data len) (the uint 0))
          (set! (-> *mp-last-local-continue-name* data -4) (the-as uint len)))
        (set-continue! *game-info* s* #t))))
  (none))

(defun mp-event-handle-scene! ((evt mp-scene-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((event-type (-> evt etype))
        (len 0))
    (dotimes (i 32)
      (set! (-> *mp-scene-name-scratch* data i) (-> evt payload scene-name i)))
    (set! (-> *mp-scene-name-scratch* data 31) (the uint 0))
    (while (and (< len 31) (nonzero? (-> *mp-scene-name-scratch* data len)))
      (+! len 1))
    (set! (-> *mp-scene-name-scratch* data -4) (the-as uint len))
    (log 'debug "[MP-Event] Scene event=~D name=~S.~%" event-type *mp-scene-name-scratch*)
    (case event-type
      ((MP_EVENT_SCENE_START) (mp-event-handler-scene-start evt))
      ((MP_EVENT_SCENE_REQUEST_SKIP) (mp-event-handler-scene-request-skip evt))
      ((MP_EVENT_SCENE_SKIPPED) (mp-event-handler-scene-skipped evt))
      (else (log 'debug "[MP-Event] Unknown scene event ~D.~%" event-type))))
  (none))

(defun mp-receive-waypoint-event ((evt mp-waypoint-event) (snapshot? symbol))
  (mp-waypoint-apply-remote-event! evt snapshot?)
  (none))

(defun mp-receive-warp-gate-event ((evt mp-warp-gate-event))
  (mp-warp-gate-apply-remote-event! evt)
  (none))

(defun mp-receive-widow-bomb-kick-event ((evt mp-widow-bomb-kick-event))
  (mp-widow-bomb-apply-kick-event! evt)
  (none))

(defun mp-receive-widow-bomb-fizzle-event ((evt mp-widow-bomb-fizzle-event))
  (mp-widow-bomb-apply-fizzle-event! evt)
  (none))

(defun mp-receive-widow-spydroid-event ((evt mp-widow-spydroid-event))
  (mp-widow-apply-spydroid-event! evt)
  (none))

(defun mp-receive-widow-bomb-event ((evt mp-widow-bomb-event))
  (mp-widow-apply-bomb-event! evt)
  (none))

(defun mp-receive-widow-bomb-hit-event ((evt mp-widow-bomb-hit-event))
  (mp-widow-apply-bomb-hit-event! evt)
  (none))

(defun mp-receive-widow-catwalk-hit-event ((evt mp-widow-catwalk-hit-event))
  (mp-widow-apply-catwalk-hit-event! evt)
  (none))

(defun mp-receive-palace-squid-event ((evt mp-palace-squid-event))
  (unless (nonnull? evt)
    (return (the-as none 0)))
  (let ((squid-proc (process-by-type-exact 'squid *active-pool*)))
    (when (and squid-proc (nonzero? squid-proc))
      (case (-> evt payload squid-evt)
        ((MP_PALACE_SQUID_EVT_HIT_REQUEST)
         (send-event squid-proc
                     'mp-hit-request
                     (-> evt source-player-id)
                     (-> evt payload sequence)
                     (-> evt payload param0)
                     (-> evt payload param1)))
        ((MP_PALACE_SQUID_EVT_GRENADE)
         (send-event squid-proc
                     'mp-grenade
                     (-> evt payload sequence)
                     (-> evt payload param0)
                     (-> evt payload param1)
                     (-> evt payload target-position x)
                     (-> evt payload target-position y)
                     (-> evt payload target-position z)))
        ((MP_PALACE_SQUID_EVT_WHIRLWIND) (send-event squid-proc 'mp-whirlwind (-> evt payload sequence)))
        ((MP_PALACE_SQUID_EVT_RESOLUTION) (send-event squid-proc 'mp-resolution (-> evt payload sequence))))))
  (none))

(defun mp-event-dispatch! ((evt mp-event))
  (let ((saved-remote-context *mp-processing-remote-event*)
        (saved-event-source *mp-current-event-source-player-id*))
    (cond
      ((not (nonnull? evt)) (log 'debug "[MP-Event] Dropped null event.~%"))
      ((not (mp-event-known? (-> evt etype))) (log 'debug "[MP-Event] Dropped unknown event ID ~D.~%" (-> evt etype)))
      ((!= (-> evt payload-size) (mp-event-payload-size (-> evt etype)))
       (log 'debug "[MP-Event] Dropped event ID ~D with invalid size ~D.~%" (-> evt etype) (-> evt payload-size)))
      ((not (mp-player-controller-record *mp-player-controller* (-> evt source-player-id)))
       (log 'debug "[MP-Event] Dropped event ~D from vacant player ~D.~%" (-> evt etype) (-> evt source-player-id)))
      (else
       (set! *mp-processing-remote-event* #t)
       (set! *mp-current-event-source-player-id* (-> evt source-player-id))
       (let ((source-record (mp-player-controller-record *mp-player-controller* (-> evt source-player-id))))
         (mp-event-route! evt source-record))))
    (set! *mp-processing-remote-event* saved-remote-context)
    (set! *mp-current-event-source-player-id* saved-event-source)
    (none)))
