;;-*-Lisp-*-
(in-package goal)

(defconstant MP_EVENT_QUEUE_CAPACITY (the int 64))
(defconstant MP_EVENT_QUEUE_WORDS (the int 20))

(define-perm *mp-event-queue* (inline-array mp-event) (new 'static 'inline-array mp-event 64))
(define-perm *mp-event-queue-write-ptr* int 0)
(define-perm *mp-event-queue-read-ptr* int 0)
(define-perm *mp-event-queue-count* int 0)

(defun mp-event-copy! ((destination mp-event) (source mp-event))
  (when (and (nonnull? destination source))
    (dotimes (word-index MP_EVENT_QUEUE_WORDS)
      (set! (-> (the-as (pointer uint32) destination) word-index) (-> (the-as (pointer uint32) source) word-index)))
    (return #t))
  #f)

(defun mp-event-prepare! ((event mp-event) (event-type uint))
  (when (and (nonnull? event) (mp-event-known? event-type))
    (mem-set32! (the-as pointer event) MP_EVENT_QUEUE_WORDS 0)
    (set! (-> event etype) (the-as uint8 event-type))
    (set! (-> event payload-size) (mp-event-payload-size event-type))
    (log 'debug "[MP-EventQueue] Succesfully prepared event id=~D.~%" (-> event etype))
    (return #t))
  (log 'debug "[MP-EventQueue] Failed to prepare event id=~D.~%" event-type)
  #f)

(defun mp-event-queue-full? ()
  (>= *mp-event-queue-count* 64))

(defun mp-event-queue-reset! ()
  (set! *mp-event-queue-write-ptr* 0)
  (set! *mp-event-queue-read-ptr* 0)
  (set! *mp-event-queue-count* 0)
  (when (nonnull? *mp-event-queue*)
    (mem-set32! (the-as pointer *mp-event-queue*) (* MP_EVENT_QUEUE_CAPACITY MP_EVENT_QUEUE_WORDS) 0))
  (none))

(defun mp-event-enqueue! ((event mp-event))
  (cond
    ((not (nonnull? event)) (log 'debug "[MP-EventQueue] Rejected null event.~%") #f)
    ((not (mp-event-known? (-> event etype)))
     (log 'debug "[MP-EventQueue] Rejected unknown event ID ~D.~%" (-> event etype))
     #f)
    ((!= (-> event payload-size) (mp-event-payload-size (-> event etype)))
     (log 'debug "[MP-EventQueue] Rejected event ID ~D with invalid size ~D.~%" (-> event etype) (-> event payload-size))
     #f)
    ((not (mp-session-in-game?)) #f)
    ((mp-event-queue-full?)
     (log 'debug "[MP-EventQueue] Queue full; dropping newest event ID ~D.~%" (-> event etype))
     #f)
    (else
     (let ((destination (the-as mp-event (-> *mp-event-queue* *mp-event-queue-write-ptr*))))
       (if (mp-event-copy! destination event)
         (begin
           (set! *mp-event-queue-write-ptr* (logand (+ *mp-event-queue-write-ptr* 1) 63))
           (+! *mp-event-queue-count* 1)
           (log 'debug "[MP-EventQueue] Enqueued event id=~D.~%" (-> event etype))
           #t)
         (begin
           (log 'debug "[MP-EventQueue] Failed to enque event id=~D.~%" (-> event etype))
           #f))))))

(defun mp-push-local-events ()
  (when (and (nonnull? *mp-event-buffer*) (zero? (-> *mp-event-buffer* out-count)))
    (let ((out-index 0))
      (while (and (> *mp-event-queue-count* 0) (< out-index 64))
        (let ((source (the-as mp-event (-> *mp-event-queue* *mp-event-queue-read-ptr*)))
              (destination (-> *mp-event-buffer* out-events out-index)))
          (mp-event-copy! destination source))
        (set! *mp-event-queue-read-ptr* (logand (+ *mp-event-queue-read-ptr* 1) 63))
        (-! *mp-event-queue-count* 1)
        (+! out-index 1))
      (set! (-> *mp-event-buffer* out-count) (the-as uint8 out-index))))
  (none))
