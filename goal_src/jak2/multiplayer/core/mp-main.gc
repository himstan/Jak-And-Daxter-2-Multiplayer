;;-*-Lisp-*-
(in-package goal)

(define-extern mp-reset-boss-sync-state! (function none))

(defun multiplayer-network-tick ()
  "Compatibility wrapper for the multiplayer network sync window."
  (mp-network-sync-window-tick)
  (none))

(defun mp-reset-state ()
  "Reset all multiplayer flags, buffers, and singletons to their default state."
  (mp-reset-session-state!)
  (mp-reset-event-state!)
  (mp-reset-scene-sync-state!)
  (mp-reset-player-sync-state!)
  (mp-reset-enemy-state!)
  (mp-reset-traffic-state!)
  (mp-reset-airlock-state!)
  (mp-reset-waypoint-state!)
  (mp-reset-puppet-state!)
  (mp-reset-remote-marker-state!)
  (mp-reset-environment-sync)
  (debug-log *mp-debug-log?* "[MP] State has been fully reset.~%")
  (none)
  )
