;;-*-Lisp-*-
(in-package goal)

(deftype main-multiplayer-manager (process) ()
  (:state-methods
   active)
  (:methods
   (mp-main-update! (_type_) symbol)))

(defmethod mp-main-update! ((this main-multiplayer-manager))
  (mp-session-tick)
  (let ((status (pc-multi-get-session-status)))
    (mp-update-synchronized-gameplay-state!)
    (when (= status (mp-connection-status in-game))
      (mp-sync-scene-tick)
      (mp-apply-synchronized-gameplay-state!))
    (mp-player-list-update!)
    (mp-draw-level-debug)
    (when (= status (mp-connection-status in-game))
      (mp-debug-draw-synced-tick)))
  #t)

(defstate active (main-multiplayer-manager)
  :virtual #t
  :code
    (behavior ()
      (until #f
        (mp-main-update! self)
        (suspend))
      #f))

(defbehavior mp-main-init main-multiplayer-manager ()
  (change-to-last-brother self)
  (go-virtual active)
  (none))

(defun mp-main-start! ()
  (when (and *active-pool* (nonzero? *active-pool*) *mid-pool* (nonzero? *mid-pool*))
    (let ((main-process (process-by-type-exact 'main-multiplayer-manager *active-pool*)))
      (when (not (and main-process (nonzero? main-process)))
        (process-spawn main-multiplayer-manager :init mp-main-init :to *mid-pool*))))
  (none))

(mp-main-start!)
