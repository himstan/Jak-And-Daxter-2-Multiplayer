;;-*-Lisp-*-
(in-package goal)

(defun mp-network-status-ready? ((status mp-connection-status))
  (if (< status (mp-connection-status connecting))
      (begin
        (when *multi-sync-enabled?*
          (debug-log *mp-debug-log?* "[MP-Network] Return Early: Status ~D, SyncEnabled? ~A~%" status *multi-sync-enabled?*)
          )
        #f
        )
      #t
      )
  )

(defun mp-local-frame-target-ready? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting)))
  )

(defun mp-network-log-active-sync! ((status mp-connection-status) (role mp-session-role))
  (when (and (mp-local-player-record)
             (nonzero? (the-as uint (mp-local-player-record)))
             (>= (- (current-time) *multi-last-sync-frame*) (seconds 5)))
    (debug-log *mp-debug-log?* "[MP-Network] Active and Syncing! (Status ~D, Role ~D, SyncFlag ~D)~%"
            status
            role
            (-> *mp-bootstrap-state* phase))
    (set! *multi-last-sync-frame* (current-time))
    )
  (none))

(defun mp-network-pack-local-frame! ((status mp-connection-status))
  (when (and (mp-local-player-record)
             (nonzero? (the-as uint (mp-local-player-record))))
    (mp-pack-local-player-name!)
    (let ((role *mp-session-role*))
      (when (and (= status (mp-connection-status in-game))
                 (or (mp-session-host?) *multi-sync-enabled?*))
        (mp-extract-environment-state)
        (when (and (mp-local-frame-target-ready?)
                   (= (-> (mp-local-player-record) identity spectator-only?) 0))
          (mp-network-log-active-sync! status role)
          (mp-extract-local-data)
          (mp-push-local-events)
          )
        )
      )
    )
  (none))

(defun mp-local-state-send-tick ()
  (when (and (mp-local-player-record)
             (nonzero? (the-as uint (mp-local-player-record))))
    (pc-multi-send-sync
      (the-as uint *mp-player-controller*)
      (the-as uint *mp-world-state*)
      (the-as uint *mp-bootstrap-state*))
    )
  (none))

(defun mp-event-send-tick ()
  (when (and *mp-event-buffer*
             (nonzero? (the-as uint *mp-event-buffer*)))
    (pc-multi-send-events (the-as uint *mp-event-buffer*))
    )
  (none))

(defun mp-airlock-send-tick ()
  (mp-airlock-sync-tick)
  (none))

(defun mp-enemy-send-tick ()
  (when (and *mp-enemy-buffer*
             (nonzero? (the-as uint *mp-enemy-buffer*)))
    (pc-multi-send-enemies (the-as uint *mp-enemy-buffer*))
    )
  (none))

(defun mp-traffic-send-tick ()
  (when (and (mp-is-traffic-authoritative?)
             *mp-traffic-buffer*
             (nonzero? (the-as uint *mp-traffic-buffer*)))
    (pc-multi-send-traffic (the-as uint *mp-traffic-buffer*))
    )
  (none))

(defun mp-network-sync-window-tick ((gameplay-ready? object))
  "Send session identity/state before remote readiness and gameplay payloads after it."
  (let ((status (pc-multi-get-status)))
    (if (not (mp-network-status-ready? status))
        (return #f))
    (mp-network-pack-local-frame! status)
    (mp-local-state-send-tick)
    (when gameplay-ready?
      (mp-event-send-tick)
      (mp-airlock-send-tick)
      (mp-enemy-send-tick)
      (mp-traffic-send-tick)
      )
    (pc-multi-flush-packet-window)
    )
  (none))
