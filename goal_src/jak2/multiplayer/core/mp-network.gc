;;-*-Lisp-*-
(in-package goal)

(defun mp-network-status-ready? ((status mp-connection-status))
  (if (< status (mp-connection-status connecting)) #f #t))

(defun mp-local-frame-target-ready? ()
  (and (nonnull? *target* (-> *target* control)) (not (focus-test? *target* teleporting))))

(defun mp-network-pack-local-frame! ((status mp-connection-status))
  (let ((local-record (mp-local-player-record)))
    (when (nonnull? local-record)
      (mp-pack-local-player-name!)
      (when (= status (mp-connection-status in-game))
        (mp-extract-environment-state)
        (when (and (mp-local-frame-target-ready?) (= (-> local-record identity spectator-only?) 0))
          (mp-extract-local-data))
        (mp-push-local-events))))
  (none))

(defun mp-network-copy-player-identity-to-replication! ((destination mp-replication-player-identity)
                                                        (source mp-player-identity))
  (when (nonnull? destination source)
    (mem-copy! (the-as pointer (-> destination skin)) (the-as pointer (-> source skin)) (size-of mp-player-skin))
    (mem-copy! (the-as pointer (-> destination name)) (the-as pointer (-> source name)) MP_PLAYER_NAME_SIZE)
    (set! (-> destination player-id) (-> source player-id))
    (set! (-> destination character) (the-as uint8 (-> source character)))
    (set! (-> destination identity-ready?) (-> source identity-ready?))
    (set! (-> destination state-ready?) (-> source state-ready?))
    (set! (-> destination joined?) (-> source joined?))
    (set! (-> destination spectator-only?) (-> source spectator-only?))
    (set! (-> destination lobby-ready?) (-> source lobby-ready?)))
  (none))

(defun mp-network-copy-player-identity-from-replication! ((destination mp-player-identity)
                                                          (source mp-replication-player-identity))
  (when (nonnull? destination source)
    (mem-copy! (the-as pointer (-> destination skin)) (the-as pointer (-> source skin)) (size-of mp-player-skin))
    (mem-copy! (the-as pointer (-> destination name)) (the-as pointer (-> source name)) MP_PLAYER_NAME_SIZE)
    (set! (-> destination player-id) (-> source player-id))
    (set! (-> destination character) (the-as mp-player-character (-> source character)))
    (set! (-> destination identity-ready?) (-> source identity-ready?))
    (set! (-> destination state-ready?) (-> source state-ready?))
    (set! (-> destination joined?) (-> source joined?))
    (set! (-> destination spectator-only?) (-> source spectator-only?))
    (set! (-> destination lobby-ready?) (-> source lobby-ready?)))
  (none))

(defun mp-network-copy-player-to-replication! ((destination mp-replication-player) (source mp-player-record))
  (when (nonnull? destination source)
    (mp-network-copy-player-identity-to-replication! (-> destination identity) (-> source identity))
    (vector-copy! (-> destination transform position) (-> source transform position))
    (vector-copy! (-> destination transform velocity) (-> source transform velocity))
    (vector-copy! (-> destination presentation-position) (-> source transform position))
    (vector-copy! (-> destination presentation-velocity) (-> source transform velocity))
    (set! (-> destination transform angle) (-> source transform angle))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (set! (-> destination transform levels idx level-id) (-> source transform levels idx level-id))
      (set! (-> destination transform levels idx flags) (-> source transform levels idx flags)))
    (set! (-> destination action target-state-id) (-> source action target-state-id))
    (set! (-> destination action authoritative-sequence) (-> source action authoritative-sequence))
    (set! (-> destination action action-state-id) (-> source action action-state-id))
    (set! (-> destination action darkjak-stage) (the-as uint8 (-> source action darkjak-stage)))
    (set! (-> destination action scene-state) (-> source action scene-state))
    (set! (-> destination action respawn-flags) (-> source action respawn-flags))
    (set! (-> destination action hit-invulnerable?) (-> source action hit-invulnerable?))
    (set! (-> destination action riding-along-player-id) (-> source action riding-along-player-id))
    (set! (-> destination action visual-secrets) (the-as uint8 (-> source action visual-secrets)))
    (set! (-> destination input camera-angle-y) (-> source input camera-angle-y))
    (set! (-> destination input buttons) (-> source input buttons))
    (set! (-> destination input leftx) (-> source input leftx))
    (set! (-> destination input lefty) (-> source input lefty))
    (set! (-> destination input equipped-weapon) (-> source input equipped-weapon))
    (mem-copy! (the-as pointer (-> destination vehicle state))
               (the-as pointer (-> source vehicle state))
               (size-of mp-vehicle-state))
    (set! (-> destination vehicle vehicle-id) (-> source vehicle vehicle-id))
    (set! (-> destination vehicle turret-roty) (-> source vehicle turret-roty))
    (set! (-> destination vehicle turret-rotx) (-> source vehicle turret-rotx))
    (set! (-> destination vehicle seat-index) (-> source vehicle seat-index))
    (set! (-> destination vehicle turret-active) (-> source vehicle turret-active?))
    (set! (-> destination activity) (-> source connection activity))
    (set! (-> destination valid?) (-> source connection state-cached?))
    (set! (-> destination mission-flags) (the-as uint8 (-> source runtime mission-flags))))
  (none))

(defun mp-network-copy-player-from-replication! ((destination mp-player-record)
                                                 (source mp-replication-player)
                                                 (notify-joins? symbol))
  (local-vars (joining? symbol))
  (when (nonnull? destination source)
    (set! joining?
          (and (nonzero? (-> source identity joined?))
               (or (zero? (-> destination identity joined?))
                   (!= (-> destination connection lifecycle-generation) (-> source lifecycle-generation)))))
    (when (!= (-> destination connection lifecycle-generation) (-> source lifecycle-generation))
      (let ((previous-player-id (the uint (-> destination identity player-id))))
        (if (and (nonzero? (-> destination identity joined?)) (mp-player-id-valid? previous-player-id))
          (begin
            (notify-player! previous-player-id
                            (if (= (-> source departure-reason) (player-departure-reason timed-out))
                              (text-id notification-player-timed-out)
                              (text-id notification-player-left)))
            (reassign-player-owned-enemies previous-player-id)
            (mp-player-controller-release-slot! *mp-player-controller* previous-player-id))
          (reset-player-replica-state! destination)))
      (set! (-> destination connection lifecycle-generation) (-> source lifecycle-generation)))
    (let ((previous-character (-> destination identity character)))
      (mp-network-copy-player-identity-from-replication! (-> destination identity) (-> source identity))
      (let ((character (-> destination identity character)))
        (set! (-> destination identity character) previous-character)
        (apply-player-character-change! destination character)))
    (when (and joining? notify-joins?)
      (notify-player! (the uint (-> destination identity player-id)) (text-id notification-player-joined)))
    (vector-copy! (-> destination transform position) (-> source presentation-position))
    (vector-copy! (-> destination transform velocity) (-> source presentation-velocity))
    (vector-copy! (-> destination runtime presentation-position) (-> source presentation-position))
    (quaternion-copy! (-> destination runtime presentation-quaternion) (-> source presentation-quaternion))
    (set! (-> destination transform angle) (-> source transform angle))
    (dotimes (idx MP_PLAYER_LEVEL_SLOT_COUNT)
      (set! (-> destination transform levels idx level-id) (-> source transform levels idx level-id))
      (set! (-> destination transform levels idx flags) (-> source transform levels idx flags)))
    (set! (-> destination action target-state-id) (-> source action target-state-id))
    (set! (-> destination action authoritative-sequence) (-> source action authoritative-sequence))
    (set! (-> destination action action-state-id) (-> source action action-state-id))
    (set! (-> destination action darkjak-stage) (the-as uint32 (-> source action darkjak-stage)))
    (set! (-> destination action scene-state) (-> source action scene-state))
    (set! (-> destination action respawn-flags) (-> source action respawn-flags))
    (set! (-> destination action hit-invulnerable?) (-> source action hit-invulnerable?))
    (set! (-> destination action riding-along-player-id) (-> source action riding-along-player-id))
    (set! (-> destination action visual-secrets) (the-as mp-player-visual-secrets (-> source action visual-secrets)))
    (set! (-> destination input camera-angle-y) (-> source input camera-angle-y))
    (set! (-> destination input buttons) (-> source input buttons))
    (set! (-> destination input leftx) (-> source input leftx))
    (set! (-> destination input lefty) (-> source input lefty))
    (set! (-> destination input equipped-weapon) (-> source input equipped-weapon))
    (mem-copy! (the-as pointer (-> destination vehicle state))
               (the-as pointer (-> source vehicle state))
               (size-of mp-vehicle-state))
    (set! (-> destination vehicle vehicle-id) (-> source vehicle vehicle-id))
    (set! (-> destination vehicle turret-roty) (-> source vehicle turret-roty))
    (set! (-> destination vehicle turret-rotx) (-> source vehicle turret-rotx))
    (set! (-> destination vehicle seat-index) (-> source vehicle seat-index))
    (set! (-> destination vehicle turret-active?) (-> source vehicle turret-active))
    (set! (-> destination connection activity-changed?)
          (if (= (-> destination connection activity) (-> source activity)) (the uint8 0) (the uint8 1)))
    (when (and (!= (-> destination connection connected?) (-> source valid?))
               (!= (-> source identity player-id) (mp-local-player-id)))
      (log 'debug
           ("[MP-PlayerState] Player=~D connected=~D->~D state-ready=~D joined=~D"
            (-> source identity player-id)
            (-> destination connection connected?)
            (-> source valid?)
            (-> source identity state-ready?)
            (-> source identity joined?))
           (" activity=~D presentation-generation=~D lifecycle=~D vehicle=~D"
            (-> source activity)
            (-> source generation)
            (-> source lifecycle-generation)
            (-> source vehicle vehicle-id))))
    (set! (-> destination connection activity) (-> source activity))
    (set! (-> destination connection connected?) (-> source valid?))
    (set! (-> destination connection state-cached?) (-> source valid?))
    (set! (-> destination connection latest-state-sequence) (-> source generation))
    (set! (-> destination runtime mission-flags) (the-as mp-player-mission-flags (-> source mission-flags))))
  (none))

(defun mp-network-copy-bootstrap-to-replication! ((destination mp-replication-bootstrap-state)
                                                  (source mp-bootstrap-sync-state))
  (when (nonnull? destination source)
    (vector-copy! (-> destination host-spawn-position) (-> source host-spawn-position))
    (mem-copy! (the-as pointer (-> destination synchronized-aids))
               (the-as pointer (-> source synchronized-aids))
               (* MP_MAX_BOOTSTRAP_AIDS 4))
    (mem-copy! (the-as pointer (-> destination host-continue)) (the-as pointer (-> source host-continue)) 32)
    (set! (-> destination phase) (-> source phase))
    (set! (-> destination sequence) (-> source sequence))
    (set! (-> destination host-task) (-> source host-task))
    (set! (-> destination host-spawn-angle) (-> source host-spawn-angle))
    (set! (-> destination host-camera-angle-y) (-> source host-camera-angle-y))
    (set! (-> destination synchronized-aid-count)
          (the-as uint16 (min MP_MAX_BOOTSTRAP_AIDS (-> source synchronized-aid-count)))))
  (none))

(defun mp-network-copy-bootstrap-from-replication! ((destination mp-bootstrap-sync-state)
                                                    (source mp-replication-bootstrap-state))
  (when (nonnull? destination source)
    (vector-copy! (-> destination host-spawn-position) (-> source host-spawn-position))
    (mem-copy! (the-as pointer (-> destination synchronized-aids))
               (the-as pointer (-> source synchronized-aids))
               (* MP_MAX_BOOTSTRAP_AIDS 4))
    (mem-copy! (the-as pointer (-> destination host-continue)) (the-as pointer (-> source host-continue)) 32)
    (when (and (nonzero? (-> source sequence)) (!= (-> destination sequence) (-> source sequence)))
      (set! (-> destination phase) (the uint 1))
      (set! *mp-bootstrap-local-phase* (the uint 1)))
    (set! (-> destination sequence) (-> source sequence))
    (set! (-> destination host-task) (-> source host-task))
    (set! (-> destination host-spawn-angle) (-> source host-spawn-angle))
    (set! (-> destination host-camera-angle-y) (-> source host-camera-angle-y))
    (set! (-> destination synchronized-aid-count) (the-as uint32 (-> source synchronized-aid-count))))
  (none))

(defun mp-network-copy-enemy-to-replication! ((destination mp-replication-enemy-state) (source mp-enemy-state))
  (when (nonnull? destination source)
    (set-vector! (-> destination position) (-> source x) (-> source y) (-> source z) 1.0)
    (set! (-> destination quaternion x) (-> source quat-x))
    (set! (-> destination quaternion y) (-> source quat-y))
    (set! (-> destination quaternion z) (-> source quat-z))
    (set! (-> destination quaternion w) (-> source quat-w))
    (vector-reset! (-> destination presentation-velocity))
    (set! (-> destination actor-id) (-> source actor-id))
    (set! (-> destination hp) (-> source hp))
    (set! (-> destination state) (-> source state))
    (set! (-> destination focus-player-id) (the-as uint8 (-> source focus-player-id)))
    (set! (-> destination attack-flag) (-> source attack-flag))
    (set! (-> destination owner-player-id) (-> source owner-player-id))
    (set! (-> destination is-aggro) (-> source is-aggro)))
  (none))

(defun mp-network-copy-enemy-from-replication! ((destination mp-enemy-state) (source mp-replication-enemy-state))
  (when (nonnull? destination source)
    (set! (-> destination x) (-> source position x))
    (set! (-> destination y) (-> source position y))
    (set! (-> destination z) (-> source position z))
    (set! (-> destination quat-x) (-> source quaternion x))
    (set! (-> destination quat-y) (-> source quaternion y))
    (set! (-> destination quat-z) (-> source quaternion z))
    (set! (-> destination quat-w) (-> source quaternion w))
    (set! (-> destination actor-id) (-> source actor-id))
    (set! (-> destination hp) (-> source hp))
    (set! (-> destination state) (-> source state))
    (set! (-> destination focus-player-id) (the-as uint32 (-> source focus-player-id)))
    (set! (-> destination attack-flag) (-> source attack-flag))
    (set! (-> destination owner-player-id) (-> source owner-player-id))
    (set! (-> destination is-aggro) (-> source is-aggro))
    (let ((auth-record (mp-get-enemy-auth (the-as uint (-> source actor-id)))))
      (when (nonnull? auth-record)
        (vector-copy! (-> auth-record linvel) (-> source presentation-velocity)))))
  (none))

