(defun mp-network-capture-local-replication! ()
  (when (nonnull? *mp-replication-state*
                  *mp-player-controller*
                  *mp-world-state*
                  *multiplayer-preferences*
                  *mp-bootstrap-state*
                  *mp-event-buffer*
                  *mp-enemy-buffer*
                  *mp-traffic-buffer*
                  *mp-palace-squid-buffer*
                  *mp-widow-buffer*
                  *mp-airlock-buffer*
                  *mp-traffic-authority-assignments*)
    (set! (-> *mp-replication-state* abi-size) (the uint MP_REPLICATION_STATE_SIZE))
    (set! (-> *mp-replication-state* local-player-id) (-> *mp-player-controller* local-player-id))
    (set! (-> *mp-replication-state* host-player-id) (-> *mp-player-controller* host-player-id))
    (dotimes (player-id MP_MAX_PLAYERS)
      (mp-network-copy-player-to-replication! (-> *mp-replication-state* local players player-id)
                                              (-> *mp-player-controller* records player-id)))
    (when (mp-session-host?)
      (set! (-> *mp-world-state* respawn-delay-seconds) (-> *multiplayer-preferences* respawn-delay-seconds))
      (set! (-> *mp-world-state* player-collision) (-> *multiplayer-preferences* player-collision))
      (set! (-> *mp-world-state* friendly-fire) (-> *multiplayer-preferences* friendly-fire)))
    (mem-copy! (the-as pointer (-> *mp-replication-state* local world))
               (the-as pointer *mp-world-state*)
               (size-of mp-world-sync-state))
    (mp-network-copy-bootstrap-to-replication! (-> *mp-replication-state* local bootstrap) *mp-bootstrap-state*)
    (set! (-> *mp-replication-state* local enemies count)
          (the-as uint8 (min MP_MAX_SYNC_ENEMIES (-> *mp-enemy-buffer* local-count))))
    (dotimes (enemy-index (-> *mp-replication-state* local enemies count))
      (mp-network-copy-enemy-to-replication! (-> *mp-replication-state* local enemies enemies enemy-index)
                                             (-> *mp-enemy-buffer* local-enemies enemy-index)))
    (cond
      (*mp-traffic-local-authoritative?*
       (set! (-> *mp-replication-state* local traffic pedestrian-count)
             (the-as uint8 (min MP_MAX_SYNC_PEDESTRIANS (-> *mp-traffic-buffer* ped-count))))
       (set! (-> *mp-replication-state* local traffic vehicle-count)
             (the-as uint8 (min MP_MAX_SYNC_VEHICLES (-> *mp-traffic-buffer* veh-count))))
       (dotimes (pedestrian-index (-> *mp-replication-state* local traffic pedestrian-count))
         (mp-network-copy-pedestrian-to-replication! (-> *mp-replication-state*
                                                         local
                                                         traffic
                                                         pedestrians
                                                         pedestrian-index)
                                                     (-> *mp-traffic-buffer* ped-enemies pedestrian-index)))
       (mem-copy! (the-as pointer (-> *mp-replication-state* local traffic vehicles))
                  (the-as pointer (-> *mp-traffic-buffer* veh-enemies))
                  (* MP_MAX_SYNC_VEHICLES (size-of mp-vehicle-state))))
      (else
       (set! (-> *mp-replication-state* local traffic pedestrian-count) (the-as uint8 0))
       (set! (-> *mp-replication-state* local traffic vehicle-count) (the-as uint8 0))))
    (mp-network-copy-squid-to-replication! (-> *mp-replication-state* local bosses squid)
                                           (-> *mp-palace-squid-buffer* local-state))
    (mp-network-copy-widow-to-replication! (-> *mp-replication-state* local bosses widow)
                                           (-> *mp-widow-buffer* local-state))
    (set! (-> *mp-replication-state* local airlocks count)
          (the-as uint8 (min MP_AIRLOCK_LOCAL_STATE_COUNT (-> *mp-airlock-buffer* local-table count))))
    (set! (-> *mp-replication-state* local airlocks sequence) (-> *mp-airlock-buffer* sequence))
    (dotimes (airlock-index (-> *mp-replication-state* local airlocks count))
      (mp-network-copy-airlock-to-replication! (-> *mp-replication-state* local airlocks states airlock-index)
                                               (-> *mp-airlock-buffer* local-table states airlock-index)))
    (set! (-> *mp-replication-state* local authority revision) *mp-traffic-authority-revision*)
    (set! (-> *mp-replication-state* local authority selected) *mp-traffic-selected-authority-id*)
    (mem-copy! (the-as pointer (-> *mp-replication-state* local authority assignments))
               (the-as pointer (-> *mp-traffic-authority-assignments* assignments))
               MP_MAX_PLAYERS)
    (when (= (-> *mp-replication-state* outbound-event-count) 0)
      (set! (-> *mp-replication-state* outbound-event-count) (-> *mp-event-buffer* out-count))
      (mem-copy! (the-as pointer (-> *mp-replication-state* outbound-events))
                 (the-as pointer (-> *mp-event-buffer* out-events))
                 (* 64 (size-of mp-event)))))
  (none))

(defun mp-network-consume-remote-replication! ((notify-joins? symbol))
  (when (nonnull? *mp-replication-state*
                  *mp-player-controller*
                  *mp-world-state*
                  *mp-bootstrap-state*
                  *mp-event-buffer*
                  *mp-enemy-buffer*
                  *mp-traffic-buffer*
                  *mp-palace-squid-buffer*
                  *mp-widow-buffer*
                  *mp-airlock-buffer*
                  *mp-traffic-working-authority-map*)
    (dotimes (player-id MP_MAX_PLAYERS)
      (when (!= player-id (the-as int (-> *mp-replication-state* local-player-id)))
        (mp-network-copy-player-from-replication! (-> *mp-player-controller* records player-id)
                                                  (-> *mp-replication-state* remote players player-id)
                                                  notify-joins?)))
    (when (mp-session-client?)
      (when (!= (-> *mp-replication-state* remote world-valid?) 0)
        (mem-copy! (the-as pointer *mp-world-state*)
                   (the-as pointer (-> *mp-replication-state* remote world))
                   (size-of mp-world-sync-state)))
      (when (!= (-> *mp-replication-state* remote bootstrap-valid?) 0)
        (mp-network-copy-bootstrap-from-replication! *mp-bootstrap-state* (-> *mp-replication-state* remote bootstrap))))
    (mem-set32! (the-as pointer (-> *mp-enemy-buffer* remote-enemies))
                (/ (* MP_MAX_REMOTE_ENEMIES (size-of mp-enemy-state)) 4)
                0)
    (set! (-> *mp-enemy-buffer* remote-count)
          (if (nonzero? (-> *mp-replication-state* remote enemies valid?))
            (the-as uint (min MP_MAX_REMOTE_ENEMIES (-> *mp-replication-state* remote enemies count)))
            (the uint 0)))
    (dotimes (enemy-index (-> *mp-enemy-buffer* remote-count))
      (mp-network-copy-enemy-from-replication! (-> *mp-enemy-buffer* remote-enemies enemy-index)
                                               (-> *mp-replication-state* remote enemies enemies enemy-index)))
    (set! (-> *mp-traffic-buffer* ped-count) (the-as uint (-> *mp-replication-state* remote traffic pedestrian-count)))
    (set! (-> *mp-traffic-buffer* veh-count) (the-as uint (-> *mp-replication-state* remote traffic vehicle-count)))
    (dotimes (pedestrian-index (-> *mp-traffic-buffer* ped-count))
      (mp-network-copy-pedestrian-from-replication! (-> *mp-traffic-buffer* ped-enemies pedestrian-index)
                                                    (-> *mp-replication-state*
                                                        remote
                                                        traffic
                                                        pedestrians
                                                        pedestrian-index)))
    (mem-copy! (the-as pointer (-> *mp-traffic-buffer* veh-enemies))
               (the-as pointer (-> *mp-replication-state* remote traffic vehicles))
               (* MP_MAX_SYNC_VEHICLES (size-of mp-vehicle-state)))
    (mp-network-copy-squid-from-replication! (-> *mp-palace-squid-buffer* remote-state)
                                             (-> *mp-replication-state* remote bosses squid))
    (mp-network-copy-widow-from-replication! (-> *mp-widow-buffer* remote-state)
                                             (-> *mp-replication-state* remote bosses widow))
    (mp-airlock-clear-table! (-> *mp-airlock-buffer* remote-table))
    (set! (-> *mp-airlock-buffer* remote-table count) (the-as uint (-> *mp-replication-state* remote airlocks count)))
    (dotimes (airlock-index (-> *mp-airlock-buffer* remote-table count))
      (mp-network-copy-airlock-from-replication! (-> *mp-airlock-buffer* remote-table states airlock-index)
                                                 (-> *mp-replication-state* remote airlocks states airlock-index)))
    (mem-copy! (the-as pointer (-> *mp-traffic-working-authority-map* assignments))
               (the-as pointer (-> *mp-replication-state* remote authority assignments))
               MP_MAX_PLAYERS)
    (when (= (-> *mp-replication-state* outbound-event-count) 0)
      (set! (-> *mp-event-buffer* out-count) (the-as uint8 0)))
    (set! (-> *mp-event-buffer* in-count) (-> *mp-replication-state* inbound-event-count))
    (mem-copy! (the-as pointer (-> *mp-event-buffer* in-events))
               (the-as pointer (-> *mp-replication-state* inbound-events))
               (* 64 (size-of mp-event)))
    (set! (-> *mp-replication-state* inbound-event-count) (the-as uint8 0)))
  (none))

(defun gungame-prepare-exchange! ()
  (when (nonnull? *mp-replication-state*)
    (let ((local (-> *mp-replication-state* local gungame))
          (remote (-> *mp-replication-state* remote gungame)))
      (mem-set32! (the-as pointer local) (/ (size-of gungame-state) 4) 0)
      (set! (-> local end-door) (the uint 0))
      (set! (-> local open-end?) (the uint 0))
      (set! (-> remote targets) (the-as (inline-array gungame-target-record) #f))
      (set! (-> remote capacity) (the uint 0))
      (set! (-> remote sequence) (the uint 0)))
    (let ((manager (process-by-type-exact 'training-manager *active-pool*)))
      (when (nonnull? manager)
        (send-event manager 'gungame-capture (the-as uint *mp-replication-state*)))))
  (none))

(defun mp-network-exchange-state! ((status mp-connection-status))
  (when (mp-network-status-ready? status)
    (mp-network-pack-local-frame! status)
    (mp-airlock-sync-tick)
    (mp-network-capture-local-replication!)
    (gungame-prepare-exchange!))
  (when (nonnull? *mp-replication-state*)
    (let* ((local-player-id (the uint (-> *mp-replication-state* local-player-id)))
           (notify-joins? (if (and (mp-player-id-valid? local-player-id)
                                   (or (= local-player-id (-> *mp-replication-state* host-player-id))
                                       (nonzero? (-> *mp-replication-state*
                                                     remote
                                                     players
                                                     local-player-id
                                                     identity
                                                     joined?))))
                            #t
                            #f)))
      (pc-multi-exchange-state (the-as uint *mp-replication-state*))
      (when (mp-network-status-ready? status)
        (mp-network-consume-remote-replication! notify-joins?))))
  (none))
