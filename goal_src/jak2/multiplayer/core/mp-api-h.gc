(defun mp-session-status-active? ((status mp-connection-status))
  (!= status (mp-connection-status idle)))

(defun mp-session-status-connected? ((status mp-connection-status))
  (or (= status (mp-connection-status lobby))
      (= status (mp-connection-status game-starting))
      (= status (mp-connection-status in-game))))

(defun mp-session-status-in-game? ((status mp-connection-status))
  (= status (mp-connection-status in-game)))

(defun mp-session-status-reconnecting? ((status mp-connection-status))
  (= status (mp-connection-status reconnecting)))

(defun mp-session-status-terminal? ((status mp-connection-status))
  (or (= status (mp-connection-status host-left)) (= status (mp-connection-status failed))))

(defun mp-session-active? ()
  (mp-session-status-active? (pc-multi-get-session-status)))

(defun mp-session-connected? ()
  (mp-session-status-connected? (pc-multi-get-session-status)))

(defun mp-session-in-game? ()
  (mp-session-status-in-game? (pc-multi-get-session-status)))

(defun mp-session-reconnecting? ()
  (mp-session-status-reconnecting? (pc-multi-get-session-status)))

(defun mp-session-terminal? ()
  (mp-session-status-terminal? (pc-multi-get-session-status)))

(defun mp-session-version-mismatch? ()
  (and (= (pc-multi-get-session-status) (mp-connection-status failed))
       (= (pc-multi-get-session-rejection) (mp-session-rejection version-mismatch))))
