(defconstant MP_TRAFFIC_NET_ID_CLASS_MASK (the uint #xf0000000))
(defconstant MP_TRAFFIC_NET_ID_ORIGIN_MASK (the uint #x0f000000))
(defconstant MP_TRAFFIC_NET_ID_SEQUENCE_MASK (the uint #x00ffffff))
(defconstant MP_TRAFFIC_NET_ID_ORIGIN_SHIFT 24)
(defconstant MP_TRAFFIC_PEDESTRIAN_NET_ID_BASE (the uint #x10000000))
(defconstant MP_TRAFFIC_VEHICLE_NET_ID_BASE (the uint #x20000000))
(defconstant MP_CLIENT_VEHICLE_NET_ID_BASE (the uint #x40000000))
(defconstant MP_CLIENT_VEHICLE_NET_ID_END (the uint #x50000000))
(define-perm *mp-client-vehicle-net-id-counter* uint MP_CLIENT_VEHICLE_NET_ID_BASE)
(define-perm *mp-last-local-state-id* uint (the uint 0))
(define-perm *mp-battle-spawn-counter* uint (the uint 0))
(defconstant MP_MISSION_ENEMY_ATOLL_ASHELIN (the uint #x6f000001))
(define *multi-sync-tps* 30)

(defun mp-traffic-net-id-class ((net-id uint))
  (logand net-id MP_TRAFFIC_NET_ID_CLASS_MASK)
  )

(defun mp-traffic-net-id-origin ((net-id uint))
  (logand (shr net-id MP_TRAFFIC_NET_ID_ORIGIN_SHIFT) (the uint #xf))
  )

(defun mp-traffic-net-id-sequence ((net-id uint))
  (logand net-id MP_TRAFFIC_NET_ID_SEQUENCE_MASK)
  )

(defun mp-traffic-build-net-id ((class-base uint) (player-id uint) (sequence uint))
  "Encode a traffic entity class, immutable origin player, and local sequence."
  (if (and (< player-id (the uint MP_MAX_PLAYERS))
           (<= sequence MP_TRAFFIC_NET_ID_SEQUENCE_MASK)
           (or (= class-base MP_TRAFFIC_PEDESTRIAN_NET_ID_BASE)
               (= class-base MP_TRAFFIC_VEHICLE_NET_ID_BASE)
               (= class-base MP_CLIENT_VEHICLE_NET_ID_BASE)))
      (logior class-base
              (shl player-id MP_TRAFFIC_NET_ID_ORIGIN_SHIFT)
              sequence)
      (the uint 0)
      )
  )

