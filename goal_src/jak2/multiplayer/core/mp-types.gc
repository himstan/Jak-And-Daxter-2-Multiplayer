  )

(defenum mp-pedestrian-flags
  :type uint8
  :bitfield #t
  (dead)
  (dark-guard)
  )

(deftype mp-pedestrian-state (structure)
  ((net-id          uint32)
   (object-type     uint8)
   (object-variance uint8)
   (state-id        uint8)    ;; Replaces anim-index: numeric mp-ped-state-id
   (pad-align       uint8)    ;; Alignment padding (was 2 bytes, now 1 since we use one for state-id)
   (x               float)
   (y               float)
   (z               float)
   (quat-x          float)
   (quat-y          float)
   (quat-z          float)
   (quat-w          float)
   (hp              int32)
   (flags           mp-pedestrian-flags)
   (target-player-id uint8) ;; 0xff = invalid; otherwise canonical player ID
   (context-align   uint8 2)  ;; Aligns the named sync context fields below.
   (animation-profile uint32) ;; Type-specific initial animation selection.
   (vehicle-net-id  uint32)   ;; Vehicle rider bootstrap context, 0 = unset
   (transport-id    uint32)   ;; Transport-spawned guard context, 0 = unset
   (transport-side  uint8)    ;; Optional transport side hint/debug
   (pad             uint8 7)
   )
  :size-assert 64)

