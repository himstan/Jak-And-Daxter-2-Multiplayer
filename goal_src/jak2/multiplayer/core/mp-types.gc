;;-*-Lisp-*-
(in-package goal)

;; Keep these values in sync with MultiplayerStatus in
;; game/multiplayer/multiplayer_protocol.h.
(defenum mp-connection-status
  :type int32
  (idle                    0)
  (searching               1)
  (found                   2)
  (connecting              3)
  (connected-lobby         4)
  (game-starting           5)
  (in-game                 6)
  (reconnecting            7)
  (host-left               8)
  (failed                 -1)
  (version-mismatch       -2)
  (credential-discovery-failed -3)
  )

(defun mp-connection-status-active? ((status mp-connection-status))
  "Return true for every connection status except the offline/idle state."
  (!= status (mp-connection-status idle))
  )

