   )
  :size-assert 112)

(defenum mp-airlock-state-id (uint32)
  (none 0)
  (ready 1)
  (occupied 2)
  (commit 3)
  )

(defconstant MP_AIRLOCK_STATE_COUNT 4)

(deftype mp-airlock-state (structure)
  ((airlock-aid  uint32)
   (state-id     uint32)
   (level-id     uint32)
   (sequence     uint32)
   (last-updated uint32)
   (pad          uint8 12)
   )
  :size-assert 32)

(deftype mp-airlock-state-table (structure)
  ((count  uint32)
   (pad    uint8 12)
   (states mp-airlock-state MP_AIRLOCK_STATE_COUNT :inline)
   )
  :size-assert 144)

(deftype mp-airlock-sync-buffer (structure)
  ((local-table    mp-airlock-state-table :inline)
   (remote-table   mp-airlock-state-table :inline)
   (sequence       uint32)
   (pad-align      uint8 4)
   (last-sync-time uint64)
   (pad            uint8 8)
   )
  :size-assert 312)

;; --- Ghost Record for Traffic Sync (Position Prediction) ---
;; Stores the last-known authoritative position/state for each traffic entity.
;; Used to present non-authoritative traffic from host-derived motion.
(deftype mp-traffic-ghost-record (structure)
  ((net-id          uint32)
   (entity-kind     uint8)       ;; 0=pedestrian, 1=vehicle
   (pad             uint8 3)
   (last-seen       time-frame)  ;; Timestamp of last remote update
   (ghost-trans     vector :inline)
   (ghost-quat      quaternion :inline)
   (presentation-trans vector :inline) ;; Client-only host-driven display position
   (presentation-quat quaternion :inline) ;; Client-only host-driven display facing
   (ghost-linvel    vector :inline)   ;; Vehicles: remote linear velocity; peds: locally estimated velocity
   (ghost-angvel    vector :inline)   ;; Vehicles: remote angular velocity; peds: previous authoritative position
   (ghost-hp         int32)
   (ghost-state-id  uint8)           ;; Pedestrian state ID; unused for vehicles
   (ghost-aux-state uint8)                 ;; Pedestrian target player ID or vehicle state flags
   (presentation-valid uint8)        ;; Client-only presentation transform has been initialized
   (last-attack-source-player-id uint8)
   (ghost-animation-profile uint32)  ;; Latest authoritative pedestrian animation selection
   (last-applied-animation-profile uint32)
   (last-attack-id   uint32)
   (last-local-attack-id uint32)
   (last-local-attack-time time-frame)
   (last-correction-time   uint64)
   (last-applied-state-id uint32)
   (last-state-bump-time time-frame)
   (authorized-trans-state-id uint32)
   (authorized-trans-frame time-frame)
   )
  )

(defconstant MP_MAX_TRAFFIC_GHOST_RECORDS 192)
(define-perm *mp-traffic-ghosts*
  (inline-array mp-traffic-ghost-record)
  (new 'static 'inline-array mp-traffic-ghost-record 192))

(defenum mp-enemy-state-id (uint32)
  (none 0)
  (active 1)
  (notice 2)
  (hostile 3)
  (hit 4)
  (knocked 5)
  (stare 6)
  (idle 7)
  (victory 8)
  (die 9)
  (dormant 10)
  (dormant-aware 11)
  (ambush 12)
  (flee 13)
  (jump 14)
  (jump-blocked 15)
  ;; Nav-Enemy Specific States
  (chase 16)
  (patrol 17)
  (pacing 18)
  (circling 19)
  (taunt 20)
  (stop-chase 21)
  (staredown 22)
  ;; Crimson Guard Specific States
  (gun-shoot 23)
  (get-up-front 24)
  (get-up-back 25)
  (close-attack 26)
  (grenade-attack 27)
  (exit-transport 28)
  (blast-hostile 29)
  (grenade-hostile 30)
  (tazer-hostile 31)
  (roll-right 32)
  (roll-left 33)
  (arrest 34)
  (attack 35)
  ;; Grunt Specific States
  (falling-ambush 36)
  (jumping-ambush 37)
  (jumping-ambush-cont 38)
  (wait-for-focus 39)
  (spin-attack 40)
  ;; Bot Specific States
  (traveling 41)
  (traveling-blocked 42)
  (waiting-far 43)
  (waiting-close 44)
  (waiting-turn 45)
  (waiting-crouched 46)
  (die-falling 47)
  (failed 48)
  (hidden 49)
  ;; Sig Specific States
  (sig-path-run 50)
  (sig-path-jump 51)
  (sig-path-jump-land 52)
  (sig-path-shoot-jump 53)
  (sig-path-shoot-jump-land 54)
  (sig-path-idle 55)
  (charge-plasma 56)
  (gun-jam 57)
  (repair-gun 58)
  (clean-gun 59)
  (whip 60)
  (blast 61)
  (chase-attack 62)
  ;; Amphibian Specific States
  (stare-idle 63)
  (attack-forward 64)
  (attack-forward-lunge 65)
  (attack-forward-end 66)
  (attack-spin 67)
  (tongue-attack 68)
  ;; Rhino Specific States
  (run-away 69)
  (stop-run 70)
  (charge 71)
  ;; Sewer scare-grunt specific states
  (waiting 72)
  (scare 73)
  ;; Ashelin Specific States
  (waiting-idle 74)
  (standing-idle 75)
  (standing-turn 76)
  (standing-blast 77)
  (back-spring 78)
  (cartwheel-left 79)
  (tumble-right 80)
  ;; Monster Frog Specific States
  (turn 81)
  (attack-recover 82)
  ;; Tomb Beetle Specific States
  (explode 83)
  (fly-away 84)
  (go-to-door 85)
  (key 86)
  (land 87)
  (stand 88)
  ;; Misc
  (directed 89)
  )

(deftype mp-enemy-auth-record (structure)
  ((aid                uint32)
   (owner-player-id    uint8)
   (is-aggro           symbol)
   (last-transfer-time time-frame)
   (last-remote-seen   time-frame)
   (last-attack-id     uint32)
   (last-local-attack-id uint32)
   (last-local-attack-time time-frame)
   ;; --- Ghost Predictive Sync ---
   (ghost-trans        vector :inline)
   (ghost-quat         quaternion :inline)
   (presentation-trans vector :inline) ;; GOAL-only remote display position
   (presentation-quat  quaternion :inline) ;; GOAL-only remote display facing
   (ghost-linvel       vector :inline)
   (ghost-sample-time  uint32)
   (presentation-valid uint8)
   (presentation-pad   uint8 3)
   (ghost-state        mp-enemy-state-id)
   (ghost-focus-player-id    uint32)
   (just-taken-authority symbol)
   (last-applied-remote-state mp-enemy-state-id)
   (last-remote-state-bump-time time-frame)
   )
  )

