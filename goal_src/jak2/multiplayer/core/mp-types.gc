  (get-up-back           11)
  (knocked               12)
  (knocked-off-vehicle   13)
  (wait-for-ride         14)
  (move-to-vehicle       15)
  (board-vehicle         16)
  (ride                  17)
  (exit-vehicle          18)
  (wait-at-dest          19)
  (in-ditch              20)
  (idle                  21)
  (dormant               22)
  (notice                23)
  (hostile               24)
  (stare                 25)
  (hit                   26)
  (die                   27)
  (walk                  28)
  (run                   29)
  (talk                  30)
  (hide                  31)
  ;; Guard-specific combat states (crimson-guard)
  (search                32)
  (close-attack          33)
  (close-attack-active   34)
  (gun-shoot             35)
  (roll-right            36)
  (roll-left             37)
  (arrest                38)
