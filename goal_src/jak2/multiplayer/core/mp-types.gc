(deftype mp-enemy-state (structure)
  ((actor-id    uint32)
   (x           float)
   (y           float)
   (z           float)
   (quat-x     float)
   (quat-y     float)
   (quat-z     float)
   (quat-w     float)
   (pad1       float 3) ;; Removed anim-index, anim-frame, last-anim-frame
   (hp         int32)
   (state      uint32)
   (focus-player-id  uint32)
   (attack-flag uint8)
   (owner-player-id uint8)
   (is-aggro    uint8)
   (pad         uint8 5)
   (last-updated uint64)
   (pad2        uint8 8))
  :size-assert 80)

