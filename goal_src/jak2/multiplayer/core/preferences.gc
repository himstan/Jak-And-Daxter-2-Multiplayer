;;-*-Lisp-*-
(in-package goal)

(define-extern pc-multi-get-preferences (function multiplayer-preferences int))
(define-extern pc-multi-set-preferences (function multiplayer-preferences int))

(define *multiplayer-preferences*
  (new 'static 'multiplayer-preferences :nametag-visibility (player-nametag-visibility hold) :player-map-marker 1))

(when (nonnull? *multiplayer-preferences*)
  (set! (-> *multiplayer-preferences* player-name) (new 'global 'string 15 ""))
  (set! (-> *multiplayer-preferences* room-code) (new 'global 'string 6 "")))

(defun save-multiplayer-preferences! ()
  (when (nonnull? *multiplayer-preferences*)
    (when (= (pc-multi-set-preferences *multiplayer-preferences*) 1)
      (return 1))
    (pc-multi-get-preferences *multiplayer-preferences*))
  0)
