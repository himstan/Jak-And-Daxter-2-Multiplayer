;;-*-Lisp-*-
(in-package goal)

(defenum player-nametag-visibility
  :type uint8
  (always 0)
  (hold 1)
  (off 2))

(defenum host-visibility
  :type uint8
  (public 0)
  (friends-only 1)
  (invite-only 2)
  (lan-only 3))

(defenum player-glow-mode
  :type uint8
  (disabled 0)
  (wall 1)
  (always 2))

(deftype multiplayer-preferences (structure)
  ((skin                   mp-player-skin :inline)
   (player-name            string)
   (room-code              string)
   (network-port           uint16)
   (respawn-delay-seconds  uint16)
   (session-player-limit   uint8)
   (preferred-character    uint8)
   (automatic-port-mapping uint8)
   (player-collision       uint8)
   (friendly-fire          uint8)
   (nametag-visibility     uint8)
   (player-map-marker      uint8)
   (host-visibility        uint8)
   (glow-fade-in-ms        uint16)
   (glow-fade-out-ms       uint16)
   (glow-fade-distance     uint16)  ;; meters, 0 = infinite
   (glow-mode              uint8)
   (glow-width             uint8)   ;; pixels at 1080p
   (glow-rounding          uint8)   ;; percent
   (glow-blur              uint8))  ;; percent
  :size-assert 286)

(define-extern pc-multi-get-preferences (function multiplayer-preferences int))
(define-extern pc-multi-set-preferences (function multiplayer-preferences int))
(define-extern pc-multi-preview-player-glow (function multiplayer-preferences int))

(define *multiplayer-preferences*
  (new 'static 'multiplayer-preferences
       :nametag-visibility (player-nametag-visibility hold)
       :player-map-marker 1
       :glow-mode (player-glow-mode wall)
       :glow-width 22
       :glow-rounding 100
       :glow-blur 50
       :glow-fade-in-ms 200
       :glow-fade-out-ms 100))

(when (nonnull? *multiplayer-preferences*)
  (set! (-> *multiplayer-preferences* player-name) (new 'global 'string 15 ""))
  (set! (-> *multiplayer-preferences* room-code) (new 'global 'string 6 "")))

(defun save-multiplayer-preferences! ()
  (when (nonnull? *multiplayer-preferences*)
    (when (= (pc-multi-set-preferences *multiplayer-preferences*) 1)
      (return 1))
    (pc-multi-get-preferences *multiplayer-preferences*))
  0)
