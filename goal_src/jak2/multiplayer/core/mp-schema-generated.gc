(in-package goal)

(defconstant MP_PACKET_STATE_UPDATE (the uint 0))
(defconstant MP_PACKET_EVENT_JOIN (the uint 1))
(defconstant MP_PACKET_EVENT_LEAVE (the uint 2))
(defconstant MP_PACKET_EVENT_GAME (the uint 3))
(defconstant MP_PACKET_BOOTSTRAP (the uint 4))
(defconstant MP_PACKET_ENEMY_SYNC (the uint 5))
(defconstant MP_PACKET_PEDESTRIAN_SYNC (the uint 6))
(defconstant MP_PACKET_VEHICLE_SYNC (the uint 7))
(defconstant MP_PACKET_TURRET_SYNC (the uint 8))
(defconstant MP_PACKET_PALACE_SQUID_SYNC (the uint 9))
(defconstant MP_PACKET_AIRLOCK_SYNC (the uint 10))
(defconstant MP_PACKET_WIDOW_SYNC (the uint 11))
(defconstant MP_PACKET_WORLD_STATE (the uint 12))
(defconstant MP_PACKET_SESSION_WELCOME (the uint 13))
(defconstant MP_PACKET_LOBBY_ACTION (the uint 14))

(defconstant MP_EVENT_ORB (the uint 1))
(defconstant MP_EVENT_GEM (the uint 2))
(defconstant MP_EVENT_BREAK (the uint 3))
(defconstant MP_EVENT_ATTACK_ENEMY (the uint 4))
(defconstant MP_EVENT_ENEMY_DEATH (the uint 5))
(defconstant MP_EVENT_SCENE_START (the uint 6))
(defconstant MP_EVENT_SCENE_REQUEST_SKIP (the uint 7))
(defconstant MP_EVENT_SCENE_SKIPPED (the uint 8))
(defconstant MP_EVENT_ENEMY_AUTHORITY_REQUEST (the uint 9))
(defconstant MP_EVENT_ENEMY_AUTHORITY_ACK (the uint 10))
(defconstant MP_EVENT_ATTACK_PED (the uint 11))
(defconstant MP_EVENT_CHANGE_MODE_DARKJAK (the uint 12))
(defconstant MP_EVENT_END_MODE_DARKJAK (the uint 13))
(defconstant MP_EVENT_EDGE_GRAB (the uint 14))
(defconstant MP_EVENT_PILOT_EDGE_GRAB (the uint 15))
(defconstant MP_EVENT_PLAYER_RESPAWNED (the uint 16))
(defconstant MP_EVENT_PLAYER_DIED (the uint 17))
(defconstant MP_EVENT_CONTINUE_POINT (the uint 18))
(defconstant MP_EVENT_WAYPOINT_BUMP (the uint 19))
(defconstant MP_EVENT_WAYPOINT_SNAPSHOT (the uint 20))
(defconstant MP_EVENT_WAYPOINT_REQUEST (the uint 21))
(defconstant MP_EVENT_POLE_GRAB (the uint 22))
(defconstant MP_EVENT_BATTLE_EVENT (the uint 23))
(defconstant MP_EVENT_PLAYER_GUN_SHOT (the uint 24))
(defconstant MP_EVENT_WARP_GATE (the uint 25))
(defconstant MP_EVENT_ENEMY_GEM (the uint 26))
(defconstant MP_EVENT_MTN_PLAT_SHOOT (the uint 27))
(defconstant MP_EVENT_MTN_DICE (the uint 28))
(defconstant MP_EVENT_PALACE_SQUID (the uint 29))
(defconstant MP_EVENT_FORT_MISSILE_TARGET (the uint 30))
(defconstant MP_EVENT_WIDOW_SPYDROID (the uint 31))
(defconstant MP_EVENT_WIDOW_BOMB (the uint 32))
(defconstant MP_EVENT_WIDOW_BOMB_KICK (the uint 33))
(defconstant MP_EVENT_WIDOW_BOMB_FIZZLE (the uint 34))
(defconstant MP_EVENT_WIDOW_BOMB_HIT (the uint 35))
(defconstant MP_EVENT_WIDOW_CATWALK_HIT (the uint 36))
(defconstant MP_EVENT_MISSION_LEAVE (the uint 37))
(defconstant MP_EVENT_MISSION_PLAY_SCENE (the uint 38))
(defconstant MP_EVENT_MISSION_FAILED_RETRY_YES (the uint 39))
(defconstant MP_EVENT_MISSION_FAILED_RETRY_NO (the uint 40))
(defconstant MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER (the uint 41))
(defconstant MP_EVENT_MISSION_GUNGAME_TUTORIAL_STEP (the uint 42))
(defconstant MP_EVENT_MISSION_GUNGAME_COURSE_SNAPSHOT (the uint 43))
(defconstant MP_EVENT_MISSION_GUNGAME_TARGET_BROKEN (the uint 44))
(defconstant MP_EVENT_MISSION_GUNGAME_TARGET_SPAWNED (the uint 45))
(defconstant MP_EVENT_MISSION_GUNGAME_COURSE_END (the uint 46))
(defconstant MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE (the uint 47))
(defconstant MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START (the uint 48))
(defconstant MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE (the uint 49))
(defconstant MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END (the uint 50))
(defconstant MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP (the uint 51))
(defconstant MP_EVENT_MISSION_KREW_COLLECTION_PICKUP (the uint 52))
(defconstant MP_EVENT_MISSION_CITY_SHUTTLE_STATE (the uint 53))
(defconstant MP_EVENT_MISSION_CITY_POWER_TURRET_STATE (the uint 54))
(defconstant MP_EVENT_MISSION_TOMB_BOULDER_COMPLETE (the uint 55))
(defconstant MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START (the uint 56))
(defconstant MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END (the uint 57))
(defconstant MP_EVENT_RACE (the uint 58))

(defconstant MP_PACKET_COUNT (the uint 15))

(defun mp-schema-packet-name ((idx int))
  (cond
    ((= idx 0) "STATE_UPDATE")
    ((= idx 1) "EVENT_JOIN")
    ((= idx 2) "EVENT_LEAVE")
    ((= idx 3) "EVENT_GAME")
    ((= idx 4) "BOOTSTRAP")
    ((= idx 5) "ENEMY_SYNC")
    ((= idx 6) "PEDESTRIAN_SYNC")
    ((= idx 7) "VEHICLE_SYNC")
    ((= idx 8) "TURRET_SYNC")
    ((= idx 9) "PALACE_SQUID_SYNC")
    ((= idx 10) "AIRLOCK_SYNC")
    ((= idx 11) "WIDOW_SYNC")
    ((= idx 12) "WORLD_STATE")
    ((= idx 13) "SESSION_WELCOME")
    ((= idx 14) "LOBBY_ACTION")
    (else "UNKNOWN")
    )
  )

(defun mp-schema-event-known? ((event-id uint))
  (cond
    ((= event-id MP_EVENT_ORB) #t)
    ((= event-id MP_EVENT_GEM) #t)
    ((= event-id MP_EVENT_BREAK) #t)
    ((= event-id MP_EVENT_ATTACK_ENEMY) #t)
    ((= event-id MP_EVENT_ENEMY_DEATH) #t)
    ((= event-id MP_EVENT_SCENE_START) #t)
    ((= event-id MP_EVENT_SCENE_REQUEST_SKIP) #t)
    ((= event-id MP_EVENT_SCENE_SKIPPED) #t)
    ((= event-id MP_EVENT_ENEMY_AUTHORITY_REQUEST) #t)
    ((= event-id MP_EVENT_ENEMY_AUTHORITY_ACK) #t)
    ((= event-id MP_EVENT_ATTACK_PED) #t)
    ((= event-id MP_EVENT_CHANGE_MODE_DARKJAK) #t)
    ((= event-id MP_EVENT_END_MODE_DARKJAK) #t)
    ((= event-id MP_EVENT_EDGE_GRAB) #t)
    ((= event-id MP_EVENT_PILOT_EDGE_GRAB) #t)
    ((= event-id MP_EVENT_PLAYER_RESPAWNED) #t)
    ((= event-id MP_EVENT_PLAYER_DIED) #t)
    ((= event-id MP_EVENT_CONTINUE_POINT) #t)
    ((= event-id MP_EVENT_WAYPOINT_BUMP) #t)
    ((= event-id MP_EVENT_WAYPOINT_SNAPSHOT) #t)
    ((= event-id MP_EVENT_WAYPOINT_REQUEST) #t)
    ((= event-id MP_EVENT_POLE_GRAB) #t)
    ((= event-id MP_EVENT_BATTLE_EVENT) #t)
    ((= event-id MP_EVENT_PLAYER_GUN_SHOT) #t)
    ((= event-id MP_EVENT_WARP_GATE) #t)
    ((= event-id MP_EVENT_ENEMY_GEM) #t)
    ((= event-id MP_EVENT_MTN_PLAT_SHOOT) #t)
    ((= event-id MP_EVENT_MTN_DICE) #t)
    ((= event-id MP_EVENT_PALACE_SQUID) #t)
    ((= event-id MP_EVENT_FORT_MISSILE_TARGET) #t)
    ((= event-id MP_EVENT_WIDOW_SPYDROID) #t)
    ((= event-id MP_EVENT_WIDOW_BOMB) #t)
    ((= event-id MP_EVENT_WIDOW_BOMB_KICK) #t)
    ((= event-id MP_EVENT_WIDOW_BOMB_FIZZLE) #t)
    ((= event-id MP_EVENT_WIDOW_BOMB_HIT) #t)
    ((= event-id MP_EVENT_WIDOW_CATWALK_HIT) #t)
    ((= event-id MP_EVENT_MISSION_LEAVE) #t)
    ((= event-id MP_EVENT_MISSION_PLAY_SCENE) #t)
    ((= event-id MP_EVENT_MISSION_FAILED_RETRY_YES) #t)
    ((= event-id MP_EVENT_MISSION_FAILED_RETRY_NO) #t)
    ((= event-id MP_EVENT_MISSION_FORTRESS_ROBOTANK_TRIGGER) #t)
    ((= event-id MP_EVENT_MISSION_GUNGAME_TUTORIAL_STEP) #t)
    ((= event-id MP_EVENT_MISSION_GUNGAME_COURSE_SNAPSHOT) #t)
    ((= event-id MP_EVENT_MISSION_GUNGAME_TARGET_BROKEN) #t)
    ((= event-id MP_EVENT_MISSION_GUNGAME_TARGET_SPAWNED) #t)
    ((= event-id MP_EVENT_MISSION_GUNGAME_COURSE_END) #t)
    ((= event-id MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE) #t)
    ((= event-id MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START) #t)
    ((= event-id MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE) #t)
    ((= event-id MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END) #t)
    ((= event-id MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP) #t)
    ((= event-id MP_EVENT_MISSION_KREW_COLLECTION_PICKUP) #t)
    ((= event-id MP_EVENT_MISSION_CITY_SHUTTLE_STATE) #t)
    ((= event-id MP_EVENT_MISSION_CITY_POWER_TURRET_STATE) #t)
    ((= event-id MP_EVENT_MISSION_TOMB_BOULDER_COMPLETE) #t)
    ((= event-id MP_EVENT_MISSION_TOMB_DAXTER_WAIT_START) #t)
    ((= event-id MP_EVENT_MISSION_TOMB_DAXTER_WAIT_END) #t)
    ((= event-id MP_EVENT_RACE) #t)
    (else #f)
    )
  )
