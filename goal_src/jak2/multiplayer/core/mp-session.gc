;;-*-Lisp-*-
(in-package goal)

(define-extern mp-death-respawn-event-on-spawn! (function none))
(define-extern *dproc* process)
(define-extern activate-progress (function process symbol none))
(define-extern mp-demo-guard-tick (function none))
(define-extern mp-demo-guard-on-local-spawn! (function none))
(define-extern mp-reset-orb-permanence-state! (function none))
(define-extern mp-reset-gem-permanence-state! (function none))

(defun mp-character-cli-whitespace? ((character uint))
  (or (= character (the uint 32)) (= character (the uint 9)) (= character (the uint 13)) (= character (the uint 10))))

(defun mp-character-cli-letter? ((character uint) (lowercase uint))
  (or (= character lowercase) (= character (- lowercase (the uint 32)))))

(defun mp-character-from-cli-token ((token-start (pointer uint8)) (token-end (pointer uint8)))
  (while (and (< (the-as uint token-start) (the-as uint token-end))
              (mp-character-cli-whitespace? (the-as uint (-> token-start 0))))
    (set! token-start (&-> token-start 1)))
  (while (and (< (the-as uint token-start) (the-as uint token-end))
              (mp-character-cli-whitespace? (the-as uint (-> token-end -1))))
    (set! token-end (&-> token-end -1)))
  (let ((token-length (&- token-end (the-as uint token-start))))
    (cond
      ((and (= token-length (the uint 3))
            (mp-character-cli-letter? (the-as uint (-> token-start 0)) (the uint 106))
            (mp-character-cli-letter? (the-as uint (-> token-start 1)) (the uint 97))
            (mp-character-cli-letter? (the-as uint (-> token-start 2)) (the uint 107)))
       (mp-player-character jak))
      ((and (= token-length (the uint 6))
            (mp-character-cli-letter? (the-as uint (-> token-start 0)) (the uint 100))
            (mp-character-cli-letter? (the-as uint (-> token-start 1)) (the uint 97))
            (mp-character-cli-letter? (the-as uint (-> token-start 2)) (the uint 120))
            (mp-character-cli-letter? (the-as uint (-> token-start 3)) (the uint 116))
            (mp-character-cli-letter? (the-as uint (-> token-start 4)) (the uint 101))
            (mp-character-cli-letter? (the-as uint (-> token-start 5)) (the uint 114)))
       (mp-player-character daxter))
      (else (mp-player-character unknown)))))

(defun mp-parse-session-characters-cli! ((characters-arg string))
  (when (or (not characters-arg) (zero? (the-as uint characters-arg)))
    (return #f))
  (let ((token-start (-> characters-arg data))
        (cursor (-> characters-arg data))
        (player-id (the uint 0))
        (valid? #t)
        (done? #f))
    (while (and valid? (not done?))
      (let ((character (the-as uint (-> cursor 0))))
        (cond
          ((or (zero? character) (= character (the uint 44)))
           (if (>= player-id (the uint MP_MAX_PLAYERS))
             (set! valid? #f)
             (let ((player-character (mp-character-from-cli-token token-start cursor)))
               (if (mp-player-character-valid? player-character)
                 (begin
                   (mp-set-session-player-character! player-id player-character)
                   (+! player-id (the uint 1)))
                 (set! valid? #f))))
           (if (zero? character) (set! done? #t) (begin   (set! cursor (&-> cursor 1))   (set! token-start cursor))))
          (else (set! cursor (&-> cursor 1))))))
    valid?))

(defun mp-load-max-players-from-cli! ()
  (let ((max-players-arg (pc-multi-get-command-line-arg "-max-players")))
    (when (and max-players-arg
               (nonzero? (the-as uint max-players-arg))
               (nonzero? (-> max-players-arg allocated-length)))
      (let ((parsed-limit (string->int max-players-arg)))
        (if (and (>= parsed-limit 2) (<= parsed-limit MP_MAX_PLAYERS))
          (mp-set-session-player-limit! (the-as uint parsed-limit))
          (format #t
                  "[MP-Session] WARNING: Invalid -max-players value '~A', keeping limit ~D~%"
                  max-players-arg
                  *mp-session-player-limit*)))))
  (none))

(defun mp-load-session-characters-from-cli! ()
  (let ((characters-arg (pc-multi-get-command-line-arg "-mp-characters")))
    (when (and characters-arg (nonzero? (the-as uint characters-arg)) (nonzero? (-> characters-arg allocated-length)))
      (if (not (mp-parse-session-characters-cli! characters-arg))
        (format #t "[MP-Session] WARNING: Invalid -mp-characters value; keeping current character settings.~%"))))
  (none))

(defun mp-session-migrate-local-player! ((local-player-id uint))
  (when (and *mp-player-controller* (nonzero? *mp-player-controller*) (mp-player-id-valid? local-player-id))
    (let ((previous-local-id (-> *mp-player-controller* local-player-id)))
      (when (and (mp-player-id-valid? previous-local-id) (!= previous-local-id local-player-id))
        (mp-player-controller-reassign-local! *mp-player-controller* local-player-id)
        (log 'debug "[MP-Session] Migrated local player record from ~D to ~D.~%" previous-local-id local-player-id))))
  (none))

(defun mp-session-update-local-player-record! ((local-player-id uint) (local-character mp-player-character))
  (when (and *mp-player-controller*
             (nonzero? *mp-player-controller*)
             (mp-player-id-valid? local-player-id)
             (mp-player-character-valid? local-character))
    (when (not (mp-local-player-record))
      (mp-player-controller-register! *mp-player-controller* local-player-id local-character)
      (log 'debug "[MP-Session] Registered local player ~D (character ~D).~%" local-player-id local-character))
    (let ((local-record (mp-local-player-record)))
      (when (and local-record (nonzero? local-record))
        (set! (-> local-record identity character) local-character)
        (when (not (mp-player-color-progress-active?))
          (pc-multi-get-player-appearance (-> local-record identity appearance))))))
  (none))

(defun mp-session-ensure-local-player! ()
  (let ((local-player-id (pc-multi-get-local-player-id))
        (host-player-id (pc-multi-get-host-player-id))
        (local-character (the-as mp-player-character (pc-multi-get-local-player-character))))
    (when (and *mp-player-controller*
               (nonzero? *mp-player-controller*)
               (mp-player-id-valid? local-player-id)
               (mp-player-id-valid? host-player-id)
               (mp-player-character-valid? local-character))
      (mp-session-migrate-local-player! local-player-id)
      (set! (-> *mp-player-controller* local-player-id) local-player-id)
      (set! (-> *mp-player-controller* host-player-id) host-player-id)
      (mp-session-update-local-player-record! local-player-id local-character)
      (when (and *target* (nonzero? *target*))
        (mp-player-controller-bind-target! *mp-player-controller* local-player-id *target*))))
  (none))

(defun mp-session-identity-refresh-status? ((status mp-connection-status))
  (or (= status (mp-connection-status connecting))
      (= status (mp-connection-status lobby))
      (= status (mp-connection-status game-starting))
      (= status (mp-connection-status in-game))
      (= status (mp-connection-status reconnecting))
      (= status (mp-connection-status host-left))))

(defun mp-session-refresh-bridge-identity! ((status mp-connection-status))
  (when (mp-session-identity-refresh-status? status)
    (mp-session-ensure-local-player!))
  (none))

(defun mp-set-local-bootstrap-phase! ((bootstrap-phase uint))
  (when (nonnull? *mp-bootstrap-state*)
    (set! (-> *mp-bootstrap-state* phase) bootstrap-phase))
  (none))

(defun mp-arm-spawn-sync-state! ((status mp-connection-status))
  (when (>= status (mp-connection-status connecting))
    (if (mp-session-host?)
      (begin
        (when (or (= status (mp-connection-status connecting)) (= status (mp-connection-status game-starting)))
          (log 'debug "[MP-Session] Host world is ready; activating the session.~%")
          (mp-pack-local-world-snapshot!)
          (mp-set-local-bootstrap-phase! (the uint 1))
          (mp-network-exchange-state! status)
          (pc-multi-session-enter-game))
        (mp-arm-mission-failed-bootstrap-after-spawn))
      (begin
        (when (and (nonnull? *mp-bootstrap-state* (mp-local-player-record))
                   (= status (mp-connection-status in-game))
                   (zero? (-> *mp-bootstrap-state* phase)))
          (mp-arm-mission-failed-bootstrap-after-spawn)))))
  (none))

(defun mp-session-host-game-start! ()
  (run-async-task :tag 'mp-host-game
                  :timeout 3000
                  :poll
                  (lambda ((task async-task) (owner process))
                    (let ((status (pc-multi-get-session-status)))
                      (cond
                        ((mp-session-status-terminal? status) 'fail)
                        ((= status (mp-connection-status in-game)) 'success)
                        (else
                         (when (and (= (-> task user-data) 0)
                                    (or (= status (mp-connection-status connecting))
                                        (= status (mp-connection-status game-starting)))
                                    (nonnull? *target* (mp-local-player-record)))
                           (log 'debug "[MP-Host] Host world ready; entering game.~%")
                           (set! (-> task user-data) (the uint 1))
                           (mp-pack-local-world-snapshot!)
                           (mp-set-local-bootstrap-phase! (the uint 1))
                           (mp-network-exchange-state! status)
                           (pc-multi-session-enter-game)
                           (mp-arm-mission-failed-bootstrap-after-spawn))
                         'continue))))
                  :on-fail
                  (lambda ((task async-task) (owner process) (reason symbol))
                    (log 'warn "[MP-Host] Host game startup failed (reason ~A).~%" reason)))
  (none))

(defun mp-start-host-from-cli! ((internet-host? symbol))
  (log 'debug "[MP-Session] Hosting via CLI argument.~%")
  (when (nonnull? *pc-settings*)
    (set! (-> *pc-settings* is-host?) #t)
    (set! (-> *pc-settings* is-host-online?) internet-host?))
  (mp-sync-preferences-to-session-host-config!)
  (mp-load-max-players-from-cli!)
  (mp-load-session-characters-from-cli!)
  (mp-configure-bridge-version!)
  (mp-setup-host-bridge! internet-host?)
  (mp-session-host-game-start!)
  (mp-set-local-bootstrap-phase! (the uint 1))
  (none))

(defun mp-client-port-from-cli ()
  (let ((port-arg (pc-multi-get-command-line-arg "-mp-client-port")))
    (if (and port-arg (nonzero? (the-as uint port-arg)) (nonzero? (-> port-arg allocated-length)))
      (string->int port-arg)
      (pc-multi-get-host-port))))

(defun mp-session-client-game-start! ()
  (run-async-task :tag 'mp-client-game
                  :timeout 600
                  :poll
                  (lambda ((task async-task) (owner process))
                    (let ((status (pc-multi-get-session-status)))
                      (cond
                        ((mp-session-status-terminal? status) 'fail)
                        ((= status (mp-connection-status in-game)) 'success)
                        (else 'continue))))
                  :on-fail
                  (lambda ((task async-task) (owner process) (reason symbol))
                    (log 'warn "[MP-Client] Client game startup failed (reason ~A).~%" reason)))
  (none))

(defun mp-start-client-from-cli! ((client-arg string))
  (log 'debug "[MP-Session] Starting client via CLI argument.~%")
  (mp-clear-version-mismatch-ui!)
  (mp-configure-bridge-version!)
  (pc-multi-setup-client client-arg (mp-client-port-from-cli))
  (mp-session-client-game-start!)
  (none))

(defun mp-start-host-from-settings! ()
  (log 'debug "[MP-Session] Hosting mode active (from settings). Initializing server...~%")
  (mp-sync-preferences-to-session-host-config!)
  (mp-configure-bridge-version!)
  (if (and *pc-settings* (nonzero? (the-as uint *pc-settings*)) (-> *pc-settings* is-host-online?))
    (mp-setup-host-bridge! #t)
    (mp-setup-host-bridge! #f))
  (mp-session-host-game-start!)
  (mp-set-local-bootstrap-phase! (the uint 1))
  (none))

(define-perm *mp-cli-auto-start-attempted?* symbol #f)

(defun mp-auto-start-session-on-spawn! ((status mp-connection-status))
  (when (and (= status (mp-connection-status idle)) (not *mp-cli-auto-start-attempted?*))
    (set! *mp-cli-auto-start-attempted?* #t)
    (let ((host-arg (pc-multi-get-command-line-arg "-mp-host"))
          (client-arg (pc-multi-get-command-line-arg "-mp-client")))
      (cond
        ((and host-arg (nonzero? (the-as uint host-arg)) (nonzero? (-> host-arg allocated-length)))
         (mp-start-host-from-cli! (string= host-arg "internet")))
        ((and client-arg (nonzero? (the-as uint client-arg)) (nonzero? (-> client-arg allocated-length)))
         (mp-start-client-from-cli! client-arg))
        ((and (nonnull? *pc-settings*) (-> *pc-settings* is-host?)) (mp-start-host-from-settings!)))))
  (none))

(defun mp-on-local-spawn! ()
  (mp-traffic-clear-death-spectate-state!)
  (let ((initial-status (pc-multi-get-session-status)))
    (mp-auto-start-session-on-spawn! initial-status)
    (let ((status (pc-multi-get-session-status)))
      (mp-session-refresh-bridge-identity! status)
      (mp-bootstrap-controller-start!)
      (mp-bootstrap-note-local-spawn! status)
      (mp-death-respawn-event-on-spawn!)
      (mp-arm-spawn-sync-state! status))
    (mp-demo-guard-on-local-spawn!))
  (none))

(defun mp-reset-session-state! ()
  (cancel-all-async-tasks!)
  (mp-bootstrap-controller-reset!)
  (mp-reset-orb-permanence-state!)
  (mp-reset-gem-permanence-state!)
  (set! *mp-reconnect-menu-active?* #f)
  (set! *mp-host-left-menu-active?* #f)
  (mp-reconnect-reset-state!)
  (mp-clear-version-mismatch-ui!)
  (mp-spectate-reset!)
  (mp-traffic-clear-death-spectate-state!)
  (set! *mp-death-party-wipe-pending?* #f)
  (mp-reset-respawn-policy!)
  (mp-tomb-boulder-reset-state!)
  (none))

(defun mp-enter-host-left-terminal-state! ()
  (reset-replica-state!)
  (mp-reset-remote-marker-state!)
  (mp-for-each-player-record (player-id record)
    (when (is-record-remote-player? record)
      (set! (-> record connection activity) (mp-player-activity unavailable))
      (set! (-> record action darkjak-stage) (the uint 0))
      (set! (-> record action authoritative-sequence) (the uint 0))
      (set! (-> record action action-state-id) (the uint 0))
      (set! (-> record input buttons) (the-as uint16 0))
      (set! (-> record action respawn-flags) (the uint8 0))))
  (none))

(defun mp-update-host-left-ui! ((status mp-connection-status))
  (when (and (= status (mp-connection-status host-left)) (not *mp-host-left-menu-active?*))
    (sync-path 0 0)
    (mp-enter-host-left-terminal-state!)
    (when (and *dproc* (nonzero? (the-as uint *dproc*)))
      (log 'debug "[MP-Session] Host has left the session. Activating Host Left screen.~%")
      (activate-progress *dproc* 'host-left)
      (set! *mp-host-left-menu-active?* #t)))
  (none))

(defun mp-show-version-mismatch-ui! ()
  (when (mp-cache-required-version!)
    (cond
      ((and *progress-process* (nonzero? (the-as uint *progress-process*)))
       (let ((progress-obj (-> *progress-process* 0)))
         (when (and progress-obj (nonzero? (the-as uint progress-obj)))
           (set! *mp-version-mismatch-menu-active?* #t)
           (sound-play "menu-error")
           (set-next-state progress-obj 'version-mismatch 0))))
      ((and *dproc* (nonzero? (the-as uint *dproc*)))
       (set! *mp-version-mismatch-menu-active?* #t)
       (sound-play "menu-error")
       (activate-progress *dproc* 'version-mismatch))))
  (none))

(defun mp-update-version-mismatch-ui! ((status mp-connection-status))
  (when (and (mp-session-version-mismatch?) (not *mp-version-mismatch-menu-active?*))
    (mp-show-version-mismatch-ui!))
  (none))

(defun mp-connect-discovered-host-if-ready! ((status mp-connection-status))
  (when (and (nonzero? (pc-multi-discovery-result-available)) (not (async-task-active? 'mp-connect-found-host)))
    (pc-multi-connect-found-host)
    (run-async-task :tag 'mp-connect-found-host
                    :timeout 300
                    :poll
                    (lambda ((task async-task) (owner process))
                      (let ((st (pc-multi-get-session-status)))
                        (cond
                          ((mp-session-status-terminal? st) 'fail)
                          ((or (= st (mp-connection-status connecting)) (>= st (mp-connection-status lobby))) 'success)
                          (else 'continue))))))
  status)

(defun mp-bootstrap-controller-session-status? ((status mp-connection-status))
  (or (= status (mp-connection-status lobby))
      (= status (mp-connection-status game-starting))
      (= status (mp-connection-status in-game))
      (= status (mp-connection-status reconnecting))))

(defun mp-session-ensure-bootstrap-controller! ((status mp-connection-status))
  (let ((local-record (mp-local-player-record)))
    (when (and (mp-session-client?) (mp-bootstrap-controller-session-status? status) (nonnull? local-record))
      (mp-bootstrap-controller-start!)))
  (none))

(defun mp-session-tick ()
  (let ((status (mp-connect-discovered-host-if-ready! (pc-multi-get-session-status))))
    (when (not (= status (mp-connection-status in-game)))
      (mp-clear-remote-respawn-policy!))
    (when (or (< status (mp-connection-status connecting))
              (= status (mp-connection-status reconnecting))
              (= status (mp-connection-status host-left)))
      (mp-scene-coordinator-clear-catchup-audience!))
    (let ((active? (or (= status (mp-connection-status connecting))
                       (= status (mp-connection-status lobby))
                       (= status (mp-connection-status game-starting))
                       (= status (mp-connection-status in-game))
                       (= status (mp-connection-status reconnecting))
                       (= status (mp-connection-status host-left)))))
      (when active?
        (set! status (pc-multi-get-session-status))
        (mp-session-refresh-bridge-identity! status))
      (mp-network-exchange-state! status)
      (if active?
        (begin
          (mp-refresh-player-render-appearances!)
          (set! status (pc-multi-get-session-status))
          (mp-session-ensure-bootstrap-controller! status)
          (when (and (mp-bootstrap-in-progress?) (nonnull? *target* (-> *target* control)))
            (target-timed-invulnerable (seconds 0.1) *target* 1)
            (vector-reset! (-> *target* control transv)))
          (when (not (= status (mp-connection-status in-game)))
            (mp-clear-remote-respawn-policy!))
          (mp-reconnect-observe-status! status)
          (mp-tomb-boulder-note-session-status! status))
        (begin
          (when (nonnull? *mp-player-controller*)
            (mp-player-controller-reset! *mp-player-controller*))
          (return #f))))
    #t))

(defun mp-sync-scene-tick ()
  (mp-handle-scene-transition)
  (mp-process-pending-scene-sync!)
  (mp-process-scene-sync-target-hold!)
  (mp-scene-coordinator-tick!)
  (mp-complete-active-host-scene-skip-if-ready!)
  (none))

(defun mp-update-synchronized-gameplay-state! ()
  (mp-sync-clock-host)
  (mp-sync-clock-client)
  (mp-request-mission-failed-bootstrap-when-ready)
  (none))

(defun mp-apply-synchronized-gameplay-state! ()
  (mp-resolve-local-vehicle-seat-conflict!)
  (manage-remote-replicas!)
  (mp-extract-local-stats)
  (mp-apply-remote-world-state)
  (mp-apply-remote-environment-state)
  (mp-process-inbound-events)
  (mp-battle-sync-tick (pc-multi-get-session-status))
  (mp-waypoint-sync-tick)
  (when (not (or (movie?) *scene-player*))
    (mp-sync-enemies-update))
  (mp-tomb-daxter-wait-update!)
  (mp-update-traffic-authority)
  (mp-sync-traffic-update)
  (mp-for-each-player-target (player-id record player-target)
    (when (is-record-remote-player? record)
      (mp-process-pending-edge-grab! player-target)))
  #t)

(defun mp-debug-draw-synced-tick ()
  (mp-draw-battle-debug)
  (mp-draw-task-debug)
  (mp-draw-traffic-debug)
  (draw-replica-debug)
  (mp-draw-gun-debug)
  (mp-draw-airlock-debug)
  (mp-draw-elevator-debug)
  (mp-draw-boss-debug)
  (mp-draw-boss-debug-overlay)
  (respawn-policy-debug-draw)
  (none))

(defun mp-ui-trigger-tick ()
  (let ((status (pc-multi-get-session-status)))
    (mp-update-reconnect-ui! status)
    (mp-update-host-left-ui! status)
    (mp-update-version-mismatch-ui! status))
  (mp-demo-guard-tick)
  (none))

(defun mp-reset-gameplay-state ()
  (mp-reset-event-state!)
  (mp-reset-scene-sync-state!)
  (reset-replica-state!)
  (mp-reset-player-sync-state!)
  (mp-reset-enemy-state!)
  (mp-reset-battle-sync-state!)
  (mp-reset-traffic-state!)
  (mp-reset-airlock-state!)
  (mp-reset-waypoint-state!)
  (mp-reset-remote-marker-state!)
  (mp-reset-environment-sync)
  (mp-tomb-daxter-wait-reset!)
  (mp-player-list-hide!)
  (eye-control-reset-all!)
  (mp-bootstrap-controller-reset!)
  (none))

(defun mp-reset-state ()
  (set! *mp-cli-auto-start-attempted?* #t)
  (when (nonnull? *pc-settings*)
    (set! (-> *pc-settings* is-host?) #f))
  (mp-reset-session-state!)
  (mp-reset-gameplay-state)
  (log 'debug "[MP] State has been fully reset.~%")
  (none))
