;;-*-Lisp-*-
(in-package goal)

;; name: mp-session.gc
;; name in dgo: mp-session

(define-extern mp-network-sync-window-tick (function none))
(define-extern *dproc* process)
(define-extern activate-progress (function process symbol none))
(define-extern activate-progress (function process symbol none))
(define-extern mp-demo-guard-tick (function none))
(define-extern mp-demo-guard-on-local-spawn! (function none))

(defun mp-client-ready-to-enable-sync-on-spawn? ((status int))
  (and *local-info*
       (nonzero? (the-as uint *local-info*))
       (= (-> *local-info* role) 1)
       (= status 6)
       (zero? (-> *local-info* sync-flag)))
  )

(defun mp-set-local-sync-flag! ((sync-flag uint))
  (when (and *local-info* (nonzero? (the-as uint *local-info*)))
    (set! (-> *local-info* sync-flag) (the-as uint sync-flag))
    )
  (none))

(defun mp-enable-sync-after-spawn! ((status int))
  (cond
    ((and *local-info*
          (nonzero? (the-as uint *local-info*))
          (= (-> *local-info* role) 1))
     (if (mp-client-ready-to-enable-sync-on-spawn? status)
         (begin
           (set! *multi-sync-enabled?* #t)
           (format 0 "[GOAL] Client spawned in-game after full sync. Enabling multiplayer sync.~%")
           )
         (begin
           (set! *multi-sync-enabled?* #f)
           (format 0 "[GOAL] Client spawned before full sync completion. Keeping multiplayer sync disabled.~%")
           )
         )
     )
    (else
     (set! *multi-sync-enabled?* #t)
     (format 0 "[GOAL] Jak spawned! Enabling multiplayer sync.~%")
     )
    )
  (none))

(defun mp-arm-spawn-sync-state! ((status int))
  (when (>= status 3)
    (if (mp-is-jak?)
        (begin
          (pc-multi-set-status 6)
          (set! *multi-last-send-time* 0)
          (mp-arm-mission-failed-full-sync-after-spawn)
          )
        (begin
          (when (and *local-info*
                     (nonzero? (the-as uint *local-info*))
                     (= status 6)
                     (zero? (-> *local-info* sync-flag)))
            (set! *multi-last-send-time* 0)
            (mp-arm-mission-failed-full-sync-after-spawn)
            )
          )
        )
    )
  (none))

(defun mp-start-host-from-cli! ()
  (format 0 "[MP-Auto] Hosting via CLI argument.~%")
  (pc-multi-setup-host)
  (pc-multi-set-status 6)
  (mp-set-local-sync-flag! (the uint 1))
  (none))

(defun mp-start-client-from-cli! ((client-arg string))
  (format 0 "[MP-Auto] Connecting via CLI argument.~%")
  (pc-multi-setup-client client-arg 26210)
  (none))

(defun mp-start-host-from-settings! ()
  (format 0 "[MP-Host] Hosting mode active (from settings). Initializing server...~%")
  (pc-multi-setup-host)
  (mp-set-local-sync-flag! (the uint 1))
  (none))

(defun mp-auto-start-session-on-spawn! ((status int))
  (when (zero? status)
    (let ((host-arg (pc-multi-get-command-line-arg "-mp-host"))
          (client-arg (pc-multi-get-command-line-arg "-mp-client")))
      (cond
        ((and host-arg (nonzero? (the-as uint host-arg)) (nonzero? (-> host-arg allocated-length)))
         (mp-start-host-from-cli!)
         )
        ((and client-arg (nonzero? (the-as uint client-arg)) (nonzero? (-> client-arg allocated-length)))
         (mp-start-client-from-cli! client-arg)
         )
        ((and *pc-settings*
              (nonzero? (the-as uint *pc-settings*))
              (-> *pc-settings* mp-hosting-mode?))
         (mp-start-host-from-settings!)
         )
        )
      )
    )
  (none))

(defun mp-on-local-spawn! ()
  (let ((status (pc-multi-get-status)))
    (mp-enable-sync-after-spawn! status)
    (mp-arm-spawn-sync-state! status)
    (mp-auto-start-session-on-spawn! status)
    (mp-demo-guard-on-local-spawn!)
    )
  (none))

(defun mp-reset-session-state! ()
  (set! *multi-sync-enabled?* #f)
  (set! *mp-reconnect-menu-active?* #f)
  (set! *mp-host-left-menu-active?* #f)
  (set! *mp-reconnect-process* (the-as handle #f))
  (set! *multi-last-send-time* (the-as time-frame 0))
  (none))

(defun mp-auto-enable-sync-if-ready! ((status int))
  (when (and (= status 6)
             (not *multi-sync-enabled?*)
             (not (and (mp-is-daxter?) (nonzero? (-> *local-info* sync-flag)))))
    (if (mp-is-jak?)
        (format 0 "[MP-Host] Auto-enabling sync as Host in game...~%")
        (format 0 "[MP-Client] Auto-enabling sync as Client in game...~%")
        )
    (set! *multi-sync-enabled?* #t)
    )
  (none))

(defun mp-close-reconnect-ui-if-active! ()
  (when *mp-reconnect-menu-active?*
    (format 0 "[MP-UI] Connection restored. Closing Reconnect screen smoothly.~%")
    (when (and *progress-process* (nonzero? (the-as uint *progress-process*)))
      (set-next-state (-> *progress-process* 0) 'go-away 0)
      )
    (set! *mp-reconnect-menu-active?* #f)
    )
  (none))

(defun mp-update-reconnect-ui! ((status int))
  (if (= status 7)
      (begin
        (when (and (not *mp-reconnect-menu-active?*)
                   *dproc*
                   (nonzero? (the-as uint *dproc*)))
          (format 0 "[MP-UI] Connection lost. Activating Reconnect screen.~%")
          (activate-progress *dproc* 'reconnect)
          (set! *mp-reconnect-menu-active?* #t)
          )
        )
      (mp-close-reconnect-ui-if-active!)
      )
  (none))

(defun mp-update-host-left-ui! ((status int))
  (when (and (= status 8)
             (not *mp-host-left-menu-active?*)
             *dproc*
             (nonzero? (the-as uint *dproc*)))
    (format 0 "[MP-UI] Host has left the session. Activating Host Left screen.~%")
    (activate-progress *dproc* 'host-left)
    (set! *mp-host-left-menu-active?* #t)
    )
  (none))

(defun mp-session-tick ()
  (let ((status (pc-multi-get-status)))
    (when (or (< status 3) (= status 7) (= status 8))
      (mp-clear-connected-scene-broadcast!)
      )
    (mp-auto-enable-sync-if-ready! status)
    (if (or (= status 3) (= status 4) (= status 5) (= status 6) (= status 7) (= status 8))
        (begin
          (pc-multi-poll (the-as uint *local-info*) (the-as uint *remote-info*))
          (pc-multi-receive-state (the-as uint *remote-info*))
          (set! (-> *local-info* role) (pc-multi-get-role))
          )
        (begin
          (set! (-> *local-info* role) -1)
          (return #f)
          )
        )
    (mp-update-reconnect-ui! status)
    (mp-update-host-left-ui! status)
    #t
    ))

(defun mp-sync-scene-tick ()
  (mp-handle-full-sync-state)
  (mp-handle-scene-transition)
  (mp-process-pending-scene-sync!)
  (mp-process-scene-sync-target-hold!)
  (mp-log-client-blackout-diag!)
  (none))

(defun mp-update-debug-loss! ()
  (if *mp-debug-simulate-loss?*
      (begin
        (if (zero? *mp-debug-simulate-loss-time*)
            (set! *mp-debug-simulate-loss-time* (current-time)))
        (when (>= (- (current-time) *mp-debug-simulate-loss-time*) (seconds 60))
          (format 0 "[MP-Debug] Auto-restoring connection after 30s timeout.~%")
          (set! *mp-debug-simulate-loss?* #f)
          (set! *mp-debug-simulate-loss-time* 0)
          )
        )
      (begin
        (set! *mp-debug-simulate-loss-time* 0)
        )
      )
  (pc-multi-debug-stop-receive (if *mp-debug-simulate-loss?* (the uint 1) (the uint 0)))
  (none))

(defun mp-update-send-clock! ((current-ticks uint))
  (let ((interval (the uint64 (/ 1000 *multi-sync-tps*))))
    (if (> (- current-ticks (the uint64 *multi-last-send-time*)) (* 2 interval))
        (set! *multi-last-send-time* (the-as time-frame current-ticks))
        (+! *multi-last-send-time* (the-as time-frame interval))
        )
    )
  (none))

(defun mp-update-tps-counter! ()
  (+! *mp-tps-counter* 1)
  (when (>= (- (current-time) *mp-tps-timer*) (seconds 1))
    (set! *mp-actual-tps* *mp-tps-counter*)
    (set! *mp-tps-counter* (the uint 0))
    (+! *mp-tps-timer* (seconds 1))
    )
  (none))

(defun mp-send-tick ()
  (mp-sync-clock-host)
  (mp-sync-clock-client)
  (mp-update-debug-loss!)
  (mp-request-mission-failed-full-sync-when-ready)
  (let ((current-ticks (pc-multi-get-ticks)))
    (when (and (not *mp-debug-simulate-loss?*)
               (>= (- current-ticks (the uint64 *multi-last-send-time*))
                   (the uint64 (/ 1000 *multi-sync-tps*))))
      (mp-update-send-clock! current-ticks)
      (mp-update-tps-counter!)
      (mp-network-sync-window-tick)
      )
    )
  (none))

(defun mp-receive-tick ()
  (if (not *multi-sync-enabled?*)
      (return #f))
  (pc-multi-receive-events (the-as uint *mp-event-buffer*))
  (pc-multi-receive-enemies (the-as uint *mp-enemy-buffer*))
  (when (and *mp-enemy-buffer* (nonzero? (the-as uint *mp-enemy-buffer*)))
    (set! (-> *mp-enemy-buffer* last-sync-time) (pc-multi-get-enemy-sync-time))
    )
  (mp-manage-remote-puppet)
  (mp-extract-local-stats)
  (mp-stadium-board1-tick)
  (mp-apply-remote-world-state)
  (mp-apply-remote-environment-state)
  (mp-process-inbound-events)
  (mp-waypoint-sync-tick)
  (mp-update-role-transformation)
  (mp-update-death-spectate)
  (mp-update-ai-targeting)
  (mp-update-player-visibility)
  (mp-update-traffic-authority)
  (mp-sync-traffic-update)
  #t
  )

(defun mp-debug-draw-synced-tick ()
  (mp-draw-enemy-debug)
  (mp-draw-battle-debug)
  (mp-draw-task-debug)
  (mp-draw-traffic-debug)
  (mp-draw-puppet-debug)
  (mp-draw-eye-debug)
  (mp-draw-gun-debug)
  (mp-draw-network-debug)
  (mp-draw-airlock-debug)
  (mp-draw-elevator-debug)
  (mp-draw-boss-debug)
  (mp-draw-boss-debug-overlay)
  (none))

(defun mp-debug-draw-tick ()
  (mp-draw-level-debug)
  (when *multi-sync-enabled?*
    (mp-debug-draw-synced-tick)
    )
  (none))

(defun mp-ui-trigger-tick ()
  (mp-demo-guard-tick)
  (none))

(defun mp-frame-tick ()
  "High-frequency multiplayer frame scheduler."
  (with-pp
    (if (or (not *local-info*) (not *remote-info*) (not *mp-event-buffer*))
        (return #f))
    (if (not (mp-session-tick))
        (return #f))
    (mp-ui-trigger-tick)
    (mp-sync-scene-tick)
    (mp-send-tick)
    (mp-receive-tick)
    (mp-debug-draw-tick)
    (none)))
