;;-*-Lisp-*-
(in-package goal)

;; name: mp-session.gc
;; name in dgo: mp-session

(define-extern mp-network-sync-window-tick (function object none))
(define-extern *dproc* process)
(define-extern activate-progress (function process symbol none))
(define-extern mp-demo-guard-tick (function none))
(define-extern mp-demo-guard-on-local-spawn! (function none))

(defun mp-character-cli-whitespace? ((character uint))
  (or (= character (the uint 32))
      (= character (the uint 9))
      (= character (the uint 13))
      (= character (the uint 10))))

(defun mp-character-cli-letter? ((character uint) (lowercase uint))
  (or (= character lowercase)
      (= character (- lowercase (the uint 32)))))

(defun mp-character-from-cli-token
       ((token-start (pointer uint8)) (token-end (pointer uint8)))
  (while (and (< (the-as uint token-start) (the-as uint token-end))
              (mp-character-cli-whitespace? (the-as uint (-> token-start 0))))
    (set! token-start (&-> token-start 1)))
  (while (and (< (the-as uint token-start) (the-as uint token-end))
              (mp-character-cli-whitespace?
                (the-as uint (-> token-end -1))))
    (set! token-end (&-> token-end -1)))
  (let ((token-length (&- token-end (the-as uint token-start))))
    (cond
      ((and (= token-length (the uint 3))
            (mp-character-cli-letter? (the-as uint (-> token-start 0)) (the uint 106))
            (mp-character-cli-letter? (the-as uint (-> token-start 1)) (the uint 97))
            (mp-character-cli-letter? (the-as uint (-> token-start 2)) (the uint 107)))
       (mp-player-character jak))
      ((and (= token-length (the uint 6))
            (mp-character-cli-letter? (the-as uint (-> token-start 0)) (the uint 100))
            (mp-character-cli-letter? (the-as uint (-> token-start 1)) (the uint 97))
            (mp-character-cli-letter? (the-as uint (-> token-start 2)) (the uint 120))
            (mp-character-cli-letter? (the-as uint (-> token-start 3)) (the uint 116))
            (mp-character-cli-letter? (the-as uint (-> token-start 4)) (the uint 101))
            (mp-character-cli-letter? (the-as uint (-> token-start 5)) (the uint 114)))
       (mp-player-character daxter))
      (else (mp-player-character unknown)))))

(defun mp-parse-session-characters-cli! ((characters-arg string))
  (when (or (not characters-arg) (zero? (the-as uint characters-arg)))
    (return #f))
  (let ((token-start (-> characters-arg data))
        (cursor (-> characters-arg data))
        (player-id (the uint 0))
        (valid? #t)
        (done? #f))
    (while (and valid? (not done?))
      (let ((character (the-as uint (-> cursor 0))))
        (cond
          ((or (zero? character) (= character (the uint 44)))
           (if (>= player-id (the uint MP_MAX_PLAYERS))
               (set! valid? #f)
               (let ((player-character
                       (mp-character-from-cli-token token-start cursor)))
                 (if (mp-player-character-valid? player-character)
                     (begin
                       (mp-set-session-player-character! player-id player-character)
                       (+! player-id (the uint 1)))
                     (set! valid? #f))))
           (if (zero? character)
               (set! done? #t)
               (begin
                 (set! cursor (&-> cursor 1))
                 (set! token-start cursor))))
          (else
           (set! cursor (&-> cursor 1))))))
    valid?))

(defun mp-load-session-characters-from-cli! ()
  (mp-reset-session-player-characters!)
  (let ((characters-arg (pc-multi-get-command-line-arg "-mp-characters")))
    (when (and characters-arg
               (nonzero? (the-as uint characters-arg))
               (not (mp-parse-session-characters-cli! characters-arg)))
      (mp-reset-session-player-characters!)
      (format #t
        "[MP-Session] WARNING: Invalid -mp-characters value; using alternating defaults.~%")))
  (none))

(defun mp-client-ready-to-enable-sync-on-spawn? ((status mp-connection-status))
  (and *mp-bootstrap-state*
       (nonzero? (the-as uint *mp-bootstrap-state*))
       (mp-local-player-record)
       (nonzero? (the-as uint (mp-local-player-record)))
       (mp-session-client?)
       (= status (mp-connection-status in-game))
       (zero? (-> *mp-bootstrap-state* phase)))
  )

(defun mp-set-local-sync-flag! ((sync-flag uint))
  (when (and *mp-bootstrap-state*
             (nonzero? (the-as uint *mp-bootstrap-state*))
             (mp-local-player-record)
             (nonzero? (the-as uint (mp-local-player-record))))
    (set! (-> *mp-bootstrap-state* phase) (the-as uint sync-flag))
    )
  (none))

(defun mp-session-ensure-local-player! ()
  (let ((local-player-id (pc-multi-get-local-player-id))
        (host-player-id (pc-multi-get-host-player-id))
        (local-character
          (the-as mp-player-character (pc-multi-get-local-player-character))))
    (when (and *mp-player-controller*
               (nonzero? *mp-player-controller*)
               (mp-player-id-valid? local-player-id)
               (mp-player-character-valid? local-character))
      (let ((previous-local-id (-> *mp-player-controller* local-player-id)))
        (when (and (mp-player-id-valid? previous-local-id)
                   (!= previous-local-id local-player-id))
          (mp-player-controller-reassign-local!
            *mp-player-controller* local-player-id)
          (debug-log *mp-debug-log?*
            "[MP-Session] Migrated local player record from ~D to ~D.~%"
            previous-local-id
            local-player-id)))
      (set! (-> *mp-player-controller* local-player-id) local-player-id)
      (when (mp-player-id-valid? host-player-id)
        (set! (-> *mp-player-controller* host-player-id) host-player-id))
      (when (not (mp-local-player-record))
        (mp-player-controller-register!
          *mp-player-controller*
          local-player-id
          local-character)
        (debug-log *mp-debug-log?*
          "[MP-Session] Registered local player ~D (character ~D, role ~D).~%"
          local-player-id
          local-character
          *mp-session-role*))
      (let ((local-record (mp-local-player-record)))
        (when (and local-record (nonzero? local-record))
          (set! (-> local-record identity character) local-character)))
      (when (and *target* (nonzero? *target*))
        (mp-player-controller-bind-target!
          *mp-player-controller*
          local-player-id
          *target*))))
  (none))

(defun mp-session-role-refresh-status? ((status mp-connection-status))
  (or (= status (mp-connection-status connecting))
      (= status (mp-connection-status connected-lobby))
      (= status (mp-connection-status game-starting))
      (= status (mp-connection-status in-game))
      (= status (mp-connection-status reconnecting))
      (= status (mp-connection-status host-left))))

(defun mp-session-refresh-bridge-identity! ((status mp-connection-status))
  "Refresh role before classifying a spawn, then materialize its assigned local record."
  (if (mp-session-role-refresh-status? status)
      (begin
        (set! *mp-session-role* (the-as mp-session-role (pc-multi-get-role)))
        (mp-session-ensure-local-player!))
      (set! *mp-session-role* (mp-session-role none)))
  (none))

(defun mp-enable-sync-after-spawn! ((status mp-connection-status))
  (cond
    ((mp-session-client?)
     (if (mp-client-ready-to-enable-sync-on-spawn? status)
         (begin
           (set! *multi-sync-enabled?* #t)
           (debug-log *mp-debug-log?* "[MP-Session] Client spawned in-game after bootstrap. Enabling multiplayer sync.~%")
           )
         (begin
           (set! *multi-sync-enabled?* #f)
           (debug-log *mp-debug-log?* "[MP-Session] Client spawned before bootstrap completion. Keeping multiplayer sync disabled.~%")
           )
         )
     )
    ((mp-session-host?)
     (if (or (= status (mp-connection-status connecting))
             (= status (mp-connection-status game-starting))
             (= status (mp-connection-status in-game)))
         (begin
           (set! *multi-sync-enabled?* #t)
           (debug-log *mp-debug-log?*
             "[MP-Session] Host player spawned! Enabling multiplayer sync.~%"))
         (set! *multi-sync-enabled?* #f))
     )
    (else
     (set! *multi-sync-enabled?* #f)
     )
    )
  (none))

(defun mp-arm-spawn-sync-state! ((status mp-connection-status))
  (when (>= status (mp-connection-status connecting))
    (if (mp-session-host?)
        (begin
          (when (or (= status (mp-connection-status connecting))
                    (= status (mp-connection-status game-starting)))
            (debug-log *mp-debug-log?*
              "[MP-Session] Host world is ready; activating the session.~%")
            (pc-multi-set-status (mp-connection-status in-game)))
          (set! *multi-last-send-time* 0)
          (mp-arm-mission-failed-bootstrap-after-spawn)
          )
        (begin
          (when (and *mp-bootstrap-state*
                     (nonzero? (the-as uint *mp-bootstrap-state*))
                     (mp-local-player-record)
                     (nonzero? (the-as uint (mp-local-player-record)))
                     (= status (mp-connection-status in-game))
                     (zero? (-> *mp-bootstrap-state* phase)))
            (set! *multi-last-send-time* 0)
            (mp-arm-mission-failed-bootstrap-after-spawn)
            )
          )
        )
    )
  (none))

(defun mp-start-host-from-cli! ((internet-host? symbol))
  (debug-log *mp-debug-log?* "[MP-Session] Hosting via CLI argument.~%")
  (mp-load-session-characters-from-cli!)
  (mp-configure-bridge-version!)
  (mp-setup-host-bridge! internet-host?)
  (mp-set-local-sync-flag! (the uint 1))
  (none))

(defun mp-client-port-from-cli ()
  (let ((port-arg (pc-multi-get-command-line-arg "-mp-client-port")))
    (if (and port-arg
             (nonzero? (the-as uint port-arg))
             (nonzero? (-> port-arg allocated-length)))
        (string->int port-arg)
        (pc-multi-get-host-port))
    )
  )

(defun mp-start-client-from-cli! ((client-arg string))
  (debug-log *mp-debug-log?* "[MP-Session] Starting client via CLI argument.~%")
  (mp-clear-version-mismatch-ui!)
  (mp-configure-bridge-version!)
  (pc-multi-setup-client client-arg (mp-client-port-from-cli))
  (none))

(defun mp-start-host-from-settings! ()
  (debug-log *mp-debug-log?* "[MP-Session] Hosting mode active (from settings). Initializing server...~%")
  (mp-configure-bridge-version!)
  (if (and *pc-settings* (nonzero? (the-as uint *pc-settings*))
           (-> *pc-settings* mp-internet-host?))
      (mp-setup-host-bridge! #t)
      (mp-setup-host-bridge! #f))
  (mp-set-local-sync-flag! (the uint 1))
  (none))

(defun mp-auto-start-session-on-spawn! ((status mp-connection-status))
  (when (= status (mp-connection-status idle))
    (let ((host-arg (pc-multi-get-command-line-arg "-mp-host"))
          (client-arg (pc-multi-get-command-line-arg "-mp-client")))
      (cond
        ((and host-arg (nonzero? (the-as uint host-arg)) (nonzero? (-> host-arg allocated-length)))
         (mp-start-host-from-cli! (string= host-arg "internet"))
         )
        ((and client-arg (nonzero? (the-as uint client-arg)) (nonzero? (-> client-arg allocated-length)))
         (mp-start-client-from-cli! client-arg)
         )
        ((and *pc-settings*
              (nonzero? (the-as uint *pc-settings*))
              (-> *pc-settings* mp-hosting-mode?))
         (mp-start-host-from-settings!)
         )
        )
      )
    )
  (none))

(defun mp-on-local-spawn! ()
  (let ((initial-status (pc-multi-get-status)))
    (mp-auto-start-session-on-spawn! initial-status)
    (let ((status (pc-multi-get-status)))
      (mp-session-refresh-bridge-identity! status)
      (mp-bootstrap-controller-start!)
      (mp-bootstrap-note-local-spawn! status)
      (mp-enable-sync-after-spawn! status)
      (mp-arm-spawn-sync-state! status))
    (mp-demo-guard-on-local-spawn!)
    )
  (none))

(defun mp-reset-tps-counter! ()
  (set! *mp-tps-counter* (the uint 0))
  (set! *mp-actual-tps* (the uint 0))
  (set! *mp-tps-timer* (the-as time-frame 0))
  (set! *mp-tps-window-active?* #f)
  (none))

(defun mp-record-sync-window! ()
  (+! *mp-tps-counter* 1)
  (none))

(defun mp-reset-session-state! ()
  (mp-bootstrap-controller-reset!)
  (set! *multi-sync-enabled?* #f)
  (set! *mp-reconnect-menu-active?* #f)
  (set! *mp-host-left-menu-active?* #f)
  (mp-reconnect-reset-state!)
  (mp-clear-version-mismatch-ui!)
  (set! *mp-reconnect-process* (the-as handle #f))
  (set! *multi-last-send-time* (the-as time-frame 0))
  (mp-reset-tps-counter!)
  (mp-spectate-reset!)
  (mp-reset-respawn-policy!)
  (mp-tomb-boulder-reset-state!)
  (none))

(defun mp-auto-enable-sync-if-ready! ((status mp-connection-status))
  (when (and (= status (mp-connection-status in-game))
             (not *multi-sync-enabled?*)
             (not (and (mp-session-client?) (nonzero? (-> *mp-bootstrap-state* phase)))))
    (if (mp-session-host?)
        (debug-log *mp-debug-log?* "[MP-Session] Auto-enabling sync as Host in game...~%")
        (debug-log *mp-debug-log?* "[MP-Session] Auto-enabling sync as Client in game...~%")
        )
    (set! *multi-sync-enabled?* #t)
    )
  (none))

(defun mp-enter-host-left-terminal-state! ()
  "Stop remote gameplay after its submitted foreground DMA has finished rendering."
  (set! *multi-sync-enabled?* #f)
  (mp-reset-puppet-state!)
  (mp-reset-remote-marker-state!)
  (mp-for-each-player-record (player-id record)
    (when (mp-player-record-remote? *mp-player-controller* record)
      (set! (-> record connection status) (mp-connection-status idle))
      (set! (-> record action darkjak-stage) (the uint 0))
      (set! (-> record action authoritative-sequence) (the uint 0))
      (set! (-> record action action-state-id) (the uint 0))
      (set! (-> record input buttons) (the-as uint16 0))
      (set! (-> record action respawn-flags) (the uint8 0))))
  (none)
  )

(defun mp-update-host-left-ui! ((status mp-connection-status))
  (when (and (= status (mp-connection-status host-left))
             (not *mp-host-left-menu-active?*))
    (sync-path 0 0)
    (mp-enter-host-left-terminal-state!)
    (when (and *dproc*
               (nonzero? (the-as uint *dproc*)))
      (debug-log *mp-debug-log?* "[MP-Session] Host has left the session. Activating Host Left screen.~%")
      (activate-progress *dproc* 'host-left)
      (set! *mp-host-left-menu-active?* #t)
      )
    )
  (none))

(defun mp-show-version-mismatch-ui! ()
  (when (mp-cache-required-version!)
    (cond
      ((and *progress-process*
            (nonzero? (the-as uint *progress-process*)))
       (let ((progress-obj (-> *progress-process* 0)))
         (when (and progress-obj
                    (nonzero? (the-as uint progress-obj)))
           (set! *mp-version-mismatch-menu-active?* #t)
           (sound-play "menu-error")
           (set-next-state progress-obj 'version-mismatch 0)
           )
         )
       )
      ((and *dproc*
            (nonzero? (the-as uint *dproc*)))
       (set! *mp-version-mismatch-menu-active?* #t)
       (sound-play "menu-error")
       (activate-progress *dproc* 'version-mismatch)
       )
      )
    )
  (none))

(defun mp-update-version-mismatch-ui! ((status mp-connection-status))
  (when (and (= status (mp-connection-status version-mismatch))
             (not *mp-version-mismatch-menu-active?*))
    (mp-show-version-mismatch-ui!)
    )
  (none))

(defun mp-connect-discovered-host-if-ready! ((status mp-connection-status))
  (if (= status (mp-connection-status found))
      (begin
        (pc-multi-connect-found-host)
        (pc-multi-get-status)
        )
      status
      )
  )

(defun mp-bootstrap-controller-session-status? ((status mp-connection-status))
  (or (= status (mp-connection-status connected-lobby))
      (= status (mp-connection-status game-starting))
      (= status (mp-connection-status in-game))
      (= status (mp-connection-status reconnecting))))

(defun mp-session-ensure-bootstrap-controller! ((status mp-connection-status))
  (let ((local-record (mp-local-player-record)))
    (when (and (mp-session-client?)
               (mp-bootstrap-controller-session-status? status)
               local-record
               (nonzero? (the-as uint local-record)))
      (mp-bootstrap-controller-start!)))
  (none))

(defun mp-session-tick ()
  (let ((status (mp-connect-discovered-host-if-ready! (pc-multi-get-status))))
    (when (not (= status (mp-connection-status in-game)))
      (mp-clear-remote-respawn-policy!)
      )
    (when (or (< status (mp-connection-status connecting))
              (= status (mp-connection-status reconnecting))
              (= status (mp-connection-status host-left)))
      (mp-scene-coordinator-clear-catchup-audience!)
      )
    (mp-auto-enable-sync-if-ready! status)
    (if (or (= status (mp-connection-status connecting))
            (= status (mp-connection-status connected-lobby))
            (= status (mp-connection-status game-starting))
            (= status (mp-connection-status in-game))
            (= status (mp-connection-status reconnecting))
            (= status (mp-connection-status host-left)))
        (begin
          (pc-multi-poll
            (the-as uint *mp-player-controller*)
            (the-as uint *mp-world-state*)
            (the-as uint *mp-bootstrap-state*))
          (set! status (pc-multi-get-status))
          (mp-session-refresh-bridge-identity! status)
          (pc-multi-receive-sync
            (the-as uint *mp-player-controller*)
            (the-as uint *mp-world-state*)
            (the-as uint *mp-bootstrap-state*))
          (set! status (pc-multi-get-status))
          (mp-session-ensure-bootstrap-controller! status)
          (when (not (= status (mp-connection-status in-game)))
            (mp-clear-remote-respawn-policy!)
            )
          (when (= status (mp-connection-status host-left))
            (set! *multi-sync-enabled?* #f)
            )
          (mp-reconnect-observe-status! status)
          (mp-tomb-boulder-note-session-status! status)
          )
        (begin
          (mp-player-controller-reset! *mp-player-controller*)
          (set! *mp-session-role* (mp-session-role none))
          (return #f)
          )
        )
    #t
    ))

(defun mp-sync-scene-tick ()
  (mp-handle-scene-transition)
  (mp-process-pending-scene-sync!)
  (mp-process-scene-sync-target-hold!)
  (mp-scene-coordinator-tick!)
  (mp-complete-active-host-scene-skip-if-ready!)
  (none))

(defun mp-update-debug-loss! ()
  (if *mp-debug-simulate-loss?*
      (begin
        (if (zero? *mp-debug-simulate-loss-time*)
            (set! *mp-debug-simulate-loss-time* (current-time)))
        (when (>= (- (current-time) *mp-debug-simulate-loss-time*) (seconds 60))
          (debug-log *mp-debug-log?* "[MP-Session] Auto-restoring connection after 30s timeout.~%")
          (set! *mp-debug-simulate-loss?* #f)
          (set! *mp-debug-simulate-loss-time* 0)
          )
        )
      (begin
        (set! *mp-debug-simulate-loss-time* 0)
        )
      )
  (pc-multi-debug-stop-receive (if *mp-debug-simulate-loss?* (the uint 1) (the uint 0)))
  (none))

(defun mp-update-send-clock! ((current-ticks uint))
  "Anchor the next packet window to the actual flush time.
   This intentionally avoids catch-up bursts after a delayed game frame."
  (set! *multi-last-send-time* (the-as time-frame current-ticks))
  (none))

(defun mp-update-tps-counter! ()
  (let ((now (current-time)))
    (when (not *mp-tps-window-active?*)
      (set! *mp-tps-timer* now)
      (set! *mp-tps-window-active?* #t)
      )
    (let ((elapsed (- now *mp-tps-timer*)))
      (when (>= elapsed (seconds 1))
        (set! *mp-actual-tps*
              (the uint (/ (* (the uint64 *mp-tps-counter*) (the uint64 (seconds 1)))
                           (the uint64 elapsed))))
        (set! *mp-tps-counter* (the uint 0))
        (set! *mp-tps-timer* now)
        )
      )
    )
  (none))

(defun mp-gameplay-sync-ready? ()
  (let ((local-record (mp-local-player-record)))
    (and *multi-sync-enabled?*
         local-record
         (nonzero? (the-as uint local-record))
         (mp-any-remote-player-connected?)
         *mp-event-buffer*
         (nonzero? (the-as uint *mp-event-buffer*)))))

(defun mp-send-tick ()
  (mp-sync-clock-host)
  (mp-sync-clock-client)
  (mp-update-debug-loss!)
  (mp-request-mission-failed-bootstrap-when-ready)
  (let ((current-ticks (the-as uint64 (pc-multi-get-ticks))))
    (when (and (not *mp-debug-simulate-loss?*)
               (>= (- current-ticks (the uint64 *multi-last-send-time*))
                   (the uint64 (/ 1000 *multi-sync-tps*))))
      (mp-update-send-clock! current-ticks)
      (when (mp-network-status-ready? (pc-multi-get-status))
        (mp-network-sync-window-tick (mp-gameplay-sync-ready?))
        (mp-record-sync-window!)
        )
      )
    (mp-update-tps-counter!)
    )
  (none))

(defun mp-receive-tick ()
  (if (not *multi-sync-enabled?*)
      (return #f))
  (pc-multi-receive-events (the-as uint *mp-event-buffer*))
  (pc-multi-receive-enemies (the-as uint *mp-enemy-buffer*))
  (when (and *mp-enemy-buffer* (nonzero? (the-as uint *mp-enemy-buffer*)))
    (set! (-> *mp-enemy-buffer* last-sync-time) (pc-multi-get-enemy-sync-time))
    )
  (mp-resolve-local-vehicle-seat-conflict!)
  (mp-manage-remote-puppets!)
  (mp-extract-local-stats)
  (mp-stadium-board1-tick)
  (mp-apply-remote-world-state)
  (mp-apply-remote-environment-state)
  (mp-process-inbound-events)
  (mp-battle-sync-tick (pc-multi-get-status))
  (mp-waypoint-sync-tick)
  (mp-update-role-transformation)
  (mp-update-ai-targeting)
  (mp-update-player-visibility)
  (mp-tomb-daxter-wait-update!)
  (mp-update-traffic-authority)
  (mp-sync-traffic-update)
  (mp-for-each-player-target (player-id record player-target)
    (when (mp-player-record-remote? *mp-player-controller* record)
      (mp-process-pending-edge-grab! player-target)))
  #t
  )

(defun mp-debug-draw-synced-tick ()
  (mp-draw-battle-debug)
  (mp-draw-task-debug)
  (mp-draw-traffic-debug)
  (mp-draw-puppet-debug)
  (mp-draw-gun-debug)
  (mp-draw-network-debug)
  (mp-draw-airlock-debug)
  (mp-draw-elevator-debug)
  (mp-draw-boss-debug)
  (mp-draw-boss-debug-overlay)
  (respawn-policy-debug-draw)
  (none))

(defun mp-debug-draw-tick ()
  (mp-draw-level-debug)
  (when *multi-sync-enabled?*
    (mp-debug-draw-synced-tick)
    )
  (none))

(defun mp-ui-trigger-tick ()
  "Mutate multiplayer progress UI only at determine-pause-mode's post-DMA safe point."
  (let ((status (pc-multi-get-status)))
    (mp-update-reconnect-ui! status)
    (mp-update-host-left-ui! status)
    (mp-update-version-mismatch-ui! status)
    )
  (mp-demo-guard-tick)
  (none))

(defun mp-frame-tick ()
  "High-frequency multiplayer frame scheduler."
  (with-pp
    (if (not (mp-session-tick))
        (return #f))
    (mp-send-tick)
    (when *multi-sync-enabled?*
      (mp-sync-scene-tick)
      (mp-receive-tick))
    (mp-player-list-update!)
    (mp-debug-draw-tick)
    (none)))
