;;-*-Lisp-*-
(in-package goal)

(define-extern *dproc* process)
(define-extern activate-progress (function process symbol none))
(define-extern mp-reset-gameplay-state (function none))

(define-perm *mp-reconnect-gameplay-reset?* symbol #f)

(defun mp-reconnect-client? ()
  (= (pc-multi-get-role) 1)
  )

(defun mp-reconnect-terminal-status? ((status mp-connection-status))
  (or (< status (mp-connection-status connecting))
      (= status (mp-connection-status host-left))
      (= status (mp-connection-status failed))
      (= status (mp-connection-status version-mismatch)))
  )

(defun mp-reconnect-reset-state! ()
  (set! *mp-reconnect-gameplay-reset?* #f)
  (none)
  )

(defun mp-reconnect-reset-gameplay-if-needed! ()
  (when (and (mp-reconnect-client?)
             (not *mp-reconnect-gameplay-reset?*))
    (mp-reset-gameplay-state)
    (set! *mp-reconnect-gameplay-reset?* #t)
    (debug-log *mp-debug-log?* "[MP-Reconnect] Cleared gameplay state for peer recovery.~%")
    )
  (none)
  )

(defun mp-reconnect-observe-status! ((status mp-connection-status))
  (when (mp-reconnect-client?)
    (cond
      ((= status (mp-connection-status reconnecting))
       (mp-reconnect-reset-gameplay-if-needed!)
       )
      ((or (= status (mp-connection-status in-game)) (mp-reconnect-terminal-status? status))
       (set! *mp-reconnect-gameplay-reset?* #f)
       )
      )
    )
  (none)
  )

(defun mp-close-reconnect-ui-if-finished! ((status mp-connection-status))
  (when (and (mp-reconnect-client?)
             *mp-reconnect-menu-active?*
             (or (= status (mp-connection-status in-game)) (mp-reconnect-terminal-status? status)))
    (debug-log *mp-debug-log?* "[MP-Reconnect] Closing reconnect screen after session completion.~%")
    (when (and *progress-process* (nonzero? (the-as uint *progress-process*)))
      (set-next-state (-> *progress-process* 0) 'go-away 0)
      )
    (set! *mp-reconnect-menu-active?* #f)
    )
  (none)
  )

(defun mp-update-reconnect-ui! ((status mp-connection-status))
  (when (mp-reconnect-client?)
    (cond
      ((= status (mp-connection-status reconnecting))
       (when (and (not *mp-reconnect-menu-active?*)
                  *dproc*
                  (nonzero? (the-as uint *dproc*)))
         (debug-log *mp-debug-log?* "[MP-Session] Connection lost. Activating Reconnect screen.~%")
         (activate-progress *dproc* 'reconnect)
         (set! *mp-reconnect-menu-active?* #t)
         )
       )
      ((or (= status (mp-connection-status in-game)) (mp-reconnect-terminal-status? status))
       (mp-close-reconnect-ui-if-finished! status)
       )
      )
    )
  (none)
  )
