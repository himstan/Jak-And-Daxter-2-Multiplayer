(defun drill-turret-update-guard-hud! ((this turret))
  (when (and (nonnull? this *game-info*)
             (base-turret-local-rider? (handle->process-safe (-> this rider))))
    (let ((remaining (drill-battle-remaining))
          (battle (handle->process-safe (-> this hover-battle))))
      (set! (-> *game-info* counter) (the float (if (= remaining #xff) 0 remaining)))
      (set! (-> this hud-cgh-event)
            (if (and (!= remaining #xff) (> remaining 0)
                     (nonnull? battle) (> (the-as int (send-event battle 'num-spawned?)) 0))
                'force-show
                'force-hide
                )
            )
      (set! (-> this cgh-timer)
            (+ (current-time) (if (zero? remaining) (seconds 4) (the int (* 300.0 (rand-vu-float-range 0.2 0.4)))))
            )
      )
    )
  (none)
  )

(defstate active (turret)
  :virtual #t
  :enter (behavior ()
    (let ((t9-0 (-> (method-of-type base-turret active) enter)))
      (if t9-0
          (t9-0)
          )
      )
    (when (and (base-turret-local-rider? (handle->process-safe (-> self rider))) (not (-> self use-cgh-hud)))
      (set! (-> *game-info* counter) 0.0)
      )
    (set! (-> self egg-timer) 0)
    (set! (-> self cgh-timer) 0)
    (drill-turret-ensure-shared-battle! self)
    (when (>= (drill-rail-index self) 0)
      (set! (-> self rail-scale) 1.0)
      (drill-rail-seek-visible! self #t)
      )
    (if (and (handle->process (-> self hover-battle)) (zero? (-> self path-event)))
        (send-event (handle->process (-> self hover-battle)) 'trigger)
        )
    (drill-turret-set-formation-los! self #f)
    )
  :exit (behavior ()
    (let ((t9-1 (-> (find-parent-state) exit)))
      (if t9-1
          (t9-1)
          )
      )
    (send-event (handle->process (-> self hud-egg)) 'hide-and-die)
    (send-event (handle->process (-> self hud-cgh)) 'hide-and-die)
    (drill-turret-set-formation-los! self #t)
    (when (< 0.0 (-> *game-info* counter))
      (let* ((v1-22 (rand-vu-int-count 3))
             (t0-0 (cond
                     ((zero? v1-22)
                      "ds439"
                      )
                     ((= v1-22 1)
                      "ds440"
                      )
                     ((= v1-22 2)
                      "ds441"
                      )
                     )
                   )
             )
        (add-process *gui-control* self (gui-channel daxter) (gui-action play) t0-0 -99.0 0)
        )
      )
    (none)
    )
  :post (behavior ()
    (let ((t9-1 (-> (the-as (state base-turret) (find-parent-method turret 29)) post)))
      (if t9-1
          ((the-as (function none) t9-1))
          )
      )
    (when (and self
               (nonzero? self)
               (base-turret-local-rider? (handle->process-safe (-> self rider)))
               (-> self use-egg-hud)
               (< (-> self egg-timer) (current-time))
               (-> self actor-group)
               (nonzero? (-> self actor-group))
               (> (-> self actor-group-count) 0))
      (let* ((v1-6 0)
             (actor-group-count (-> self actor-group-count))
             (last-group-index (+ actor-group-count -1))
             (actor-groups (-> self actor-group))
             (egg-group (-> actor-groups last-group-index)))
        (when (and egg-group (nonzero? egg-group))
          (dotimes (a1-1 (-> egg-group length))
            (let ((a2-4 (-> egg-group data a1-1 actor)))
              (when (and a2-4
                         (nonzero? a2-4)
                         (-> a2-4 extra)
                         (nonzero? (-> a2-4 extra))
                         (-> a2-4 extra perm)
                         (nonzero? (-> a2-4 extra perm)))
                (if (not (logtest? (-> a2-4 extra perm status) (entity-perm-status subtask-complete)))
                    (+! v1-6 1)
                    )
                )
              )
            )
          )
        (set! (-> *game-info* counter) (the float v1-6))
        )
      (set! (-> self egg-timer) (+ (current-time) (the int (* 300.0 (rand-vu-float-range 0.2 0.4)))))
      )
    (when (and (-> self use-cgh-hud) (< (-> self cgh-timer) (current-time)))
      (drill-turret-update-guard-hud! self)
      )
    (none)
    )
  )

(defstate idle (turret)
  :virtual #t
  :trans (behavior ()
    (let ((rail (drill-rail-index self)))
      (if (>= rail 0)
          (drill-rail-update-idle! rail)
          )
      )
    )
  )

(defstate dormant (turret)
  :virtual #t
  :event (behavior ((proc process) (argc int) (message symbol) (block event-message-block))
    (case message
      (('exit-valid)
       (base-turret-method-41 self (the-as vector (-> block param 0)))
       #t
       )
      (else
        ((-> (method-of-type base-turret dormant) event) proc argc message block)
        )
      )
    )
  :trans (behavior ()
    (drill-rail-update-dormant!)
    )
  )

(defstate die (turret)
  :virtual #t
  :enter (behavior ()
    (speech-control-method-12 *speech-control* self (speech-type speech-type-10))
    (let ((t9-2 (-> (find-parent-state) enter)))
      (if t9-2
          (t9-2)
          )
      )
    )
  )

(defun drill-turret-battle-table ((extra-id int))
  (case extra-id
    ((0) *drill-turret-10-battle*)
    ((1) *drill-turret-11-battle*)
    ((2) *drill-turret-12-battle*)
    ((3) *drill-turret-13-battle*)
    (else (the-as (array hover-enemy-battle-command) #f))
    )
  )

(defun drill-turret-path-table ((extra-id int))
  (case extra-id
    ((3) *turret-13-path*)
    ((4) *turret-14-path*)
    ((5) *turret-15-path*)
    (else (the-as turret-path #f))
    )
  )

(defmethod turret-init! ((this turret) (arg0 entity-actor) (arg1 matrix))
  (set! (-> this hover-battle) (the-as handle #f))
  (set! (-> this rail-scale) -1.0)
  (let* ((shared-aid (res-lump-value (-> this entity) 'shared-battle-aid uint128 :default (the-as uint128 0) :time -1000000000.0))
         (extra-id (res-lump-value (-> this entity) 'extra-id int :default (the-as uint128 -1) :time -1000000000.0))
         (battle (drill-turret-battle-table extra-id))
         (path (drill-turret-path-table extra-id))
         )
    (if path
        (set! (-> this path-event) path)
        )
    (when (and (mp-session-in-game?) (>= extra-id 3))
      (drill-rail-sync-front!)
      )
    (if (and battle (zero? shared-aid)
             (not (and (mp-session-in-game?) (= extra-id 3) (drill-rail-battle-done?))))
        (set! (-> this hover-battle) (process->handle (hover-manager-spawn this (-> this entity) battle)))
        )
    (set! (-> this use-cgh-hud) (= extra-id 3))
    (set! (-> this use-egg-hud) (or (and (>= extra-id 0) (< extra-id 3)) (and (nonzero? shared-aid) (!= extra-id 3))))
    (let ((t9-5 (method-of-type base-turret turret-init!)))
      (t9-5 this arg0 arg1)
      )
    (set! (-> this hud-egg) (the-as handle #f))
    (set! (-> this hud-cgh) (the-as handle #f))
    (set! (-> this hover-formation) (the-as hover-formation (entity-actor-lookup arg0 'formation-actor 0)))
    (when (and (nonzero? shared-aid) (not (drill-turret-copy-shared-battle! this (the-as uint shared-aid))))
      (set! (-> this use-egg-hud) #f)
      )
    )
  (if (or (name= (-> this name) "turret-14") (name= (-> this name) "turret-15"))
      (set! (-> this shot-timeout) (seconds 2.667))
      )
  (none)
  )

;; WARN: Return type mismatch object vs none.
(defmethod base-turret-method-39 ((this turret) (arg0 turret-path-event))
  (case (-> arg0 event-type)
    (('trigger-battle)
     (when (and (handle->process (-> this hover-battle))
                (nonzero? (handle->process (-> this hover-battle))))
       (set! (-> this hud-cgh-event) 'force-show)
       (send-event (handle->process (-> this hover-battle)) 'trigger)
       )
     )
    (else
      ((method-of-type base-turret base-turret-method-39) this arg0)
      )
    )
  (none)
  )

(defmethod base-turret-method-34 ((this turret) (arg0 process))
  (drill-turret-ensure-shared-battle! this)
  (if (base-turret-local-rider? arg0)
      (set! (-> this hud)
            (ppointer->handle (process-spawn hud-drill-turret-health :init hud-init-by-other :to arg0))
            )
      (set! (-> this hud) (the-as handle #f))
      )
  (if (-> this use-egg-hud)
      (set! (-> this hud-egg) (ppointer->handle (process-spawn hud-gruntegg :init hud-init-by-other :to arg0)))
      )
  (when (and (-> this use-cgh-hud) (base-turret-local-rider? arg0))
    (set! (-> this hud-cgh) (ppointer->handle (process-spawn hud-crimsonhover :init hud-init-by-other :to arg0)))
    (drill-turret-update-guard-hud! this)
    )
  0
  (none)
  )

(defmethod base-turret-method-35 ((this turret))
  (if (-> this use-egg-hud)
      (send-event (handle->process (-> this hud-egg)) 'force-show)
      )
  (if (-> this use-cgh-hud)
      (send-event (handle->process (-> this hud-cgh)) (-> this hud-cgh-event))
      )
  (call-parent-method this)
  (none)
  )

(defmethod base-turret-method-46 ((this turret) (arg0 process))
  (if (type? arg0 hover-enemy)
      arg0
      )
  )

(defmethod path-u-limit ((this turret))
  (let ((rail (drill-rail-index this)))
    (if (and (>= rail 0) (mp-session-in-game?))
        (drill-rail-path-limit this rail)
        1.0
        )
    )
  )

(defmethod base-turret-method-38 ((this turret))
  (let ((rail (drill-rail-index this)))
    (if (and (>= rail 0) (mp-session-in-game?))
        (drill-rail-process-events! this rail)
        (call-parent-method this)
        )
    )
  (none)
  )
