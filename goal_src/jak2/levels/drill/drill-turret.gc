;;-*-Lisp-*-
(in-package goal)

;; name: drill-turret.gc
;; name in dgo: drill-turret
;; dgos: DMI

;; DECOMP BEGINS

(declare-type turret base-turret)
(define-extern drill-rail-index (function turret int))
(define-extern drill-rail-path-limit (function turret int float))
(define-extern drill-rail-process-events! (function turret int none))
(define-extern drill-rail-update-idle! (function int none :behavior turret))
(define-extern drill-rail-update-dormant! (function none :behavior turret))
(define-extern drill-rail-seek-visible! (function turret symbol none))
(define-extern drill-rail-sync-front! (function none))
(define-extern drill-rail-battle-done? (function symbol))
(define-extern drill-battle-remaining (function int))

(deftype turret (base-turret)
  ((hover-battle     handle)
   (hover-formation  hover-formation)
   (use-egg-hud      symbol)
   (hud-egg          handle)
   (use-cgh-hud      symbol)
   (hud-cgh          handle)
   (hud-cgh-event    symbol)
   (egg-timer        time-frame)
   (cgh-timer        time-frame)
   (rail-scale       float)
   )
  )

(defun drill-turret-set-formation-los! ((this turret) (los-enabled symbol))
  (when (and this
             (nonzero? this)
             (-> this hover-formation)
             (nonzero? (-> this hover-formation)))
    (let ((formation (-> this hover-formation)))
      (when (and formation (nonzero? formation))
        (let ((formation-child (-> formation child 3)))
          (when (and formation-child (nonzero? formation-child))
            (let ((message-block (new 'stack-no-clear 'event-message-block)))
              (when (and message-block (nonzero? message-block))
                (set! (-> message-block from) (process->ppointer this))
                (set! (-> message-block num-params) 1)
                (set! (-> message-block message) 'set-los)
                (set! (-> message-block param 0) (the-as uint los-enabled))
                (send-event-function formation-child message-block)
                )
              ))
          ))
      ))
  (none)
  )

(defun drill-turret-copy-shared-battle! ((this turret) (source-aid uint))
  (when (and (nonnull? this) (nonzero? source-aid))
    (let ((manager (the-as hover-enemy-manager (hover-manager-by-aid source-aid))))
      (when (nonnull? manager)
        (set! (-> this hover-battle) (process->handle manager))
        (set! (-> this actor-group) (-> manager actor-group))
        (set! (-> this actor-group-count) (-> manager actor-group-count))
        (return #t)
        )
      )
    )
  #f
  )

(defun drill-turret-ensure-shared-battle! ((this turret))
  (when (nonnull? this)
    (let ((shared-aid (res-lump-value (-> this entity) 'shared-battle-aid uint128 :default (the-as uint128 0) :time -1000000000.0)))
      (when (and (nonzero? shared-aid)
                 (not (handle->process (-> this hover-battle)))
                 (drill-turret-copy-shared-battle! this (the-as uint shared-aid)))
        (set! (-> this use-egg-hud) (not (-> this use-cgh-hud))))))
  (none)
  )


