;;-*-Lisp-*-
(in-package goal)

(defconstant MP_RACE_MAX_RACERS 10)
(defconstant MP_RACE_INVALID_INDEX (the uint8 #xff))
(defconstant MP_RACE_COUNTDOWN_FRAMES (the-as time-frame 900))
(defconstant MP_RACE_START_BUFFER_FRAMES (the-as time-frame 300))

(deftype mp-race-sync-state (structure)
  ((generation             uint32)
   (race-id                uint32)
   (participant-mask       uint32)
   (open-racer-mask        uint32)
   (retired-racer-mask     uint32)
   (pending-progress-mask  uint32)
   (dnf-request-mask       uint32)
   (sequence               uint32)
   (catchup-player-mask    uint32)
   (last-host-config-sequence uint32)
   (manager-generation     uint32)
   (last-manager-generation uint32)
   (active-racer-count     int32)
   (start-authorized?      uint32)
   (results-ready?         uint32)
   (overall-success?       uint32)
   (decision               uint32)
   (start-time             time-frame)
   (bound-player-by-racer  uint8 MP_RACE_MAX_RACERS)
   (bound-racer-by-player  uint8 MP_MAX_PLAYERS)
   (player-status          uint8 MP_MAX_PLAYERS)
   (result-place           int8 MP_MAX_PLAYERS)
   (observed-checkpoint-mask uint8 MP_RACE_MAX_RACERS)
   (last-progress-time     time-frame MP_MAX_PLAYERS)
   (result-finish-time     time-frame MP_MAX_PLAYERS)
   ))

(define-perm *mp-race-sync-state* mp-race-sync-state
  (new 'static 'mp-race-sync-state))
(define-perm *mp-race-generation-counter* uint (the uint 0))

(define-extern mp-race-commit-lap! (function race-state int none))
(define-extern mp-race-reconcile-progress!
  (function race-state int int int time-frame none))

(defun mp-race-player-bit ((player-id uint))
  (if (< player-id (the uint MP_MAX_PLAYERS))
      (the-as uint (ash 1 player-id))
      (the uint 0)))

(defun mp-race-racer-bit ((racer-index int))
  (if (and (>= racer-index 0) (< racer-index MP_RACE_MAX_RACERS))
      (the-as uint (ash 1 racer-index))
      (the uint 0)))

(defun mp-race-sync-active? ()
  (and *multi-sync-enabled?*
       (= (pc-multi-get-status) (mp-connection-status in-game))
       (or (mp-session-host?) (mp-session-client?))))

(defun mp-race-multiplayer-mode? ()
  (and *multi-sync-enabled?*
       (or (mp-session-host?) (mp-session-client?))))

(defun mp-race-world-ready? ()
  (and *target*
       (nonzero? *target*)
       (-> *target* control)
       (nonzero? (-> *target* control))
       (not (focus-test? *target* teleporting))
       *level*
       (nonzero? *level*)
       (= (-> *level* loading-level) (-> *level* default-level))
       (not (load-in-progress? *level*))))

(defun mp-race-current-clock ()
  (if (and *display* (nonzero? *display*))
      (-> *display* shared-clock frame-counter)
      (the-as time-frame (current-time))))

(defun mp-race-record-connected? ((record mp-player-record))
  (and record
       (nonzero? record)
       (nonzero? (-> record identity joined?))
       (nonzero? (-> record connection connected?))))

(defun mp-race-record-roster-ready? ((record mp-player-record))
  (and (mp-race-record-connected? record)
       (or (= (-> record identity player-id) (mp-local-player-id))
           (>= (-> record connection status)
               (mp-connection-status connected-lobby)))))

(defun mp-race-reset-runtime! ()
  (let ((sync *mp-race-sync-state*))
    (when (and sync (nonzero? sync))
      (set! (-> sync participant-mask) (the uint 0))
      (set! (-> sync open-racer-mask) (the uint 0))
      (set! (-> sync retired-racer-mask) (the uint 0))
      (set! (-> sync pending-progress-mask) (the uint 0))
      (set! (-> sync dnf-request-mask) (the uint 0))
      (set! (-> sync sequence) (the uint 0))
      (set! (-> sync catchup-player-mask) (the uint 0))
      (set! (-> sync last-host-config-sequence) (the uint 0))
      (set! (-> sync active-racer-count) 0)
      (set! (-> sync start-authorized?) (the uint 0))
      (set! (-> sync results-ready?) (the uint 0))
      (set! (-> sync overall-success?) (the uint 0))
      (set! (-> sync decision) MP_RACE_DECISION_NONE)
      (set! (-> sync start-time) (the-as time-frame 0))
      (dotimes (racer-index MP_RACE_MAX_RACERS)
        (set! (-> sync bound-player-by-racer racer-index)
              MP_RACE_INVALID_INDEX)
        (set! (-> sync observed-checkpoint-mask racer-index)
              (the uint8 0)))
      (dotimes (player-index MP_MAX_PLAYERS)
        (set! (-> sync bound-racer-by-player player-index)
              MP_RACE_INVALID_INDEX)
        (set! (-> sync player-status player-index)
              (the-as uint8 MP_RACE_STATUS_ACTIVE))
        (set! (-> sync result-place player-index) -1)
        (set! (-> sync last-progress-time player-index)
              (the-as time-frame 0))
        (set! (-> sync result-finish-time player-index)
              (the-as time-frame 0)))))
  (none))

(defun mp-race-reset-all! ()
  (when (and *mp-race-sync-state* (nonzero? *mp-race-sync-state*))
    (mp-race-reset-runtime!)
    (set! (-> *mp-race-sync-state* generation) (the uint 0))
    (set! (-> *mp-race-sync-state* race-id) (the uint 0))
    (set! (-> *mp-race-sync-state* manager-generation) (the uint 0))
    (set! (-> *mp-race-sync-state* last-manager-generation) (the uint 0)))
  (set! *mp-race-generation-counter* (the uint 0))
  (mp-culling-clear-override! (mp-culling-override-flags race))
  (none))

(defun mp-race-next-sequence! ()
  (+! (-> *mp-race-sync-state* sequence) 1)
  (-> *mp-race-sync-state* sequence))

(defun mp-race-enqueue-event! ((action uint)
                               (racer-index uint)
                               (player-id uint)
                               (value0 int)
                               (value1 int)
                               (event-time time-frame))
  (when (and (mp-race-sync-active?)
             *mp-race-sync-state*
             (nonzero? *mp-race-sync-state*))
    (let ((details (new 'stack-no-clear 'mp-race-event-data)))
      (set! (-> details action) action)
      (set! (-> details generation) (-> *mp-race-sync-state* generation))
      (set! (-> details race-id) (-> *mp-race-sync-state* race-id))
      (set! (-> details racer-index) racer-index)
      (set! (-> details player-id) player-id)
      (set! (-> details participant-mask)
            (-> *mp-race-sync-state* participant-mask))
      (set! (-> details open-racer-mask)
            (-> *mp-race-sync-state* open-racer-mask))
      (set! (-> details value0) value0)
      (set! (-> details value1) value1)
      (set! (-> details sequence) (mp-race-next-sequence!))
      (set! (-> details event-time) event-time)
      (mp-event-enqueue-race! details)))
  (none))

(defun mp-race-count-participants ((participant-mask uint))
  (let ((participant-count 0))
    (dotimes (player-id MP_MAX_PLAYERS)
      (when (logtest? participant-mask
                      (mp-race-player-bit (the-as uint player-id)))
        (+! participant-count 1)))
    participant-count))

(defun mp-race-participant-mask-valid? ((participant-mask uint)
                                         (participant-count int))
  (let ((count 0))
    (dotimes (bit-index 32)
      (when (logtest? participant-mask
                      (the-as uint (ash 1 bit-index)))
        (when (>= bit-index MP_MAX_PLAYERS)
          (return #f))
        (+! count 1)))
    (= count participant-count)))

(defun mp-race-open-mask-valid? ((open-mask uint)
                                  (active-racer-count int)
                                  (participant-count int))
  (let ((count 0))
    (dotimes (bit-index 32)
      (when (logtest? open-mask
                      (the-as uint (ash 1 bit-index)))
        (when (>= bit-index active-racer-count)
          (return #f))
        (+! count 1)))
    (= count participant-count)))

(defun mp-race-config-valid? ((event mp-race-event))
  (when (or (not event) (zero? event))
    (return #f))
  (let ((active-racer-count (-> event value0))
        (participant-count (-> event value1)))
    (and (nonzero? (-> event generation))
         (> active-racer-count 0)
         (<= active-racer-count MP_RACE_MAX_RACERS)
         (> participant-count 0)
         (<= participant-count MP_MAX_PLAYERS)
         (mp-race-participant-mask-valid?
           (-> event participant-mask) participant-count)
         (mp-race-open-mask-valid?
           (-> event open-racer-mask)
           active-racer-count
           participant-count))))

(defun mp-race-build-participant-mask ()
  (let ((participant-mask (the uint 0)))
    (mp-for-each-player-record (player-id record)
      (when (mp-race-record-roster-ready? record)
        (set! participant-mask
              (logior participant-mask
                      (mp-race-player-bit (the-as uint player-id))))))
    participant-mask))

(defun mp-race-connected-remote-mask ()
  (let ((connected-mask (the uint 0)))
    (mp-for-each-player-record (player-id record)
      (when (and (mp-race-record-connected? record)
                 (= (-> record connection status)
                    (mp-connection-status in-game))
                 (mp-player-record-remote? *mp-player-controller* record))
        (set! connected-mask
              (logior connected-mask
                      (mp-race-player-bit (the-as uint player-id))))))
    connected-mask))

(defun mp-race-player-only? ((racer-info race-racer-info))
  (and racer-info
       (nonzero? racer-info)
       (logtest? (-> racer-info flags)
                 (racer-info-flags player-only))))

(defun mp-race-ai-capable? ((racer-info race-racer-info))
  (and racer-info
       (nonzero? racer-info)
       (not (mp-race-player-only? racer-info))
       (logtest? (-> racer-info flags)
                 (racer-info-flags player-or-ai))))

(defun mp-race-human-capable? ((racer-info race-racer-info))
  (or (mp-race-player-only? racer-info)
      (mp-race-ai-capable? racer-info)))

(defun mp-race-canonical-human? ((racer-info race-racer-info))
  (and (mp-race-human-capable? racer-info)
       (or (mp-race-player-only? racer-info)
           (zero? (-> racer-info rider))
           (= (-> racer-info rider) 1))))

(defun mp-race-select-open-racers ((info race-info)
                                   (participant-count int)
                                   (required-mask uint))
  (let ((open-mask required-mask)
        (selected-count 0))
    (dotimes (racer-index MP_RACE_MAX_RACERS)
      (when (logtest? required-mask (mp-race-racer-bit racer-index))
        (when (or (>= racer-index (-> info racer-count))
                  (not (mp-race-human-capable?
                         (-> info racer-array racer-index))))
          (return (the uint 0)))
        (+! selected-count 1)))
    (when (> selected-count participant-count)
      (return (the uint 0)))
    (dotimes (racer-index (-> info racer-count))
      (let ((racer-info (-> info racer-array racer-index)))
        (when (and (< selected-count participant-count)
                   (not (logtest? open-mask
                                  (mp-race-racer-bit racer-index)))
                   (mp-race-canonical-human? racer-info))
          (set! open-mask
                (logior open-mask (mp-race-racer-bit racer-index)))
          (+! selected-count 1))))
    (dotimes (racer-index (-> info racer-count))
      (let ((racer-info (-> info racer-array racer-index)))
        (when (and (< selected-count participant-count)
                   (not (logtest? open-mask
                                  (mp-race-racer-bit racer-index)))
                   (mp-race-human-capable? racer-info)
                   (not (mp-race-canonical-human? racer-info)))
          (set! open-mask
                (logior open-mask (mp-race-racer-bit racer-index)))
          (+! selected-count 1))))
    (if (= selected-count participant-count)
        open-mask
        (the uint 0))))

(defun mp-race-multiplayer-racer-count ((info race-info) (open-mask uint))
  (let ((racer-count (the-as int (-> info racer-count))))
    (while (> racer-count 0)
      (let* ((racer-index (+ racer-count -1))
             (racer-info (-> info racer-array racer-index)))
        (if (and (mp-race-canonical-human? racer-info)
                 (not (logtest? open-mask
                                (mp-race-racer-bit racer-index))))
            (-! racer-count 1)
            (return racer-count))))
    racer-count))

(defun mp-race-singleplayer-racer-count ((info race-info))
  (let ((racer-count (the-as int (-> info racer-count))))
    (while (> racer-count 1)
      (let ((racer-info (-> info racer-array (+ racer-count -1))))
        (if (logtest? (-> racer-info flags)
                      (racer-info-flags player-only))
            (-! racer-count 1)
            (return racer-count))))
    racer-count))

(defun mp-race-host-build-config! ((info race-info))
  (when (or (not info) (zero? info))
    (return #f))
  (let* ((participant-mask (mp-race-build-participant-mask))
         (participant-count (mp-race-count-participants participant-mask))
         (open-mask
           (mp-race-select-open-racers info participant-count (the uint 0))))
    (when (or (zero? participant-count) (zero? open-mask))
      (debug-log *mp-debug-log?*
                 "[Race-MP] Race ~D cannot allocate ~D human racers.~%"
                 (-> info id)
                 participant-count)
      (return #f))
    (+! *mp-race-generation-counter* 1)
    (mp-race-reset-runtime!)
    (set! (-> *mp-race-sync-state* generation)
          *mp-race-generation-counter*)
    (set! (-> *mp-race-sync-state* race-id)
          (the-as uint (-> info id)))
    (set! (-> *mp-race-sync-state* participant-mask) participant-mask)
    (set! (-> *mp-race-sync-state* open-racer-mask) open-mask)
    (set! (-> *mp-race-sync-state* active-racer-count)
          (mp-race-multiplayer-racer-count info open-mask))
    (set! (-> *mp-race-sync-state* manager-generation)
          *mp-race-generation-counter*)
    (set! (-> *mp-race-sync-state* catchup-player-mask)
          (mp-race-connected-remote-mask))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_CONFIG
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      (-> *mp-race-sync-state* active-racer-count)
      participant-count
      (mp-race-current-clock))
    #t))

(defun mp-race-request-config! ((info race-info))
  (when (and (mp-race-multiplayer-mode?)
             (not (mp-session-host?))
             info
             (nonzero? info))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_CONFIG_REQUEST
      (the uint MP_RACE_INVALID_INDEX)
      (mp-local-player-id)
      (the-as int (-> info id))
      0
      (mp-race-current-clock)))
  (none))

(defun mp-race-manager-begin! ((info race-info))
  (mp-culling-set-override! (mp-culling-override-flags race) #t)
  (when (not (mp-race-multiplayer-mode?))
    (return #t))
  (when (or (not info) (zero? info))
    (return #f))
  (set! (-> *mp-race-sync-state* manager-generation) (the uint 0))
  (if (mp-session-host?)
      (mp-race-host-build-config! info)
      (begin
        (mp-race-request-config! info)
        #t)))

(defun mp-race-manager-config-ready? ((info race-info))
  (when (not (mp-race-multiplayer-mode?))
    (return #t))
  (when (or (not info) (zero? info))
    (return #f))
  (let ((sync *mp-race-sync-state*))
    (when (and (zero? (-> sync manager-generation))
               (= (-> sync race-id) (the-as uint (-> info id)))
               (nonzero? (-> sync generation)))
      (set! (-> sync manager-generation) (-> sync generation)))
    (and (nonzero? (-> sync manager-generation))
         (= (-> sync manager-generation) (-> sync generation))
         (= (-> sync race-id) (the-as uint (-> info id)))
         (> (-> sync active-racer-count) 0))))

(defun mp-race-manager-end! ()
  (mp-culling-clear-override! (mp-culling-override-flags race))
  (when (and *mp-race-sync-state* (nonzero? *mp-race-sync-state*))
    (mp-race-reset-runtime!)
    (set! (-> *mp-race-sync-state* manager-generation) (the uint 0))
    (set! (-> *mp-race-sync-state* last-manager-generation) (the uint 0)))
  (none))

(defun mp-race-effective-racer-count ((info race-info))
  (cond
    ((or (not info) (zero? info)) 0)
    ((not (mp-race-sync-active?))
     (mp-race-singleplayer-racer-count info))
    ((mp-race-manager-config-ready? info)
     (-> *mp-race-sync-state* active-racer-count))
    (else 0)))

(defun mp-race-racer-open? ((racer-index int))
  (and (mp-race-sync-active?)
       (logtest? (-> *mp-race-sync-state* open-racer-mask)
                 (mp-race-racer-bit racer-index))))

(defun mp-race-racer-retired? ((racer-index int))
  (and (mp-race-sync-active?)
       (logtest? (-> *mp-race-sync-state* retired-racer-mask)
                 (mp-race-racer-bit racer-index))))

(defun mp-race-local-participant? ()
  (let ((player-id (mp-local-player-id)))
    (and (mp-race-sync-active?)
         *mp-race-sync-state*
         (nonzero? *mp-race-sync-state*)
         (< player-id (the uint MP_MAX_PLAYERS))
         (logtest? (-> *mp-race-sync-state* participant-mask)
                   (mp-race-player-bit player-id)))))

(defun mp-race-racer-local-player? ((racer racer-state))
  (when (and racer (nonzero? racer))
    (let ((vehicle (handle->process-safe (-> racer racer)))
          (local-record (mp-local-player-record)))
      (when (and vehicle
                 (nonzero? vehicle)
                 local-record
                 (nonzero? local-record))
        (return (= (-> (the-as vehicle vehicle) net-id)
                   (-> local-record vehicle vehicle-id))))))
  #f)

(defun mp-race-racer-remote-player? ((racer racer-state))
  (when (and racer (nonzero? racer))
    (let ((vehicle (handle->process-safe (-> racer racer))))
      (when (and vehicle (nonzero? vehicle))
        (let ((record
                (mp-remote-player-record-by-vehicle-id
                  (-> (the-as vehicle vehicle) net-id))))
          (return (and record (nonzero? record)))))))
  #f)

(defun mp-race-bound-player-id ((racer-index int))
  (if (and (>= racer-index 0) (< racer-index MP_RACE_MAX_RACERS))
      (the-as uint
        (-> *mp-race-sync-state* bound-player-by-racer racer-index))
      MP_INVALID_PLAYER_ID))

(defun mp-race-bound-racer-index ((player-id uint))
  (if (< player-id (the uint MP_MAX_PLAYERS))
      (the-as int
        (-> *mp-race-sync-state* bound-racer-by-player player-id))
      (the-as int MP_RACE_INVALID_INDEX)))

(defun mp-race-clear-bound-racer-state! ((state race-state)
                                         (racer-index int))
  (set! (-> *mp-race-sync-state* bound-player-by-racer racer-index)
        MP_RACE_INVALID_INDEX)
  (logclear! (-> *mp-race-sync-state* pending-progress-mask)
             (mp-race-racer-bit racer-index))
  (set! (-> *mp-race-sync-state* observed-checkpoint-mask racer-index)
        (the uint8 0))
  (when (and state
             (nonzero? state)
             (< racer-index (-> state racer-count)))
    (let ((racer (-> state racer-array racer-index)))
      (logclear! (-> racer flags)
                 (racer-flags finished dead local-player remote-player))
      (set! (-> racer finish-count) (the-as int8 0))
      (set! (-> racer lap-count) (the-as int8 0))
      (set! (-> racer finish-time) (the uint 0)))
    (when (= (-> state i-player) racer-index)
      (set! (-> state i-player) -1)))
  (none))

(defun mp-race-reset-player-result! ((player-id uint))
  (set! (-> *mp-race-sync-state* bound-racer-by-player player-id)
        MP_RACE_INVALID_INDEX)
  (set! (-> *mp-race-sync-state* player-status player-id)
        (the-as uint8 MP_RACE_STATUS_ACTIVE))
  (set! (-> *mp-race-sync-state* result-place player-id) -1)
  (set! (-> *mp-race-sync-state* last-progress-time player-id)
        (the-as time-frame 0))
  (set! (-> *mp-race-sync-state* result-finish-time player-id)
        (the-as time-frame 0))
  (logclear! (-> *mp-race-sync-state* dnf-request-mask)
             (mp-race-player-bit player-id))
  (none))

(defun mp-race-clear-player-binding! ((state race-state) (player-id uint))
  (when (or (>= player-id (the uint MP_MAX_PLAYERS))
            (not *mp-race-sync-state*)
            (zero? *mp-race-sync-state*))
    (return #f))
  (let ((racer-index (mp-race-bound-racer-index player-id)))
    (when (and (>= racer-index 0) (< racer-index MP_RACE_MAX_RACERS))
      (mp-race-clear-bound-racer-state! state racer-index))
    (mp-race-reset-player-result! player-id))
  #t)

(defun mp-race-clear-stale-bindings! ((state race-state)
                                      (participant-mask uint)
                                      (open-mask uint))
  (dotimes (player-index MP_MAX_PLAYERS)
    (let* ((player-id (the-as uint player-index))
           (racer-index (mp-race-bound-racer-index player-id)))
      (when (and (>= racer-index 0)
                 (< racer-index MP_RACE_MAX_RACERS)
                 (or (not (logtest? participant-mask
                                    (mp-race-player-bit player-id)))
                     (not (logtest? open-mask
                                    (mp-race-racer-bit racer-index)))))
        (mp-race-clear-player-binding! state player-id))))
  (none))

(defun mp-race-retained-racer-mask ((participant-mask uint))
  (let ((retained-mask (the uint 0)))
    (dotimes (racer-index MP_RACE_MAX_RACERS)
      (let ((player-id (mp-race-bound-player-id racer-index)))
        (when (and (< player-id (the uint MP_MAX_PLAYERS))
                   (logtest? participant-mask
                             (mp-race-player-bit player-id))
                   (= (the-as uint
                        (-> *mp-race-sync-state* player-status player-id))
                      MP_RACE_STATUS_ACTIVE))
          (set! retained-mask
                (logior retained-mask
                        (mp-race-racer-bit racer-index))))))
    retained-mask))

(defun mp-race-apply-binding! ((state race-state)
                               (racer-index int)
                               (player-id uint))
  (when (or (not state)
            (zero? state)
            (< racer-index 0)
            (>= racer-index (-> state racer-count))
            (>= player-id (the uint MP_MAX_PLAYERS)))
    (return #f))
  (let ((racer (-> state racer-array racer-index))
        (record (mp-player-record-by-id player-id)))
    (when (and racer (nonzero? racer) record (nonzero? record))
      (logclear! (-> racer flags)
                 (racer-flags local-player remote-player))
      (if (= player-id (mp-local-player-id))
          (begin
            (set! (-> state i-player) racer-index)
            (logior! (-> racer flags) (racer-flags local-player)))
          (logior! (-> racer flags) (racer-flags remote-player)))
      (set! (-> racer rider)
            (if (mp-player-daxter? record) (the uint8 1) (the uint8 0)))))
  #t)

(defun mp-race-apply-bindings! ((state race-state))
  (when (and state (nonzero? state) (mp-race-sync-active?))
    (dotimes (racer-index (-> state racer-count))
      (let ((player-id (mp-race-bound-player-id racer-index)))
        (when (< player-id (the uint MP_MAX_PLAYERS))
          (mp-race-apply-binding! state racer-index player-id)))))
  (none))

(defun mp-race-host-binding-record ((state race-state) (racer-index int))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (let* ((racer (-> state racer-array racer-index))
           (vehicle
             (the-as vehicle (handle->process-safe (-> racer racer)))))
      (when (and vehicle (nonzero? vehicle))
        (let ((record
                (mp-player-record-by-vehicle-id (-> vehicle net-id))))
          (when (and record
                     (nonzero? record)
                     (zero? (-> record vehicle seat-index)))
            (return record))))))
  (the-as mp-player-record #f))

(defun mp-race-host-bind-racer! ((state race-state) (racer-index int))
  (when (or (not (mp-race-racer-open? racer-index))
            (mp-race-racer-retired? racer-index))
    (return #f))
  (let ((record (mp-race-host-binding-record state racer-index)))
    (when (and record (nonzero? record))
      (let* ((player-id (the-as uint (-> record identity player-id)))
             (player-bit (mp-race-player-bit player-id))
             (current-racer (mp-race-bound-racer-index player-id))
             (current-player (mp-race-bound-player-id racer-index)))
        (when (and (nonzero? player-bit)
                   (logtest? (-> *mp-race-sync-state* participant-mask)
                             player-bit)
                   (or (= current-racer (the-as int MP_RACE_INVALID_INDEX))
                       (= current-racer racer-index))
                   (or (= current-player (the-as uint MP_RACE_INVALID_INDEX))
                       (= current-player player-id)))
          (when (= current-player (the-as uint MP_RACE_INVALID_INDEX))
            (set! (-> *mp-race-sync-state*
                      bound-player-by-racer racer-index)
                  (the-as uint8 player-id))
            (set! (-> *mp-race-sync-state*
                      bound-racer-by-player player-id)
                  (the-as uint8 racer-index))
            (mp-race-enqueue-event!
              MP_RACE_ACTION_BIND_COMMIT
              (the-as uint racer-index)
              player-id
              0
              0
              (mp-race-current-clock)))
          (mp-race-apply-binding! state racer-index player-id)))))
  #t)

(defun mp-race-ai-map-icon ((rider uint))
  (if (= rider 2)
      (minimap-class racer-errol)
      (minimap-class racer)))

(defun mp-race-ai-rider-active? ((vehicle vehicle-racer))
  (let ((driver (get-rider-in-seat vehicle 0)))
    (and driver
         (nonzero? driver)
         (type? driver vehicle-rider)
         (not (mp-player-process-record driver))
         (logtest? (-> vehicle flags)
                   (rigid-body-object-flag ai-driving)))))

(defun mp-race-restore-ai-icon! ((vehicle vehicle-racer) (rider uint))
  (let ((minimap-icon (-> vehicle minimap)))
    (when (and minimap-icon (nonzero? minimap-icon))
      (logior! (-> minimap-icon flags) (minimap-flag fade-out)))
    (set! (-> vehicle minimap) #f)
    (when (and *minimap* (nonzero? *minimap*))
      (set! (-> vehicle minimap)
            (add-icon! *minimap* vehicle
                       (the-as uint (mp-race-ai-map-icon rider))
                       (the-as int #f) (the-as vector #t) 0))))
  (none))

(defun mp-race-spawn-ai-rider! ((vehicle vehicle-racer) (rider uint))
  (let ((spawn-params (new 'stack-no-clear 'traffic-object-spawn-params)))
    (set! (-> spawn-params user-data) rider)
    (set! (-> spawn-params flags) (traffic-spawn-flags spawn-rider))
    (spawn-default-vehicle-rider! vehicle spawn-params))
  (none))

(defun mp-race-restore-ai-racer! ((state race-state) (racer-index int))
  (when (or (not state)
            (zero? state)
            (< racer-index 0)
            (>= racer-index (-> state racer-count)))
    (return #f))
  (let ((info (-> state info)))
    (when (or (not info)
              (zero? info)
              (>= racer-index (-> info racer-count)))
      (return #f))
    (let* ((racer (-> state racer-array racer-index))
           (racer-info (-> info racer-array racer-index))
           (rider (the-as uint (-> racer-info rider)))
           (vehicle
             (the-as vehicle-racer
               (handle->process-safe (-> racer racer)))))
      (when (or (not (mp-race-ai-capable? racer-info))
                (not vehicle)
                (zero? vehicle)
                (not (type? vehicle vehicle-racer)))
        (return #f))
      (when (mp-race-ai-rider-active? vehicle)
        (return #t))
      (mp-vehicle-clear-seat-occupant! vehicle 0 (the-as object #f))
      (logclear! (-> vehicle flags)
                 (rigid-body-object-flag waiting-for-player
                                         player-driving
                                         player-grabbed))
      (logior! (-> vehicle flags)
               (rigid-body-object-flag riding ai-driving))
      (logclear! (-> vehicle focus-status) (focus-status grabbed))
      (logclear! (-> racer flags)
                 (racer-flags dead local-player remote-player))
      (set! (-> racer rider) (the-as uint8 rider))
      (mp-race-restore-ai-icon! vehicle rider)
      (mp-race-spawn-ai-rider! vehicle rider)
      (when (and (-> vehicle race path)
                 (nonzero? (-> vehicle race path)))
        (send-event vehicle
                    (if (logtest? (-> state flags) (race-flags begun))
                        'resume-ai-race
                        'waiting-for-start)))
      #t)))

(defun mp-race-retire-racer! ((state race-state) (racer-index int))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count))
             (not (mp-race-racer-retired? racer-index)))
    (logior! (-> *mp-race-sync-state* retired-racer-mask)
             (mp-race-racer-bit racer-index))
    (let* ((racer (-> state racer-array racer-index))
           (vehicle (the-as vehicle-racer (handle->process-safe (-> racer racer)))))
      (logior! (-> racer flags) (racer-flags dead))
      (when (and vehicle (nonzero? vehicle))
        (let ((minimap-icon (-> vehicle minimap)))
          (when (and minimap-icon (nonzero? minimap-icon))
            (logior! (-> minimap-icon flags) (minimap-flag fade-out))
            (set! (-> vehicle minimap) #f)))
        (deactivate vehicle)
        (set! (-> racer racer) (the-as handle #f))))))

(defun mp-race-find-unclaimed-open-racer ((state race-state))
  (let ((racer-index (+ (-> state racer-count) -1)))
    (while (>= racer-index 0)
      (when (and (mp-race-racer-open? racer-index)
                 (= (mp-race-bound-player-id racer-index)
                    (the-as uint MP_RACE_INVALID_INDEX))
                 (not (mp-race-racer-retired? racer-index)))
        (return racer-index))
      (-! racer-index 1)))
  (the-as int MP_RACE_INVALID_INDEX))

(defun mp-race-apply-dnf! ((state race-state)
                           (player-id uint)
                           (racer-index int))
  (when (or (>= player-id (the uint MP_MAX_PLAYERS))
            (not state)
            (zero? state))
    (return #f))
  (set! (-> *mp-race-sync-state* player-status player-id)
        (the-as uint8 MP_RACE_STATUS_DNF))
  (when (= racer-index (the-as int MP_RACE_INVALID_INDEX))
    (set! racer-index (mp-race-find-unclaimed-open-racer state)))
  (when (and (>= racer-index 0) (< racer-index (-> state racer-count)))
    (let ((info (-> state info)))
      (if (and info
               (nonzero? info)
               (< racer-index (the-as int (-> info racer-count)))
               (mp-race-ai-capable? (-> info racer-array racer-index))
               (mp-race-restore-ai-racer! state racer-index))
          #t
          (mp-race-retire-racer! state racer-index))))
  #t)

(defun mp-race-host-publish-dnf! ((state race-state)
                                  (player-id uint)
                                  (racer-index int))
  (mp-race-apply-dnf! state player-id racer-index)
  (mp-race-enqueue-event!
    MP_RACE_ACTION_DNF
    (the-as uint racer-index)
    player-id
    (the-as int MP_RACE_STATUS_DNF)
    0
    (mp-race-current-clock))
  (none))

(defun mp-race-host-update-disconnects! ((state race-state))
  (dotimes (player-index MP_MAX_PLAYERS)
    (let* ((player-id (the-as uint player-index))
           (player-bit (mp-race-player-bit player-id)))
      (when (and (logtest? (-> *mp-race-sync-state* participant-mask)
                           player-bit)
                 (= (the-as uint
                      (-> *mp-race-sync-state* player-status player-index))
                    MP_RACE_STATUS_ACTIVE))
        (let ((record (mp-player-record-by-id player-id)))
          (when (not (mp-race-record-connected? record))
            (mp-race-host-publish-dnf!
              state player-id (mp-race-bound-racer-index player-id)))))))
  (none))

(defun mp-race-host-dnf-active-racers! ((state race-state))
  (when (and state
             (nonzero? state)
             (mp-session-host?)
             (mp-race-sync-active?))
    (mp-for-each-player-record (player-id record)
      (let ((player-bit (mp-race-player-bit (the-as uint player-id))))
        (when (and (logtest? (-> *mp-race-sync-state* participant-mask)
                             player-bit)
                   (= (the-as uint
                        (-> *mp-race-sync-state* player-status player-id))
                      MP_RACE_STATUS_ACTIVE))
          (let ((racer-index (mp-race-bound-racer-index (the-as uint player-id))))
            (mp-race-host-publish-dnf! state (the-as uint player-id) racer-index))))))
  (none))

(defun task-manager-has-race-finisher? ((this task-manager))
  (when (and this (nonzero? this))
    (let ((race-proc (the-as race-manager (handle->process (-> this slave 0)))))
      (when (and race-proc
                 (nonzero? race-proc)
                 (type? race-proc race-manager)
                 (-> race-proc race-state)
                 (nonzero? (-> race-proc race-state))
                 (> (-> race-proc race-state finished-count) 0))
        (return #t))))
  #f)

(defun mp-race-sync-post-finish-timer! ((manager race-manager))
  (when (and manager
             (nonzero? manager)
             (mp-race-sync-active?))
    (let ((state (-> manager race-state)))
      (when (and state
                 (nonzero? state)
                 (> (-> state finished-count) 0))
        (let ((parent-proc (the-as task-manager (ppointer->process (-> manager parent)))))
          (when (and parent-proc
                     (nonzero? parent-proc)
                     (type? parent-proc task-manager)
                     (nonzero? (-> parent-proc start-time)))
            (let ((remaining (- (-> parent-proc time-limit)
                                (- (current-time) (-> parent-proc start-time)))))
              (when (> remaining MP_RACE_POST_FINISH_TIMEOUT)
                (set! (-> parent-proc time-limit)
                      (+ (- (current-time) (-> parent-proc start-time))
                         MP_RACE_POST_FINISH_TIMEOUT)))))))))
  (none))

(defun mp-race-host-all-participants-bound? ()
  (dotimes (player-index MP_MAX_PLAYERS)
    (let* ((player-id (the-as uint player-index))
           (player-bit (mp-race-player-bit player-id))
           (status
             (the-as uint
               (-> *mp-race-sync-state* player-status player-index))))
      (when (and (logtest? (-> *mp-race-sync-state* participant-mask)
                           player-bit)
                 (= status MP_RACE_STATUS_ACTIVE)
                 (= (mp-race-bound-racer-index player-id)
                    (the-as int MP_RACE_INVALID_INDEX)))
        (return #f))))
  #t)

(defun mp-race-host-all-racers-ready? ((state race-state))
  (dotimes (racer-index (-> state racer-count))
    (when (not (mp-race-racer-retired? racer-index))
      (let* ((racer (-> state racer-array racer-index))
             (vehicle (handle->process-safe (-> racer racer))))
        (when (or (not vehicle)
                  (zero? vehicle)
                  (not (send-event vehicle 'test-ready)))
          (return #f)))))
  #t)

(defun mp-race-host-all-ready? ((state race-state))
  (when (or (not (mp-session-host?))
            (not (mp-race-world-ready?))
            (not state)
            (zero? state))
    (return #f))
  (mp-race-host-update-disconnects! state)
  (dotimes (racer-index (-> state racer-count))
    (mp-race-host-bind-racer! state racer-index))
  (mp-race-apply-bindings! state)
  (and (mp-race-host-all-participants-bound?)
       (mp-race-host-all-racers-ready? state)))

(defun mp-race-host-authorize-start! ()
  (when (and (mp-session-host?)
             (zero? (-> *mp-race-sync-state* start-authorized?)))
    (set! (-> *mp-race-sync-state* start-authorized?) (the uint 1))
    (set! (-> *mp-race-sync-state* start-time) (the-as time-frame 0))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_START
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      0
      0
      (mp-race-current-clock)))
  (none))

(defun mp-race-host-schedule-go! ((state race-state))
  (when (and (mp-session-host?)
             state
             (nonzero? state)
             (nonzero? (-> *mp-race-sync-state* start-authorized?))
             (zero? (-> *mp-race-sync-state* start-time))
             (mp-race-host-all-ready? state))
    (set! (-> *mp-race-sync-state* start-time)
          (+ (mp-race-current-clock)
             MP_RACE_COUNTDOWN_FRAMES
             MP_RACE_START_BUFFER_FRAMES))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_START
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      1
      0
      (-> *mp-race-sync-state* start-time)))
  (none))

(defun mp-race-start-authorized? ()
  (or (not (mp-race-sync-active?))
      (nonzero? (-> *mp-race-sync-state* start-authorized?))))

(defun mp-race-start-time ()
  (-> *mp-race-sync-state* start-time))

(defun mp-race-racer-index ((state race-state) (racer racer-state))
  (when (and state (nonzero? state) racer (nonzero? racer))
    (dotimes (racer-index (-> state racer-count))
      (when (= racer (-> state racer-array racer-index))
        (return racer-index))))
  (the-as int MP_RACE_INVALID_INDEX))

(defun mp-race-racer-ai-takeover? ((state race-state) (racer-index int))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (let ((info (-> state info))
          (player-id (mp-race-bound-player-id racer-index)))
      (when (and info
                 (nonzero? info)
                 (< racer-index (-> info racer-count))
                 (< player-id (the uint MP_MAX_PLAYERS))
                 (= (the-as uint
                      (-> *mp-race-sync-state* player-status player-id))
                    MP_RACE_STATUS_DNF)
                 (mp-race-ai-capable? (-> info racer-array racer-index)))
        (return #t))))
  #f)

(defun mp-race-host-may-commit-lap? ((state race-state)
                                     (racer racer-state))
  (when (not (mp-race-sync-active?))
    (return #t))
  (when (not (mp-session-host?))
    (return #f))
  (let* ((racer-index (mp-race-racer-index state racer))
         (player-id (mp-race-bound-player-id racer-index)))
    (or (= player-id (the-as uint MP_RACE_INVALID_INDEX))
        (= player-id (mp-local-player-id))
        (mp-race-racer-ai-takeover? state racer-index)
        (and state
             (nonzero? state)
             (-> state info)
             (nonzero? (-> state info))
             (logtest? (-> state info flags)
                       (race-info-flags destination-race))))))

(defun mp-race-client-may-commit-lap? ((state race-state)
                                       (racer racer-state))
  (when (or (not (mp-race-sync-active?))
            (not (mp-session-client?)))
    (return #f))
  (let* ((racer-index (mp-race-racer-index state racer))
         (racer-bit (mp-race-racer-bit racer-index)))
    (and (= (mp-race-bound-player-id racer-index) (mp-local-player-id))
         (not (logtest? (-> *mp-race-sync-state* pending-progress-mask)
                        racer-bit)))))

(defun mp-race-client-request-progress! ((state race-state)
                                         (racer-index int))
  (when (and state
             (nonzero? state)
             (mp-session-client?)
             (mp-race-world-ready?)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (let ((racer (-> state racer-array racer-index)))
      (logior! (-> *mp-race-sync-state* pending-progress-mask)
               (mp-race-racer-bit racer-index))
      (mp-race-enqueue-event!
        MP_RACE_ACTION_PROGRESS_REQUEST
        (the-as uint racer-index)
        (mp-local-player-id)
        (the-as int (-> racer lap-count))
        0
        (mp-race-current-clock))))
  (none))

(defun mp-race-host-publish-progress! ((state race-state)
                                       (racer-index int))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (let* ((racer (-> state racer-array racer-index))
           (player-id (mp-race-bound-player-id racer-index)))
      (when (and (< player-id (the uint MP_MAX_PLAYERS))
                 (= (the-as uint
                      (-> *mp-race-sync-state* player-status player-id))
                    MP_RACE_STATUS_ACTIVE)
                 (logtest? (-> racer flags) (racer-flags finished)))
        (set! (-> *mp-race-sync-state* player-status player-id)
              (the-as uint8 MP_RACE_STATUS_FINISHED))
        (set! (-> *mp-race-sync-state* result-place player-id)
              (-> racer finish-count)))
      (mp-race-enqueue-event!
        MP_RACE_ACTION_PROGRESS_COMMIT
        (the-as uint racer-index)
        player-id
        (the-as int (-> racer lap-count))
        (the-as int (-> racer finish-count))
        (the-as time-frame (-> racer finish-time)))))
  (none))

(defun mp-race-host-observe-checkpoints! ((state race-state))
  (when (and state
             (nonzero? state)
             (logtest? (-> state flags) (race-flags begun))
             (not (logtest? (-> state info flags)
                            (race-info-flags destination-race))))
    (dotimes (racer-index (-> state racer-count))
      (when (not (mp-race-racer-retired? racer-index))
        (let* ((racer (-> state racer-array racer-index))
               (quadrant (the-as int (-> racer lap-quadrant))))
          (when (and (logtest? (-> racer flags) (racer-flags in-race))
                     (>= quadrant 0)
                     (< quadrant 4))
            (logior!
              (-> *mp-race-sync-state* observed-checkpoint-mask racer-index)
              (the-as uint8 (ash 1 quadrant))))))))
  (none))

(defun mp-race-host-progress-transition-valid? ((state race-state)
                                                 (racer-index int))
  (when (or (not state)
            (zero? state)
            (< racer-index 0)
            (>= racer-index (-> state racer-count)))
    (return #f))
  (let ((racer (-> state racer-array racer-index)))
    (if (logtest? (-> state info flags) (race-info-flags destination-race))
        (< (vector-vector-distance-squared
             (-> racer position)
             (the-as vector (-> state info finish-sphere)))
           (square (-> state info finish-sphere r)))
        (= (logand
             (the-as uint
               (-> *mp-race-sync-state*
                   observed-checkpoint-mask racer-index))
             #xf)
           #xf))))

(defun mp-race-request-local-dnf! ((state race-state))
  (when (or (not (mp-race-sync-active?))
            (not (mp-race-world-ready?))
            (not state)
            (zero? state))
    (return #f))
  (let* ((player-id (mp-local-player-id))
         (player-bit (mp-race-player-bit player-id))
         (racer-index (mp-race-bound-racer-index player-id)))
    (when (and (nonzero? player-bit)
               (logtest? (-> *mp-race-sync-state* participant-mask)
                         player-bit)
               (not (logtest? (-> *mp-race-sync-state* dnf-request-mask)
                              player-bit)))
      (logior! (-> *mp-race-sync-state* dnf-request-mask) player-bit)
      (if (mp-session-host?)
          (mp-race-host-publish-dnf! state player-id racer-index)
          (mp-race-enqueue-event!
            MP_RACE_ACTION_DNF
            (the-as uint racer-index)
            player-id
            (the-as int MP_RACE_STATUS_DNF)
            0
            (mp-race-current-clock)))))
  #t)

(defun mp-race-all-participants-terminal? ()
  (dotimes (player-index MP_MAX_PLAYERS)
    (let ((player-bit (mp-race-player-bit (the-as uint player-index))))
      (when (and (logtest? (-> *mp-race-sync-state* participant-mask)
                           player-bit)
                 (= (the-as uint
                      (-> *mp-race-sync-state* player-status player-index))
                    MP_RACE_STATUS_ACTIVE))
        (return #f))))
  #t)

(defun mp-race-any-human-won? ()
  (dotimes (player-index MP_MAX_PLAYERS)
    (let ((player-bit (mp-race-player-bit (the-as uint player-index))))
      (when (and (logtest? (-> *mp-race-sync-state* participant-mask)
                           player-bit)
                 (= (the-as uint
                      (-> *mp-race-sync-state* player-status player-index))
                    MP_RACE_STATUS_FINISHED)
                 (zero? (-> *mp-race-sync-state* result-place player-index)))
        (return #t))))
  #f)

(defun mp-race-host-finalize-results! ((state race-state))
  (when (or (not (mp-session-host?))
            (nonzero? (-> *mp-race-sync-state* results-ready?))
            (not (mp-race-all-participants-terminal?)))
    (return #f))
  (let ((success? (mp-race-any-human-won?)))
    (set! (-> *mp-race-sync-state* overall-success?)
          (if success? (the uint 1) (the uint 0)))
    (dotimes (player-index MP_MAX_PLAYERS)
      (let* ((player-id (the-as uint player-index))
             (player-bit (mp-race-player-bit player-id)))
        (when (logtest? (-> *mp-race-sync-state* participant-mask)
                        player-bit)
          (let* ((racer-index (mp-race-bound-racer-index player-id))
                 (finish-time
                   (if (and (>= racer-index 0)
                            (< racer-index (-> state racer-count)))
                       (the-as time-frame
                         (-> state racer-array racer-index finish-time))
                       (the-as time-frame 0))))
            (mp-race-enqueue-event!
              MP_RACE_ACTION_RESULTS
              (the-as uint racer-index)
              player-id
              (the-as int
                (-> *mp-race-sync-state* player-status player-index))
              (the-as int
                (-> *mp-race-sync-state* result-place player-index))
              finish-time)
            (set! (-> *mp-race-sync-state*
                      result-finish-time player-index)
                  finish-time)))))
    (set! (-> *mp-race-sync-state* results-ready?) (the uint 1))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_RESULTS
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      (if success? 1 0)
      0
      (mp-race-current-clock)))
  #t)

(defun mp-race-host-enqueue-config-snapshot! ()
  (let ((participant-count
          (mp-race-count-participants
            (-> *mp-race-sync-state* participant-mask))))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_CONFIG
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      (-> *mp-race-sync-state* active-racer-count)
      participant-count
      (mp-race-current-clock)))
  (none))

(defun mp-race-host-enqueue-binding-snapshot! ()
  (dotimes (racer-index (-> *mp-race-sync-state* active-racer-count))
    (let ((player-id (mp-race-bound-player-id racer-index)))
      (when (< player-id (the uint MP_MAX_PLAYERS))
        (mp-race-enqueue-event!
          MP_RACE_ACTION_BIND_COMMIT
          (the-as uint racer-index)
          player-id
          0
          0
          (mp-race-current-clock)))))
  (none))

(defun mp-race-host-enqueue-participant-snapshot! ((state race-state))
  (dotimes (player-index MP_MAX_PLAYERS)
    (let* ((player-id (the-as uint player-index))
           (player-bit (mp-race-player-bit player-id)))
      (when (logtest? (-> *mp-race-sync-state* participant-mask)
                      player-bit)
        (let ((racer-index (mp-race-bound-racer-index player-id)))
          (if (= (the-as uint
                   (-> *mp-race-sync-state* player-status player-index))
                 MP_RACE_STATUS_DNF)
              (mp-race-enqueue-event!
                MP_RACE_ACTION_DNF
                (the-as uint racer-index)
                player-id
                (the-as int MP_RACE_STATUS_DNF)
                0
                (mp-race-current-clock))
              (when (and (>= racer-index 0)
                         (< racer-index (-> state racer-count)))
                (mp-race-host-publish-progress! state racer-index)))))))
  (none))

(defun mp-race-host-enqueue-start-snapshot! ()
  (when (nonzero? (-> *mp-race-sync-state* start-authorized?))
    (let ((start-time (-> *mp-race-sync-state* start-time)))
      (mp-race-enqueue-event!
        MP_RACE_ACTION_START
        (the uint MP_RACE_INVALID_INDEX)
        MP_INVALID_PLAYER_ID
        (if (nonzero? start-time) 1 0)
        0
        (if (nonzero? start-time)
            start-time
            (mp-race-current-clock)))))
  (none))

(defun mp-race-host-enqueue-results-snapshot! ()
  (when (nonzero? (-> *mp-race-sync-state* results-ready?))
    (dotimes (player-index MP_MAX_PLAYERS)
      (let* ((player-id (the-as uint player-index))
             (player-bit (mp-race-player-bit player-id)))
        (when (logtest? (-> *mp-race-sync-state* participant-mask)
                        player-bit)
          (mp-race-enqueue-event!
            MP_RACE_ACTION_RESULTS
            (the-as uint (mp-race-bound-racer-index player-id))
            player-id
            (the-as int
              (-> *mp-race-sync-state* player-status player-index))
            (the-as int
              (-> *mp-race-sync-state* result-place player-index))
            (-> *mp-race-sync-state* result-finish-time player-index)))))
    (mp-race-enqueue-event!
      MP_RACE_ACTION_RESULTS
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      (if (nonzero? (-> *mp-race-sync-state* overall-success?)) 1 0)
      0
      (mp-race-current-clock)))
  (none))

(defun mp-race-host-enqueue-decision-snapshot! ()
  (let ((decision (-> *mp-race-sync-state* decision)))
    (when (!= decision MP_RACE_DECISION_NONE)
      (mp-race-enqueue-event!
        MP_RACE_ACTION_DECISION
        (the uint MP_RACE_INVALID_INDEX)
        MP_INVALID_PLAYER_ID
        (the-as int decision)
        0
        (mp-race-current-clock))))
  (none))

(defun mp-race-host-publish-snapshot! ((state race-state))
  (when (and *mp-race-sync-state* (nonzero? *mp-race-sync-state*))
    (mp-race-host-enqueue-config-snapshot!)
    (mp-race-host-enqueue-binding-snapshot!)
    (when (and state (nonzero? state))
      (mp-race-host-enqueue-participant-snapshot! state))
    (mp-race-host-enqueue-start-snapshot!)
    (mp-race-host-enqueue-results-snapshot!)
    (mp-race-host-enqueue-decision-snapshot!))
  (none))

(defun mp-race-host-refresh-roster! ((state race-state))
  (when (and state
             (nonzero? state)
             (zero? (-> *mp-race-sync-state* start-time)))
    (let* ((info (-> state info))
           (current-mask (-> *mp-race-sync-state* participant-mask))
           (candidate-mask (mp-race-build-participant-mask)))
      (when (and info
                 (nonzero? info)
                 (!= candidate-mask current-mask))
        (let* ((participant-count
                 (mp-race-count-participants candidate-mask))
               (retained-mask
                 (mp-race-retained-racer-mask candidate-mask))
               (open-mask
                 (mp-race-select-open-racers
                   info participant-count retained-mask)))
          (when (nonzero? open-mask)
            (mp-race-clear-stale-bindings! state candidate-mask open-mask)
            (set! (-> *mp-race-sync-state* participant-mask) candidate-mask)
            (set! (-> *mp-race-sync-state* open-racer-mask) open-mask)
            (set! (-> *mp-race-sync-state* active-racer-count)
                  (mp-race-multiplayer-racer-count info open-mask))
            (mp-race-host-publish-snapshot! state)
            (set! (-> *mp-race-sync-state* catchup-player-mask)
                  (mp-race-connected-remote-mask)))))))
  (none))

(defun mp-race-host-replay-for-late-joins! ((state race-state))
  (let ((connected-mask (mp-race-connected-remote-mask)))
    (set! (-> *mp-race-sync-state* catchup-player-mask)
          (logand (-> *mp-race-sync-state* catchup-player-mask)
                  connected-mask))
    (when (nonzero?
            (logand connected-mask
                    (lognot
                      (-> *mp-race-sync-state* catchup-player-mask))))
      (mp-race-host-publish-snapshot! state)
      (set! (-> *mp-race-sync-state* catchup-player-mask)
            connected-mask)))
  (none))

(defun mp-race-host-tick! ((state race-state))
  (when (and (mp-race-sync-active?)
             (mp-session-host?)
             (mp-race-world-ready?)
             state
             (nonzero? state))
    (mp-race-host-refresh-roster! state)
    (mp-race-host-replay-for-late-joins! state)
    (mp-race-host-update-disconnects! state)
    (mp-race-apply-bindings! state)
    (mp-race-host-observe-checkpoints! state)
    (when (logtest? (-> state flags) (race-flags begun))
      (when (> (-> state finished-count) 0)
        (let ((manager (the-as race-manager (handle->process (-> state manager)))))
          (when (and manager (nonzero? manager))
            (mp-race-sync-post-finish-timer! manager)
            (let ((parent-proc (the-as task-manager (ppointer->process (-> manager parent)))))
              (when (and parent-proc
                         (nonzero? parent-proc)
                         (type? parent-proc task-manager)
                         (nonzero? (-> parent-proc start-time))
                         (<= (- (-> parent-proc time-limit)
                                (- (current-time) (-> parent-proc start-time)))
                             0))
                (mp-race-host-dnf-active-racers! state))))))
      (mp-race-host-finalize-results! state)))
  (none))

(defun mp-race-results-ready? ()
  (and (mp-race-sync-active?)
       (nonzero? *mp-race-sync-state*)
       (nonzero? (-> *mp-race-sync-state* start-time))
       (nonzero? (-> *mp-race-sync-state* results-ready?))))

(defun mp-race-overall-success? ()
  (and (mp-race-results-ready?)
       (nonzero? (-> *mp-race-sync-state* overall-success?))))

(defun mp-race-result-participant? ((player-id uint))
  (and (mp-race-results-ready?)
       (< player-id (the uint MP_MAX_PLAYERS))
       (logtest? (-> *mp-race-sync-state* participant-mask)
                 (mp-race-player-bit player-id))))

(defun mp-race-result-player-at-place ((place int))
  (when (or (< place 0)
            (>= place MP_RACE_MAX_RACERS)
            (not (mp-race-results-ready?)))
    (return (the uint MP_RACE_INVALID_INDEX)))
  (dotimes (player-index MP_MAX_PLAYERS)
    (let ((player-id (the uint player-index)))
      (when (and (mp-race-result-participant? player-id)
                 (= (-> *mp-race-sync-state* player-status player-index)
                    MP_RACE_STATUS_FINISHED)
                 (= (-> *mp-race-sync-state* result-place player-index)
                    place))
        (return player-id))))
  (the uint MP_RACE_INVALID_INDEX))

(defun mp-race-result-player-dnf? ((player-id uint))
  (and (mp-race-result-participant? player-id)
       (= (-> *mp-race-sync-state* player-status (the int player-id))
          MP_RACE_STATUS_DNF)))

(defun mp-race-result-elapsed-time ((player-id uint))
  (when (or (not (mp-race-result-participant? player-id))
            (!= (-> *mp-race-sync-state* player-status (the int player-id))
                MP_RACE_STATUS_FINISHED))
    (return (the-as time-frame 0)))
  (let ((start-time (-> *mp-race-sync-state* start-time))
        (finish-time
          (-> *mp-race-sync-state* result-finish-time (the int player-id))))
    (if (and (nonzero? start-time) (>= finish-time start-time))
        (- finish-time start-time)
        (the-as time-frame 0))))

(defun mp-race-host-set-decision! ((decision uint))
  (when (and (mp-race-sync-active?)
             (mp-session-host?)
             (>= decision MP_RACE_DECISION_RETRY)
             (<= decision MP_RACE_DECISION_FAIL))
    (set! (-> *mp-race-sync-state* decision) decision)
    (mp-race-enqueue-event!
      MP_RACE_ACTION_DECISION
      (the uint MP_RACE_INVALID_INDEX)
      MP_INVALID_PLAYER_ID
      (the-as int decision)
      0
      (mp-race-current-clock)))
  (none))

(defun mp-race-decision ()
  (if (mp-race-sync-active?)
      (-> *mp-race-sync-state* decision)
      MP_RACE_DECISION_NONE))

(defun mp-race-event-from-host? ((event mp-race-event))
  (and event
       (nonzero? event)
       (= (-> event source-player-id) (mp-host-player-id))))

(defun mp-race-event-current-generation? ((event mp-race-event))
  (and event
       (nonzero? event)
       (= (-> event generation) (-> *mp-race-sync-state* generation))
       (= (-> event race-id) (-> *mp-race-sync-state* race-id))))

(defun mp-race-receive-config! ((event mp-race-event))
  (when (or (not (mp-race-event-from-host? event))
            (mp-session-host?)
            (not (mp-race-config-valid? event)))
    (return #f))
  (let ((current-generation (-> *mp-race-sync-state* generation)))
    (cond
      ((> (-> event generation) current-generation)
       (mp-race-reset-runtime!)
       (set! (-> *mp-race-sync-state* generation) (-> event generation))
       (set! (-> *mp-race-sync-state* race-id) (-> event race-id)))
      ((or (!= (-> event generation) current-generation)
           (!= (-> event race-id) (-> *mp-race-sync-state* race-id))
           (<= (-> event sequence)
               (-> *mp-race-sync-state* last-host-config-sequence))
           (and (nonzero? (-> *mp-race-sync-state* start-time))
                (or (!= (-> event participant-mask)
                         (-> *mp-race-sync-state* participant-mask))
                    (!= (-> event open-racer-mask)
                         (-> *mp-race-sync-state* open-racer-mask))
                    (!= (-> event value0)
                         (-> *mp-race-sync-state* active-racer-count)))))
       (return #f)))
    (mp-race-clear-stale-bindings!
      *race-state* (-> event participant-mask) (-> event open-racer-mask))
    (set! (-> *mp-race-sync-state* participant-mask)
          (-> event participant-mask))
    (set! (-> *mp-race-sync-state* open-racer-mask)
          (-> event open-racer-mask))
    (set! (-> *mp-race-sync-state* active-racer-count)
          (-> event value0))
    (set! (-> *mp-race-sync-state* last-host-config-sequence)
          (-> event sequence)))
  #t)

(defun mp-race-receive-bind! ((event mp-race-event))
  (let ((racer-index (the-as int (-> event racer-index)))
        (player-id (-> event player-id)))
    (when (and (>= racer-index 0)
               (< racer-index MP_RACE_MAX_RACERS)
               (< player-id (the uint MP_MAX_PLAYERS))
               (mp-race-racer-open? racer-index)
               (logtest? (-> *mp-race-sync-state* participant-mask)
                         (mp-race-player-bit player-id)))
      (set! (-> *mp-race-sync-state* bound-player-by-racer racer-index)
            (the-as uint8 player-id))
      (set! (-> *mp-race-sync-state* bound-racer-by-player player-id)
            (the-as uint8 racer-index))
      (when (and *race-state* (nonzero? *race-state*))
        (mp-race-apply-binding! *race-state* racer-index player-id))))
  (none))

(defun mp-race-receive-start! ((event mp-race-event))
  (set! (-> *mp-race-sync-state* start-authorized?) (the uint 1))
  (when (and (nonzero? (-> event value0))
             (nonzero? (-> event event-time)))
    (set! (-> *mp-race-sync-state* start-time) (-> event event-time)))
  (none))

(defun mp-race-host-accept-progress! ((event mp-race-event))
  (when (or (not *race-state*) (zero? *race-state*))
    (return #f))
  (let* ((source-player-id (-> event source-player-id))
         (racer-index (the-as int (-> event racer-index)))
         (record (mp-player-record-by-id source-player-id)))
    (when (or (>= source-player-id (the uint MP_MAX_PLAYERS))
              (< racer-index 0)
              (>= racer-index (-> *race-state* racer-count))
              (not (mp-race-world-ready?))
              (not (logtest? (-> *race-state* flags) (race-flags begun)))
              (zero? (-> *mp-race-sync-state* start-authorized?))
              (!= (mp-race-bound-player-id racer-index) source-player-id)
              (not (mp-race-record-connected? record))
              (!= (the-as uint
                    (-> *mp-race-sync-state* player-status source-player-id))
                  MP_RACE_STATUS_ACTIVE))
      (return #f))
    (let* ((racer (-> *race-state* racer-array racer-index))
           (vehicle
             (the-as vehicle (handle->process-safe (-> racer racer)))))
      (when (or (not vehicle)
                (zero? vehicle)
                (and (!= (-> vehicle net-id) (-> record vehicle vehicle-id))
                     (!= (-> vehicle net-id) (-> record vehicle state net-id))))
        (return #f)))
    (when (or (not (mp-race-host-progress-transition-valid?
                     *race-state* racer-index))
              (!= (-> event value0)
                  (+ (the-as int
                       (-> *race-state* racer-array racer-index lap-count))
                     1))
              (<= (-> event event-time) (mp-race-start-time))
              (<= (-> event event-time)
                  (-> *mp-race-sync-state* last-progress-time
                      source-player-id)))
      (mp-race-host-publish-progress! *race-state* racer-index)
      (return #f))
    (set! (-> *mp-race-sync-state* last-progress-time source-player-id)
          (-> event event-time))
    (set! (-> *mp-race-sync-state* observed-checkpoint-mask racer-index)
          (the uint8 1))
    (mp-race-commit-lap! *race-state* racer-index)
    (mp-race-host-publish-progress! *race-state* racer-index))
  #t)

(defun mp-race-receive-progress-commit! ((event mp-race-event))
  (let ((racer-index (the-as int (-> event racer-index))))
    (when (and *race-state*
               (nonzero? *race-state*)
               (>= racer-index 0)
               (< racer-index (-> *race-state* racer-count)))
      (logclear! (-> *mp-race-sync-state* pending-progress-mask)
                 (mp-race-racer-bit racer-index))
      (mp-race-reconcile-progress!
        *race-state*
        racer-index
        (-> event value0)
        (-> event value1)
        (-> event event-time))))
  (none))

(defun mp-race-host-accept-dnf! ((event mp-race-event))
  (when (or (not *race-state*)
            (zero? *race-state*)
            (not (mp-race-world-ready?)))
    (return #f))
  (let* ((player-id (-> event source-player-id))
         (racer-index (mp-race-bound-racer-index player-id)))
    (when (and (< player-id (the uint MP_MAX_PLAYERS))
               (logtest? (-> *mp-race-sync-state* participant-mask)
                         (mp-race-player-bit player-id))
               (= (the-as uint
                    (-> *mp-race-sync-state* player-status player-id))
                  MP_RACE_STATUS_ACTIVE))
      (mp-race-host-publish-dnf! *race-state* player-id racer-index)))
  #t)

(defun mp-race-receive-dnf! ((event mp-race-event))
  (let ((player-id (-> event player-id))
        (racer-index (the-as int (-> event racer-index))))
    (when (< player-id (the uint MP_MAX_PLAYERS))
      (mp-race-apply-dnf! *race-state* player-id racer-index)))
  (none))

(defun mp-race-receive-results! ((event mp-race-event))
  (let ((player-id (-> event player-id)))
    (if (< player-id (the uint MP_MAX_PLAYERS))
        (begin
          (set! (-> *mp-race-sync-state* player-status player-id)
                (the-as uint8 (-> event value0)))
          (set! (-> *mp-race-sync-state* result-place player-id)
                (the-as int8 (-> event value1)))
          (set! (-> *mp-race-sync-state* result-finish-time player-id)
                (-> event event-time)))
        (begin
          (set! (-> *mp-race-sync-state* overall-success?)
                (if (nonzero? (-> event value0)) (the uint 1) (the uint 0)))
          (set! (-> *mp-race-sync-state* results-ready?) (the uint 1)))))
  (none))

(defun mp-race-receive-event! ((event mp-race-event))
  (when (or (not event) (zero? event))
    (return #f))
  (case (-> event action)
    ((MP_RACE_ACTION_CONFIG)
     (mp-race-receive-config! event))
    ((MP_RACE_ACTION_CONFIG_REQUEST)
     (when (and (mp-session-host?)
                *race-state*
                (nonzero? *race-state*))
       (mp-race-host-publish-snapshot! *race-state*)))
    ((MP_RACE_ACTION_PROGRESS_REQUEST)
     (when (and (mp-session-host?)
                (mp-race-event-current-generation? event))
       (mp-race-host-accept-progress! event)))
    ((MP_RACE_ACTION_DNF)
     (cond
       ((and (mp-session-host?)
             (not (mp-race-event-from-host? event))
             (mp-race-event-current-generation? event))
        (mp-race-host-accept-dnf! event))
       ((and (not (mp-session-host?))
             (mp-race-event-from-host? event)
             (mp-race-event-current-generation? event))
        (mp-race-receive-dnf! event))))
    (else
     (when (and (not (mp-session-host?))
                (mp-race-event-from-host? event)
                (mp-race-event-current-generation? event))
       (case (-> event action)
         ((MP_RACE_ACTION_BIND_COMMIT) (mp-race-receive-bind! event))
         ((MP_RACE_ACTION_START) (mp-race-receive-start! event))
         ((MP_RACE_ACTION_PROGRESS_COMMIT)
          (mp-race-receive-progress-commit! event))
         ((MP_RACE_ACTION_RESULTS) (mp-race-receive-results! event))
         ((MP_RACE_ACTION_DECISION)
          (set! (-> *mp-race-sync-state* decision)
                (the-as uint (-> event value0))))))))
  #t)

(mp-race-reset-all!)
