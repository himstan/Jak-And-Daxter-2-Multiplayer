;;-*-Lisp-*-
(in-package goal)

(defun mp-race-racer-local-player? ((racer racer-state))
  (let ((vehicle (handle->process-safe (-> racer racer))))
    (and vehicle
         (mp-local-player-record)
         (= (-> (the-as vehicle vehicle) net-id)
            (-> (mp-local-player-record) vehicle vehicle-id)))))

(defun mp-race-racer-remote-player? ((racer racer-state))
  (let ((vehicle (handle->process-safe (-> racer racer))))
    (and vehicle
         (nonzero? vehicle)
         (nonzero?
           (mp-remote-player-record-by-vehicle-id
             (-> (the-as vehicle vehicle) net-id))))))
