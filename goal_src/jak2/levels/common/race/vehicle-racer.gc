;;-*-Lisp-*-
(in-package goal)

(defmethod compute-rider-hand-position ((this vehicle-racer) (result vector) (seat int) (hand int))
  (vector-matrix*! result
                   (-> this info rider-hand-offset hand)
                   (-> this node-list data (-> this rider-hand-joint) bone transform))
  (none))

(defmethod spawn-default-vehicle-rider! ((this vehicle-racer) (params traffic-object-spawn-params))
  (vehicle-rider-spawn this
                       (if (= (-> params user-data) 2) errol-rider stadium-racer)
                       params)
  (none))

(defmethod debug-draw-race-path-slice ((this vehicle-racer) (path race-path) (slice race-mesh-slice))
  "Draw the section of a race path associated with a mesh slice."
  (let ((start-pos (new 'stack-no-clear 'vector))
        (end-pos (new 'stack-no-clear 'vector))
        (start-t (-> (the-as (pointer float) (+ (* (-> slice start-edge) 4) (the-as int (-> path edge-infos))))))
        (end-t (-> (the-as (pointer float) (+ (* (-> slice end-edge) 4) (the-as int (-> path edge-infos)))))))
    (when (and (>= start-t 0.0) (>= end-t 0.0))
      (race-path-position-at path start-pos start-t end-t)
      (race-path-position-at path end-pos end-t start-t)
      (add-debug-line #t (bucket-id debug-no-zbuf1) start-pos end-pos *color-cyan* #f (the-as rgba -1))))
  (none))

(defmethod vehicle-method-120 ((this vehicle-racer))
  (when (logtest? (-> this flags) (rigid-body-object-flag player-driving))
    (set! (-> *game-info* race-number-turbos) (-> this turbo-pickup-count)))
  (logior! (-> this skel status) (joint-control-status sync-math))
  ((method-of-type vehicle vehicle-method-120) this)
  (set! (-> this root trans-old-old-old quad) (-> this root trans-old-old quad))
  (set! (-> this root trans-old-old quad) (-> this root trans-old quad))
  (set! (-> this root trans-old quad) (-> this root trans quad))
  (none))

(defmethod activate-turbo-boost! ((this vehicle-racer))
  (when (and (not (logtest? (rigid-body-object-flag turbo-boost) (-> this flags)))
             (> (-> this turbo-pickup-count) 0))
    (+! (-> this turbo-pickup-count) -1)
    (set-time! (-> this turbo-boost-time))
    (set! (-> this turbo-boost-factor) 1.0)
    (set! (-> this turbo-boost-duration) (the-as uint 150))
    (logior! (-> this flags) (rigid-body-object-flag turbo-boost))
    (when (logtest? (-> this flags) (rigid-body-object-flag player-driving))
      (sound-play "turbo-boost")))
  (none))

(defun destination-race-vehicle? ((this vehicle-racer))
  "Return true when this racer belongs to a destination race without a race mesh."
  (let ((state (-> this race state)))
    (and state
         (nonzero? state)
         (let ((info (-> state info)))
           (and info
                (nonzero? info)
                (logtest? (-> info flags) (race-info-flags destination-race)))))))

(defun wait-for-destination-race-player! ((this vehicle-racer))
  "Keep an unoccupied destination-race bike available for the local player."
  (logior! (-> this flags) (rigid-body-object-flag waiting-for-player))
  (logior! (-> this focus-status) (focus-status grabbed))
  (go (method-of-object this waiting-race))
  (none))

(defmethod start-from-spawn-params! ((this vehicle-racer) (params traffic-object-spawn-params))
  (set! (-> this draw lod-set lod 1 dist) 819200.0)
  (set! (-> this draw lod-set lod 2 dist) 1228800.0)
  (let ((state *race-state*))
    (initialize-race-control! (-> this race) state (-> state racer-array (-> params id))))

  (set! (-> this shortcut-speed-factor) 0.0)
  (case (-> params behavior)
    ((10)
     (cond
       ((-> this race mesh)
        (select-race-path! (-> this race) (-> this traffic-priority-id) (-> this root trans))
        (cond
          ((logtest? (-> params flags) (traffic-spawn-flags spawn-rider))
           (logior! (-> this flags) (rigid-body-object-flag riding ai-driving))
           (cond
             ((-> this race path)
              (go (method-of-object this waiting-for-start)))
             (else
              (format 0 "vehicle-racer::go-start-state: ERROR, no race-paths found~%")
              (go (method-of-object this die)))))
          (else
           (logior! (-> this flags) (rigid-body-object-flag waiting-for-player))
           (logior! (-> this focus-status) (focus-status grabbed))
           (go (method-of-object this waiting-race)))))
       ((and (destination-race-vehicle? this)
             (not (logtest? (-> params flags) (traffic-spawn-flags spawn-rider))))
        (wait-for-destination-race-player! this))
       (else
        (format #t "ERROR: vehicle-racer::go-start-state: no race-mesh found~%")
        (go (method-of-object this die)))))
    (else
     ((method-of-type vehicle start-from-spawn-params!) this params)))
  (none))

(defmethod send-vehicle-player-control! ((this vehicle-racer))
  (if (focus-test? this grabbed)
      (go (method-of-object this waiting-for-start))
      (go (method-of-object this player-control)))
  (none))

(defmethod rigid-body-object-method-45 ((this vehicle-racer) (impact rigid-body-impact))
  ((method-of-type vehicle rigid-body-object-method-45) this impact)
  (when (and (logtest? (-> this flags) (rigid-body-object-flag player-driving))
             (< 40960.0 (-> impact impulse))
             (< 0.0 (-> this hit-points)))
    (if (-> impact rbody)
        (dotimes (seat (-> this info seat-count))
          (send-event (handle->process (-> this rider-array seat)) 'vehicle-got-hit impact))
        (dotimes (seat (-> this info seat-count))
          (send-event (handle->process (-> this rider-array seat)) 'vehicle-hit impact))))
  (none))

(defmethod rigid-body-object-method-46
    ((this vehicle-racer) (sender process-drawable) (event-id int) (event symbol) (message event-message-block))
  (case event
    (('test-ready)
     (and (-> this next-state)
          (= (-> this next-state name) 'waiting-for-start)
          (logtest? (-> this flags) (rigid-body-object-flag riding))))

    (('begin-race)
     (logclear! (-> this focus-status) (focus-status grabbed))
     (when (and (-> this next-state) (= (-> this next-state name) 'waiting-for-start))
       (cond
         ((logtest? (-> this flags) (rigid-body-object-flag player-driving))
          (logclear! (-> this flags) (rigid-body-object-flag player-grabbed))
          (go (method-of-object this player-control)))
         (else
          (go (method-of-object this racing))))))

    (('turbo-pickup)
     (when (< (-> this turbo-pickup-count) 3)
       (sound-play "turbo-pickup")
       (when (logtest? (-> this flags) (rigid-body-object-flag player-driving))
         (sound-play "turbo-pickup-pl")
         (send-event *target* 'color-effect 'eco-pill-dark (seconds 0.2)))
       (+! (-> this turbo-pickup-count) 1)
       #t))

    (('race-decision-point)
     (when (logtest? (rigid-body-object-flag ai-driving) (-> this flags))
       (let* ((decision (the-as race-decision-point (-> message param 0)))
              (decision-type (-> decision decision-type)))
         (cond
           ((zero? decision-type)
            (cond
              ((and (nonzero? (-> decision shortcuts))
                    (>= (-> this race racer-state speed-factor) (-> this race state info ai-max-speed-factor))
                    (< 0.1 (- (+ (-> this race state target-pos)
                                  (-> this race racer-state target-pos-offset))
                               (-> this race racer-state pos))))
               (select-path-randomly-from-mask this (-> decision shortcuts))
               (set-time! (-> this shortcut-time))
               (set! (-> this shortcut-speed-factor) 1.0))
              (else
               (select-path-randomly-from-mask this (-> decision safe-paths))
               (set! (-> this shortcut-speed-factor) 0.0))))
           ((= decision-type 1)
            (when (and (> (-> this turbo-pickup-count) 0)
                       (< (-> this path-deviation) 1.0)
                       (>= (-> this race racer-state speed-factor) (-> this race state info ai-max-speed-factor)))
              (rigid-body-object-method-38 this)
              (activate-turbo-boost! this)))))))

    (('hide)
     (logior! (-> this draw status) (draw-control-status no-draw))
     (send-event (ppointer->process (-> this child)) 'hide))

    (('unhide)
     (logclear! (-> this draw status) (draw-control-status no-draw))
     (send-event (ppointer->process (-> this child)) 'unhide))

    (('race-pass)
     (if (logtest? (-> this flags) (rigid-body-object-flag player-driving))
         (speech-control-method-12 *speech-control* this
                                   (if (-> *target* pilot as-daxter?)
                                       (speech-type speech-type-45)
                                       (speech-type speech-type-36)))
         (send-event (ppointer->process (-> this child)) 'race-pass)))

    (('race-got-passed)
     (when (not (logtest? (-> this flags) (rigid-body-object-flag player-driving)))
       (send-event (ppointer->process (-> this child)) 'race-got-passed)))

    (('race-finished)
     (let ((safe-paths (-> message param 0)))
       (select-path-randomly-from-mask this safe-paths)
       (set! (-> this damage-factor) 0.0)
       (cond
         ((logtest? (-> this flags) (rigid-body-object-flag player-driving))
          (logior! (-> this flags) (rigid-body-object-flag player-grabbed))
          (when (zero? safe-paths)
            (set! (-> this race path) #f)
            #f))
         (else
          (go (method-of-object this race-finished))))))

    (else
     ((method-of-type vehicle rigid-body-object-method-46) this sender event-id event message))))

(defmethod select-path-randomly-from-mask ((this vehicle-racer) (path-mask uint))
  "Choose one path uniformly from the low eight bits of a path mask."
  (let ((path-count 0)
        (path-index 0)
        (paths (new 'stack-no-clear 'array 'int8 12))
        (remaining (logand path-mask 255)))
    (while (nonzero? remaining)
      (set! (-> paths path-count) path-index)
      (+! path-count (logand remaining 1))
      (+! path-index 1)
      (set! remaining (shr remaining 1)))

    (when (> path-count 0)
      (let ((selected-path (-> paths (rand-vu-int-count path-count))))
        (format #t "vehicle-racer::select-path-randomly-from-mask: switching to path-~d~%" selected-path)
        (select-race-path! (-> this race) selected-path (-> this root trans)))))
  (none))

(defmethod update-kinematic-race-motion! ((this vehicle-racer))
  "Follow the race path while full rigid-body physics is disabled."
  (let ((race (-> this race)))
    (when (nonzero? race)
      (advance-race-path! race 0.0)
      (let* ((body (-> this rbody))
             (state (-> body state))
             (dt (seconds-per-frame))
             (path-speed (vector-length (-> race lin-velocity)))
             (speed-scale (fmin (* (+ (vector-length (-> state lin-velocity)) (* 163840.0 dt))
                                    (/ 1.0 (fmax 1.0 path-speed)))
                                (-> race racer-state speed-factor)))
             (target-rotation (new 'stack-no-clear 'quaternion))
             (target-velocity (new 'stack-no-clear 'vector))
             (path-offset (new 'stack-no-clear 'vector))
             (velocity-change (new 'stack-no-clear 'vector)))

        (quaternion-copy! target-rotation (-> race path-sample quat))
        (vector-float*! target-velocity (-> race lin-velocity) speed-scale)
        (vector-! path-offset (-> race path-sample pos) (-> state position))

        (set! (-> this path-deviation)
              (* (+ (* (-> path-offset x) (-> path-offset x))
                    (* (-> path-offset y) (-> path-offset y))
                    (* (-> path-offset z) (-> path-offset z)))
                 (/ 1.0 (square 40960.0))))

        (+! (-> target-velocity x) (-> path-offset x))
        (+! (-> target-velocity y) (-> path-offset y))
        (+! (-> target-velocity z) (-> path-offset z))
        (set! (-> velocity-change x) (* 16.0 (- (-> target-velocity x) (-> state lin-velocity x))))
        (set! (-> velocity-change y) (* 16.0 (- (-> target-velocity y) (-> state lin-velocity y))))
        (set! (-> velocity-change z) (* 16.0 (- (-> target-velocity z) (-> state lin-velocity z))))

        (let ((max-acceleration 819200.0)
              (velocity-change-sq (+ (* (-> velocity-change x) (-> velocity-change x))
                                     (* (-> velocity-change y) (-> velocity-change y))
                                     (* (-> velocity-change z) (-> velocity-change z)))))
          (when (< (square max-acceleration) velocity-change-sq)
            (vector-normalize! velocity-change max-acceleration)))

        (+! (-> state lin-velocity x) (* (-> velocity-change x) dt))
        (+! (-> state lin-velocity y) (* (-> velocity-change y) dt))
        (+! (-> state lin-velocity z) (* (-> velocity-change z) dt))
        (+! (-> state position x) (* (-> state lin-velocity x) dt))
        (+! (-> state position y) (* (-> state lin-velocity y) dt))
        (+! (-> state position z) (* (-> state lin-velocity z) dt))
        (quaternion-pseudo-seek (-> state rotation) (-> state rotation) target-rotation (* 10.0 dt))

        (vector-float*! (-> state lin-momentum) (-> state lin-velocity) (-> this info info mass))
        (vector-reset! (-> state ang-momentum))
        (rigid-body-method-24 state)
        (rigid-body-method-13 state)

        (set! (-> this root transv quad) (-> state lin-velocity quad))
        (quaternion-copy! (-> this root quat) (-> state rotation))
        (rigid-body-method-23 state (-> this root trans))

        (let ((bone-transform (-> this node-list data 0 bone transform))
              (body-matrix (-> state matrix)))
          (set! (-> bone-transform quad 0) (-> body-matrix quad 0))
          (set! (-> bone-transform quad 1) (-> body-matrix quad 1))
          (set! (-> bone-transform quad 2) (-> body-matrix quad 2))
          (set! (-> bone-transform trans quad) (-> body-matrix trans quad)))
        (set! (-> this node-list data 0 bone transform trans quad) (-> this root trans quad))

        (advance-race-path! race (* dt speed-scale)))))

  (update-rider-seat-transforms! this)
  (vehicle-method-120 this)
  (update-transforms (-> this root))
  (let ((overlap-params (new 'stack-no-clear 'overlaps-others-params)))
    (set! (-> overlap-params options) (overlaps-others-options))
    (set! (-> overlap-params collide-with-filter) (collide-spec civilian enemy obstacle))
    (set! (-> overlap-params tlist) *touching-list*)
    (find-overlapping-shapes (-> this root) overlap-params))
  (none))

(defmethod physics-post ((this vehicle-racer))
  "Update AI path following and controls while rigid-body physics is active."
  (let ((race (-> this race)))
    (let* ((state (-> this rbody state))
           (dt (seconds-per-frame))
           (position (-> state position))
           (velocity (-> state lin-velocity))
           (forward (new 'stack-no-clear 'vector))
           (path-offset (new 'stack-no-clear 'vector))
           (desired-velocity (new 'stack-no-clear 'vector))
           (velocity-error (new 'stack-no-clear 'vector))
           (steering-error (new 'stack-no-clear 'vector))
           (lookahead-sample (new 'stack-no-clear 'race-path-sample))
           (lookahead-velocity (new 'stack-no-clear 'vector))
           (controls (new 'stack-no-clear 'vector)))

      (set! (-> forward quad) (-> state matrix quad 0))
      (set! (-> forward y) 0.0)
      (vector-normalize! forward 1.0)

      (sync-race-path-to-position! race position)

      (let* ((current-speed (vector-length velocity))
             (path-speed (vector-length (-> race lin-velocity)))
             (desired-speed (* path-speed (fmax (-> race racer-state speed-factor)
                                                (-> this shortcut-speed-factor))))
             (turn-speed (* (-> state ang-velocity y) current-speed))
             (sample (-> race path-sample)))

        (when (logtest? (rigid-body-object-flag in-air turbo-boost) (-> this flags))
          (set! desired-speed (* 2.0 desired-speed)))

        (let ((sample-steering (* 0.007874016 (the float (-> sample stick-x))))
              (sample-throttle (* 0.003921569 (the float (-> sample throttle)))))
          (let ((lookahead-t (+ (-> race path-t) (* 1.875 (/ 1.0 path-speed) current-speed))))
            (race-path-sample-at (-> race path) lookahead-sample lookahead-velocity lookahead-t))

          (vector-! path-offset (-> sample pos) position)
          (let ((path-deviation
                  (+ (* (+ (* (-> path-offset x) (-> path-offset x))
                           (* (-> path-offset y) (-> path-offset y))
                           (* (-> path-offset z) (-> path-offset z)))
                        (/ 1.0 (square 40960.0)))
                     (* (vector-vector-distance-squared (-> race lin-velocity) velocity)
                        (/ 1.0 (square 40960.0))))))
            (set! (-> this path-deviation) path-deviation)

            (set! (-> desired-velocity x) (+ (-> lookahead-velocity x) (-> path-offset x)))
            (set! (-> desired-velocity y) (+ (-> lookahead-velocity y) (-> path-offset y)))
            (set! (-> desired-velocity z) (+ (-> lookahead-velocity z) (-> path-offset z)))
            (set! (-> velocity-error x) (- (-> desired-velocity x) (-> velocity x)))
            (set! (-> velocity-error y) (- (-> desired-velocity y) (-> velocity y)))
            (set! (-> velocity-error z) (- (-> desired-velocity z) (-> velocity z)))
            (set! (-> steering-error x) (* 1.5 (-> velocity-error x)))
            (set! (-> steering-error y) (* 1.5 (-> velocity-error y)))
            (set! (-> steering-error z) (* 1.5 (-> velocity-error z)))

            (let ((throttle-delta (* 0.00036621094 (- desired-speed current-speed) dt)))
              (set! (-> this ai-controls throttle)
                    (fmax 0.0 (fmin 1.0 (+ (-> this ai-controls throttle) throttle-delta)))))

            (set! (-> this ai-controls brake)
                  (fmax 0.0 (fmin 1.0 (* 0.000048828126 (+ (- -4096.0 desired-speed) current-speed)))))
            (+! (-> this ai-controls brake)
                (* (- (-> this ai-controls brake)) (fmin 1.0 (* 8.0 dt))))

            (set! (-> this ai-controls steering)
                  (fmax -1.0
                        (fmin 1.0
                              (* 0.000000000048894434
                                 (+ 40960.0 desired-speed)
                                 (vector-dot forward steering-error)))))

            (let ((deviation-blend (fmin 1.0 path-deviation)))
              (set! (-> controls x)
                    (+ (* sample-steering (- 1.0 deviation-blend))
                       (* (-> this ai-controls steering) deviation-blend))))
            (set! (-> controls y) (-> this ai-controls throttle))
            (set! (-> controls w) (* 0.007874016 (the float (-> sample stick-y))))
            (set! (-> controls z) (-> this ai-controls brake))
            (vehicle-method-95 this controls))))

      (when (logtest? (-> race path-sample flags) 2)
        (start-jump this))))

  (vehicle-method-121 this)
  (when (< (-> this rbody state position y) -409600.0)
    (format #t "vehicle-racer::physics-post: pid ~d fell to death from path-id ~d~%"
            (-> this pid) (-> this race path record-id))
    (go (method-of-object this explode)))
  (none))

(defmethod update-race-physics-lod! ((this vehicle-racer))
  "Enable or disable full vehicle physics based on distance and visibility."
  (cond
    ((logtest? (-> this rbody state flags) (rigid-body-flag enable-physics))
     (when (and (logtest? (-> this flags) (rigid-body-object-flag on-ground))
                (not (logtest? (rigid-body-object-flag turbo-boost) (-> this flags)))
                (or (< (square 368640.0) (-> this player-dist2))
                    (and (< (square 102400.0) (-> this player-dist2))
                         (not (logtest? (-> this draw status) (draw-control-status on-screen))))))
       (rigid-body-object-method-39 this)))
    (else
     (when (and (< (-> this player-dist2) (square 348160.0))
                (or (< (-> this player-dist2) (square 81920.0))
                    (logtest? (-> this draw status) (draw-control-status on-screen))
                    (logtest? (rigid-body-object-flag turbo-boost) (-> this flags))))
       (rigid-body-object-method-38 this))))
  (none))

(defmethod update-ai-racing! ((this vehicle-racer))
  "Update an AI-controlled racer during the active race."
  (set! (-> this camera-dist2) (vector-vector-distance-squared (-> this rbody state position) (camera-pos)))
  (set! (-> this player-dist2) (vector-vector-distance-squared (-> this rbody state position) (target-pos 0)))

  (when (time-elapsed? (-> this shortcut-time) (seconds 5))
    (set! (-> this shortcut-speed-factor) 0.0))

  (update-race-physics-lod! this)
  (if (logtest? (-> this rbody state flags) (rigid-body-flag enable-physics))
      (physics-post this)
      (update-kinematic-race-motion! this))
  (none))

(defmethod update-race-finished! ((this vehicle-racer))
  "Update a racer after finishing while it remains attached to a race path."
  (set! (-> this camera-dist2) (vector-vector-distance-squared (-> this rbody state position) (camera-pos)))
  (set! (-> this player-dist2) (vector-vector-distance-squared (-> this rbody state position) (target-pos 0)))
  (set! (-> this shortcut-speed-factor) 0.0)

  (update-race-physics-lod! this)
  (when (and (logtest? (-> this flags) (rigid-body-object-flag player-driving))
             (not (logtest? (-> this rbody state flags) (rigid-body-flag enable-physics))))
    (rigid-body-object-method-38 this))

  (if (logtest? (-> this rbody state flags) (rigid-body-flag enable-physics))
      (physics-post this)
      (update-kinematic-race-motion! this))
  (none))

(defmethod vehicle-method-124 ((this vehicle-racer))
  (cond
    ((and (logtest? (rigid-body-object-flag player-grabbed) (-> this flags))
          (-> this race path))
     (update-race-finished! this))
    (else
     (vehicle-method-94 this)
     (vehicle-method-121 this)))
  (vehicle-method-97 this)
  (none))

(defstate waiting-race (vehicle-racer)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self flags) (rigid-body-object-flag ignition))
    (set! (-> self controls throttle) 0.0)
    (set! (-> self controls brake) 0.0)
    (set! (-> self controls steering) 0.0)
    (set! (-> self damage-factor) 0.0)
    (reset-flight-level-transition! self)
    (update-navmesh-membership! self)
    (let ((vehicle-prim (find-prim-by-id-logtest (-> self root) (the-as uint 32))))
      (when vehicle-prim
        (set! (-> vehicle-prim prim-core collide-with) (collide-spec))
        (set! (-> vehicle-prim prim-core collide-as) (collide-spec))
        )
      )
    )
  :exit (behavior ()
    (set! (-> self hit-points) 1.0)
    (logclear! (-> self flags) (rigid-body-object-flag waiting-for-player))
    (let ((vehicle-prim (find-prim-by-id-logtest (-> self root) (the-as uint 32))))
      (when vehicle-prim
        (set! (-> vehicle-prim prim-core collide-with)
              (collide-spec backgnd crate civilian enemy obstacle vehicle-sphere
                            hit-by-player-list hit-by-others-list collectable pusher))
        (set! (-> vehicle-prim prim-core collide-as) (collide-spec vehicle-sphere))
        )
      )
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (when (logtest? (-> self flags) (rigid-body-object-flag waiting-for-player))
      (set! (-> self camera-dist2) (vector-vector-distance-squared (-> self root trans) (camera-pos)))
      (set! (-> self player-dist2) (vector-vector-distance-squared (-> self root trans) (target-pos 0)))
      (check-player-get-on self)
      )
    (vector-reset! (-> self target-acceleration))
    (vehicle-method-120 self)
    (update-transforms (-> self root))
    (update-rider-seat-transforms! self)
    (rigid-body-object-method-39 self)
    )
  )

(defstate waiting-for-start (vehicle-racer)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (set! (-> self damage-factor) (-> self info damage-factor))
    (update-navmesh-membership! self)
    (logior! (-> self flags) (rigid-body-object-flag ignition))
    )
  :code sleep-code
  :post (behavior ()
    (vector-reset! (-> self target-acceleration))
    (logclear! (-> self flags) (rigid-body-object-flag player-impulse-force player-contact-force))
    (let ((state (-> self rbody state)))
      (set! (-> state force quad) (the-as uint128 0))
      (set! (-> state torque quad) (the-as uint128 0))
      )
    (clear-momentum! (-> self rbody state))
    (vehicle-method-120 self)
    (update-rider-seat-transforms! self)
    )
  )

(defstate racing (vehicle-racer)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self flags) (rigid-body-object-flag riding ignition))
    (set! (-> self controls throttle) 0.0)
    (set! (-> self controls brake) 0.0)
    (set! (-> self controls steering) 0.0)
    )
  :exit (behavior ()
    (logclear! (-> self flags) (rigid-body-object-flag waiting-for-player))
    (let ((vehicle-prim (find-prim-by-id-logtest (-> self root) (the-as uint 32))))
      (when vehicle-prim
        (set! (-> vehicle-prim prim-core collide-with)
              (collide-spec backgnd crate civilian enemy obstacle vehicle-sphere
                            hit-by-player-list hit-by-others-list collectable pusher))
        (set! (-> vehicle-prim prim-core collide-as) (collide-spec vehicle-sphere))
        )
      )
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (update-ai-racing! self)
    )
  )

(defstate race-finished (vehicle-racer)
  :virtual #t
  :event vehicle-event-handler
  :enter (behavior ()
    (set-time! (-> self state-time))
    (logior! (-> self flags) (rigid-body-object-flag persistent riding nav-spheres))
    (set! (-> self controls throttle) 0.0)
    (set! (-> self controls brake) 0.0)
    (set! (-> self controls steering) 0.0)
    )
  :trans #f
  :code sleep-code
  :post (behavior ()
    (update-race-finished! self)
    )
  )
