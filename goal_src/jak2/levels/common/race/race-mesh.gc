;;-*-Lisp-*-
(in-package goal)

(defenum race-mesh-flags
  :bitfield #t
  :type uint8
  (racemeshflag-0)
  (racemeshflag-1)
  (racemeshflag-2)
  (racemeshflag-3)
  (racemeshflag-4)
  (racemeshflag-5)
  (racemeshflag-6)
  (racemeshflag-7))

(deftype race-mesh-hash-search (structure)
  ((best-dist              float)
   (debug-cells-searched   int32)
   (debug-slices-searched  int32)
   (bounds                 bounding-box4w  :inline)
   (cell-quads             vector          2 :inline)
   (slice-quads            vector          4 :inline)
   (cell-bits              vector16ub      2 :inline :overlay-at cell-quads)
   (slice-bits             vector16ub      4 :inline :overlay-at slice-quads)))

(deftype race-mesh-slice-query (structure)
  ((slice-id       int16)
   (lap-dist       float)
   (pt-on-slice    vector  :inline)
   (slice-corners  vector  4 :inline)
   (search-sphere  sphere  :inline)))

(deftype race-path-edge-info (structure)
  ((sample-t  float)))

(deftype race-path-sample (structure)
  ((bytes     uint8       32)
   (pos       vector      :inline :overlay-at (-> bytes 0))
   (quat      quaternion  :inline :overlay-at (-> bytes 16))
   (stick-x   int8                :overlay-at (-> bytes 12))
   (stick-y   int8                :overlay-at (-> bytes 13))
   (throttle  uint8               :overlay-at (-> bytes 14))
   (flags     uint8               :overlay-at (-> bytes 15))))

(deftype race-path (structure)
  ((sample-count  uint16)
   (record-id     int8)
   (pad           uint8)
   (samples       (inline-array race-path-sample))
   (edge-infos    (inline-array race-path-edge-info)))
  (:methods
    (draw-path-debug (_type_ rgba rgba) none)
    (race-path-position-at (_type_ vector float float) none)
    (race-path-sample-at (_type_ race-path-sample vector float) none)
    (race-path-project-position (_type_ vector float float) float)))

(deftype race-path-group (structure)
  ((name        string)
   (path-count  int8)
   (pad         uint8  3)
   (paths       (inline-array race-path))))

(deftype race-mesh-edge (structure)
  ((left      vector  :inline)
   (right     vector  :inline)
   (lap-dist  float   :overlay-at (-> left data 3))))

(deftype race-mesh-slice (structure)
  ((edge-index-array  uint16  2)
   (start-edge        int16   :overlay-at (-> edge-index-array 0))
   (end-edge          int16   :overlay-at (-> edge-index-array 1)))
  :pack-me)

(deftype race-mesh-hash-cell (structure)
  ((first-slice  int16)
   (slice-count  uint8)
   (pad          uint8)))

(deftype race-mesh-hash (structure)
  ((cells-wide   int8)
   (cells-tall   int8)
   (cell-length  float)
   (cells        (inline-array race-mesh-hash-cell))
   (slice-table  (inline-array race-mesh-slice))
   (origin       vector  :inline)))

(deftype race-mesh (basic)
  ((version           uint8)
   (path-group-count  uint8)
   (flags             race-mesh-flags)
   (pad               uint8  1)
   (slice-count       int16)
   (edge-count        int16)
   (slices            (inline-array race-mesh-slice))
   (edges             (inline-array race-mesh-edge))
   (hash              race-mesh-hash)
   (path-groups       (inline-array race-path-group)))
  (:methods
    (debug-draw-path (_type_ int int rgba rgba) none)
    (debug-draw-path-from-history (_type_ int int) symbol)
    (debug-draw-slice (_type_ int) none)
    (debug-draw-edges (_type_) none)
    (race-mesh-query (_type_ race-mesh-slice-query) none)
    (race-mesh-calculate-lap-distance (_type_ race-mesh-slice-query) none)
    (race-mesh-closest-point-on-slice (_type_ int race-mesh-slice-query) none)
    (race-mesh-search-nearby (_type_ race-mesh-slice-query) none)
    (race-mesh-search-containing (_type_ race-mesh-slice-query) symbol)
    (race-mesh-search-cell (_type_ race-mesh-hash-search int int race-mesh-slice-query) none)
    (race-mesh-try-slice (_type_ int race-mesh-slice-query) symbol)))

(defmethod race-path-position-at ((this race-path) (out vector) (sample-t float) (unused float))
  (let ((points (new 'stack-no-clear 'inline-array 'vector 4))
        (sample-index (the int sample-t)))
    (set! (-> points 0 quad) (-> this samples sample-index pos quad))
    (set! (-> points 1 quad) (-> this samples (+ sample-index 1) pos quad))
    (let ((fraction (- sample-t (the float sample-index))))
      (vector-lerp! out (-> points 0) (-> points 1) fraction)))
  0
  (none))

(defmethod race-path-sample-at ((this race-path) (out-sample race-path-sample) (out-velocity vector) (sample-t float))
  (let ((samples (new 'stack-no-clear 'inline-array 'race-path-sample 6)))
    (let ((sample-count (the float (-> this sample-count))))
      (if (< sample-count sample-t)
          (set! sample-t (- sample-t sample-count)))
      (if (< sample-t 0.0)
          (set! sample-t (+ sample-t sample-count))))
    (let ((sample-index (the int sample-t)))
      (mem-copy! (the-as pointer (-> samples 0)) (the-as pointer (-> this samples sample-index)) 32)
      (mem-copy! (the-as pointer (-> samples 1)) (the-as pointer (-> this samples (+ sample-index 1))) 32)
      (let ((next-index (+ sample-index 2)))
        (if (< (the-as int (-> this sample-count)) next-index)
            (set! next-index (- next-index (the-as int (-> this sample-count)))))
        (mem-copy! (the-as pointer (-> samples 2)) (the-as pointer (-> this samples next-index)) 32))
      (let ((fraction (- sample-t (the float sample-index))))
        (vector-lerp! (the-as vector (-> out-sample bytes)) (the-as vector (-> samples 0)) (the-as vector (-> samples 1)) fraction)
        (quaternion-slerp! (-> out-sample quat) (-> samples 0 quat) (-> samples 1 quat) fraction)
        (set! (-> out-sample stick-x)
              (the int (+ 0.5 (* (the float (-> samples 1 stick-x)) fraction) (* (the float (-> samples 0 stick-x)) (- 1.0 fraction)))))
        (set! (-> out-sample stick-y) (-> samples 0 stick-y))
        (set! (-> out-sample throttle)
              (the-as
                uint
                (the int
                     (+ 0.5 (* (the float (-> samples 1 throttle)) fraction) (* (the float (-> samples 0 throttle)) (- 1.0 fraction))))))
        (set! (-> out-sample flags) (-> samples 0 flags))
        (vector-! (the-as vector (-> samples 4)) (the-as vector (-> samples 1)) (the-as vector (-> samples 0)))
        (vector-float*! (the-as vector (-> samples 3)) (the-as vector (-> samples 4)) 15.0)
        (vector-! (the-as vector (-> samples 4)) (the-as vector (-> samples 2)) (the-as vector (-> samples 1)))
        (vector-float*! (the-as vector (-> samples 3 quat)) (the-as vector (-> samples 4)) 15.0)
        (vector-lerp! out-velocity (the-as vector (-> samples 3)) (the-as vector (-> samples 3 quat)) fraction))))
  0
  0
  (none))

(defmethod race-path-project-position ((this race-path) (position vector) (start-t float) (end-t float))
  (local-vars (segment-length-sq float))
  (rlet ((acc :class vf)
         (vf0 :class vf)
         (vf1 :class vf)
         (vf2 :class vf))
    (init-vf0-vector)
    (let ((wrapped-end-t end-t)
          (work (new 'stack-no-clear 'matrix))
          (sample-count (the float (-> this sample-count))))
      (if (< sample-count wrapped-end-t)
          (set! wrapped-end-t (- wrapped-end-t sample-count)))
      (if (< start-t 0.0)
          (set! start-t (+ start-t sample-count)))
      (race-path-position-at this (the-as vector (-> work vector)) start-t end-t)
      (race-path-position-at this (-> work vector 1) wrapped-end-t end-t)
      (vector-! (-> work vector 2) (-> work vector 1) (the-as vector (-> work vector)))
      (vector-! (-> work trans) position (the-as vector (-> work vector)))
      (let ((min-alpha 0.0)
            (max-alpha 1.0)
            (projection-dot (vector-dot (-> work vector 2) (-> work trans))))
        (.lvf vf1 (&-> (-> work vector 2) quad))
        (.add.w.vf.x vf2 vf0 vf0)
        (.mul.vf vf1 vf1 vf1)
        (.mul.x.vf.x acc vf2 vf1)
        (.add.mul.y.vf.x acc vf2 vf1 acc)
        (.add.mul.z.vf.x vf1 vf2 vf1 acc)
        (.mov segment-length-sq vf1)
        (let ((alpha (fmax min-alpha (fmin max-alpha (/ projection-dot segment-length-sq)))))
          (if (< wrapped-end-t start-t)
              (set! wrapped-end-t (+ wrapped-end-t sample-count)))
          (let ((projected-t (+ (* start-t (- 1.0 alpha)) (* wrapped-end-t alpha))))
            (if (< sample-count projected-t)
                (set! projected-t (- projected-t sample-count)))
            (if (< projected-t 0.0)
                (+! projected-t sample-count))
            projected-t))))))

(defmethod draw-path-debug ((this race-path) (color-a rgba) (color-b rgba))
  (let ((sample-index 0)
        (next-index 1)
        (last-index (+ (-> this sample-count) -1)))
    (set! (-> (new 'stack-no-clear 'vector) quad) (-> (camera-pos) quad))
    (while (< sample-index (the-as int last-index))
      (let ((sample-a (-> this samples sample-index))
            (sample-b (-> this samples next-index)))
        (add-debug-line
          #t
          (bucket-id debug2)
          (the-as vector (-> sample-a bytes))
          (the-as vector (-> sample-b bytes))
          color-a
          #f
          color-b))
      (set! sample-index next-index)
      (set! next-index (min (+ next-index 1) (the-as int last-index)))))
  0
  (none))

(defmethod debug-draw-path ((this race-mesh) (path-index int) (group-index int) (color-a rgba) (color-b rgba))
  (when (< group-index (the-as int (-> this path-group-count)))
    (let ((group (-> this path-groups group-index)))
      (if (< path-index (-> group path-count))
          (draw-path-debug (-> group paths path-index) color-a color-b))))
  (none))

(defmethod debug-draw-path-from-history ((this race-mesh) (record-id int) (group-index int))
  (when (< group-index (the-as int (-> this path-group-count)))
    (let ((group (-> this path-groups group-index)))
      (countdown (path-index (-> group path-count))
        (let ((path (-> group paths path-index)))
          (when (= (-> path record-id) record-id)
            (let ((colors (new 'static 'array rgba 16
                          (new 'static 'rgba :r #x40 :a #x80)
                          (new 'static 'rgba :r #xff :g #x30 :b #x30 :a #x80)
                          (new 'static 'rgba :g #xff :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :b #xff :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :r #x60 :g #x60 :b #x60 :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :a #x80)
                          (new 'static 'rgba :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :r #xff :b #xff :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :r #xff :g #x80 :b #x40 :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
                          (new 'static 'rgba :a #x80)
                          (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)))
                  (color-index (* record-id 2)))
              (draw-path-debug path (-> colors color-index) (-> colors (+ color-index 1))))
            (return #f)))))
    #f))

(defmethod debug-draw-slice ((this race-mesh) (slice-id int))
  (let* ((slice (-> this slices slice-id))
         (start-edge (-> this edges (-> slice start-edge)))
         (end-edge (-> this edges (-> slice end-edge))))
    (add-debug-line
      #t
      (bucket-id debug-no-zbuf1)
      (-> start-edge left)
      (-> start-edge right)
      (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
      #f
      (the-as rgba -1))
    (add-debug-line
      #t
      (bucket-id debug-no-zbuf1)
      (-> start-edge right)
      (-> end-edge right)
      (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
      #f
      (the-as rgba -1))
    (add-debug-line
      #t
      (bucket-id debug-no-zbuf1)
      (-> end-edge right)
      (-> end-edge left)
      (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
      #f
      (the-as rgba -1))
    (add-debug-line
      #t
      (bucket-id debug-no-zbuf1)
      (-> end-edge left)
      (-> start-edge left)
      (new 'static 'rgba :r #xff :g #xff :b #xff :a #x80)
      #f
      (the-as rgba -1))
    (let ((center (new 'stack-no-clear 'vector)))
      (vector+! center (-> start-edge left) (-> start-edge right))
      (vector+! center center (-> end-edge left))
      (vector+! center center (-> end-edge right))
      (vector-float*! center center 0.25)
      (let ((draw-text add-debug-text-3d)
            (enabled #t)
            (bucket 318))
        (format (clear *temp-string*) "~D" slice-id)
        (draw-text enabled (the-as bucket-id bucket) *temp-string* center (font-color white) (the-as vector2h #f)))))
  (none))

(defmethod debug-draw-edges ((this race-mesh))
  (let ((idx 0)
        (last-slice-index (+ (-> this slice-count) -1)))
    (while (>= last-slice-index idx)
      (let* ((slice (-> this slices idx))
             (start-edge (-> this edges (-> slice start-edge)))
             (end-edge (-> this edges (-> slice end-edge))))
        (add-debug-line #t (bucket-id debug-no-zbuf1) (-> start-edge left) (-> end-edge left) *color-white* #f (the-as rgba -1))
        (add-debug-line
          #t
          (bucket-id debug-no-zbuf1)
          (-> start-edge right)
          (-> end-edge right)
          *color-white*
          #f
          (the-as rgba -1))
        (add-debug-line #t (bucket-id debug-no-zbuf1) (-> end-edge left) (-> end-edge right) *color-gray* #f (the-as rgba -1)))
      (+! idx 1)))
  (let ((first-edge (-> this edges 0)))
    (add-debug-line
      #t
      (bucket-id debug-no-zbuf1)
      (-> first-edge left)
      (-> first-edge right)
      *color-green*
      #f
      (the-as rgba -1)))
  (let ((last-edge-index (+ (-> this edge-count) -1)))
    (let ((last-edge (-> this edges last-edge-index)))
      (add-debug-line
        #t
        (bucket-id debug-no-zbuf1)
        (-> last-edge left)
        (-> last-edge right)
        *color-red*
        #f
        (the-as rgba -1)))
    (format *stdcon* "edge-count ~d last-edge ~d~%" (-> this edge-count) last-edge-index))
  0
  (none))

(defmethod race-mesh-try-slice ((this race-mesh) (slice-id int) (query race-mesh-slice-query))
  (set! (-> query slice-id) -1)
  (let* ((slice (-> this slices slice-id))
         (start-edge (-> this edges (-> slice start-edge)))
         (end-edge (-> this edges (-> slice end-edge))))
    (set! (-> query slice-corners 0 quad) (-> start-edge left quad))
    (set! (-> query slice-corners 1 quad) (-> start-edge right quad))
    (set! (-> query slice-corners 2 quad) (-> end-edge right quad))
    (set! (-> query slice-corners 3 quad) (-> end-edge left quad)))
  (let ((point-offset (new 'stack-no-clear 'vector))
        (edge-direction (new 'stack-no-clear 'vector)))
    (countdown (corner-index 4)
      (vector-! edge-direction (-> query slice-corners (logand (+ corner-index 1) 3)) (-> query slice-corners corner-index))
      (vector-! point-offset (the-as vector (-> query search-sphere)) (-> query slice-corners corner-index))
      (if (< (- (* (-> edge-direction z) (-> point-offset x)) (* (-> edge-direction x) (-> point-offset z))) 0.0)
          (return #f))))
  (let ((diagonal (new 'stack-no-clear 'vector))
        (diagonal-offset (new 'stack-no-clear 'vector)))
    (vector-! diagonal (-> query slice-corners 2) (the-as vector (-> query slice-corners)))
    (vector-! diagonal-offset (the-as vector (-> query search-sphere)) (the-as vector (-> query slice-corners)))
    (let ((diagonal-side (- (* (-> diagonal z) (-> diagonal-offset x)) (* (-> diagonal x) (-> diagonal-offset z))))
          (plane-edge (new 'stack-no-clear 'vector))
          (plane-normal (new 'stack-no-clear 'vector)))
      (cond
        ((< diagonal-side 0.0)
         (vector-! plane-edge (-> query slice-corners 1) (the-as vector (-> query slice-corners)))
         (vector-cross! plane-normal plane-edge diagonal))
        (else
          (vector-! plane-edge (-> query slice-corners 3) (the-as vector (-> query slice-corners)))
          (vector-cross! plane-normal diagonal plane-edge)))
      (vector-normalize! plane-normal 1.0)
      (set-vector! plane-edge 0.0 -1.0 0.0 1.0)
      (let ((vertical-hit-t (intersect-ray-plane (-> query search-sphere) plane-edge (the-as vector (-> query slice-corners)) plane-normal)))
        (vector+float*! (-> query pt-on-slice) (the-as vector (-> query search-sphere)) plane-edge vertical-hit-t))))
  (if (< (- (-> query search-sphere y) (-> query pt-on-slice y)) -8192.0)
      (return #f))
  (set! (-> query slice-id) slice-id)
  #t)

(defmethod race-mesh-search-containing ((this race-mesh) (query race-mesh-slice-query))
  (set! (-> query slice-id) -1)
  (let* ((race-hash (-> this hash))
         (cell-x
           (max
             0
             (min
               (the int (/ (- (-> query search-sphere x) (-> race-hash origin x)) (-> race-hash cell-length)))
               (+ (-> race-hash cells-wide) -1))))
         (cell-z
           (max
             0
             (min
               (the int (/ (- (-> query search-sphere z) (-> race-hash origin z)) (-> race-hash cell-length)))
               (+ (-> race-hash cells-tall) -1))))
         (cell-ptr
           (the-as object (+ (the-as uint (-> race-hash cells)) (* (+ (* cell-z (-> race-hash cells-wide)) cell-x) 4))))
         (slice-count (-> (the-as race-mesh-hash-cell cell-ptr) slice-count)))
    (when (nonzero? slice-count)
      (let ((candidate (new 'stack-no-clear 'race-mesh-slice-query)))
        (mem-copy! (the-as pointer candidate) (the-as pointer query) 112)
        (while (nonzero? slice-count)
          (+! slice-count -1)
          (let ((slice-id (-> (&-> (-> race-hash slice-table) 0 edge-index-array (+ (-> (the-as (pointer int16) cell-ptr)) slice-count)) 0)))
            (when (race-mesh-try-slice this (the-as int slice-id) candidate)
              (if (or (= (-> query slice-id) -1)
                      (< (vector-vector-distance-squared (-> candidate pt-on-slice) (-> query search-sphere))
                         (vector-vector-distance-squared (-> query pt-on-slice) (-> query search-sphere))))
                  (mem-copy! (the-as pointer query) (the-as pointer candidate) 112))))))
      #f)))

(defmethod race-mesh-closest-point-on-slice ((this race-mesh) (slice-id int) (query race-mesh-slice-query))
  (local-vars (inside-slice symbol))
  (set! (-> query slice-id) slice-id)
  (let* ((slice (-> this slices slice-id))
         (start-edge (-> this edges (-> slice start-edge)))
         (end-edge (-> this edges (-> slice end-edge))))
    (set! (-> query slice-corners 0 quad) (-> start-edge left quad))
    (set! (-> query slice-corners 1 quad) (-> start-edge right quad))
    (set! (-> query slice-corners 2 quad) (-> end-edge right quad))
    (set! (-> query slice-corners 3 quad) (-> end-edge left quad)))
  (let ((point-offset (new 'stack-no-clear 'vector))
        (edge-direction (new 'stack-no-clear 'vector)))
    (countdown (corner-index 4)
      (vector-! edge-direction (-> query slice-corners (logand (+ corner-index 1) 3)) (-> query slice-corners corner-index))
      (vector-! point-offset (the-as vector (-> query search-sphere)) (-> query slice-corners corner-index))
      (when (< (- (* (-> edge-direction z) (-> point-offset x)) (* (-> edge-direction x) (-> point-offset z))) 0.0)
        (set! inside-slice #f)
        (goto cfg-6))))
  (set! inside-slice #t)
  (label cfg-6)
  (cond
    (inside-slice
      (let ((diagonal (new 'stack-no-clear 'vector))
            (diagonal-offset (new 'stack-no-clear 'vector)))
        (vector-! diagonal (-> query slice-corners 2) (the-as vector (-> query slice-corners)))
        (vector-! diagonal-offset (the-as vector (-> query search-sphere)) (the-as vector (-> query slice-corners)))
        (let ((diagonal-side (- (* (-> diagonal z) (-> diagonal-offset x)) (* (-> diagonal x) (-> diagonal-offset z))))
              (plane-edge (new 'stack-no-clear 'vector))
              (plane-normal (new 'stack-no-clear 'vector)))
          (cond
            ((< diagonal-side 0.0)
             (vector-! plane-edge (-> query slice-corners 1) (the-as vector (-> query slice-corners)))
             (vector-cross! plane-normal plane-edge diagonal))
            (else
              (vector-! plane-edge (-> query slice-corners 3) (the-as vector (-> query slice-corners)))
              (vector-cross! plane-normal diagonal plane-edge)))
          (vector-normalize! plane-normal 1.0)
          (set-vector! plane-edge 0.0 -1.0 0.0 1.0)
          (let ((vertical-hit-t
                  (intersect-ray-plane (-> query search-sphere) plane-edge (the-as vector (-> query slice-corners)) plane-normal)))
            (vector+float*! (-> query pt-on-slice) (the-as vector (-> query search-sphere)) plane-edge vertical-hit-t)))))
    (else
      (let ((closest-point (new 'stack-no-clear 'vector))
            (best-distance -1.0))
        (countdown (corner-index 4)
          (let ((edge-distance (vector-segment-distance-point!
                         (-> query search-sphere)
                         (-> query slice-corners corner-index)
                         (-> query slice-corners (logand (+ corner-index 1) 3))
                         closest-point)))
            (when (or (< best-distance 0.0) (< edge-distance best-distance))
              (set! best-distance edge-distance)
              (set! (-> query pt-on-slice quad) (-> closest-point quad))))))))
  (none))

(defmethod race-mesh-search-cell ((this race-mesh) (search race-mesh-hash-search) (cell-x int) (cell-z int) (query race-mesh-slice-query))
  (let* ((cell-index (+ (* cell-z (-> this hash cells-wide)) cell-x))
         (cell-byte-index (/ cell-index 8))
         (cell-bit (ash 1 (logand cell-index 7)))
         (visited-cell-byte (-> (the-as race-mesh-hash-search (+ cell-byte-index (the-as int search))) cell-bits 0 data 0)))
    (when (not (logtest? visited-cell-byte cell-bit))
      (set! (-> search cell-bits 0 data cell-byte-index) (logior visited-cell-byte cell-bit))
      (let* ((cell-ptr (the-as object (+ (the-as uint (-> this hash cells)) (* cell-index 4))))
             (slice-index-ptr (&-> (-> this hash slice-table) 0 edge-index-array (-> (the-as (pointer int16) cell-ptr))))
             (slice-count (-> (the-as race-mesh-hash-cell cell-ptr) slice-count)))
        (when (nonzero? slice-count)
          (let ((candidate (new 'stack-no-clear 'race-mesh-slice-query)))
            (mem-copy! (the-as pointer candidate) (the-as pointer query) 112)
            (while (nonzero? slice-count)
              (+! slice-count -1)
              (let* ((slice-id (-> slice-index-ptr 0))
                     (slice-byte-index (shr slice-id 3))
                     (slice-bit (ash 1 (logand slice-id 7)))
                     (visited-slice-byte (-> search slice-bits 0 data slice-byte-index)))
                (when (not (logtest? visited-slice-byte slice-bit))
                  (set! (-> search slice-bits 0 data slice-byte-index) (logior visited-slice-byte slice-bit))
                  (race-mesh-closest-point-on-slice this (the-as int slice-id) candidate)
                  (let ((distance-sq (vector-vector-distance-squared (-> candidate pt-on-slice) (-> query search-sphere))))
                    (when (or (= (-> query slice-id) -1) (< distance-sq (-> search best-dist)))
                      (set! (-> search best-dist) distance-sq)
                      (mem-copy! (the-as pointer query) (the-as pointer candidate) 112)))))
              (set! slice-index-ptr (&-> slice-index-ptr 1))))))))
  (none))

(defmethod race-mesh-search-nearby ((this race-mesh) (query race-mesh-slice-query))
  (set! (-> query slice-id) -1)
  (let ((race-hash (-> this hash))
        (search (new 'stack-no-clear 'race-mesh-hash-search)))
    (let ((slice-bit-chunks (/ (+ (-> this slice-count) 127) 128)))
      (when (< 4 slice-bit-chunks)
        (break!)
        0)
      (while (nonzero? slice-bit-chunks)
        (+! slice-bit-chunks -1)
        (set! (-> search slice-bits slice-bit-chunks quad) (the-as uint128 0))))
    (set! (-> search cell-bits 0 quad) (the-as uint128 0))
    (set! (-> search cell-bits 1 quad) (the-as uint128 0))
    (let ((inv-cell-length (/ 1.0 (-> race-hash cell-length)))
          (search-half-width (fmin (-> query search-sphere r) (/ (-> race-hash cell-length) 2))))
      (let ((search-min-x (- (-> query search-sphere x) search-half-width))
            (search-min-z (- (-> query search-sphere z) search-half-width)))
        (set! (-> search bounds min x)
              (max 0 (min (the int (* (- search-min-x (-> race-hash origin x)) inv-cell-length)) (+ (-> race-hash cells-wide) -1))))
        (set! (-> search bounds min z)
              (max 0 (min (the int (* (- search-min-z (-> race-hash origin z)) inv-cell-length)) (+ (-> race-hash cells-tall) -1)))))
      (let ((search-max-x (+ (-> query search-sphere x) search-half-width))
            (search-max-z (+ (-> query search-sphere z) search-half-width)))
        (set! (-> search bounds max x)
              (max 0 (min (the int (* (- search-max-x (-> race-hash origin x)) inv-cell-length)) (+ (-> race-hash cells-wide) -1))))
        (set! (-> search bounds max z)
              (max 0 (min (the int (* (- search-max-z (-> race-hash origin z)) inv-cell-length)) (+ (-> race-hash cells-tall) -1))))))
    (let ((cell-z (-> search bounds min z)))
      (until (< (-> search bounds max z) cell-z)
        (let ((cell-x (-> search bounds min x)))
          (until (< (-> search bounds max x) cell-x)
            (race-mesh-search-cell this search cell-x cell-z query)
            (+! cell-x 1)))
        (+! cell-z 1)))
    (when (and (= (-> query slice-id) -1) (< (/ (-> race-hash cell-length) 2) (-> query search-sphere r)))
      (while (= (-> query slice-id) -1)
        (set! (-> search bounds min x) (max 0 (+ (-> search bounds min x) -1)))
        (set! (-> search bounds min z) (max 0 (+ (-> search bounds min z) -1)))
        (set! (-> search bounds max x) (min (+ (-> search bounds max x) 1) (+ (-> race-hash cells-wide) -1)))
        (set! (-> search bounds max z) (min (+ (-> search bounds max z) 1) (+ (-> race-hash cells-tall) -1)))
        (let ((border-x (-> search bounds min x)))
          (until (< (-> search bounds max x) border-x)
            (race-mesh-search-cell this search border-x (-> search bounds min z) query)
            (race-mesh-search-cell this search border-x (-> search bounds max z) query)
            (+! border-x 1)))
        (let ((border-z (-> search bounds min z)))
          (until (< (-> search bounds max z) border-z)
            (race-mesh-search-cell this search (-> search bounds min x) border-z query)
            (race-mesh-search-cell this search (-> search bounds max x) border-z query)
            (+! border-z 1))))))
  0
  (none))

(defmethod race-mesh-calculate-lap-distance ((this race-mesh) (query race-mesh-slice-query))
  (let* ((start-side-distance
           (vector-line-distance-point! (-> query pt-on-slice) (the-as vector (-> query slice-corners))
                                        (-> query slice-corners 1) (the-as vector #f)))
         (end-side-distance
           (vector-line-distance-point! (-> query pt-on-slice) (-> query slice-corners 2)
                                        (-> query slice-corners 3) (the-as vector #f)))
         (total-width (+ start-side-distance end-side-distance))
         (slice (-> this slices (-> query slice-id)))
         (start-lap-distance (-> this edges (-> slice start-edge) left w))
         (end-lap-distance (-> this edges (-> slice end-edge) left w)))
    (set! (-> query lap-dist)
          (+ (* (/ end-side-distance total-width) start-lap-distance)
             (* (/ start-side-distance total-width) end-lap-distance))))
  (none))

(defmethod race-mesh-query ((this race-mesh) (query race-mesh-slice-query))
  (race-mesh-search-containing this query)
  (if (and (= (-> query slice-id) -1) (< 0.0 (-> query search-sphere r)))
      (race-mesh-search-nearby this query))
  (when (!= (-> query slice-id) -1)
    (race-mesh-calculate-lap-distance this query)
    0)
  (none))
