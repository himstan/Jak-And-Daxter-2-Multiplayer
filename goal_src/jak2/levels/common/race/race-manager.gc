;;-*-Lisp-*-
(in-package goal)

(define-extern race-start (function int process symbol race-manager))
(define-extern race-start-from-info (function race-info process symbol race-manager))
(define-extern race-start-by-task-node (function game-task-node process symbol race-manager))
(define-extern race-manager-reconcile-racers! (function race-manager none))
(define-extern race-manager-update-spectate! (function none))
(define-extern race-vehicle-entity-hack (function none))
(define-extern start-pilot-recorder (function none))
(declare-type race-bike-a vehicle-city-racer)
(declare-type race-bike-b vehicle-city-racer)
(declare-type race-bike-c vehicle-city-racer)
(declare-type race-bike-d vehicle-race-bike)
(declare-type race-bike-e vehicle-race-bike)
(declare-type bikea bike-base)

(defun race-find-ground ((result vector) (position vector))
  "Find the ground below a position and write the hit point to result."
  (let ((query (new 'stack-no-clear 'collide-query)))
    (set! (-> query start-pos quad) (-> position quad))
    (vector-reset! (-> query move-dist))
    (set! (-> query move-dist y) -81920.0)
    (set! (-> query radius) 2048.0)
    (set! (-> query collide-with) (collide-spec backgnd))
    (set! (-> query ignore-process0) #f)
    (set! (-> query ignore-process1) #f)
    (set! (-> query ignore-pat) (new 'static 'pat-surface :noentity #x1 :nojak #x1 :probe #x1 :noendlessfall #x1))
    (set! (-> query action-mask) (collide-action solid))
    (let ((hit-t (fill-and-probe-using-line-sphere *collide-cache* query)))
      (when (>= hit-t 0.0)
        (vector+float*! result (-> query start-pos) (-> query move-dist) hit-t)
        #t)))
  )

(defmethod initialize-mesh ((this race-info))
  (let ((mesh-entity (entity-by-name (-> this race-mesh-name))))
    (cond
      (mesh-entity
        (let ((mesh (-> (the-as entity-race-mesh mesh-entity) race-mesh)))
          (set! (-> this mesh) mesh)
          (when mesh
            (let ((start-edge (-> mesh edges 0)))
              (vector-average! (-> this start-sphere) (-> start-edge left) (-> start-edge right))
              (+! (-> this start-sphere y) 40960.0)
              (race-find-ground (-> this start-sphere) (-> this start-sphere))
              (+! (-> this start-sphere y) 8192.0)
              (set! (-> this start-sphere r) (* 0.5 (vector-vector-distance (-> start-edge left) (-> start-edge right))))
              (let ((start-direction (new 'stack-no-clear 'vector)))
                (vector-! start-direction (-> start-edge right) (-> start-edge left))
                (set-vector! (-> this start-dir) (-> start-direction z) 0.0 (- (-> start-direction x)) 1.0)
                )
              )
            (vector-normalize! (-> this start-dir) 1.0)
            (let* ((last-edge-index (+ (-> mesh edge-count) -1))
                   (finish-edge (-> mesh edges last-edge-index))
                   )
              (vector-average! (-> this finish-sphere) (-> finish-edge left) (-> finish-edge right))
              (set! (-> this finish-sphere r) (* 0.75 (vector-vector-distance (-> finish-edge left) (-> finish-edge right))))
              (let ((finish-direction (new 'stack-no-clear 'vector)))
                (vector-! finish-direction (-> finish-edge right) (-> finish-edge left))
                (set-vector! (-> this finish-dir) (-> finish-direction z) 0.0 (- (-> finish-direction x)) 1.0)
                )
              )
            (vector-normalize! (-> this finish-dir) 1.0)
            (if (< (vector-vector-distance-squared (-> this start-sphere) (-> this finish-sphere)) (square 163840.0))
                (logior! (-> mesh flags) (race-mesh-flags closed-loop))
                )
            )
          )
        )
      (else
        (set! (-> this mesh) #f)
        )
      )
    )
  (none)
  )

(defmethod begin-lap ((this racer-state) (state race-state))
  (debug-log *mp-debug-log?* "[Race] begin-lap racer ~d~%" (-> this rank))
  (set! (-> this lap-start) (-> state current-time))
  (logior! (-> this flags) (racer-flags in-race))
  (none)
  )

(defun race-racer-run-local-lap-effects? ((state race-state) (racer racer-state))
  (when (not (mp-race-sync-active?))
    (return #t))
  (when (or (not state)
            (zero? state)
            (not racer)
            (zero? racer))
    (return #f))
  (let* ((racer-index (mp-race-racer-index state racer))
         (player-id (mp-race-bound-player-id racer-index)))
    (or (mp-race-racer-local-player? racer)
        (and (mp-session-host?)
             (= player-id (the-as uint MP_RACE_INVALID_INDEX))))))

(defun race-racer-speech-ready? ((racer process))
  (and racer
       (nonzero? racer)
       (type? racer process-drawable)
       *speech-control*
       (nonzero? *speech-control*)
       (or (not (mp-race-sync-active?))
           (mp-race-world-ready?))))

(defun race-racer-play-finish-speech! ((this racer-state) (racer process))
  (when (and this
             (nonzero? this)
             (race-racer-speech-ready? racer))
    (cond
      ((zero? (-> this finish-count))
       (case (-> this rider)
         ((0)
          (format #t "racer-state::end-lap: play speech race-jak-win~%")
          (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-38)))
         ((1)
          (format #t "racer-state::end-lap: play speech race-daxter-win~%")
          (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-47)))
         ((2)
          (format #t "racer-state::end-lap: play speech race-errol-win~%")
          (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-55)))))
      ((= (-> this rider) 2)
       (format #t "racer-state::end-lap: play speech race-errol-lose~%")
       (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-56)))))
  (none))

(defun race-racer-play-last-lap-speech! ((this racer-state) (racer process))
  (when (and this
             (nonzero? this)
             (race-racer-speech-ready? racer))
    (case (-> this rider)
      ((0)
       (format #t "racer-state::end-lap: play speech race-jak-last-lap~%")
       (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-32)))
      ((1)
       (format #t "racer-state::end-lap: play speech race-daxter-last-lap~%")
       (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-41)))
      ((2)
       (format #t "racer-state::end-lap: play speech race-errol-last-lap~%")
       (speech-control-method-12 *speech-control* (the-as process-drawable racer) (speech-type speech-type-49)))))
  (none))

(defun race-racer-run-finish-effects! ((this racer-state) (state race-state))
  (when (and this
             (nonzero? this)
             state
             (nonzero? state))
    (let ((racer (handle->process-safe (-> this racer)))
          (info (-> state info)))
      (when (and racer
                 (nonzero? racer)
                 info
                 (nonzero? info))
        (send-event racer 'race-finished (-> info safe-paths))
        (race-racer-play-finish-speech! this racer))))
  (none))

(defun mp-race-commit-lap-core! ((this racer-state) (state race-state))
  (when (and this
             (nonzero? this)
             state
             (nonzero? state))
    (let ((info (-> state info)))
      (when (and info (nonzero? info))
        (+! (-> this lap-count) 1)
        (debug-log *mp-debug-log?* "[Race] end-lap ~d racer ~d~%" (-> this lap-count) (-> this rank))
        (let ((dst-index 4)
              (src-index 3))
          (while (>= src-index 0)
            (set! (-> this lap-time-array dst-index) (-> this lap-time-array src-index))
            (+! src-index -1)
            (+! dst-index -1)))
        (let ((lap-time (- (-> state current-time) (-> this lap-start))))
          (set! (-> this best-lap-time)
                (the-as uint
                  (min (the-as int (-> this best-lap-time))
                       (the-as int lap-time))))
          (set! (-> this lap-time-array 0) (the-as float lap-time)))
        (when (= (-> this lap-count) (-> info lap-count))
          (logior! (-> this flags) (racer-flags finished))
          (set! (-> this finish-time) (-> state current-time))
          (set! (-> this finish-count) (-> state finished-count))
          (+! (-> state finished-count) 1)
          (when (race-racer-run-local-lap-effects? state this)
            (race-racer-run-finish-effects! this state)))
        (when (and (> (-> this lap-count) 0)
                   (= (-> this lap-count) (+ (-> info lap-count) -1))
                   (race-racer-run-local-lap-effects? state this))
          (let ((racer (handle->process-safe (-> this racer))))
            (when (and racer (nonzero? racer))
              (race-racer-play-last-lap-speech! this racer)))))))
  (none)
  )

(defun mp-race-commit-lap! ((state race-state) (racer-index int))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (mp-race-commit-lap-core!
      (-> state racer-array racer-index)
      state))
  (none))

(defun mp-race-recount-finished! ((state race-state))
  (when (and state (nonzero? state))
    (let ((finished-count 0))
      (dotimes (racer-index (-> state racer-count))
        (let ((racer (-> state racer-array racer-index)))
          (when (logtest? (-> racer flags) (racer-flags finished))
            (set! finished-count
                  (max finished-count
                       (+ (the-as int (-> racer finish-count)) 1))))))
      (set! (-> state finished-count) finished-count)))
  (none))

(defun mp-race-reconcile-progress! ((state race-state)
                                    (racer-index int)
                                    (lap-count int)
                                    (finish-count int)
                                    (finish-time time-frame))
  (when (and state
             (nonzero? state)
             (>= racer-index 0)
             (< racer-index (-> state racer-count)))
    (let ((racer (-> state racer-array racer-index)))
      (when (> (-> racer lap-count) lap-count)
        (set! (-> racer lap-count) (the-as int8 lap-count))
        (logclear! (-> racer flags) (racer-flags finished))
        (set! (-> racer finish-count) -1)
        (set! (-> racer finish-time) (the-as uint 0))
        (mp-race-recount-finished! state))
      (while (< (-> racer lap-count) lap-count)
        (mp-race-commit-lap-core! racer state))
      (when (= lap-count (-> state info lap-count))
        (logior! (-> racer flags) (racer-flags finished))
        (set! (-> racer finish-count) (the-as int8 finish-count))
        (set! (-> racer finish-time) (the-as uint finish-time))
        (set! (-> state finished-count)
              (max (-> state finished-count) (+ finish-count 1))))))
  (none))

(defmethod end-lap ((this racer-state) (state race-state))
  (cond
    ((not (mp-race-sync-active?))
     (mp-race-commit-lap-core! this state))
    ((mp-race-host-may-commit-lap? state this)
     (let ((racer-index (mp-race-racer-index state this)))
       (mp-race-commit-lap-core! this state)
       (mp-race-host-publish-progress! state racer-index)))
    ((mp-race-client-may-commit-lap? state this)
     (let ((racer-index (mp-race-racer-index state this)))
       (mp-race-commit-lap-core! this state)
       (mp-race-client-request-progress! state racer-index))))
  (none))

(defmethod update-lap-distance ((this racer-state) (state race-state))
  (let ((racer (handle->process (-> this racer))))
    (cond
      (racer
       (when (focus-test? (the-as process-focusable racer) dead inactive)
         (logior! (-> this flags) (racer-flags dead)))

       (set! (-> this position quad) (-> (the-as process-focusable racer) root trans quad))

       (cond
         ((logtest? (-> state info flags) (race-info-flags destination-race))
          (when (and (logtest? (-> state flags) (race-flags begun))
                     (not (logtest? (-> this flags) (racer-flags finished dead))))
            (when (not (logtest? (-> this flags) (racer-flags in-race)))
              (begin-lap this state))

            (let ((finish-distance-squared
                    (vector-vector-distance-squared
                      (-> this position)
                      (the-as vector (-> state info finish-sphere)))))
              ;; Rankings sort larger progress first, so negated distance makes
              ;; the closest unfinished destination racer lead in real time.
              (set! (-> this lap-distance) (- 0.0 finish-distance-squared))
              (when (< finish-distance-squared
                       (square (-> state info finish-sphere r)))
                (end-lap this state)))))

         (else
          (when (not (logtest? (-> this flags) (racer-flags finished dead)))
            (let ((slice (new 'stack-no-clear 'race-mesh-slice-query)))
              (set! (-> slice search-sphere quad) (-> this position quad))
              (set! (-> slice search-sphere r) 0.0)
              (race-mesh-query (-> state info mesh) (the-as race-mesh-slice-query (&-> slice slice-id)))
              (set! (-> this lap-distance-prev) (-> this lap-distance))

              (cond
                ((>= (-> slice slice-id) 0)
                 (set! (-> this lap-distance) (-> slice lap-dist))
                 (when (not (logtest? (-> this flags) (racer-flags on-track)))
                   (set! (-> this lap-distance-prev) (-> this lap-distance)))
                 (logior! (-> this flags) (racer-flags on-track)))
                (else
                 (logclear! (-> this flags) (racer-flags on-track))))

              (cond
                ((logtest? (-> state info mesh flags) (race-mesh-flags closed-loop))
                 (when (>= (-> slice slice-id) 0)
                   (let ((quadrant (min 3 (the int (* 4.0 (-> slice lap-dist))))))
                     (when (= quadrant (logand (+ (-> this lap-quadrant) 1) 3))
                       (set! (-> this lap-quadrant) quadrant)
                       (when (zero? quadrant)
                         (if (logtest? (-> this flags) (racer-flags in-race))
                             (end-lap this state)
                             (begin-race state))
                         (begin-lap this state))))))

                ((logtest? (-> this flags) (racer-flags in-race))
                 (let ((finish-offset (new 'stack-no-clear 'vector)))
                   (vector-! finish-offset (-> this position) (the-as vector (-> state info finish-sphere)))
                   (when (and (< (vector-vector-distance-squared
                                   (-> this position)
                                   (the-as vector (-> state info finish-sphere)))
                                 (square (-> state info finish-sphere r)))
                              (> (vector-dot finish-offset (-> state info finish-dir)) 0.0))
                     (end-lap this state))))

                (else
                 (when (> (-> this lap-distance) 0.0)
                   (begin-race state)
                   (begin-lap this state)))))

            (let ((target-speed (-> state info ai-max-speed-factor)))
              (when (< (+ (-> state target-pos) (-> this target-pos-offset)) (-> this pos))
                (set! target-speed (-> state info ai-min-speed-factor)))
              (seek! (-> this speed-factor) target-speed (* 0.2 (seconds-per-frame)))))))

       (when (logtest? (-> this flags) (racer-flags finished))
         (seek! (-> this speed-factor) 0.9 (* 0.2 (seconds-per-frame))))

       (when (logtest? (-> this flags) (racer-flags in-race))
         (dotimes (i (-> state info decision-point-count))
           (let ((decision-point (-> state info decision-point-array i)))
             (when (and (< (-> this lap-distance-prev) (-> decision-point pos))
                        (>= (-> this lap-distance) (-> decision-point pos)))
               (send-event racer 'race-decision-point decision-point))))
         (set! (-> this pos) (+ (-> this lap-distance) (the float (-> this lap-count))))))

      (else
       (logior! (-> this flags) (racer-flags dead)))))

  (none))

(defmethod print-laps ((this racer-state) (state race-state) (stream string))
  (let ((current-lap-time (- (-> state current-time) (-> this lap-start))))
    (format stream "lap count ~d~%" (-> this lap-count))
    (format stream "best lap ")
    (print-time stream (the-as time-frame (-> this best-lap-time)))
    (format stream "~%~%")
    (when (logtest? (-> this flags) (racer-flags in-race))
      (format stream "this lap ")
      (print-time stream (the-as time-frame current-lap-time))
      )
    )
  (format stream "~%")
  (let ((lap-count (min 5 (-> this lap-count))))
    (dotimes (lap-index lap-count)
      (format stream "lap ~d " lap-index)
      (print-time stream (the-as time-frame (-> this lap-time-array lap-index)))
      (format stream "~%")
      )
    )
  (none)
  )

(defmethod init-racer! ((this racer-state) (vehicle process-drawable))
  (set! (-> this racer) (process->handle vehicle))
  (set! (-> this position quad) (-> vehicle root trans quad))
  (set! (-> this flags) (racer-flags unknown))
  (set! (-> this lap-count) 0)
  (set! (-> this lap-distance) 0.0)
  (set! (-> this lap-quadrant) 3)
  (set! (-> this finish-time) (the-as uint 0))
  (set! (-> this pos) 0.0)
  (set! (-> this target-pos-offset) 0.0)
  (set! (-> this speed-factor) 1.0)
  (set! (-> this finish-count) -1)
  (set! (-> this best-lap-time) (the-as uint #x2dc6c0))
  (none)
  )

(defmethod init-racers! ((this race-state) (racer process-drawable))
  (let ((racer-index (-> this racer-count)))
    (when (< racer-index 10)
      (+! (-> this racer-count) 1)
      (init-racer! (-> this racer-array racer-index) racer)
      )
    )
  (none)
  )

(defmethod begin-race ((this race-state))
  (debug-log *mp-debug-log?* "[Race] Begin-race~%")
  (when (not (logtest? (-> this flags) (race-flags begun)))
    (logior! (-> this flags) (race-flags begun))
    (set-speech-tables! this)
    (send-event (handle->process (-> this manager)) 'begin-race)
    (set-setting! 'sound-mode #f 0.0 0)
    (remove-setting! 'allow-progress)
    (set! (-> this race-start-time) (-> this current-time))
    (let ((manager (handle->process (-> this manager))))
      (set! (-> this hud-timer) (ppointer->handle (process-spawn hud-race-timer :init hud-init-by-other :to manager)))
      (set! (-> this hud-position)
            (ppointer->handle (process-spawn hud-race-position :init hud-init-by-other :to manager))
            )
      (if (< 1 (-> this info lap-count))
          (set! (-> this hud-lap-counter)
                (ppointer->handle (process-spawn hud-race-lap-counter :init hud-init-by-other :to manager))
                )
          )
      (when (logtest? (-> this info flags) (race-info-flags borrow))
        (set! (-> this hud-turbo-counter)
              (ppointer->handle (process-spawn hud-race-turbo-counter :init hud-init-by-other :to manager))
              )
        (set-setting! 'race-minimap #f 0.0 (-> this info map-index))
        )
      )
    (dotimes (racer-index (-> this racer-count))
      (when (not (mp-race-racer-retired? racer-index))
        (let* ((racer (-> this racer-array racer-index))
               (vehicle (handle->process-safe (-> racer racer))))
          (when (and vehicle (nonzero? vehicle))
            (send-event vehicle 'begin-race))))
      )
    (send-event (handle->process (-> this race-signal)) 'count-go)
    (when (nonzero? (-> this info go-speech))
      (format #t "playing speech ~d~%" (-> this info go-speech))
      (talker-spawn-func
        (-> *talker-speech* (-> this info go-speech))
        *entity-pool*
        (target-pos 0)
        (the-as region #f)
        )
      )
    )
  (none)
  )

(defmethod update-rankings ((this race-state))
  (let ((progress (new 'stack-no-clear 'array 'float 10)))
    (dotimes (racer-index (-> this racer-count))
      (let ((racer (-> this racer-array racer-index)))
        (cond
          ((logtest? (-> racer flags) (racer-flags finished))
           (set! (-> progress racer-index) (the float (- 1000 (-> racer finish-count))))
           )
          ((logtest? (-> racer flags) (racer-flags in-race))
           (set! (-> progress racer-index) (+ (the float (-> racer lap-count)) (-> racer lap-distance)))
           )
          (else
            (set! (-> progress racer-index) 0.0)
            )
          )
        )
      )
    (let ((left-index 0)
          (right-index 1)
          )
      (while (< right-index (-> this racer-count))
        (let ((left-racer (-> this rankings left-index))
              (right-racer (-> this rankings right-index))
              )
          (when (< (-> progress left-racer) (-> progress right-racer))
            (set! (-> this rankings left-index) right-racer)
            (set! (-> this rankings right-index) left-racer)
            )
          )
        (+! left-index 1)
        (+! right-index 1)
        )
      )
    )
  (dotimes (rank (-> this racer-count))
    (let* ((racer-index (-> this rankings rank))
           (racer (-> this racer-array racer-index))
           )
      (if (and (zero? rank) (nonzero? (-> racer rank)))
          (send-event (handle->process (-> racer racer)) 'race-pass)
          )
      (if (and (nonzero? rank) (zero? (-> racer rank)))
          (send-event (handle->process (-> racer racer)) 'race-got-passed)
          )
      (set! (-> racer rank) rank)
      )
    )
  (none)
  )

(defmethod debug-print-rankings ((this race-state))
  (dotimes (rank (-> this racer-count))
    (let* ((racer-index (-> this rankings rank))
           (racer (-> this racer-array racer-index))
           )
      (when (not (logtest? (-> racer flags) (racer-flags dead)))
        (if (= racer-index (-> this i-player))
            (format *stdcon* ">>>")
            (format *stdcon* "   ")
            )
        (cond
          ((logtest? (-> racer flags) (racer-flags finished))
           (format *stdcon* " #~d  finished " (+ racer-index 1))
           (cond
             ((zero? rank)
              (let ((finish-time (- (-> racer finish-time) (-> this race-start-time))))
                (print-time *stdcon* (the-as time-frame finish-time))
                )
              )
             (else
               (format *stdcon* "+")
               (let ((time-behind (- (- (-> racer finish-time) (-> this race-start-time))
                              (- (-> this racer-array (-> this rankings 0) finish-time) (-> this race-start-time))
                              )
                           )
                     )
                 (print-time *stdcon* (the-as time-frame time-behind))
                 )
               )
             )
           (format *stdcon* "~%")
           )
          (else
            (format *stdcon* " #~d  lap ~d  ~f~%" (+ racer-index 1) (+ (-> racer lap-count) 1) (-> racer lap-distance))
            )
          )
        )
      )
    )
  (none)
  )

(defmethod update-racers ((this race-state))
  (let ((active-count 0))
    (dotimes (racer-index (-> this racer-count))
      (let ((racer (-> this racer-array racer-index)))
        (update-lap-distance racer this)
        (if (not (logtest? (-> racer flags) (racer-flags finished dead)))
            (+! active-count 1)
            )
        )
      )
    (if (zero? active-count)
        (set! (-> this state) (race-state-enum all-dead))
        )
    )
  (none)
  )

(defmethod setup-race ((this race-state))
  (set-setting! 'allow-progress #f 0.0 0)
  (send-event (handle->process (-> this arrow)) 'leave)
  (when (logtest? (-> this info flags) (race-info-flags borrow))
    (send-event *traffic-manager* 'set-target-level 0.0)
    (send-event *traffic-manager* 'set-alert-level 0)
    )
  (send-event (handle->process (-> this race-signal)) 'ready)
  (let ((curve-points (new 'stack-no-clear 'matrix)))
    (vector-reset! (-> curve-points vector 2))
    (vector-reset! (-> curve-points trans))
    (let ((player-racer (-> this racer-array (-> this i-player))))
      (let ((player-vehicle (handle->process (-> player-racer racer))))
        (if player-vehicle
            (set! (-> curve-points vector 0 quad) (-> (the-as process-drawable player-vehicle) root trans quad))
            )
        )
      (set! (-> curve-points vector 1 quad) (-> player-racer start-position quad))
      )
    (cubic-curve-method-9
      (-> this player-intro-curve)
      (-> curve-points vector 0)
      (-> curve-points vector 2)
      (-> curve-points vector 1)
      (-> curve-points trans)
      )
    )
  (let ((hatch-name (-> this info hatch-actor-name)))
    (when hatch-name
      (let ((hatch (process-by-name hatch-name *active-pool*)))
        (send-event hatch 'open)
        )
      )
    )
  (set! (-> this countdown-start-time) (-> this current-time))
  (none)
  )

(defun mp-race-bind-player! ((state race-state) (racer racer-state) (racer-index int))
  (when (and state
             (nonzero? state)
             racer
             (nonzero? racer))
    (if (mp-race-sync-active?)
        (let ((player-id (mp-race-bound-player-id racer-index)))
          (when (< player-id (the uint MP_MAX_PLAYERS))
            (mp-race-apply-binding! state racer-index player-id)))
        (when (mp-race-racer-local-player? racer)
          (set! (-> state i-player) racer-index)
          (logior! (-> racer flags) (racer-flags local-player)))))
  (none))

(defmethod update ((this race-state))
  (set! (-> this current-time) (the-as uint (current-time)))
  (mp-race-host-tick! this)
  (case (-> this state)
    (((race-state-enum idle))
     (let ((ready? (the-as object #t)))
       (when (not (logtest? (-> this flags) (race-flags ready)))
         (if (mp-race-sync-active?)
             (begin
               (mp-race-apply-bindings! this)
               (when (and (mp-session-host?)
                          (mp-race-host-all-ready? this))
                 (mp-race-host-authorize-start!))
               (set! ready? (mp-race-start-authorized?)))
             (dotimes (racer-index (-> this racer-count))
               (let* ((racer (-> this racer-array racer-index))
                      (vehicle (handle->process-safe (-> racer racer))))
                 (mp-race-bind-player! this racer racer-index)
                 (set! ready?
                       (and ready?
                            vehicle
                            (nonzero? vehicle)
                            (send-event vehicle 'test-ready)))))))
       (when ready?
         (when (-> this info on-player-ready)
            (script-eval (-> this info on-player-ready))
           )
         (when (spawn-race-signal this)
            (debug-log *mp-debug-log?* "[Race] Race signal has been spawned!~%")
            (set! ready? (handle->process (-> this race-signal)))
            )
         (setup-race this)
         (set! (-> this state)
               (if (or (logtest? (-> this flags) (race-flags pidax)) (logtest? (-> this info flags) (race-info-flags city-race)))
                   (race-state-enum countdown-start)
                   (race-state-enum player-get-on)
                   )
               )
         )
       )
     )
    (((race-state-enum player-get-on))
     (let ((intro-t (* 0.0033333334 (the float (- (-> this current-time) (-> this countdown-start-time)))))
           (player-vehicle (the-as process-focusable (handle->process (-> this racer-array (-> this i-player) racer))))
           )
       (cond
         ((< intro-t 1.0)
          (when player-vehicle
            (cubic-curve-method-10 (-> this player-intro-curve) (-> player-vehicle root trans) intro-t)
            (cubic-curve-method-11 (-> this player-intro-curve) (-> player-vehicle root transv) intro-t)
            (when (< 0.4 intro-t)
              (when (-> this info start-camera)
                (set-setting! 'entity-name (-> this info start-camera) 0.0 0)
                (if (logtest? (-> this info flags) (race-info-flags show-tutorial))
                    (talker-spawn-func (-> *talker-speech* 377) *entity-pool* (target-pos 0) (the-as region #f))
                    )
                )
              )
            )
          )
         (else
           (set! (-> this state) (race-state-enum player-set-pos))
           )
         )
       )
     )
    (((race-state-enum player-set-pos))
     (let ((player-vehicle (the-as process-focusable (handle->process (-> this racer-array (-> this i-player) racer)))))
       (when player-vehicle
         (cubic-curve-method-10 (-> this player-intro-curve) (-> player-vehicle root trans) 1.0)
         (vector-reset! (-> (the-as process-focusable player-vehicle) root transv))
         )
       )
     (let ((hatch-name (-> this info hatch-actor-name)))
       (when hatch-name
         (let ((hatch (process-by-name hatch-name *active-pool*)))
           (send-event hatch 'close)
           )
         )
       )
     (set! (-> this countdown-start-time) (-> this current-time))
     (set! (-> this state) (if (-> this info countdown-scene)
                               (race-state-enum countdown-scene-start)
                               (race-state-enum countdown-start)
                               )
           )
     )
    (((race-state-enum countdown-scene-start))
     (when (>= (the-as uint (- (current-time) (the-as int (-> this countdown-start-time)))) (the-as uint 300))
       (set! (-> this state) (race-state-enum countdown-scene))
       (set! (-> this scene-player)
             (ppointer->handle (process-spawn scene-player :init scene-player-init (-> this info countdown-scene) #t #f))
             )
       )
     )
    (((race-state-enum countdown-scene))
     (cond
       ((handle->process (-> this scene-player))
        (let ((info (-> this info)))
          (dotimes (racer-index (-> this racer-count))
            (let ((racer (-> this racer-array racer-index)))
              (if (logtest? (-> info racer-array racer-index flags) (racer-info-flags hide-in-scene))
                  (send-event (handle->process (-> racer racer)) 'hide)
                  )
              )
            )
          )
        )
       (else
         (let ((info (-> this info)))
           (dotimes (racer-index (-> this racer-count))
             (let ((racer (-> this racer-array racer-index)))
               (if (logtest? (-> info racer-array racer-index flags) (racer-info-flags hide-in-scene))
                   (send-event (handle->process (-> racer racer)) 'unhide)
                   )
               )
             )
           )
         (set! (-> this state) (race-state-enum countdown-start))
         )
       )
     )
    (((race-state-enum countdown-start))
     (if (mp-race-sync-active?)
         (begin
           (when (mp-session-host?)
             (mp-race-host-schedule-go! this))
           (when (nonzero? (mp-race-start-time))
             (set! (-> this i-countdown) 4)
             (set! (-> this state) (race-state-enum countdown))
             (set! (-> this countdown-start-time)
                   (the-as uint
                     (- (mp-race-start-time) MP_RACE_COUNTDOWN_FRAMES)))
             (remove-setting! 'entity-name)))
         (begin
           (set! (-> this i-countdown) 4)
           (set! (-> this state) (race-state-enum countdown))
           (set! (-> this countdown-start-time) (-> this current-time))
           (remove-setting! 'entity-name)))
     )
    (((race-state-enum countdown))
     (let ((countdown-scale 3.0))
       (let ((countdown-time (+ (the int (* 300.0 countdown-scale)) (- (-> this countdown-start-time) (-> this current-time)))))
         (cond
           ((>= countdown-time (the int (* 225.0 countdown-scale)))
            )
           ((>= countdown-time (the int (* 150.0 countdown-scale)))
            (when (!= (-> this i-countdown) 3)
              (set! (-> this i-countdown) 3)
              (send-event (handle->process (-> this race-signal)) 'count-3)
              )
            )
           ((>= countdown-time (the int (* 75.0 countdown-scale)))
            (when (!= (-> this i-countdown) 2)
              (set! (-> this i-countdown) 2)
              (send-event (handle->process (-> this race-signal)) 'count-2)
              )
            )
           ((< (the int (* 0.0 countdown-scale)) countdown-time)
            (when (!= (-> this i-countdown) 1)
              (set! (-> this i-countdown) 1)
              (send-event (handle->process (-> this race-signal)) 'count-1)
              )
            )
           (else
             (set! (-> this i-countdown) 0)
             (set! (-> this state) (race-state-enum active))
             (begin-race this)
             )
           )
         )
       )
     (update-racers this)
     )
    (((race-state-enum active))
     (update-racers this)
     (update-rankings this)
     )
    (((race-state-enum all-dead))
     )
    (else
      )
    )
  (dotimes (turbo-index (-> this info turbo-pad-count))
    (let ((turbo-pad (-> this info turbo-pad-array turbo-index)))
      (if (not (handle->process (-> turbo-pad handle)))
          (set! (-> turbo-pad handle)
                (process->handle (turbo-pickup-spawn (handle->process (-> this manager)) (-> turbo-pad position)))
                )
          )
      )
    )
  (none)
  )

(defmethod spawn-race-signal ((this race-state))
  (when (= (level-status *level* 'lracelit) 'active)
    (let ((info (-> this info))
          (manager (handle->process (-> this manager)))
          (transform (new 'stack-no-clear 'matrix)))
      (vector-float*! (-> transform vector 2) (-> info start-dir) -1.0)
      (forward-up-nopitch->quaternion
        (the-as quaternion (-> transform vector 1))
        (-> transform vector 2)
        (new 'static 'vector :y 1.0 :w 1.0))
      (vector+float*! (-> transform vector 0) (the-as vector (-> info start-sphere)) (-> info start-dir) 49152.0)
      (+! (-> transform vector 0 y) 22528.0)
      (set! (-> this race-signal)
            (process->handle (race-signal-spawn manager (-> transform vector 0) (the-as quaternion (-> transform vector 1)))))
      )
    )
  (the-as symbol (and (-> this race-signal) (nonzero? (-> this race-signal)))))

(defun race-state-initialize-racer-slot! ((state race-state)
                                          (racer-index int))
  (when (or (not state)
            (zero? state)
            (< racer-index 0)
            (>= racer-index 10))
    (return #f))
  (let ((info (-> state info)))
    (when (or (not info)
              (zero? info)
              (>= racer-index (-> info racer-count)))
      (return #f))
    (let ((grid (new 'stack-no-clear 'mystery-race-manager-type)))
      (set! (-> grid vec1 z) 81920.0)
      (set! (-> grid word) 4)
      (set! (-> grid vec0 z) (/ (-> grid vec1 z) -2))
      (set! (-> grid vec0 w) -20480.0)
      (set! (-> grid vec1 x)
            (/ (-> grid vec1 z) (the float (+ (-> grid word) -1))))
      (set! (-> grid vec1 y) -40960.0)
      (set! (-> grid mat quad 0) (-> info start-sphere quad))
      (set! (-> grid mat vector 1 quad) (-> info start-dir quad))
      (set-vector! (-> grid mat vector 2)
                   (-> grid mat vector 1 z)
                   0.0
                   (- (-> grid mat vector 1 x))
                   1.0)
      (let* ((row (/ racer-index (-> grid word)))
             (column (- racer-index (* row (-> grid word))))
             (racer (-> state racer-array racer-index)))
        (set! (-> grid vec0 x)
              (+ (-> grid vec0 z)
                 (* (-> grid vec1 x) (the float column))))
        (set! (-> grid vec0 y)
              (+ (-> grid vec0 w)
                 (* (-> grid vec1 y) (the float row))))
        (set! (-> grid mat trans quad) (-> grid mat quad 0))
        (vector+float*! (-> grid mat trans)
                        (-> grid mat trans)
                        (-> grid mat vector 1)
                        (-> grid vec0 y))
        (vector+float*! (-> grid mat trans)
                        (-> grid mat trans)
                        (-> grid mat vector 2)
                        (-> grid vec0 x))
        (set! (-> racer start-position quad) (-> grid mat trans quad))
        (set! (-> racer rank) racer-index)
        (set! (-> racer speed-factor) 1.0)
        (set! (-> state rankings racer-index) racer-index))))
  #t)

(defmethod initialize ((this race-state) (manager process) (info race-info))
  (let ((saved-flags (-> this flags)))
    (mem-set32! (the-as pointer this) 324 0)
    (set! (-> this flags) saved-flags))

  (set! (-> this info) info)
  (set! (-> this manager) (process->handle manager))
  (set! (-> this scene-player) (the-as handle #f))
  (set! (-> this hud-timer) (the-as handle #f))
  (set! (-> this hud-lap-counter) (the-as handle #f))
  (set! (-> this hud-turbo-counter) (the-as handle #f))
  (set! (-> this hud-position) (the-as handle #f))
  (set! (-> this arrow) (the-as handle #f))
  (set! (-> this state) (race-state-enum idle))
  (set! (-> this racer-count) 0)
  (set! (-> this finished-count) 0)

  (dotimes (racer-index (mp-race-effective-racer-count info))
    (race-state-initialize-racer-slot! this racer-index))

  (dotimes (i (-> this info turbo-pad-count))
    (set! (-> this info turbo-pad-array i handle) (the-as handle #f)))

  (let ((task (-> *game-info* sub-task-list (-> info task-node))))
    (set! (-> this suck-factor) 0.0)
    (when (not (logtest? (-> info flags) (race-info-flags bbush)))
      (set! (-> this suck-factor)
            (fmax 0.0 (fmin 1.0 (* 0.2 (+ -4.0 (the float (-> task death-count))))))))
    (format #t "race-state::initialize: death-count ~d, suck-factor ~f~%"
            (-> task death-count) (-> this suck-factor)))
  (none))

(define *race-state* (new 'static 'race-state))

(define *race-rigid-body-queue* (new 'static 'rigid-body-queue))

(defmethod update ((this race-manager))
  (let ((display-flags *display-race-marks*))
    (when (logtest? display-flags (race-marks-controls rmc2040))
      (let ((mesh-entity (entity-by-name (-> *race-info-array* *select-race* race-mesh-name))))
        (when mesh-entity
          (let ((mesh (-> (the-as entity-race-mesh mesh-entity) race-mesh)))
            (when mesh
              (let ((path-bit 8))
                (dotimes (path-index 8)
                  (when (logtest? display-flags path-bit)
                    (debug-draw-path-from-history mesh path-index 0))
                  (set! path-bit (* path-bit 2)))))))))
  (race-manager-reconcile-racers! this)
  (update (-> this race-state))
  0))

(defmethod race-manager-method-22 ((this race-manager))
  (none))

(defmethod initialize-race-state ((this race-manager))
  (let ((info (-> this race-state info)))
    (if (logtest? (-> info flags) (race-info-flags destination-race))
        (set! (-> info mesh) #f)
        (initialize-mesh info))
    (initialize (-> this race-state) this info))

  (set! (-> *game-info* race-position) 0)
  (set! (-> *game-info* race-current-lap-count) 0)
  (set! (-> *game-info* race-total-lap-count) 0)
  (set! (-> *game-info* race-timer) (the-as uint 0))
  (set! (-> *game-info* race-number-turbos) 0)
  (none))

(defun race-manager-configure-spawn-base!
       ((info race-info) (spawn mystery-traffic-object-spawn-params))
  (when (or (not info) (zero? info) (not spawn) (zero? spawn))
    (return #f))
  (set! (-> spawn vector 0 quad) (-> info start-sphere quad))
  (set! (-> spawn vector 1 quad) (-> info start-dir quad))
  (set-vector! (-> spawn vector 2)
               (-> spawn vector 1 z)
               0.0
               (- (-> spawn vector 1 x))
               1.0)
  (set! (-> spawn params object-type) (traffic-type tt17))
  (set! (-> spawn params behavior) (the-as uint 10))
  (set! (-> spawn params nav-mesh) #f)
  (set! (-> spawn params nav-branch) #f)
  (set! (-> spawn params proc) #f)
  (set! (-> spawn params handle) (the-as handle #f))
  (set! (-> spawn params flags) (traffic-spawn-flags))
  (set! (-> spawn params guard-type) (the-as uint 7))
  (vector-reset! (-> spawn params velocity))
  (forward-up-nopitch->quaternion
    (-> spawn params rotation)
    (-> spawn vector 1)
    (new 'static 'vector :y 1.0 :w 1.0))
  #t)

(defun race-racer-map-icon ((rider uint) (open-racer? symbol))
  (cond
    (open-racer? (minimap-class racer-target))
    ((or (zero? rider) (= rider 1)) (minimap-class none))
    ((= rider 2) (minimap-class racer-errol))
    (else (minimap-class racer))))

(defun race-manager-finish-racer-spawn! ((state race-state)
                                          (info race-info)
                                          (racer-index int)
                                          (vehicle vehicle)
                                          (rider uint)
                                          (open-racer? symbol)
                                          (map-icon uint))
  (when (or (not state) (zero? state)
            (not info) (zero? info)
            (not vehicle) (zero? vehicle)
            (< racer-index 0)
            (>= racer-index (-> state racer-count))
            (>= racer-index (-> info racer-count)))
    (return #f))
  (let ((racer (-> state racer-array racer-index))
        (racer-info (-> info racer-array racer-index)))
    (mp-race-vehicle-register! racer-index vehicle)
    (when (and (type? vehicle vehicle-racer)
               *minimap*
               (nonzero? *minimap*))
      (set! (-> (the-as vehicle-racer vehicle) minimap)
            (add-icon! *minimap* vehicle map-icon
                       (the-as int #f) (the-as vector #t) 0)))
    (init-racer! racer vehicle)
    (set! (-> racer rider) (if open-racer? (the uint8 0) rider))
    (set! (-> racer target-pos-offset)
          (* (-> info ai-spread-factor)
             (+ (the float (-> racer-info seek-offset))
                (* -3.33 (-> state suck-factor)))))
    (when (and (not (mp-race-sync-active?))
               (= racer-index (-> state i-player))
               (logtest? (-> state flags) (race-flags pidax))
               *target*
               (nonzero? *target*))
      (send-event *target* 'change-mode
                  (if (= rider 1) 'pilot-daxter 'pilot)
                  vehicle 0 #t)))
  #t)

(defun race-manager-spawn-racer! ((manager race-manager)
                                  (racer-index int))
  (when (or (not manager) (zero? manager))
    (return #f))
  (let* ((state (-> manager race-state))
         (info (-> state info)))
    (when (or (not state) (zero? state)
              (not info) (zero? info)
              (< racer-index 0)
              (>= racer-index (-> state racer-count))
              (>= racer-index (-> info racer-count)))
      (return #f))
    (let* ((racer (-> state racer-array racer-index))
           (racer-info (-> info racer-array racer-index))
           (rider (the-as uint (-> racer-info rider)))
           (open-racer? (mp-race-racer-open? racer-index))
           (spawn (new 'stack-no-clear 'mystery-traffic-object-spawn-params)))
      (race-manager-configure-spawn-base! info spawn)
      (set! (-> spawn params position quad) (-> racer start-position quad))
      (set! (-> spawn params id) (the-as uint racer-index))
      (set! (-> spawn params user-data) rider)
      (logior! (-> spawn params flags) (traffic-spawn-flags spawn-rider))
      (when (or open-racer? (zero? rider) (= rider 1))
        (logclear! (-> spawn params flags) (traffic-spawn-flags spawn-rider)))
      (when (not (and (logtest? (-> state flags) (race-flags sleep))
                      (logtest? (-> racer-info flags)
                                (racer-info-flags hide-in-scene))))
        (set! (-> spawn params net-id)
              (mp-race-vehicle-net-id (-> info id) racer-index))
        (let ((vehicle
                (the-as vehicle
                  (vehicle-spawn manager
                    (type-from-race-vehicle-type (-> racer-info vehicle))
                    (-> spawn params)))))
          (if (and vehicle (nonzero? vehicle))
              (race-manager-finish-racer-spawn!
                state info racer-index vehicle rider open-racer?
                (the-as uint (race-racer-map-icon rider open-racer?)))
              (format 0 "failed to spawn racebike~%")))))
  #t))

(defun race-manager-mark-racer-icon-open! ((vehicle vehicle-racer))
  (when (and vehicle
             (nonzero? vehicle)
             *minimap*
             (nonzero? *minimap*))
    (let ((old-icon (-> vehicle minimap)))
      (when (and old-icon (nonzero? old-icon))
        (logior! (-> old-icon flags) (minimap-flag fade-out)))
      (set! (-> vehicle minimap)
            (add-icon! *minimap* vehicle
                       (the-as uint (minimap-class racer-target))
                       (the-as int #f) (the-as vector #t) 0))))
  (none))

(defun race-manager-open-existing-racer! ((state race-state)
                                           (racer-index int))
  (when (or (not state) (zero? state)
            (< racer-index 0)
            (>= racer-index (-> state racer-count))
            (not (mp-race-racer-open? racer-index))
            (mp-race-racer-ai-takeover? state racer-index))
    (return #f))
  (let* ((racer (-> state racer-array racer-index))
         (vehicle
           (the-as vehicle-racer
             (handle->process-safe (-> racer racer)))))
    (when (and vehicle (nonzero? vehicle) (type? vehicle vehicle-racer))
      (let ((driver (get-rider-in-seat vehicle 0)))
        (when (and (not (mp-player-process-record driver))
                   (or (and driver
                            (nonzero? driver)
                            (type? driver vehicle-rider))
                       (logtest? (-> vehicle flags)
                                 (rigid-body-object-flag ai-driving))))
          (mp-vehicle-clear-seat-occupant! vehicle 0 (the-as object #f))
          (logclear! (-> vehicle flags)
                     (rigid-body-object-flag riding ai-driving))
          (logior! (-> vehicle flags)
                   (rigid-body-object-flag waiting-for-player))
          (logior! (-> vehicle focus-status) (focus-status grabbed))
          (set! (-> racer rider) (the uint8 0))
          (race-manager-mark-racer-icon-open! vehicle)
          (send-event vehicle 'waiting-race)))))
  #t)

(defun race-manager-clear-temporary-retirement! ((state race-state)
                                                   (racer-index int))
  (when (and state
             (nonzero? state)
             (zero? (mp-race-start-time))
             (>= racer-index 0)
             (< racer-index MP_RACE_MAX_RACERS))
    (logclear! (-> *mp-race-sync-state* retired-racer-mask)
               (mp-race-racer-bit racer-index))
    (when (< racer-index (-> state racer-count))
      (let ((racer (-> state racer-array racer-index)))
        (logclear! (-> racer flags) (racer-flags finished dead)))))
  (none))

(defun race-manager-ensure-open-racer! ((manager race-manager)
                                        (racer-index int))
  (when (or (not manager) (zero? manager))
    (return #f))
  (let ((state (-> manager race-state)))
    (when (or (not state)
              (zero? state)
              (< racer-index 0)
              (>= racer-index (-> state racer-count)))
      (return #f))
    (race-manager-clear-temporary-retirement! state racer-index)
    (let* ((racer (-> state racer-array racer-index))
           (vehicle (handle->process-safe (-> racer racer))))
      (when (or (not vehicle) (zero? vehicle))
        (race-state-initialize-racer-slot! state racer-index)
        (race-manager-spawn-racer! manager racer-index)))
    (race-manager-open-existing-racer! state racer-index))
  #t)

(defun race-manager-close-racer! ((state race-state) (racer-index int))
  (when (or (not state)
            (zero? state)
            (< racer-index 0)
            (>= racer-index (-> state racer-count)))
    (return #f))
  (let ((info (-> state info)))
    (when (or (not info)
              (zero? info)
              (>= racer-index (-> info racer-count)))
      (return #f))
    (let ((racer-info (-> info racer-array racer-index)))
      (cond
        ((mp-race-ai-capable? racer-info)
         (mp-race-restore-ai-racer! state racer-index))
        ((mp-race-player-only? racer-info)
         (mp-race-retire-racer! state racer-index)))))
  #t)

(defun race-manager-resize-racers! ((manager race-manager)
                                    (desired-count int))
  (let ((state (-> manager race-state)))
    (while (> (-> state racer-count) desired-count)
      (let ((racer-index (+ (-> state racer-count) -1)))
        (mp-race-retire-racer! state racer-index)
        (-! (-> state racer-count) 1)))
    (while (< (-> state racer-count) desired-count)
      (let ((racer-index (the-as int (-> state racer-count))))
        (race-manager-clear-temporary-retirement! state racer-index)
        (when (race-state-initialize-racer-slot! state racer-index)
          (+! (-> state racer-count) 1)
          (race-manager-spawn-racer! manager racer-index)))))
  (none))

(defun race-manager-reconcile-racers! ((manager race-manager))
  (when (and manager
             (nonzero? manager)
             (mp-race-sync-active?)
             (zero? (mp-race-start-time)))
    (let ((state (-> manager race-state)))
      (when (and state (nonzero? state))
        (let ((info (-> state info)))
          (when (and info (nonzero? info))
            (let ((desired-count
                    (min MP_RACE_MAX_RACERS
                         (min (the-as int (-> info racer-count))
                              (-> *mp-race-sync-state* active-racer-count)))))
              (race-manager-resize-racers! manager desired-count)
              (dotimes (racer-index (-> state racer-count))
                (if (mp-race-racer-open? racer-index)
                    (race-manager-ensure-open-racer! manager racer-index)
                    (race-manager-close-racer! state racer-index)))))))))
  (none))

(defmethod initialize-state ((this race-manager))
  (rigid-body-queue-manager-spawn *race-rigid-body-queue* this)
  (let* ((state (-> this race-state))
         (info (-> state info)))
    (when (or (logtest? (-> info flags) (race-info-flags pidax))
              (logtest? (continue-flags pilot) (-> *game-info* last-continue flags)))
      (logior! (-> state flags) (race-flags pidax)))

    (let ((spawn (new 'stack-no-clear 'mystery-traffic-object-spawn-params)))
      (race-manager-configure-spawn-base! info spawn)
      (set! (-> spawn params id) (the-as uint 0))
      (set! (-> spawn params user-data) (the-as uint 0))
      (set! (-> state i-player) 0)
      (set! (-> state race-signal) (the-as handle #f))

      (cond
        ((and *debug-segment* *target* *race-record-path*)
         (let ((player-info (the-as race-racer-info #f)))
           (dotimes (i (mp-race-effective-racer-count info))
             (let ((candidate (-> info racer-array i)))
               (when (or (zero? (-> candidate rider)) (= (-> candidate rider) 1))
                 (set! player-info candidate))))

           (when (not player-info)
             (format 0 "race-manager::initialize-state: no player found~%"))

           (when player-info
             (set! (-> spawn params id) (the-as uint 0))
             (set! (-> state i-player) 0)
             (set! (-> spawn params position quad) (-> *target* control trans quad))
             (quaternion-copy! (-> spawn params rotation) (-> *target* control quat))
             (+! (-> spawn params position y) 12288.0)
             (set! (-> spawn params behavior) (the-as uint 4))
             (logclear! (-> spawn params flags) (traffic-spawn-flags spawn-rider))
             (let ((vehicle (vehicle-spawn this (type-from-race-vehicle-type (-> player-info vehicle)) (-> spawn params))))
               (when vehicle
                 (init-racers! state vehicle)
                 (send-event *target* 'change-mode 'pilot vehicle 0 #t)
                 (start-pilot-recorder))
               (when (not vehicle)
                 (format 0 "failed to spawn racebike~%"))))))

        (else
         (set! (-> state racer-count) (mp-race-effective-racer-count info))
         (dotimes (racer-index (-> state racer-count))
           (race-manager-spawn-racer! this racer-index))))))
  (none))

(defmethod save-score ((this race-manager) (score float))
  (let* ((score-id (-> this race-state info score))
         (duplicate-rank 0)
         (highscore-info (-> *highscore-info-array* score-id))
         )
    (let ((scores (get-game-score-ref *game-info* (the-as int score-id)))
          (rank-counts (new 'stack-no-clear 'array 'int8 4))
          )
      (dotimes (rank 4)
        (set! (-> rank-counts rank) 0)
        )
      (let ((score-index 0))
        (while (< score-index 8)
          (let ((rank (get-rank highscore-info (-> scores score-index))))
            (+! (-> rank-counts rank) 1)
            )
          (+! score-index 1)
          )
        )
      (dotimes (rank 4)
        (if (< 1 (-> rank-counts rank))
            (set! duplicate-rank rank)
            )
        )
      )
    (let* ((new-rank (get-rank highscore-info score))
           (skill-reward (max 0 (- new-rank duplicate-rank)))
           )
      (when (> (the-as uint skill-reward) 0)
        (set! (-> this finish-sound-id) (the-as sound-id 1))
        (cond
          ((= new-rank 3)
           (talker-spawn-func (-> *talker-speech* 374) *entity-pool* (target-pos 0) (the-as region #f))
           )
          ((= new-rank 2)
           (talker-spawn-func (-> *talker-speech* 375) *entity-pool* (target-pos 0) (the-as region #f))
           )
          ((= new-rank 1)
           (talker-spawn-func (-> *talker-speech* 376) *entity-pool* (target-pos 0) (the-as region #f))
           )
          )
        )
      (game-info-method-28 *game-info* (the-as game-score score-id) score)
      ;; og:preserve-this just give the skill directly
      (#cond
        (PC_PORT
          (send-event *target* 'get-pickup (pickup-type skill) (* (the float skill-reward) (-> *FACT-bank* super-skill-inc))))
        (#t
          (let ((pickup-info (new 'static 'fact-info)))
            (set! (-> pickup-info options) (actor-option))
            (logior! (-> pickup-info options) (actor-option suck-in))
            (birth-pickup-at-point
              (camera-pos)
              (pickup-type skill)
              (* (the float skill-reward) (-> *FACT-bank* super-skill-inc))
              #t
              *entity-pool*
              pickup-info
              )
            )
          )
        )
      )
    )
  (none)
  )

(defmethod stop-speech ((this race-manager))
  (set-action!
    *gui-control*
    (gui-action stop)
    (the-as sound-id 1)
    (gui-channel guard)
    (gui-action none)
    (the-as string #f)
    (the-as (function gui-connection symbol) #f)
    (the-as process #f)
    )
  (set-action!
    *gui-control*
    (gui-action stop)
    (the-as sound-id 1)
    (gui-channel background)
    (gui-action none)
    (the-as string #f)
    (the-as (function gui-connection symbol) #f)
    (the-as process #f)
    )
  (none)
  )

(defun race-manager-result-prompt-visible? ((manager race-manager))
  (when (or (not manager) (zero? manager))
    (return #f))
  (if (mp-race-sync-active?)
      (mp-session-host?)
      (and *gui-control*
           (nonzero? *gui-control*)
           (= (get-status *gui-control* (-> manager message-id))
              (gui-status active))))
  )

(defmethod draw-message-continue ((this race-manager))
  (when (race-manager-result-prompt-visible? this)
    (let ((font
            (new 'stack 'font-context *font-default-matrix* 70 20 0.0 (font-color orange) (font-flags shadow kerning))
            )
          )
      (set-scale! font 0.7)
      (set-width! font 225)
      (set-height! font 70)
      (set! (-> font origin x) (the float (- 256 (the int (/ (-> font width) 2)))))
      (set! (-> font origin y) 320.0)
      (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
      (let ((draw-text print-game-text))
        (format (clear *temp-string*) (lookup-text! *common-text* (text-id progress-x-to-continue) #f) 1)
        (draw-text *temp-string* font #f 44 (bucket-id progress))
        )
      )
    )
  (none)
  )

(defmethod draw-message-retry ((this race-manager))
  (when (race-manager-result-prompt-visible? this)
    (let ((font
            (new 'stack 'font-context *font-default-matrix* 70 20 0.0 (font-color orange) (font-flags shadow kerning))
            )
          )
      (set-scale! font 0.7)
      (set-width! font 240)
      (set-height! font 35)
      (set! (-> font origin x) (the float (- 256 (the int (/ (-> font width) 2)))))
      (set! (-> font origin y) 320.0)
      (set! (-> font flags) (font-flags shadow kerning middle middle-vert large))
      (let ((draw-text print-game-text))
        (format (clear *temp-string*) (lookup-text! *common-text* (text-id try-again?) #f) 1)
        (draw-text *temp-string* font #f 44 (bucket-id progress))
        )
      (+! (-> font origin y) 35.0)
      (let ((draw-text print-game-text))
        (format (clear *temp-string*) (lookup-text! *common-text* (text-id yes-no-prompt) #f) 1)
        (draw-text *temp-string* font #f 44 (bucket-id progress))
        )
      )
    )
  (none)
  )

(defbehavior race-manager-event-handler race-manager ((source process) (event-id int) (event symbol) (message event-message-block))
  (case event
    (('die)
     (go-virtual die)
     )
    (('force-start)
     (logior! (-> self race-state flags) (race-flags ready))
     )
    (('begin-race)
     (send-event (ppointer->process (-> self parent)) 'fail-on-death #t)
     )
    (('win))
    (('lose))
    )
  )

(defstate idle (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :code (behavior ()
    (cond
      ((logtest? (-> self race-state flags) (race-flags sleep))
       (initialize-race-state self)
       (initialize-state self)
       (until #f
         (suspend)
         )
       #f
       )
      (else
        (set-setting! 'music 'race 0.0 0)
        (set-setting! 'sound-mode #f 0.0 2)
        (let ((info (-> self race-state info)))
          (when (-> info borrow)
            (debug-log *mp-debug-log?* "[Race] Borrowing: ~A~%" (-> info borrow))
            (set-setting! 'borrow (-> info borrow) 0.0 0)
            (apply-settings *setting-control*)
            (while (!= (level-status *level* 'lracelit) 'active)
              (suspend)
              )
            (debug-log *mp-debug-log?* "[Race] racelit is active~%")
            (when (-> info borrow-level)
              (while (!= (level-status *level* (-> info borrow-level)) 'active)
                (suspend)
                )
              )
            )
          )
        (while (not (and *target* (or (not (focus-test? *target* teleporting)) (focus-test? *target* pilot))))
          (suspend)
          )
        (let ((info (-> self race-state info)))
          (mp-race-manager-begin! info)
          (let ((request-timer (the-as time-frame 0)))
            (while (not (mp-race-manager-config-ready? info))
              (cond
                ((mp-session-host?)
                 (mp-race-manager-begin! info))
                (else
                 (when (time-elapsed? request-timer (seconds 0.5))
                   (set-time! request-timer)
                   (mp-race-request-config! info))))
              (suspend))))
        (initialize-race-state self)
        (initialize-state self)
        (suspend)
        (let ((info (-> self race-state info)))
          (when (and (-> info countdown-scene) (not (logtest? (-> self race-state flags) (race-flags pidax))))
            (dotimes (racer-index (-> self race-state racer-count))
              (let ((racer (-> self race-state racer-array racer-index)))
                (if (and (logtest? (-> info racer-array racer-index flags) (racer-info-flags hide-in-scene))
                         (!= racer-index (-> self race-state i-player))
                         )
                    (send-event (handle->process (-> racer racer)) 'hide)
                    )
                )
              )
            )
          )
        (when (and *debug-segment* *target* *race-record-path*)
          (until #f
            (update self)
            (suspend)
            )
          #f
          )
        )
      )
    (go-virtual active)
    )
  )

(defstate active (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :code sleep-code
  :enter (behavior ()
    (mp-culling-set-override! (mp-culling-override-flags race) #t)
    )
  :post (behavior ()
    (update self)
    (mp-race-sync-post-finish-timer! self)
    (let ((player-racer (-> self race-state racer-array (-> self race-state i-player)))
          (state (-> self race-state))
          )
      (set! (-> state target-pos) (-> player-racer pos))
      (let ((game-info *game-info*))
        (set! (-> game-info race-position) (-> player-racer rank))
        (set! (-> game-info race-current-lap-count) (min (+ (-> player-racer lap-count) 1) (-> self race-state info lap-count)))
        (set! (-> game-info race-total-lap-count) (-> self race-state info lap-count))
        (let ((timer-end (-> state current-time)))
          (if (logtest? (-> player-racer flags) (racer-flags finished))
              (set! timer-end (-> player-racer finish-time))
              )
          (let ((race-time (the-as int (- timer-end (-> state race-start-time)))))
            (if (not (logtest? (-> state flags) (race-flags begun)))
                (set! race-time 0)
                )
            (set! (-> game-info race-timer) (the-as uint race-time))
            )
          )
        )
      (when (logtest? (-> player-racer flags) (racer-flags in-race))
        (cond
          ((or (logtest? (-> player-racer flags) (racer-flags on-track))
               (logtest? (-> self race-state info flags) (race-info-flags destination-race)))
           (set-time! (-> self player-on-track-time))
           )
          (else
            (when (time-elapsed? (-> self player-on-track-time) (seconds 1))
              (let ((player-vehicle (handle->process (-> player-racer racer))))
                (when player-vehicle
                  (when (logtest? (-> (the-as vehicle-racer player-vehicle) flags) (rigid-body-object-flag on-ground))
                    (when (send-event *target* 'attack-invinc #f (static-attack-info ((id (new-attack-id)) (mode 'instant-death))))
                        (debug-log *mp-debug-log?* "[Race] Racer is off the track, failing the race.~%")
                        (if (mp-race-sync-active?)
                            (mp-race-request-local-dnf! state)
                            (go-virtual fail))
                        )
                    )
                  )
                )
              )
            )
          )
        )
      (when (or (logtest? (-> player-racer flags) (racer-flags dead)) (not *target*) (focus-test? *target* dead))
          (debug-log *mp-debug-log?* "[Race] Racer is dead, failing the race.~%")
          (if (mp-race-sync-active?)
              (mp-race-request-local-dnf! state)
              (go-virtual fail))
          )
      (when (and (not (mp-race-sync-active?))
                 (logtest? (-> player-racer flags) (racer-flags finished)))
        (when (and (not (logtest? (-> player-racer flags) (racer-flags saved-score))) (not (logtest? (-> self race-state info flags) (race-info-flags destination-race))))
          (logior! (-> player-racer flags) (racer-flags saved-score))
          (let ((finish-time-seconds (* 0.0033333334 (the float (- (-> player-racer finish-time) (-> state race-start-time))))))
            (save-score self finish-time-seconds)
            )
          )
        (send-event (ppointer->process (-> self parent)) 'allow-fail #f)
        (if (not (logtest? (-> self race-state info flags) (race-info-flags borrow)))
            (set-setting! 'sound-mode #f 0.0 2)
            )
        (set! (-> self message-id)
              (add-process *gui-control* self (gui-channel supertitle) (gui-action play) "fail" 81920.0 0)
              )
        (if (zero? (-> player-racer finish-count))
            (go-virtual win)
            (go-virtual lose))
        )
      (when (and (logtest? (-> self race-state flags) (race-flags begun))
                 (mp-race-results-ready?))
        (if (mp-race-overall-success?)
            (go-virtual win)
            (go-virtual lose)))
      )
    )
  )

(defun clear-task-manager-hud-timer-if-present ((manager race-manager))
  (let ((manager-parent (the-as task-manager (ppointer->process (-> manager parent)))))
    (when manager-parent (nonzero? manager-parent) (type? manager-parent task-manager)
      (let ((hud-timer (handle->process (-> (the-as task-manager manager-parent) hud-timer))))
        (set! (-> manager-parent start-time) 0)
        (send-event hud-timer 'hide-and-die)
        )
      )
    )
  )

(defun race-manager-force-hide-hud! ((hud-handle handle))
  (let ((hud (handle->process-safe hud-handle)))
    (when (and hud (nonzero? hud))
      (send-event hud 'force-hide)))
  (none))

(defstate win (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :code (behavior ()
    (if (zero? (-> self finish-sound-id))
        (set! (-> self finish-sound-id)
              (add-process *gui-control* *target* (gui-channel background) (gui-action play) "miss001" -99.0 0)
              )
        )
    (send-event (ppointer->process (-> self parent)) 'race-win)
    (race-manager-force-hide-hud! (-> self race-state hud-timer))
    (race-manager-force-hide-hud! (-> self race-state hud-lap-counter))
    (race-manager-force-hide-hud! (-> self race-state hud-turbo-counter))
    (process-spawn hud-race-final-stats :init hud-init-by-other :to self)
    (set-time! (-> self state-time))
    (when (logtest? (-> self race-state info flags) (race-info-flags complete-immediately))
      (when (or (not (mp-race-sync-active?)) (mp-session-host?))
        (when (mp-race-sync-active?)
          (mp-race-host-set-decision! MP_RACE_DECISION_COMPLETE))
        (send-event (ppointer->process (-> self parent)) 'complete)
        (sleep-code)))
    (clear-task-manager-hud-timer-if-present self)
    ;; og:preserve-this auto-save when a race is won
    (#when PC_PORT
      (when (not (mp-race-sync-active?))
        (auto-save-user)))
    (until #f
      (when (and (mp-race-sync-active?)
                 (mp-session-client?)
                 (!= (mp-race-decision) MP_RACE_DECISION_NONE))
        (stop-speech self)
        (case (mp-race-decision)
          ((MP_RACE_DECISION_RETRY)
           (send-event (ppointer->process (-> self parent)) 'retry-immediately)
           (go-virtual die))
          ((MP_RACE_DECISION_COMPLETE) (go-virtual completed))
          ((MP_RACE_DECISION_FAIL)
           (send-event (ppointer->process (-> self parent)) 'fail-immediately)
           (go-virtual die))))
      (cond
        ((or (logtest? (-> self race-state info flags) (race-info-flags retryable))
             (logtest? (-> self race-state info flags) (race-info-flags optionally-retryable)))
         (draw-message-retry self)
         (when (time-elapsed? (-> self state-time) (seconds 0.5))
           (cond
             ((and (or (not (mp-race-sync-active?)) (mp-session-host?))
                   (cpad-pressed? 0 confirm))
              (stop-speech self)
              (when (mp-race-sync-active?)
                (mp-race-host-set-decision! MP_RACE_DECISION_RETRY))
              (send-event (ppointer->process (-> self parent)) 'retry-immediately)
              (go-virtual die)
              )
             ((and (or (not (mp-race-sync-active?)) (mp-session-host?))
                   (cpad-pressed? 0 triangle))
              (stop-speech self)
              (if (logtest? (-> self race-state info flags) (race-info-flags optionally-retryable))
                (begin
                  (when (mp-race-sync-active?)
                    (mp-race-host-set-decision! MP_RACE_DECISION_COMPLETE))
                  (go-virtual completed))
                (begin
                  (when (mp-race-sync-active?)
                    (mp-race-host-set-decision! MP_RACE_DECISION_FAIL))
                  (send-event (ppointer->process (-> self parent)) 'fail-immediately)
                  (go-virtual die))
                )
              )
             )
           )
         )
        (else
          (draw-message-continue self)
          (when (time-elapsed? (-> self state-time) (seconds 0.5))
            (when (and (or (not (mp-race-sync-active?)) (mp-session-host?))
                       (cpad-pressed? 0 confirm))
              (stop-speech self)
              (when (mp-race-sync-active?)
                (mp-race-host-set-decision! MP_RACE_DECISION_COMPLETE))
              (go-virtual completed)
              )
            )
          )
        )
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (update self)
    )
  )

(defmethod all-players-completed? ((this race-manager))
  (if (mp-race-sync-active?)
      (mp-race-results-ready?)
      #t)
  )

(defstate completed (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :code (behavior ()
    (when (all-players-completed? self)
      (send-event (ppointer->process (-> self parent)) 'complete)
      (sleep-code)
      )
    )
  :post (behavior ()
    (update self)
    )
  )

(defstate lose (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :code (behavior ()
    (if (zero? (-> self finish-sound-id))
        (set! (-> self finish-sound-id)
              (add-process *gui-control* *target* (gui-channel background) (gui-action play) "lose1" -99.0 0)
              )
        )
    (send-event (ppointer->process (-> self parent)) 'race-lose)
    (race-manager-force-hide-hud! (-> self race-state hud-timer))
    (race-manager-force-hide-hud! (-> self race-state hud-lap-counter))
    (race-manager-force-hide-hud! (-> self race-state hud-turbo-counter))
    (process-spawn hud-race-final-stats :init hud-init-by-other :to self)
    (set-time! (-> self state-time))
    (until #f
      (when (and (mp-race-sync-active?)
                 (mp-session-client?)
                 (!= (mp-race-decision) MP_RACE_DECISION_NONE))
        (stop-speech self)
        (case (mp-race-decision)
          ((MP_RACE_DECISION_RETRY)
           (send-event (ppointer->process (-> self parent)) 'retry-immediately)
           (go-virtual die))
          ((MP_RACE_DECISION_COMPLETE) (go-virtual completed))
          ((MP_RACE_DECISION_FAIL)
           (send-event (ppointer->process (-> self parent)) 'fail-immediately)
           (go-virtual die))))
      (draw-message-retry self)
      (when (time-elapsed? (-> self state-time) (seconds 0.5))
        (cond
          ((and (or (not (mp-race-sync-active?)) (mp-session-host?))
                (cpad-pressed? 0 confirm))
           (stop-speech self)
           (when (mp-race-sync-active?)
             (mp-race-host-set-decision! MP_RACE_DECISION_RETRY))
           (send-event (ppointer->process (-> self parent)) 'retry-immediately)
           (go-virtual die)
           )
          ((and (or (not (mp-race-sync-active?)) (mp-session-host?))
                (cpad-pressed? 0 triangle))
           (stop-speech self)
           (when (mp-race-sync-active?)
             (mp-race-host-set-decision! MP_RACE_DECISION_FAIL))
           (send-event (ppointer->process (-> self parent)) 'fail-immediately)
           (go-virtual die)
           )
          )
        )
      (suspend)
      )
    #f
    )
  :post (behavior ()
    (update self)
    )
  )

(defstate fail (race-manager)
  :virtual #t
  :event race-manager-event-handler
  :enter (behavior ()
    (debug-log *mp-debug-log?* "[Race] Race manager has entered fail.~%")
    )
  :code (behavior ()
    (race-manager-force-hide-hud! (-> self race-state hud-timer))
    (race-manager-force-hide-hud! (-> self race-state hud-lap-counter))
    (race-manager-force-hide-hud! (-> self race-state hud-turbo-counter))
    (set-time! (-> self state-time))
    (until #f
      (suspend)
      )
    #f
    )
  )

(defstate die (race-manager)
  :virtual #t
  :enter (behavior ()
    (mp-culling-clear-override! (mp-culling-override-flags race))
    )
  :code (behavior ()
    '()
    )
  )

(defun want-race-sound! ((info race-info))
  (when (and info (nonzero? info) *load-state* (nonzero? *load-state*))
    (let ((want-sound (-> info want-sound)))
      (when (and want-sound (nonzero? want-sound))
        (set! (-> *load-state* want-sound 1) want-sound)
        )
      )
    )
  (none)
  )

(defmethod deactivate ((this race-manager))
  "Make a process dead, clean it up, remove it from the active pool, and return to dead pool."
  (when (and (-> this race-state) (-> this race-state info))
    (set! (-> this race-state info manager) (the-as handle #f)))
  (mp-race-manager-end!)
  (mp-race-clear-vehicle-handles!)
  (persist-with-delay *setting-control* 'music-volume (seconds 3) 'music-volume 'abs 0.0 0)
  (send-event *traffic-manager* 'restore-default-settings)
  (call-parent-method this)
  (none)
  )

(defbehavior race-manager-init-by-other race-manager ((info race-info) (preload? symbol))
  ;; og:preserve-this changed from 512
  (mp-race-clear-vehicle-handles!)
  (stack-size-set! (-> self main-thread) 1024)
  (want-race-sound! info)
  (race-vehicle-entity-hack)
  (set! (-> self race-state) *race-state*)
  (set! (-> self race-state info) info)
  (set! (-> self race-state flags) (race-flags))
  (set! (-> info manager) (process->handle self))
  (set! (-> self finish-sound-id) (new 'static 'sound-id))
  (if preload?
      (logior! (-> self race-state flags) (race-flags sleep))
      )
  (go-virtual idle)
  (none)
  )

(defun race-start-from-info ((info race-info) (parent process) (preload? symbol))
  (cond
    ((not info)
     (format 0 "race-start-from-info: cannot start a null race-info~%")
     (the-as race-manager #f)
     )
    (else
      (let ((existing-manager (the-as race-manager (handle->process (-> info manager)))))
        (cond
          (existing-manager existing-manager)
          (else
            (when (not parent)
              (set! parent (the-as process *entity-pool*))
              )
            (format #t "starting race-manager for task ~d~%" (the int (-> info task-node)))
            (let ((spawn-result (process-spawn race-manager info preload? :to (the-as process-tree parent))))
              (cond
                (spawn-result
                 (let ((manager (-> spawn-result 0)))
                   (format #t "race-manager started~%")
                   manager
                   )
                 )
                (else
                  (format 0 "race-start-from-info: failed to spawn race-manager~%")
                  (the-as race-manager #f)
                  )
                )
              )
            )
          )
        )
      )
    )
  )

(defun race-start ((race-index int) (parent process) (preload? symbol))
  (if (or (< race-index 0) (>= race-index (length *race-info-array*)))
    (begin
     (format 0 "race-start: invalid race-info index ~d; array length is ~d~%" race-index (length *race-info-array*))
     (the-as race-manager #f)
     )
    (race-start-from-info
      (-> *race-info-array* race-index)
      parent
      preload?)
    )
  )

(defun race-start-by-task-node ((task-node game-task-node) (parent process) (preload? symbol))
  (let ((info (find-race-info-by-task-node task-node)))
    (if (and info (nonzero? info))
      (race-start-from-info info parent preload?)
      (begin
        (format
          0
          "race-start-by-task-node: no race-info found for task node ~d~%"
          (the int task-node))
        (the-as race-manager #f)
        )
      )
    )
  )

(defun race-kill ()
  (kill-by-type race-manager *active-pool*)
  (none)
  )

(defun type-from-race-vehicle-type ((vehicle-type uint))
  (cond
    ((zero? vehicle-type) race-bike-a)
    ((= vehicle-type 1) race-bike-b)
    ((= vehicle-type 2) race-bike-c)
    ((= vehicle-type 3) race-bike-d)
    ((= vehicle-type 4) race-bike-e)
    (else bikea)))

(defun race-vehicle-entity-hack ()
  (with-pp
    (process-entity-set! pp *race-vehicle-entity*)
    (none)))

(defun race-level-activate ((level level))
  (format 0 "race-level-activate~%")
  (cond
    ((> (-> level entity length) 0)
     (set! *race-vehicle-entity* (the-as entity-actor (-> level entity data 0 entity)))
     )
    (else
      (dotimes (i 10)
        (format 0 "ERROR: race-level-startup: level ~s has no entities!!~%" (-> level name))
        )
      (set! *race-vehicle-entity* #f)
      )
    )
  (none)
  )

(defun race-level-deactivate ()
  (set! *race-vehicle-entity* #f)
  (none)
  )
