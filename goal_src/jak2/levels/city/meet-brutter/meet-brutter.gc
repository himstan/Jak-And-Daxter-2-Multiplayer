(defun save-lurkers-pick-pipe! ((lurker city-lurker))
  (let ((best (the-as float #x7f800000)))
    (dotimes (index (-> *city-save-lurkers-pipe-info* length))
      (let* ((pipe (-> *city-save-lurkers-pipe-info* index))
             (dist (vector-vector-xz-distance (-> pipe end-pos) (-> lurker root trans))))
        (when (< dist best)
          (set! best dist)
          (set! (-> lurker pipe-name) (-> pipe pipe-name))
          (set! (-> lurker end-pos quad) (-> pipe end-pos quad))))))
  (none))

(defun save-lurkers-update-pipes! ((task task-manager))
  (let ((destination (the-as vector #f)))
    (dotimes (index (-> task max-count))
      (let ((lurker (the-as city-lurker (handle->process (-> task slave index)))))
        (when (and lurker
                   (!= (-> task data-int32 index) -1)
                   (not (-> lurker task-done?))
                   (handle->process (-> lurker vehicle)))
          (save-lurkers-pick-pipe! lurker)
          (if (logtest? *passenger-local-carried* (ash 1 index))
              (set! destination (-> lurker end-pos))))))
    (task-show-destination! task destination))
  (none))

(defun save-lurkers-try-drop! ((task task-manager) (lurker city-lurker) (veh vehicle))
  (when (lurker-at-dropoff? veh (-> lurker end-pos) 40960.0)
    (set! (-> lurker task-done?) #t)
    (send-event lurker 'exit-vehicle (-> lurker end-pos)))
  (none))

(defun save-lurkers-all-inactive? ((task task-manager))
  (let ((inactive 0))
    (dotimes (index (-> task max-count))
      (let ((lurker (handle->process (-> task slave index))))
        (if (and lurker (-> lurker next-state) (= (-> lurker next-state name) 'inactive))
            (+! inactive 1))))
    (= inactive (-> task max-count))))

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_INIT_HOOK
  (lambda :behavior task-manager
    ()
    (set! (-> self begin-pos quad) (-> (new 'static 'vector :x 4698112.0 :y 40960.0 :z 81920.0 :w 1.0) quad))
    (set-setting! 'minimap 'clear 0.0 (minimap-flag task-graph))
    (dotimes (v1-3 8)
      (set! (-> self minimap v1-3) #f)
      )
    (dotimes (v1-8 4)
      (set! (-> self data-vector v1-8 quad) (-> *save-lurkers-position* v1-8 quad))
      )
    (lurker-task-init! self (the uint (game-task-node city-save-lurkers-save-lurkers)) 6)
    (countdown (index (-> self max-count))
      (let ((info (-> *city-save-lurkers-vehicle-info* index)))
        (lurker-task-spawn! self
                            (game-task-node city-save-lurkers-save-lurkers)
                            index
                            (-> info pos)
                            (-> info level)
                            (-> info end-pos)
                            (-> info pipe-name))))
    (set! (-> self arrow) (the-as handle #f))
    (lurker-task-spawned! self)
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_CLEANUP_HOOK
  (lambda :behavior task-manager () (send-event *traffic-manager* 'restore-default-settings) (none))
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_EVENT_HOOK
  (lambda :behavior task-manager
    ((lurker city-lurker) (arg1 object) (message symbol) (block event-message-block))
    (lurker-task-event! self lurker message block (the uint (game-task-node city-save-lurkers-save-lurkers)))
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_UPDATE_HOOK
  (lambda :behavior task-manager
    ()
    (save-lurkers-update-pipes! self)
    (if (lurker-task-update! self (the uint (game-task-node city-save-lurkers-save-lurkers)) save-lurkers-try-drop!)
        (go-virtual complete))
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_CODE_HOOK
  (lambda :behavior task-manager
    ()
    (set! (-> self hud-counter) (ppointer->handle (process-spawn hud-lurker :init hud-init-by-other :to self)))
    (suspend)
    (send-event *traffic-manager* 'set-target-level 0.75)
    (set-time! (-> self state-time))
    (while (not (time-elapsed? (-> self state-time) (seconds 5)))
      (suspend)
      )
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_FAIL_HOOK
  (lambda :behavior task-manager () (none))
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-save-lurkers-save-lurkers)
  TASK_MANAGER_COMPLETE_HOOK
  (lambda :behavior task-manager
    ()
    (set-time! (-> self state-time))
    (until (or (save-lurkers-all-inactive? self) (time-elapsed? (-> self state-time) (seconds 10)))
      (suspend))
    (task-node-close! (game-task-node city-save-lurkers-save-lurkers))
    (none)
    )
  )
