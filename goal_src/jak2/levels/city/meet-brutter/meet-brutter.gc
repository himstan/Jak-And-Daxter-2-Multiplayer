(defconstant LURKER_DELIVERED_MASK (the-as int 19))
(defconstant LURKER_FREED_MASK (the-as int 20))

(defun lurker-delivered? ((task task-manager) (index int))
  (logtest? (-> task data-int32 LURKER_DELIVERED_MASK) (ash 1 index)))

(defun lurker-at-dropoff? ((veh vehicle) (drop-pos vector) (max-speed float))
  (the-as symbol
          (and (nonnull? veh)
               (< (vector-vector-distance-squared drop-pos (-> veh root trans)) (square 114688.0))
               (< (vector-length-squared (-> veh root transv)) (square max-speed)))))

(defun lurker-task-send-state! ((task task-manager) (task-node uint))
  (passenger-mission-send-state! task-node
                                 (the uint (logior (-> task data-int32 LURKER_DELIVERED_MASK)
                                                   (ash (-> task data-int32 LURKER_FREED_MASK) 8)))
                                 (the uint 0)
                                 (the-as time-frame 0)
                                 (the-as time-frame 0)
                                 #f)
  (none))

(defun lurker-task-receive-state! ((task task-manager) (task-node uint) (state passenger-event-data))
  (when (and (nonnull? task state) (= (-> state task-node) task-node))
    (logior! (-> task data-int32 LURKER_DELIVERED_MASK) (logand (-> state progress) #xff))
    (logior! (-> task data-int32 LURKER_FREED_MASK) (ash (-> state progress) -8)))
  (none))

(defun lurker-task-free-from-wagon! ((task task-manager) (index int))
  (when (logtest? (-> task data-int32 LURKER_FREED_MASK) (ash 1 index))
    (let ((wagon (the-as vehicle (handle->process (-> task slave (+ index (-> task max-count)))))))
      (when (and wagon
                 (not (focus-test? wagon inactive))
                 (not (logtest? (-> wagon flags) (rigid-body-object-flag dead))))
        (set! (-> wagon hit-points) 0.0)
        (logior! (-> wagon flags) (rigid-body-object-flag dead)))))
  (none))

(defun lurker-task-note-left-wagon! ((task task-manager) (lurker city-lurker) (index int))
  (when (and (nonnull? task lurker)
             (not (focus-test? lurker inactive))
             (!= (handle->process (-> lurker vehicle)) (handle->process (-> task slave (+ index (-> task max-count))))))
    (let ((block (new 'stack-no-clear 'event-message-block)))
      (set! (-> block from) (process->ppointer lurker))
      (set! (-> block num-params) 0)
      (set! (-> block message) 'on-ground)
      (send-event-function task block)))
  (none))

(defun lurker-icon-wanted? ((task task-manager) (index int))
  (the-as symbol
          (and (handle->process (-> task slave index))
               (not (lurker-delivered? task index))
               (!= (-> task data-int32 index) 1)
               (not (passenger-remote-carrier index)))))

(defun lurker-task-seat-in-wagon! ((wagon vehicle) (lurker city-lurker))
  (let ((seat (get-best-seat-for-vehicle wagon (-> wagon root trans) 4 0)))
    (when (!= seat -1)
      (put-rider-in-seat wagon seat lurker)
      (logior! (-> lurker focus-status) (focus-status pilot-riding))))
  (none))

(defun lurker-task-reactivate! ((proc process-focusable) (object-type traffic-type) (behavior uint) (flags traffic-spawn-flags))
  (let ((params (new 'stack 'traffic-object-spawn-params)))
    (set! (-> params object-type) object-type)
    (set! (-> params behavior) behavior)
    (set! (-> params id) (the-as uint 0))
    (set! (-> params nav-mesh) #f)
    (set! (-> params nav-branch) #f)
    (set! (-> params proc) #f)
    (set! (-> params handle) (process->handle proc))
    (set! (-> params user-data) (the-as uint 0))
    (set! (-> params flags) flags)
    (set! (-> params guard-type) (the-as uint 7))
    (vector-reset! (-> params velocity))
    (set! (-> params position quad) (-> proc root trans quad))
    (quaternion-copy! (-> params rotation) (-> proc root quat))
    (activate-by-handle *traffic-engine* params))
  (none))

(defun lurker-task-init! ((task task-manager) (task-node uint) (count int))
  (set! (-> task start-time) 0)
  (set! (-> task sub-state) (the-as uint 0))
  (set! (-> task max-count) count)
  (set! (-> task count) count)
  (set! (-> task data-int32 LURKER_DELIVERED_MASK) 0)
  (set! (-> task data-int32 LURKER_FREED_MASK) 0)
  (passenger-mission-reset! task-node)
  (none))

(defun lurker-task-spawn! ((task task-manager)
                           (task-node game-task-node)
                           (index int)
                           (pos vector)
                           (level symbol)
                           (end-pos vector)
                           (pipe-name string))
  (let ((spawn (new 'stack-no-clear 'mystery-traffic-object-spawn-params-1)))
    (forward-up-nopitch->quaternion (-> spawn quat) (new 'static 'vector :z 1.0 :w 1.0) (new 'static 'vector :y 1.0 :w 1.0))
    (dotimes (i 2)
      (let ((params (-> spawn params i)))
        (set! (-> params id) (the-as uint 0))
        (set! (-> params nav-mesh) #f)
        (set! (-> params nav-branch) #f)
        (set! (-> params proc) #f)
        (set! (-> params handle) (the-as handle #f))
        (set! (-> params user-data) (the-as uint 0))
        (set! (-> params guard-type) (the-as uint 7))
        (vector-reset! (-> params velocity))
        (set! (-> params position quad) (-> pos quad))
        (quaternion-copy! (-> params rotation) (-> spawn quat))))
    (set! (-> spawn params 0 object-type) (traffic-type tt17))
    (set! (-> spawn params 0 behavior) (the-as uint 1))
    (set! (-> spawn params 0 id) (the-as uint (+ index 120)))
    (set! (-> spawn params 0 flags) (traffic-spawn-flags spawn-rider))
    (set! (-> spawn params 0 net-id) (+ MP_MISSION_VEHICLE_LURKER_WAGON_BASE (the uint index)))
    (set! (-> spawn params 1 object-type) (traffic-type tt5))
    (set! (-> spawn params 1 behavior) (the-as uint (if pipe-name 8 0)))
    (set! (-> spawn params 1 flags) (traffic-spawn-flags skip-lwide-entity-hack))
    (set! (-> spawn params 1 net-id) (passenger-net-id (the uint task-node) (the uint index)))
    (let ((wagon (the-as paddywagon (vehicle-spawn *traffic-manager* paddywagon (-> spawn params 0)))))
      (when wagon
        (set! (-> wagon current-level) level)
        (set! (-> task slave (+ index (-> task max-count))) (process->handle wagon))
        (send-event *traffic-manager* 'add-object (traffic-type tt17) wagon)
        (let ((lurker (the-as city-lurker (citizen-spawn task city-lurker (-> spawn params 1)))))
          (when lurker
            (set! (-> lurker net-id) (-> spawn params 1 net-id))
            (set! (-> lurker jump-in-pipe?) (if pipe-name #t #f))
            (set! (-> lurker pipe-name) pipe-name)
            (set! (-> lurker end-pos quad) (-> end-pos quad))
            (set! (-> lurker task-node) task-node)
            (set! (-> lurker index) (the-as uint index))
            (set! (-> lurker nav-mesh-aid) (the-as uint 0))
            (set! (-> task slave index) (process->handle lurker))
            (set! (-> task data-int32 index) -1)
            (change-parent lurker wagon)
            (logior! (-> lurker flags) (citizen-flag persistent))
            (send-event *traffic-manager* 'add-object (traffic-type tt5) lurker)
            (set! (-> lurker controller traffic) *traffic-engine*)
            (set! (-> lurker vehicle) (process->handle wagon))
            (lurker-task-seat-in-wagon! wagon lurker))))))
  (none))

(defun lurker-task-spawned! ((task task-manager))
  (send-event *traffic-manager* 'set-object-target-count (traffic-type tt17) 0)
  (send-event *traffic-manager* 'set-object-target-count (traffic-type tt5) 0)
  (set! (-> *game-info* counter) (the float (-> task count)))
  (change-parent task *traffic-manager*)
  (none))

(defun lurker-task-event! ((task task-manager) (lurker city-lurker) (message symbol) (block event-message-block) (task-node uint))
  (case message
    (('passenger-state)
     (lurker-task-receive-state! task task-node (the-as passenger-event-data (-> block param 0)))
     #f)
    (('task-done)
     (set! (-> task data-int32 (-> lurker index)) 2)
     #f)
    (('on-ground)
     (let ((freed? (= (-> task data-int32 (-> lurker index)) -1)))
       (if freed?
           (set! (-> task data-int32 (-> lurker index)) 0))
       (change-parent lurker task)
       freed?))
    (else #f)))

(defun lurker-task-count-delivered! ((task task-manager))
  (let ((delivered 0))
    (dotimes (index (-> task max-count))
      (let ((lurker (the-as city-lurker (handle->process (-> task slave index)))))
        (if (and lurker (-> lurker task-done?))
            (logior! (-> task data-int32 LURKER_DELIVERED_MASK) (ash 1 index)))
        (if (>= (-> task data-int32 index) 0)
            (logior! (-> task data-int32 LURKER_FREED_MASK) (ash 1 index)))
        (when (lurker-delivered? task index)
          (if lurker
              (set! (-> lurker task-done?) #t))
          (+! delivered 1)
          (set! (-> task data-int32 index) 3))))
    (set! (-> task count) (- (-> task max-count) delivered))
    (set! (-> *game-info* counter) (the float (-> task count)))
    delivered))

(defun lurker-task-keep-wagons-active! ((task task-manager))
  (dotimes (index (-> task max-count))
    (let ((wagon (the-as paddywagon (handle->process (-> task slave (+ index (-> task max-count)))))))
      (when (and wagon (not (focus-test? wagon dead)))
        (cond
          ((or (not (-> wagon current-level)) (= (level-status *level* (-> wagon current-level)) 'active))
           (when (focus-test? wagon inactive)
             (lurker-task-reactivate! wagon (traffic-type tt17) (the-as uint 2) (traffic-spawn-flags spawn-rider))
             (mp-mission-vehicle-assign-net-id! wagon (+ MP_MISSION_VEHICLE_LURKER_WAGON_BASE (the uint index)))
             (let ((lurker (the-as city-lurker (handle->process (-> task slave index)))))
               (if lurker
                   (lurker-task-seat-in-wagon! wagon lurker)))))
          ((not (focus-test? wagon inactive))
           (send-event wagon 'traffic-off-force))))))
  (none))

(defun lurker-use-nav-mesh! ((lurker city-lurker))
  (let ((mesh (as-type (entity-nav-mesh-by-aid (the-as actor-id (-> lurker nav-mesh-aid))) entity-nav-mesh)))
    (when (and mesh (!= (-> lurker nav state mesh) (-> mesh nav-mesh)))
      (when (nonzero? (-> lurker nav state mesh))
        (remove-process-drawable (-> lurker nav state mesh) lurker)
        (set! (-> lurker nav) #f))
      (change-to (-> mesh nav-mesh) lurker)))
  (none))

(defun lurker-task-update-riding! ((task task-manager) (lurker city-lurker) (index int) (try-drop! (function task-manager city-lurker vehicle none)))
  (let ((veh (the-as vehicle (handle->process (-> lurker vehicle)))))
    (cond
      ((not (focus-test? lurker pilot))
       (set! (-> task data-int32 index) 0))
      ((not (vehicle-driver-seat-has-player? veh))
       (send-event lurker 'exit-vehicle (-> lurker root trans)))
      ((passenger-carried-locally? lurker)
       (try-drop! task lurker veh))))
  (none))

(defun lurker-task-update-lurkers! ((task task-manager) (task-node uint) (try-drop! (function task-manager city-lurker vehicle none)))
  (let ((boarding? #f))
    (dotimes (index (-> task max-count))
      (if (= (-> task data-int32 index) 1)
          (set! boarding? #t)))
    (dotimes (index (-> task max-count))
      (let ((lurker (the-as city-lurker (handle->process (-> task slave index))))
            (state (-> task data-int32 index)))
        (when lurker
          (cond
            ((passenger-follow-carrier! task lurker index)
             (if (= state -1)
                 (lurker-task-note-left-wagon! task lurker index)))
            ((= state -1)
             (when (focus-test? lurker inactive)
               (lurker-task-reactivate! lurker (traffic-type tt5) (the-as uint 6) (traffic-spawn-flags))
               (set! (-> lurker net-id) (passenger-net-id task-node (the uint index))))
             (lurker-task-free-from-wagon! task index))
            ((zero? state)
             (lurker-use-nav-mesh! lurker)
             (cond
               ((and (focus-test? lurker pilot) (handle->process (-> lurker vehicle)))
                (+! (-> task data-int32 index) 1))
               ((not boarding?)
                (let ((veh (passenger-boardable-vehicle (-> lurker root trans))))
                  (when veh
                    (set! boarding? #t)
                    (send-event lurker 'board-vehicle veh))))))
            ((= state 1)
             (lurker-task-update-riding! task lurker index try-drop!))
            ((= state 2)
             (let ((mesh (as-type (entity-nav-mesh-by-aid (the-as actor-id (-> lurker nav-mesh-aid))) entity-nav-mesh)))
               (if mesh
                   (change-to (-> mesh nav-mesh) lurker)))))))))
  (none))

(defun lurker-task-update! ((task task-manager) (task-node uint) (try-drop! (function task-manager city-lurker vehicle none)))
  (check-time task)
  (let ((delivered (lurker-task-count-delivered! task)))
    (lurker-task-send-state! task task-node)
    (lurker-task-keep-wagons-active! task)
    (lurker-task-update-lurkers! task task-node try-drop!)
    (dotimes (index (-> task max-count))
      (task-update-icon! task
                         index
                         (lurker-icon-wanted? task index)
                         (handle->process (-> task slave index))
                         (the-as uint 15)
                         (the-as vector #t)))
    (= delivered (-> task max-count))))

(defun meet-brutter-talk! ((task task-manager) (counter int) (first-speech int))
  (let ((said (-> task data-int32 counter)))
    (if (< said 3)
        (talker-spawn-func (-> *talker-speech* (+ first-speech (* 2 said))) *entity-pool* (target-pos 0) (the-as region #f))))
  (+! (-> task data-int32 counter) 1)
  (none))

(defun meet-brutter-try-drop! ((task task-manager) (lurker city-lurker) (veh vehicle))
  (when (lurker-at-dropoff? veh (-> task data-vector 3) 421888.0)
    (set! (-> lurker task-done?) #t)
    (send-event lurker 'exit-vehicle (-> task data-vector 3))
    (meet-brutter-talk! task 17 380))
  (none))

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_INIT_HOOK
  (lambda :behavior task-manager
    ()
    (set-setting! 'allow-continue #f 0.0 0)
    (set-continue! *game-info* "ctyport-hiphog-no-hiphog" #f)
    (set! (-> self begin-pos quad) (-> (new 'static 'vector :x 4698112.0 :y 40960.0 :z 81920.0 :w 1.0) quad))
    (set-setting! 'exclusive-task #f 0.0 (-> self node-info task))
    (let ((s5-0 *traffic-manager*)
          (gp-0 (new 'stack 'traffic-object-spawn-params))
          )
      (set! (-> gp-0 position quad) (-> self begin-pos quad))
      (quaternion-axis-angle! (-> gp-0 rotation) 0.0 1.0 0.0 0.0)
      (set! (-> gp-0 object-type) (traffic-type cara))
      (set! (-> gp-0 behavior) (the-as uint 0))
      (set! (-> gp-0 id) (the-as uint 0))
      (set! (-> gp-0 proc) #f)
      (send-event s5-0 'spawn-object gp-0)
      (if (not (-> gp-0 proc))
          (format #t "traffic object spawn failed~%")
          )
      )
    (dotimes (v1-20 4)
      (set! (-> self data-vector v1-20 quad) (-> *meet-brutter-position* v1-20 quad))
      )
    (lurker-task-init! self (the uint (game-task-node city-meet-brutter-meet-brutter)) 3)
    (countdown (index (-> self max-count))
      (let ((info (-> *city-meet-brutter-vehicle-info* index)))
        (lurker-task-spawn! self
                            (game-task-node city-meet-brutter-meet-brutter)
                            index
                            (-> info pos)
                            (-> info level)
                            (-> info end-pos)
                            (the-as string #f))))
    (set! (-> self data-int32 16) 0)
    (set! (-> self data-int32 17) (rand-vu-int-count 4))
    (set! (-> self data-int32 18) (rand-vu-int-count 4))
    (lurker-task-spawned! self)
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_CLEANUP_HOOK
  (lambda :behavior task-manager () (send-event *traffic-manager* 'restore-default-settings) (none))
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_EVENT_HOOK
  (lambda :behavior task-manager
    ((lurker city-lurker) (arg1 object) (message symbol) (block event-message-block))
    (when (lurker-task-event! self lurker message block (the uint (game-task-node city-meet-brutter-meet-brutter)))
      (meet-brutter-talk! self 16 379)
      (set! (-> self beep-time) (+ (current-time) (rand-vu-int-range (seconds 10) (seconds 20)))))
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_UPDATE_HOOK
  (lambda :behavior task-manager
    ()
    (task-update-icon! self 3 (nonzero? *passenger-local-carried*) self (the-as uint 19) (the-as vector #f))
    (if (lurker-task-update! self (the uint (game-task-node city-meet-brutter-meet-brutter)) meet-brutter-try-drop!)
        (go-virtual complete))
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_CODE_HOOK
  (lambda :behavior task-manager
    ()
    (set! (-> self hud-counter) (ppointer->handle (process-spawn hud-lurker :init hud-init-by-other :to self)))
    (suspend)
    (send-event *traffic-manager* 'set-target-level 0.75)
    (set-time! (-> self state-time))
    (while (not (time-elapsed? (-> self state-time) (seconds 5)))
      (suspend)
      )
    (none)
    )
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_FAIL_HOOK
  (lambda :behavior task-manager () (none))
  )

(set-subtask-hook!
  *game-info*
  (game-task-node city-meet-brutter-meet-brutter)
  TASK_MANAGER_COMPLETE_HOOK
  (lambda :behavior task-manager
    ()
    (send-event *traffic-manager* 'decrease-alert-level 0)
    (send-event *traffic-manager* 'set-alert-duration (seconds 30))
    (send-event *target* 'end-mode)
    (set-time! (-> self state-time))
    (while (not (time-elapsed? (-> self state-time) (seconds 2)))
      (suspend)
      )
    (task-node-close! (game-task-node city-meet-brutter-meet-brutter))
    (none)
    )
  )

