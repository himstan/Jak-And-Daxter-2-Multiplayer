  :code (behavior ()
    (hoverboard-training-manager-set-notify! self)
    (until #f
      (let ((gp-0
              (ppointer->handle
                (judge-spawn self (new 'static 'vector :x 190382.08 :y -47063.04 :z -2148475.0 :w 1.0) (the-as uint 10))
                )
