;;-*-Lisp-*-
(in-package goal)

;; name: skatea-obs.gc
;; name in dgo: skatea-obs
;; dgos: SKA

;; DECOMP BEGINS

(defconstant STADIUM_BOARD1_GAME_SCORE_ID 10)
(defconstant STADIUM_BOARD1_TASK_BRONZE_ID 69)
(defconstant STADIUM_BOARD1_TASK_SILVER_ID 70)
(defconstant STADIUM_BOARD1_TASK_GOLD_ID 71)
(defconstant STADIUM_BOARD1_TRAINING_GOAL 15000.0)

(deftype stadium-hud-multi-score (hud)
  ()
  )

(defconstant STADIUM_BOARD1_INACTIVE_SCORE -1)

(deftype stadium-board1-state (structure)
  ((scores                  int32 MP_MAX_PLAYERS)
   (finished-mask           uint32)
   (pending-start-player-id uint32)
   )
  )

(deftype hoverboard-training-manager (process)
  ((actor-group           (pointer actor-group))
   (stadium-state         stadium-board1-state :inline)
   (result-display-until  time-frame)
   (trick-type            board-tricks)
   (board-picked-up       symbol)
   (boost                 symbol)
   (grind                 symbol)
   (text                  symbol)
   (challenge-done        symbol)
   (arrow                 handle)
   (hud-score             handle)
   (hud-goal              handle)
   (voicebox              handle)
   (last-sound-id         sound-id)
   (combo-done?           symbol)
   (training?             symbol)
   (egg-count             int32)
   (medal                 int32)
   (gui-id                sound-id)
   (hint-time             time-frame)
   (judge-activated?      symbol)
   )
  (:state-methods
    wait-for-pickup
    wait-for-pickup-training
    wait-for-board
    wait
    jump
    duck-jump
    boost-jump
    grind
    spin
    flip
    trick
    game
    idle
    idle-training
    )
  (:methods
    (render-text (_type_ text-id) float)
    (hoverboard-training-manager-update-goal-hud! (_type_) none)
    (hoverboard-training-manager-award-score-medals! (_type_) none)
    )
  )


(defun get-hoverboard-training-manager ()
  (let ((manager (process-by-type-exact 'hoverboard-training-manager *active-pool*)))
    (if (and manager (nonzero? manager))
        (the-as hoverboard-training-manager manager)
        (the-as hoverboard-training-manager #f)))
  )

(defun get-hoverboard-training-manager-state ()
  (let ((manager (get-hoverboard-training-manager)))
    (if manager
        (-> manager stadium-state)
        (the-as stadium-board1-state #f)))
  )

(defun stadium-board1-valid-player-index? ((player-index int))
  (and (>= player-index 0)
       (< player-index MP_MAX_PLAYERS))
  )

(defun stadium-board1-player-bit ((player-index int))
  (the-as uint32 (ash 1 player-index))
  )

(defun stadium-board1-player-participant? ((record mp-player-record))
  (and record
       (nonzero? record)
       (nonzero? (-> record identity joined?))
       (zero? (-> record identity spectator-only?)))
  )

(defun stadium-board1-record-by-id ((player-id uint))
  (let ((player-index (the-as int player-id)))
    (if (stadium-board1-valid-player-index? player-index)
        (mp-player-record-by-id player-id)
        (the-as mp-player-record #f)))
  )

(defun stadium-board1-round-participant? ((state stadium-board1-state) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (and state
         (nonzero? state)
         (stadium-board1-valid-player-index? player-index)
         (> (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE)))
  )

(defun stadium-board1-player-finished? ((state stadium-board1-state) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (and state
         (nonzero? state)
         (stadium-board1-valid-player-index? player-index)
         (logtest? (-> state finished-mask) (stadium-board1-player-bit player-index))))
  )

(defun stadium-board1-clear-player-finished! ((state stadium-board1-state) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (when (and state
               (nonzero? state)
               (stadium-board1-valid-player-index? player-index))
      (logclear! (-> state finished-mask) (stadium-board1-player-bit player-index))))
  (none)
  )

(defun stadium-board1-set-player-finished! ((state stadium-board1-state) (player-id uint))
  (let ((player-index (the-as int player-id)))
    (when (and state
               (nonzero? state)
               (stadium-board1-valid-player-index? player-index))
      (logior! (-> state finished-mask) (stadium-board1-player-bit player-index))))
  (none)
  )

(defun stadium-board1-reset-round! ((state stadium-board1-state))
  (when (and state (nonzero? state))
    (dotimes (player-index MP_MAX_PLAYERS)
      (set! (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE))
    (set! (-> state finished-mask) (the uint 0))
    (set! (-> state pending-start-player-id) MP_INVALID_PLAYER_ID))
  (let ((manager (get-hoverboard-training-manager)))
    (when manager
      (set! (-> manager result-display-until) (the-as time-frame 0))))
  (none)
  )

(defun stadium-board1-add-participant! ((player-id uint))
  (debug-log *mp-debug-log?* "[Skate] Attempting to add participant: ~D to the hoverboard manager.~%" player-id)
  (let ((player-index (the-as int player-id))
        (state (get-hoverboard-training-manager-state)))
    (when (and state
               (nonzero? state)
               (stadium-board1-valid-player-index? player-index)
               (stadium-board1-player-participant? (stadium-board1-record-by-id player-id))
               (= (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE))
      (debug-log *mp-debug-log?* "[Skate] Participant: ~D has been added to the hoverboard manager.~%" player-id)
      (set! (-> state scores player-index) 0)))
  (none)
  )

(defun stadium-board1-snapshot-round! ((state stadium-board1-state))
  (when (and state (nonzero? state))
    (stadium-board1-reset-round! state)
    (mp-for-each-player-record (player-id record)
      (when (stadium-board1-player-participant? record)
        (let ((player-index (the-as int player-id)))
          (when (stadium-board1-valid-player-index? player-index)
            (set! (-> state scores player-index) 0))))))
  (none)
  )

(defun stadium-board1-has-round-participants? ((state stadium-board1-state))
  (when (and state (nonzero? state))
    (dotimes (player-index MP_MAX_PLAYERS)
      (when (!= (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE)
        (return #t))))
  #f
  )

(defun stadium-board1-local-flag? ((flag mp-player-mission-flags))
  (mp-player-mission-flag? (mp-local-player-record) flag)
  )

(defun stadium-board1-reset-player! ((record mp-player-record))
  (when (and record (nonzero? record))
    (mp-player-mission-clear-flag! record (mp-player-mission-flags stadium-board1-tutorial-done))
    (mp-player-mission-clear-flag! record (mp-player-mission-flags stadium-board1-tutorial-announced)))
  (none)
  )

(defun stadium-board1-send-event! ((evt-id uint) (score int))
  (when (and *multi-sync-enabled?*
             (= (pc-multi-get-status) (mp-connection-status in-game))
             (not *mp-processing-remote-event*))
    (let ((local-record (mp-local-player-record)))
      (when (and local-record (nonzero? local-record))
        (mp-event-enqueue-stadium-board! evt-id (-> local-record identity player-id) score))))
  (none)
  )

(defun stadium-board1-reset ()
  (mp-for-each-player-record (player-id record)
    (stadium-board1-reset-player! record))
  (let ((state (get-hoverboard-training-manager-state)))
    (when state
      (stadium-board1-reset-round! state)))
  (none)
  )

(defun stadium-board1-broadcast-tutorial-done! ()
  (let ((local-record (mp-local-player-record)))
    (when (and local-record
               (nonzero? local-record)
               (mp-player-mission-flag? local-record (mp-player-mission-flags stadium-board1-tutorial-done))
               (not (mp-player-mission-flag? local-record (mp-player-mission-flags stadium-board1-tutorial-announced))))
      (mp-player-mission-set-flag! local-record (mp-player-mission-flags stadium-board1-tutorial-announced))
      (debug-log *mp-debug-log?* "[Skate] Local player completed the tutorial. Broadcasting to all peers...~%")
      (stadium-board1-send-event! MP_EVENT_MISSION_STADIUM_BOARD1_TUTORIAL_DONE 0)))
  (none)
  )

(defun stadium-board1-all-tutorials-done? ()
  (let ((found-player? #f))
    (mp-for-each-player-record (player-id record)
      (when (stadium-board1-player-participant? record)
        (set! found-player? #t)
        (when (not (mp-player-mission-flag? record (mp-player-mission-flags stadium-board1-tutorial-done)))
          (return #f))))
    found-player?)
  )

(defun stadium-board1-tutorials-ready? ()
  (if *multi-sync-enabled?*
      (stadium-board1-all-tutorials-done?)
      (not (task-node-open? (game-task-node stadium-board1-training))))
  )

(defun stadium-board1-waiting-for-players? ()
  (and (stadium-board1-local-flag? (mp-player-mission-flags stadium-board1-tutorial-done))
       (not (stadium-board1-all-tutorials-done?)))
  )

(defun stadium-board1-mark-tutorial-done! ()
  (let ((local-record (mp-local-player-record)))
    (when (and local-record (nonzero? local-record))
      (mp-player-mission-set-flag! local-record (mp-player-mission-flags stadium-board1-tutorial-done))
      (debug-log *mp-debug-log?* "[Skate] Local player completed the tutorial.~%")
      (stadium-board1-broadcast-tutorial-done!)))
  (none)
  )

(defun stadium-board1-receive-tutorial-done! ((player-id uint))
  (let ((record (stadium-board1-record-by-id player-id)))
    (when (and record (nonzero? record))
      (mp-player-mission-set-flag! record (mp-player-mission-flags stadium-board1-tutorial-done))
      (debug-log *mp-debug-log?* "[Skate] Player ~D completed the tutorial.~%" player-id)))
  (none)
  )

(defun stadium-board1-current-local-score ()
  (if (and *game-info* (nonzero? *game-info*))
      (the int (-> *game-info* score))
      0)
  )

(defun stadium-board1-local-finished? ()
  (let ((state (get-hoverboard-training-manager-state))
        (player-id (mp-local-player-id)))
    (and state
         (nonzero? state)
         (stadium-board1-round-participant? state player-id)
         (stadium-board1-player-finished? state player-id)))
  )

(defun stadium-board1-challenge-active? ()
  (let ((manager (get-hoverboard-training-manager)))
    (and manager
         (nonzero? manager)
         (not (-> manager challenge-done))))
  )

(defun stadium-board1-all-players-finished? ()
  (let ((state (get-hoverboard-training-manager-state))
        (found-player? #f))
    (when (and state (nonzero? state))
      (dotimes (player-index MP_MAX_PLAYERS)
        (when (!= (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE)
          (set! found-player? #t)
          (when (not (stadium-board1-player-finished? state (the-as uint player-index)))
            (let ((record (stadium-board1-record-by-id (the-as uint player-index))))
              (when (stadium-board1-player-participant? record)
                (return #f)))))))
    found-player?)
  )

(defun stadium-board1-round-active? ()
  (let ((state (get-hoverboard-training-manager-state)))
    (and state
         (nonzero? state)
         (stadium-board1-has-round-participants? state)
         (not (stadium-board1-all-players-finished?))))
  )

(defun stadium-board1-start-challenge! ((send-event? symbol))
  (let ((manager (get-hoverboard-training-manager))
        (state (get-hoverboard-training-manager-state))
        (local-record (mp-local-player-record)))
    (when (and manager
               state
               (nonzero? state)
               local-record
               (nonzero? local-record))
      (when (not (stadium-board1-round-active?))
        (stadium-board1-snapshot-round! state))
      (let ((player-id (-> local-record identity player-id)))
        (stadium-board1-add-participant! player-id)
        (stadium-board1-clear-player-finished! state player-id)
        (set! (-> state pending-start-player-id) MP_INVALID_PLAYER_ID))
      (set! (-> manager challenge-done) #f)
      (set! (-> manager judge-activated?) #t)
      (when send-event?
        (debug-log *mp-debug-log?* "[Skate] Broadcasting challenge start.~%")
        (stadium-board1-send-event! MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_START 0))))
  (none)
  )

(defun stadium-board1-receive-start! ((player-id uint))
  (let ((manager (get-hoverboard-training-manager))
        (state (get-hoverboard-training-manager-state))
        (source-record (stadium-board1-record-by-id player-id)))
    (when (and manager
               state
               (nonzero? state)
               (stadium-board1-player-participant? source-record))
      (when (not (stadium-board1-has-round-participants? state))
        (stadium-board1-snapshot-round! state))
      (stadium-board1-add-participant! player-id)
      (debug-log *mp-debug-log?* "[Skate] Attempting to set pending start player id to: ~D~%" player-id)
      (when (not (stadium-board1-challenge-active?))
        (debug-log *mp-debug-log?* "[Skate] Setting pending start player id to: ~D~%" player-id)
        (set! (-> state pending-start-player-id) player-id)
        )
      )
    )
  (none)
  )

(defun stadium-board1-deliver-pending-start! ((judge-handle handle))
  "Deliver a queued remote start once the tutorial manager has a waiting judge."
  (let ((state (get-hoverboard-training-manager-state)))
    (when (and state
               (nonzero? state)
               (!= (-> state pending-start-player-id) MP_INVALID_PLAYER_ID))
      (let ((source-record (stadium-board1-record-by-id (-> state pending-start-player-id)))
            (judge-proc (handle->process-safe judge-handle)))
        (when (and source-record
                   (nonzero? source-record)
                   judge-proc
                   (nonzero? judge-proc))
          (debug-log *mp-debug-log?* "[Skate] Delivering pending challenge start to judge ~A.~%" judge-handle)
          (set! (-> state pending-start-player-id) MP_INVALID_PLAYER_ID)
          (set! (-> (get-hoverboard-training-manager) judge-activated?) #t)
          (send-event judge-proc 'mp-start source-record)))))
  (none)
  )

(defun stadium-board1-player-score ((player-id uint))
  (let ((state (get-hoverboard-training-manager-state))
        (player-index (the-as int player-id)))
    (if (and state
             (nonzero? state)
             (stadium-board1-valid-player-index? player-index)
             (!= (-> state scores player-index) STADIUM_BOARD1_INACTIVE_SCORE))
        (the int (-> state scores player-index))
        0))
  )

(defun stadium-board1-effective-score ()
  (let ((best-score (stadium-board1-current-local-score))
        (state (get-hoverboard-training-manager-state)))
    (when (and *multi-sync-enabled?* state (nonzero? state))
      (dotimes (player-index MP_MAX_PLAYERS)
        (let ((score (-> state scores player-index)))
          (when (and (!= score STADIUM_BOARD1_INACTIVE_SCORE)
                     (> score best-score))
            (set! best-score score)))))
    best-score)
  )

(defun stadium-board1-send-score! ((score int) (force? symbol))
  (let ((state (get-hoverboard-training-manager-state))
        (local-record (mp-local-player-record)))
    (when (and state
               (nonzero? state)
               local-record
               (nonzero? local-record))
      (let* ((player-id (-> local-record identity player-id))
             (player-index (the-as int player-id)))
        (when (and (stadium-board1-valid-player-index? player-index)
                   (stadium-board1-round-participant? state player-id))
          (let ((previous-score (the int (-> state scores player-index))))
            (when (and *multi-sync-enabled?*
                       (= (pc-multi-get-status) (mp-connection-status in-game))
                       (or force? (!= score previous-score)))
              (set! (-> state scores player-index) score)
              (stadium-board1-send-event! MP_EVENT_MISSION_STADIUM_BOARD1_SCORE_UPDATE score)))))))
  (none)
  )

(defun stadium-board1-receive-score! ((player-id uint) (score int))
  (let ((state (get-hoverboard-training-manager-state))
        (player-index (the-as int player-id)))
    (when (and state
               (nonzero? state)
               (stadium-board1-valid-player-index? player-index)
               (stadium-board1-round-participant? state player-id)
               (not (stadium-board1-player-finished? state player-id)))
      (set! (-> state scores player-index) score)))
  (none)
  )

(defun stadium-board1-begin-result! ()
  (let ((manager (get-hoverboard-training-manager))
        (state (get-hoverboard-training-manager-state)))
    (when (and manager
               state
               (nonzero? state)
               (zero? (-> manager result-display-until))
               (stadium-board1-all-players-finished?))
      (debug-log *mp-debug-log?* "[Skate] Challenge is done.~%")
      (set! (-> manager challenge-done) #t)
      (set! (-> manager result-display-until) (+ (current-time) (seconds 10)))
      (set! (-> state pending-start-player-id) MP_INVALID_PLAYER_ID)))
  (none)
  )

(defun stadium-board1-receive-finish! ((player-id uint) (score int))
  "Apply a remote player's final score to the current round."
  (let ((state (get-hoverboard-training-manager-state))
        (player-index (the-as int player-id)))
    (when (and state
               (nonzero? state)
               (stadium-board1-valid-player-index? player-index)
               (stadium-board1-round-participant? state player-id))
      (set! (-> state scores player-index) score)
      (stadium-board1-set-player-finished! state player-id)
      (debug-log *mp-debug-log?* "[Skate] Player ~D finished with score ~D.~%" player-id score)
      (stadium-board1-begin-result!)
      )
    )
  (none)
  )

(defun stadium-board1-finish-local-challenge! ((send-event? symbol))
  (let ((state (get-hoverboard-training-manager-state))
        (local-record (mp-local-player-record))
        (score (stadium-board1-current-local-score)))
    (when (and state
               (nonzero? state)
               local-record
               (nonzero? local-record))
      (let* ((player-id (-> local-record identity player-id))
             (player-index (the-as int player-id)))
        (when (stadium-board1-valid-player-index? player-index)
          (when (not (stadium-board1-has-round-participants? state))
            (stadium-board1-snapshot-round! state))
          (stadium-board1-add-participant! player-id)
          (when (stadium-board1-challenge-active?)
            (stadium-board1-send-score! score #t))
          (set! (-> state scores player-index) score)
          (stadium-board1-set-player-finished! state player-id)
          (when send-event?
            (stadium-board1-send-event! MP_EVENT_MISSION_STADIUM_BOARD1_CHALLENGE_END score))))))
  (none)
  )

(defun stadium-board1-post-challenge-finished! ((send-event? symbol))
  (when (not (stadium-board1-local-finished?))
    (stadium-board1-finish-local-challenge! send-event?))
  (let ((state (get-hoverboard-training-manager-state)))
    (when state
      (set! (-> state pending-start-player-id) MP_INVALID_PLAYER_ID)))
  (stadium-board1-begin-result!)
  (none)
  )

(defun stadium-board1-update! ((local-challenge-active? symbol))
  (when local-challenge-active?
    (stadium-board1-send-score! (stadium-board1-current-local-score) #f))
  (when (stadium-board1-has-round-participants? (get-hoverboard-training-manager-state))
    (stadium-board1-begin-result!))
  (none)
  )

(defun stadium-board1-render-waiting-text ()
  (when (stadium-board1-waiting-for-players?)
    (let ((ctx (new 'stack 'font-context *font-default-matrix* 32 280 0.0 (font-color default) (font-flags shadow kerning large))))
      (set-width! ctx 520)
      (set-height! ctx 80)
      (set-scale! ctx 0.5)
      (print-game-text (lookup-text! *common-text* (text-id stadium-waiting-for-other-player) #f) ctx #f 44 (bucket-id progress))))
  (none)
  )

(defun stadium-board1-winner-player ()
  "Return the highest-scoring player from the current round snapshot."
  (let ((best-player (the-as mp-player-record #f))
        (best-score STADIUM_BOARD1_INACTIVE_SCORE)
        (state (get-hoverboard-training-manager-state)))
    (when (and state (nonzero? state))
      (mp-for-each-player-record (player-id record)
        (let ((score (-> state scores player-id)))
          (when (and (!= score STADIUM_BOARD1_INACTIVE_SCORE)
                     (> score best-score))
            (set! best-score score)
            (set! best-player record)))))
    best-player)
  )

(defun stadium-board1-render-result-text ()
  (when (stadium-board1-local-finished?)
    (stadium-board1-begin-result!))
  (let ((manager (get-hoverboard-training-manager))
        (state (get-hoverboard-training-manager-state)))
    (when (and manager state (nonzero? state) (nonzero? (-> manager result-display-until)))
      (if (< (current-time) (-> manager result-display-until))
          (let ((winner (stadium-board1-winner-player))
                (popup-text (new 'global 'string 64 (the-as string #f)))
                (player-name (new 'global 'string 64 (the-as string #f)))
                (ctx (new 'stack 'font-context *font-default-matrix* 32 240 0.0 (font-color default) (font-flags shadow kerning large))))
            (when (and winner (nonzero? winner))
              (set-width! ctx 520)
              (set-height! ctx 80)
              (set-scale! ctx 0.75)
              (format (clear popup-text)
                      (lookup-text! *common-text* (text-id stadium-player-won) #f)
                      (mp-player-copy-name! player-name (-> winner identity player-id)))
              (print-game-text popup-text ctx #f 44 (bucket-id progress))))
          (stadium-board1-reset-round! state))))
  (none)
  )

(defun stadium-board1-init-score-hud! ((hud stadium-hud-multi-score) (player-id int))
  (set! (-> hud sprites player-id tex) (get-texture hud-scoreboard-01 level-default-minimap))
  (set! (-> hud sprites player-id scale-x) 1.5)
  (set! (-> hud sprites player-id flags) (the-as uint 4))
  (alloc-string-if-needed hud player-id)                        
  (set! (-> hud strings player-id scale) 0.5)
  (set! (-> hud strings player-id flags) (font-flags kerning right large))
  (set! (-> hud strings player-id color) (mp-player-font-color-by-id player-id))
  )

(define *stadium-board1-local-score-hud-x* 115)

(define *stadium-board1-local-score-hud-y* 90)

(defun stadium-board1-draw-score-hud! ((hud stadium-hud-multi-score))
  (let ((remote-hud-y 140))
    (mp-for-each-player-record (player-id record)
      (if (= player-id (mp-local-player-id))
        (set-hud-piece-position!
          (-> hud sprites player-id)
          *stadium-board1-local-score-hud-x*
          *stadium-board1-local-score-hud-y*
          )
        (begin
          (set-hud-piece-position!
            (-> hud sprites player-id)
            480
            remote-hud-y
            )
          (+! remote-hud-y 30)
          )
        )
      (format (clear (-> hud strings player-id text)) "~D" (-> hud values player-id current))
      (set-as-offset-from! (the-as hud-sprite (-> hud strings player-id pos)) (the-as vector4w (-> hud sprites player-id)) -12 8)
      )
    )
  )

(defmethod draw ((this stadium-hud-multi-score))
  (stadium-board1-draw-score-hud! this)
  ((method-of-type hud draw) this)
  0
  (none)
  )

(defmethod update-values ((this stadium-hud-multi-score))
  (mp-for-each-player-record (player-id record)
    (set! (-> this values player-id target) (stadium-board1-player-score (the-as uint player-id)))
    )
  ((method-of-type hud update-values) this)
  0
  (none)
  )

(defmethod init-callback ((this stadium-hud-multi-score))
  (set! (-> this gui-id)
        (add-process *gui-control* this (gui-channel hud-center-right) (gui-action hidden) (-> this name) 81920.0 0)
        )
  (logior! (-> this flags) (hud-flags show))
  (dotimes (player-id MP_MAX_PLAYERS)
    (stadium-board1-init-score-hud! this player-id)
    )
  (none)
  )


(defmethod render-text ((this hoverboard-training-manager) (arg0 text-id))
  (when (= (get-status *gui-control* (-> this gui-id)) (gui-status active))
    (let ((s5-1
            (new 'stack 'font-context *font-default-matrix* 32 280 0.0 (font-color default) (font-flags shadow kerning))
            )
          )
      (set! (-> s5-1 flags) (font-flags shadow kerning large))
      (set-width! s5-1 440)
      (set-height! s5-1 80)
      (set-scale! s5-1 0.75)
      (let ((s4-0 print-game-text))
        (format (clear *temp-string*) (lookup-text! *common-text* arg0 #f))
        (s4-0 *temp-string* s5-1 #f 44 (bucket-id progress))
        )
      )
    )
  )

(defun trick-type-trick? ((arg0 board-tricks))
  (or (= arg0 (board-tricks board-spin))
      (= arg0 (board-tricks board-flip))
      (= arg0 (board-tricks board-nosegrab))
      (= arg0 (board-tricks board-method))
      (= arg0 (board-tricks board-board-spin))
      (= arg0 (board-tricks board-board-flip))
      (= arg0 (board-tricks board-noseflip))
      (= arg0 (board-tricks board-kickflip))
      )
  )

(defun hoverboard-training-manager-get-ride-target ()
  (if (and *multi-sync-enabled?* (mp-target-daxter? *target*) (mp-target-ride-along? *target*))
      (let ((ride-target (mp-jak-target-for *target*)))
        (if (and ride-target (nonzero? ride-target))
            ride-target
            (the-as target #f)
            )
        )
      (the-as target #f)
      )
  )

(defun hoverboard-training-manager-board-ready? ()
  (or (and *target*
           (nonzero? *target*)
           (logtest? (focus-status board) (-> *target* focus-status)))
      (let ((ride-target (hoverboard-training-manager-get-ride-target)))
        (and ride-target
             (nonzero? ride-target)
             (logtest? (focus-status board) (-> ride-target focus-status)))
        )
      )
  )

(defun hoverboard-training-manager-set-notify! ((listener object))
  (when (and *target* (nonzero? *target*))
    (send-event *target* 'get-notify listener)
    )
  (let ((ride-target (hoverboard-training-manager-get-ride-target)))
    (when (and ride-target
               (nonzero? ride-target)
               (!= ride-target *target*))
      (send-event ride-target 'get-notify listener)
      )
    )
  (none)
  )

(defun hoverboard-training-manager-ride-focus-test? ((status focus-status))
  (let ((ride-target (hoverboard-training-manager-get-ride-target)))
    (and ride-target
         (nonzero? ride-target)
         (logtest? status (-> ride-target focus-status))
         )
    )
  )

(defun hoverboard-training-manager-boost-step-done? ((this hoverboard-training-manager) (quick-jump-seen? symbol))
  (and quick-jump-seen?
       (or (-> this boost)
           (= (-> this trick-type) (board-tricks board-boost))
           )
       )
  )

(defun hoverboard-training-manager-grind-step-done? ((this hoverboard-training-manager) (rail-jump-seen? symbol))
  (and rail-jump-seen?
       (or (-> this grind)
           (= (-> this trick-type) (board-tricks board-rail))
           (hoverboard-training-manager-ride-focus-test? (focus-status rail))
           )
       )
  )

;; WARN: Return type mismatch object vs hoverboard-training-manager.
(defbehavior hoverboard-training-manager-event-handler hoverboard-training-manager ((arg0 process) (arg1 int) (arg2 symbol) (arg3 event-message-block))
  (local-vars (v0-0 object))
  (the-as
    hoverboard-training-manager
    (case arg2
      (('player-joined)
        (let ((player-record (the-as mp-player-record (-> arg3 param 0)))
              (player-id (the-as uint (-> arg3 param 1))))
          (stadium-board1-add-participant! player-id)
          )
        )
      (('notify)
       (case (-> arg3 param 0)
         (('trick-point)
          (set! v0-0 (-> arg3 param 1))
          (set! (-> self trick-type) (the-as board-tricks v0-0))
          v0-0
          )
         (('trick-judge)
          (set! v0-0 #t)
          (set! (-> self challenge-done) (the-as symbol v0-0))
          v0-0
          )
         (('pickup)
          (set! v0-0 #t)
          (set! (-> self board-picked-up) (the-as symbol v0-0))
          (when (and *multi-sync-enabled?*
                     (= (pc-multi-get-status) (mp-connection-status in-game))
                     (not *mp-processing-remote-event*))
            (stadium-board1-send-event! MP_EVENT_MISSION_STADIUM_BOARD1_BOARD_PICKED_UP 0)
            )
          v0-0
          )
         (('trick-flush)
          (the-as float (-> arg3 param 1))
          (let ((gp-0 (the-as object (-> arg3 param 2)))
                (s5-0 (-> arg3 param 3))
                )
            (dotimes (s4-0 (the-as int (+ s5-0 -2)))
              (cond
                ((= (-> (the-as (pointer board-tricks) gp-0) s4-0) (board-tricks board-rail-jump))
                 (if (and (trick-type-trick? (-> (the-as (pointer board-tricks) gp-0) (+ s4-0 1)))
                          (= (-> (the-as (pointer board-tricks) gp-0) (+ s4-0 2)) (board-tricks board-rail-jump))
                          )
                     (set! (-> self combo-done?) #t)
                     )
                 )
                ((trick-type-trick? (-> (the-as (pointer board-tricks) gp-0) s4-0))
                 (if (and (= (-> (the-as (pointer board-tricks) gp-0) (+ s4-0 1)) (board-tricks board-rail-jump))
                          (trick-type-trick? (-> (the-as (pointer board-tricks) gp-0) (+ s4-0 2)))
                          )
                     (set! (-> self combo-done?) #t)
                     )
                 )
                )
              )
            )
          #f
          )
         )
       )
      (('boost)
       (set! v0-0 #t)
       (set! (-> self boost) (the-as symbol v0-0))
       v0-0
       )
      (('grind)
       (set! v0-0 #t)
       (set! (-> self grind) (the-as symbol v0-0))
       v0-0
       )
      (('text-on)
       (set! v0-0 #t)
       (set! (-> self text) (the-as symbol v0-0))
       v0-0
       )
      (('text-off)
       (set! (-> self text) #f)
       #f
       )
      )
    )
  )

(defstate wait-for-pickup (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :enter (behavior ()
    (set! (-> self board-picked-up) #f)
    (cond
      ((task-node-closed? (game-task-node forest-scouts-get-board))
       (set! (-> self board-picked-up) #t)
       )
      (else
        (let ((v1-0 (birth-pickup-at-point
                      (new 'static 'vector :x 505282.56 :y -38912.0 :z -2533785.5 :w 1.0)
                      (pickup-type board)
                      1.0
                      #t
                      self
                      (the-as fact-info #f)
                      )
                    )
              )
          (send-event (ppointer->process v1-0) 'get-notify #t)
          )
        (let ((gp-0 (new 'stack-no-clear 'task-arrow-params)))
          (set! (-> gp-0 pos quad) (-> (new 'static 'vector :x 505282.56 :y -38912.0 :z -2533785.5 :w 1.0) quad))
          (quaternion-identity! (-> gp-0 quat))
          (set! (-> gp-0 flags) (task-arrow-flags))
          (set! (-> gp-0 map-icon) (the-as uint 15))
          (set! (-> self arrow) (process->handle (task-arrow-spawn gp-0 self)))
          )
        )
      )
    )
  :exit (behavior ()
    (set-continue! *game-info* "skatea-training" #f)
    )
  :trans (behavior ()
    (when (-> self board-picked-up)
      (let ((a1-0 (new 'stack-no-clear 'event-message-block)))
        (set! (-> a1-0 from) (process->ppointer self))
        (set! (-> a1-0 num-params) 0)
        (set! (-> a1-0 message) 'complete)
        (let ((t9-0 send-event-function)
              (v1-5 (-> *game-info* sub-task-list (game-task-node stadium-board1-board)))
              )
          (t9-0
            (handle->process (if (-> v1-5 info)
                                 (-> v1-5 info manager)
                                 (the-as handle #f)
                                 )
                             )
            a1-0
            )
          )
        )
      (send-event (handle->process (-> self arrow)) 'leave)
      (go-virtual jump)
      )
    )
  :code sleep-code
  )

(defstate wait-for-pickup-training (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :enter (behavior ()
    (when (!= (-> self arrow) #f)
        (send-event (handle->process (-> self arrow)) 'leave)
        (set! (-> self arrow) (the-as handle #f)))
    (set! (-> self board-picked-up) #f)
    (cond
      ((task-node-closed? (game-task-node forest-scouts-get-board))
       (set! (-> self board-picked-up) #t)
       )
      (else
        (let ((v1-0 (birth-pickup-at-point
                      (new 'static 'vector :x 505282.56 :y -38912.0 :z -2533785.5 :w 1.0)
                      (pickup-type board)
                      1.0
                      #t
                      self
                      (the-as fact-info #f)
                      )
                    )
              )
          (send-event (ppointer->process v1-0) 'get-notify #t)
          )
        )
      )
    )
  :exit (behavior ()
    (set-continue! *game-info* "skatea-training" #f)
    )
  :trans (behavior ()
    (if (-> self board-picked-up)
        (go-virtual idle-training)
        )
    )
  :code sleep-code
  )

(defstate wait-for-board (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :trans (behavior ()
    (if (task-node-open? (game-task-node stadium-board1-board))
        (go-virtual wait-for-pickup)
        )
    (when (and (task-node-closed? (game-task-node stadium-board1-training))
               (logtest? (-> *game-info* features) (game-feature board)))
          (stadium-board1-mark-tutorial-done!)
          (go-virtual idle)
          )
    )
  :code sleep-code
  )

(defstate wait (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :trans (behavior ()
    (if (task-node-open? (game-task-node stadium-board1-training-judge))
        (go-virtual jump)
        )
    )
  :code sleep-code
  )

(defstate jump (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :code (behavior ()
    (if (= (-> self voicebox) #f)
        (set! (-> self voicebox) (ppointer->handle (voicebox-spawn *target* (target-pos 0))))
        )
    (send-event (handle->process (-> self voicebox)) 'speak-effect #t)
    (set! (-> self last-sound-id)
          (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei001" -99.0 0)
          )
    (while (not (hoverboard-training-manager-board-ready?))
      (if (= (get-status *gui-control* (-> self last-sound-id)) (gui-status unknown))
          (send-event (handle->process (-> self voicebox)) 'speak-effect #f)
          )
      (render-text self (text-id board-tutorial-get-on-board))
      (suspend)
      )
    (send-event (handle->process (-> self voicebox)) 'speak-effect #t)
    (set! (-> self last-sound-id)
          (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei002" -99.0 0)
          )
    (while (nonzero? (get-status *gui-control* (-> self last-sound-id)))
      (suspend)
      )
    (send-event (handle->process (-> self voicebox)) 'speak-effect #f)
    (hoverboard-training-manager-set-notify! self)
    (set! (-> self trick-type) (board-tricks none))
    (until #f
      (render-text self (text-id board-tutorial-jump))
      (suspend)
      (if (= (-> self trick-type) (board-tricks board-jump))
          (goto cfg-51)
          )
      )
    #f
    (label cfg-51)
    (hoverboard-training-manager-set-notify! #f)
    (go-virtual duck-jump)
    )
  )

