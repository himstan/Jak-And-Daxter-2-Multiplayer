    (set! (-> self trick-type) (board-tricks none))
    (until #f
      (render-text self (text-id board-tutorial-trick))
      (suspend)
      (case (-> self trick-type)
        (((board-tricks board-nosegrab)
          (board-tricks board-method)
          (board-tricks board-board-spin)
          (board-tricks board-board-flip)
          (board-tricks board-noseflip)
          (board-tricks board-kickflip)
          )
         (goto cfg-47)
         )
        )
      )
    #f
    (label cfg-47)
    (hoverboard-training-manager-set-notify! #f)
    (go-virtual game)
    )
  )

(defstate game (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :code (behavior ()
    (while (nonzero? (get-status *gui-control* (-> self last-sound-id)))
      (suspend)
      )
    (send-event (handle->process (-> self voicebox)) 'speak-effect #f)
    (send-event (handle->process (-> self voicebox)) 'speak-effect #t)
    (set! (-> self last-sound-id)
          (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei018" -99.0 0)
          )
    (set! (-> self last-sound-id)
          (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei019" -99.0 0)
          )
    (while (nonzero? (get-status *gui-control* (-> self last-sound-id)))
      (suspend)
      )
    (send-event (handle->process (-> self voicebox)) 'speak-effect #f)
    (when (!= (-> self voicebox) #f)
      (send-event (handle->process (-> self voicebox)) 'die)
      (set! (-> self voicebox) (the-as handle #f))
      )
    (task-node-close! (game-task-node stadium-board1-training))
    (stadium-board1-mark-tutorial-done!)
    (go-virtual idle)
    )
  )

(defun hoverboard-training-manager-set-goal-text! ((this hoverboard-training-manager) (label-id text-id))
  (let ((goal-hud (the-as hud-goal (handle->process (-> this hud-goal)))))
    (when (and goal-hud (nonzero? goal-hud))
      (format (clear (-> goal-hud strings 1 text))
              "~S"
              (lookup-text! *common-text* label-id #f))))
  (none)
  )

(defmethod hoverboard-training-manager-update-goal-hud! ((this hoverboard-training-manager))
  "Update the next score threshold and HUD label from the best player score."
  (let ((score-thresholds (get-game-score-ref *game-info* STADIUM_BOARD1_GAME_SCORE_ID))
        (score (the float (stadium-board1-effective-score))))
    (cond
      ((-> this training?)
       (cond
         ((>= score (-> score-thresholds 0))
          (set! (-> *game-info* goal) score)
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))
         ((>= score (-> score-thresholds 1))
          (set! (-> *game-info* goal) (-> score-thresholds 0))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))
         ((>= score (-> score-thresholds 2))
          (set! (-> *game-info* goal) (-> score-thresholds 1))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-silver)))
         ((>= score STADIUM_BOARD1_TRAINING_GOAL)
          (set! (-> *game-info* goal) (-> score-thresholds 2))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-bronze)))
         (else
           (set! (-> *game-info* goal) STADIUM_BOARD1_TRAINING_GOAL)
           (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-goal)))))
      ((task-node-open? (the-as game-task-node STADIUM_BOARD1_TASK_BRONZE_ID))
       (cond
         ((>= score (-> score-thresholds 0))
          (set! (-> *game-info* goal) score)
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))
         ((>= score (-> score-thresholds 1))
          (set! (-> *game-info* goal) (-> score-thresholds 0))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))
         ((>= score (-> score-thresholds 2))
          (set! (-> *game-info* goal) (-> score-thresholds 1))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-silver)))
         (else
           (set! (-> *game-info* goal) (-> score-thresholds 2))
           (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-bronze)))))
      ((task-node-open? (the-as game-task-node STADIUM_BOARD1_TASK_SILVER_ID))
       (cond
         ((>= score (-> score-thresholds 0))
          (set! (-> *game-info* goal) score)
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))
         ((>= score (-> score-thresholds 1))
          (set! (-> *game-info* goal) (-> score-thresholds 0))
          (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-silver)))
         (else
           (set! (-> *game-info* goal) (-> score-thresholds 1))
           (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-silver)))))
      (else
        (if (>= score (-> score-thresholds 0))
            (set! (-> *game-info* goal) score)
            (set! (-> *game-info* goal) (-> score-thresholds 0)))
        (hoverboard-training-manager-set-goal-text! this (text-id highscore-text-gold)))))
  (none)
  )

(defmethod hoverboard-training-manager-award-score-medals! ((this hoverboard-training-manager))
  "Close newly earned stadium score tasks and grant their skill rewards."
  (set! (-> this egg-count) 0)
  (set! (-> this medal) 0)
  (let ((score-thresholds (get-game-score-ref *game-info* STADIUM_BOARD1_GAME_SCORE_ID))
        (score (stadium-board1-effective-score)))
    (when (and (or (-> this training?)
                   (task-node-open? (the-as game-task-node STADIUM_BOARD1_TASK_BRONZE_ID)))
               (>= score (-> score-thresholds 2)))
      (task-node-close! (the-as game-task-node STADIUM_BOARD1_TASK_BRONZE_ID))
      (logior! (-> *game-info* features) (game-feature board))
      (+! (-> this egg-count) 1)
      (set! (-> this medal) 2))
    (when (and (task-node-open? (the-as game-task-node STADIUM_BOARD1_TASK_SILVER_ID))
               (>= score (-> score-thresholds 1)))
      (task-node-close! (the-as game-task-node STADIUM_BOARD1_TASK_SILVER_ID))
      (logior! (-> *game-info* features) (game-feature board))
      (+! (-> this egg-count) 1)
      (set! (-> this medal) 1))
    (when (and (task-node-open? (the-as game-task-node STADIUM_BOARD1_TASK_GOLD_ID))
               (>= score (-> score-thresholds 0)))
      (task-node-close! (the-as game-task-node STADIUM_BOARD1_TASK_GOLD_ID))
      (logior! (-> *game-info* features) (game-feature board))
      (+! (-> this egg-count) 1)
      (set! (-> this medal) 0)))
  (game-info-method-28
    *game-info*
    (the-as game-score STADIUM_BOARD1_GAME_SCORE_ID)
    (the float (stadium-board1-effective-score)))
  ;; og:preserve-this give skill directly
  (#when PC_PORT
    (send-event *target*
                'get-pickup
                (pickup-type skill)
                (* (the float (-> this egg-count)) (-> *FACT-bank* super-skill-inc))))
  (none)
  )

(defun hoverboard-training-manager-spawn-main-score-hud! ((self hoverboard-training-manager))
  (let ((score-proc (if (!= (-> self hud-score) #f)
                        (handle->process (-> self hud-score))
                        #f
                        )))
    (when (and score-proc
               (nonzero? score-proc)
               *multi-sync-enabled?*
               (not (type? score-proc stadium-hud-multi-score)))
      (send-event (the-as process-tree score-proc) 'hide-and-die)
      (set! (-> self hud-score) (the-as handle #f))
      )
    )
  (when (= (-> self hud-score) #f)
    (if *multi-sync-enabled?*
        (set! (-> self hud-score)
              (ppointer->handle
                (process-spawn stadium-hud-multi-score :init hud-init-by-other :to self)))
        (set! (-> self hud-score)
              (ppointer->handle (process-spawn hud-score :init hud-init-by-other :to self)))
        )
    )
  (none)
  )

(defun hoverboard-training-manager-send-hud-event! ((hud-handle handle) (message symbol))
  (when (!= hud-handle #f)
    (let ((hud-proc (handle->process hud-handle)))
      (when (nonzero? hud-proc)
        (send-event hud-proc message)
        )
      )
    )
  (none)
  )

(defun hoverboard-training-manager-ensure-score-huds! ((self hoverboard-training-manager))
  (hoverboard-training-manager-spawn-main-score-hud! self)
  (if (= (-> self hud-goal) #f)
      (set! (-> self hud-goal) (ppointer->handle (process-spawn hud-goal :init hud-init-by-other :to self)))
      )
  (none)
  )

(defun hoverboard-training-manager-show-score-huds! ((self hoverboard-training-manager))
  (hoverboard-training-manager-ensure-score-huds! self)
  (hoverboard-training-manager-send-hud-event! (-> self hud-score) 'force-show)
  (hoverboard-training-manager-send-hud-event! (-> self hud-goal) 'force-show)
  (none)
  )

(defun hoverboard-training-manager-hide-score-huds! ((self hoverboard-training-manager))
  (hoverboard-training-manager-send-hud-event! (-> self hud-score) 'force-hide)
  (hoverboard-training-manager-send-hud-event! (-> self hud-goal) 'force-hide)
  (none)
  )

(defstate idle (hoverboard-training-manager)
  :virtual #t
  :event hoverboard-training-manager-event-handler
  :enter (behavior ()
    (hoverboard-training-manager-ensure-score-huds! self)
    (set! (-> self training?) #t)
    (set! (-> self challenge-done) #t)
    (if (task-node-closed? (game-task-node stadium-board1-training-judge))
        (set! (-> self training?) #f)
        )
    (if (task-node-closed? (game-task-node stadium-board1-training))
      (stadium-board1-mark-tutorial-done!)
      )
    (if (logtest? (-> *game-info* features) (game-feature board))
        (hoverboard-training-manager-show-score-huds! self)
        (hoverboard-training-manager-hide-score-huds! self)
        )
    )
  :exit (behavior ()
    (hoverboard-training-manager-set-notify! #f)
    )
  :trans (behavior ()
    (if (and (-> self training?)
             (not (stadium-board1-local-flag? (mp-player-mission-flags stadium-board1-tutorial-done)))
             (task-node-closed? (game-task-node stadium-board1-training)))
        (stadium-board1-mark-tutorial-done!)
      )
    (hoverboard-training-manager-ensure-score-huds! self)
    (let ((a1-0 (new 'stack-no-clear 'event-message-block)))
      (set! (-> a1-0 from) (process->ppointer self))
      (set! (-> a1-0 num-params) 0)
      (set! (-> a1-0 message) 'off)
      (let ((t9-0 send-event-function)
            (v1-5 (-> self actor-group 0 data 0 actor))
            )
        (t9-0
          (if v1-5
              (-> v1-5 extra process)
              )
          a1-0
          )
        )
      )
    (let ((a1-1 (new 'stack-no-clear 'event-message-block)))
      (set! (-> a1-1 from) (process->ppointer self))
      (set! (-> a1-1 num-params) 0)
      (set! (-> a1-1 message) 'off)
      (let ((t9-1 send-event-function)
            (v1-13 (-> self actor-group 0 data 1 actor))
            )
        (t9-1
          (if v1-13
              (-> v1-13 extra process)
              )
          a1-1
          )
        )
      )
    (cond
      ((not (logtest? (-> *game-info* features) (game-feature board)))
       (hoverboard-training-manager-hide-score-huds! self)
       )
      (else
        (hoverboard-training-manager-show-score-huds! self)
        )
      )
    (hoverboard-training-manager-set-notify! self)
    (hoverboard-training-manager-update-goal-hud! self)
    (stadium-board1-update! (not (-> self challenge-done)))
    (when (not (and (-> self training?) (< (the float (stadium-board1-effective-score)) STADIUM_BOARD1_TRAINING_GOAL)))
      (stadium-board1-render-result-text)
      )
    (stadium-board1-render-waiting-text)
    (when (not (-> self challenge-done))
      (when (and (not (-> self combo-done?))
                 (time-elapsed? (-> self hint-time) (seconds 30))
                 (not (task-node-closed? (game-task-node stadium-board1-resolution)))
                 )
        (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei018" -99.0 0)
        (set-time! (-> self hint-time))
        )
      )
    )
  :code (behavior ()
    (suspend)
    (when (stadium-board1-tutorials-ready?)
      (let ((a1-0 (new 'stack-no-clear 'event-message-block)))
        (set! (-> a1-0 from) (process->ppointer self))
        (set! (-> a1-0 num-params) 0)
        (set! (-> a1-0 message) 'open)
        (let ((t9-0 send-event-function)
              (v1-5 (-> self actor-group 1 data 0 actor))
              )
          (t9-0
            (if v1-5
                (-> v1-5 extra process)
                )
            a1-0
            )
          )
        )
      )
    (until #f
      (when (not (task-node-closed? (game-task-node stadium-board1-training-judge)))
        (let ((arrow-params (new 'stack-no-clear 'task-arrow-params)))
          (set! (-> arrow-params pos quad)
                (-> (new 'static 'vector :x 191037.44 :y -53780.48 :z -2148638.8 :w 1.0) quad))
          (quaternion-identity! (-> arrow-params quat))
          (set! (-> arrow-params flags) (task-arrow-flags))
          (set! (-> arrow-params map-icon) (the-as uint 15))
          (set! (-> self arrow) (process->handle (task-arrow-spawn arrow-params self)))))
      (let* ((judge-ppointer
               (judge-spawn
                 self
                 (new 'static 'vector :x 190382.08 :y -47063.04 :z -2148475.0 :w 1.0)
                 (the-as uint 10)))
             (judge-handle (ppointer->handle judge-ppointer)))
        (suspend)
        (while (send-event (handle->process judge-handle) 'waiting)
          (set! (-> self judge-activated?) #f)
          (stadium-board1-deliver-pending-start! judge-handle)
          (when (-> self text)
            (cond
              ((not (task-node-closed? (game-task-node stadium-board1-resolution)))
               (cond
                 ((and (stadium-board1-tutorials-ready?) (task-node-open? (game-task-node stadium-board1-training-judge)))
                  (cond
                    ((= 0 (stadium-board1-effective-score)) (not (-> self judge-activated?))
                     (render-text self (text-id board-score-activate-judge))
                     )
                     ((and (-> self training?) (< (the float (stadium-board1-effective-score)) STADIUM_BOARD1_TRAINING_GOAL))
                      (render-text self (text-id board-score-try-again))
                    )
                  )
               )
              ((not (task-node-closed? (game-task-node stadium-board1-done)))
                (if (stadium-board1-waiting-for-players?)
                    (stadium-board1-render-waiting-text)
                    (if (not (movie?))
                        (render-text self (text-id board-score-return-to-garage))
                        )
                    )
                )
               ((task-node-closed? (game-task-node stadium-board1-done))
                (when (!= (-> self arrow) #f)
                  (send-event (handle->process (-> self arrow)) 'leave)
                  (set! (-> self arrow) (the-as handle #f))
                  )
                )
               )
             )
            (else
              (go-virtual wait-for-pickup-training)
              )
            )
          )
        (suspend)
        )
        (when (!= (-> self arrow) #f)
          (send-event (handle->process (-> self arrow)) 'leave))
        (set! (-> self challenge-done) #f)
        (set! (-> self combo-done?) #f)
        (set-time! (-> self hint-time))
        (while (and (not (-> self challenge-done))
                    (logtest? (-> *game-info* features) (game-feature board)))
          (suspend))
        (send-event (handle->process judge-handle) 'die))
      (when (-> self challenge-done)
        (hoverboard-training-manager-award-score-medals! self)
        (when (> (-> self egg-count) 0)
          (let ((s5-0 0))
            (let ((gp-3 (ppointer->handle (voicebox-spawn *target* (target-pos 0)))))
              (let ((v1-83 (-> self medal)))
                (cond
                  ((zero? v1-83)
                   (set! s5-0
                         (the-as int (add-process *gui-control* self (gui-channel sig) (gui-action play) "cityv179" -99.0 0))
                         )
                   )
                  ((= v1-83 1)
                   (set! s5-0
                         (the-as int (add-process *gui-control* self (gui-channel sig) (gui-action play) "cityv180" -99.0 0))
                         )
                   )
                  ((= v1-83 2)
                   (set! s5-0
                         (the-as int (add-process *gui-control* self (gui-channel sig) (gui-action play) "cityv181" -99.0 0))
                         )
                   )
                  )
                )
              (while (nonzero? (get-status *gui-control* (the-as sound-id s5-0)))
                (suspend)
                )
              ;; og:preserve-this skill is given in score method
              (#unless PC_PORT
                (let* ((s5-1 (handle->process gp-3))
                      (v1-97 (if (type? s5-1 process-drawable)
                                  (the-as process-drawable s5-1)
                                  )
                              )
                      (t1-3 (new 'static 'fact-info))
                      )
                  (set! (-> t1-3 options) (actor-option))
                  (logior! (-> t1-3 options) (actor-option suck-in))
                  (birth-pickup-at-point
                    (-> v1-97 root trans)
                    (pickup-type skill)
                    (* (the float (-> self egg-count)) (-> *FACT-bank* super-skill-inc))
                    #t
                    *entity-pool*
                    t1-3
                    )
                  )
                )
              (suspend-for (seconds 1)
                )
              (send-event (handle->process gp-3) 'die)
              )
            )
          (auto-save-user)
          )
        )
      (set! (-> self challenge-done) #t)
      (stadium-board1-post-challenge-finished! #t)
      (let ((gp-4 (new 'stack-no-clear 'task-arrow-params)))
        (cond
          ((not (task-node-closed? (game-task-node stadium-board1-training-judge)))
           (cond
             ((>= (the float (stadium-board1-effective-score)) STADIUM_BOARD1_TRAINING_GOAL)
             (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei021" -99.0 0)
             (task-node-close! (game-task-node stadium-board1-training-judge))
              (set! (-> self training?) #f)
              (set! (-> gp-4 pos quad) (-> (new 'static 'vector :x 426885.12 :y -38461.44 :z -2598625.2 :w 1.0) quad))
              (quaternion-identity! (-> gp-4 quat))
              (set! (-> gp-4 flags) (task-arrow-flags))
              (set! (-> gp-4 map-icon) (the-as uint 15))
              (set! (-> self arrow) (process->handle (task-arrow-spawn gp-4 self)))
              )
             (else
               (set! (-> *game-info* sub-task-list (game-task-node stadium-board1-training-judge) death-count)
                     (the-as
                       uint
                       (seekl
                         (the-as int (-> *game-info* sub-task-list (game-task-node stadium-board1-training-judge) death-count))
                         #xffff
                         1
                         )
                       )
                     )
               (add-process *gui-control* self (gui-channel sig) (gui-action play) "kei020" -99.0 0)
               )
             )
           )
          (else
            (set! (-> self training?) #f)
            (set! (-> gp-4 pos quad) (-> (new 'static 'vector :x 426885.12 :y -38461.44 :z -2598625.2 :w 1.0) quad))
            (quaternion-identity! (-> gp-4 quat))
            (set! (-> gp-4 flags) (task-arrow-flags))
            (set! (-> gp-4 map-icon) (the-as uint 15))
            (set! (-> self arrow) (process->handle (task-arrow-spawn gp-4 self)))
            )
          )
        )
      )
    #f
    )
  )

