    )
  )

(defun eye-control-reset! ((control eye-control))
  (when (nonnull? control)
    (set! (-> control process) (the-as handle #f))
    (set! (-> control shaders) (the-as (inline-array adgif-shader) #f))
    (set! (-> control random-time) (the-as uint 60))
    (set! (-> control blink) 0.0))
  (none))

(defun eye-control-reset-all! ()
  (when (nonnull? *eye-control-arrays*)
    (dotimes (group-idx 6)
      (dotimes (slot-idx 16)
        (let ((control (the-as eye-control
                               (+ (+ (* 96 slot-idx) 28 (* 1552 group-idx))
                                  (the-as int *eye-control-arrays*)))))
          (eye-control-reset! control)))))
  (when (nonnull? *pc-eye-control-array*)
    (dotimes (instance-id MP_MAX_PLAYERS)
      (let ((entry (-> *pc-eye-control-array* data instance-id)))
        (eye-control-reset! (-> entry control))
        (set! (-> entry source-eye-slot) -1))))
  (when (nonnull? *pc-eye-preview-control*)
    (eye-control-reset! (-> *pc-eye-preview-control* control))
    (set! (-> *pc-eye-preview-control* source-eye-slot) -1))
  (none))

(defun eye-control-owner ((control eye-control))
  (if (nonnull? control (-> control process))
      (the-as process-drawable (handle->process-safe (-> control process)))
      (the-as process-drawable #f)))

(defun eye-control-render-active? ((eye-proc process-drawable))
  (and (nonnull? eye-proc (-> eye-proc skel) (-> eye-proc draw))
       (logtest? (-> eye-proc skel status) (joint-control-status eye-anim))
       (logtest? (-> eye-proc draw status) (draw-control-status on-screen))))

(defun update-eye-control-blink! ((control eye-control))
  (when (and (nonnull? control) (not (paused?)))
    (cond
      ((and (>= (-> control left lid) 0.0) (>= (-> control right lid) 0.0))
       (set! (-> control random-time) (the int (* (1/ DISPLAY_FPS_RATIO) (the-as uint 60))))
       (set! (-> control blink) 0.0))
      (else
        (+! (-> control random-time) -1)
        (let ((blink-frame (the int (* DISPLAY_FPS_RATIO (-> control random-time)))))
          (when (and (>= blink-frame 0) (< blink-frame (the-as uint 10)))
            (set! (-> control blink) (-> *eye-work* blink-table blink-frame))
            (when (zero? blink-frame)
              (set! (-> control random-time)
                    (the-as uint
                            (the int
                                 (* (1/ DISPLAY_FPS_RATIO)
                                    (rand-vu-float-range 60.0 240.0)))))))))))
  (none))

(defun daxter-eye-draw-control? ((draw-control draw-control))
  (when (nonnull? draw-control)
    (let ((merc-control (-> draw-control mgeo)))
      (when (and merc-control (nonzero? merc-control))
        (let ((model-name (-> merc-control name)))
          (when (and model-name (nonzero? model-name))
            (return (or (string= model-name "daxter-lod0")
                        (string= model-name "daxter-highres-lod0"))))))))
  #f)

(defun get-lid-tint-color ((draw-control draw-control) (daxter-eye? symbol))
  (if daxter-eye?
    (-> draw-control pc-player-tint-colors (mp-player-skin-group daxter-fur))
    (the uint 0))
  )

(defun get-lid-tint-strength ((draw-control draw-control) (daxter-eye? symbol))
  (if daxter-eye?
    (-> draw-control pc-player-tint-strengths (mp-player-skin-group daxter-fur))
    0.0)
  )

(defun render-eye-control! ((control eye-control) (eye-group int) (eye-slot int) (instance-id uint))
  (when (nonnull? control *display* *eyes-texture-base*)
    (let* ((eye-proc (eye-control-owner control))
           (draw-control (if (and eye-proc (nonzero? eye-proc)) (-> eye-proc draw) (the-as draw-control #f)))
           (daxter-eye? (daxter-eye-draw-control? draw-control))
           (lid-tint-color (get-lid-tint-color draw-control daxter-eye?))
           (lid-tint-strength (get-lid-tint-strength draw-control daxter-eye?)))
      (with-dma-buffer-add-bucket ((dma-buf (-> *display* frames (-> *display* on-screen) global-buf))
                                   (the-as bucket-id (-> control bucket)))
        (if (>= eye-group 3)
            (begin
              (set-display-gs-state-offset dma-buf (the-as int (-> *eyes-texture-base* vram-page)) 128 256 0 0 64 64)
              (dma-buffer-add-gs-set dma-buf
                                     (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always))))
              (if (-> control different-eyes)
                  (render-eyes-64-different dma-buf control (/ eye-slot 4) instance-id lid-tint-color lid-tint-strength)
                  (render-eyes-64 dma-buf control (/ eye-slot 4) instance-id lid-tint-color lid-tint-strength)))
            (begin
              (set-display-gs-state-offset dma-buf (the-as int (-> *eyes-texture-base* vram-page)) 64 512 0 0 32 32)
              (dma-buffer-add-gs-set dma-buf
                                     (test-1 (new 'static 'gs-test :ate #x1 :atst (gs-atest always) :zte #x1 :ztst (gs-ztest always))))
              (if (-> control different-eyes)
                  (render-eyes-32-different dma-buf control eye-slot instance-id lid-tint-color lid-tint-strength)
                  (render-eyes-32 dma-buf control eye-slot instance-id lid-tint-color lid-tint-strength))))
        (reset-display-gs-state *display* dma-buf)
        (dma-buffer-add-gs-set dma-buf (alpha-1 (new 'static 'gs-alpha :b #x1 :d #x1))))))
  (none))

(defun vanilla-eye-control-render? ((eye-group int) (eye-slot int))
  (cond
    ((>= eye-group 3)
     (or (movie?)
         (and (not (-> (the-as eye-control-arrays (+ (the-as uint *eye-control-arrays*) (* 1552 (- eye-group 3)) (* 96 eye-slot))) data 0 data 0 process))
              (not (-> (the-as eye-control-arrays (+ (the-as uint *eye-control-arrays*) (* 1552 (- eye-group 3)) (* 96 (+ eye-slot 1)))) data 0 data 0 process))
              (not (-> (the-as eye-control-arrays (+ (the-as uint *eye-control-arrays*) (* 1552 (- eye-group 3)) (* 96 (+ eye-slot 2)))) data 0 data 0 process))
              (not (-> (the-as eye-control-arrays (+ (the-as uint *eye-control-arrays*) (* 1552 (- eye-group 3)) (* 96 (+ eye-slot 3)))) data 0 data 0 process)))))
    ((< eye-group 3)
     (or (not (movie?))
         (not (-> (the-as eye-control-arrays (+ (the-as uint *eye-control-arrays*) (* 1552 (+ eye-group 3)) (* 96 (* (/ eye-slot 4) 4)))) data 0 data 0 process))))
    (else #f)))

(defun update-eye-control! ((control eye-control) (eye-group int) (eye-slot int) (instance-id uint) (render? symbol))
  (when (and control (nonzero? control) render?)
    (let ((eye-proc (eye-control-owner control)))
      (when (and (eye-control-render-active? eye-proc)
                 (-> control shaders)
                 (-> control draw-flag))
        (update-eye-control-blink! control)
        (render-eye-control! control eye-group eye-slot instance-id))))
  (none))

(defun update-pc-eye-control! ((entry pc-eye-control-entry) (instance-id uint))
  (when (nonnull? entry)
    (let* ((control (-> entry control))
           (eye-proc (eye-control-owner control))
           (draw-control (if (and eye-proc (nonzero? eye-proc))
                             (-> eye-proc draw)
                             (the-as draw-control #f))))
      (if (and (nonnull? eye-proc draw-control)
               (= (-> draw-control pc-eye-instance-id) instance-id)
               (>= (-> entry source-eye-slot) 0))
          (update-eye-control! control
                               (/ (-> entry source-eye-slot) 20)
                               (mod (-> entry source-eye-slot) 20)
                               instance-id
                               #t)
          (begin
            (eye-control-reset! control)
            (set! (-> entry source-eye-slot) -1)))))
  (none))

(defun update-eyes ()
  (when (nonnull? *blit-displays-work*
                  *eye-control-arrays*
                  *pc-eye-control-array*
                  *pc-eye-preview-control*)
    (when (not (-> *blit-displays-work* screen-copied))
      (dotimes (eye-group 6)
        (dotimes (eye-slot 16)
          (let ((control (the-as eye-control
                                 (+ (+ (* 96 eye-slot) 28 (* 1552 eye-group))
                                    (the-as int *eye-control-arrays*)))))
            (update-eye-control! control
                                 eye-group
                                 eye-slot
                                 MP_INVALID_PLAYER_ID
                                 (vanilla-eye-control-render? eye-group eye-slot)))))
      (dotimes (instance-id MP_MAX_PLAYERS)
        (update-pc-eye-control! (-> *pc-eye-control-array* data instance-id)
                                (the-as uint instance-id))))
    (update-pc-eye-control! *pc-eye-preview-control*
                            (the-as uint PC_EYE_PREVIEW_INSTANCE_ID)))
  0
  (none))

;; WARN: Return type mismatch uint vs int.
(defun get-eye-block ((arg0 int) (arg1 int))
  (let ((v1-0 arg0)
        (a0-4 (-> ct32-24-block-table (* arg1 4)))
        )
    (the-as int (+ (-> *eyes-texture-base* vram-block) (* v1-0 32) a0-4))
    )
  )

(defun convert-eye-data ((arg0 eye) (arg1 uint))
  (local-vars
    (v0-0 float)
    (v1-0 uint128)
    (v1-1 uint128)
    (v1-2 uint128)
    (v1-3 uint128)
    (v1-4 uint128)
    (v1-5 uint128)
    )
  (rlet ((vf1 :class vf)
         (vf2 :class vf)
         )
    (.pextlb v1-0 arg1 0)
    (.pextlh v1-1 v1-0 0)
    (.pw.sra v1-2 v1-1 16)
    (.mov vf1 v1-2)
    (.pextlb v1-3 0 arg1)
    (.pextuh v1-4 0 v1-3)
    (.pw.sll v1-5 v1-4 6)
    (.mov vf2 v1-5)
    (vitof15.xyzw vf1 vf1)
    (vitof12.xyzw vf2 vf2)
    (.svf (&-> arg0 data 0 quad) vf1)
    (.svf (&-> arg0 data 1 quad) vf2)
    (.mov v0-0 vf2)
    v0-0
    )
  )

(defun eye-control-set-default! ((control eye-control))
  (when (nonnull? control)
    (set! (-> control left x) 0.0)
    (set! (-> control left y) 0.0)
    (set! (-> control left lid) -1.0)
    (set! (-> control left iris-scale) 0.55)
    (set! (-> control left pupil-scale) 0.45)
    (set! (-> control left lid-scale) 1.0)
    (set! (-> control right x) 0.0)
    (set! (-> control right y) 0.0)
    (set! (-> control right lid) -1.0)
    (set! (-> control right iris-scale) 0.55)
    (set! (-> control right pupil-scale) 0.45)
    (set! (-> control right lid-scale) 1.0))
  (none))

(defun eye-control-apply-override! ((control eye-control) (override (array float)))
  (when (nonnull? control override)
    (set! (-> control left x) (-> override 42))
    (set! (-> control left y) (-> override 43))
    (set! (-> control left lid) (-> override 44))
    (set! (-> control left iris-scale) (-> override 45))
    (set! (-> control left pupil-scale) (-> override 46))
    (set! (-> control left lid-scale) (-> override 47))
    (set! (-> control right x) (-> override 48))
    (set! (-> control right y) (-> override 49))
    (set! (-> control right lid) (-> override 50))
    (set! (-> control right iris-scale) (-> override 51))
    (set! (-> control right pupil-scale) (-> override 52))
    (set! (-> control right lid-scale) (-> override 53)))
  (none))

(defun eye-control-sample-animation! ((control eye-control)
                                      (channel joint-control-channel)
                                      (frame-group art-joint-anim))
  (when (nonnull? control channel frame-group (-> frame-group eye-anim))
    (let* ((eye-anim (-> frame-group eye-anim))
           (frame-num (-> channel frame-num))
           (frame-frac (- frame-num (* (the float (the int frame-num)) 1.0)))
           (frame-a (min (the int frame-num) (-> eye-anim max-frame)))
           (frame-b (min (+ (the int frame-num) 1) (-> eye-anim max-frame)))
           (eye-a (new 'stack-no-clear 'eye))
           (eye-b (new 'stack-no-clear 'eye)))
      (convert-eye-data eye-a (-> eye-anim data (* frame-a 2) dword))
      (convert-eye-data eye-b (-> eye-anim data (* frame-b 2) dword))
      (vector4-lerp! (the-as vector (-> control left)) (-> eye-a data 0) (-> eye-b data 0) frame-frac)
      (vector4-lerp! (the-as vector (&-> control left iris-scale))
                     (the-as vector (&-> eye-a iris-scale))
                     (the-as vector (&-> eye-b iris-scale))
                     frame-frac)
      (convert-eye-data eye-a (-> eye-anim data (+ (* frame-a 2) 1) dword))
      (convert-eye-data eye-b (-> eye-anim data (+ (* frame-b 2) 1) dword))
      (vector4-lerp! (the-as vector (-> control right)) (-> eye-a data 0) (-> eye-b data 0) frame-frac)
      (vector4-lerp! (the-as vector (&-> control right iris-scale))
                     (the-as vector (&-> eye-a iris-scale))
                     (the-as vector (&-> eye-b iris-scale))
                     frame-frac)))
  (none))

(defun configure-eye-control! ((control eye-control)
                               (eye-proc process-drawable)
                               (merc-eye merc-eye-ctrl))
  (when (nonnull? control eye-proc (-> eye-proc draw) merc-eye *level*)
    (let ((draw-control (-> eye-proc draw)))
      (set! (-> control process) (process->handle eye-proc))
      (set! (-> control different-eyes) (> (-> merc-eye shader-count) 3))
      (set! (-> control shaders)
            (the-as (inline-array adgif-shader) (-> merc-eye left-iris-shader)))
      (set! (-> control bucket)
            (the-as uint
                    (vu1-bucket-map
                      (the-as int (-> *level* draw-index-map (-> draw-control level-index)))
                      (the-as int (-> draw-control default-texture-page))
                      (merc-mode eye))))))
  (none))

(defun pc-eye-control-entry-for-instance ((instance-id uint))
  (cond
    ((and (< instance-id (the-as uint MP_MAX_PLAYERS))
          (nonnull? *pc-eye-control-array*))
     (-> *pc-eye-control-array* data instance-id))
    ((= instance-id (the-as uint PC_EYE_PREVIEW_INSTANCE_ID))
     *pc-eye-preview-control*)
    (else
     (the-as pc-eye-control-entry #f))))

(defun eye-control-for-process ((eye-proc process-drawable) (merc-eye merc-eye-ctrl))
  (let ((draw-control (if (nonnull? eye-proc)
                          (-> eye-proc draw)
                          (the-as draw-control #f))))
    (if (nonnull? draw-control merc-eye)
        (let* ((instance-id (-> draw-control pc-eye-instance-id))
               (entry (pc-eye-control-entry-for-instance instance-id)))
          (if (nonnull? entry)
              (let* ((control (-> entry control))
                     (owner (eye-control-owner control)))
                (when (and (-> control process)
                           (or (not owner) (zero? owner) (!= owner eye-proc)))
                  (eye-control-reset! control))
                (set! (-> entry source-eye-slot) (the-as int (-> merc-eye eye-slot)))
                control)
              (if (nonnull? *eye-control-arrays*)
                  (-> *eye-control-arrays*
                      data
                      (/ (-> merc-eye eye-slot) 20)
                      data
                      (mod (-> merc-eye eye-slot) 20))
                  (the-as eye-control #f))))
        (the-as eye-control #f))))

(defun merc-eye-anim ((arg0 process-drawable))
  (when (nonnull? arg0 (-> arg0 draw) (-> arg0 skel))
    (let* ((draw-control (-> arg0 draw))
           (skel (-> arg0 skel))
           (merc-control (-> draw-control mgeo))
           (merc-eye (if (and merc-control (nonzero? merc-control))
                         (-> merc-control header eye-ctrl)
                         (the-as merc-eye-ctrl #f))))
      (when (and (nonnull? merc-eye)
                 (not (logtest? (-> draw-control status) (draw-control-status no-draw no-draw-bounds2)))
                 (> (-> skel active-channels) 0)
                 (logtest? (-> skel status) (joint-control-status eye-anim)))
        (let* ((float-channels (-> skel float-channels))
               (channel (if (> float-channels 0)
                            (-> skel channel (+ float-channels -1 (-> skel active-channels)))
                            (let ((root-channel (-> skel root-channel))
                                  (effect (-> skel effect)))
                              (if (and root-channel (nonzero? root-channel))
                                  (-> root-channel (if (and effect (nonzero? effect))
                                                       (-> effect channel-offset)
                                                       0))
                                  (the-as joint-control-channel #f)))))
               (frame-group (if (and channel (nonzero? channel))
                                (-> channel frame-group)
                                (the-as art-joint-anim #f)))
               (control (eye-control-for-process arg0 merc-eye)))
          (when (nonnull? frame-group control)
            (configure-eye-control! control arg0 merc-eye)
            (let ((override (-> skel override)))
              (cond
                ((and override (nonzero? override) (!= (-> override 41) 0.0))
                 (eye-control-apply-override! control override))
                ((and (-> frame-group eye-anim) (nonzero? (-> frame-group eye-anim)))
                 (eye-control-sample-animation! control channel frame-group))
                (else
                  (format *stdcon* "no eye anim data for ~s~%" (-> arg0 name))
                  (eye-control-set-default! control))))
            (logior! (-> skel status) (joint-control-status eye-anim-valid)))))
      (when (logtest? (-> skel status) (joint-control-status eye-anim-valid))
        (logclear! (-> skel status) (joint-control-status eye-anim-valid)))))
  0
  (none))

(defun set-eye-draw-flag ((arg0 symbol) (arg1 int))
  (let ((s5-0 (-> *eye-control-arrays* data (/ arg1 20) data (mod arg1 20)))
        )
    (format 0 "flag: ~a eye-slot: ~d ~%" arg0 arg1)
    (set! (-> (the-as eye-control s5-0) draw-flag) arg0)
    )
  0
  (none)
  )
