(in-package goal)

(deftype region-override (structure)
  ((region-id   uint32)
   (on-enter    object)
   (on-inside   object)
   (on-exit     object)
   )
  )

(define-extern register-region-override! (function int object object object none))
(define-extern region-custom-tick (function none))
