;;-*-Lisp-*-
(in-package goal)

(define-extern mp-run-local-death-spectate! (function target symbol))
(define-extern mp-should-suppress-local-endlessfall? (function symbol))
(define-extern mp-begin-local-death-respawn-policy! (function target symbol))
(define-extern mp-traffic-begin-local-death-spectate! (function none))
(define-extern mp-death-spectate-abort! (function none))
(define-extern mp-spectate-requested? (function symbol))
(define-extern mp-spectate-active? (function symbol))

(defbehavior target-daxter-death-voice! target ((reason symbol))
  (when (and self
             (nonzero? self)
             (mp-target-daxter? self)
             (not (or (= reason 'none) (= reason 'instant-death) (= reason 'bot))))
    (let ((voice (if (= reason 'endlessfall) "ds175" "ds173")))
      (set! (-> self control unknown-sound-id00)
            (add-process *gui-control* self (gui-channel daxter) (gui-action play) voice -99.0 0))
      (set-falloff! *gui-control* (-> self control unknown-sound-id00) #t -1 100 2)))
  (none))

(defstate target-indax-death (target)
  :event
    (-> target-death
        event)
  :enter
    (behavior ()
      (when (not-player-replica? self)
        (mp-trigger-death-taunt! self)))
  :exit
    (behavior ()
      ((-> target-death exit))
      (target-indax-exit))
  :trans
    (-> target-indax-hit
        trans)
  :code
    (behavior ((arg0 symbol))
      (log 'debug "[Daxter-Death] target-indax-death: reason is ~A~%" arg0)
      (when (and (= arg0 'endlessfall) (mp-should-suppress-local-endlessfall?))
        ;; This is a hack guard againts some weird behavior, which is that we can die during cutscenes, never really tried finding the actual reason
        (log 'debug "[Daxter-Death] Suppressing cutscene/loading endlessfall for Daxter.~%")
        (set! (-> self control transv quad) (the-as uint128 0))
        (go target-indax-start (the handle #f)))
      (target-daxter-death-voice! arg0)
      (set! (-> self control unknown-word04) (the-as uint #f))
      (set! (-> self control did-move-to-pole-or-max-jump-height)
            (the-as float (send-event (handle->process-safe (-> self attack-info attacker)) 'target 'die arg0)))
      (set! (-> self neck flex-blend) 0.0)
      (target-timed-invulnerable-off self 0)
      (if (not (mp-session-in-game?)) (set-setting! 'process-mask 'set 0.0 (process-mask enemy platform projectile death)))
      (when (not-player-replica? self)
        (apply-settings *setting-control*))
      (set! (-> self control transv quad) (the-as uint128 0))
      (logior! (-> self focus-status) (focus-status dead))
      (cond
        ((or (= arg0 'none) (= arg0 'instant-death) (= arg0 'bot)))
        ((= arg0 'endlessfall)
         (logior! (-> self control pat-ignore-mask) (new 'static 'pat-surface :noendlessfall #x1))
         (logclear! (-> self water flags) (water-flags swim-ground))
         (set! (-> self post-hook) target-no-move-post)
         (let ((f30-0 (if (rand-vu-percent? 0.2) 0.0 55.0)))
           (ja-channel-push! 1 (seconds 0.1))
           (ja-no-eval :group! daxter-indax-death-fall-ja :num! (seek!) :frame-num (ja-aframe f30-0 0)))
         (until (ja-done? 0)
           (let ((a1-8 (new 'stack-no-clear 'event-message-block)))
             (let ((v1-50 (process->ppointer self))) (set! (-> a1-8 from) v1-50))
             (set! (-> a1-8 num-params) 2)
             (set! (-> a1-8 message) 'joystick)
             (set! (-> a1-8 param 0) (the-as uint 0))
             (set! (-> a1-8 param 1) (the-as uint -1082130432))
             (send-event-function *camera* a1-8))
           (vector-reset! (-> self control transv))
           (suspend)
           (ja :num! (seek!)))
         (remove-setting! 'mode-name))
        ((= arg0 'smush)
         (set! (-> self control mod-surface) *neutral-mods*)
         (ja-channel-push! 1 (seconds 0.1))
         (ja-no-eval :group! daxter-indax-death-squashed-ja :num! (seek!) :frame-num 0.0)
         (until (ja-done? 0)
           (suspend)
           (ja :num! (seek!))))
        ((= arg0 'tomb-spider)
         (set! (-> self control mod-surface) *neutral-mods*)
         (ja-channel-push! 1 (seconds 0.1))
         (cond
           ((rand-vu-percent? 0.5)
            (ja-no-eval :group! daxter-indax-death-eaten-ja :num! (seek!) :frame-num 0.0)
            (until (ja-done? 0)
              (suspend)
              (ja :num! (seek!))))
           (else
            (ja-no-eval :group! daxter-indax-death-kill-ja :num! (seek!) :frame-num 0.0)
            (until (ja-done? 0)
              (suspend)
              (ja :num! (seek!))))))
        (else
         (set! (-> self control mod-surface) *neutral-mods*)
         (ja-channel-push! 1 (seconds 0.1))
         (ja-no-eval :group! daxter-indax-death-kill-ja :num! (seek!) :frame-num 0.0)
         (until (ja-done? 0)
           (suspend)
           (ja :num! (seek!)))))
      (set! (-> self control transv quad) (the-as uint128 0))
      (let ((use-local-respawn? (mp-begin-local-death-respawn-policy! self)))
        (when (mp-session-in-game?)
          (when (player-replica? self)
            (log 'debug "[Daxter-Death] Waiting for remote respawn...~%")
            (loop
              (let ((record (get-player-target-record (mp-player-process-record self))))
                (when (or (not record) (zero? record))
                  (go target-indax-start (the handle #f)))
                (let ((record-state (mp-target-get-state-from-id (-> record state-id))))
                  (when (not (mp-target-death-state? record-state))
                    (log 'debug "[Daxter-Death] Replica respawned (State: ~A). Exiting death reset.~%" record-state)
                    (if (mp-target-daxter? self) (go target-indax-start (the handle #f)) (go target-stance)))))
              (suspend)))
          (when (not-player-replica? self)
            (when (not use-local-respawn?)
              (mp-traffic-begin-local-death-spectate!))
            (mp-event-enqueue-aid! MP_EVENT_PLAYER_DIED (the-as uint 0))
            (when (not use-local-respawn?)
              (log 'debug "[Daxter-Death] You've died of ~A. Spectating and waiting...~%" arg0)
              (when (mp-run-local-death-spectate! self)
                (set! *mp-death-respawn-event-pending?* #t)
                (goto cfg-reset-init))))))
      (label cfg-reset-init)
      (when (or (mp-spectate-active?) (mp-spectate-requested?))
        (mp-death-spectate-abort!))
      (mp-reset-battle-sync-state!)
      (initialize! (-> self game) 'life (the-as game-save #f) (the-as string #f))
      (set-time! (-> self state-time))
      (sleep-code))
  :post target-no-stick-post)
