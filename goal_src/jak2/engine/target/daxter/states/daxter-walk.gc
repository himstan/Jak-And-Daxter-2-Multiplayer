;;-*-Lisp-*-
(in-package goal)

(defbehavior target-indax-footstep-effect target ((step-effect symbol))
  (let ((ground-pat (-> self control ground-pat))
        (poof-effect (if (< (-> self control ctrl-xz-vel) 16384.0) 'effect-just-poof 'effect-run-poof)))
    (when (and ground-pat (nonzero? ground-pat))
      (do-effect-for-surface (-> self skel effect) step-effect -1.0 -1 (the-as basic #f) ground-pat)
      (do-effect-for-surface (-> self skel effect) poof-effect -1.0 -1 (the-as basic #f) ground-pat))))

(defbehavior daxter-start-walk-cycle! target ()
  (let ((frame 0.0)
        (group (ja-group)))
    (cond
      ((and group (or (= group daxter-indax-walk-ja) (= group daxter-indax-run-ja)))
       (set! frame (ja-frame-num 0)))
      ((and (nonnull? self (-> self control))
            (or (= group daxter-indax-jump-loop-ja)
                (and (= group daxter-indax-jump-ja) (< 15.0 (ja-aframe-num 0))))
            (< 12288.0 (-> self control ctrl-xz-vel)))
       (ja-channel-push! 1 (seconds 0.01))
       (ja-no-eval :group! daxter-indax-run-squash-ja :num! (seek! max 2.0) :frame-num 0.0)
       (until (ja-done? 0)
         (suspend)
         (ja :num! (seek! max 2.0)))))
    (ja-channel-push! 2 (seconds 0.05))
    (ja-no-eval :group! daxter-indax-run-ja :num! (identity frame) :dist 13107.2)
    (ja-no-eval :chan 1 :group! daxter-indax-walk-ja :num! (loop!)
                :frame-num frame :dist 5939.2 :frame-interp0 1.0 :frame-interp1 1.0))
  (none))

(defbehavior daxter-update-walk-cycle! target ((run-blend float))
  (when (nonnull? self (-> self skel) (-> self control))
    (let* ((distance (* (current-cycle-distance (-> self skel)) (-> self control scale x)))
           (speed (if (= distance 0.0)
                    0.0
                    (* (/ (-> self control ctrl-xz-vel) distance) *indax-walk-anim-speed*)))
           (walk-blend (- 1.0 run-blend)))
      (ja :num! (loop! speed))
      (ja :chan 1 :frame-interp0 walk-blend :frame-interp1 walk-blend :num! (chan 0))))
  (none))

(defbehavior target-indax-walk-anim target ()
  (daxter-start-walk-cycle!)
  (let ((prev-frame (ja-aframe-num 0))
        (run-blend 0.0))
    (until #f
      (suspend)
      (let ((curr-frame (ja-aframe-num 0))
            (max-frame (the float (ja-num-frames 0))))
        (when (and (< prev-frame (* 0.25 max-frame)) (>= curr-frame (* 0.25 max-frame)))
          (target-indax-footstep-effect 'effect-walk-step-left))
        (when (and (< prev-frame (* 0.75 max-frame)) (>= curr-frame (* 0.75 max-frame)))
          (target-indax-footstep-effect 'effect-walk-step-right))
        (set! prev-frame curr-frame))
      (when (nonnull? self (-> self control))
        (seek! run-blend (lerp-scale 0.0 1.0 (-> self control ctrl-xz-vel) 16384.0 40960.0)
               (* 4.0 (seconds-per-frame))))
      (daxter-update-walk-cycle! run-blend))))

(defstate target-indax-walk (target)
  :event target-indax-handler
  :enter
    (behavior ()
      (set-time! (-> self state-time))
      (set! (-> self control mod-surface) *indax-walk-mods*)
      (target-indax-init #f))
  :exit
    (behavior ()
      (target-effect-exit)
      (target-indax-init #f)
      (target-state-hook-exit)
      (target-indax-exit))
  :trans
    (behavior ()
      ((-> self state-hook))
      (when (logtest? (water-flags swimming) (-> self water flags))
        (go target-swim-stance))
      (when (not (move-legs?))
        (target-effect-exit)
        (remove-exit)
        (go target-indax-stance))
      (if (and (recently-pressed? l1)
               (and (!= (-> *cpad-list* cpads (-> self control cpad number) stick0-speed) 0.0) (can-roll?)))
        (go target-indax-roll))
      (if (and (cpad-hold? (-> self control cpad number) l1)
               (not (logtest? (-> self state-flags) (state-flags prevent-duck))))
        (go target-indax-duck-walk #f))
      (if (and (recently-pressed? x) (can-jump? #f))
        (go target-indax-jump
            (-> *TARGET-bank* indax-jump-height-min)
            (-> *TARGET-bank* indax-jump-height-max)
            (the-as surface #f)))
      (if (and (recently-pressed? square) (can-hands? #t)) (go target-indax-running-attack))
      (target-indax-ride-along-check)
      (if (and (recently-pressed? circle) (can-feet? #t)) (go target-indax-attack))
      (when (and (using-gun? self) (-> self gun active?))
        (go target-gun-walk))
      (fall-test target-indax-falling -4096000.0))
  :code
    (behavior ()
      (target-indax-walk-anim)
      #f)
  :post target-indax-post)
