(in-package goal)

(define-extern mp-any-remote-players-driving? (function symbol))

(define *mp-ride-along-rapid-camera?* #f)

(defconstant RIDE_ALONG_JUMP_HEIGHT (meters 1.0))

(defun mp-ride-along-update-camera-speed! ((ride-along-active? symbol))
  (let ((rapid-tracking-needed? (and ride-along-active?
                                     (mp-local-player-daxter?)
                                     (mp-target-ride-along? *target*)
                                     (mp-any-remote-players-driving?))))
    (cond
      ((and rapid-tracking-needed? (not *mp-ride-along-rapid-camera?*))
       (set-setting! 'rapid-tracking #f 0.0 0)
       (set! *mp-ride-along-rapid-camera?* #t))
      ((and (not rapid-tracking-needed?) *mp-ride-along-rapid-camera?*)
       (remove-setting! 'rapid-tracking)
       (set! *mp-ride-along-rapid-camera?* #f))))
  (none))

(defun mp-ride-along-sync-camera-target! ((local-target target) (ride-target target))
  (when (and (nonnull? local-target *camera*) (mp-target-daxter? local-target))
    (let ((current-target (handle->process (-> *camera* focus handle))))
      (if (nonnull? ride-target)
        (when (!= current-target ride-target)
          (send-event *camera* 'change-target ride-target))
        (when (!= current-target local-target)
          (send-event *camera*
                      'change-target
                      local-target)))))
  (none))

(defun get-attached-jak-proc ((this target))
  (when (and (nonnull? this) (mp-player-id-valid? (the uint (-> this riding-along-player-id))))
    (let ((jak-target (mp-player-target-by-id (-> this riding-along-player-id))))
      (when (and (nonnull? jak-target (-> jak-target control))
                 (mp-target-jak? jak-target)
                 (not (focus-test? jak-target dead inactive))
                 (= (-> jak-target riding-along-player-id) (-> this player-id)))
        (return jak-target))))
  (the-as target #f))

(defun release-ride-along! ((rider target))
  (when (nonnull? rider)
    (let ((jak-target (mp-player-target-by-id (-> rider riding-along-player-id))))
      (when (and (nonnull? jak-target) (= (-> jak-target riding-along-player-id) (-> rider player-id)))
        (set! (-> jak-target riding-along-player-id) MP_INVALID_PLAYER_ID)))
    (set! (-> rider riding-along-player-id) MP_INVALID_PLAYER_ID))
  (none))

(defun get-ride-along-position! ((position vector) (jak-target target))
  (unless (nonnull? position jak-target (-> jak-target control))
    (return #f))
  (let ((attachment (-> jak-target control sidekick-root parent)))
    (when (nonnull? (-> jak-target sidekick))
      (let ((sidekick-proc (the-as sidekick (ppointer->process (-> jak-target sidekick)))))
        (when (and (nonnull? sidekick-proc (-> sidekick-proc node-list)) (> (-> sidekick-proc node-list length) 0))
          (let ((root (-> sidekick-proc node-list data 0)))
            (when (and (nonnull? root (-> root bone)) (!= (-> root bone transform trans w) 0.0))
              (set! attachment root))))))
    (unless (and (nonnull? attachment (-> attachment bone)) (!= (-> attachment bone transform trans w) 0.0))
      (return #f))
    (vector<-cspace! position attachment))
  #t)

(defbehavior update-ride-along-transform! target ()
  (unless (nonnull? (-> self control))
    (return #f))
  (let ((jak-target (get-attached-jak-proc self)))
    (unless (and (nonnull? jak-target) (get-ride-along-position! (-> self control trans) jak-target))
      (return #f))
    (quaternion-copy! (-> self control quat) (-> jak-target control quat))
    (quaternion-copy! (-> self control dir-targ) (-> jak-target control quat))
    (quaternion-copy! (-> self control quat-for-control) (-> jak-target control quat))
    (vector-copy! (-> self control transv) (-> jak-target control transv)))
  #t)

(defbehavior jump-off-jak target ()
  (log 'debug "[Daxter-Ride-Along] Exiting ride along state...~%")
  (go target-indax-jump
      (-> *TARGET-bank* indax-jump-height-min)
      (-> *TARGET-bank* indax-jump-height-max)
      (the-as surface #f)))

(defbehavior update-ride-along-jump! target ((progress float) (start-rotation quaternion))
  (unless (nonnull? (-> self control) start-rotation)
    (return #f))
  (let ((jak-target (get-attached-jak-proc self))
        (destination (new 'stack-no-clear 'vector))
        (blend (smooth-step progress)))
    (unless (and (nonnull? jak-target) (get-ride-along-position! destination jak-target))
      (return #f))
    (vector-lerp! (-> self control trans) (-> self alt-cam-pos) destination blend)
    (+! (-> self control trans y) (* RIDE_ALONG_JUMP_HEIGHT (sin (* 32768.0 blend))))
    (quaternion-slerp! (-> self control quat) start-rotation (-> jak-target control quat) blend)
    (quaternion-copy! (-> self control dir-targ) (-> self control quat))
    (quaternion-copy! (-> self control quat-for-control) (-> self control quat)))
  #t)

(defstate target-ride-along (target)
  :event target-ride-along-handler
  :enter
    (behavior ()
      (set! (-> self control transv quad) (the-as uint128 0))
      (set! (-> self control ctrl-xz-vel) 0.0)
      (set! (-> self control root-prim prim-core action) (collide-action))
      (logior! (-> self focus-status) (focus-status indax ignore))
      (logior! (-> self draw status) (draw-control-status no-draw no-draw-bounds2))
      (when (and (not-player-replica? self) (mp-target-daxter? self))
        (let ((jak-proc (get-attached-jak-proc self)))
          (when (nonnull? jak-proc)
            (mp-ride-along-update-camera-speed! #t)
            (mp-ride-along-sync-camera-target! self jak-proc))))
      (when (nonnull? (-> self sidekick))
        (let ((sidekick-proc (the-as sidekick (ppointer->process (-> self sidekick)))))
          (when (nonnull? sidekick-proc (-> sidekick-proc draw))
            (logclear! (-> sidekick-proc draw status) (draw-control-status no-draw))
            (send-event sidekick-proc 'matrix #f)))))
  :exit
    (behavior ()
      (update-ride-along-transform!)
      (set! (-> self control ctrl-xz-vel) (vector-xz-length (-> self control transv)))
      (set! (-> self control root-prim prim-core action) (collide-action solid can-ride stuck-wall-escape))
      (logclear! (-> self focus-status) (focus-status ignore))
      (when (nonnull? (-> self draw))
        (logclear! (-> self draw status) (draw-control-status no-draw no-draw-bounds2)))
      (when (not-player-replica? self)
        (mp-ride-along-update-camera-speed! #f)
        (mp-ride-along-sync-camera-target! self (the-as target #f)))
      (when (and (nonnull? (-> self next-state)) (= (-> self next-state name) 'target-indax-grab))
        (set! *local-riding-before-grabbed?* #t))
      (release-ride-along! self)
      (target-indax-init #f))
  :trans
    (behavior ()
      (unless (nonnull? (get-attached-jak-proc self))
        (jump-off-jak))
      (draw-ride-along-prompt! (text-id press-x-to-hop-off))
      (when (and (not-player-replica? self)
                 (not (real-movie?))
                 (nonnull? (-> self control) (-> self control cpad))
                 (cpad-pressed? (-> self control cpad number) x))
        (jump-off-jak)))
  :code
    (behavior ()
      (until #f
        (suspend)))
  :post
    (behavior ()
      (unless (nonnull? self (-> self control) (-> self draw) (-> self node-list) (-> self skel))
        (return (the-as none 0)))
      (set! (-> self control transv quad) (the-as uint128 0))
      (set! (-> self control remaining-ctrl-iterations) 0)
      (flag-setup)
      (post-flag-setup)
      (ja-post)
      (unless (update-ride-along-transform!)
        (jump-off-jak))
      (set! (-> self control gspot-pos quad) (-> self control trans quad))
      (joint-points)
      (do-joint-math (-> self draw) (-> self node-list) (-> self skel))
      (update-transforms (-> self control))
      (target-powerup-process)
      (when (and (not-player-replica? self) (mp-target-daxter? self))
        (mp-ride-along-update-camera-speed! #t)
        (mp-ride-along-sync-camera-target! self (get-attached-jak-proc self)))))

(defstate target-indax-jump-on (target)
  :event target-indax-handler
  :enter
    (behavior ((jak-player-id uint))
      (let ((jak-proc (mp-player-target-by-id jak-player-id)))
        (unless (and (nonnull? jak-proc (-> jak-proc control))
                     (mp-target-jak? jak-proc)
                     (not (focus-test? jak-proc dead inactive)))
          (go target-indax-stance))
        (let ((rider (get-jak-rider jak-proc))) (when (and (nonnull? rider) (!= rider self)) (go target-indax-stance)))
        (set! (-> self riding-along-player-id) jak-player-id)
        (set! (-> jak-proc riding-along-player-id) (-> self player-id)))
      (set! (-> self control mod-surface) *empty-mods*)
      (set! (-> self control transv quad) (the-as uint128 0))
      (vector-copy! (-> self alt-cam-pos) (-> self control trans))
      (logclear! (-> self draw status) (draw-control-status no-draw))
      (logior! (-> self draw status) (draw-control-status no-draw-bounds2)))
  :exit
    (behavior ()
      (unless (and (nonnull? (-> self next-state)) (= (-> self next-state name) 'target-ride-along))
        (release-ride-along! self))
      (target-indax-exit))
  :code
    (behavior ()
      (sound-play "jump")
      (let ((start-rotation (new 'stack-no-clear 'quaternion)))
        (quaternion-copy! start-rotation (-> self control quat))
        (ja-channel-push! 1 (seconds 0.05))
        (ja :group! daxter-indax-jump-ja :num! (seek!) :frame-num 0.0)
        (until (ja-done? 0)
          (unless (update-ride-along-jump! (/ (ja-frame-num 0) (the float (max 1 (- (ja-num-frames 0) 1))))
                                           start-rotation)
            (go target-indax-falling #f))
          (suspend)
          (ja :num! (seek!)))
        (unless (update-ride-along-jump! 1.0 start-rotation)
          (go target-indax-falling #f)))
      (go target-ride-along))
  :post target-no-move-post)
