;;-*-Lisp-*-
(in-package goal)

(define-extern get-daxter-seat-offset (function target vector))

(defun get-daxter-pose-owner ((tgt target))
  (if (nonnull? tgt (-> tgt sidekick))
    (as-type (ppointer->process (-> tgt sidekick)) sidekick)
    (the-as sidekick #f)))

(defun daxter-copy-pose-channels! ((dst joint-control) (src joint-control))
  (when (nonnull? dst src)
    (joint-control-copy! dst src)
    (set! (-> dst float-channels) (-> src float-channels))
    (mem-copy! (the-as pointer (-> dst channel (-> src active-channels)))
               (the-as pointer (-> src channel (-> src active-channels)))
               (* 64 (-> src float-channels)))
    (dotimes (index (the-as int (-> dst float-channels)))
      (set! (-> dst channel (+ index (-> dst active-channels)) parent) dst))
    (set! (-> dst active-frame-interp) (-> src active-frame-interp))
    (set! (-> dst interp-select 0) (-> src interp-select 0))
    (set! (-> dst interp-select 1) (-> src interp-select 1))
    (set! (-> dst generate-frame-function) (-> src generate-frame-function)))
  (none))

(defun daxter-sync-look! ((owner sidekick) (tgt target))
  (when (nonnull? owner (-> owner neck) (-> owner head) tgt (-> tgt neck))
    (set! (-> owner neck flex-blend) 0.0)
    (let ((head (-> owner head))
          (source (-> tgt neck)))
      (when (!= (-> head mode) (joint-mod-mode look-at))
        (mode-set! head (joint-mod-mode look-at)))
      (set! (-> head ignore-angle) (-> owner neck ignore-angle))
      (set! (-> head target quad) (-> source target quad))
      (set! (-> head blend) (-> source blend))
      (set! (-> head flex-blend) (-> source flex-blend))
      (set! (-> head notice-time) (-> source notice-time))))
  (none))

(defun daxter-init-arm-ik! ((owner sidekick))
  (when (nonnull? owner (-> owner node-list))
    (dotimes (hand 2)
      (when (not (nonnull? (-> owner arm-ik hand)))
        (let ((elbow-index (cspace-index-by-name owner (if (zero? hand) "Lelbow" "Relbow"))))
          (when (>= elbow-index 3)
            (with-pp
              (let ((pp owner))
                (set! (-> owner arm-ik hand) (new 'process 'joint-mod-ik owner elbow-index 0.0)))))))))
  (none))

(defun daxter-pilot-seated? ((tgt target))
  (and (nonnull? tgt (-> tgt pilot))
       (focus-test? tgt indax)
       (focus-test? tgt pilot-riding)
       (-> tgt pilot as-daxter?)
       (not (daxter-stadium-bike? tgt))
       (nonnull? (handle->process (-> tgt pilot vehicle)))))

(defun daxter-sync-pilot-arms! ((owner sidekick) (tgt target))
  (when (nonnull? owner tgt)
    (let ((driver? (and (daxter-pilot-seated? tgt) (zero? (-> tgt pilot seat-index)))))
      (dotimes (hand 2)
        (let ((arm (-> owner arm-ik hand))
              (source (-> tgt arm-ik hand)))
          (when (nonnull? arm)
            (let ((enabled? (if (and driver? (nonnull? source)
                                    (logtest? (-> source flags) (joint-mod-ik-flags enable))) #t #f)))
              (enable-set! arm enabled?)
              (if enabled?
                (handle-copy! arm (-> source handle-pos))
                (set! (-> arm blend) 0.0))))))))
  (none))

(defun daxter-seat-pose! ((main transformq) (hips transformq) (neck transformq) (tgt target))
  (when (nonnull? main hips neck tgt (-> tgt pilot))
    (let ((offset (get-daxter-seat-offset tgt))
          (seat-offset (new 'stack-no-clear 'vector))
          (seat-position (new 'stack-no-clear 'vector)))
      (when (nonnull? offset)
        (when (and (zero? (-> tgt pilot stance)) (zero? (-> tgt pilot seat-index)))
          (quaternion-rotate-local-x! (-> main quat) (-> main quat) (degrees 65))
          (quaternion-rotate-local-x! (-> neck quat) (-> neck quat) (degrees -65)))
        (vector-float*! seat-position offset (meters 1))
        (vector-rotate*! seat-offset (-> hips trans)
                        (matrix<-transformq! (new 'stack-no-clear 'matrix) main))
        (vector-! (-> main trans) seat-position seat-offset))))
  (none))

(defun daxter-prepare-pilot-frame! ((frame joint-anim-frame) (joint-count int) (owner sidekick))
  (when (nonnull? frame owner (-> owner node-list) (-> owner parent))
    (dotimes (hand 2)
      (let ((arm (-> owner arm-ik hand))
            (hand-index (cspace-index-by-name owner (if (zero? hand) "Lhand" "Rhand"))))
        (when (and (nonnull? arm) (>= hand-index 3) (< hand-index (+ joint-count 1)))
          (set! (-> arm hand-dist) (-> frame data (- hand-index 3) trans y)))))
    (let ((tgt (the-as target (ppointer->process (-> owner parent)))))
      (when (daxter-pilot-seated? tgt)
        (let ((main-index (cspace-index-by-name owner "main"))
              (hips-index (cspace-index-by-name owner "hips"))
              (neck-index (cspace-index-by-name owner "neckB")))
          (when (and (>= main-index 3) (>= hips-index 3) (>= neck-index 3)
                     (< main-index (+ joint-count 1)) (< hips-index (+ joint-count 1))
                     (< neck-index (+ joint-count 1)))
            (daxter-seat-pose! (-> frame data (- main-index 3))
                              (-> frame data (- hips-index 3))
                              (-> frame data (- neck-index 3)) tgt))))))
  (none))

(defun daxter-rolling-pose? ((self sidekick) (skel joint-control))
  (when (nonnull? self (-> self draw) (-> self draw art-group) skel)
    (dotimes (index (the-as int (-> skel active-channels)))
      (let ((channel (-> skel channel index)))
        (when (and (nonnull? channel (-> channel frame-group))
                   (nonzero? (-> channel inspector-amount))
                   (or (= (-> channel frame-group) daxter-duck-roll-ja)
                       (= (-> channel frame-group) daxter-duck-roll-end-ja)
                       (= (-> channel frame-group) daxter-roll-flip-ja)
                       (= (-> channel frame-group) daxter-roll-flip-land-ja)))
          (return #t)))))
  #f)

(defun daxter-soften-jump-scale! ((frame joint-anim-frame) (joint-count int) (self sidekick) (skel joint-control))
  (unless (nonnull? frame self (-> self draw) (-> self draw art-group) skel (-> skel root-channel))
    (return 0))
  (let ((clip (-> skel root-channel 0 frame-group)))
    (unless (and (nonnull? clip)
                 (or (= clip daxter-indax-jump-ja)
                     (= clip daxter-indax-jump-land-ja)
                     (= clip daxter-pole-cycle-ja)
                     (= clip daxter-pole-cycle2-ja)
                     (= clip daxter-pole-flip-forward-ja)
                     (= clip daxter-pole-jump-loop-ja)
                     (= clip daxter-pole-flip-forward-ja)
                     (= clip daxter-indax-attack-spin-air-ja)
                     (= clip daxter-indax-jump-forward-ja)
                     (= clip daxter-indax-jump-loop-ja)))
      (return 0)))
  (dotimes (index 2)
    (dotimes (axis 3)
      (let* ((basis (-> frame matrices index vector axis))
             (scale (vector-length basis)))
        (when (> scale 0.0)
          (vector-normalize! basis (lerp 1.0 scale 0.6))))))
  (dotimes (index (- joint-count 2))
    (let ((scale (-> frame data index scale)))
      (set! (-> scale x) (lerp 1.0 (-> scale x) 0.6))
      (set! (-> scale y) (lerp 1.0 (-> scale y) 0.6))
      (set! (-> scale z) (lerp 1.0 (-> scale z) 0.65))))
  0)

(defun daxter-prepare-render-frame! ((frame joint-anim-frame) (joint-count int) (skel joint-control))
  (let* ((owner (as-type PP sidekick))
         (tgt (if (nonnull? owner (-> owner parent))
                (as-type (ppointer->process (-> owner parent)) target) (the-as target #f))))
    (daxter-soften-jump-scale! frame joint-count owner skel)
    (daxter-prepare-pilot-frame! frame joint-count owner)
    (cond
      ((daxter-stadium-bike? tgt) (none))
      ((rider-gun-pose? tgt)
       (prepare-rider-gun-frame! frame joint-count skel))
      ((and (nonnull? tgt) (focus-test? tgt edge-grab)) (none))
      ((not (daxter-rolling-pose? owner skel))
       (rebase-gun-upper-body! frame joint-count skel))))
  0)

(defun daxter-update-render-pose! ((owner sidekick))
  (when (nonnull? owner (-> owner parent) (-> owner skel) (-> owner draw) (-> owner node-list))
    (let ((tgt (the-as target (ppointer->process (-> owner parent)))))
      (when (and (nonnull? tgt (-> tgt skel) (-> tgt draw))
                 (or (!= (-> owner pose-time) (current-time))
                     (focus-test? tgt edge-grab) (focus-test? tgt pilot-riding)))
        (set! (-> owner draw status) (-> tgt draw status))
        (logclear! (-> owner draw status) (draw-control-status no-draw-bounds2))
        (daxter-init-arm-ik! owner)
        (daxter-sync-pilot-arms! owner tgt)
        (when (!= (-> owner pose-time) (current-time))
          (daxter-copy-pose-channels! (-> owner skel) (-> tgt skel))
          (set! (-> owner skel prebind-function) daxter-prepare-render-frame!)
          (daxter-sync-look! owner tgt)
          (sidekick-apply-visual-head! owner)
          (with-pp
            (let ((pp owner))
              (evaluate-joint-control owner)))
          (set! (-> owner pose-time) (current-time)))
        (do-joint-math (-> owner draw) (-> owner node-list) (-> owner skel)))))
  (none))

(defun daxter-copy-control-joint! ((owner sidekick) (node cspace))
  (when (nonnull? owner (-> owner node-list) node (-> node bone))
    (let ((source (-> owner node-list data 0)))
      (when (nonnull? (-> node joint) (-> node joint name))
        (let ((matching (cspace-by-name owner (the-as string (-> node joint name)))))
          (when (nonnull? matching) (set! source matching))))
      (when (nonnull? source (-> source bone))
        (cspace<-cspace! node source)
        (set! (-> node bone scale quad) (-> source bone scale quad)))))
  (none))

(defun daxter-control-pose! ((draw draw-control) (nodes cspace-array) (skel joint-control))
  (when (nonnull? draw (-> draw process) nodes skel)
    (let* ((tgt (the-as target (-> draw process)))
           (owner (get-daxter-pose-owner tgt)))
      (when (nonnull? owner (-> owner draw) (-> owner node-list))
        (daxter-bind-pose! tgt)
        (daxter-update-render-pose! owner)
        (dotimes (index (-> nodes length))
          (daxter-copy-control-joint! owner (-> nodes data index)))
        (set! (-> draw origin quad) (-> owner draw origin quad)))))
  (none))

(defun daxter-bind-pose! ((tgt target))
  (let ((owner (get-daxter-pose-owner tgt)))
    (when (nonnull? tgt (-> tgt skel) (-> tgt skel top-anim) (-> tgt control)
                    owner (-> owner node-list))
      (let ((skel (-> tgt skel))
            (left-hand (cspace-by-name owner "Lhand"))
            (right-hand (cspace-by-name owner "Rhand")))
        (when (not (logtest? (-> skel status) (joint-control-status external-pose)))
          (reset (-> skel top-anim))
          (set! (-> skel float-channels) 0)
          (set! (-> skel generate-frame-function) create-interpolated-joint-animation-frame)
          (set! (-> owner pose-time) (- (current-time) 1))
          (when (and (nonnull? (-> tgt gun)) (using-gun? tgt))
            (bind-target-gun-joints! tgt)
            (set! (-> skel top-anim interp) 1.0)))
        (set-gun-joint-mask! owner (-> skel top-anim) (not (rider-gun-pose? tgt)))
        (set! (-> skel interp-select 0) (the-as int (-> skel top-anim interp-select 0)))
        (set! (-> skel interp-select 1) (the-as int (-> skel top-anim interp-select 1)))
        (logior! (-> skel status) (joint-control-status external-pose))
        (logclear! (-> skel status)
                   (joint-control-status blend-shape blend-shape-valid eye-anim eye-anim-valid))
        (set! (-> skel postbind-function) daxter-control-pose!)
        (when (nonnull? left-hand) (set! (-> tgt control lhand-cspace) left-hand))
        (when (nonnull? right-hand) (set! (-> tgt control rhand-cspace) right-hand)))))
  (none))

(defun daxter-unbind-pose! ((tgt target))
  (let ((owner (get-daxter-pose-owner tgt)))
    (when (nonnull? owner)
      (dotimes (hand 2)
        (let ((arm (-> owner arm-ik hand)))
          (when (nonnull? arm)
            (enable-set! arm #f)
            (set! (-> arm blend) 0.0))))))
  (when (nonnull? tgt (-> tgt skel))
    (let ((skel (-> tgt skel)))
      (logclear! (-> skel status) (joint-control-status external-pose))
      (logior! (-> skel status) (joint-control-status blend-shape eye-anim))
      (set! (-> skel postbind-function) #f)
      (set! (-> skel float-channels) 0)
      (set! (-> skel generate-frame-function) create-interpolated-joint-animation-frame)
      (when (nonnull? (-> skel top-anim))
        (reset (-> skel top-anim))
        (when (and (nonnull? (-> tgt gun)) (using-gun? tgt))
          (bind-target-gun-joints! tgt)
          (set! (-> skel top-anim interp) 1.0)))))
  (none))
