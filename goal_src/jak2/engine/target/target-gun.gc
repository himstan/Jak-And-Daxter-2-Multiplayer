(defun gun-on-ledge? ((self target))
  (and (nonnull? self (-> self gun) (-> self skel) (-> self draw) (-> self draw art-group))
       (using-gun? self) (focus-test? self edge-grab)
       (let ((clip (ja-group)))
         (and (nonnull? clip)
              (if (focus-test? self indax)
                (or (= clip daxter-indax-jump-loop-ja)
                    (= clip daxter-falling-to-edge-grab-ja)
                    (= clip daxter-edge-grab-stance0-ja)
                    (= clip daxter-edge-grab-stance1-ja))
                (or (= clip jakb-jump-loop-ja)
                    (= clip jakb-falling-to-edge-grab-ja)
                    (= clip jakb-edge-grab-stance0-ja)
                    (= clip jakb-edge-grab-stance1-ja)))))))

(defun place-gun-on-ledge! ((tgt target) (attachment matrix))
  (when (nonnull? tgt (-> tgt gun) (-> tgt control) (-> tgt edge-grab-state)
                  (-> tgt edge-grab-state info) (-> tgt node-list) (-> tgt node-list data 0)
                  (-> tgt node-list data 0 bone) attachment)
    (let ((offset (new 'static 'vector :y 491.52 :w 1.0))
          (rotation (new 'static 'vector :x -16384.0 :z -16384.0 :w 1.0))
          (orientation (new 'stack-no-clear 'quaternion)))
      (matrix-rotate-xyz! attachment rotation)
      (matrix->quaternion orientation attachment)
      (vector+! (-> tgt gun gun-pos trans) (-> tgt edge-grab-state info center-hold) offset)
      (vector+float*! (-> tgt gun gun-pos trans) (-> tgt gun gun-pos trans)
                     (-> tgt node-list data 0 bone transform vector 2) 778.24)
      (quaternion-normalize! (quaternion*! (-> tgt gun gun-pos quat) (-> tgt control quat) orientation))))
  (none))

(defbehavior target-gun-compute-pos target ()
  (let* ((owner (get-target-pose-owner self))
         (gun-joint (if (nonnull? owner (-> owner node-list)) (cspace-by-name owner "gun") (the-as cspace #f)))
         (gp-0 (new 'stack-no-clear 'matrix)))
    (matrix-identity! gp-0)
    (unless (nonnull? self (-> self gun) (-> self control) gun-joint (-> gun-joint bone))
      (return gp-0))
    (let ((passenger (if (nonnull? (-> self sidekick))
                       (as-type (ppointer->process (-> self sidekick)) sidekick)
                       (the-as sidekick #f))))
      (if (and (< 0.0 (-> self gun gun-daxter)) (nonnull? passenger (-> passenger node-list)))
        (let ((passenger-gun (cspace-by-name passenger "gun")))
          (if (nonnull? passenger-gun (-> passenger-gun bone))
            (matrix-lerp! gp-0 (-> gun-joint bone transform) (-> passenger-gun bone transform) (-> self gun gun-daxter))
            (matrix-copy! gp-0 (-> gun-joint bone transform))))
        (matrix-copy! gp-0 (-> gun-joint bone transform))))
    (matrix->transformq (-> self gun gun-pos) gp-0)
    (set! (-> self gun gun-pos scale quad) (-> self control scale quad))
    (when (gun-on-ledge? self) (place-gun-on-ledge! self gp-0))
    gp-0
    )
  )

(defbehavior target-gun-joint-points target ()
  (when (-> self gun gun)
    (set! (-> self gun gun-daxter)
          (if (and (focus-test? self pilot-riding) (not (rider-gun-pose? self))
                   (nonzero? (-> self skel float-channels))
                   (= (-> (get-channel (-> self skel top-anim) (the-as int (+ (-> self skel float-channels) -1))) frame-interp 1)
                      1.0
                      )
                   )
              1.0
              0.0
              )
          )
    (cond
      ((using-gun? self)
       (set! (-> self gun gun-roty-targ) (y-angle (-> self control)))
       (set! (-> self gun gun-roty) (-> self gun gun-roty-targ))
       (set! (-> self gun gun-roty-rel) 0.0)
       (let ((v1-24 (get-channel (-> self skel top-anim) 0)))
         (cond
           ((not v1-24)
            )
           ((handle->process (-> self gun charge-active?))
            (cond
              ((and (not (focus-test? self indax)) (= (-> v1-24 frame-group) jakb-gun-dark-fire-ja) (>= (-> v1-24 frame-num) 8.5))
               (set! (-> v1-24 frame-num) 5.0)
               )
              ((and (= (-> v1-24 frame-group) (pilot-gun-anim dark-fire)) (>= (-> v1-24 frame-num) 8.0))
               (set! (-> v1-24 frame-num) 3.0)
               )
              )
            )
           ((and (not (focus-test? self indax)) (= (-> v1-24 frame-group) jakb-gun-dark-fire-ja) (< (-> v1-24 frame-num) 9.0))
            (set! (-> v1-24 frame-num) 10.0)
            )
           ((and (= (-> v1-24 frame-group) (pilot-gun-anim dark-fire)) (< (-> v1-24 frame-num) 9.0))
            (set! (-> v1-24 frame-num) 9.0)
            )
           )
         )
       (set! (-> self gun active?)
             (and (not (logtest? (surface-flag gun-inactive gun-hide gun-off) (-> self control current-surface flags)))
                  (time-elapsed? (-> self gun gun-get-on-time) (seconds 0.1))
                  (>= (current-time) (-> self gun surpress-time))
                  (gun-animation-allows-fire? (-> self skel top-anim frame-group) (-> self skel top-anim frame-num) #t)
                  (gun-animation-allows-fire? (-> self skel top-anim frame-group-push) 0.0 #f)))
       (if (-> self gun active?)
           (set-time! (-> self gun active-time))
           )
       (set! (-> self gun laser-active?)
             (not (logtest? (surface-flag gun-inactive gun-hide gun-off laser-hide) (-> self control current-surface flags))
                  )
             )
       (when (and (not (and (not (logtest? (surface-flag gun-inactive gun-hide gun-off) (-> self control current-surface flags)))
                            (time-elapsed? (-> self gun gun-get-on-time) (seconds 0.1))
                            (>= (current-time) (-> self gun surpress-time))
                            )
                       )
                  (and (time-elapsed? (-> self gun fire-pending-time) (seconds 0.2))
                       (time-elapsed? (-> self gun active-time) (seconds 0.2))
                       (= (-> self gun fire-pending) 1)
                       )
                  )
         (set! (-> self gun fire-pending) 0)
         0
         )
       (if (and (or (logtest? (surface-flag gun-hide gun-off) (-> self control current-surface flags))
                    (logtest? (state-flags prevent-gun) (-> self state-flags))
                    (let ((v1-75 (-> self gun gun-type)))
                      (or (and (not-player-replica? self) (cond
                                 ((= v1-75 (pickup-type eco-yellow))
                                  ;; og:preserve-this - High FPS Fix - https://github.com/open-goal/jak-project/pull/3178
                                  (recently-pressed? down)
                                  )
                                 ((= v1-75 (pickup-type eco-red))
                                  ;; og:preserve-this - High FPS Fix - https://github.com/open-goal/jak-project/pull/3178
                                  (recently-pressed? up)
                                  )
                                 ((= v1-75 (pickup-type eco-blue))
                                  ;; og:preserve-this - High FPS Fix - https://github.com/open-goal/jak-project/pull/3178
                                  (recently-pressed? left)
                                  )
                                 (else
                                   ;; og:preserve-this - High FPS Fix - https://github.com/open-goal/jak-project/pull/3178
                                   (recently-pressed? right)
                                   )
                                 )
                               (and (not (cpad-hold? (-> self control cpad number) r1))
                                    (not (logtest? (surface-flag gun-inactive) (-> self control current-surface flags)))
                                    (not (logtest? (-> self focus-status) (focus-status grabbed)))
                                    )
                               )
                          (-> self gun put-away?)
                          (not (logtest? (-> self game features) (game-feature gun)))
                          (not (logtest? (the-as game-feature (ash 1 (+ (-> self gun gun-type) 5)))
                                         (logand (-> self game features) (-> *setting-control* user-current features))
                                         )
                               )
                          (focus-test? self dead dark)
                          (-> self board latch?)
                          )
                      )
                    )
                (time-elapsed? (-> self gun gun-get-on-time) (seconds 0.1))
      (let ((v1-110 (-> self skel top-anim frame-targ)))
        (or (not v1-110)
            (= v1-110 jakb-gun-side-jump-ja)
            (= v1-110 jakb-gun-front-jump-ja)
            (= v1-110 jakb-gun-side-jump-land-ja)
                      (= v1-110 jakb-gun-front-jump-land-ja)
                      (= v1-110 jakb-gun-front-run-ja)
                      (= v1-110 jakb-gun-front-walk-ja)
                      (= v1-110 jakb-gun-run-blue-ja)
                      (= v1-110 jakb-gun-walk-blue-ja)
                      (logtest? (surface-flag gun-fast-exit) (-> self control current-surface flags))
                      )
                  )
                )
           (target-gun-end-mode (not (logtest? (surface-flag gun-hide) (-> self control current-surface flags))))
           )
       )
      (else
        (set! (-> self gun active?) #f)
        )
      )
    )
  0
  (none)
  )

