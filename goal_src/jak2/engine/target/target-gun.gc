(defun gun-takeout-animation? ((anim art-joint-anim))
  (and (nonnull? anim (-> anim name))
       (nmember (-> anim name)
                '("jakb-gun-red-takeout" "jakb-gun-yellow-takeout" "jakb-gun-blue-takeout" "jakb-gun-dark-takeout"
                  "jakb-pilot-gun-red-takeout" "jakb-pilot-gun-yellow-takeout" "jakb-pilot-gun-blue-takeout" "jakb-pilot-gun-dark-takeout"
                  "daxter-pilot-gun-red-takeout" "daxter-pilot-gun-yellow-takeout" "daxter-pilot-gun-blue-takeout" "daxter-pilot-gun-dark-takeout"))))

(defun gun-animation-allows-fire? ((anim art-joint-anim) (frame float) (check-frame? symbol))
  (or (not (nonnull? anim (-> anim name)))
      (and (not (gun-takeout-animation? anim))
           (not (nmember (-> anim name)
                         '("jakb-pilot-gun-red-dark" "jakb-pilot-gun-red-yellow" "jakb-pilot-gun-red-blue" "jakb-pilot-gun-yellow-blue"
                           "daxter-pilot-gun-red-dark" "daxter-pilot-gun-red-yellow" "daxter-pilot-gun-red-blue" "daxter-pilot-gun-yellow-blue"
                           "jakb-gun-dark-fire-twirl" "jakb-gun-yellow-fire-twirl" "jakb-gun-transformation-twirl"
                           "jakb-gun-front-to-side-hop" "jakb-gun-side-to-front-hop" "jakb-gun-blue-to-front-hop" "jakb-gun-front-to-blue-hop"
                           "jakb-gun-hit-from-front" "jakb-gun-hit-from-back")))
           (not (and check-frame? (<= frame 6.8)
