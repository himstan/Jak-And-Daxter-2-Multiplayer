(defun handle-gun-equip-marking-menu ((this target) (gun-type uint))
  (when (nonnull? this (-> this clock) (-> this gun) (-> this game) (-> this skel) (-> this skel top-anim)
                  *setting-control* (-> *setting-control* user-current))
    (let ((top (-> this skel top-anim))
          (equipped? (using-gun? this)))
      (when (and (nonzero? gun-type)
                 (logtest? (the-as game-feature (ash 1 (+ gun-type 5)))
                           (logand (-> this game features) (-> *setting-control* user-current features)))
                 (or (not (focus-test? this pilot)) (and (nonnull? (-> this pilot)) (-> this pilot gun?)))
                 (!= gun-type (the-as uint (-> this gun gun-type)))
                 (or (not equipped?) (not (nonnull? (-> top frame-targ))) (gun-takeout-animation? (-> top frame-targ)))
                 (not (handle->process (-> this gun charge-active?))))
        (set! (-> this gun using-gun-type) (the-as pickup-type gun-type))
        (cond
          (equipped?
           (set! (-> this gun gun-get-on-time) (-> this clock frame-counter))
           (when (not-player-replica? this) (sound-play "select-option"))
           (send-event this 'gun-type gun-type))
          ((want-to-gun? this #t)
           (send-event this 'change-mode 'gun #f gun-type))))))
  (none))

(defun target-gun-marking-menu ((this target))
  (when (and (not (mp-local-player-dead-or-spectating?))
             (not (paused?))
             (not (and (focus-test? this dark) (nonzero? (-> this darkjak))))
             (not (logtest? (-> this focus-status) (focus-status grabbed)))
             (not-player-replica? this)
             )
    (let ((selected-gun-type (the-as uint (-> this gun using-gun-type))))
      (cond
        ((cpad-pressed? (-> this control cpad number) down)
         (set! selected-gun-type (the-as uint 1))
         )
        ((cpad-pressed? (-> this control cpad number) up)
         (set! selected-gun-type (the-as uint 2))
         )
        ((cpad-pressed? (-> this control cpad number) left)
         (set! selected-gun-type (the-as uint 3))
         )
        ((cpad-pressed? (-> this control cpad number) right)
         (set! selected-gun-type (the-as uint 4))
         )
        )
      (handle-gun-equip-marking-menu this selected-gun-type)
    )
    )
  0
  (none)
  )

