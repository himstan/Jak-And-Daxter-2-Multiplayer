;;-*-Lisp-*-
(in-package goal)

(define *static-actor-registry*
  (new 'global 'boxed-array static-actor-definition STATIC_ACTOR_REGISTRY_MAX))
(define *static-actor-registry-count* 0)

(defun static-actor-log-error ((definition static-actor-definition) (reason string))
  (when (and definition (nonzero? definition))
    (format 0
            "[static-actor] skipped level=~A actor=~A: ~A~%"
            (-> definition level)
            (-> definition name)
            reason)
    )
  (none)
  )

(defun static-actor-log-property-error ((definition static-actor-definition)
                                        (property static-actor-property)
                                        (reason string))
  (format 0
          "[static-actor] skipped level=~A actor=~A property=~A: ~A~%"
          (-> definition level)
          (-> definition name)
          (if (and property (nonzero? property)) (-> property name) 'unknown)
          reason)
  (none)
  )

(defun static-actor-definition-conflicts? ((definition static-actor-definition))
  (dotimes (registry-idx *static-actor-registry-count*)
    (let ((registered (the-as static-actor-definition (-> *static-actor-registry* registry-idx))))
      (when (and registered (nonzero? registered))
        (when (= (-> registered aid) (-> definition aid))
          (return #t)
          )
        (when (and (-> registered name)
                   (nonzero? (-> registered name))
                   (-> definition name)
                   (nonzero? (-> definition name))
                   (= (-> registered level) (-> definition level))
                   (string= (-> registered name) (-> definition name)))
          (return #t)
          )
        )
      )
    )
  #f
  )

(defun static-actor-registration-valid? ((definition static-actor-definition))
  (cond
    ((or (not (-> definition level))
         (not (-> definition name))
         (zero? (-> definition name))
         (= (length (-> definition name)) 0)
         (not (-> definition etype)))
     (static-actor-log-error definition "level, name, or actor type is missing")
     #f
     )
    ((or (< (the-as uint (-> definition aid)) STATIC_ACTOR_AID_MIN)
         (> (the-as uint (-> definition aid)) STATIC_ACTOR_AID_MAX))
     (static-actor-log-error definition "AID is outside the custom range")
     #f
     )
    (else
      #t
      )
    )
  )

(defun register-static-actor! ((definition static-actor-definition))
  (cond
    ((or (not definition) (zero? definition))
     #f
     )
    ((>= *static-actor-registry-count* STATIC_ACTOR_REGISTRY_MAX)
     (static-actor-log-error definition "registry is full")
     #f
     )
    ((not (static-actor-registration-valid? definition))
     #f
     )
    ((static-actor-definition-conflicts? definition)
     (static-actor-log-error definition "duplicate registered name or AID")
     #f
     )
    (else
      (set! (-> *static-actor-registry* *static-actor-registry-count*) definition)
      (+! *static-actor-registry-count* 1)
      #t
      )
    )
  )

(defun static-actor-resolve-type ((definition static-actor-definition))
  (when (and definition (nonzero? definition))
    (let ((etype-symbol (-> definition etype)))
      (when (and etype-symbol (nonzero? etype-symbol))
        (let ((etype-value (-> etype-symbol value)))
          (when (and etype-value
                     (nonzero? etype-value)
                     (valid? etype-value type (the-as string #f) #f 0))
            (return (the-as type etype-value))
            )
          )
        )
      )
    )
  (the-as type #f)
  )

(defun static-actor-required-art-valid? ((definition static-actor-definition))
  (let ((required (-> definition required-art-groups)))
    (when (and required (nonzero? required))
      (dotimes (art-idx (-> required length))
        (let ((art-name (the-as string (-> required art-idx))))
          (when (or (not art-name)
                    (zero? art-name)
                    (not *level*)
                    (zero? *level*)
                    (not (art-group-get-by-name *level* art-name (the-as (pointer uint32) #f))))
            (return #f)
            )
          )
        )
      )
    )
  #t
  )

(defun static-actor-path-knots-valid? ((property static-actor-property))
  (let ((point-count (-> property elt-count))
        (knots (the-as (array float) (-> property extra))))
    (when (< point-count 4)
      (return #f)
      )
    (when (and knots (nonzero? knots))
      (when (!= (-> knots length) (+ point-count 4))
        (return #f)
        )
      (dotimes (knot-idx (-> knots length))
        (when (and (> knot-idx 0)
                   (< (the-as float (-> knots knot-idx))
                      (the-as float (-> knots (+ knot-idx -1)))))
          (return #f)
          )
        )
      )
    )
  #t
  )

(defun static-actor-property-type ((property static-actor-property))
  (when (and property (nonzero? property))
    (let ((type-symbol (-> property elt-type)))
      (when (and type-symbol (nonzero? type-symbol))
        (let ((type-value (-> type-symbol value)))
          (when (and type-value
                     (nonzero? type-value)
                     (valid? type-value type (the-as string #f) #f 0))
            (return (the-as type type-value))
            )
          )
        )
      )
    )
  (the-as type #f)
  )

(defun static-actor-property-valid? ((property static-actor-property))
  (when (or (not property)
            (zero? property)
            (not (-> property name))
            (zero? (-> property name))
            (<= (-> property elt-count) 0))
    (return #f)
    )
  (case (-> property kind)
    (('string 'symbol 'vector)
     (and (-> property data) (nonzero? (-> property data)))
     )
    (('int 'uint 'float)
     #t
     )
    (('float-array 'vector-array)
     (let ((values (the-as (array object) (-> property data))))
       (and values
            (nonzero? values)
            (= (-> values length) (-> property elt-count)))
       )
     )
    (('path)
     (let ((points (the-as (array vector) (-> property data))))
       (and points
            (nonzero? points)
            (= (-> points length) (-> property elt-count))
            (-> property secondary-name)
            (nonzero? (-> property secondary-name))
            (static-actor-path-knots-valid? property))
       )
     )
    (('raw)
     (and (static-actor-property-type property) (-> property data))
     )
    (else
      #f
      )
    )
  )

(defun static-actor-properties-valid? ((definition static-actor-definition))
  (let ((properties (-> definition properties)))
    (when (and properties (nonzero? properties))
      (dotimes (property-idx (-> properties length))
        (let ((property (the-as static-actor-property (-> properties property-idx))))
          (when (or (not property) (zero? property))
            (static-actor-log-property-error definition property "property descriptor is null")
            (return #f)
            )
          (when (and (= (-> property kind) 'path)
                     (not (static-actor-path-knots-valid? property)))
            (static-actor-log-property-error
              definition
              property
              "path needs at least four points and point-count+4 nondecreasing knots")
            (return #f)
            )
          (unless (static-actor-property-valid? property)
            (static-actor-log-property-error
              definition
              property
              "type, data pointer, or element count is invalid")
            (return #f)
            )
          (when (or (= (-> property name) 'name)
                    (= (-> property name) 'vis-dist))
            (static-actor-log-property-error definition property "property name is reserved")
            (return #f)
            )
          (dotimes (other-idx property-idx)
            (let ((other (the-as static-actor-property (-> properties other-idx))))
              (when (and other
                         (nonzero? other)
                         (or (= (-> property name) (-> other name))
                             (and (-> property secondary-name)
                                  (nonzero? (-> property secondary-name))
                                  (= (-> property secondary-name) (-> other name)))
                             (and (-> other secondary-name)
                                  (nonzero? (-> other secondary-name))
                                  (= (-> property name) (-> other secondary-name)))
                             (and (-> property secondary-name)
                                  (nonzero? (-> property secondary-name))
                                  (-> other secondary-name)
                                  (nonzero? (-> other secondary-name))
                                  (= (-> property secondary-name) (-> other secondary-name)))))
                (static-actor-log-property-error definition property "property tag name is duplicated")
                (return #f)
                )
              )
            )
          )
        )
      )
    )
  #t
  )

(defun static-actor-definition-valid? ((definition static-actor-definition))
  (cond
    ((or (not (-> definition level))
         (not (-> definition name))
         (zero? (-> definition name))
         (= (length (-> definition name)) 0)
         (not (-> definition etype))
         (not (-> definition trans))
         (zero? (-> definition trans))
         (not (-> definition quat))
         (zero? (-> definition quat)))
     (static-actor-log-error definition "level, name, type, translation, or rotation is missing")
     #f
     )
    ((or (< (the-as uint (-> definition aid)) STATIC_ACTOR_AID_MIN)
         (> (the-as uint (-> definition aid)) STATIC_ACTOR_AID_MAX))
     (static-actor-log-error definition "AID is outside the custom range")
     #f
     )
    ((not (static-actor-resolve-type definition))
     (static-actor-log-error definition "actor type is not resident")
     #f
     )
    ((not (static-actor-required-art-valid? definition))
     (static-actor-log-error definition "required art group is not resident")
     #f
     )
    ((not (static-actor-properties-valid? definition))
     #f
     )
    (else
      #t
      )
    )
  )

(defun static-actor-bsp-collision ((bsp bsp-header) (definition static-actor-definition))
  (let ((actors (-> bsp actors))
        (matching-name? #f)
        (matching-aid? #f)
        (matching-pair? #f))
    (when (and actors (nonzero? actors))
      (dotimes (actor-idx (-> actors length))
        (let ((actor (-> actors data actor-idx actor)))
          (when (and actor (nonzero? actor))
            (let ((same-aid? (= (-> actor aid) (-> definition aid)))
                  (same-name? #f))
              (when same-aid?
                (set! matching-aid? #t)
                )
              (let ((actor-name (res-lump-struct actor 'name string)))
                (when (and actor-name
                           (nonzero? actor-name)
                           (-> definition name)
                           (nonzero? (-> definition name))
                           (string= actor-name (-> definition name)))
                  (set! same-name? #t)
                  (set! matching-name? #t)
                  )
                )
              (when (and same-aid? same-name?)
                (set! matching-pair? #t)
                )
              )
            )
          )
        )
      )
    (cond
      (matching-pair? 'present)
      (matching-name? 'name-collision)
      (matching-aid? 'aid-collision)
      (else 'clear)
      )
    )
  )

(defun static-actor-align16 ((byte-count int))
  (logand -16 (+ byte-count 15))
  )

(defun static-actor-property-tag-count ((property static-actor-property))
  (if (= (-> property kind) 'path) 2 1)
  )

(defun static-actor-property-byte-count ((property static-actor-property))
  (case (-> property kind)
    (('string 'symbol 'int 'uint 'float)
     4
     )
    (('vector)
     16
     )
    (('float-array)
     (* (-> property elt-count) 4)
     )
    (('vector-array)
     (* (-> property elt-count) 16)
     )
    (('path)
     (+ (static-actor-align16 (* (-> property elt-count) 16))
        (* (+ (-> property elt-count) 4) 4))
     )
    (('raw)
     (let ((elt-type (static-actor-property-type property)))
       (if (-> property inlined?)
           (* (-> property elt-count) (-> elt-type size))
           (* (-> property elt-count) 4))
       )
     )
    (else
      0
      )
    )
  )

(defun static-actor-resource-shape ((definition static-actor-definition)
                                    (tag-count-out (pointer int64))
                                    (data-size-out (pointer int64)))
  (let ((tag-count 2)
        (data-size 32)
        (properties (-> definition properties)))
    (when (and properties (nonzero? properties))
      (dotimes (property-idx (-> properties length))
        (let ((property (the-as static-actor-property (-> properties property-idx))))
          (when (and property (nonzero? property))
            (+! tag-count (static-actor-property-tag-count property))
            (+! data-size (static-actor-align16 (static-actor-property-byte-count property)))
            )
          )
        )
      )
    (set! (-> tag-count-out 0) tag-count)
    (set! (-> data-size-out 0) (+ data-size 16))
    )
  (none)
  )

(defun static-actor-add-value! ((actor entity-actor)
                                (name symbol)
                                (elt-type type)
                                (value object)
                                (key-frame float))
  (let ((tag (new 'static 'res-tag
               :name name
               :key-frame key-frame
               :elt-type elt-type
               :elt-count 1
               :inlined? 1)))
    (add-32bit-data! actor tag value)
    )
  (none)
  )

(defun static-actor-add-reference! ((actor entity-actor)
                                    (name symbol)
                                    (elt-type type)
                                    (value object)
                                    (key-frame float))
  (let ((tag (new 'static 'res-tag
               :name name
               :key-frame key-frame
               :elt-type elt-type
               :elt-count 1
               :inlined? 0)))
    (add-data! actor tag (the-as pointer value))
    )
  (none)
  )

(defun static-actor-add-vector! ((actor entity-actor)
                                 (property static-actor-property))
  (let ((value (the-as vector (-> property data))))
    (when (and value (nonzero? value))
      (add-data!
        actor
        (new 'static 'res-tag
          :name (-> property name)
          :key-frame (-> property key-frame)
          :elt-type vector
          :elt-count 1
          :inlined? 1)
        (the-as pointer value))
      )
    )
  (none)
  )

(defun static-actor-add-float-array! ((actor entity-actor)
                                      (name symbol)
                                      (values (array float))
                                      (key-frame float))
  (let ((tag (allocate-data-memory-for-tag!
               actor
               (new 'static 'res-tag
                 :name name
                 :key-frame key-frame
                 :elt-type float
                 :elt-count (-> values length)
                 :inlined? 1))))
    (when tag
      (let ((destination (the-as (pointer float) (get-tag-data actor tag))))
        (dotimes (value-idx (-> values length))
          (set! (-> destination value-idx) (the-as float (-> values value-idx)))
          )
        )
      )
    )
  (none)
  )

(defun static-actor-add-vector-array! ((actor entity-actor)
                                       (name symbol)
                                       (values (array vector))
                                       (key-frame float))
  (let ((tag (allocate-data-memory-for-tag!
               actor
               (new 'static 'res-tag
                 :name name
                 :key-frame key-frame
                 :elt-type vector
                 :elt-count (-> values length)
                 :inlined? 1))))
    (when tag
      (let ((destination (get-tag-data actor tag)))
        (dotimes (value-idx (-> values length))
          (let ((value (the-as vector (-> values value-idx))))
            (when (and value (nonzero? value))
              (mem-copy! (&+ destination (* value-idx 16)) (the-as pointer value) 16)
              )
            )
          )
        )
      )
    )
  (none)
  )

(defun static-actor-fill-auto-knots! ((destination (pointer float)) (point-count int))
  (let ((knot-count (+ point-count 4))
        (interior-denominator (the float (+ point-count -3))))
    (dotimes (knot-idx knot-count)
      (cond
        ((< knot-idx 4)
         (set! (-> destination knot-idx) 0.0)
         )
        ((>= knot-idx point-count)
         (set! (-> destination knot-idx) 1.0)
         )
        (else
          (set! (-> destination knot-idx)
                (/ (the float (+ knot-idx -3)) interior-denominator))
          )
        )
      )
    )
  (none)
  )

(defun static-actor-add-path! ((actor entity-actor) (property static-actor-property))
  (let ((points (the-as (array vector) (-> property data)))
        (knots (the-as (array float) (-> property extra))))
    (static-actor-add-vector-array! actor (-> property name) points (-> property key-frame))
    (cond
      ((and knots (nonzero? knots))
       (static-actor-add-float-array!
         actor
         (-> property secondary-name)
         knots
         (-> property key-frame))
       )
      (else
        (let* ((knot-count (+ (-> property elt-count) 4))
               (tag (allocate-data-memory-for-tag!
                      actor
                      (new 'static 'res-tag
                        :name (-> property secondary-name)
                        :key-frame (-> property key-frame)
                        :elt-type float
                        :elt-count knot-count
                        :inlined? 1))))
          (when tag
            (static-actor-fill-auto-knots!
              (the-as (pointer float) (get-tag-data actor tag))
              (-> property elt-count))
            )
          )
        )
      )
    )
  (none)
  )

(defun static-actor-add-raw! ((actor entity-actor) (property static-actor-property))
  (let ((tag (allocate-data-memory-for-tag!
               actor
               (new 'static 'res-tag
                 :name (-> property name)
                 :key-frame (-> property key-frame)
                 :elt-type (static-actor-property-type property)
                 :elt-count (-> property elt-count)
                 :inlined? (if (-> property inlined?) 1 0)))))
    (when tag
      (mem-copy!
        (get-tag-data actor tag)
        (the-as pointer (-> property data))
        (length tag))
      )
    )
  (none)
  )

(defun static-actor-add-property! ((actor entity-actor) (property static-actor-property))
  (case (-> property kind)
    (('string 'symbol)
     (static-actor-add-reference!
       actor
       (-> property name)
       (static-actor-property-type property)
       (-> property data)
       (-> property key-frame))
     )
    (('int 'uint 'float)
     (static-actor-add-value!
       actor
       (-> property name)
       (static-actor-property-type property)
       (-> property data)
       (-> property key-frame))
     )
    (('vector)
     (static-actor-add-vector! actor property)
     )
    (('float-array)
     (static-actor-add-float-array!
       actor
       (-> property name)
       (the-as (array float) (-> property data))
       (-> property key-frame))
     )
    (('vector-array)
     (static-actor-add-vector-array!
       actor
       (-> property name)
       (the-as (array vector) (-> property data))
       (-> property key-frame))
     )
    (('path)
     (static-actor-add-path! actor property)
     )
    (('raw)
     (static-actor-add-raw! actor property)
     )
    )
  (none)
  )

(defun static-actor-materialize ((definition static-actor-definition))
  (local-vars (tag-count int) (data-size int))
  (static-actor-resource-shape definition (& tag-count) (& data-size))
  (let ((actor (new 'loading-level 'entity-actor tag-count data-size))
        (etype (static-actor-resolve-type definition)))
    (when (and actor (nonzero? actor) etype (nonzero? etype))
      (set! (-> actor etype) etype)
      (set! (-> actor aid) (the-as uint (-> definition aid)))
      (set! (-> actor task) (-> definition task))
      (set! (-> actor kill-mask) (-> definition kill-mask))
      (set! (-> actor vis-id) (the-as int STATIC_ACTOR_CUSTOM_VIS_ID))
      (set! (-> actor trans quad) (-> definition trans quad))
      (set! (-> actor quat quad) (-> definition quat quad))
      (static-actor-add-reference! actor 'name string (-> definition name) -1000000000.0)
      (static-actor-add-value! actor 'vis-dist float (-> definition vis-dist) -1000000000.0)
      (let ((properties (-> definition properties)))
        (when (and properties (nonzero? properties))
          (dotimes (property-idx (-> properties length))
            (let ((property (the-as static-actor-property (-> properties property-idx))))
              (when (and property (nonzero? property))
                (static-actor-add-property! actor property)
                )
              )
            )
          )
        )
      (sort! actor)
      (return actor)
      )
    )
  (the-as entity-actor #f)
  )

(defun static-actor-make-actor-array ((old-actors drawable-inline-array-actor)
                                      (capacity int))
  (let* ((extra-count (max 0 (+ capacity -1)))
         (byte-count (+ (-> drawable-inline-array-actor size)
                        (* extra-count (-> drawable-actor size))))
         (new-actors (the-as drawable-inline-array-actor
                       (object-new 'loading-level drawable-inline-array-actor
                                   (the-as int byte-count)))))
    (when (and new-actors (nonzero? new-actors))
      (set! (-> new-actors length) 0)
      (when (and old-actors (nonzero? old-actors))
        (dotimes (actor-idx (-> old-actors length))
          (set! (-> new-actors data actor-idx id)
                (-> old-actors data actor-idx id))
          (set! (-> new-actors data actor-idx bsphere quad)
                (-> old-actors data actor-idx bsphere quad))
          (set! (-> new-actors data actor-idx actor)
                (-> old-actors data actor-idx actor))
          )
        (set! (-> new-actors length) (-> old-actors length))
        )
      )
    new-actors
    )
  )

(defun static-actor-entry-aid ((actors drawable-inline-array-actor) (entry uint))
  (let* ((actor-idx (logand entry #xffff))
         (actor (-> actors data actor-idx actor)))
    (if (and actor (nonzero? actor))
        (-> actor aid)
        (the-as uint 0))
    )
  )

(defun static-actor-sort-birth-order! ((actors drawable-inline-array-actor)
                                       (birth-order (pointer uint32))
                                       (old-birth-order (pointer uint32))
                                       (old-count int))
  (dotimes (entry-idx (-> actors length))
    (set! (-> birth-order entry-idx)
          (if (and (< entry-idx old-count)
                   old-birth-order
                   (nonzero? old-birth-order))
              (-> old-birth-order entry-idx)
              (the-as uint entry-idx)))
    )
  (dotimes (entry-idx (-> actors length))
    (let ((cursor entry-idx))
      (while (> cursor 0)
        (let ((left (-> birth-order (+ cursor -1)))
              (right (-> birth-order cursor)))
          (if (<= (static-actor-entry-aid actors left)
                  (static-actor-entry-aid actors right))
              (set! cursor 0)
              (begin
                (set! (-> birth-order (+ cursor -1)) right)
                (set! (-> birth-order cursor) left)
                (-! cursor 1)
                )
              )
          )
        )
      )
    )
  (none)
  )

(defun static-actor-install-definitions! ((bsp bsp-header)
                                          (definitions (array static-actor-definition))
                                          (definition-count int))
  (let* ((old-actors (-> bsp actors))
         (old-count (if (and old-actors (nonzero? old-actors)) (-> old-actors length) 0))
         (new-actors (static-actor-make-actor-array old-actors (+ old-count definition-count))))
    (when (and new-actors (nonzero? new-actors))
      (dotimes (definition-idx definition-count)
        (let* ((definition (the-as static-actor-definition (-> definitions definition-idx)))
               (actor (static-actor-materialize definition)))
          (cond
            ((and actor (nonzero? actor))
             (set! (-> new-actors data (-> new-actors length) actor) actor)
             (+! (-> new-actors length) 1)
             )
            (else
              (static-actor-log-error definition "materialization failed")
              )
            )
          )
        )
      (when (> (-> new-actors length) old-count)
        (let ((birth-order (the-as (pointer uint32)
                             (malloc 'loading-level (* (-> new-actors length) 4)))))
          (when (and birth-order (nonzero? birth-order))
            (static-actor-sort-birth-order!
              new-actors
              birth-order
              (-> bsp actor-birth-order)
              old-count)
            (set! (-> bsp actors) new-actors)
            (set! (-> bsp actor-birth-order) birth-order)
            )
          )
        )
      )
    )
  (none)
  )

(defun static-actor-collect-for-bsp! ((bsp bsp-header)
                                      (definitions (array static-actor-definition)))
  (let ((definition-count 0))
    (dotimes (registry-idx *static-actor-registry-count*)
      (let ((definition (the-as static-actor-definition (-> *static-actor-registry* registry-idx))))
        (when (and definition
                   (nonzero? definition)
                   (= (-> definition level) (-> bsp name)))
          (case (static-actor-bsp-collision bsp definition)
            (('present)
             )
            (('name-collision)
             (static-actor-log-error definition "name collides with an existing BSP actor")
             )
            (('aid-collision)
             (static-actor-log-error definition "AID collides with an existing BSP actor")
             )
            (('clear)
             (when (static-actor-definition-valid? definition)
               (set! (-> definitions definition-count) definition)
               (+! definition-count 1)
               )
             )
            )
          )
        )
      )
    definition-count
    )
  )

(defun static-actor-augment-bsp! ((bsp bsp-header))
  (when (and bsp
             (nonzero? bsp)
             (> *static-actor-registry-count* 0))
    (let ((definitions
            (new 'loading-level 'boxed-array
              static-actor-definition
              *static-actor-registry-count*)))
      (when (and definitions (nonzero? definitions))
        (let ((definition-count (static-actor-collect-for-bsp! bsp definitions)))
          (when (> definition-count 0)
            (static-actor-install-definitions! bsp definitions definition-count)
            )
          )
        )
      )
    )
  (none)
  )
