(defmacro defdrill-rail-turret-clones (source source-aid first-aid extra-id rotoffset vis-dist trans visvol-min visvol-max &key (shared-battle? #f))
  `(begin
    ,@(apply (lambda (slot)
               `(defstatic-actor ,(string->symbol-format "drill-{}-{}-definition" source slot)
                                 :level 'drill
                                 :name ,(fmt #f "{}-{}" source slot)
                                 :etype 'turret
                                 :aid ,(+ first-aid slot)
                                 :trans ,trans
                                 :task (game-task drill-ship)
                                 :kill-mask (task-mask task0 task2 done)
                                 :vis-dist ,vis-dist
                                 :required-art-groups (static-actor-art-groups "skel-turret" "skel-turret-explode")
                                 :properties
                                 (static-actor-properties
                                   (static-actor-raw-property 'path-actor uint32 (new 'static 'array uint32 1 ,source-aid) 1 #t)
                                   ,@(if shared-battle?
                                         `((static-actor-raw-property 'shared-battle-aid uint32 (new 'static 'array uint32 1 ,source-aid) 1 #t))
                                         '())
                                   (static-actor-raw-property 'extra-id int32 (new 'static 'array int32 1 ,extra-id) 1 #t)
                                   (static-actor-raw-property 'rotoffset float (new 'static 'array float 1 ,rotoffset) 1 #t)
                                   (static-actor-volume 'visvol ,visvol-min ,visvol-max))))
             '(1 2 3 4 5 6 7))))

(defdrill-rail-turret-clones turret-13 19283 60010 3 16384.0 200.0 (60.0 12.0 -22.0) (53.0 5.0 -124.5) (210.0 20.5 -15.0)
                             :shared-battle? #t)
